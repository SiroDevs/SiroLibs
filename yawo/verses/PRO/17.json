          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusakululucila cileŵi akusalimbikasya cinonyelo, nambo mundu jwakusasunga ngani ku lukosi akusawulaga ulongo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
