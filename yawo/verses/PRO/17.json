          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo cici cisilu cikuŵajilwa kola mbiya, kutendaga mtwe wakwe ukakwenda cenene soni akakusaka kupata lunda?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        }
      ]
