          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakutenda yakusakala akusapikanila maloŵe gakusakala, mundu jwa unami akusapikanila yayikusakopoka mkamwa mwakunyenga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
