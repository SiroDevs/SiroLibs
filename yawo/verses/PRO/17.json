              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapolo jwakutenda yindu mwa lunda tacilamulila mwanace jwa mlukosyo jwakusatenda yakutesya soni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
