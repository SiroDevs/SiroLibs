          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli kwambone kusimangana ni cilombo cicisumulidwe ŵanace ŵakwe, kulekangana ni kusimana ni cisilu mu usilu wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        }
