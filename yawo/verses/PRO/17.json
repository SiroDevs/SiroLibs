          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusawucisya cindu cakusakala m'malo mwa cambone, yisawusyo ngasiyityoka pa liŵasa lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
