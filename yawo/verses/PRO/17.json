          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndande ja ukangani jili mpela mesi gakwiticila, myoyo mtukuceje pa malopo ndewo mkanijitande.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
