        },
        {
          "text": "Golidi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "text": " ni silifa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "text": " yikusalinjidwa ni moto, nambo AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "text": " ni ŵakasajilinga mitima ja ŵandu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
