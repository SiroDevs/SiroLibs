              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli kwambone kulya mkute wejumu pali pana mtendele, kulekangana ni kutenda cindimba m'nyumba mwegumbale ni ukangani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
