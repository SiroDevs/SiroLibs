              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cisawu ciwilili ca ngope ja mundu cikusawoneka m'mesi, myoyo peyo soni mtima wa mundu ukusamanyika ni yitendo yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.19",
            "verseOrgIds": [
