          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵangondolo tacimkamucisya kumpa cakuwala kutyocela ku manyunya gakwe, soni pakusumisya mbusi timcipata cakusumila mgunda. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.26",
            "verseOrgIds": [
              "PRO.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
