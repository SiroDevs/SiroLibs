        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakalamuka akusati mkuciwona cindu cakogoyamo akusajuŵa, nambo jwakuloŵela akusagamba kupelenganya ni akusasimana ni yipwetesi ni kuligamba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
