          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timcikola mkaka wejinji wa mbusi kuti m'mweje, m'mwejo ni liŵasa lyenu, soni ni ŵamasengo ŵenu wosope.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.27",
            "verseOrgIds": [
              "PRO.27.27"
