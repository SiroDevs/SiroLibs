          "attrs": {
            "verseId": "PRO.27.21",
            "verseOrgIds": [
              "PRO.27.21"
            ]
          }
        },
        {
          "text": " yikusalinjidwa ni moto, nambo mundu akasamanyika cenene malinga ni mbili jakwe.",
