          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cisyano cikusaŵatika cisyano cijakwe, myoyo soni nombe najo mundu akusasyana mundu mjakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.17",
            "verseOrgIds": [
              "PRO.27.17"
            ]
          }
        }
      ]
