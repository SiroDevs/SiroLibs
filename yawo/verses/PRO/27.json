          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa cipanje cikusamala. Ana ucimwene ngawukusasamala mpaka mipago josope ja pasogolo? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.24",
            "verseOrgIds": [
              "PRO.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pati manyasi gamasile, msonde ni kusipuka, soni ŵandu ali acuŵile manyasi gosope ga ku matumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.25",
            "verseOrgIds": [
              "PRO.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
