          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakumkomasya mjakwe mwagumila kundaŵindaŵipe, ŵandu taciganicisya kuti atenda kumlwesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
