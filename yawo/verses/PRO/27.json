              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapocela ya malaŵi, pakuŵa ngamkuyimanyilila yitiyicitendekwa pa lyele lisikulyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
