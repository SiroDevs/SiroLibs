          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msimanyilile cenene ngondolo syenu musiŵelele, nambo soni myisamalile cenene yilangwa yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.23",
            "verseOrgIds": [
              "PRO.27.23"
            ]
