    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pati mtemi pasi kulya ni mwenye, mkumbucile cenene kuti nduni jwele jwamli najojo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mli mundu jwakunyela, mwusimane mtima kuti mkasimtenda kulosya lukowo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimkumbila yakulya yakwe yakunong'a pakuŵa yakulya yakweyo kuŵa mkomboleka kuti yili yakwamba kumlinga nayo basi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimlipesya mwasyene kusosasosa cipanje, mlijiganye kutenda yindu mwa lunda soni kuwusimana mtima. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakwamba kupisya panandipe, basi tiwusimane kuti cipanje cipite, pakuŵa cikusatenda mpela cigambile kumela mapapiko mwacisisimucisya, ni kutanda kuguluka ulendo wa kwinani mpela nyanga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkamlya cakulya kwa mundu jwa usuci, ni kumbila kose kasimkumbilaga yakulya yakwe yakunong'a. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa jwalakwe akusagambaga kutamila ganicisya ya mtengo wa yindu, akusakusalila kuti, “Myice, kwende mlyeje, soni m'mweleje!” Citamileco kutendaga mu mtima mwakwemo ali ngakusosa. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timcitapika syele mbamu simlilesyo, ni maloŵe genu gosope gakuyamicila tigacipita pacabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimŵecetaga mundu jwakuloŵela ali mkupikana, pakuŵa taciganyosya maloŵe genu galunda gakugapikanago.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimlundila malile kutyosya cimanyisyo ca mpika wa kalakala, kapena kuja kwinjilila migunda ja ŵanace ŵa masije. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.10",
            "verseOrgIds": [
              "PRO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa mkulupusyo jwawo ali jwamacili, tacacenjela pa magambo gawo ni m'mwejo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.11",
            "verseOrgIds": [
              "PRO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.11",
            "verseOrgIds": [
              "PRO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wenu uŵe pa malamusi ni kugakamulicisya masengo, soni mapikanilo genu gapikanileje yindu ya lunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasimleka kumjamuka ni kumwunda mwanagwenu, pakuŵa atamose mumkuŵite ni cikoti, ngasawa. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga kumputa ni cikoti, timcikulupusya umi wakwe ku ciwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, naga mtima wenu ukuŵa wa lunda, nombe une mtima wangu tiwuciŵa wakusangalala. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wangu tiwucisangalala, patinjimpikana mli mkuŵeceta yindu yakamula mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wenu ukasiwutenda wiwu ni ŵandu ŵa ulemwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        },
        {
          "text": " nambo mpitilisye kwajogopa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        },
        {
          "text": " ndaŵi ni ndaŵi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisyene nditu, cembeceyo cenu cakusogolo cipali, soni cikulupi cenu ngasiciŵa cacabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.18",
            "verseOrgIds": [
              "PRO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.18",
            "verseOrgIds": [
              "PRO.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane mwanangu, soni mkole lunda, mtima wenu mwujendesye mwitala lyambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.19",
            "verseOrgIds": [
              "PRO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.19",
            "verseOrgIds": [
              "PRO.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkatama pasikati pa ŵandu ŵakusakolelwa, pane pasikati ja ŵandu ŵakusalya nyama mwakunyela.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.20",
            "verseOrgIds": [
              "PRO.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.20",
            "verseOrgIds": [
              "PRO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa ŵandu ŵakolelwa ni ŵandu ŵakunyela taciŵa ŵakulaga, soni mundu jwaulesi tacisyuka jwakulwala yiwisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
            "verseOrgIds": [
              "PRO.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
            "verseOrgIds": [
              "PRO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwapikanile baba ŵenu ŵiŵamŵelece, soni mkasimwanyosyaga mama ŵenu ligongo lyakuti acekulwipe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.22",
            "verseOrgIds": [
              "PRO.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.22",
            "verseOrgIds": [
              "PRO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sumani cakuwona, ni mkasimcisumisya soni, msume lunda, misyungu nambo soni umanyilisi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.23",
            "verseOrgIds": [
              "PRO.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.23",
            "verseOrgIds": [
              "PRO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba ŵa mwanace jwakulungama taciŵa ŵakusangalala mnope. Jwakuŵeleka mwanace jwalunda tacisangalala najo mwanacejo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.24",
            "verseOrgIds": [
              "PRO.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.24",
            "verseOrgIds": [
              "PRO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba ŵenu ni mama ŵenu aŵe ŵakusangalala, mama ŵenu ŵiŵamŵelece m'mwejo aŵe ŵakondwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.25",
            "verseOrgIds": [
              "PRO.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.25",
            "verseOrgIds": [
              "PRO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanangu, mtima wenu ungulupilile une, meso genu galolecesye matala gangu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.26",
            "verseOrgIds": [
              "PRO.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkongwe jwacikululu ali mpela lisimbo lyakusokoka, jwamkongwe jwa cigwagwa ali mpela cisima cakanganika. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.27",
            "verseOrgIds": [
              "PRO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusajuŵilila kwembeceya mpela jwaciswamba, soni ligongo lya jwalakwejo, acalume ŵajinji akusatupilatupila kuŵa ŵangakulupicika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.28",
            "verseOrgIds": [
              "PRO.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.28",
            "verseOrgIds": [
              "PRO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nduni jwakwete likungu? Nduni jwakwete canasa? Nduni jwali pa ukangani? Ana nduni akudandawula? Nduni jwakwete maŵanga gangamanyika kugatyocele? Nduni jwakwete meso gakucejela? Ni ŵele ŵakusatamilisya pa malo pajuli finyo, ŵele ŵakusamwa nawo finyo jwewanganye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29+PRO.23.30",
            "verseOrgIds": [
              "PRO.23.29",
              "PRO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimjigalika mtima ni kucejela kwa finyo, pakusatenda mpela kusemula m'cikapu ni kunong'a pakwinjila ku ngulo. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.31",
            "verseOrgIds": [
              "PRO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mbesi pakwe finyo jukusaluma mpela lijoka, soni ni kutamukula mpela lipili ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.32",
            "verseOrgIds": [
              "PRO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso genu tigacilola yindu ya cilendo, soni nganisyo syenu ni maloŵe genu ngasiyiŵa yagoloka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.33",
            "verseOrgIds": [
              "PRO.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.33",
            "verseOrgIds": [
              "PRO.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timciŵa mpela mundu jwagonile kwala sikati ja nyasa, pane mpela mundu jwagonile pa songa jisyesyene ja wato. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.34",
            "verseOrgIds": [
              "PRO.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timciŵeceta kuti, “Ŵambutile likofi, nambo nganambweka. Ŵanguŵite, nambo une pangali cinapikene. Ana une ngingwimuka ligongo cici? Ngusosa finyo jwine soni.”",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.35",
            "verseOrgIds": [
              "PRO.23.35"
            ]
          }
        }
      ]
    }
