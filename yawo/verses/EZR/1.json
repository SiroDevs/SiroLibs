          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Sailasi ŵakopwesye mbale ni makapu ga ku Nyumba ja AMBUJE yiŵayijigele Mwenye Nebukadinesa kutyoka nayo ku Yelusalemu ni kuja kuyiŵika ku nyumba ja milungu jawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Sailasi jwa ku Pelesiya ŵayikopwesye yeleyi ni kuyipeleka kwa Mitiledati juŵaliji jwakusunga yipanje yawo, nipo ŵayiŵalasile pameso pa Sheshibasala bwanamkubwa jwa ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cakwe caliji myi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9+EZR.1.10",
            "verseOrgIds": [
              "EZR.1.9",
              "EZR.1.10"
