              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcaka candanda ca Sailasi mwenye jwa ku Pelesiya, AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "text": " ŵakwanilisye yiŵaŵecete kupitila mwa jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "text": " Yelemiya. AMBUJE ŵaŵisile nganisyo mu mtima mwa Sailasi kuti ajenesye utenga wa pakamwa ni wakulemba kuti ukaŵalanjidwe mu ucimwene wakwe wosope wakuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
