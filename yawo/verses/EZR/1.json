            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko acimlongola ŵa maŵasa ga lukosyo lwa Yuda ni lwa Benjamini, ŵakutaga mbopesi, Alefi ni ŵandu wosope ŵiŵaŵilanjidwe ni AMBUJE ni kwaŵika nganisyo m'mitima mwawo, ŵaliji cile kwawula ku Yelusalemu kukutaŵa Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope ŵiŵatamaga mwakuŵandikana nawo ŵakamucisye jemanjajo pakwapa yindu yejinji mpela yida ya ku kicini ya silifa, golidi, katundu, mituka ja mtengo wapenani ni yakupeleka ya ku Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
