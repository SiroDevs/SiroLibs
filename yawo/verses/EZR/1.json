        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
