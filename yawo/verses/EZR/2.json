          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵiŵaliji ku ukapolo ŵala piŵayice ku Nyumba ja AMBUJE ku Yelusalemu, acimlongola ŵane ŵa maŵasa ŵapelece mwa lisosa lyawo mituka kuti jikamucisye pa masengo gakutaŵa soni Nyumba ja AMBUJE pa malo gakwe gakala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "EZR 2:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapelece yosope muŵapakombolele nipo yosope yakwanile golidi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "text": " jwa makilogalamu 500, ni silifa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "text": " jwa makilogalamu 2,800, ni mikanjo ja ŵakutaga mbopesi jakwanila 1,000.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        }
      ]
