    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mena ga ŵandu ŵiŵawusile ku ukapolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵajinji ŵiŵaliji ku ukapolo ŵatyosile ku upande wa Babiloniya nipo ŵawujilile ku Yelusalemu ni ku Yuda, jwalijose ku msinda wa kumangwakwe. Acinangolo ŵa jemanjaji ŵaŵele ali mkutama mu ukapolo ku Babiloniya citandilile pa ndaŵi jiŵajigalidwe ni Mwenye Nebukadinesa ni kuja nawo kweleko mpela acikapolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimlongola ŵawo ŵaliji Selubabele, Yeswa, Nehemiya, Selaya, Leaya, Modekayi, Bilisani, Misipali, Bigifayi, Lehumu, ni Baana. Aga ni mena ga maŵasa ga ku Isalaeli pamo ni ciŵalanjilo ca ŵandu ŵakutyocela ku liŵasa lililyose ŵiŵawusile kutyocela ku ukapolo:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
