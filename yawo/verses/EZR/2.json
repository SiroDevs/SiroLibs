          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi, Alefi, ni ŵandu ŵane ŵajile kutama ku msinda wa Yelusalemu ni malo gane gakuwusyungulila msindawo. Ŵandu ŵakwimba nyimbo, acilonda ŵa ku Nyumba ja AMBUJE, ni ŵandu ŵakamula masengo ku Nyumba ja AMBUJE, ni Aisalaeli ŵane wosope ŵajile kutama m'misinda jiŵatamaga acinangolo ŵawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.70",
            "verseOrgIds": [
              "EZR.2.70"
            ]
          }
