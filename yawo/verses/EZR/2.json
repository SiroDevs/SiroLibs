        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "EZR 2:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maŵasa ga Habaiya, Hakosi, ni Balisilayi nganigakola umboni wakusala kuti jemanjajo ŵaliji ŵakutaga mbopesi. Acinangolo ŵa liŵasa lya jwakutaga mbopesi Balisilayi ŵalombele mwanace jwamkongwe jwa Balisilayi ŵa ku Giliyadi nipo ŵaŵilanjidwaga ni lina lya liŵasa lya Balisilayi. Nambo pakutipo jemanjajo ŵasosilesosile mena mu buku jakulongosola mu kaundula jwa ngosyo syawo, nambo mena gawogo nganigasimanikwa mwelemo, myoyo nganiŵakunda soni kutumicila mpela ŵakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.61+EZR.2.62",
            "verseOrgIds": [
              "EZR.2.61",
              "EZR.2.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "EZR 2:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanamkubwa jwa Ciyuda ŵasalile jemanjajo kuti akalyaga nawo cakulya cele cipelecedwe kwa Mlungu, mpaka ali asimanikwe jwakutaga mbopesi jwakumanyilila kutenda cisango pakamulisya masengo maganga gaŵili ga Ulimu ni Tumimu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        },
