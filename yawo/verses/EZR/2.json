            "number": "59",
            "style": "v",
            "sid": "EZR 2:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapali ŵandu 652 ŵa m'maŵasa ga Delaya, Tobiya, ni Nekoda ŵiŵawusile kutyocela ku misinda ja Teli Mela, Teli Halisha, Kelubi, Adani, ni Imeli atamose kuti paliji pangali umboni usyesyene kuti acinangolo ŵawo kapena mtundu wawo waliji wa ci Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.59+EZR.2.60",
            "verseOrgIds": [
              "EZR.2.59",
              "EZR.2.60"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
