              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo ca ŵamasengo wosope ŵa ku Nyumba ja AMBUJE pamo ni ŵamasengo ŵa Solomoni ŵiŵawusile kutyocela ku ukapolo caliji 392.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.58",
            "verseOrgIds": [
              "EZR.2.58"
            ]
          }
        }
      ]
    },
    {
