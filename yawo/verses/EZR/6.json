            "number": "1",
            "style": "v",
            "sid": "EZR 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Mwenye Daliyasi ŵatesile lilamusi nipo kuwungunya kwatendekwe ku Babiloniya m'nyumba syakusunjila yipanje ni m'mabuku gakwayana ni mbili ja kalakala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambesi pakwe cipukutu ca yakulembedwa casimanikwe mu msinda wa Ekibatana ku likulungwa lya mbali ja Mediya, nipo ŵalembilemo maloŵe gakuyicisyaga:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye Daliyasi akulamula kuti masengo gapelenganye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Mwenye Daliyasi ŵajanjile mwamti myi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyumba ja AMBUJE jikupelecedwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko bwanamkubwa Tatenayi jwa mbali ja kungapilo lyuŵa kwa Lusulo lwa Yufuleti, Setali Bosenayi, ni acimjawo ŵagakuyisye malamusigo mwakusamalila mpela muŵalamulile Mwenye Daliyasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.13",
            "verseOrgIds": [
              "EZR.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimlongola ŵa Ayuda ŵagajawisye msogolo masengo gakutaŵa Nyumba ja AMBUJE jila, mwakulimbisidwa mitima ni ŵakulocesya Hagai ni Sakaliya mwanace jwa Ido. Myoyo jemanjajo ŵamalisisye masengo gawo gakutaŵa Nyumba ja AMBUJE, mpela muŵalamulile Mlungu jwakusamlambilaga Aisalaeli, ni pakukuya soni malamusi ga Mwenye Sailasi, Daliyasi ni Mwenye Alitakisesi ŵa ku Pelesiya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Hag 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Sak 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumbaji ŵajimalisisye kutaŵa pa lisiku lyatatu lya mwesi wa Adala",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        },
        {
          "text": " mcaka ca msano ni cimo ca ucimwene ŵa Mwenye Daliyasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku Isalaeli, ŵakutaga mbopesi, Alefi ni ŵandu ŵane wosope ŵiŵaliji ali awusileko ku ukapolo ŵaliji wakusengwa nipo ŵasangalele piŵapelekaga Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.16",
            "verseOrgIds": [
              "EZR.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵatendaga msyunguwu, ŵandu ŵapelece ng'ombe sya mikambako 100, ngondolo sya mikambako 200, ŵanace ŵangondolo 400, ni acitonde likumi ni ŵaŵili ŵambopesi ja kuŵenda cikululucilo ca ulemwa pa ŵandu wosope pakukuya ciŵalanjilo ca ngosyo sya ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.17",
            "verseOrgIds": [
              "EZR.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo kaneko ŵaŵisile ŵakutaga mbopesi ni Alefi pa masengo gawo gakutumicila m'Nyumba ja AMBUJE ku Yelusalemu, mpela muŵayilembele mu buku ja Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        }
      ]
    },
