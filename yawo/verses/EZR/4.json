              },
              "items": [
                {
                  "text": "Est 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo pa ndaŵi jiŵalamulilaga Mwenye Alitakisesi jwa ku Pelesiya, Bishilamu, Mitiledati, Tabele ni acimjakwe ŵane wosope, ŵalembile nombe nawo cikalata cakwawula kwa Mwenye Alitakisesi. Cikalataco calembedwe mu ciŵeceto ca m'Cialamu, nipo pakuciŵalanga cikalataco ŵacigopolelaga.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nombe nawo Lehumu juŵaliji bwanamkubwa ni Shimushayi juŵaliji mlembela, ŵalembile cikalata kwa Mwenye Alitakisesi cakwalaŵila ŵandu ŵa ku Yelusalemu mwakuyicisyamu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga ni maloŵe gigaliji mcikalatamo:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwenye, tukusaka kuti wawo amanyilile kuti Ayuda ŵiŵayice akuno kutyocela kweleko, ajile kukutama ku Yelusalemu. Kweleko akutaŵako soni msinda ŵakwimucila ni ŵangalumbana ula. Akumalisya kutaŵa mapupa gakwe ni kulinganya yilimbilimbi yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye, wawotu akwenela kumanyilila kuti naga akuwutaŵa msinda welewu ni kumalisya kutaŵa mapupa gakwe, ni kuti Ayuda tacileka kukoma msongo uliwose, nipo mbiya syakwinjila mu msaku wa mwenye tisicinandipa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.13",
            "verseOrgIds": [
              "EZR.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo pakuti uwe tukusalya nawo ya m'nyumba ja mwenye, ngaŵa yambone kuti tugambeje kuyilola yindu yeleyi yili mkutendekwa, ali ni ligongo lyakwe tukutumisya maloŵega kwa wawo mwenye kuti ayimanyilile, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.14",
            "verseOrgIds": [
              "EZR.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni cakulinga cakuti kuwungunya kutendekwe m'buku jakala ja acinangolo ŵetu. M'buku jakalajo tacisimana ni kuŵalanga kuti msinda welewo uli wakwimucila, wakwasawusya ayimwene ni nduna sya mbali jelejo. Msindawu uŵele uli mkutenda yakwimucila kutandilila kalakala. Ali ni ligongo lyakwe msindawo ŵawusandwisye kuŵa masame. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.15",
            "verseOrgIds": [
              "EZR.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukwamanyisya wawo mwenye kuti naga msinda welewu ukutaŵidwa ni kumalisya kutaŵa mapupa gakwe, ni kuti wawojo ngasapakombola kulamulila mbali ja kungapilo lyuŵa pesi pa Lusulo lwa Yufuleti.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Alitakisesi ŵajanjile mwamti myi: “Bwanamkubwa Lehumu ni mlembela Shimushayi, ni acimjawo wosope ŵakutama ku Samaliya, ni mbali ja pesi pa Lusulo lwa Yufuleti, une ngupeleka moni.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cikalata cimwatumisye jemanja ciŵalanjidwe mwakupikanika ni kugopoleledwa cenene pameso pangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.18",
            "verseOrgIds": [
              "EZR.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une pinalamwile kuti nganiji jiwungunyidwe, pasimanikwe kuti ŵandu ŵa mu msinda wa Yelusalemu ŵajimucile ayimwene kalakala, nipo ya upandu ni yakwimucila yiŵele yili mkutendeka mu msindamo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.19",
            "verseOrgIds": [
              "EZR.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayimwene ŵamacili ŵaŵele ali mkulamulila ku Yelusalemu ni mbali jesope jene ja pesi pa Lusulo lwa Yufuleti, nipo ŵapocelaga kasitomu ni msongo pa kandu kane kalikose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ngusaka kuti jemanja mwalamule ŵanduwo kuti alece kutaŵa soni msindawo, mpaka pa ndaŵi jitinjakunda jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
