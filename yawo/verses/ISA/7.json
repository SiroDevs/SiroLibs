              "type": "text"
            }
          ]
        },
        {
          "text": "“Lisiku lyelelo AMBUJE tacilemba ŵakusenga ŵakutyocela pesi pa Lusulo lwa Yufuleti, mwenye jwa Asiliya. Ni lwembe lwakwe tacimsenga umbo sya mu mtwe ni mcilu nipo soni ndewu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        }
      ]
