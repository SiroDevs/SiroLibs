          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pitiliciyika lisiku lyelelo, migunda ja mpeleya jele jili jambone, jele jikwete yitela yakwana 1,000 mu mgunda uliwose nipo kuti mtengo wakusumicisya ni yiduswa 1,000 ya silifa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
          "text": " mu migunda mwelemu timucimela miŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu taciyika kweleko kukutenda mani ali ajigele mawukunje ni mipamba, pakuti mcilambo mosopemo timucigumbala miŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
              "ISA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
