          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa lisiku lyelelo mwine mundu tacigamba kulanga ng'ombe ja mwana ja mkaka ni ngondolo siŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambope, tacipata mkaka wejinji, mwamti jwalakwe taciŵa mundu jwakulya cenene. Pakuti jwalijose jutacisigalila mcilambomo tacilyaga mawuta ga mkaka ni uci.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
      ]
