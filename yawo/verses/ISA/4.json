          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lumbili lwakwe tuluciŵa m'bwilili wakutililamo citukuta ca musi, tiwuciŵa malo gakutililapo mbepo ni ula.",
          "type": "text",
          "attrs": {
