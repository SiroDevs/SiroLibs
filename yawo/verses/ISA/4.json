            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo acakongwe msano ni ŵaŵili tacimkamula jwamlume jumo ni kuŵeceta najo kuti, uweji citulyeje yakulya yetu ni kuwala yakuwala yetu; nambo wawo atujiticisye kuti ŵandu atukolanjeje ni lina lya ŵalakwe kuti tuli ŵamkwawo, kuti soni sya ungalombedwa sityoce pa uwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yelusalemu taciwucisidwa soni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
