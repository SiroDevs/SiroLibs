                {
                  "text": "Ciw 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.9"
              },
              "items": [
                {
                  "text": "2 Ates 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likwisa lisiku lyele kulikwesya kosope kwa ŵandu tikucimala, kulilumba kwa ŵandu tikucijonanjidwa, nipo AMBUJE jikape ni wutacipocela lumbili. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lya AMBUJE Ŵamaciligosope, ŵandu wosope ŵakulikwesya ni kulilumba tacanandiya. Wosope ŵamacili tacagwisya pasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciyikata yitela ya mikungusa yosope ya ku Lebanoni, jelewu kupunda jine josope. Taciyikata yitela yosope ya mtundu ya ku Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
              "ISA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacimwasanya matumbi gosope gelewu ni mikuli josope jelewu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.14",
            "verseOrgIds": [
              "ISA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacigwisya sanja syosope syelewu. Tacigumula mapupa gosope gakulimba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.15",
            "verseOrgIds": [
              "ISA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacitiŵisya yombo yosope yekulungwa ni yakusalala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.16",
            "verseOrgIds": [
              "ISA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikwesya kosope kwa mundu tikucimala, kulilumba kwa jemanja kosope tukucijonanjidwa. AMBUJE jikape ni utacipocela ucimbicimbi pa lisiku lyelelo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.17",
            "verseOrgIds": [
              "ISA.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Milungu jakupanganyidwa josope tijicimalila papopo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.18",
            "verseOrgIds": [
              "ISA.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.18",
            "verseOrgIds": [
              "ISA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu tacitilila mu mbanga sya m'maganga, ni m'masimbo ga mwitaka. Tacitila lutumbilo lwa AMBUJE, soni lumbili lwamacili gakwe, pele pitaciyika kucijogoya cilambo capasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.19",
            "verseOrgIds": [
              "ISA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo ŵandu tacijasa milungu jakupanganyidwa ja golidi ni silifa, yele ŵayipanganyisye kuti ayilambileje. Taciyijasa kugapa namfuko ni mileme. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.20",
            "verseOrgIds": [
              "ISA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu tacitilila mu mbanga sya m'malwala, ni m'masimbo ga m'malwala. Tacitila lutumbilo lwa AMBUJE, soni lumbili lwamacili gakwe, pele pitaciyika kucijogoya cilambo capasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.21",
            "verseOrgIds": [
              "ISA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
