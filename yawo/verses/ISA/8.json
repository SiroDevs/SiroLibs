              "ISA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlole une pamo ni ŵanace ŵambele une AMBUJE, tuli yimanyisyo kwa Aisalaeli yakutyocela kwa AMBUJE Ŵamaciligosope ŵele ŵakusatama pa Litumbi lya Siyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
