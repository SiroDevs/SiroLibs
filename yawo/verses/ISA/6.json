                "loc": "2KI.15.7"
              },
              "items": [
                {
                  "text": "2 Ayi 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Mbi 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Penani pa AMBUJE, ŵajimi Aselafi. Jwalijose jwakwete mapapiko msano ni limo: gaŵili ŵaliwunicilaga nago ngope syawo, gane gaŵili ŵawunicilaga nago sajo syawo, nipo gane gaŵiligo ŵagulucilaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aselafi ŵakolanganaga kuti:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Ciw 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lyakugumila kwa Aselafiwo, yilimbilimbi ya Nyumba ja AMBUJE jatenganyice, nipo Nyumba josope jagumbele lyosi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.15.8"
              },
              "items": [
                {
                  "text": "Ciw 15:8",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo une natite kuti, “Likungu kwa une! Njonasice! Pakuti ndili mundu jwa ngomo syakusakala, nipo ngusatama sikati ja ŵandu ŵa ngomo syakusakala. Nambope ni meso gangu naweni mwenye, AMBUJE Ŵamaciligosope.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo jumo jwa Aselafi ŵala ŵagulwice ni kwika pa une, ali ajigele likala lya moto m'myala mwakwe. Likalalyo ŵalityosisye pa malo gakupelecela mbopesi ni mbanilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵasikwayiye ngomo syangu ni kuti, “Mlole, ngwayiye ngomo syenu ni likalali. Kulemwa kwenu kutyosyedwe, ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        },
        {
          "text": " wenu ukululucidwe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo napikene AMBUJE ali mkuŵeceta kuti, “Ana ŵani utinatume? Ana ŵani utajawule m'malo mwetu?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo une najanjile kuti, “Une ndili apano, andume!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵaŵecete ni une kuti, “Jawulani mkasalile ŵandu ŵeleŵa kuti, ‘Kupikana timpikaneje nambo ngisimpikanicisya, kulola timloleje nambo ngim'manyilila yimkuyiwonayo.’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.14+MAT.13.15"
              },
              "items": [
                {
                  "text": "Mat 13:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.12"
              },
              "items": [
                {
                  "text": "Mak 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.10"
              },
              "items": [
                {
                  "text": "Luk 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.40"
              },
              "items": [
                {
                  "text": "Yoh 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.26+ACT.28.27"
              },
              "items": [
                {
                  "text": "Mase 28:26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵandu ŵeleŵa mwasisimisye mtima, mwatendesye kuti akapikana ni mapikanilo gawo, ni mwasiŵe m'meso mwawo, kuti akalola ni meso gawo, soni kuti akapikana ni mapikanilo gawo, soni kuti akapikanicisya ni mtima wawo, kaneko ni kupitikuka mtima ni kuposyedwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo nawusisye kuti, “AMBUJE ana yeleyi tiyicitendekwa mpaka cakaci?” Ŵalakwe ŵatite, “Mpaka misinda josope jiŵe masame, mpaka m'majumba muŵe mwangali ŵandu ŵakutamamo, mpaka cilambo cili citendekwe kuŵa cipululu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjasamicisya ŵanduŵa kwakutalika, nipo cilambo ticiciŵa cangali ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose asigale mundu jumo mwa ŵandu likumi mcilambomo, nombe najo soni taciwulajidwa, taciŵa mpela cisici ca citela ca mtundu, cele cikusasigalila pitacigwisye citelaco. Myoyo mbeju jeswela jila tijicisigalila mpela cisici cakusigala mcilambo.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Cisici cikwimilila ndande jasambano ja ŵandu ŵa Mlungu).",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    }
