                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.21",
            "verseOrgIds": [
              "ISA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano jemanja mkanyosya maloŵe gelega. Naga mkutenda myoyo tiyiciŵa yakusawusya kutila. Kutyocela kwa AMBUJE Ŵamaciligosope, mbikene maloŵe kuti, “Ndamwile kuti tinjicijonanga cilambo cosope capasi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lunda lwa Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane yinguŵeceta. Mpikanile ni kupikana yingumsalila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.23",
            "verseOrgIds": [
              "ISA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mundu jwakusosa kupanda mbeju akusagamba kupitilisya kulimape? Ana akusagamba kulima ni kutenda cikasila mu mgundawo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.24",
            "verseOrgIds": [
              "ISA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali awulinganyisye mgundawo, ana ngaŵa akusapanda mbeju sya kununjilisya yakulya? Ana ngaŵa akusapanda mbeju ja tiligu ni balele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.25",
            "verseOrgIds": [
              "ISA.28.25"
            ]
          }
        },
        {
          "text": " m'misela ni kupanda soni mungulugulu mwa mgundawo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.25",
            "verseOrgIds": [
              "ISA.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ni jwakusamsalila ni kumjiganya litala lyambone. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.26",
            "verseOrgIds": [
              "ISA.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakununjilisya yakulya yangaputidwa ni ligeleta lyangali yigudumu, ŵangaputa pakuliŵata ni yigudumu ya ligeleta. Yakununjilisya yakulya akusaputa ni kacitela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.27",
            "verseOrgIds": [
              "ISA.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu ngaŵa mkuputa tiligu mwangalecesya, ligongo kutenda iyoyo mpaka ajonasice tiligujo. Akusaputa pakuliŵata ni ligeleta, nambo mwangasijonanga mbeju syakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.28",
            "verseOrgIds": [
              "ISA.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda lwelelu lukusatyocela kwa AMBUJE Ŵamaciligosope. Upungu wakwe uli wakusimonjesya, lunda lwakwe lwakupunda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.29",
            "verseOrgIds": [
              "ISA.28.29"
            ]
          }
        }
      ]
    }
