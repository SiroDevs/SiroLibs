              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Hesekiya ŵamsalile Yesaya kuti, “Maloŵe gaŵecete AMBUJE gali gambone.” Pakuŵeceta gele maloŵego, Hesekiya ŵaliji mganisya mu mtima mwakwe kuti, “Yeleyo yangali kandu, bola upagwe mtendele ni bata masiku gosope ga umi wangu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
