          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa litumbi ali lya Siyoni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "text": " AMBUJE Ŵamaciligosope tacilinganya cindimba ca ŵandu wosope, ca yakulya yakunong'a ni finyo jwambone, cindimba ca nyama jakunakana ni finyo jwakunong'a mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa litumbi alino tacityosya canasa cele cakamwile ŵandu wosope, cele ciwunicile mitundu josope ja ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE tacicimasya ciwa mpaka ndaŵi jangali mbesi. Tacipukuta misosi m'meso mwa jwalijose, nipo tacityosya soni sya ŵandu ŵakwe pa cilambo cosope capasi. Akuti myoyo AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
