              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amowabu tacilinga kugatambasukula makono gawo mpela mwakusatendela mundu jwakung'ambila. Nambo AMBUJE tacimasya kulilumba kwawo nipo soni umisili wa makono gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacigumula mapupa gawo gelewu. Tacagwisya, kaneko tacaponya pasi, pa luwundu pasyesyene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
