              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo ŵandu taciti, “Aju ni Mlungu jwetu, jutwamkulupililaga kuti tacitukulupusya. Ŵalakweŵa ni AMBUJE ŵetu. Twakulupililaga, sambano kwende tukondwe ni kusangalala ligongo lyakuti atukulupwisye nditu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu tacipeleka cilango kwa Amowabu",
          "type": "text"
        }
      ]
    },
    {
