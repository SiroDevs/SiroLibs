        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
          "text": " akuŵeceta kuti, “Msinda wa Damasiko ngasiwuŵa soni msinda, nambo tiwucitendekwa kuŵa malo gangatamidwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
