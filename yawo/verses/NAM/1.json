        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalamwile AMBUJE kwa Asiliya nayi: “Ngasakola yisukulu yitiyiciŵilanjidwa ni mena gawo. Tinjijonanga milungu jawo jakupanganya ŵandu jajili m'majumba mwawo ga milungu jawo. Ngusola lilembe lya Asiliya — ngakuŵajilwa kuŵa ni umi!”",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
    },
