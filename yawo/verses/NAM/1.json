              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Ninefe kwatyocele mundu jwine jwa nganisyo syangalumbana, juŵasosaga kwatendela ciswamba AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakuŵeceta AMBUJE nayi: “Atamose kuti Asiliya ali ŵamacili soni ŵajinji, tacijonasika ni kumala kwangawoneka soni. Ŵandu ŵangu namlagasisye, nambo ngisinimlagasya soni. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ngumasya macili ga Asiliya pa jemanja soni ngukutulanya ma unyolo giŵamtaŵilego.”",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        }
      ]
    },
    {
