          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwele jwakwete mapikanilo, apikanicisye yele Msimu akujisalila mipingoji.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.22",
