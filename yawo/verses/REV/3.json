              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa jwakulongolela mpingo wa ku Filadefiya mlembe kuti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
