            "number": "1",
            "style": "v",
            "sid": "REV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo nam'weni Mwanace Jwangondolo jula ali mkumatukula candanda mwa yimatilo msano ni cimo yila. Myoyo napikene cimo mwa ya umi mcece yila cili mkuŵeceta ni liloŵe lyakupikanika mpela njasi licitiji, “Myice!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinalolite najiweni haci jeswela. Juŵakwesile pelepo jwakwete ukunje soni jwapegwile cisindi ca ucimwene. Jwalakwejo jwakopocele mpela jwakupunda, kuti akapunde soni ŵane pa cilambo capasi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
