              "items": [
                {
                  "text": "Esek 14:21",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili yimasile yeleyi Mwanace Jwangondolo jula jwamatukwile cimatilo ca msano. Myoyo naweni kusi kwa malo gakupelecela mbopesi misimu ja ŵandu uŵawulajidwe ligongo lyakulalicila maloŵe ga Mlungu, nambo soni ŵaŵele ŵakulupicika pakutendela umboni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misimujo jagumisile mwakwesya maloŵe jicitiji kuti, “Ambuje Ŵamaciligosope, ŵalakwe ali ŵaswela ni ŵakulupicika. Ana tacaleka mpaka cakaci ngajimba magambo ni kwapa cilango ŵandu ŵa pa cilambo capasi ni ligongo lyakutuwulaga uwe?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jwa jemanjajo jwapegwile mkanjo weswela, nipo ŵasalilidwe kuti apumuleje panandi kaje mpaka piticicikwanila ciŵalanjilo cosope ca ŵakutumicila acimjawo, ni acalongo acimjawo mwa Ambuje ŵele ŵakwenela kuwulajidwa mpela acimsyenewo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
      ]
    },
    {
