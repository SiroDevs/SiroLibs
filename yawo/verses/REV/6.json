          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndondwa syagwile pasi, mpela musikusalakaticila nguju syeŵisi syangajiwula, pa ndaŵi jele citelaco cikutenganyika ni mbungo jamacili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
