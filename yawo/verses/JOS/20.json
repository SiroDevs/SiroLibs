              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo, ku mbali ja kungapilo lyuŵa kwa Lusulo lwa Yolodani Aisalaeli ŵatyosisye Kedeshi ku Galileya, mcilambo ca kwitumbi ca Nafutali; nipo Shekemu, mcilambo ca kwitumbi ca Efelemu, ni Kiliyati Alaba (jijili Hebuloni) mcilambo ca kwitumbi ca Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo kungopoko lyuŵa kwa Yolodani, pa cawe ca mcipululu Aisalaeli ŵasagwile Besala, kungopoko lyuŵa kwa Yeliko mu upande wa Lubeni; nipo Lamoti ku Giliyadi, mu upande wa Gadi; ni Golani ku Bashani, mu upande wa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeleji ni misinda jakutilila jiŵasagulile Aisalaeli wosope ŵene pamo ni mlendo jwalijose jwakutama pasikati pawo. Jwalijose juŵawuleje mundu mwangosi ngaŵaga mwa mele akukomboleka kutilila kweleko, kuti akasawulajidwa ni mundu jwakusosa kuwucisya, mpaka ali alamulidwe panganya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
