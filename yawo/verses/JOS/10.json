          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵapundisye soni Aisalaeli pa wele msindawu ni mwenye jwakwe. Nginamleka jwa umi jwalijose, nambo ŵawuleje wosope ŵene mwelemo. Ŵatesile kwa mwenyejo mpela yiŵatesile kwa mwenye jwa Yeliko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
