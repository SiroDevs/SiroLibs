          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Holamu jwa Gesele ŵayice kukuwukamucisya msinda wa Lakishi, nambo Yoswa ŵampundile jwalakwejo ni ŵa ngondo ŵakwe nipo nginamleka jwa cijumi ni jumo jose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
