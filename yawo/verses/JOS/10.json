              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pa yeleyi, Yoswa ni ŵa ngondo ŵakwe ŵajawile ku Lakishi kutyocela ku Libina, ŵawusyungulile ni kuwutanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
