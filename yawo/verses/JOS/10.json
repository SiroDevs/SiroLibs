          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵawusumwile lisiku lilyolyo ni kumwulaga jwalijose mwelemo, mpela muŵatendele ku Lakishi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
