            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵapundisye Aisalaeli pakuwupunda msinda wa Lakishi pa lisiku lya lyaŵili lya ngondojo. Mpela muŵatendele ku Libina, nginamleka jwa umi jwalijose, nambo ŵawuleje wosope ŵene mu msindamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
