              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko, Yoswa ni ŵa ngondo ŵakwe ŵajawile ku Egiloni kutyocela ku Lakishi, ŵawusyungulile ni kuwutanda msindawo. ",
          "type": "text",
          "attrs": {
