          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa ŵajitandite ngondo ni kusumula Makeda ni mwenye jwakwe lyele lisikulyo. Ŵamwuleje jwalijose mu msindamo; pangali jumo juŵamlesile jwacijumi. Jwalakwe ŵatesile kwa mwenye jwa ku Makeda yiŵatesile kwa mwenye jwa ku Yeliko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
