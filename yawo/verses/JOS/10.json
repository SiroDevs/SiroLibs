              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pa yeleyi, Yoswa ni ŵa ngondo ŵakwe ŵakwesile m'matumbi kwawula ku Hebuloni kutyocela ku Egiloni, ŵajile kuwutanda ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni kuwusumula msindawo. Ŵamwuleje mwenye ni jwalijose mu msindamo nambo soni kusumula misinda jajinandi jakuŵandicila ni kwawulaga ŵandu wosope ŵene mwelemo. Yoswa ŵasalile ŵandu ŵakwe kuti, awujonanje msindawo mnope, mpela muŵawujonanjile msinda wa Egiloni pakumwulaga jwalijose mwelemo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
