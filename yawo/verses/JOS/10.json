          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pa yeleyi, Yoswa ni ŵa ngondo ŵakwe ŵapitilisye kwawula kukuputa ngondo ku Libina kutyocela ku Makeda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
