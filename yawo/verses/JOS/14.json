      },
      "items": [
        {
          "text": "Yoswa akugaŵanya upande kungapilo lyuŵa kwa Yolodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakuyicisyaji ni ngani ja muŵagaŵile cilambo ca Kenani kungapilo lyuŵa kwa Lusulo lwa Yolodani kwa ŵandu ŵa ku Isalaeli. Eliyesa jwambopesi, Yoswa mwanace jwa Nuni, ni ŵakulongolela ŵa maŵasa ga mitundu ja Isalaeli ŵacigaŵile cilamboco mwakulandana ni ciŵalanjilo ca ŵanduwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "text": " ŵamlamwile Mose,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "text": " ma upande ga ngosyo msano ni mcece ni hafu ja kungapilo lyuŵa kwa Lusulo lwa Yolodani ŵagagaŵenye mwa kulondola yisango.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
