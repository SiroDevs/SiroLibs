                  "text": "Num 26:52-56",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.13"
              },
              "items": [
                {
                  "text": "34:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵaliji ali apelece kala cilambo ca kungopoko lyuŵa kwa Yolodani kwa mitundu jine jiŵili ni litika. (Ŵandu ŵa mwiŵasa lya Yosefe ŵagaŵile m'mitundu jiŵili: Manase ni Efelemu). Nambope Mose nginapeleka kambali ka mtepa kwa Alefi. M'malo mwakwe, jemanjajo ŵapocele misinda kuti atamejemo, ni migunda jakulicisya ng'ombe syawo ni yilangwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3+JOS.14.4",
            "verseOrgIds": [
              "JOS.14.3",
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Num 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.14+NUM.34.15"
              },
              "items": [
                {
                  "text": "34:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
