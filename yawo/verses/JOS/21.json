        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE ŵapelece kwa Aisalaeli cilambo cosope cene ciŵalangene mwakulumbila acinangolo ŵawo kuti tacapa jemanjajo. Piŵacipocele, ŵatemi kweleko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵapele jemanjajo mtendele mcilambomo, mpela muŵalanganile ni acinangolo ŵawo. Pangali jumo mwa amagongo ŵawo wosope juŵapakombwele kusisyana nawo ni kupunda, ligongo AMBUJE ŵapundisye Aisalaeli pakwapunda amagongo ŵawo wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵasunjile lililyose lya yilanga yosope yiŵayitesile kwa ŵandu ŵa ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
