          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41+JOS.21.42",
            "verseOrgIds": [
              "JOS.21.41",
