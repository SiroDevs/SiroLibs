          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku cilambo ciŵakwete ŵandu ŵa ku Isalaeli, misinda jakwanila 48, pamo ni malo ga mopo gakujisyungulila misindajo japelecedwe kwa Alefi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41+JOS.21.42",
            "verseOrgIds": [
              "JOS.21.41",
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aisalaeli akujigala cilambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
