          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana ŵapopesile ŵatite,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        },
