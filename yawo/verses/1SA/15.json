        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo akutenda ngondo ni Aamaleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line Samuele ŵamsalile Saulo kuti, “Une ndili mundu juŵandumile AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "text": " jula kuti najinjisye ucimwene wawojo kuŵa mwenye jwa Aisalaeli. Apikane sambano yakuti AMBUJE Ŵamaciligosope.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.1"
              },
              "items": [
                {
                  "text": "1 Sam 10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuti tiŵasawusye Aamaleki ligongo acinangolo ŵawo ŵamenyene ni Aisalaeli petala piŵatyocelaga ku Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14"
              },
              "items": [
                {
                  "text": "Eks 17:8-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Det 25:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajawule akamenyane ni Aamaleki nipo akajonanje yosope yene yakwete jemanjajo. Akaja kuleka cindu cilicose, nambo akawulaje acalume wosope, acakongwe, ŵanace, ni makandi gakwe. Akawulaje soni ng'ombe, ngondolo, ngamila",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        },
        {
          "text": " ni acibulu ŵakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Saulo ŵaŵilasile ŵa ngondo ŵakwe ni kwaŵalanga ku Telaimu. Ciŵalanjilo ca ŵa ngondo ŵakwenda pasi caliji 200,000 kutyocela ku Isalaeli nipo ŵakutyocela ku Yuda ŵaliji pamo 10,000. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko jwalakwe pamo ni asilikali ŵakwewo ŵajawile ku msinda wa Aamaleki, nipo ŵawujuŵilile m'ciŵata cangali mesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵasalile Akeni kuti, “Mtyoce pasikati pa Aamaleki kogopa kwajonanjila pamo. Pakuŵapo jemanja mwatendele Aisalaeli yindu yambone piŵatyocelaga ku Iguputo.” Myoyo Akeni ŵatyosile pasikati pa Aamaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ŵapundile Aamaleki pa ngondojo, kutandila ku Hafila mpaka ku Shuli kungopoko lyuŵa kwa Iguputo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵamjigele Agagi mwenye jwa Aamaleki ali jwa umi nipo ŵandu ŵane wosope ŵawuleje. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Saulo ni ŵandu ŵakwe nganiŵawulaga Agagi nipo soni nganawulaga ngondolo, ng'ombe, ŵanace ŵa ng'ombe, ni ŵangondolo ŵakwimbala, ni yosope yiyawonekaga yakusalala. Ŵagambile konanga yeleyo peyo yiyaliji yangali masengo ni yakusakala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AMBUJE akumkana Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE ŵamsalile Samuele kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngutenda canasa kuti namsagwile Saulo kuti aŵe mwenye. Agalawice nipo alesile kunguya une kwakuti nganagapikanila malamusi gangu.” Papopo Samuele ŵapile mtima, nipo ŵacesisye cilo cosope kwadandawulila AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵalaŵile kundaŵi kuja kukuwonegana ni Saulo. Ŵandu ŵamsalile kuti, “Saulo ŵapite ku msinda wa Kalimeli, nipo kweleko jwalakwe ŵajile kukwimika liganga lyakuti ciŵe cikumbukumbu ca msyenejo, nipo kuti ŵaliji ali apite ku Giligala.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵamkuyisye Saulo, ali amsimene Saulojo ŵamkomasisye Samuele kuti, “AMBUJE ŵape upile wawojo. Une napikanile AMBUJE pakutenda yosope yiŵandumile.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵawusisye kuti, “Nambi ligongo cici ngupikana kulila kwa ng'ombe pamo ni ngondolo syakwe?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ŵajanjile kuti, “Ŵandu ŵangu ŵayijigele yeleyi kwa Aamaleki. Ŵajigele ng'ombe ni ngondolo syakwimbala kuti akasipelece mbopesi kwa AMBUJE Mlungu jwakusamlambila ŵalakwe. Nambo yine yosope tuyijonasile nditu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵamsalile kuti, “Basi mkapitilisya kuŵecetako soni! Une tinimsalile m'mwejo maloŵe gasalile une AMBUJE cilo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ŵajanjile kuti, “Asalile!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵatite kuti, “Atamose mkulidelela jika kuti mli ŵangasoseka, nambo m'manyilile kuti m'mwejo mli ŵakulongolela ŵa mitundu ja Aisalaeli. AMBUJE ŵamsagwile m'mwejo kuti mŵe mwenye jwa Aisalaeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵamtumisye m'mwejo ali ampele malamusi kukwajonanga ŵandu ŵakusakala ŵa Aamaleki. AMBUJE ŵamsalile m'mwejo kuti mkamenyane nawo mpaka mkawulaje wosope ŵene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.18",
            "verseOrgIds": [
              "1SA.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi sambano, ligongo cici nganimwapikanila AMBUJE? Ligongo cici mwawutucile kusumula ni kusunga yinyama yine kukuli kwapyesya mtima AMBUJE?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ŵajanjile kuti, “Iyayi, une nagapikanile maloŵe ga AMBUJE. Najawile mpela muŵandumile, namjigele Mwenye Agagi, nipo nawuleje Aamaleki wosope ŵene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.20",
            "verseOrgIds": [
              "1SA.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵandu ŵangu nginawulaga ngondolo ni ng'ombe syakwimbala siŵasumwile. M'malo mwakwe ŵayice nasyo akuno ku Giligala kuti asipelece kwa AMBUJE Mlungu jwawo mpela mbopesi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Samuele ŵatite kuti, “Ana AMBUJE akusasangalala ni cici: kupikanila maloŵe gakwe kapena yakupeleka ni mbopesi syakutinisya? Kuli cenene kwapikanila AMBUJE kulekangana ni kupeleka mbopesi syakutinisya sya ngondolo syakwimbala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.22",
            "verseOrgIds": [
              "1SA.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwajimucila AMBUJE kuli mpela usaŵi, nipo kulikwesya kuli mpela ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        },
        {
          "text": " wa kujilambila milungu jakupanganyidwa. Pakuŵapo wawo alikanile lilamusi lya AMBUJE, nombe nawo ŵakanile wawo kuti akaŵa mwenye.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Saulo ŵamsalile Samuele kuti, “Une ndemwisye pangapikanila Malamusi ga AMBUJE ni maloŵe ga wawojo gakungalamusya. Najogopaga ŵandu nipo natesile yiŵasosaga jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo sambano ngwaŵenda wawojo kuti, angululucile ulemwa wangu nipo tuwujileje yalumo, kuti ngalambile AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Samuele ŵajanjile kuti, “Une ngimbujila yalumo ni m'mwejo. Pakuŵapo m'mwejo mwagakanile Malamusi ga AMBUJE, myoyo nombe nawo ŵamkanile m'mwejo kuti mkaŵa mwenye jwa Aisalaeli.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Samuele ŵagalawice kuti ajawuleje, nambo Saulo ŵawukamwile mkanjo wakwe, nipo wapapwice.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.17"
              },
              "items": [
                {
                  "text": "1 Sam 28:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.30+1KI.11.31"
              },
              "items": [
                {
                  "text": "1 Ayi 11:30-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Samuele ŵamsalile Saulo kuti, “AMBUJE awupapwile ucimwene wa Aisalaeli kutyoka kwa m'mwejo lelo nipo ŵapele ŵane ŵali ŵambone kumpunda m'mwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu Jwa lumbili jwa Aisalaeli jangalambusya kapena kucenga nganisyo syakwe. Jwalakwejo nginaŵa mundu kuti mpaka asinde nganisyo syakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yakuwona Une nalemwisye,” Saulo ŵajanjile myoyo. “Nambope conde ngwaŵenda kuti anjimbicisye pameso pa acakulungwa ŵa ŵandu ŵangu ni pameso pa Aisalaeli wosope. Awujile yalumo ni une kuti ngalambile AMBUJE Mlungu jwawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Samuele ŵawujile yalumo ni Saulo, nipo Saulojo ŵalambile AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe Samuele ŵalamwile kuti, “Myice nawo Mwenye Agagi akuno.” Agagi ŵayice kwa jwalakwe ali mkutetemela mtande wa woga, ali mkuganisya asyenewo kuti, “Ana ni mucikusapwetecelaga mwakwe ciwa!” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵamsalile kuti, “Mpela muwutendele upanga wenu kwasandusya acakongwe ŵajinji kuŵa ŵangali ŵanace, myoyo soni sambano mama ŵenu taciŵa ŵangali mwanace pasikati pa acakongwe ŵane.” Nipo ŵamwuleje Agagi ni kumkatakata pasogolo pa malo gakupelecela mbopesi ku Giligala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Samuele ŵajawile ku Lama, nipo Mwenye Saulo ŵajawile kumangwakwe ku Gibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele nginawonegana najo soni Saulo pa umi wakwe wosope nambo kuti ŵamlililaga nditu, pakuŵa AMBUJE ŵamtyosisye Saulojo pa mpando wa kuŵa mcimwene jwakwalamulila Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        }
      ]
    }
