            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndunasyo syajile kukumsalila Saulo yiŵaŵecete Daudi yila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Saulo ŵasitumile ndunasyo kuti, akamsalile Daudi kuti, “Yakusosatu mwenye kuti yiŵe malipilo ga msonogwenujo ngaŵa yine yiliyoseyo iyayi, nambo songa sya mapende ga yilu ya Afilisiti 100 ŵawe pakusosa kuti aliwucisye pa amagongo ŵawo.” (Amu ni muŵaganicisyaga Saulo kuti Daudi awulajidwe ni Afilisiti). ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nduna sila syamsalile Daudi yiŵaŵecete Saulo, nipo Daudi ŵasangalele kuti aŵe mkwegwe jwa mwenye. Mkaniliyice lisiku lya ulombela, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ni ŵa ngondo ŵakwe ŵanyakwice kuja kukwawulaga Afilisiti 200. Ŵajigele songa sya mapende ga yilu yawo kuja nago kwa mwenye ni kuja kugaŵalanga gosope gene kuti jwalakwe aŵe mkwegwe jwawo. Myoyo Saulo ŵampelece mwanagwawo Mikala kuti alombele Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        }
      ]
    },
