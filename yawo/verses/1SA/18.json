          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneka Saulo ŵamanyilile kuti AMBUJE ŵaliji najo Daudi nipo soni kuti mwanagwawo Mikala ŵamnonyele Daudijo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yamtendesye Saulo kumjogopa mnope Daudi jula nipo ŵasandwice m'magongo jwakwe umi wawo wosope.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
      ]
    },
