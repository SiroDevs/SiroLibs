            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ndaŵi syosope siŵayikaga ŵa ngondo ŵa Afilisiti kukuputa ngondo, Daudi ŵapundaga mu ngondo syosope kwapunda ŵakulongolela wosope ŵa ngondo ŵa Saulo. Myoyo lina lya Daudi lyapikanice mnope.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
