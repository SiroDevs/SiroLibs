  "reference": "Ngeche 1",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PRO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Gima omiyo nondik kitabu mar Ngeche kod thoro mare",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeche mag Solomon wuod Daudi, ruodh Israel:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.1",
            "verseOrgIds": [
              "PRO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mamiyo iyudo rieko kod ritruok makare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:2"
      },
      "items": [
        {
          "text": "kendo winjo tiend weche matut;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo miyo idak e ngima moritore kendo mobidhore",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:3"
      },
      "items": [
        {
          "text": "kitimo gima adiera kendo gima kare kendo mowinjore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "gimiyo joma ngʼeyogi tin bedo mariek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:4"
      },
      "items": [
        {
          "text": "kendo gimiyo jomatindo ngʼeyo tiend weche kendo pogo tiend wach.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad jomariek chik itgi mondo owinji kendo gimedgi e puonjruokgi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "to jogo mongʼeyo pogo tiend wach mad oyud gino ma chikogi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo gingʼe ngeche, sigendini,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:6"
      },
      "items": [
        {
          "text": "kod weche ma tiendgi tek mag jorieko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro Jehova Nyasaye e chakruok mar ngʼeyo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:7"
      },
      "items": [
        {
          "text": "to joma ofuwo chayo rieko gi ritruok makare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Weche motelo: Jip mar rwako rieko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siem kuom hoch manono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, chik iti ni puonj wuonu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:8"
      },
      "items": [
        {
          "text": "kendo kik ijwangʼ puonj mar minu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginibedni kaka kondo michwowo e wiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:9"
      },
      "items": [
        {
          "text": "kendo kaka thiwni miketo e ngʼuti mondo ineri maber.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, ka joricho hoyoi mondo itim marach,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:10"
      },
      "items": [
        {
          "text": "kik iyienegi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kagiwachoni niya, \"Bi idhi kodwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "mondo wabuti ni ngʼato wanegi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "kendo wamonj kayiem nono joma onge ketho;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo wamuonygi ngili ka bur liel",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "mana ka joma omwony mangima gi bur;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabiro yudo gik moko duto mabeyo ma nengogi tek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:13"
      },
      "items": [
        {
          "text": "mi wapongʼ utewa gi gik moyaki.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "In bende riwri kodwa e wachni,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:14"
      },
      "items": [
        {
          "text": "kendo wanapog gigo duto mwayako.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, kik idhi kodgi ngangʼ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:15"
      },
      "items": [
        {
          "text": "kendo kik iwuoth e yoregigo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech tiendgi reto piyo piyo mar timo richo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:16"
      },
      "items": [
        {
          "text": "kendo gimwomore mondo gichwer remo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka en gima nono chiko obadho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:17"
      },
      "items": [
        {
          "text": "ka winy duto neno.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogi ochiko obadho ne gin giwegi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.18",
            "verseOrgIds": [
              "PRO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:18"
      },
      "items": [
        {
          "text": "kendo gin ema ginimokie!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.18",
            "verseOrgIds": [
              "PRO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
