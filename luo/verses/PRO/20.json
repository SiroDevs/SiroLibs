  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PRO 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Divai en jajaro to kongʼo en koko;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:1"
      },
      "items": [
        {
          "text": "ngʼat motelne kodgi onge rieko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirimb ruoth chalo gi ruto mar sibuor;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:2"
      },
      "items": [
        {
          "text": "ngʼat momiyo obedo gi gero lalo ngimane.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enobed luor maduongʼ ne ngʼatno ma dagi dhawo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:3"
      },
      "items": [
        {
          "text": "to joma ofuwo duto ohero dhawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasamuoyo ok pur puothe e kinde mowinjore;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:4"
      },
      "items": [
        {
          "text": "omiyo e kinde mar keyo omanyo, to ok oyud gimoro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwaro mar chuny dhano chalo gi pi matut,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:5"
      },
      "items": [
        {
          "text": "to ngʼat man-gi winjo twomogi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mangʼeny wacho ni gin gihera ma adiera;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:6"
      },
      "items": [
        {
          "text": "to ngʼat ma ja-adiera, en ngʼa ma diyude?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat makare nigi ngima ma ok ocha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:7"
      },
      "items": [
        {
          "text": "nyithinde nigi gweth bangʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ruoth obedo e kome mondo ongʼad bura;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:8"
      },
      "items": [
        {
          "text": "opiedho weche maricho duto gi wangʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa manyalo wacho niya, \"Aserito chunya maler;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:9"
      },
      "items": [
        {
          "text": "aler kendo aonge richo?\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rapim ma ok nikare gi pimo ma ok kare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:10"
      },
      "items": [
        {
          "text": "Jehova Nyasaye mon kodgi duto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mana nyathi ingʼeyo gi timbene,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:11"
      },
      "items": [
        {
          "text": "omiyo ingʼeyo ka kite obidhore kata ni kare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "It mawinjo gi wangʼ maneno,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:12"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ema osechweyo gik moko ariyogo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iher nindo nono to ibiro bedo jachan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:13"
      },
      "items": [
        {
          "text": "bed kineno to ok ibi chando chiemo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jangʼiewo wacho niya, \"Ok ber ngangʼ, ok ber ngangʼ!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:14"
      },
      "items": [
        {
          "text": "To bangʼe owuok odhiyo ka osungore ni ongʼiewo gi nengo mayot.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhahabu nitie, kendo kite ma nengogi tek bende nitie mogundho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:15"
      },
      "items": [
        {
          "text": "to dhok mawacho weche mag ngʼeyo gin kaka mula mabeyo mayudo tek.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaw law ngʼat mochungʼne ngʼat mokia kaka singo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.16",
            "verseOrgIds": [
              "PRO.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:16"
      },
      "items": [
        {
          "text": "mak gino mosingorego, ka otimo kamano ni dhako majabayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.16",
            "verseOrgIds": [
              "PRO.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiemo moyud e yo ma ok kare mit ne ngʼato,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.17",
            "verseOrgIds": [
              "PRO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:17"
      },
      "items": [
        {
          "text": "to achien omuodore mana ka kuoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.17",
            "verseOrgIds": [
              "PRO.20.17"
            ]
