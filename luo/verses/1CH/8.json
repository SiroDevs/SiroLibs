          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azel ne nigi yawuowi auchiel kendo magi e nying-gi:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:38"
      },
      "items": [
        {
          "text": "Azrikam, Bokeru, Ishmael, Shearia, Obadia kod Hanan. Magi duto ne yawuot Azel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
