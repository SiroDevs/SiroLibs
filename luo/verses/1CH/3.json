      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:23"
      },
      "items": [
        {
          "text": "Elioenai, Hizkia kod Azrikam; giduto ne gin yawuowi adek.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
