              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikwa Jehoyakin mane onywol ka en e twech ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        }
