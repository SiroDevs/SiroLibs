          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikwa Hanania ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        }
      ]
    },
    {
