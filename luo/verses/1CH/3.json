      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:21"
      },
      "items": [
        {
          "text": "Pelatia kod Jeshaya, gi yawuot Refaya ma joka Arnan, joka Obadia, kod joka Shekania.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        }
