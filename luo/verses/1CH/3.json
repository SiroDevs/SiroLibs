        "vid": "1CH 3:24"
      },
      "items": [
        {
          "text": "Hodavia, Eliashib, Pelaya, Akub, Johanan, Delaya kod Anani, giduto gin yawuowi abiriyo.",
          "type": "text",
          "attrs": {
