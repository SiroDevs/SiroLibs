  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "EXO 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chike mag Sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa noluongo ogendini mag jo-Israel duto kanyakla mi owachonegi niya, \"Gik ma Jehova Nyasaye ochikou mondo utim e magi:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom ndalo auchiel nyaka uti to odiechiengʼ mar abiriyo nobed odiechiengu maler, ma en Sabato mar yweyo ni Jehova Nyasaye. Ngʼato angʼata motimo tich chiengʼ Sabato nyaka negi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik umok mach e kar daku moro amora chiengʼ Sabato.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gik milosogo Hemb Romo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nowacho ni oganda jo-Israel duto niya, \"Ma e gima Jehova Nyasaye ochiko:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teruru chiwo ne Jehova Nyasaye kuom gik moko duto ma un-go. Ngʼato angʼata ma chunye oyie nyaka kel ne Jehova Nyasaye chiwo mag:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 35:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:5"
      },
      "items": [
        {
          "text": "\"dhahabu, fedha kod mula;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "law marambulu, maralik, marakwaro, law",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:6"
      },
      "items": [
        {
          "text": "mayom kod law mar yie diek;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "piende rombe molok gi range makwar, piende monyongʼ mayom mag le mag nembe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:7"
      },
      "items": [
        {
          "text": "yiend siala;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "mor zeituni miolo e taya mondo okel ler,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:8"
      },
      "items": [
        {
          "text": "gik mangʼwe ngʼar milosogo mor pwodhruok kod ubani mangʼwe ngʼar;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi oniks kod kite moko miketo kuom law mayom mar dolo miluongo ni efod kod law akor.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jotich duto molony mantie e kindu nyaka bi mondo olos gik moko duto ma Jehova Nyasaye osechiko kaka:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hemb Romo kod hembene ma oko, gi raumne, gi ramakine, gi sirnine gi bepene miriwo kod sirni gi rachungigi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi Sandug Muma, gi ludhene, gi raum mar kar pwodhruok kod pasia mogengʼe;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi mesa kod ludhene kaachiel gi gigene duto mag tich kod makati miketo e nyim Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
            "verseOrgIds": [
              "EXO.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bende gilos rachungi taya kod gigene duto kaka techene gi mo milielgo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
            "verseOrgIds": [
              "EXO.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gi kendo mar misango miwangʼoe ubani, kaachiel gi ludhene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:15"
      },
      "items": [
        {
          "text": "kod mor pwodhruok gi ubani mangʼwe ngʼar, gi pasia molier e dhood Hemb Romo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod kendo mar misango miwangʼo pep, gi singʼengene molos gi mula man kod ludhene gi gik moko duto mitiyogo e kendono kaachiel",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:16"
      },
      "items": [
        {
          "text": "gi karaya kod rachungine,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod pasia mag laru gi sirnine kod rachungigi kod pasia moumo kar donjo mar laru,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "loye mag hema gi loye mag laru gi tonde motwegigo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
            "verseOrgIds": [
              "EXO.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi lewni mochwe mag tij dolo mitiyogo e kama ler mar lemo ma gin lewni mag Harun jadolo kod lep yawuote ka gitiyogo kaka jodolo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka oganda mar jo-Israel duto noa e nyim Musa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.20",
            "verseOrgIds": [
              "EXO.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ji duto mane oyie kendo chunygi oelore nobiro mokelo mich ni Jehova Nyasaye kuom tich mar Hemb Romo gi tijene duto gi lewni mopwodhi mag dolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.21",
            "verseOrgIds": [
              "EXO.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji duto mane oyie, chwo kod mon, nobiro mokelo bangli gi sitadi mag dhahabu. Ji duto nokelo ne Jehova Nyasaye misango mifwayo mar dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.22",
            "verseOrgIds": [
              "EXO.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "to jomoko to nokelo law marambulu, kata maralik, kata marakwaro, kata yie diek, kata piende rombe molok makwar, kata piende monyongʼ mayom mag le mag nembe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.23",
            "verseOrgIds": [
              "EXO.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo mane kelo chiwo mar dhahabu kata fedha kata mula nokelogi kaka chiwo ni Jehova Nyasaye kendo ngʼato angʼata mane nigi yiend siala ne tich moro amora nokelo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.24",
            "verseOrgIds": [
              "EXO.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhako moro amora molony e twengʼo kod chwecho nokelo law marambulu, maralik kod marakwaro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.25",
            "verseOrgIds": [
              "EXO.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo mon duto mane chunygi oyie kendo olony e twengʼo nokelo yie diek.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.26",
            "verseOrgIds": [
              "EXO.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotelo nokelo kite mag oniks kod kite mamoko miketo e law mayom mar dolo miluongo ni efod kendo kuom law akor.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.27",
            "verseOrgIds": [
              "EXO.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende negikelo gik madum mangʼwe ngʼar gi mor zeituni miolo e taya to gi mor pwodhruok kod ubani mangʼwe ngʼar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.28",
            "verseOrgIds": [
              "EXO.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel duto machwo gi mamon mane chunygi oyie nokelo ni Jehova Nyasaye chiwo mar hera ne tich duto mane Jehova Nyasaye ochiko Musa mondo otim.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bazalel gi Oholiab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Musa nowacho ne jo-Israel niya, \"Winjuru, Jehova Nyasaye oseyiero Bezalel wuod Uri, ma wuod Hur, maa e dhood Juda,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo osepongʼe gi Roho mar Nyasaye, mondo obed gi lony, gi rieko, gi nyalo kod ngʼeyo tije duto mag lwedo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo omi ogor kido mabeyo mag dhahabu gi fedha kod mula,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ongʼad kite duto gi payo bao kendo mondo otim kit tije, duto mag lwedo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo osemiyo Bazalel, wuod Uri, ma wuod Hur, maa e dhood Juda kaachiel gi Oholiab wuod Ahisamak maa e dhood Dan rieko mar puonjo jomoko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osemiyogi rieko mar tiyo tije machalo kaka pecho, goro, chweyo lewni marambulu, maralik, marakwaro kod lewni mayom, ma gin tich joma nigi lony.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
      ]
    }
  ],
