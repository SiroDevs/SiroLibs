              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negilosone dhoranga Hemb Romo law mayom momin mar range marambulu, maralik kod marakwaro, ma en tich jachwecho molony;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
