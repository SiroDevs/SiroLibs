  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ROM 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wan joma otegno nyaka watingʼ nyawo mar joma yomyom ma ok watimo mana gik mamorowa wan wawegi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ka ngʼato kuomwa nyaka tim gik mamoro nyawadgi, ka en gi paro maber mar gere.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.2",
            "verseOrgIds": [
              "ROM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar kata Kristo bende ne ok otimo gik mamore en owuon, to mana kaka ondiki: \"Ayany duto mag joma yanyi nolwar kuoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar weche duto ma nondiki e ndalo machon, nondiki mondo opuonjwa, mondo kwachungʼ motegno kendo ka wajiwore gi Ndiko, to wanyalo bedo gi geno.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Nyasaye mamiyo ji kinda kendo ma jiwo ji, omi ubed gi chuny achiel e kindu uwegi, kendo kuluwo Kristo Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo ka un gi chuny achiel kendo uwacho gi chuny achiel kamano, to umi Nyasaye ma wuon Ruodhwa Yesu Kristo duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, rwakuru joweteu mana kaka Kristo bende norwakou eka Nyasaye oyud pak.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar anyisou ni Kristo osedoko jatich jo-Yahudi mondo ochop adiera mar Nyasaye, mondo omi singruok mane omi kwerewa otimre,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo joma ok jo-Yahudi omi Nyasaye duongʼ kuom kechne, mana kaka ondiki niya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:9"
      },
      "items": [
        {
          "text": "\"Emomiyo anapaki e kind ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:9"
      },
      "items": [
        {
          "text": "kendo anawer wende mapako nyingi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacho kendo niya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.10",
            "verseOrgIds": [
              "ROM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:10"
      },
      "items": [
        {
          "text": "\"Moruru un joma ok jo-Yahudi kaachiel gi joge,\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.10",
            "verseOrgIds": [
              "ROM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo niya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.11",
            "verseOrgIds": [
              "ROM.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:11"
      },
      "items": [
        {
          "text": "\"Pakuru Jehova Nyasaye un joma ok jo-Yahudi duto,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.11",
            "verseOrgIds": [
              "ROM.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:11"
      },
      "items": [
        {
          "text": "ee ji duto mondo odende,\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.11",
            "verseOrgIds": [
              "ROM.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya bende wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:12"
      },
      "items": [
        {
          "text": "\"Nyakwar Jesse nobi,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:12"
      },
      "items": [
        {
          "text": "en ema nowuogi mondo otel ni joma ok jo-Yahudi,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:12"
      },
      "items": [
        {
          "text": "kendo ogendini nogen kuome.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.12",
            "verseOrgIds": [
              "ROM.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Nyasach geno opongʼu gi mor kod kwe mogundho ka ugeno kuome, mondo omi upongʼ gi geno malach kuom teko mar Roho Maler.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo jatich e kind joma ok jo-Yahudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowetena, angʼeyo chutho ni un joma beyo kendo mariek kendo ngʼato ka ngʼato kuomu nyalo puonjo nyawadgi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, asendikonu kuom weche moko ka an gi chir mana mondo aparnugi, kendo kuom ngʼwono ma Nyasaye omiya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar bedo Jatich Kristo Yesu e kind joma ok jo-Yahudi, ka atiyo tich dolo mar lando Injili Maber mar Nyasaye mondo ogendini obed misango maler ma Nyasaye oyiego kendo ma Roho Maler opwodho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emomiyo ei Kristo Yesu anyalo sungora kuom tichna matiyo ni Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.17",
            "verseOrgIds": [
              "ROM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ok anyal hedhora mar wacho gimoro amora, makmana gigo ma Kristo osetimo kotiyo koda kuom loko joma ok jo-Yahudi mondo oluor Nyasaye, kuom wechena gi timbena,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.18",
            "verseOrgIds": [
              "ROM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotiyo gi teko mar honni gi ranyisi kuom teko mar Roho Maler mar Nyasaye. Kamano aselworora e piny Jerusalem nyaka Iliriko, kalando Injili mar Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.19",
            "verseOrgIds": [
              "ROM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseketo chunya mondo ayal Injili kuonde ma ji pok ongʼeyoe Kristo, mondo kik agedi ewi mise ma ngʼat machielo ema nochako.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "To mana kaka ondiki ni:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 15:21"
      },
      "items": [
        {
          "text": "\"Joma ne pok onyis wach kuome none",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 15:21"
      },
      "items": [
        {
          "text": "kendo jogo mapok owinjo kuome nowinj tiend wach.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma emomiyo asetemo ndalo mangʼeny mar biro iru to osetama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo ochano limbe Rumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kaka koro onge kuonde modongʼ ma anyalo tiye e gwengegi, kendo nikech asebedo ka anenou kuom higni mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "achano mar timo kamano kadhi Spania. Ageno mar limou ka abiro akadho mondo bangʼ bedo kodu moromo to ukonya e wuodhano.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sani to pod an e wuodha adhi Jerusalem mondo adhi akony jomaler man kuno.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar jo-Makedonia gi jo-Akaya osechiwo kony gimor ne jomaler modhier man Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.26",
            "verseOrgIds": [
              "ROM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negimor mar timo ma, to chutho gin jogop jogo. Nimar owinjore mondo joma ok jo-Yahudi, moseyudo konyruok mar chuny mar jo-Yahudi opog negie mwandu mag pinyni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ka asechopo wuodhani, kendo ka aseneno ni giyudo olemoni, to abiro dhi Spania, kendo anaraw alimu kakadho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼeyo ni ka abiro iru to anabi katingʼo gweth mogundho mar Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owetena, ajiwou kuom Ruodhwa Yesu Kristo, kendo kuom hera mar Roho, mondo uriwru koda e nyagruokna, kulamona Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamnauru mondo Nyasaye oresa e lwet joma odagi yie man Judea, kendo mondo jomaler man Jerusalem orwak tich ma atimo e diergi,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo ka Nyasaye oyie to abi iru ka amor kendo mondo ka an kodu to uduog chunya, to an bende aduog chunyu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasach kwe mondo obed kodu uduto. Amin!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
          }
        }
      ]
    }
  ],
