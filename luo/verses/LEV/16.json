          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koro chik momakou nyaka chiengʼ ema: Pwodhruok kuom richo duto mag jo-Israel nyaka tim dichiel e higa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
