              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Paulo osetieko wacho wechegi, nogoyo chonge piny kaachiel kodgi duto mi nolemo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
