              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asenyisou gi yore duto ni nyaka wati matek wan wawegi mondo wakonygo joma chandore, ka waparo wach mane Ruoth Yesu owachonwa ni,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
