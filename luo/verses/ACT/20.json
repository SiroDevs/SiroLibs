          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pok agombo fedha kata dhahabu kata law ngʼato.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
