          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un uwegi ungʼeyo ni lwetenagi osetiyo matek mi ochopo dwarona duto, nyaka dwaro mag jowadwa mwayalogo Injili.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
