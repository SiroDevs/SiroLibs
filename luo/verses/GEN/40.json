{
  "id": "GEN.40",
  "number": "40",
  "bookId": "GEN",
  "reference": "Chakruok 40",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "GEN 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jagam divai gi jatend makati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ndalo moko jagam divai kod jated makati mar Farao ruodh Misri nochwanyo ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirima nomako Farao gi jotichge ariyogo, ma gin jotend jagam divai kod jatend joma tedo makati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.2",
            "verseOrgIds": [
              "GEN.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo noketogi e od twech kama jatend askeche mar od twech notweyoe Josef.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.3",
            "verseOrgIds": [
              "GEN.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jatend askeche noketogi e lwet Josef mondo oritgi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 40:4"
      },
      "items": [
        {
          "text": "Bangʼ kane gisebedo e od twech kuom kinde moko,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "moro ka moro kuom ji ariyogi mane gin jatend jogam divai kod jatend joted makati mar ruodh Misri mane oyudo otwe, noleko lek otienono moro ka moro, kendo lek ka lek ne nigi tiende mopogore gi machielo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.5",
            "verseOrgIds": [
              "GEN.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Josef obiro irgi kinyne gokinyi, noneno ka chunygi ool.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.6",
            "verseOrgIds": [
              "GEN.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano nopenjo jatich Farao mane ni kode e od twechgo niya, \"Angʼo ma omiyo uol kawuono?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.7",
            "verseOrgIds": [
              "GEN.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidwoke niya, \"Waduto nyoro waleko lek mopogore opogore, to onge ngʼama nyalo lokonwa tiendgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 40:8"
      },
      "items": [
        {
          "text": "Eka Josef nowachonegi niya, \"Donge fwenyo tiend lek aa mane kuom Nyasaye? Emomiyo yieuru unyisa lekugo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano jatend jogam Divai nonyiso Josef lek mane oleko. Nowachone niya, \"E lekna nende aleko ni aneno yadh mzabibu e nyima,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.9",
            "verseOrgIds": [
              "GEN.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo e yadh mzabibuno ne nitie bede adek. Kane ochako loth, nogolo thiepene kendo neginyago mzabibu mochiek mana gikanyono.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.10",
            "verseOrgIds": [
              "GEN.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikombe Farao ne ni e lweta, kendo nakawo olembe mag mzabibu mi abiyogi e kikombe mar Farao kendo aketo kikombe e lwete.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.11",
            "verseOrgIds": [
              "GEN.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef nowachone niya, \"Ma e tiend lek mane ilekono. Bede yadh mzabibu adekgo nyiso ndalo adek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ndalo adek Farao biro gonyi kendo dwoki e tiji, kendo ibiro keto kikombe Farao e lwete mana kaka yande kitimo kane in jatingʼ divai mare.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka gik moko duto otimoreni maber, ipara kendo itimna ngʼwono; iwuona gi Farao mondo ogola e od twech.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech nomaka githuon ka igola e piny jo-Hibrania, kendo kata mana kaonge gima rach ma asetimo manyalo miyo abedie od twech ka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jatend joted makati oneno ni Josef oloko tiend lek maber, nowachone Josef niya, \"An bende ne aleko kama: Atonge adek mag makati ne ni e wiya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.16",
            "verseOrgIds": [
              "GEN.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ei atonga mamalo ne nitie chiemo duto motedi ni Farao, to winy ne chamogi ei atonga mamalono.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.17",
            "verseOrgIds": [
              "GEN.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef nowachone niya, \"Ma e tiend leknino. Atonge adek nyiso ndalo adek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapok okadho ndalo adek Farao biro golie od twech, kendo obiro ngʼado wiyi oko manolieri e yath kendo winy biro chamo ringri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro odiechiengʼ mar adek ne en odiechieng rapar mar nywol Farao, kendo noloso nyasi ne jotije duto. Nogonyo jatend jogam divai kod jatend joted makati moketogi e nyim jodonge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.20",
            "verseOrgIds": [
              "GEN.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodwoko jatend jogam divai e tije, mondo omi ochak oket kikombe e lwet Farao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.21",
            "verseOrgIds": [
              "GEN.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "to jatend joted makati nonego, mana kaka Josef noselokonegi tiend lekgi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.22",
            "verseOrgIds": [
              "GEN.40.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano jatend jogam divai ne ok oparo Josef; wiye nowil kode.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.23",
            "verseOrgIds": [
              "GEN.40.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.41",
    "number": "41",
