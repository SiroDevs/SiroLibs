  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "GEN 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dina gi jo-Shekem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ moro Dina, nyar Jakobo mane Lea onywolone nodhi limo nyi pinyno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Shekem wuod Hamor ja-Hivi ma jatend gwengʼno, nonene, nomake moterore kode.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunye nokete kuom Dina nyar Jakobo omiyo nohere kendo nowuoyo kode gi ngʼwono mathoth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.3",
            "verseOrgIds": [
              "GEN.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Shekem nowacho ni wuon mare Hamor niya, \"Nyuomna nyakoni obed chiega.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jakobo owinjo ni Dina nyare osedwany to ne ok owacho gimoro nyaka yawuote noduogo dala koa kwayo jambe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Hamor ma wuon Shekem nodhi mowuoyo gi Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.6",
            "verseOrgIds": [
              "GEN.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane yawuot Jakobo owinjo gima nosetimore, negidwogo dala mapiyo nono ka gia kuonde mag kwath. Igi nowangʼ ahinya kendo negikuyo, nikech tim anjawo mane Shekem osetimo ni Dina nyamin-gi e piny Israel, tim mamono ma ok owinjore.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Hamor nowacho ne Jakobo niya, \"Wuoda Shekem chunye oseketo kuom nyari. Asayi yie ichiw nyari obed jaod Shekem.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.8",
            "verseOrgIds": [
              "GEN.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakend nyiu to un bende ukend nyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.9",
            "verseOrgIds": [
              "GEN.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unyalo dak e dierwa; pinyni en maru dagieuru, timeuru ohala kendo uyudieuru giu uwegi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Shekem nowacho ne wuon Dina kod owete Dina niya, \"timnauru ngʼwono kendo abiro miyou gimoro amora ma ukwayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyisauru gik ma onego anyuomnu kata ma onego amiu kaka uhero, kendo abiro chulou gimoro amora ma ukwaya ka uyie miye nyaminu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Jakobo nodwoko Shekem gi Hamor wuon mare ka giwuondore nikech Shekem nosedwanyo Dina nyamin-gi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.13",
            "verseOrgIds": [
              "GEN.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiwachonegi niya, \"Ok wanyal timo gima kamano; ok wanyal chiwo nyaminwa ne ngʼama ok oter nyangu, mano dibed wichkuot ne wan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.14",
            "verseOrgIds": [
              "GEN.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiro yienu mana ka utimo gimoro achielni: mondo ubed kaka wan ka utero yawuotu duto nyangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka wabiro miyou nyiwa kendo wan bende wabiro kawo nyiu. Wabiro dak kodu kendo wabiro bedo oganda achiel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
              "GEN.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ok unyal yie mondo oteru nyangu to wabiro kawo nyaminwa mi wadhigo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima negiwachono nonenore maber ne Hamor kod wuode Shekem.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Shekem mane omi duongʼ e od wuon-gi, ne ok odeko timo gima ne yawuot Jakobo owacho, nikech nomor gi Dina nyar Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Hamor gi wuode Shekem nodhi e dhoranga dalagi mondo giwuo gi jothurgi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.20",
            "verseOrgIds": [
              "GEN.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiwachonegi niya, \"Jogi gin osiepewa. We gidag e pinywa kendo gilokie; pinywani duongʼ moromogi. Wanyalo kendo nyigi kendo gin bende ginyalo kendo nyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.21",
            "verseOrgIds": [
              "GEN.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok ginyal yie dak kodwa mondo wabed oganda achiel kodgi makmana ka chwo duto oter nyangu mana kaka gin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.22",
            "verseOrgIds": [
              "GEN.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge kwethgi, gi gigegi kod jambgi duto biro bedo mawa? Omiyo ka wayie timo kamano eka giniyie dak kodwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.23",
            "verseOrgIds": [
              "GEN.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji duto mane odhi e dhoranga dala noyie gi Hamor kod Shekem wuode kendo chwo duto mane ni e dalano noter nyangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ndalo adek kane pod gin kod rem, yawuot Jakobo ariyo, Simeon kod Lawi mowete Dina, nokawo gigegi mag lweny mi gidonjo e dala jogo apoya kendo ginego joma chwo duto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neginego Hamor gi Shekem wuode, eka negigolo Dina e od Shekem mi giago.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Jakobo mamoko nomonjo joma ne owetegi osenego mi giyako dala maduongʼni nikech jogo nosekuodo wi nyamin-gi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negipeyo kwethgi gi dhogi gi pundegi kod gigegi duto mane ni e dala kod mago mane ni oko e pap.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negikawo mwandugi duto, mondgi duto, nyithindgi duto kod gik moko duto mane ni e udi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jakobo nowacho ne Simeon gi Lawi niya, \"Usekelona chandruok maduongʼ ka umiya nying marach e kind jo-Kanaan kod jo-Perizi, ma weg pinyni. Wan ji manok, kendo kagiriworenwa mondo giked kodwa e lweny, to an kod oda ibiro tieka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.30",
            "verseOrgIds": [
              "GEN.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "To negidwoko wuon-gi niya, \"Bende en gima ber mondo timne nyaminwa tim marach mane otimne cha?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.31",
            "verseOrgIds": [
              "GEN.34.31"
            ]
          }
        }
      ]
    }
  ],
