  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JER 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowachona kama: \"Kata dabed ni Musa gi Samuel ema nyalo chungʼ e nyima, to ok anyal weyonegi richogi. Golgi oko e nyima! Wegi gidhi!",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka gipenji ni, 'Ere kama wanyalo dhiyoe?' To nyisgi ni, 'Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "\" 'Mago matho ochomo, tho nonegi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "mago ma ligangla ochomo, noneg gi ligangla;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "to mago ma kech ochomo, kech nonegi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "to mago ma twech ochomo, noter e twech.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye owacho niya, \"Abiro oro masiche angʼwen mopogore opogore, ma gin ligangla mar nek kod guogi maywayo gi mabor gi winy mafuyo e kor polo gi ondiegi mag bungu mondo okidhgi kendo tiekogi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anami pinjeruodhi duto mag piny bed gibuok kuomgi nikech gima Manase wuod Hezekia ruodh Juda notimo e Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ere ngʼama nokechi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "yaye Jerusalem? Ere ngʼama biro ywagi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Ere ngʼama nochungʼ ma penji kaka idhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye owacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "\"Isedaga. Isiko mana kibaro iweyo yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "Omiyo anaket lweta kuomi kendo tieki;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "ok anatimni ngʼwono kendo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapiedhgi gi odhech pietho e dhorangeye",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "mag dala maduongʼ mar piny.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "Anakel lit kod kethruok ne joga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "nimar gitamore loko yoregi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anami mon ma chwogi otho mag-gi bedo mathoth",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "moloyo kwoyo manie dho nam.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "E odiechiengʼ tir anakel ngʼama nego mana rowere;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "kendo apoya nono anakelnegi lit kod bwok maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyo man-gi nyithindo abiriyo",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "nobed mool matho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "To chiengʼ marienyne nopodhi kapod en odiechiengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "wiye nokuodi kendo chunye nochandre.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Ananeg jogo motony gi ligangla,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "e nyim wasikgi,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuololo, minwa, angʼo momiyo ne inywola,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "an ngʼat ma piny ngima piemgo kendo kedogo!",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "Pok aholo ngʼato kata an bende pok ohola,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "to kata kamano ji duto kwongʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "\"Adier anaresi gi gima omiyo maber;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "adier anami wasiki sayi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "e kinde mag masira kod kinde mag thagruok.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende dhano nyalo turo chuma,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:12"
      },
      "items": [
        {
          "text": "chuma moa yo nyandwat kata mula?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
