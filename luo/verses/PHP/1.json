{
  "id": "PHP.1",
  "number": "1",
  "bookId": "PHP",
  "reference": "Jo-Filipi 1",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PHP 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Paulo gi Timotheo ma wasumb Kristo Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PHP 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "PHP 1:1"
      },
      "items": [
        {
          "text": "Wandikonu un jomaler duto mag Kristo Yesu man Filipi, kaachiel gi jokwadh jo-Kristo duto gi jokonygi:",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼwono kod kwe mar Nyasaye Wuonwa kod Ruoth Yesu Kristo, obed kodu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Goyo erokamano kod lamo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adwokone Nyasacha erokamano seche duto ma aparoue.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde duto ka alemonu, to alemonu gi mor,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.4",
            "verseOrgIds": [
              "PHP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech riwruok maru kodwa e tij lando Injili chakre odiechiengʼ mokwongo nyaka koroni,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omiyo koro an gichir malongʼo ni Jal mane ochako tich maberno e chunyu biro dhi kode nyime nyaka chop orum e odiechieng Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En gima kare mondo apar kamano kuomu uduto nikech agenou e chunya; kata ka an e twech kata ka asiro adiera mar Injili kendo ajiwe to un uduto usebedo koda e achiel kuom ngʼwono mar Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye owuon nyalo timo nenda kaka chunya gombou duto ka an-gi hera matut mar Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo ma e lamona mondo herau omedre mathoth ahinya kuom rieko kod ngʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo mondo ubed gi rieko mar yiero mana timo gima ber kende. Kamano ngimau nobed maler kendo maonge bura, nyaka chop odiechieng Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.10",
            "verseOrgIds": [
              "PHP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngimau nopongʼ gi olemo mag timbe makare maa kuom Yesu Kristo mondo Nyasaye oyud duongʼ kod pak.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Twech Paulo omedo lando Injili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jowetena, koro adwaro ni ungʼe, ni gik mosetimorena osemiyo Injili omedo landore.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, koro osengʼere malongʼo ne askeche dala ruoth duto, kod ji mamoko duto ni otweya nikech Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedona e twech osemiyo jowete mathoth odoko thuondi kuom Ruoth, mi giyalo Wach Nyasaye gi chir maonge luoro.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "En adier ni jomoko lando wach Kristo ka gin-gi ich lit kod miero, to jomoko to lande ka chunygi ni kare.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma lando Injili gi chuny makarego lendo gihera, ka gingʼeyo ni oketa e twech mondo aked matek ni Injili.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma lando Kristo ka gin-gi ich lit gi miero to timo kamano mondo oyud duongʼ, ka giparo niginyalo medona chandruok ka pod an e od twech.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To onge wach! Gima duongʼ en ni wach Kristo ilando e yore duto; kata gi chuny marach, kata maber, kendo mano medo miya mor moloyo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "PHP 1:18"
      },
      "items": [
        {
          "text": "Ee, kendo pod abiro medo bedo mamor,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech angʼeyo ni kuom lemo mulemonago kod kony ma ayudo kuom Roho mar Yesu Kristo, gik mosetimorenago ema bende biro kelona resruok.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwarona maduongʼ kod genona en ni ok anane wichkuot, to ni abiro bedo gi teko moromo mondo Kristo osik ka yudo duongʼ e ringra kaka pile, bed ni angima kata atho.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech an aneno ni ka angima, to angima nikech Kristo, to ka atho to en ohala.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane anyalo medo bedo mangima e ringruok, to mano nyiso ni abiro medo tiyo tich makelo ohala. To koro dayier angʼo? Ok angʼeyo gima dayier!",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiero otama e kind gik mabeyo ariyogi: Chunya gombo ni atho mondo adhi abed gi Kristo, kendo mano en gima ber moloyo,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "to daher moloyo mondo amed bedo mangima e ringruok nikech un.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech chunya nigi ratiro chutho ni pod onego akonyu, kendo angʼeyo chutho ni pod abiro bet kodu duto mondo ami umed geroru kendo ubed mamor e yie maru,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo omi bedona kodu kendo omedu mor moloyo kuom Kristo Yesu nikech an.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata obedo ni angʼo motimore, to usik kudak e kit ngimau mapile mowinjore gi Injili mar Kristo. Kata ka abiro nenou, kata ka ok abiro, to adwaro winjo ni uchungʼ motegno gi chuny achiel kendo gi paro achiel mondo ukedni adiera mar Injili,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.27",
            "verseOrgIds": [
              "PHP.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ok obwogu e yo moro amora, gi joma kwedou. Mano biro bedonegi ranyisi ni ibiro tiekgi, to un ibiro resu kendo Nyasaye ema biro timo mano.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech dhial museyudo kuom Kristo ok en mana mondo uyie kuome kende, to oseluongu bende mondo une masiche nikech en,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
            "verseOrgIds": [
              "PHP.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech ukedo lweny nogo mane unena kakedo e kinde mokalo, kendo ma pod uwinjo ni akedo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.30",
            "verseOrgIds": [
              "PHP.1.30"
            ]
          }
        }
      ]
    }
  ],
