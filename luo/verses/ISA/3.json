      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:26"
      },
      "items": [
        {
          "text": "kendo dalano nodongʼ nono kokethore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
              "ISA.3.26"
            ]
          }
        }
