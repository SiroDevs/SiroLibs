      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:25"
      },
      "items": [
        {
          "text": "kendo jolweny magu norum e lweny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        }
      ]
    },
    {
