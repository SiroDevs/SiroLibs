            "number": "13",
            "style": "v",
            "sid": "ISA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye osebedo e kom bura",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.13",
            "verseOrgIds": [
              "ISA.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:13"
      },
      "items": [
        {
          "text": "mondo ongʼad bura ne oganda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.13",
            "verseOrgIds": [
              "ISA.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa ngʼado bura mar Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:14"
      },
      "items": [
        {
          "text": "kuom jodongo kod jotend joge osechopo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:14"
      },
      "items": [
        {
          "text": "kowacho niya, \"Un ema useketho puotha mar mzabibu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:14"
      },
      "items": [
        {
          "text": "kendo gik ma uyako kukawo e ut joma odhier opongʼo uteu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.14",
            "verseOrgIds": [
              "ISA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "En angʼo momiyo usando",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:15"
      },
      "items": [
        {
          "text": "kendo uthiro joga modhier?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:15"
      },
      "items": [
        {
          "text": "Ruoth Nyasaye, ma en Jehova Nyasaye Maratego ema owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
