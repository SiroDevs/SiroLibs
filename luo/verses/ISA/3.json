  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "ISA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum ne Jerusalem kod Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neuru koro Ruoth Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "ma en Jehova Nyasaye Maratego,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "biro tieko mich kod kony",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "mikelo ne Jerusalem kod Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "Notiek kit chiemo duto kod pi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "thuondi maroteke kod jolweny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "gi jongʼad bura gi jonabi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "gi jokor wach kod jodongo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "jatend lweny morito ji piero abich gi joma ogen,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:3"
      },
      "items": [
        {
          "text": "jongʼad rieko, jopecho molony kod joma olony e wach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaket mana yawuowi obed jotendgi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:4"
      },
      "items": [
        {
          "text": "to rawere matindo noritgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji nosandre kendgi giwegi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "ka ngʼato sando mana wadgi owuon",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "bende jogo modak mokiewo nosandre kendgi giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "Jomatindo notug lweny gi jomadongo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "kendo ji ajiya nocha joma ogen.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato nochun achiel kuom owetene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "manie dala wuon-gi kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "\"In ema in-gi lep loch, koro telnwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "kendo ibed gi teko ewi pinywa mokethoreni.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e kindeno ngʼatno nodwoki niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "\"Ooyo ok dabed ruodhu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "nimar aonge gi chiemo kata lewni e oda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "madimi uketa abed jatend ogandani.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusalem yiengni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "bende Juda mukore;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "wechegi kod timbegi opogore gi dwach Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "nimar ok omi duongʼne nenre e diergi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangʼ-gi nyiso ni gin joricho",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "kendo richogi oyangore e lela mana ka richo mane ni Sodom,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "bende gionge gi wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "Yaye, mano kaka ginine malit",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "nikech gisekelo masira kuomgi giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kone joma kare ni gin johawi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:10"
      },
      "items": [
        {
          "text": "nimar giniyud pok kuom tichgi matek.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye, mano kaka nobed malit ne joricho nikech masira nobed kuomgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "Enokumgi kuom gik maricho ma lwetgi osetimo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomatindo ema thiro joga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:12"
      },
      "items": [
        {
          "text": "kendo mon ema jotendgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:12"
      },
      "items": [
        {
          "text": "Yaye joga, jotendu osewuondou,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:12"
      },
      "items": [
        {
          "text": "momiyo ubaro uweyo yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
