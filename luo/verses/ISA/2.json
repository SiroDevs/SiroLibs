  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ISA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Got mar Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e fweny mane Isaya wuod Amoz noneno kuom Juda kod Jerusalem:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ndalo giko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "got mogerie hekalu mar Jehova Nyasaye nobed gi teko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "e kind gode duto molwore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "kendo ibiro tingʼe malo moyombo gode duto",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "kendo ogendini duto nobi ma pongʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini mangʼeny nobi kawacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "\"Biuru wadhi e got mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "e od Nyasach Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Enopuonjwa wechene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "mondo wawuothie e yorene.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Chik nowuog Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "kendo wach Jehova Nyasaye nowuog koa Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro ngʼado bura e kind ogendini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "kendo nokel kwe e kind ogendini mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Ginithedh ligengligi olokre kwe mag pur",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "kendo tongegi ginithedhi olokre pende keyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Onge piny mano kedi gi nyawadgi gi ligangla",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "bende ok ginichak gipuonjre ne lweny kendo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye od Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:5"
      },
      "items": [
        {
          "text": "biuru mondo wawuoth e ler mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Odiechieng Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, isejwangʼo jogi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "jogi ma nyikwa Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "Gipongʼ gi timbe mag mudho kod timbe mag jwok moa yo wuok chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "gitimo timbe jwok ka jo-Filistia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "kendo gin e winjruok gi joma ok oyie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinygi opongʼ gi fedha kod dhahabu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "kendo mwandugi okadho akwana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "Pinygi opongʼ kod farese;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "ngechegi mag lweny okadho akwana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinygi opongʼ kod nyiseche manono;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "gilamo gik ma gipayo kod lwetgi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "gigo ma lwetgi ema oloso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo dhano nodwok piny",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "kendo ogendini mangʼeny noma teko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "kuom mano ok nowenegi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donjuru e buche manie kind lwendni, ponduru e buche manie lowo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "ka luoro omakou nikech,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "duongʼ malich mar Jehova Nyasaye kod tekone!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangʼ teko mar ngʼama janjore nothir",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:11"
      },
      "items": [
        {
          "text": "kendo sunga mag ji nodwok piny;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:11"
      },
