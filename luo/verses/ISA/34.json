  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "ISA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum ne ogendini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suduru machiegni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "un ogendini kendo chikuru itu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "winjuru, un ogendini!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "Mad piny kod gik moko manie iye winja!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nigi ich wangʼ kod ogendini duto;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "mirimbe ochomo jolweny mag-gi duto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "Obiro tiekogi duto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "mi nochiwgi mondo otiekgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogi monegi nowit oko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "mi ringregi nodungʼ kendo rembgi nopongʼ gode.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulwe duto manie polo noleny nono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "polo noban mana ka kalatas,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "gik moko duto manie polo malo nolwar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "mana ka it mzabibu moner,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "kata ka olemb ngʼowu ma kundi ochwowo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liganglana osetieko tichne e kor lwasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "neuru, olor mondo ongʼad bura ne Edom,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "oganda ma asetieko chuth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligangla mar Jehova Nyasaye opongʼ gi remo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "kendo boche ogawore kuome ma gin, remb rombe kod diek,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "kaachiel gi boche moa e nyiroke mag imbe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "Nimar Jehova Nyasaye nigi misango Bozra kod nek ei Edom.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo jope, gi nyirwedhi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "kod rwedhi madongo nopodh kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "Pinygi nopongʼ gi remo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "kendo boche noum buru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar Jehova Nyasaye ni kod odiechienge mar chulo kuor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:8"
      },
      "items": [
        {
          "text": "ma en higa mar chiwo kum ne jogo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:8"
      },
      "items": [
        {
          "text": "mosetimo marach ne Sayun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aore mag Edom nobar okak,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "lopene nolokre lot maliet mawengʼo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "kendo pinye nowangʼ duto!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok nokwe odiechiengʼ gotieno;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "iro mare nodum kanyo nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "Koa e tiengʼ moro nyaka machielo nodongʼ gunda;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "onge ngʼat manochak oluwe kendo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobed kama winj tula rutoe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:11"
      },
      "items": [
        {
          "text": "kendo agak odakie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:11"
      },
      "items": [
        {
          "text": "Nyasaye nopim timbe maricho",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:11"
      },
      "items": [
        {
          "text": "mag Edom kod ketho mage.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodonge ok nobed gi gimoro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:12"
      },
      "items": [
        {
          "text": "miluongo ni pinyruoth,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
