  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "ISA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wach mokor kuom Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e wach mokor kuom Holo mar Fweny:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "Koro angʼo mathagou momiyo un duto uidho ewi udi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye in dala ma mahu opongʼo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "yaye dala maduongʼ ma koko gi mor kod ilo opongʼo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "Jogi mane otho ok noneg gi ligangla",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "to bende ne ok githo e lweny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotendu duto oseringo kaachiel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "osemakgi ma ok oti gi gige lweny moro amora.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "Un duto mane uringo ka wasigu ne pod ni mabor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "osemaku kanyakla moteru e twech.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano ne awacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "\"Weyauru aweya mondo aywag malit.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "Weuru hoya nikech jowa osetieki.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth Nyasaye ma en Jehova Nyasaye Maratego",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "oseketo odiechieng mahu gi koko kod masira e Holo mar Fweny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "en odiechiengʼ mar muko ohinga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "kendo nduru nowuog malit kochomo ewi gode.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Elam kawo aserni mag-gi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "kaachiel gi joriemb geche mag lweny gi farese;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "to jo-Kir to nokawo kuodigi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Holniu mabeyo opongʼ gi geche mag lweny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:7"
      },
      "items": [
        {
          "text": "kendo joidh farese osechielo rangeye mag dala maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth Nyasaye oselonyo mabor tekre Juda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "kendo e kindeno ne umanyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "gige lweny manie Od Ruoth manie Bungu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne uneno ka kuonde mangʼeny mar ohinga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "mar Dala Maduongʼ mar Daudi omukore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "omiyo ne uchiko pi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "odhi e soko mamwalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gikwano ute mag Jerusalem",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:10"
      },
      "items": [
        {
          "text": "kendo ne gimukogi mondo olosgo ohinga motegno.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gikunyo yawo e kind ohinga ariyogo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "ne pi mawuok e soko machon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "to ne ok upenjo Jal mane olose,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "kata miyo Jalno mane ochane luor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Ruoth Nyasaye ma en Jehova Nyasaye Maratego,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "ne oluongou odiechiengno mondo uywagi kendo udengi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:12"
      },
      "items": [
        {
          "text": "ka upudho yie wiu kendo urwako pien gugru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano nitie mor kod ilo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "kaachiel gi yangʼo dhok kod rombe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "chamo ringʼo kod madho divai!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "Giwacho niya, \"We wachiem kendo wamethi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:13"
      },
      "items": [
        {
          "text": "nikech kiny wanatho!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Maratego osefwenyona ma kawinjo: \"Richoni ok nopwodhi nyaka chop thou,\" Ruoth Nyasaye ma en Jehova Nyasaye Maratego owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Ruoth Nyasaye ma en Jehova Nyasaye Maratego wacho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:15"
      },
      "items": [
        {
          "text": "Dhi ir jakeno mar od ruoth miluongo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:15"
      },
      "items": [
        {
          "text": "ni Shebna mondo iwachne niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "En angʼo ma itimo ka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "kendo en ngʼa manomiyi thuolo mar kunyo buri ka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "momiyo iloso bur kama otingʼore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:16"
      },
      "items": [
        {
          "text": "kendo iloso kari maber mar yweyo e kind lwanda?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed motangʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:17"
      },
      "items": [
        {
          "text": "Jehova Nyasaye chiegni ngʼwasi mi owiti oko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:17"
      },
      "items": [
        {
          "text": "yaye in ngʼat maratego.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.17",
            "verseOrgIds": [
              "ISA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro ngʼwasi motweyi matek",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "kendo owiti e piny malach mana ka mipira mowiti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "Kuno ema nithoe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "kendo kuno ema gecheni mag lweny mabeyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:18"
      },
      "items": [
        {
          "text": "nosikie in mikelo wichkuot ne od ruodhi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.18",
            "verseOrgIds": [
              "ISA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro goli e kari mar tich",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.19",
            "verseOrgIds": [
              "ISA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:19"
      },
      "items": [
        {
          "text": "kendo goli e loch mari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.19",
            "verseOrgIds": [
              "ISA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno analuong jatichna Eliakim ma wuod Hilkia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anarwake gi law mar duongʼ kendo anatwe okanda e nungone mi anamiye loch mari. Enobed wuon joma odak Jerusalem kod Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamiye rayaw mar od Daudi, ma gima oyawo ngʼato ok lor, to bende gima oloro onge ngʼama yawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
            "verseOrgIds": [
              "ISA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro gure motegno kendo mongirore ka sigingi kendo enobed e kom duongʼ ne od wuon mare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.23",
            "verseOrgIds": [
              "ISA.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duongʼ duto ma joodgi noyudi ma gin, nyithinde gi nyikwaye, gige duto ma ok ogen, machalo kaka bakunde nyaka agulni duto nowuog kuome.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.24",
            "verseOrgIds": [
              "ISA.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Maratego wacho niya, \"E kindeno sigingi mane ogur motegno kendo mongirore biro pudhore, nongʼade mi olwar kendo gik moko duto mongʼaw kuome bende nolwar.\" Jehova Nyasaye osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
      ]
    }
  ],
