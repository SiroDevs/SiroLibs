      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wende mag pak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno iniwach niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "\"Anapaki, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "Kata obedo ni mirima nomaki koda to mirimbino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "koro oserumo kendo isekweyo chunya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom adiera Nyasaye e jaresna;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "anagen kuome kendo ok analuor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "Jehova Nyasaye, ma en Jehova Nyasaye owuon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "e tekra kendo wenda;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "kendo osebedo resruokna.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gi mor malach,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:3"
      },
      "items": [
        {
          "text": "ibiro tuomo pi koa e sokni mag resruok.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno iniwach niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "\"Gone Jehova Nyasaye erokamano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "luong nyinge kendo landuru ni ji duto gik ma osetimo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "ka uhulo ni nyinge nigi duongʼ moloyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werne Jehova Nyasaye nikech osetimo gik madongo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:5"
      },
      "items": [
        {
          "text": "kendo mano nyaka ngʼere e piny duto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koguru matek kuwer gi mor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:6"
      },
      "items": [
        {
          "text": "un jo-Sayun nimar Jal Maler mar Israel odak e dieru.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    }
  ],
