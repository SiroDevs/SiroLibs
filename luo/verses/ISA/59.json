      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:20"
      },
      "items": [
        {
          "text": "\"Jalno makelo Resruok nobi Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
