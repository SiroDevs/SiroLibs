  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "59",
        "style": "c",
        "sid": "ISA 59"
      },
      "items": [
        {
          "text": "59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Richo, ulo richo kod resruok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adiera bad Jehova Nyasaye ok chiek ma ok dores joge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:1"
      },
      "items": [
        {
          "text": "bende ite ok odino ma ok dowinj wach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To richou ema osepogou gi Nyasachu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "richou ema omiyo osepandonu wangʼe mondo kik owinju.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar lwetu otimo remo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "kendo usemulo richo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "Dhou osewacho miriambo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "kendo leu osehulo gik mamono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ngʼama dwaro tim makare;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "kata manyo bura miyalo gadiera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "Gigeno mana kuom weche manono kendo giwacho miriambo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "gimako ich mar chandruok kendo ginywolo mana richo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibutno e tong thuonde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "kendo gichweyo mbuyi mar otiengʼ-otiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "Ngʼato angʼata mochamo tongʼ-gi biro tho",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "kendo kamoro oto to nyathi fu ema wuokie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbui margi ok nyal twangʼ-go nanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "bende ok ginyal umore giwegi gi gik ma giloso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "Timbegi gin timbe richo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "kendo timbe mag mahundu ni e lwetgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiendegi reto kadhi timo richo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "giyot ahinya mondo gichwer remo maonge ketho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "Paro manie chunygi gin paro maricho",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "kendo kamoro amora ma gidhiyoe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "masira gi chandruok ema dongʼie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok gingʼeyo yo makelo kwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "onge tim makare e yoregi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "Giseloko yorego obedo yore mogondore ogondore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "kendo ngʼato angʼata mawuotho e yorego ok noyud kwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ngʼado bura makare koro bor kodwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "kendo tim makare ok chop irwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "Wagombo ler, to mudho ema waneno;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "kendo wadwaro mondo piny oru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "to mudho mandiwa ema wawuothoe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamulo kor udi mana ka muofni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "kendo wamulo kuonde ma wawuothe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "mana ka joma onge wengegi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "Wachwanyore godiechiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "mana ka gima en otieno",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:10"
      },
      "items": [
        {
          "text": "kendo wachalo joma otho e kind joma rateke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walak mana ka ondiegi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "kendo wadengo malit mana ka akuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:11"
      },
      "items": [
        {
          "text": "Wadwaro ngʼado bura makare to ok wayud kata achiel,",
          "type": "text",
