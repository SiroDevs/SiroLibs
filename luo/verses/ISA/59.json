      "attrs": {
        "style": "q2",
        "vid": "ISA 59:20"
      },
      "items": [
        {
          "text": "mondo ores nyikwa Jakobo moseweyo richogi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        }
      ]
