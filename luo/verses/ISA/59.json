      "attrs": {
        "style": "q2",
        "vid": "ISA 59:19"
      },
      "items": [
        {
          "text": "kendo koa yo wuok chiengʼ, oganda nomiye duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
