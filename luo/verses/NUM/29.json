    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'E odiechiengʼ mar abiriyo chiw rwedhi abiriyo, imbe ariyo kod nyiimbe apar gangʼwen ma jo-higa achiel, ma duto onge songa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.32",
            "verseOrgIds": [
              "NUM.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwedhigo, imbego kod nyiimbego.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.33",
            "verseOrgIds": [
              "NUM.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile kaachiel gi chiwo mar cham kaachiel gi misango miolo piny.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.34",
            "verseOrgIds": [
              "NUM.29.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'E odiechiengʼ mar aboro chok oganda kanyakla kendo kik uti tije mapile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.35",
            "verseOrgIds": [
              "NUM.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelneuru Jehova Nyasaye chiwo madungʼ tik mangʼwe ngʼar mar misango miwangʼo pep mar rwath achiel, im achiel kod nyiimbe abiriyo ma jo-higa achiel, ma duto onge songa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.36",
            "verseOrgIds": [
              "NUM.29.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwo mag cham kod misango miolo piny nyaka keti kaka chik dwaro maromre gi rwadhno, imno kod nyiimbego.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.37",
            "verseOrgIds": [
              "NUM.29.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 29:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewi mago meduru nywok achiel kaka chiwo mar pwodhruok e richo, kumedo ewi misango miwangʼo pep mapile mar cham kaachiel gi misango miolo piny.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.38",
            "verseOrgIds": [
              "NUM.29.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kuom chiwo mar kwongʼruok kod chiwo mar hera, losneuru Jehova Nyasaye sewni moyier kaka: misango miwangʼo pep, chiwo mag cham, misango miolo piny kod chiwo mag lalruok.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.39",
            "verseOrgIds": [
              "NUM.29.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nonyiso jo-Israel gigo duto mane Jehova Nyasaye ochike.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.40",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        }
      ]
    }
  ],
