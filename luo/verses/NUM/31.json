              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi owachone niya, \"Jotichni osekwano kar romb jolweny man e lwetwa, kendo onge kata achiel kuomgi molal.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
