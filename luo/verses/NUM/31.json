              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jotelo mane orito migepe mag jolweny, jotelo mag alufe alufe kod jotelo mag miche miche, nodhi ir Musa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
