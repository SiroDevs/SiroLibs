          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo wasekelo mich ne Jehova Nyasaye kuom gik molos gi dhahabu mane wayako kaka; thiwni, manyonge, tere, stadi kod tigo mondo omi wapwodhrego e richo e nyim Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        }
      ]
