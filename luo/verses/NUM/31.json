          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kod Eliazar jadolo noyie okawo dhahabugo irgi, ma gin gik mothedhi maber.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhahabu duto mane oa ir jotend lweny mag alufe alufe kod mago mag miche miche mane Musa kod Eliazar jadolo ochiwo kaka mich ne Jehova Nyasaye pekgi ne romo kilo mia ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jalweny ka jalweny noyako mana gima orome.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kod Eliazar jadolo nokawo dhahabu koa kuom jotend jolweny mag alufe alufe kod mago mag miche miche mi negiterogi e Hemb Romo kaka rapar mar jo-Israel e nyim Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.54",
