      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼadna bura makare, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "nikech e ngimana duto asedak ka aonge ketho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "aseketo genona kuom Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "ma ok adigni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nona kendo itema, yaye Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:2"
      },
      "items": [
        {
          "text": "nonie chunya gi pacha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech herani osiko kanie chunya kinde duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:3"
      },
      "items": [
        {
          "text": "kendo asiko kawuotho e adierani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok abed piny gi joma wuondore",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:4"
      },
      "items": [
        {
          "text": "bende ok ariwra gi jo-miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achayo chokruok mar joma timo gik maricho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:5"
      },
      "items": [
        {
          "text": "kendo ok ayie bet piny gi joricho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluoko lwetena kanyisogo ni aonge ketho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:6"
      },
      "items": [
        {
          "text": "kendo aluoro kendoni mar misango, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka alando pakni gi dwol maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:7"
      },
      "items": [
        {
          "text": "kendo anyiso timbeni duto miwuoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahero hekalu kama idakie, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:8"
      },
      "items": [
        {
          "text": "kama duongʼni nitie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ikaw chunya kaachiel gi joricho, kik ikaw ngimana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:9"
      },
      "items": [
        {
          "text": "kod joma ohero chwero remo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "joma lwetegi otingʼo chenro maricho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:10"
      },
      "items": [
        {
          "text": "ma lwetegi ma korachwich asoya opongʼo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "An to ngimana onge ketho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:11"
      },
      "items": [
        {
          "text": "yie iwara kendo ikecha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiendena onyono kama opie;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:12"
      },
      "items": [
        {
          "text": "e chokruok mangʼongo abiro pako Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    }
  ],
