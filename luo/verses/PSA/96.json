  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "96",
        "style": "c",
        "sid": "PSA 96"
      },
      "items": [
        {
          "text": "96",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 96",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 96:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru ne Jehova Nyasaye wer manyien;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:1"
      },
      "items": [
        {
          "text": "piny duto mondo ower ne Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 96:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru ne Jehova Nyasaye, pakuru nyinge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:2"
      },
      "items": [
        {
          "text": "landuru warruokne odiechiengʼ kodiechiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 96:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huluru duongʼne e kind ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:3"
      },
      "items": [
        {
          "text": "kendo landuru tijene miwuoro ne ji duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 96:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar Jehova Nyasaye duongʼ kendo owinjore gi pak;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:4"
      },
      "items": [
        {
          "text": "onego omiye luor moloyo nyiseche mamoko duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 96:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech nyiseche duto mag ogendini gin mana gik ma dhano oloso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:5"
      },
      "items": [
        {
          "text": "to Jehova Nyasaye ema nochweyo polo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 96:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duongʼ kod pak nitiere e nyime;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:6"
      },
      "items": [
        {
          "text": "teko kod duongʼ nitiere e kare maler mar lemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 96:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye, yaye ogendini manie piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:7"
      },
      "items": [
        {
          "text": "wachuru ni Jehova Nyasaye duongʼ kendo en gi teko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 96:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miuru Jehova Nyasaye duongʼ mowinjore gi nyinge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:8"
      },
      "items": [
        {
          "text": "kelneuru mich kendo biuru e laru mage.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 96:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamuru Jehova Nyasaye kaka Ngʼama Ler man-gi duongʼ mangʼongo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:9"
      },
      "items": [
        {
          "text": "beduru maluor ahinya e nyime, un piny duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 96:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachuru e dier ogendini niya, \"Jehova Nyasaye olocho.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "Piny osegur motegno, ok nyal yienge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "obiro ngʼado ne ji bura maonge dewo wangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 96:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo mondo obed moil, piny mondo obed mamor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:11"
      },
      "items": [
        {
          "text": "nam mondo owuo kaachiel gi gik moko duto manie iye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 96:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "pewe mondo okog gi mor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:12"
      },
      "items": [
        {
          "text": "kod gik moko duto manie igi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 96:12"
      },
      "items": [
        {
          "text": "Eka yiende duto manie bungu nower gi mor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 96:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "giniwer e nyim Jehova Nyasaye, nimar obiro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "adier obiro mondo ongʼad ne piny bura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "Obiro ngʼado ne piny bura e yo makare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "ee, obiro yalo ji gi adierane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.97",
    "number": "97",
