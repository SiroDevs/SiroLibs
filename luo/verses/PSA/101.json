  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "101",
        "style": "c",
        "sid": "PSA 101"
      },
      "items": [
        {
          "text": "101",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 101",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 101:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro wer nikech herani gi berni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:1"
      },
      "items": [
        {
          "text": "in ema abiro weroni wend pak, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 101:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro neno ni aritora mondo ngimana obed malongʼo chuth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "ibiro biro ira karangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 101:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "Abiro dak e oda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "gi chuny malongʼo chuth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 101:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok abi yie neno",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "gimoro amora mochido gi wengena.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 101:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "Achayo timbe joma chunygi richo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "gik maricho ok adwar winjo kata gi ita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 101:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok anabed gi paro mochido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:4"
      },
      "items": [
        {
          "text": "bende kata paro mar timo richo ok anapar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 101:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato angʼata makuodho nyawadgi lingʼ-lingʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "abiro kwero mi lingʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "ngʼato angʼata ma wangʼe tek kendo ma sungore gie chunye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "ok anyal betgo amingʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 101:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma jo-adiera ema abiro keto wengena kuomgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "gin ema abiro yie dak kodgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "ngʼat ma wuodhe oriere tir",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "ema biro tiyona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 101:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok abi yiene ngʼama ohero miriambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "mondo odag e oda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "ngʼat moro amora mawacho miriambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "ok nochungʼ e nyima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 101:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okinyi kokinyi abiro tieko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "joma timbegi richo modak e piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "Abiro nego ngʼato angʼata matimo richo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "ka agologi e dala mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    }
  ],
