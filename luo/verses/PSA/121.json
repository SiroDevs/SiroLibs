            "sid": "PSA 121:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atingʼo wangʼa ka arango gode,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:1"
      },
      "items": [
        {
          "text": "ere kuma konyruokna biro aye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 121:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyruokna aa kuom Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:2"
      },
      "items": [
        {
          "text": "Jachwech polo gi piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 121:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok obi weyo tiendi kier,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:3"
      },
      "items": [
        {
          "text": "Jal ma riti ok bi nur;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
