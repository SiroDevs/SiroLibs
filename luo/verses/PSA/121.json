          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omiyo chiengʼ ok nochami godiechiengʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:6"
      },
      "items": [
        {
          "text": "kendo dwe ok notimi gimoro gotieno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
