            "sid": "PSA 121:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "adier, Jal marito Israel",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:4"
      },
      "items": [
        {
          "text": "ok nur kendo ok nindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 121:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye riti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:5"
      },
      "items": [
        {
          "text": "Jehova Nyasaye e tipo moumi gi yo badi korachwich;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
