  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "PSA 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer.",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar Daudi. Kane noyudo Doeg ja-Edom nosedhi ir Saulo kendo onyise niya, \"Daudi osedhi e od Ahimelek.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo isungori kuom tim marach,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:1"
      },
      "items": [
        {
          "text": "yaye ngʼat maratego?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:1"
      },
      "items": [
        {
          "text": "Angʼo momiyo isungori odiechiengʼ duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:1"
      },
      "items": [
        {
          "text": "in ma in gir wichkuot e nyim Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichano timbe midwaro wuondogo ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:2"
      },
      "items": [
        {
          "text": "lewi bende chano gik modwaro hinyogo ji;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:2"
      },
      "items": [
        {
          "text": "kendo lewino chalo gi wembe mabith.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihero rach moloyo ber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:3"
      },
      "items": [
        {
          "text": "miriambo mitni moloyo wacho adiera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.52.3",
                "verseOrgIds": [
                  "PSA.52.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihero weche duto machwanyo ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:4"
      },
      "items": [
        {
          "text": "yaye in lep mohero wuondni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Nyasaye biro tieli piny matieki chuth nyaka chiengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "obiro yudhi mi oyiechi oko e hembi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "obiro pudhi mi ogoli e piny joma ngima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.52.5",
                "verseOrgIds": [
                  "PSA.52.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma kare biro neno mano mi gibed maluor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:6"
      },
      "items": [
        {
          "text": "gibiro nyiere kagiwacho ni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koro neyeuru ngʼatno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "mane ok okawo Nyasaye obedo kar pondo mare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "to nogeno mana kuom mwandune mathoth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "kendo notieko joma moko mondo eka omed bedo gi teko!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "An to achalo yiend zeituni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "madongo maber e od Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "ageno kuom hera ma ok rem mar Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paki nyaka chiengʼ kuom gima isetimo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "abiro paki e nyim jogi maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "Abiro keto geno mara kuom nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "nikech nyingi ber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    }
  ],
