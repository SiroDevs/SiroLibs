  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "86",
        "style": "c",
        "sid": "PSA 86"
      },
      "items": [
        {
          "text": "86",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 86",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Lemo mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 86:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj lamona, yaye Jehova Nyasaye, kendo dwoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:1"
      },
      "items": [
        {
          "text": "nimar adhier kendo achando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 86:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rit ngimana, nikech achiworani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "In e Nyasacha, omiyo res ngima jatichni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:2"
      },
      "items": [
        {
          "text": "mogeno kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 86:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kecha, yaye Ruoth Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:3"
      },
      "items": [
        {
          "text": "nimar aywakni odiechiengʼ duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 86:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi jatichni obed mamor, yaye Ruoth Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:4"
      },
      "items": [
        {
          "text": "nimar in ema aketo genona kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 86:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech in iber kendo iweyo richo, yaye Ruoth Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:5"
      },
      "items": [
        {
          "text": "in gihera mangʼeny kuom joma luongi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 86:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj lamona, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:6"
      },
      "items": [
        {
          "text": "chik iti ne ywakna ma akwayigo kech.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 86:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ ma chandruok omaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:7"
      },
      "items": [
        {
          "text": "to abiro luongi mondo ikonya, nimar ibiro dwoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 86:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge nyasaye moro amora e dier nyiseche machalo kodi, yaye Ruoth Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:8"
      },
      "items": [
        {
          "text": "onge timbe minyalo pimo gi magi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 86:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini duto michweyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:9"
      },
      "items": [
        {
          "text": "biro lami kapodho e nyimi, yaye Ruoth Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:9"
      },
      "items": [
        {
          "text": "bende gibiro miyo nyingi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 86:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar iduongʼ kendo itimo timbe miwuoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:10"
      },
      "items": [
        {
          "text": "in e Nyasaye kende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 86:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonja yoreni, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "mondo eka awuothi e adierani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "miya chuny ma ok ba koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:11"
      },
      "items": [
        {
          "text": "mondo omi aluor nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 86:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paki gi chunya duto, yaye Ruoth Nyasacha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:12"
      },
      "items": [
        {
          "text": "abiro miyo nyingi duongʼ nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 86:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar hera ma iherago duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:13"
      },
      "items": [
        {
          "text": "kendo isegola ei chuny bur matut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 86:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josunga ma wengegi tek monja, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:14"
      },
      "items": [
        {
          "text": "migawo mar joma ok kech ngʼato dwaro tieko ngimana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:14"
      },
      "items": [
        {
          "text": "joma ok dew kata in.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 86:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "In to in Nyasaye ma kecho kendo ngʼwon, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:15"
      },
      "items": [
        {
          "text": "iyi ok wangʼ piyo, ipongʼ gihera kendo in ja-adiera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 86:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duog ira mondo ikecha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:16"
      },
      "items": [
        {
          "text": "med jatichni tekoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
