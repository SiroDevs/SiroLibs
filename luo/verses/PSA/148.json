      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "Pakuru Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    }
