        {
          "text": "Zaburi 148",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 148:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "Pakuru Jehova Nyasaye gie polo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "ee, pakeuru gi malo kuma bor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 148:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakeuru, un malaikane duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:2"
      },
      "items": [
        {
          "text": "pakeuru, un jopolo duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 148:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangʼ chiengʼ gi dwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:3"
      },
      "items": [
        {
          "text": "bende opake, kaachiel gi sulwe duto marieny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 148:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un polo man malo mogik,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:4"
      },
      "items": [
        {
          "text": "pakeuru, kaachiel gi un, pige manie bwo polo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 148:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onego gipak nying Jehova Nyasaye kargi duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:5"
      },
      "items": [
        {
          "text": "nimar nogolo chik mine gibetie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 148:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ogurogi kuondegi nyaka chiengʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:6"
      },
      "items": [
        {
          "text": "kendo nyaka chiengʼ kaluwore gi chikne mochwere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 148:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye gie piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:7"
      },
      "items": [
        {
          "text": "un gik madongo mag nam kod kude matut duto mag ataro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 148:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi mil polo gi pe gi theluji gi boche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:8"
      },
      "items": [
        {
          "text": "kod yembe maringo matek mawinjo wachne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 148:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod un gode gi thuche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:9"
      },
      "items": [
        {
          "text": "gi yiende manyago olembe gi yiende mag sida duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 148:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod le mager gi jamni duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:10"
      },
      "items": [
        {
          "text": "gi le matindo gi winy mafuyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 148:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod ruodhi mag piny gi ogendini duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:11"
      },
      "items": [
        {
          "text": "kod un jotelo gi joloch duto mag piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 148:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod un yawuowi matindo gi nyiri matindo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:12"
      },
      "items": [
        {
          "text": "gi jodongo kod nyithindo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 148:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onego gipak nying Jehova Nyasaye gin duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "nimar nyinge kende ema nigi duongʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "kendo duongʼne maler oyombo piny gi polo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 148:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osechungo tung ne joge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "tung mosekelo pak ne joge maler duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:14"
      },
      "items": [
        {
          "text": "joge ma jo-Israel, ma gin joma ni machiegni gi chunye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 148:14"
      },
      "items": []
    },
