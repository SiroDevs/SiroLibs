    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 143:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj lamona, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "chik iti ne ywakna mar kech;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "bi mondo ikonya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "nikech in ja-adiera kendo itimo maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 143:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik imi jatichni yud kum",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:2"
      },
      "items": [
        {
          "text": "nimar onge kata ngʼato achiel matimo maber e nyimi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 143:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasigu lawa matek,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "oserodha piny nyaka e lowo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "ochuna ni nyaka adag kama otimo mudho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "mana ka joma notho chon gi lala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 143:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo chunya chandore e iya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:4"
      },
      "items": [
        {
          "text": "ee, chunya obwok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 143:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aparo higni machon mosekalo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "aketo pacha mos kuom tijeni duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "kendo ageno gik ma lweti osetimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 143:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayaroni lwetena;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:6"
      },
      "items": [
        {
          "text": "chunya gombi mana kaka lowo motwo gombo koth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.143.6",
                "verseOrgIds": [
                  "PSA.143.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 143:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwoka piyo, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "nimar chunya ool.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Kik ipandna wangʼi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "nono to dipoka achalo gi joma ridore e bur matut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 143:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi mondo okinyi oromna gi herani ma ok rem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "nimar aketo genona kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Nyisa yo monego alu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "nimar aketo chunya duto kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 143:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resa e lwet wasika, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:9"
      },
      "items": [
        {
          "text": "nimar in e jaritna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 143:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonja timo dwaroni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "nimar in e Nyasacha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "mi mondo Roho mari maber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "otelna e yo mopie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 143:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, kony ngimana nikech nyingi iwuon;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:11"
      },
      "items": [
        {
          "text": "gola oko e chandruok nikech timni maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 143:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wasika olingʼ thi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "nikech herani ma ok rem;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "tiek joma kedo koda duto nimar an jatichni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
