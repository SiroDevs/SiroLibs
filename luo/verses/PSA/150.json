            "sid": "PSA 150:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "Pakuru Nyasaye e kare maler mar lemo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "pakeuru ei polo mare mar nyalo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 150:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakeuru nikech tijene mosetimo kuom tekone maduongʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:2"
      },
      "items": [
        {
          "text": "kendo nikech duongʼne moyombo duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 150:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakeuru kugoyo turumbete,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:3"
      },
      "items": [
        {
          "text": "kendo kugoyo nyatiti gi asili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 150:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakeuru kugoyo oyieke kendo umiel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:4"
      },
      "items": [
        {
          "text": "ee, pakeuru gi gita kod oporo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 150:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakeuru kudiemo ongengʼo gi nyawadgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:5"
      },
      "items": [
        {
          "text": "ee, pakeuru ka ongengʼo gore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 150:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gimoro amora mayweyo mondo opak Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.6",
            "verseOrgIds": [
              "PSA.150.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 150:6"
      },
      "items": [
        {
          "text": "Pakuru Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.6",
            "verseOrgIds": [
              "PSA.150.6"
            ]
