      },
      "items": [
        {
          "text": "Zaburi 126",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wer ma ji wero kadhi e hekalu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 126:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jehova Nyasaye odwogo joma otwe Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:1"
      },
      "items": [
        {
          "text": "to ne ochalonwa mana lek.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 126:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wathungʼ gi nyiero",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "kendo dhowa nopongʼ gi wende mor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "Eka nowachore e dier ogendini niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "\"Jehova Nyasaye osetimonegi gik madongo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 126:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adier, Jehova Nyasaye osetimonwa gik madongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:3"
      },
      "items": [
        {
          "text": "omiyo wamor mokalo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.3",
            "verseOrgIds": [
              "PSA.126.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 126:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duognwa gigewa, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:4"
      },
      "items": [
        {
          "text": "mondo wachal gi aore man Negev.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.4",
            "verseOrgIds": [
              "PSA.126.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 126:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma komo kodhi kaywak",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:5"
      },
      "items": [
        {
          "text": "biro keyo ka wero wende mor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.5",
            "verseOrgIds": [
              "PSA.126.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 126:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat madhi oko kaywak,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "kotingʼo kodhi mikomo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "biro duogo ka wero wende mor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "kotingʼo cham mosechiek.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
    }
