      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:21"
      },
      "items": [
        {
          "text": "obiro mayo joma dhi nyime gi timo richo osimbo motimo yier ma girwako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.22"
            ]
          }
        }
      ]
    },
