      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:22"
      },
      "items": [
        {
          "text": "abiro gologi oko kama tut mar nam,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.23"
            ]
          }
        }
      ]
    },
