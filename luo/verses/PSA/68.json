          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom adier, Nyasaye biro toyo wiye wasike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.21",
            "verseOrgIds": [
              "PSA.68.22"
            ]
          }
        }
