            "style": "v",
            "sid": "PSA 68:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geche mag lweny mag Nyasaye gin tara gi tara;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.17",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
