          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chok tekoni kaachiel, yaye Nyasaye; nyiswa tekoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.28",
            "verseOrgIds": [
              "PSA.68.29"
            ]
          }
