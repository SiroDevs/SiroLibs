          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuodhi koro nenore maler, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.25"
            ]
