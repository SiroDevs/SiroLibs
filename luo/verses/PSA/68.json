          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak odog ne Ruoth, ma en Nyasaye ma Jawarwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.19",
            "verseOrgIds": [
              "PSA.68.20"
            ]
          }
        }
