      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:15"
      },
      "items": [
        {
          "text": "godego mag Bashan ojuothore adier.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.15",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
