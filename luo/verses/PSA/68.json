          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo unyum tiendeu e remb joma kedo kodu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.23",
            "verseOrgIds": [
              "PSA.68.24"
