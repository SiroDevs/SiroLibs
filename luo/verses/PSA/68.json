            "number": "16",
            "style": "v",
            "sid": "PSA 68:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo ungʼicho gi nyiego, yaye gode mojuothore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:16"
      },
      "items": [
        {
          "text": "angʼo momiyo nyiego omakou gi got kama Nyasaye oyiero mondo ogurie lochne,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:16"
      },
      "items": [
        {
          "text": "kama Jehova Nyasaye owuon biro dakie nyaka chiengʼ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.16",
            "verseOrgIds": [
              "PSA.68.17"
            ]
          }
        }
      ]
    },
    {
