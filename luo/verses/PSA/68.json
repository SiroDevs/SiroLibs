          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwer ondiek manie dier togo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.31"
            ]
