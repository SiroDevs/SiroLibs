      "attrs": {
        "style": "q2",
        "vid": "PSA 68:24"
      },
      "items": [
        {
          "text": "wuodh Nyasacha ma Ruodha nenore maler kodonjo kare maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.24",
            "verseOrgIds": [
              "PSA.68.25"
            ]
          }
