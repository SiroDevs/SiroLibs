        "style": "q2",
        "vid": "PSA 68:30"
      },
      "items": [
        {
          "text": "kwer kweth mag rwedhi manie dier nyiroye mag ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.30",
            "verseOrgIds": [
              "PSA.68.31"
            ]
          }
        }
