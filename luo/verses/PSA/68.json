      "attrs": {
        "style": "q2",
        "vid": "PSA 68:25"
      },
      "items": [
        {
          "text": "nyiri magoyo oyieke bende ni kodgi machiegni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.26"
            ]
          }
        }
      ]
