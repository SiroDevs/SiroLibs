      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:17"
      },
      "items": [
        {
          "text": "gingʼeny mokalo akwana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.17",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:17"
      },
      "items": [
        {
          "text": "Ruoth osebiro koa Sinai mondo odonji kare maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.17",
            "verseOrgIds": [
              "PSA.68.18"
            ]
          }
        }
      ]
    },
    {
