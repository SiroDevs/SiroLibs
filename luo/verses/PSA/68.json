      "attrs": {
        "style": "q2",
        "vid": "PSA 68:27"
      },
      "items": [
        {
          "text": "oganda maduongʼ mar ruodhi moa e dhood Juda bende ni kodgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
