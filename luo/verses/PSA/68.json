      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:26"
      },
      "items": [
        {
          "text": "pakuru Jehova Nyasaye e dier chokruok mar jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.26",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
      ]
