          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech hekalu mari man Jerusalem",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.29",
            "verseOrgIds": [
