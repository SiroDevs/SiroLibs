      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:18"
      },
      "items": [
        {
          "text": "kendo ne ikawo mich mane ji omiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
    },
    {
