      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:19"
      },
      "items": [
        {
          "text": "Nyasaye matingʼonwa pekwa ndalo duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.19",
            "verseOrgIds": [
              "PSA.68.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
