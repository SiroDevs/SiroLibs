          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhoot matin mar joka Benjamin otelonegi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
