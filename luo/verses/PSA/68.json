          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Nyasaye e dier chokruok maduongʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.26",
            "verseOrgIds": [
              "PSA.68.27"
            ]
          }
        }
