          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gode mag Bashan gin gode madongo miwuoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.15",
            "verseOrgIds": [
              "PSA.68.16"
            ]
          }
        }
