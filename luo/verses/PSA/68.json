      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:20"
      },
      "items": [
        {
          "text": "tony e tho aa kuom Jehova Nyasaye Manyalo Gik Moko Duto ma Wuon Loch.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.20",
            "verseOrgIds": [
              "PSA.68.21"
            ]
          }
        }
      ]
