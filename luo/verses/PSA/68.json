      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:18"
      },
      "items": [
        {
          "text": "to ne itelone joma nimako e lweny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
    },
    {
