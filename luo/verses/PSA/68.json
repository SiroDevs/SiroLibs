      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:18"
      },
      "items": [
        {
          "text": "nyaka mich mane jongʼanyo omiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.18",
            "verseOrgIds": [
              "PSA.68.19"
            ]
          }
        }
      ]
    },
