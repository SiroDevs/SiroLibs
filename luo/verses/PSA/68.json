      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:27"
      },
      "items": [
        {
          "text": "eka nitie ruodhi moa e dhout Zebulun gi Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.27",
            "verseOrgIds": [
              "PSA.68.28"
            ]
          }
        }
      ]
    },
