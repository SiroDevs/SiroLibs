  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "68",
        "style": "c",
        "sid": "PSA 68"
      },
      "items": [
        {
          "text": "68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Zaburi mar Daudi. Wer.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 68:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Nyasaye aa malo, mad wasike ke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:1"
      },
      "items": [
        {
          "text": "mad joma kedo kode ring konene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 68:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad iriembgi gi dhi mabor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "mana kaka yamo riembo iro tero mabor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "mad joma timbegi richo lal nono e nyim Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "mana kaka odok leny kowinjo mach.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 68:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To joma kare to mad bed mamor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:3"
      },
      "items": [
        {
          "text": "kendo moil e nyim Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:3"
      },
      "items": [
        {
          "text": "mad gibed mamor kendo gibed mamor chuth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 68:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru ne Nyasaye, weruru wende pak ne nyinge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "miyeuru duongʼ, En moriembo gechene e boche polo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "nyinge en Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "beduru moil e nyime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 68:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye modak kare kama ler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:5"
      },
      "items": [
        {
          "text": "En wuoro ne joma onge gi wuonegi kendo en jachwak mon ma chwogi otho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 68:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye keto joma odongʼ kendgi e udi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:6"
      },
      "items": [
        {
          "text": "kendo otelo ne joma otwe kower;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:6"
      },
      "items": [
        {
          "text": "to joma ohero ngʼanyo to dak e piny ma chiengʼ otwoyo kururu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 68:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane iwuok idhi kitelo ne jogi, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:7"
      },
      "items": [
        {
          "text": "kane iwuotho e piny mokethore maonge tich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.68.7",
                "verseOrgIds": [
                  "PSA.68.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 68:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "piny noyiengni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "kendo polo noolo koth e piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "e nyim Nyasaye, Jal man Sinai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "e nyim Nyasaye ma Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 68:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ichiwo koth mogundho, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:9"
      },
      "items": [
        {
          "text": "ne idwogo chuny girkeni mari mane ojony.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 68:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogi nokawo pinyno modakie kendo nichiwo ne joma odhier gik ma gilando,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:10"
      },
      "items": [
        {
          "text": "kigolo kuom mwanduni mogundho, yaye Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 68:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nolando wach kendo oganda mane okawo wachno",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:11"
      },
      "items": [
        {
          "text": "mi okeye ne duongʼ mokalo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 68:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ruodhi gi jolweny dar gi ngʼwech;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:12"
      },
      "items": [
        {
          "text": "ji pogo gik moyaki e kambi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 68:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mana sa ma inindo but mach kama liet,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:13"
      },
      "items": [
        {
          "text": "to bwombe mag akuchena oum gi dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:13"
      },
      "items": [
        {
          "text": "kendo yierene oum gi fedha maleny.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 68:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jal Maratego okeyo ruodhi manie piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:14"
      },
      "items": [
        {
          "text": "to ne ochal mana gi pe molwar koa e kama otingʼore gi malo mar Zalmon.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
