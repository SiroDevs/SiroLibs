          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth wacho niya, \"Abiro gologi oko Bashan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.22",
            "verseOrgIds": [
              "PSA.68.23"
            ]
          }
        }
      ]
