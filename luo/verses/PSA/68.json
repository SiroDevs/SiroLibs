          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma wer gi dhogi otelo eka joma wer ka goyo thumbe luwogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.25",
            "verseOrgIds": [
              "PSA.68.26"
            ]
