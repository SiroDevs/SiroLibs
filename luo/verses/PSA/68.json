          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasachwa en Nyasaye ma waro ji;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.20",
            "verseOrgIds": [
              "PSA.68.21"
            ]
          }
        }
