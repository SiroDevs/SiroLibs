      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:28"
      },
      "items": [
        {
          "text": "yaye Nyasaye; kaka isebedo kitimo nyaka aa chon.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.28",
            "verseOrgIds": [
              "PSA.68.29"
            ]
          }
        }
