  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "77",
        "style": "c",
        "sid": "PSA 77"
      },
      "items": [
        {
          "text": "77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 77",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Ne Jeduthun. Mar Asaf. Zaburi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 77:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aywak ni Nyasaye mondo okonya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:1"
      },
      "items": [
        {
          "text": "kendo ne aywak ni Nyasaye mondo owinja.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.1",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 77:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane an e chandruok, ne amanyo Ruoth Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "otieno duto ne arieyo bedena malo ma ok aol,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "kendo chunya nodagi hoch.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 77:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne apari mine ahum, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "text": "ne aol kendo chunya nonyosore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.3",
                "verseOrgIds": [
                  "PSA.77.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 77:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne imako wengena mi ok oimore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:4"
      },
      "items": [
        {
          "text": "kendo ne an gi pek ma ok anyal wuoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.4",
            "verseOrgIds": [
              "PSA.77.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 77:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aparo kuom ndalo machon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:5"
      },
      "items": [
        {
          "text": "higni machon gi lala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.5",
            "verseOrgIds": [
              "PSA.77.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 77:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne aparo wendena mag otieno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:6"
      },
      "items": [
        {
          "text": "Ne aloso gi pacha awuon, kendo chunya nopenjo kama:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.6",
            "verseOrgIds": [
              "PSA.77.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 77:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende Ruoth Nyasaye nyalo dagi ngʼato chuth?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:7"
      },
      "items": [
        {
          "text": "Bende en adier ni ok obi ochak ongʼwon kendo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.7",
            "verseOrgIds": [
              "PSA.77.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 77:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende herane ma ok rem dirum chuth adier?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:8"
      },
      "items": [
        {
          "text": "Bende singruokne nyalo bare ma ok ochopo nyaka chiengʼ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.8",
            "verseOrgIds": [
              "PSA.77.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 77:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibed ni Nyasaye wiye osewil gi kecho ji?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:9"
      },
      "items": [
        {
          "text": "Koso mirimbe mager osemiyo ok okech joge?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.9",
            "verseOrgIds": [
              "PSA.77.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.9",
                "verseOrgIds": [
                  "PSA.77.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 77:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka naparo niya, \"Ma e kama abiro kwayoe kony:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:10"
      },
      "items": [
        {
          "text": "higni ma lwet Nyasaye Man Malo Moloyo ma korachwich osetieko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.10",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 77:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro siko kaparo timbe Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:11"
      },
      "items": [
        {
          "text": "ee, abiro paro kuom honni magi machon gi lala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 77:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paro mos kuom tijeni duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:12"
      },
      "items": [
        {
          "text": "abiro paro matut kuom timbeni madongo duto.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.12",
            "verseOrgIds": [
              "PSA.77.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 77:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoreni ler, yaye Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:13"
      },
      "items": [
        {
          "text": "En nyasaye mane maduongʼ kaka Nyasachwa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.13",
            "verseOrgIds": [
              "PSA.77.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 77:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "In e Nyasaye matimo honni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:14"
      },
      "items": [
        {
          "text": "inyiso tekoni e dier ji mopogore opogore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.14",
            "verseOrgIds": [
              "PSA.77.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 77:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne iwaro jogi gi badi maratego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:15"
      },
      "items": [
        {
          "text": "jogi ma nyikwa Jakobo gi Josef.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.15",
            "verseOrgIds": [
              "PSA.77.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.77.15",
                "verseOrgIds": [
                  "PSA.77.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 77:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pige noneni, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:16"
      },
      "items": [
        {
          "text": "pige noneni mi luoro omakogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:16"
      },
      "items": [
        {
          "text": "kendo kude matut notetni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.16",
            "verseOrgIds": [
              "PSA.77.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
