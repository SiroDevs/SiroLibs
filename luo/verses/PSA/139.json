  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "139",
        "style": "c",
        "sid": "PSA 139"
      },
      "items": [
        {
          "text": "139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 139:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, isenona",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:1"
      },
      "items": [
        {
          "text": "kendo ingʼeya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 139:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingʼeya sa ma abet piny nyaka sa ma aa malo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:2"
      },
      "items": [
        {
          "text": "adier, ingʼeyo parona gi kuma bor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 139:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ingʼeyo yorega ma aluwo kod kuonde ma ayweyoe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:3"
      },
      "items": [
        {
          "text": "yorena duto oyangoreni maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 139:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kapok wach moro owuok e dhoga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:4"
      },
      "items": [
        {
          "text": "to ingʼeye malongʼo, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 139:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilwora koni gi koni mi iketa diere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:5"
      },
      "items": [
        {
          "text": "adier, iseuma duto gi lweti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 139:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko ma kamano lichna miwuoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:6"
      },
      "items": [
        {
          "text": "kendo otutna moyombo pacha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 139:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dadhi kure eka apond ne Roho mari?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:7"
      },
      "items": [
        {
          "text": "Koso kanye ma daring adhiye mondo apondni?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 139:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aidho e polo, to in kuno;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:8"
      },
      "items": [
        {
          "text": "ka aloso kitandana e bur matut, to in kuno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 139:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aidho yamb kogwen",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:9"
      },
      "items": [
        {
          "text": "mondo otera e tok nam komachielo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 139:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "to kata kuno bende lweti biro telonae,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:10"
      },
      "items": [
        {
          "text": "kendo lweti ma korachwich biro maka motegno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 139:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka awacho niya, \"Mudho biro ima adier",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:11"
      },
      "items": [
        {
          "text": "kendo ler biro lokorena otieno,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 139:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "to in mudho ok timni mudho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "kendo otieno rienyni ka odiechiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "nimar mudho chaloni ler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 139:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema ne ichweyo dhanda maiye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:13"
      },
      "items": [
        {
          "text": "adier, ne ingʼina maber gi ei minwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 139:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki nikech ne ichweya mongʼith kendo malich miwuoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "tijeni misetimo lich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "kendo angʼeyo mano maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 139:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuonde mag ringra ne ok opondoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "kane ochweya ei minwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "kane ochwe ringra e kama opondo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 139:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wangʼi ne oneno ringra ei minwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "ndalona duto e piny-ka ne ondiki chon gi lala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "e kitabu mari kane pok kata achiel kuomgi obetie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 139:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka pachi tutna, yaye Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.17",
            "verseOrgIds": [
              "PSA.139.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:17"
      },
      "items": [
        {
          "text": "Mano kaka gingʼeny mokalo akwana kargi duto!",
