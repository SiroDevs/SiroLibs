  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MRK 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngech jachwoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Yesu nochako puonjo e dho nam. To oganda maduongʼ nochokore molwore omiyo nodonjo ei yie mi obetie ka ji duto to ochungʼ oko e dho nam.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nopuonjogi gik mangʼeny e yor ngeche. E puonjnego nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Winjauru! Japur moro nodhi chwoyo kodhi,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.3",
                "verseOrgIds": [
                  "MRK.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.3",
            "verseOrgIds": [
              "MRK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kane oyudo ochwoyo, kodhi moko nolwar e dir yo, mi winy nobiro mochamogi duto.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.4",
                "verseOrgIds": [
                  "MRK.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.4",
            "verseOrgIds": [
              "MRK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodhi moko nolwar kuonde motimo lwendni, ma lowo operoree mine gitwi piyo piyo, nikech lowo ne thany thany.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.5",
                "verseOrgIds": [
                  "MRK.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.5",
            "verseOrgIds": [
              "MRK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ka chiengʼ nowuok, chamgo nowangʼ, kendo nikech ne gionge tiendegi, ne gitwo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.6",
                "verseOrgIds": [
                  "MRK.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.6",
            "verseOrgIds": [
              "MRK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodhi moko nolwar e kind kudho, to ka kudhogo nodongo, ne githungʼo chamgo mi gimonogi nyak.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.7",
                "verseOrgIds": [
                  "MRK.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.7",
            "verseOrgIds": [
              "MRK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kodhi moko to nolwar e lowo maber, mine gitwi kendo gichiego cham. Neginyago cham, moko nyadi piero adek, moko nyadi piero auchiel, kendo moko nyadi mia achiel.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.8",
                "verseOrgIds": [
                  "MRK.4.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Yesu nomedo wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngʼat man-gi it mar winjo wach mondo owinji.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.9",
                "verseOrgIds": [
                  "MRK.4.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane odongʼ kende, jopuonjrene apar gariyo gi jomoko mane ni bute nopenje tiend ngechego.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.10",
            "verseOrgIds": [
              "MRK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachonigi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Un osemiu rieko mar ngʼeyo tiend gik mopondo mag pinyruoth Nyasaye. To joma moko, to iwuoyogo gi ngeche",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.11",
                "verseOrgIds": [
                  "MRK.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mondo mi,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'gisik ka gingʼicho to ok ginine gimoro,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kendo gisik ka giwinjo weche miwacho to wach ok nodonjnegi;",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nimar dipo ka gilokore mi owenegi richogi!'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nomedo loso kodgi kowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ere kaka ok unyal winjo tiend ngeroni? Ka kamano to bende ubiro winjo tiend ngero moro amora?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.13",
                "verseOrgIds": [
                  "MRK.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Japur chwoyo kodhi ma en Wach.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.14",
                "verseOrgIds": [
                  "MRK.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.14",
            "verseOrgIds": [
              "MRK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Jomoko chalo gi kodhi molwar e dir yo, kama ichwoyoe Wach. E sa nogo ma jogi owinjoe Wach to Satan biro mi magi Wach ma giwinjono.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.15",
                "verseOrgIds": [
                  "MRK.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.15",
            "verseOrgIds": [
              "MRK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Jomoko to chalo mana kaka kodhi mochwo kuonde motimo lwanda. Gin giwinjo Wach kendo girwake sano gi mor.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.16",
                "verseOrgIds": [
                  "MRK.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.16",
            "verseOrgIds": [
              "MRK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To nikech gionge tiendegi Wach ok bedi eigi amingʼa. Ka chandruok kata sand obiro nigi nikech Wach Nyasaye to gipodho piyo piyo nono.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.17",
                "verseOrgIds": [
                  "MRK.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.17",
            "verseOrgIds": [
              "MRK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moko chalo kaka kodhi molwar e kind kudho.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.18",
                "verseOrgIds": [
                  "MRK.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.18",
            "verseOrgIds": [
              "MRK.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To achien parruok kuom ngima mar pinyni gi wuond ma mwandu kelo kaachiel gi gombo mag pinyni ma gigombogo gik mathoth, thungʼo Wach mamone nyak.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.19",
                "verseOrgIds": [
                  "MRK.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moko to chal mana gi kodhi mochuo e lowo maber, giwinjo Wach mi girwaki. Kendo ginyak maber mana ka kodhi manyak nyadi piero adek, nyadi piero auchiel, nyaka nyadi mia achiel.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.20",
                "verseOrgIds": [
                  "MRK.4.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Taya man kama otingʼore",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bende ngʼato kuomu nyalo moko taya bangʼe to oume gi bakul kata okete e bwo kitanda? Donge okete ewi rachungi taya?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.21",
                "verseOrgIds": [
                  "MRK.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼeuru ni onge gimoro mopandi ma ok nofweny, to bende onge gimoro amora mitimo lingʼ-lingʼ ma ok noket e lela.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.22",
                "verseOrgIds": [
                  "MRK.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka ngʼato nigi it mar winjo wach to mondo owinji.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.23",
                "verseOrgIds": [
                  "MRK.4.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nodhi nyime kawachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chikuru itu maber mondo uwinj weche miwachonu, nimar rapim mupimogo ema ibiro pimnugo un bende, kendo moloyo kanyo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.24",
                "verseOrgIds": [
                  "MRK.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼat man-go nomedne mi nobed gi gik mogundho; to ngʼat ma ongego kata mano ma en-go nomaye.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.25",
                "verseOrgIds": [
                  "MRK.4.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngech kodhi madongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho bende niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma e kaka pinyruoth Nyasaye chalo. Ngʼato chwoyo kodhi e lowo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.26",
                "verseOrgIds": [
                  "MRK.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Otieno kata odiechiengʼ, kata ka onindo kata oneno, to kodhigo twi atwiya mi dongi, ka jachwoyo ok ongʼeyo kaka mano timore.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.27",
                "verseOrgIds": [
                  "MRK.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lowo owuon ema golo kodhi; mokwongo tiendene wuok, eka wiye gulo oko kaeto bangʼe kodhi dongo mi chieg cham.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.28",
                "verseOrgIds": [
                  "MRK.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka cham osechiek to gikanyono wuon puodho kawo pand keyo mondo okayego.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.29",
                "verseOrgIds": [
                  "MRK.4.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngech koth karadali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho kendo niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"En yo mane ma wanyalo pimogo pinyruoth Nyasaye, kata en ngero mane manyalo nyisowa kite?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.30",
                "verseOrgIds": [
                  "MRK.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ochal gi koth karadali ma en e kodhi matinie mogik mikomo e puodho.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.31",
                "verseOrgIds": [
                  "MRK.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kata otin kamano to kosekome to odongo mi obed maduongʼ moloyo yiende mag puodho duto. Bedene yarore madongo mi winy mafuyo e kor polo biro ywe e tipone.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.32",
                "verseOrgIds": [
                  "MRK.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nomedo wuoyonegi gi ngeche machal gi mago e thuolo moro amora mane ginyalo winje.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ok owachonegi wach moro amora ma ok okonyore gi ngero. To ka thuolo noyudore mi odongʼ gi jopuonjrene kendgi to nonyisogi tiend weche duto.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu okweyo ahiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼno godhiambo Yesu nowacho ne jopuonjrene niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wadhiuru loka nam komachielo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.35",
                "verseOrgIds": [
                  "MRK.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ne giwuok giweyo oganda, mine gidhi kode mana kaka ne En-no, mi gichako kwangʼ kode ei yie. Ne nitie yiedhi mamoko bende mane kwangʼ kodgi e nam.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.36",
            "verseOrgIds": [
              "MRK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ahiti mangʼongo notugore mi apaka nochako tago yie koni gi koni mi pi nochako pongʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.37",
            "verseOrgIds": [
              "MRK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sechego noyudo Yesu nindo ewi raten man kachien yie. Jopuonjre nochiewe kagiwachone niya, \"Japuonj, donge litni ka watho?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nochiewo mokwero yamo. Nochiko apaka kowachone niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kwe! Lingʼ thi!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.39",
                "verseOrgIds": [
                  "MRK.4.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Gikanyono yamo nokwe mi piny olingʼ thi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano Yesu nowachone jopuonjrene niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.40",
            "verseOrgIds": [
              "MRK.4.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Angʼo momiyo uluor kamano? Pod uonge mana gi yie?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.40",
                "verseOrgIds": [
                  "MRK.4.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro nomakogi mi gipenjore kendgi niya, \"Ma en ngʼa, ma kata yamo gi apaka bende winje?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.41",
            "verseOrgIds": [
              "MRK.4.41"
            ]
          }
        }
      ]
    }
  ],
