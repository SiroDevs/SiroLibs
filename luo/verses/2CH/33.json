  "bookId": "2CH",
  "reference": "2 Weche Mag Ndalo 33",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "2CH 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ne ja-higni apar gariyo kane odoko ruoth kendo nobedo e loch kuom higni piero abich gabich kodak Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notimo richo e nyim wangʼ Jehova Nyasaye koluwo timbe mamono mag ogendini mane Jehova Nyasaye oseriembo e dier jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ochako ogero kuonde motingʼore gi malo mag lemo ma wuon mare Hezekia nomuko, to bende nogero kende mag misengini miwangʼoe liswa ne Baal kaachiel gi sirni milamo mag Ashera. Bende nokulore kolamo gik moko duto mochwe man e kor polo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ogero kende mag misengini e hekalu mar Jehova Nyasaye kata obedo ni Jehova Nyasaye nosewacho niya, \"Nyinga nobed Jerusalem nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nogero kende mag misengini miwangʼoe liswa ne gik mochwe mae kor polo e laru ariyo mag hekalu mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notimo misango kochiwo nyithinde mondo owangʼ e mach e Holo mar Ben Hinom bende noiro ji kendo nogoyo gagi gi timo timbe jwok, kendo nopenjo josepe kod jo-nyakalondo. Notimo timbe maricho mangʼeny e nyim Jehova Nyasaye, omiyo Jehova Nyasaye nokecho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokawo kido mopa mane oloso moketo e hekalu mar Nyasaye mane oyudo Nyasaye osewuoyoe ne Daudi kod wuode Solomon niya, \"Aseyiero hekaluni gi Jerusalem e kind ogendini duto mag Israel, kendo abiro keto Nyinga kanyo nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka jo-Israel orito chike duto kendo otimo gik moko duto mane achikogi, kendo oluwo buche gi chike duto mane Musa onyisogi, to ok nariembgi e piny mane amiyo kweregi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano Manase nomiyo jo-Juda kod jo-Jerusalem oweyo Jehova Nyasaye mi gimedo timo timbe maricho moloyo ogendini mane Jehova Nyasaye otieko e nyim jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowuoyo kod Manase gi joge to ne ok gidewe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehova Nyasaye nokelonigi jotend jolweny mag ruodh Asuria momako Manase otero e twech kotuch ume kod olowu kendo otweye kod rateke mag mula motere Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro e thagruokne nokwayo ngʼwono kuom Jehova Nyasaye, ma Nyasache kobolore ahinya e nyim Nyasach kwerene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane okwayo, Jehova Nyasaye noneno bolruokne mowinjo ywakne omiyo nodwoge Jerusalem e pinyruodhe; bangʼe Manase nongʼeyo ni Jehova Nyasaye en Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe nogero ohinga ma oko mar Dala Maduongʼ mar Daudi yo podho chiengʼ mar aora Gihon manie holo nyaka ochopo kar donjo mar Ranga Rech kendo nolworo got Ofel mogere modhi malo ahinya. Noketo jotend lweny e mier madongo duto mag Juda mochiel motegno gi ohinga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nogolo nyiseche manono ma welo kod kido mar nyasaye manono mane ni e hekalu mar Jehova Nyasaye kaachiel gi kende mag misango miwangʼoe liswa duto mane ogero e got mar hekalu kod Jerusalem kendo nowitogi oko mar dala maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe nochako ogero kendo mar misango mar Jehova Nyasaye kendo notimo misango mar lalruok kod chiwo mag erokamano kuome kowachone Juda mondo otine Jehova Nyasaye, ma Nyasach jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, ji nodhi nyime kod timo misengini e kuonde motingʼore malo mag lemo to negitime ne Jehova Nyasaye ma Nyasachgi kende.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche mag ndalo loch Manase kaachiel gi kwayo mane okwayogo Nyasache, kod weche mane jonen nowachone kuom nying Jehova Nyasaye, ma Nyasach jo-Israel ondiki e kitepe mag ruodhi Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lemo mare kod kaka Nyasaye nowinjo ywakne kaachiel gi richone kod kethone duto kod kuonde manogeroe kuonde motingʼore malo mag lemo kaachiel gi sirni mag Ashera milamo, kod nyiseche manono kapod ok olokore, magi duto ondiki e kitap jonen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase notho kaka kwerene kendo noyike e ode mar ruoth. Amon wuode nobedo ruoth kare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amon ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amon ne ja-higni piero ariyo gariyo kane obedo ruoth kendo norito piny kodak Jerusalem kuom higni ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notimo timbe maricho e wangʼ Jehova Nyasaye mana kaka wuon mare Manase nosetimo. Amon nolamo kendo timo liswa ne nyiseche duto manono mane Manase oseloso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kopogore gi wuon mare ma Manase ne ok obolore e nyim Jehova Nyasaye nikech nomedo timo gik maricho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodongo mag Amon nowinjore monego ruoth e kar dakne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
              "2CH.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jopinyno noriwore monego jogo duto mane onego ruoth Amon kendo negiketo Josia wuode obedo ruoth kare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.25",
            "verseOrgIds": [
              "2CH.33.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CH.34",
    "number": "34",
