  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amazia ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia ne ja-higni piero ariyo gabich kane odoko ruoth kendo norito Jerusalem kuom higni piero ariyo gochiko. Min mare ne nyinge Jehoadin nyar Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notimo gima kare e nyim Jehova Nyasaye to ok gi chunye duto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ka pinyruodhe nosegurore maber, nonego jotelo mane onego wuon mare mane ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano ne ok onego yawuot jogo nikech noluwo chik manie Kitap Chik mar Musa mane Jehova Nyasaye oketo mawacho niya, \"Wuone ok nonegi nikech ketho mag nyithindgi, bende nyithindo kik negi nikech ketho mag wuonegi, to ngʼato ka ngʼato nonegi nikech richone owuon.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Amazia nochoko jo-Juda kod jo-Benjamin kaachiel mopogogi tich kaluwore gi anywolagi kendo noyiero jotend migepe mag jolweny alufu achiel kod migepe mag mia achiel. Bangʼe nokwano jogo mahikgi piero ariyo ka dhi nyime kendo nonwangʼo ni ne gin ji alufu mia adek mane nyalo dhi e lweny kendo mane nyalo kedo gi tongʼ kod okumba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende nondiko jo-Israel mathuondi alufu mia achiel kochulo fedha ma pekne romo kilo alufu adek gi mia angʼwen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ngʼat Nyasaye moro nobiro ire mowachone niya, \"Ruoth momi luor, kik iyie mondo jolweny ma jo-Israel dhi kodi nimar Jehova Nyasaye ok ni kod jo-Israel ma jo-Efraim-gi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kidhi ma ikedo gi chir e lweny, to Nyasaye nomi wasiki loyi, nikech Nyasayeno nigi teko mar konyi kata miyo wasiki loyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia nopenjo ngʼat Nyasaye niya, \"To wabiro timo angʼo kuom fedha mapekgi romo kilo alufu adek gi mia angʼwen mane wachulo kuom jolweny mag jo-Israel?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Ngʼat Nyasaye nodwoko niya, \"Jehova Nyasaye nyalo miyi mangʼeny moloyo mano.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Amazia noriembo jolweny mane oa Efraim mine gidok e miechgi ka igi owangʼ kendo gikecho malich gi Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Amazia notimo chir kendo nowuok motelone jolweny mage kagidhi e Holo mar Chumbi kama nonege jo-Seir alufu apar.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolweny mag Juda nomako ji alufu apar kangima mi negiterogi ewi lwanda moro kendo negidirogi piny ma githo kendo gitur matindo tindo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e sechego jolweny mane Amazia oriembo ni ok inyal dhi kode e lweny nomonjo miech Juda chakre Samaria nyaka Beth Horon. Neginego ji alufu adek kendo negipeyo gik moko mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Amazia odwogo koa nego jo-Edom nokelo nyiseche mag jo-Seir moketogi ka nyisechege kokulore nigi kendo notimonigi misango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nokecho ahinya gi Amazia kendo noorone janabi manowachone niya, \"Angʼo momiyo igeno kuom nyiseche mag jogi mane ok nyal reso jogi giwegi e lweti?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane pod janabino wuoyo, ruoth nowachone niya, \"Bende waseketi jangʼad rieko ne ruoth? Lingʼ thi! Koso idwaro tho?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Omiyo janabi nolingʼ, to bangʼe nowacho niya, \"Angʼeyo ni Nyasaye osechano ni mondo otieki nikech gima isetimo kendo ok isewinjo puonjna.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Amazia ruodh Juda nopenjo jongʼadne rieko mi nooro joote ir Jehoash wuod Jehoahaz ma wuod Jehu ruoth Israel kowacho niya, \"Bi warom wangʼ gi wangʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehoash ruodh Israel nodwoko Amazia ruodh Juda gi ngero niya, \"Kuth alii man Lebanon nooro wach ne yiend sida man Lebanon ni, 'Yie ichiw nyari ne wuoda mondo okendi.' To le moro mar bungu mowuok Lebanon nokadho kanyo monyono kuth aliino gi tiende.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "In iwuorori ni iseloyo jo-Edom kendo koro iwuoyo marach kisungori. To ber mondo ibed mana e dala. Angʼo momiyo imanyo lweny mabiro tieki kaachiel gi jo-Juda duto?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, Amazia ne ok odewo, nimar ne en dwaro Nyasaye mondo ochiwe e lwet Jehoash nikech negiluwo nyiseche mag Edom.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehoash ruodh Israel nomonje. Jehoash kod Amazia ruodh Juda ne joromo e lweny e dala mar Beth Shemesh man Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel noloyo jo-Juda kendo ngʼato ka ngʼato noringo kochomo dalane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoash ruodh Israel nomako Amazia wuod Joash ma wuod Ahazia, ruodh Juda e Beth Shemesh. Bangʼe Jehoash nokele Jerusalem kendo nomuko ohinga mar Jerusalem chakre e Dhoranga Efraim nyaka kama ohinga ogomogo, bor kama ne omuko ne romo fut mia abich gi piero ochiko gachiel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokawo dhahabu gi fedha duto kod gik moko duto mane oyudo e hekalu mar Nyasaye mane Obed-Edom orito kaachiel gi keno mar ruoth kod ji moko mano mako e lweny, bangʼe nodok e piny Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia wuod Joash ruodh Juda nodak higni apar gabich bangʼ tho Jehoash wuod Jehoahaz ruodh Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "To weche mamoko mag loch Amazia kar chakruokgi nyaka gikogi donge ondikgi e kitap ruodhi mag Juda kod Israel?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakre ndalo mane Amazia oweyo luwo Jehova Nyasaye, negichikone obadho e Jerusalem mi oringo odhi Lakish, to negioro ji bangʼe Lakish ma onege kuno.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noduog ringre kotingʼ gi faras kendo noyike but kwerene e Dala Maduongʼ mar Juda.",
