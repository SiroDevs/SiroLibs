      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:27"
      },
      "items": [
        {
          "text": "kata miyo oger ode ewi yien?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.27",
            "verseOrgIds": [
              "JOB.39.27"
            ]
          }
        }
      ]
    },
    {
