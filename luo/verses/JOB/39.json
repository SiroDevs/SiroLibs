          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Riekoni bende nyalo miyo ongo ringi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.26",
            "verseOrgIds": [
              "JOB.39.26"
            ]
          }
        }
      ]
