          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochur seche duto mowinjo ka turumbete ywak!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
