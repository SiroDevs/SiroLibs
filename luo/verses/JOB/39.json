      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:24"
      },
      "items": [
        {
          "text": "nikech ok onyal lingʼ mos ka turumbete oseywak.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.24",
            "verseOrgIds": [
              "JOB.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
