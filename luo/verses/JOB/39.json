          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien motingʼie asere tuomore e bathe kama oliere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.23",
            "verseOrgIds": [
              "JOB.39.23"
            ]
          }
        }
      ]
    },
