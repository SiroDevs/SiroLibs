      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:28"
      },
      "items": [
        {
          "text": "kendo kind lwendni e kare mar pondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.28",
            "verseOrgIds": [
              "JOB.39.28"
            ]
          }
        }
      ]
    },
    {
