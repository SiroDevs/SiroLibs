        "style": "q2",
        "vid": "JOB 39:30"
      },
      "items": [
        {
          "text": "kendo kama gima otho nitie, ema iyudogie.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.30",
            "verseOrgIds": [
              "JOB.39.30"
            ]
