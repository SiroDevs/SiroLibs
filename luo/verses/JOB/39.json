  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "JOB 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende ingʼeyo kinde ma diek manie got nywolie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:1"
      },
      "items": [
        {
          "text": "Bende iseneno gi wangʼi ka ngao nywolo nyathine?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende inyalo ngʼeyo dweche ma igi pongʼie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:2"
      },
      "items": [
        {
          "text": "Bende ingʼeyo sa ma ginywolie?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigoyo chonggi piny ka ginywol,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:3"
      },
      "items": [
        {
          "text": "kendo muoch makayogi rumo bangʼ mano.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindgi dongo motegno kendo mopugno ka gin e thim;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:4"
      },
      "items": [
        {
          "text": "kendo giwuok to ok giduogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"En ngʼa mane ogonyo kanyna e bungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:5"
      },
      "items": [
        {
          "text": "En ngʼa mane ogonyo tonde mane otweyego?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amiye thim motwo kaka dalane,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:6"
      },
      "items": [
        {
          "text": "kendo namiye kuonde motimo chumbi mondo odagie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidak mabor gi mier, omiyo ok giwinj koko ma ji goyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:7"
      },
      "items": [
        {
          "text": "kendo ok owinj koko mar jariembo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwayo ewi gode eka oyud lum mochamo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:8"
      },
      "items": [
        {
          "text": "kendo omanyo gimoro amora mangʼich.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende jowi ma e thim yie tiyoni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:9"
      },
      "items": [
        {
          "text": "Bende inyalo kete mobed mos e kund jambi gotieno?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende inyalo boye moluni opara tir?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:10"
      },
      "items": [
        {
          "text": "Bende onyalo puroni kuonde modongʼ bangʼi ma ok opurore maber?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende diket genoni kuom tekone mangʼenygo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:11"
      },
      "items": [
        {
          "text": "Bende inyalo weye ne tiji matek mondo otimni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende in-gi adiera ni onyalo tingʼoni cham",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:12"
      },
      "items": [
        {
          "text": "misekayo mokelni dala mi okelgi kar dino?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Udo kwadho bwombene gi mor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:13"
      },
      "items": [
        {
          "text": "to ok onyal huyo moloyo magungu kod nyamnaha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onywolo tonge piny e lowo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:14"
      },
      "items": [
        {
          "text": "kendo oweyogi ewi kuoyo mondo giyud liet,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ok odew ni gimoro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:15"
      },
      "items": [
        {
          "text": "kata le mar bungu nyalo nyonogi mi gitore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojwangʼo nyithinde ma pod yom, ka gima ok gin mage owuon;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:16"
      },
      "items": [
        {
          "text": "to bende ok odew rem mane owinjo konywologi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech Nyasaye ne ok omiye rieko",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:17"
      },
      "items": [
        {
          "text": "kata paro mar pogo gima ber.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano ka oyaro bwombene mondo oringi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:18"
      },
      "items": [
        {
          "text": "to oyombo kata mana faras maringo matek moloyo ma jaithne riembo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"In ema imiyo faras teko ma en-go",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:19"
      },
      "items": [
        {
          "text": "koso in ema ne irwakone pien man-gi yier maboyo e ngʼute?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema imiyo ochikore ka bonyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.20",
            "verseOrgIds": [
              "JOB.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:20"
      },
      "items": [
        {
          "text": "kobwogo ji gi giro mar sunga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.20",
            "verseOrgIds": [
              "JOB.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwetho piny gi mirima gi tekre duto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.21",
            "verseOrgIds": [
              "JOB.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:21"
      },
      "items": [
        {
          "text": "kendo ogiro gi tekre duto kochomo kar lweny.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.21",
            "verseOrgIds": [
              "JOB.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
