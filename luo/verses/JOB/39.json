          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odak ewi lwendni maboyo kendo odak kuno nyaka otieno;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.28",
            "verseOrgIds": [
              "JOB.39.28"
            ]
          }
        }
      ]
    },
