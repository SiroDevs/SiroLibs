      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:23"
      },
      "items": [
        {
          "text": "kaachiel gi tongʼ mamil kod bidhi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.23",
            "verseOrgIds": [
              "JOB.39.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
