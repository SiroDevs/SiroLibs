      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:26"
      },
      "items": [
        {
          "text": "mi oyar bwombene kochomo yo milambo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.26",
            "verseOrgIds": [
              "JOB.39.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
