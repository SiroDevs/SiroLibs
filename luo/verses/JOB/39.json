      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:29"
      },
      "items": [
        {
          "text": "kendo wengene nyalo nene gi kuma bor.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.29",
            "verseOrgIds": [
              "JOB.39.29"
            ]
          }
        }
      ]
    },
    {
