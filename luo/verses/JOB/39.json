          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyo ema omanye chiembe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.29",
            "verseOrgIds": [
              "JOB.39.29"
            ]
          }
        }
