      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "gin joma ger maonge joma ipimogo e piny ngima.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "Gibiro tieko sunga mar Misri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
