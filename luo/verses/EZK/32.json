  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EZK 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wer miywagogo Farao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ mokwongo mar dwe mar apar gariyo, e higa mar apar gariyo, wach Jehova Nyasaye nobirona kawacho niya:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wuod dhano, chwog wend ywak ni Farao ruodh Misri, kendo wachne ni:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "\" 'Ichalo ka sibuor e kind ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ichalo gi thuol malich mantie e chuny nembe madongo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ka imuomo aoreni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ka ithacho pi gi tiendeni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "kendo ka iduwo pige mag aore magi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "\" 'Abiro konyora gi oganda mar ji mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "mi abol gogo mara kuomi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "kendo gibiro maki gi gogono ma ok inyal bwodho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro diri oko e lowo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "kendo abiro boli e dier pap malach.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "Abiro chiko winy duto manie kor polo mondo onur kuomi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "kendo le mager duto mag piny biro chami mi giyiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anadhur ringri modongʼ motop ewi gode",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:5"
      },
      "items": [
        {
          "text": "kendo apongʼo holni gi chokeni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro budo lowo gi rembi mamol",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "koa ewi gode,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "kendo holni biro pongʼ gi ringri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ ma anatieki mi aum kor polo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "to sulwe ok norieny;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "kendo wangʼ chiengʼ gi boche polo ok nobedie",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "bende dwe ok norieny.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ler duto marieny e polo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "anami lokreni mudho;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "anakel mudho mondo oum pinyi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo chuny ji mangʼeny chandre,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "chiengʼ ma anakel kethruokni e dier ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "kendo e dier pinje mapok ingʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo ji mangʼeny dhogi moki ka gineni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "kendo ruodhigi luoro nomaki,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "nikech en chiengʼ ma nomonjgie.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "E odiechiengʼ ma inipodhie,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "moro ka moro kuomgi notetni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "seche duto ka giparo ni gin bende gibiro tho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nikech ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:11"
      },
      "items": [
        {
          "text": "\" 'Ligangla mar ruodh Babulon",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:11"
      },
      "items": [
        {
          "text": "biro lwar kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo ogandani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
