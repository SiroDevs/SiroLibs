  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elija olando ni oro maduongʼ biro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro Elija ja-Tishbi moa Tishbe e piny Gilead nonyiso Ahab niya, \"Mana kaka Jehova Nyasaye mangima, ma Nyasach Israel matiyone nitie, tho kata koth ok nobedi kuom higni manok nyaka chop achak awach kendo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agak omiyo Elija chiemo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka wach Jehova Nyasaye nobiro ne Elija mowachone niya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.2",
            "verseOrgIds": [
              "1KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aa ka, dhi yo wuok chiengʼ kendo ipondi e holo mar Kerith man yo wuok chiengʼ mar Jordan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.3",
            "verseOrgIds": [
              "1KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiro modho pi mowuok e soko kendo asechiko winyo mag agak mondo omiyi chiemo kanyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano notimo gima Jehova Nyasaye nochike. Nodhi e holo mar Kerith yo ka wuok chiengʼ mar aora Jordan kendo nobedo kuno.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winyo mag agakgo nokelone kuon gi ringʼo okinyi godhiambo to nomodho e sokono.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elija kod dhako ma chwore otho man Zarefath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kinde moko sokono notwo nikech koth ne pok ochuwe e piny.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka wach Jehova Nyasaye nobirone mowachone niya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.8",
            "verseOrgIds": [
              "1KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhiyo piyo piyo nyaka Zarefath e piny Sidon kendo ibed kanyo. Asechiko dhako ma chwore otho moro kanyo mondo omiyi chiemo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.9",
            "verseOrgIds": [
              "1KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano nodhi Zarefath. Kane ochopo e dhoranga dalano, dhako ma chwore otho moro ne ni kanyo ka choko yien. Noluonge mopenje niya, \"Bende inyalo kelonae pi matin e agwata agulu mondo amodhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.10",
            "verseOrgIds": [
              "1KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane odhi kelo pi, Elija noluonge mowachone niya, \"Kendo kiyie, to kelna kuon matin.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nodwoko Elija niya, \"Mana kaka Jehova Nyasaye ma Nyasachi ngima aonge gi kuon moro amora makmana mogo matin e agulu kod mo matin e puga. Amodo yien matin mondo ater dala kendo alosgo chiemba kod mar wuoda mondo wacham bangʼe watho.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija nowachone niya, \"Kik ibed maluor dhi dala kendo tim kaka isewacho. To mokwongo losna kuon matin kuom gima in-go mondo ikelna eka ilos gimoro ni in kaachiel gi wuodi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.13",
            "verseOrgIds": [
              "1KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ma e gima Jehova Nyasaye Nyasach Israel wacho, 'Agulu mar mogo ok nodongʼ nono kendo puga mar mo ok notwo nyaka chop chiengʼ ma Jehova Nyasaye nokelie koth, e piny.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodhi motimo kaka Elija nowachone. Kamano ne nitie chiemo pile ka pile ne Elija gi dhakono kod joode.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar agulu mar mogono ne ok odongʼ nono kendo puga mar mo-no ne ok otwo kaluwore gi wach Jehova Nyasaye mane Elija owacho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kinde moko wuod dhakoni ma wuon odno ne tuo, nomedo bedo marach ahinya to bangʼe notho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.17",
            "verseOrgIds": [
              "1KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhakono nopenjo Elija niya, \"En rach mane ma in-go koda, ngʼat Nyasaye? Ne ibiro mondo iparna richona kendo mondo ineg wuoda?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija nodwoke niya, \"Miya wuodi.\" Nokawe koa e lwete motingʼe nyaka ei ot mamalo mane odakie mopiele e kitandane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.19",
            "verseOrgIds": [
              "1KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka noywak ne Jehova Nyasaye niya, \"Yaye Jehova Nyasaye ma Nyasacha isekelo chandruok bende ni dhako ma chwore otho madakgo ni kimiyo wuode tho?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka noriere kuom wuowino nyadidek moywak ni Jehova Nyasaye niya, \"Jehova Nyasaye ma Nyasacha yie ngima wuowini oduogne!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowinjo ywak Elija mi ngima wuowino noduogone mi nobedo mangima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
            "verseOrgIds": [
              "1KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija nochungo nyathino motingʼe kogole oko ewi tado motere e ot. Nomiye min-gi mowachone niya ne wuodi ngima!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.23",
            "verseOrgIds": [
              "1KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka dhakono nowacho ni Elija niya, \"Koro angʼeyo adiera ni in ngʼat Nyasaye kendo ni wach Jehova Nyasaye mawuok e dhogi en adiera.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.24",
            "verseOrgIds": [
              "1KI.17.24"
            ]
          }
        }
      ]
    }
  ],
