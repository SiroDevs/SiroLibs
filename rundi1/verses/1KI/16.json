              "1KI.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ngoma ya Ahabu ni ho Hiyeli w’i Beteli yasubira kwubaka Yeriko. Agitangura kwubaka umushinge, umuhungu wiwe w’imfura Abiramu arapfa. Amaze guheza inzitiro zaco, umuhungu wiwe w’umuhererezi Segubu na we arapfa. Ivyo vyose vyabaye nk’uko ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        },
        {
          "text": " ryari ryarabivuze, riciye mu kanwa ka Yosuwa mwene Nuni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        }
      ]
    }
