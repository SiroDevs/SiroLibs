              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aca asubira i Galilaya yuzuye ubushobozi bwa Mpwemu Yera, maze inkuru yiwe ikwira akarere kose kahegereye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
