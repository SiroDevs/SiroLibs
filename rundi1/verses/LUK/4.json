        },
        {
          "text": "Hanyuma Yesu, yuzuye Mpwemu Yera, ava ku ruzi Yorodani ajanwa na Mpwemu mu bugaragwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
