          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuhereza umuzingo w’igitabu c’uwavugishwa n’Imana Yesaya, arakizingurura, aca ashikira ahanditswe ngo:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
            "verseOrgIds": [
              "LUK.4.17"
            ]
          }
        }
