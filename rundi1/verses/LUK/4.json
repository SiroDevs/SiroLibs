              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Satani amujana ahantu harehare, amwereka ubwami bwose bwo mw’isi mu kanya gato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.5",
            "verseOrgIds": [
              "LUK.4.5"
            ]
          }
        },
        {
          "name": "verse",
