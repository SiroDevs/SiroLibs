              "ISA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira umuntu akubwira ngo uje kuraguza ku bapfumu n’abasiguza imizimu, bavuga bongorera kandi bajwigira kugira ngo bakubwire ivyo muri kazoza, mbega igikwiye si ugusiguza Imana yanyu? Ni kuki muja kubaza abapfuye ivy’abakiriho? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimusuzumire ivyo bavuga ku vyagezwe vyanje no ku ntahe! Nimba bavuga ibitandukanye n’ijambo ryanje, bazokwama mu mwijima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukwihebura n’ikigoyi ni vyo bizorangwa mu gihugu cabo. Nibafatwa n’ikigoyi, bazoterwa n’ishavu, maze barabe hejuru, bavume umwami wabo n’Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoraba hasi babone amakuba n’umwijima, n’umubabaro w’umururazi, kandi bazotererwa mu mwijima w’umuzitanya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.22",
            "verseOrgIds": [
              "ISA.8.22"
            ]
          }
        }
