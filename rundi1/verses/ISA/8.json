            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "text": " ambarira ati: “Fata umuzingo munini uwandikeko n’ikaramu isanzwe uti: Maheri-Shalali-Hashi-Bazi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nca mpamagara Uriya umuherezi na Zakariya mwene Yeberekiya, ngo bambere ivyabona vyizerwa yuko nabikoze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma ndyamana n’umugore wanje w’umuvugishwakazi, asama inda, avyara umwana w’umuhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "text": " arambwira ati: “Numwite Maheri-Shalali-Hashi-Bazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere y’uko uwo mwana amenya kuvuga ngo data canke mama, umwami wa Ashuri azoba yaramaze gutwara ubutunzi bwose bw’i Damasiko n’i Samariya.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
