        },
        {
          "text": "Inyuma y’iyo myaka mirongo indwi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "text": " azosubira kuvyura Tiro. Ariko hazosubira ku rudandazwa rwaho rwa kera, hasambane n’ubwami bwose bwo kw’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
