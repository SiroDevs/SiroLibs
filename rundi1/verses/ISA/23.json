              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko inyuma y’aho inyungu zaho zose zizokwegurirwa ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        },
        {
          "text": ". Ntizizobikwa canke ngo zishirwe ukwazo, kuko zizohabwa abama imbere y’",
