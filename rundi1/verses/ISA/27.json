        },
        {
          "text": "Uwo musi inzamba nini izovuzwa. Abariko barahonera muri Ashuri n’abari barajanywe ari inyagano muri Egiputa bazoza guhimbariza ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.13",
            "verseOrgIds": [
