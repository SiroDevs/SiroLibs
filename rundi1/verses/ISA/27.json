            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        },
        {
          "text": " azosekura ingano, kuva ku ruzi Efutate kugeza ku mugezi wa Egiputa. Namwe Bisirayeli, muzokwegeranywa umwumwe. ",
