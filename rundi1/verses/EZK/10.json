      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngize gutya mbona ikimeze nk’intebe y’ubwami isa n’ibuye ry’agaciro ryitwa lapisi lazuli iri hejuru y’imitwe ya ba bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " abarira wa muntu yari yambaye impuzu zera derere ati: “Ja hagati mu mapine ari musi y’abakerubi. Wuzuze amashi yawe amakara yaka, hanyuma uyashwiragize mu gisagara.” Nuko aragenda abikora ndamuraba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe ba bakerubi bari bahagaze ku ruhande rwo hepfo y’Ingoro igihe uwo mugabo yinjira muri ayo mapine, hanyuma igicu c’ubwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "text": " gica cuzura imbere mu Ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bwa bwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "text": " buraduga buva ku bakerubi buja mu rwinjiriro rw’Ingoro. Ca gicu gica cuzura Ingoro, inyubakwa yose yuzura ugukayangana kw’ubwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugukubita kw’amababa ya ba bakerubi kwumvikana gushika kure hanze mu rugo, kumeze nk’ijwi ry’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "text": " Imana Mushoboravyose iyo avuze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "text": " abarira wa muntu yari yambaye impuzu zera derere ati: “Fata umuriro wo musi y’amapine no hagati y’abakerubi.” Wa muntu aragenda ahagarara i ruhande ya ya mapine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umukerubi umwe agorora ukuboko azana amakara yaka ayakuye mu muriro wariko urakira hagati muri bo; aca ayashira mu biganza vya wa muntu yari yambaye impuzu zera, na we arayakira, arasohoka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi y’amababa y’abakerubi hari ibimeze nk’amaboko y’umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngize gutya mbona amapine ane i ruhande y’abakerubi, rimwerimwe i ruhande y’umukerubi umwe; ayo mapine yarakayangana nk’akabuye k’igiciro kitwa topazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.9",
            "verseOrgIds": [
              "EZK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uyaravye, ayo mapine yose uko ari ane yarasa; rimwerimwe ryose rimeze nk’aho ryinjira mu rindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.10",
            "verseOrgIds": [
              "EZK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakerubi mu kugenda, bashobora kuja mu mpande zine zose bitewe n’aho baba baraba; ayo mapine ntiyarinda guhindukira abakerubi bariko baragenda. Bashobora kuja iyo baraba, batiriwe barahindukira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.11",
            "verseOrgIds": [
              "EZK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakerubi bari buzuyeko amaso ku mubiri wose harimwo n’umugongo, amaboko n’amababa; co kimwe n’ayo mapine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.12",
            "verseOrgIds": [
              "EZK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndahava numva ko ayo mapine yitwa: “Nyawizunguriza.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukerubi umwe wese yari afise mu maso amashusho ane: ishusho ya mbere yari iy’umukerubi, iya kabiri yari iy’umuntu, iya gatatu yari iy’intare, iya kane yari iy’inkona.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba bakerubi barahaguruka. Abo ni vyo vya binyabuzima nari nabonye ku ruzi Kebari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo abo bakerubi bagiye, ya mapine yajana na bo; kandi iyo bagoroye amababa ngo bave hasi, ya mapine ntiyabavako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.16",
            "verseOrgIds": [
              "EZK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakerubi bahagaze, amapine na yo yarahagarara; bahagurutse agahagurukana na bo, kuko impwemu y’ivyo binyabuzima yari muri ayo mapine.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ubwiza bw’Uhoraho buva mu rwinjiriro rw’Ingoro, buhagarara hejuru ya ba bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakerubi basanza amababa mbona, barahagurutse bava hasi. Bagiye, ya mapine ajana na bo. Bahagarara mu rwinjiriro rw’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "text": " rutumbereye mu buseruko, kandi ubwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli bwari hejuru yabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo binyabuzima nari nabonye biri musi y’Imana ya Isirayeli ndi ku ruzi Kebari, nca ndatahura ko bari abakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe wese yari afise amababa ane, kandi musi y’amababa yabo hari ibimeze nk’amaboko y’umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu maso habo hasa n’ah’abo nari nabonye ndi ku ruzi Kebari. Umwe wese yagenda atumbereye imbere yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.22",
            "verseOrgIds": [
              "EZK.10.22"
            ]
          }
        }
      ]
    }
