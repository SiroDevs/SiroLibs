          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i Dedani bagushorako uburengeti basasa ku mafarasi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
