          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siriya mwahanahana ibidandazwa, kuko wari ufise vyinshi; bakakuzanira amabuye y’agaciro, ibitambara bitukura, ivyera, n’impuzu z’amabara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
