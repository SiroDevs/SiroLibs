          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadandaza b’i Sheba n’i Rama mwahanahana ibidandazwa; bagashora ibirungo vy’ubwoko bwose, utubuye tw’agaciro turimwo n’inzahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        }
