        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damasiko mwahanahana ibidandazwa kuko wari ufise vyinshi, bakakuzanira imivinyu y’i Heluboni hamwe n’ubwoya bw’intama z’i Zahari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagiriki bavuye mu gisagara Uzali, baje kudandaza bakuzanira ibicuzwe mu vyuma, imbaho z’ikasiya, ibimota neza n’imisigati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        }
      ]
    },
