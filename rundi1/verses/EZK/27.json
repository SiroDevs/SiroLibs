              "EZK.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani, Kanehe na Edeni, hamwe n’abadandaza b’i Sheba, Ashuri na Kilimadi mwahanahana ibidandazwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku masoko yawe bahashora imyambaro myizamyiza, ibitambara vy’ubururu, impuzu zijererenze z’amabara menshi, ziteweko utugozi duhinze turiko amapfundo akomeye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        }
