            "number": "2",
            "style": "v",
            "sid": "EZK 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w’umuntu, cura intimba uririre Tiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwira Tiro, igisagara cubatse ku nkengera z’ikiyaga, ihuriro ry’abadandaza bava mu mihingo myinshi, uti: ‘Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarushishi mwahanahana ibidandazwa, kuko wari ufise ubutunzi bwinshi; bakaguha ifeza, n’ubundi butare, nawe ukabaha ibidandazwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubugiriki, Tubali na Mesheki mwasangira urudandazwa; bakaguha abagurano n’ibindi bintu bikozwe mu mwakaka, nawe ukabaha ibidandazwa vyawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
