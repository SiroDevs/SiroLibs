            }
          ]
        },
        {
          "text": "Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "text": " ryongera kumbwira riti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
