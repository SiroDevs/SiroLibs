          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabiya n’abaganwa bose b’i Kedari bashorera iwawe; intama n’amapfizi yazo, hamwe n’impene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        }
