          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagabo b’i Dedani mwahana ibidandazwa, kandi abo ku nkengera z’ikiyaga basumira iwawe; bakuriha amahembe y’inzovu n’ibiti vyitwa ebene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        }
      ]
    },
    {
