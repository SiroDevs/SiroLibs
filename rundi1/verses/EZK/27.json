        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuyuda na Isirayeli mwarahanahana ibidandazwa; bakuzanira ingano z’i Miniti hamwe n’ifu, insukoni nziza, ubuki, amavuta ya elayo, hamwe n’ibirungo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
