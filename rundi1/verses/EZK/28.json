            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze: Ninamara kwegeranya ubwoko bwa Isirayeli nkabukura mu mahanga bwasanzariyemwo, nzobigaragazako nk’uwera mu maso y’amahanga. Maze bazoba mu gihugu cabo, ico nahaye umusavyi wanje Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
