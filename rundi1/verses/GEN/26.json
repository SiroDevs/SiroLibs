        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu amaze imyaka mirongo ine, arongora abagore b’Abahetikazi babiri: Yudita umukobwa wa Beyeri na Basemati, umukobwa wa Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abo bagore bateye ingorane nyinshi Isaka na Rebeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
