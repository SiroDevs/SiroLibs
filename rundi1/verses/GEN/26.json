              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi abakozi ba Isaka baza bamuzaniye inkuru z’iriba bari bimvye, baramubwira bati: “Twaronse amazi!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo riba Isaka aryita Shiba, bisigura “indahiro”. Ni co gituma gushika n’uno musi igisagara cubatswe aho hantu citwa Berisheba, bisigura “iriba ry’indahiro”.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
    },
