              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe, Abimeleki ava i Gerari aja kuraba Isaka, ari kumwe n’umuhanuzi wiwe Ahuzati na Pikoli, umukuru w’abasoda biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka arababaza ati: “Ni kuki mwaje kundaba kandi munyanka, mukaba mwarananyirukanye mu gihugu canyu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura bati: “Twarabonye neza ko ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "text": " ari kumwe nawe. Ni co gituma twiyumviriye ko dukwiye kugiriranira amasezerano nawe yubakiye ku ndahiro hagati ya twe nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uturahire ko utazokwigera utugirira nabi, nk’uko natwe tutigeze tugukorera ikibi. Twagukoreye ivyiza, maze tukurungika amahoro. None biraboneka ko ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "text": " yaguhezagiye.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Isaka abategurira umusi mukuru, bararya baranywa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.30",
            "verseOrgIds": [
              "GEN.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gitondo kare, abo bagabo baca bahana indahiro. Nuko Isaka arabasezera, bagenda amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        }
      ]
    },
