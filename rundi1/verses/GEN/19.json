          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ba bakobwa ba Loti uko ari babiri basama inda batewe na se. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukuru avyara umwana amwita Mowabu. Ni we sekuruza w’ihanga ryitwa Abanyamowabu gushika uno musi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutoya na we avyara umuhungu amwita Beni-Ami. Ni we sekuruza w’ihanga ryitwa Abamoni gushika uno musi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
