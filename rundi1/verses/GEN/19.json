          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Loti ashika i Zowari izuba rirashe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "text": " akororera kuri Sodomu na Gomora umuriro n’ibizuku vyaka bivuye mw’ijuru; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "arandura ivyo bisagara vyose hamwe n’ikiyaya cose, n’abantu bose baba muri ivyo bisagara n’ibiterwa vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko muka Loti arahindukira araba inyuma aca acika inkingi y’umunyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        }
      ]
