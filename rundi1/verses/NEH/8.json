          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko umusi utashe, uhereye ku musi wa mbere gushika ku wa nyuma, Ezira yama abasomera ico Gitabu c’Ivyagezwe vy’Imana; bagahimbaza uwo musi mukuru imisi indwi, maze ku musi w’umunani hakaba ikoraniro rinini nk’uko vyari bitegekanijwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
