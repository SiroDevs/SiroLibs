          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi wa kabiri w’uko kwezi, abakuru b’imiryango, bari kumwe n’abaherezi n’Abalewi, bakoranira aho umwigisha w’Ivyagezwe Ezira ari, kugira ngo bumvirize neza amajambo yo mu Vyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basanga mu Vyagezwe, ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "text": " yari yaratanze acishije kuri Mose, handitse ngo Abisirayeli baze babe mu nsago bagire umusi mukuru wo mu kwezi kw’indwi ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ko bari bakwiye kwamamaza iryo jambo bakarikwiragiza mu bisagara vyabo n’i Yerusalemu ngo: “Nimusohoke muduge mu ntara y’imisozi maze muzane amashami mwakuye ku biti vy’imyelayo yo mu mirima hamwe n’ibiti vy’imyelayo yo mw’ishamba, no ku miriteli, ku bigazi no ku biti vyose bizitanye, kugira ngo mwubake insago nk’uko vyanditswe.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
