          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abantu barasohoka bazana amashami biyubakira utuzu dutoduto imbere y’inzu zabo, mu ngo zabo, imbere y’Ingoro y’Imana no ku kibuga kiri i ruhande y’Irembo ry’Amazi n’ikiri i ruhande y’Irembo rya Efurayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bari baravuye mu kinyago bubaka insago bazibamwo. Kuva mu gihe ca Yesuwa mwene Nuni gushika uwo musi, Abisirayeli ntibari bwahimbaze uwo musi mukuru nk’uko. Maze baranezerwa cane.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
