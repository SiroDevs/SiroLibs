          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.37",
            "verseOrgIds": [
              "NEH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bw’ivyo, turasezeranye isezerano kandi tuzoryandika, kandi abarongozi bacu, Abalewi bacu n’abaherezi bacu bashireko amazina yabo n’ibidodo vyabo.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.9.38"
            ]
          }
        }
