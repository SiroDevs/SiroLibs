          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bati: “Egome.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
        }
