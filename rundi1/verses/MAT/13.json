            "number": "57",
            "style": "v",
            "sid": "MAT 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        }
      ]
    },
