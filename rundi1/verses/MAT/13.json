          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyose Yesu yabibwira abantu mu migani; nta kintu na kimwe yababwira adakoresheje imigani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.34",
            "verseOrgIds": [
              "MAT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko ivyo uwavugishwa n’Imana yavuze vyashitse, ngo:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
