            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu Yesu ahakorera ibitangaza bike kuko abantu baho ata kwizera bari bafise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.58",
            "verseOrgIds": [
              "MAT.13.58"
            ]
          }
