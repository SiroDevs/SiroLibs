        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Yesu yicaye ku Musozi wa Elayono, biherereye, abigishwa biwe baramubaza bati: “Tubwire, ivyo bizoshika ryari, kandi ni ikihe kimenyetso kizokwerekana ukugaruka kwawe n’umuhero w’isi?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.3",
            "verseOrgIds": [
              "MAT.24.3"
            ]
          }
        }
      ]
    },
