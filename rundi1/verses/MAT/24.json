            "sid": "MAT 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ariko arasohoka ava mu rusengero, abigishwa biwe baramwegera, bamwereka ingene urusengero rwubatse. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.1",
            "verseOrgIds": [
              "MAT.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arabishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.2",
            "verseOrgIds": [
              "MAT.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
