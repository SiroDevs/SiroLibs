          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Imana abane n’impwemu yawe, kandi ubuntu bwiwe bubane namwe mwese.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.22",
            "verseOrgIds": [
              "2TI.4.22"
            ]
          }
        }
      ]
    }
