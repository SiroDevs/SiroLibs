              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atereka na kimwe giterekwako amatara mw’Ihema, aharabana n’imeza ku ruhande rwo hepfo y’ihema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
