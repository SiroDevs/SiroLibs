            }
          ]
        },
        {
          "text": "Mose yinjiza na ya meza mw’Ihema ry’Ibonaniro ayishira ku ruhande rwo mu buraruko bw’ihema, hino ya ca gitambara, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
