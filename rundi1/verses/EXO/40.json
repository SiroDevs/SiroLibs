        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.11",
            "verseOrgIds": [
              "EXO.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uce uzana Aroni n’abahungu biwe baze ku rwinjiriro rw’ihema ry’ibonaniro, ubogeshe ya mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni uce umwambika vya vyambarwa vyejejwe, umurobanuze amavuta, umweze kugira ngo ankorere igikorwa c’ubuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzane n’abahungu biwe ubambike imyambaro yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubarobanure nk’uko warobanuye sewabo, kugira ngo bankorere igikorwa c’ubuherezi. Ukwo kurobanurwa kuzobaha ubuherezi buzokwamaho uko urunganwe ruzogenda rukurikirana.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akora ivyo vyose nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        },
        {
          "text": " yabimutegetse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
