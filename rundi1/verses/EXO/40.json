              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afata vya bisate vy’amabuye vy’ivyagezwe abishira mw’isandugu, ayishirako na ya myamba, afata na wa mupfundikizo wo guhongerako awutereka kuri yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
            "verseOrgIds": [
              "EXO.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca yinjiza ya sandugu mw’Ihema, amanika na ca gitambara co kuyihisha nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        },
        {
          "text": " yabimutegetse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        }
