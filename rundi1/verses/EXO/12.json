            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamahanga baba muri mwebwe bagomba guhimbaza Pasika y’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "text": ", abagabo bo muri bo bose bazobanze bakebwe, babone gusangira n’abavutse ari Abisirayeli. Ariko ntihaze hagire uwutakebwe arya ku vya Pasika. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri tegeko rigenga bose, baba abavutse ari Abisirayeli canke abanyamahanga bazoba baba muri mwebwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        }
