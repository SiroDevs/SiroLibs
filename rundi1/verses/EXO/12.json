            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire umunyamahanga azobiryako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nihaba hari umugurano mwaguze, azobiryeko nimba yarakebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uwuzoba abana namwe igihe gito canke umucangero ntaze abiryeko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        }
      ]
    },
