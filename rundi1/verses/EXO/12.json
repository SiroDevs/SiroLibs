            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "text": " abarira Mose na Aroni ati: “Ibi ni vyo muzokurikiza mu kurya ivya Pasika:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        }
