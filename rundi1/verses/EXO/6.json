              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yongera iramubwira iti: “Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeretse Aburahamu, Isaka na Yakobo, ndabiyereka nk’Imana Mushoboravyose, ariko sinigeze ndabibwira muri iryo zina ryanje ari ryo ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nabasezeraniye ko nzobaha igihugu c’i Kanani, ico babayemwo nk’abanyamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icongeyeko narumvise amarira y’abantu banje bari mu buja muri Egiputa, nca nibuka isezerano nabasezeraniye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        }
      ]
    },
    {
