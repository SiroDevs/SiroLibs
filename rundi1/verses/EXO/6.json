          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero barira Abisirayeli uti: ‘Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "text": ", nzobakura musi y’agacinyizo k’Abanyegiputa. Nzobabohora mureke kubabera abagurano, nzogorora ukuboko kwanje ndabacungure nkoreshe n’ibikorwa bikomeye bigaragaza urubanza mbaciriye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobagira abantu banje, nanje nzoba Imana yanyu. Ni ho muzomenya ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "text": " Imana yanyu nabakuye mu gacinyizo k’Abanyegiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobajana mu gihugu narahiye manitse ukuboko ko nzogiha Aburahamu, Isaka na Yakobo. Nzokibaha kibe inyegu yanyu. Ni jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        },
        {
          "text": " ndabivuze.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        }
      ]
    },
