          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Mose abarira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        },
        {
          "text": " ati: “Nimba Abisirayeli batanyumviriza, mbega Farawo yonyumviriza gute ntazi no kuvuga?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        }
