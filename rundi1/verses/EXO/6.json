        {
          "text": "Maze Mose yiganira Abisirayeli ivyo Imana yamubwiye, ariko ntibamwumviriza kuko bari baciwe intege n’agacinyizo gahambaye barimwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        }
