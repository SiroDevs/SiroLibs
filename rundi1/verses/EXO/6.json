          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Genda ubarire Farawo umwami wa Egiputa arekure Abisirayeli bave muri iki gihugu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
