          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        },
        {
          "text": " abarira Mose iti: “Rindira gato wirabire ivyo nkorera Farawo. Ku bw’ukuboko kwanje kw’inkomezi, azobarekura bagende; ku bw’ukuboko kwanje kw’inkomezi, azobirukana bave mu gihugu ciwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
