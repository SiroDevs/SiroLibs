        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose abarira Abisirayeli ati: “",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "text": " yatoranije Bezaleli mwene Uri, umwuzukuru wa Huri, wo mu muryango wa Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "amwuzuza Mpwemu w’Imana, ubwenge, ugutahura, ubumenyi n’ubuhinga bw’uburyo bwose, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo ashobore gukora ibikorwa vy’ubuhinga mu nzahabu, mw’ifeza, no mu mwakaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afise ubuhinga bwo gukorogoshora amabuye n’ibiti, n’ubwo gukora ibintu bitandukanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "text": " yamuhaye ingabire yo kwigisha abandi ubwo buhinga afatanije na Oholiyabu, mwene Ahisamaki, wo mu muryango wa Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " yabujuje ubuhinga bwose bwo gukora ibikorwa vyo gucura, gukorongoshora ku mabuye, no gushira udusharizo ku mpuzu bakoresheje inyuzi z’ubururu, izitukura, izitukura cane n’izera derere, kujisha, hamwe n’ubundi buhinga bwose bijanye, n’ubuhinga bwo kwishushaniriza ivyo bakora.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
      ]
    }
