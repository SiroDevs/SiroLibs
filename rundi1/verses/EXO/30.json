            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "text": " yongera abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Niwamara guharura Abisirayeli, umugabo wese azoba yaharuwe azonzanire incungu y’ubuzima bwiwe, ni ho ata cago kizobashikira igihe uzoba uriko urabaharura. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese azoja ku ruhande rw’abamaze guharurwa azotanga igice ca shekeli",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30:13",
              "type": "text"
            },
            {
              "text": "Ni nk’amagarama 5,8.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", hakoreshejwe ingero shekeli y’Ahera, na yo ikaba ingana n’ingero gera mirongo ibiri. Ico gice ca shekeli abe ari co bazoshikanira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazoguca imbere bose bashikana imyaka mirongo ibiri n’iyirenga, bazoshikanire ishikanwa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abifise bazotange ibirengeye igice ca shekeli. Abakene na bo ntibazotange ibiri musi y’igice ca shekeli nimwashikanira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "text": " amashikanwa y’impongano ku bw’ubuzima bwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uze wakirire Abisirayeli ayo mahera y’impongano uzoyakoreshe mu bikorwa vyo mw’Ihema ry’Ibonaniro. Kizoba ari icibutso c’Abisirayeli imbere yanje c’uko mwatanze impongano y’ubuzima bwanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
