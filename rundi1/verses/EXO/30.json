        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "text": " yongera abarira Mose ati: “Fata ibimota neza vyitwa natalu, sheheleti, helebena ku ngero zingana, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze ubivange bibe ibimota neza. Bizokorwe n’abahinga bazi kuvanga amavuta. Azobemwo umunyu, atarobetswe n’ikindi kintu na kimwe, yejejwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.35",
            "verseOrgIds": [
              "EXO.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufate bikeya muri vyo, ubisye, ubishire imbere ya ya Sandugu y’Isezerano iri mw’ihema ry’ibonaniro, aho tuzobonanira. Ivyo bize bibabere ivyera cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire umuntu n’umwe azokwikorera imibavu itunganijwe muri ubwo buryo: mufate ko ari iyera y’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwuzokwikorera imibavu itunganije muri ubwo buryo kugira ngo aryoherwe n’ugutamirana kwayo azocibwe mu bandi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
            "verseOrgIds": [
              "EXO.30.38"
            ]
          }
        }
