        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze muheze mugikorere amatara indwi, muyagishireko kugira ngo aboneshe imbere yaco. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utundi dukoresho twose nk’imikasi n’udusahani bijanye bizobe bicuzwe mu nzahabu itavanze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gucura ico giterekwako amatara hamwe n’ibijanye na co vyose hazokoreshwe italanto",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
