            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:39",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 34.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’inzahabu itavanze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
