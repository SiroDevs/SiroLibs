          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi umuherezi hamwe n’abarongozi b’umuryango wa Isirayeli ari bo barongoye imice igize imiryango yose bumvise ivyo abo mu muryango wa Reyubeni, n’abo mu muryango wa Gadi n’ab’igice c’uwa Manase bababwiye, baranezerwa cane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi mwene Eliyazeri umuherezi abwira abo mu muryango wa Reyubeni, n’abo mu muryango wa Gadi n’ab’igice c’uwa Manase ati: “Uyu musi dutahuye ko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "text": " ari kumwe natwe, kuko mutakoze ibikorwa vyo kugarariza ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "text": " nk’uko twavyibaza. Mukijije Isirayeli ukuboko kw’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
