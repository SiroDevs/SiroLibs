          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Finehasi mwene Eliyazeri umuherezi hamwe n’abo barongozi baca basezera imiryango ya Reyubeni na Gadi, bava muri iyo ntara ya Gileyadi, basubira i Kanani, biganira abandi Bisirayeli ivyabaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bavyumvise barahimbarwa, bashima Imana. Ntibaba baciyumvira ivyo gutera imiryango ya Reyubeni na Gadi ngo bazimanganye igihugu babamwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        }
