          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibikabe ko tugarariza ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "text": " mu kwiyubakira igicaniro co gushikanirako amashikanwa yo guturirwa, amashikanwa y’ifu hamwe n’amashikanwa y’ishimwe; atari ku gicaniro c’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "text": " Imana yacu kiri imbere y’ihema ry’ibonaniro ryayo.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
