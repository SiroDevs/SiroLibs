    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Yosuwa akoranya abo mu muryango wa Reyubeni n’uwa Gadi, hamwe n’igice c’uwa Manase ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababwira ati: “Mwashikije ivyo Mose umusavyi w’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "text": " yabategetse vyose, kandi nanje mwaranyumviye mu vyo nabategetse vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko uhereye kera gushika n’ubu, mutigeze mutana urugamba benewanyu, ahubwo mwabandanije igikorwa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "text": " Imana yanyu yabashinze. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "text": " Imana yanyu ahaye akaruhuko benewanyu nk’uko yabisezeranye, nimwisubirire iwanyu, mu ntara Mose umusavyi w’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "text": " yabahaye mu buseruko bwa Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko muzokwame mwiyubara, mukurikize amabwirizwa n’ivyagezwe Mose umusavyi w’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "text": " yabahaye: Mukunde ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "text": " Imana yanyu, mugendere mu nzira ziwe, mushitse amabwirizwa yiwe, mwumire kuri we, kandi mumukorere n’imitima yanyu yose, n’imishaha yanyu yose.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa arabahezagira, arabarungika, basubira iwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igice kimwe c’umuryango wa Manase Mose yari yagihaye intara ya Bashani mu buseruko bwa Yorodani, ikindi gice Yosuwa yagihaye intara yo mu burengero bwa Yorodani. Igihe Yosuwa yariko arabarungika, yarabahezagiye, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.7",
            "verseOrgIds": [
              "JOS.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababwira ati: “Nimusubire iwanyu mutwaye n’ubutunzi bwinshi mwanyaze abansi banyu: ibitungwa, ifeza, inzahabu, imyakaka, ivyuma, n’ivyambarwa vyinshi. Muzobigabure na benewanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo mu muryango wa Reyubeni n’uwa Gadi hamwe n’igice c’uwa Manase baca batandukanira n’abandi Bisirayeli i Shilo mu ntara ya Kanani, basubira i Gileyadi, mu ntara bahawe nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "text": " yari yarabitegetse abicishije kuri Mose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bageze i Geliloti hafi ya Yorodani mu gihugu c’i Kanani, abo mu muryango wa Reyubeni n’uwa Gadi, n’ab’igice c’umuryango wa Manase baca bubaka igicaniro gisumba ibindi vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.10",
            "verseOrgIds": [
              "JOS.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi Bisirayeli bumvise ko umuryango wa Reyubeni n’uwa Gadi hamwe n’ab’igice c’umuryango wa Manase bubatse igicaniro ku rubibe rwa Kanani i Geliloti hafi ya Yorodani ku ruhande rwa Isirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bose baca bakoranira i Shilo kugira ngo baje kubatera.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli baca barungika Finehasi mwene Eliyazeri umuherezi, aja i Gileyadi mu miryango ya Reyubeni na Gadi n’igice c’umuryango wa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamurungikana n’abagabo icumi b’abatware, umwumwe ku muryango, hamwe n’umukuru umwemwe ku muce wose wo mu miryango ya Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse i Gileyadi, babarira imiryango ya Reyubeni na Gadi n’igice c’umuryango wa Manase bati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikoraniro ryose ry’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "text": " rigize riti: ‘Ni kubera iki muhemukiye Imana ya Isirayeli ukwo? Ni iki catumye muva k’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "text": " mukamugarariza mu kwiyubakira igicaniro? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega icaha c’i Peyori nticari kimaze kuri twebwe? Gushika n’uwu musi ntituriyeza uko bikwiye, mbere n’inyuma y’uko ikiza caje ku bwoko bw’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "text": "! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega murahevye ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "text": "? Nimwagarariza ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "text": " uwu musi, ejo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "text": " azorakira Abisirayeli bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwakenera aho mwubaka igicaniro kubera intara yanyu ihumanye, muzoze mwifatanye natwe mu ntara y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "text": " ahari ihema ry’ibonaniro ry’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "text": ", mubane natwe. Ariko ntimugararize ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "text": " mu kwubaka ikindi gicaniro atari ca gicaniro c’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "text": " Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega igihe Akani mwene Zera yakora icaha mu kwiba ivyari vyagenewe kuba ivy’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        },
        {
          "text": ", uburake bw’Imana ntibwaziriringiye Abisirayeli bose? Si we wenyene yapfuye azize ico caha.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
