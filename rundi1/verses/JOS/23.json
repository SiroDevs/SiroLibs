          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "text": " yirukanye amahanga akomakomeye imbere yanyu, gushika ubu nta na rimwe rirabahagarara imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe muri mwebwe yirukana igihumbi, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "text": " Imana yanyu ari we abagwanira nk’uko yabibasezeraniye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mushire imitima yanyu ku gukunda ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "text": " Imana yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nimwahindukira mukifatanya n’abacitse kw’icumu bo muri aya mahanga basigaye muri mwebwe canke mugahana abageni mukivanga na bo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.12",
            "verseOrgIds": [
              "JOS.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumenye ko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "text": " atazokwirukana ayo mahanga imbere yanyu. Ariko bazobabera imitego muzogwamwo, bababere inkoni zo kubakubita mu migongo n’amahwa abazibura mu maso, gushika mutikiriye muri iki gihugu ciza ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "text": " Imana yanyu abahaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe ndi mu kwitaba Imana nk’uko bigendera abandi bose. Murazi n’imitima yanyu yose n’imishaha yanyu yose ko ata ciza na kimwe ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "text": " Imana yanyu yasezeranye kitashitse. Ivyo yasezeranye vyose yarabishikije, nta na kimwe cavuyemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nk’uko iciza cose ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "text": " Imana yanyu yasezeranye cashitse, ni ko n’ibibi vyose ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "text": " yavuze bizoshika nimwamugarariza. Azobatikiza gushika muhonere muri iki gihugu ciza yabahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwaca kubiri n’isezerano ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        },
        {
          "text": " Imana yanyu yabahaye, mukunamira izindi mana mukazisenga, uburake bw’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        },
        {
          "text": " buzobaziriringira, muhonere bidatevye muri ico gihugu ciza yabahaye.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        }
      ]
    }
