    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’igihe kirekire ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "text": " ahaye amahoro Abisirayeli akabakiza abansi babo bose bari babakikuje, Yosuwa yari ageze mu zabukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko akoranya Abisirayeli bose; abatware bose, abarongozi n’abacamanza arababwira ati: “Ehe raba ndageze mu zabukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.2",
            "verseOrgIds": [
              "JOS.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwese mwarabonye ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "text": " yakoreye aya mahanga yose ku bwanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "text": " Imana yanyu ni yo yabagwaniye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwibuke ingene nagaburiye imiryango yanyu intara mwahawe nk’imigabane, igihugu cose twafashe n’ico tutarafata, kuva kuri Yorodani gushika ku Kiyaga Mediterane mu burengero. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.4",
            "verseOrgIds": [
              "JOS.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki gihugu kizoba icanyu, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "text": " Imana yanyu we nyene azokwiyirukanira ayo mahanga abahunge. Azobirukana imbere yanyu namwe mufate igihugu cabo, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "text": " Imana yanyu yabibasezeraniye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mushire imitima yanyu ku vyanditswe muri iki gitabu c’ivyagezwe vya Mose, ntimuzohengamire i buryo canke i bubamfu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.6",
            "verseOrgIds": [
              "JOS.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuzokwifatanye n’ayandi mahanga akiri muri mwebwe, ntimuzokwambaze amazina y’imana zabo canke ngo murahire mu mazina yazo. Ntimuzozikorere canke ngo munazunamire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.7",
            "verseOrgIds": [
              "JOS.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwumire k’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "text": " Imana yanyu nk’uko mwayumiyeko gushika ubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
