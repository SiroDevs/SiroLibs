            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisa amwishura ati: “Ngirira ubuntu. Ko wampaye itongo i Negebu, mpa n’amariba y’amazi.” Nuko Kalebu amuha amariba yo hepfo n’ayo haruguru.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
