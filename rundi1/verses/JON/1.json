            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JON 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        },
        {
          "text": " aca azana urufi runini cane, rumira Yona, amara imisi itatu n’amajoro atatu mu nda yarwo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
      ]
    }
