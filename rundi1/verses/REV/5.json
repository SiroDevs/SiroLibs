            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma nca numva amajwi y’ivyaremwe vyose, ivyo mw’ijuru, ivyo kw’isi, ivy’i kuzimu, ivyo mu biyaga n’ibibibamwo, biririmba biti:",
          "type": "text",
