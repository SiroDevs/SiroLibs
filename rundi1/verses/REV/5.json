        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nongeye kuraba kandi, nca numva amajwi y’abamarayika ibihumbi n’ibihumbi bakikuje ya ntebe y’inganji, n’aya vya binyabugingo, na ba bakuru, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "baririmba n’ijwi rirenga bati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
