            "number": "17",
            "style": "v",
            "sid": "REV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwemu w’Imana n’umugeni baravuga bati: “Kaze.” N’uwumvise aya majambo wese avuge ati: “Kaze.” Uwunyotewe wese naze, kandi uwushaka wese naze anywe ku mazi y’ubugingo ku buntu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
              "REV.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
