          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amen. Kaze, Mwami Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        }
