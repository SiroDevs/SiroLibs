          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
              "REV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaburiye umuntu wese yumva amajambo y’ubuvugishwa yo muri uwu muzingo w’igitabu: Nihagira uwugira ico yongeye ku vyanditswe muri uwu muzingo w’igitabu, Imana izokwongera ku vyago vyiwe, ivyago bicanditsemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.18",
            "verseOrgIds": [
              "REV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nihagira ico agabanije ku majambo y’ubuvugishwa ari muri uwu muzingo w’igitabu, Imana izomwaka umugabane wiwe ku giti c’ubugingo no mu Gisagara Cera vyavuzwe muri iki gitabu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.19",
            "verseOrgIds": [
              "REV.22.19"
            ]
          }
        }
      ]
    },
