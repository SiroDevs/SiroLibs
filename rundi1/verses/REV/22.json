              "type": "text"
            }
          ]
        },
        {
          "text": "Uwushingira intahe ibi aravuga ati: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        }
