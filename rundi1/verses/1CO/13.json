          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho novuga indimi z’abantu n’iz’abamarayika ntagira urukundo, noba meze nk’inkengeri canke icuma gisamirana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nogira ingabire yo kuvugishwa n’Imana, nkagira ukwizera kwokwimura imisozi ariko ntagira urukundo, vyoba ari ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nofata ivyanje vyose nkabiha abakene, ndetse naho notanga umubiri wanje",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:3",
              "type": "text"
            },
            {
              "text": "Mu nzandiko zimwezimwe barongerako ngo “ngo uturirwe”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kugira ngo ngire ico nirata ariko ntagira urukundo, vyoba ari ubusa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urukundo rurihangana, rugira neza, ntirugira ishari, ntirwihayagiza, kandi ntirwishira hejuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiruteza isoni abandi, ntirurondera inyungu zarwo, ntirutwarwa n’ishavu, kandi ntirubika ikibi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urukundo ntirunezerererwa ikibi, ariko runezererwa ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.6",
            "verseOrgIds": [
              "1CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urukundo ntirucika intege, ntirutakaza ukwizera, ntirutakaza ivyizigiro, rukomeza kwihanganira ibihe uko bije kwose.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urukundo ntiruzigera rurangira. Kuvugishwa n’Imana, kuvuga mu ndimi zitamenyekana, n’ubwenge budasanzwe bizohera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwenge dufise ubu ni agace gatoya, kandi n’ukuvugishwa n’Imana kwacu ni agace gatoya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko igihe kizogera aho vyose bizokwuzuzwa, maze ivy’ibice bikurweho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkiri umwana navuga nk’umwana nkiyumvira nk’umwana. Ariko maze gukura niyambuye ivy’ubwana vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo tubona ubu ni nk’ishusho yo mu cirore, ariko hazogera igihe tuzobona vyose neza amaso mu yandi. Ubu tuzi agace, ariko hari igihe tuzomenya vyose, nk’uko Imana ituzi neza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero hari ibintu bitatu bizokwamaho: ukwizera, ivyizigiro n’urukundo. Ariko igikuru muri vyose ni urukundo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.13",
            "verseOrgIds": [
              "1CO.13.13"
            ]
          }
        }
      ]
    }
  ],
