        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihashimwe ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "text": ", Imana ya ba sogokuruza, we yashize ku mutima w’umwami guhezagira Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "text": " iri i Yerusalemu muri ubu buryo ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yangiriye ubuntu bungana gutya imbere y’umwami n’abahanuzi biwe n’abandi bashizwe hejuru bo mu bwami bwiwe. Kubera ukuboko kw’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        },
        {
          "text": " Imana yanje kwari kuri jewe, narumvise ko ndemye, maze ndegeranya abantu barongora abandi bava muri Isirayeli ngo badugane nanje.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        }
      ]
    }
