            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ni ikopi y’ikete umwami Ahasuwerusi yahaye Ezira umuherezi n’umwigisha w’Ivyagezwe, umuntu yanonosoye ivyerekeye amabwirizwa n’amategeko ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "text": " yahaye Abisirayeli:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
