              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfise vyinshi nshaka kubabwira, ariko sinshaka kubibandikira. Nizera ko nzobagendera tuvugana amaso mu yandi, kugira ngo umunezero wacu ube uwuzuye.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        }
      ]
    },
    {
