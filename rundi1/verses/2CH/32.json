          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko igihe intumwa zatumwa kuri we zivuye ku baganza i Babiloni ngo bamubaze ivyerekeye ibitangaza vyari vyabaye mu gihugu, Imana iramureka kugira ngo imugeze imenye ivyari mu mutima wiwe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        }
