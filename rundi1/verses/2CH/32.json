            }
          ]
        },
        {
          "text": "Hezekiya ni we yagomeye amazi y’umugezi wa Gihoni aca ashiraho umuringoti w’amazi uyajana, uciye mu burengero bw’Igisagara ca Dawidi. Ivyo yipfuza gukora vyose yarabishikako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.30",
            "verseOrgIds": [
              "2CH.32.30"
            ]
          }
        },
