            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umwami ashikiriza ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "text": " ikibanza kiri imbere y’Ingoro, ahatangira n’ibimazi vyo guturirwa, ivy’ifu hamwe n’ibinure vy’ibimazi vy’ishimwe, kuko igicaniro yari yarakoze mu butare bw’umwakaka kitashobora gukwirwako ibimazi vyo guturirwa, ivy’ifu hamwe n’ibinure vy’ibimazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
