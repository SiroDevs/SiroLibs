              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilukiya n’abo umwami yari yarungitse baja kuvugana na Hulida umuvugishwa, yari umugore wa Shalumu mwene Tokati, Tokati mwene Hasira uwari ajejwe imyambaro. Uwo Hulida yaba i Yerusalemu, mu gice gishasha c’igisagara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we ababwira ati: “Uku ni ko Uhoraho Imana ya Isirayeli avuze: Nimugende mubwire uwabantumyeko muti: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "text": " avuze: ‘Ngiye guteza icago aha hantu n’abantu baho, mu gushitsa imivumo yose yanditswe muri ico gitabu casomewe imbere y’umwami w’i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bantaye, bagaturirira ibimota neza izindi mana, bakandakisha izo nyene amaboko yabo yakoze, uburake bwanje buzosukwa aha hantu, kandi nta kizobuhwamika.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimugende mubwire umwami w’i Buyuda yabatumye kumusiguriza Uhoraho, muti: ‘Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli avuze ku vyerekeye amajambo wumvise: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko umutima wawe wakozweko, ukicisha bugufi imbere y’Imana ucumva amajambo yavuze kuri aha hantu no ku bantu baho, kandi ko wicishije bugufi imbere yanje ukitabagurirako impuzu, ukaririra imbere yanje; nanje nakwumvise, ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "text": " avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero nzoguha kwitahira amahoro uhamvye ba sogokuruza bawe. Amaso yawe ntazobona ivyago vyose ngiye guteza aha hantu n’abantu bose bahaba.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bashira umwami iyo nyishu abahaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umwami akoranya abakuru bose b’i Buyuda n’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adugana ku Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "text": " n’abantu bose b’i Buyuda, ababa i Yerusalemu, abaherezi n’Abalewi, n’abantu bose uhereye ku mukuru ugashitsa ku muto. Abasomera amajambo yo muri ca Gitabu c’Isezerano, cari catowe mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami ahagarara mu kibanza ciwe, asubizaho isezerano imbere y’Uhoraho ko agiye kwubaha ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "text": " no gukurikiza amabwirizwa, amategeko hamwe n’ivyagezwe vyiwe, akabikora n’umutima wiwe wose n’umushaha wiwe wose, mu gushitsa ivyanditswe muri ico gitabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaba abantu bose b’i Yerusalemu n’Ababenyamini kwiyemeza gushira mu ngiro iryo sezerano. Maze ab’i Yerusalemu bakora bisunze iryo sezerano ry’Imana ya ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya akuraho ibigirwamana vy’ubuyobe vyose mu ntara yitirirwa Abisirayeli, ategeka abari mu Bwisirayeli ngo bakorere ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "text": " Imana yabo. Mu gihe cose yari akiriho, ntibigeze bareka gukurikira ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "text": ", Imana ya ba sekuruza babo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
  ],
