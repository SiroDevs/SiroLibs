          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abayuda bose n’ab’i Yerusalemu, barongowe na Yehoshafati, basubira i Yerusalemu banezerewe, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "text": " yari yabahaye kwitamba hejuru abansi babo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binjira i Yerusalemu, baja mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        },
        {
          "text": " bavuza inanga n’amakembe n’inzamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        }
      ]
    },
    {
