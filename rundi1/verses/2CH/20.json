          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Abanyamowabu n’Abamoni hamwe n’ab’i Mayoni bamwe, baja gutera Yehoshafati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza abantu babwira Yehoshafati bati: “Ingabo nyinshi ziraje kugutera zivuye muri Edomu, hakurya y’Ikiyaga c’Umunyu. Kandi bamaze gushika i Hazazoni-Tamari” ari ho Eni-Gedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati aratinya, aca ahitamwo gusiguza ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "text": ", kandi ategeka ko Abayuda bose bisonzesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu b’i Buyuda bakoranira hamwe ngo barondere ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        },
        {
          "text": "; kandi bari bavuye mu bisagara vyose vy’i Buyuda baje kurondera ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehoshafati ahagarara mw’ikoraniro ry’Abayuda n’ab’i Yerusalemu ku Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "text": ", imbere y’imbuga nshasha, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "avuga ati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
