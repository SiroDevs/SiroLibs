              "2CH.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yehoshafati aganza i Buyuda. Yari afise imyaka mirongo itatu n’itanu igihe yimikwa ngo abe umwami w’i Buyuda, maze aganza imyaka mirongo ibiri n’itanu ari i Yerusalemu. Nyina wiwe yitwa Azuba umukobwa wa Shiluhi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agendera mu nzira za se Asa, kandi ntiyakikama ngo azivemwo; akora ibigororotse mu nyonga z’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntiyakuraho ibibanza vyo gusengeramwo ibigirwamana biri ku mataba y’imisozi, kandi abantu ntibari bwashire imitima yabo ku Mana ya ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
