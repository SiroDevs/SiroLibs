          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Yehoshafati, uhereye ku ntango ugashika ku mpera, vyanditswe mu gitabu c’ivyagenda biraba canditswe na Yehu mwene Hanani, bikaba biri no mu gitabu c’abami ba Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
