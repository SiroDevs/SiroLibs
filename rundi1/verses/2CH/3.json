            "sid": "2CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo atangura kwubakira ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "text": " Ingoro i Yerusalemu ku musozi Moriya, hamwe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "text": " yari yariyerekeye se Dawidi. Hari ku mbuga yo kugosorerako ingano ya Orunani Umuyebusi, ikibanza cari categuwe na Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atangura kwubaka ku musi ugira kabiri w’ukwezi kwa kabiri mu mwaka ugira kane ari ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umushinge Salomo yubatse wo kwubakako iyo Ngoro y’Imana wari ufise ingero z’igice c’ukuboko mirongo itandatu z’uburebure n’ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:3",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 27 z’uburebure n’imetero 9 z’ubwaguke.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibaraza ry’amaja imbere y’iyo Ngoro ryari rifise uburebure bungana n’ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:4",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hamwe n’igihagararo kingana n’ingero z’igice c’ukuboko mirongo ibiri nyene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere mu Ngoro ahomeka inzahabu ihinguwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icumba gikuru acubakisha imbaho z’amasederi, azomekako inzahabu zihinguwe neza, hanyuma ashushanyako ibigazi n’imigufu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashariza impome z’Ingoro n’amabuye y’igiciro kinini. Inzahabu yakoresheje zavuye i Paruvayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imyamba ifashe igisenge, ibishimaryango, impome hamwe n’imiryango y’Ingoro avyomekako inzahabu, hanyuma impome azishushanyako abakerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yubaka Ahera Cane, uburebure bwaho bwangana n’ubwaguke bw’Ingoro; ni ukuvuga ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:8",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hamwe rero n’ingero z’igice c’ukuboko mirongo ibiri z’ubwaguke. Imbere ahomeka inzahabu ihinguwe neza ipima italanto amajana atandatu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:8",
              "type": "text"
            },
            {
              "text": "Ni nk’amatoni 23.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisumari y’inzahabu yapima shekeli mirongo itanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:9",
              "type": "text"
            },
            {
              "text": "Ni nk’amagarama 575.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Ivyumba vyo hejuru na vyo nyene avyomekako inzahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaza ibishushanyo bibiri vy’abakerubi vyo gushira Ahera Cane, avyomekako inzahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwaguke bw’amababa y’abo bakerubi uko ari babiri bwangana n’ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:11",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 9.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Ibaba rimwe ry’umukerubi wa mbere ryari rifise uburebure bungana n’ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:11",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ryakora ku ruhome rw’Ingoro, mu gihe irindi baba, na ryo nyene rifise ingero z’igice c’ukuboko zitanu, ryafatana n’ibaba ry’uwundi mukerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibaba ry’umukerubi wa kabiri ryapima ingero z’igice c’ukuboko zitanu rigakora ku kindi gihome c’urusengero, irindi baba na ryo nyene ryapima ingero z’igice c’ukuboko zitanu z’uburebure, rigakora kw’ibaba ry’umukerubi wa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amababa y’abo bakerubi yari afise ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:13",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 9.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Bari bahagaze, batumbereye Ahera Cane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashona igihuzu mu nyuzi z’amabara y’ubururu avanze n’ayatukura hamwe n’ayera derere, gishushanijweko abakerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere y’Ingoro yubaka inkingi zibiri, zose hamwe zareha n’ingero z’igice c’ukuboko mirongo itatu na zitanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:15",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 16.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure bw’igihagararo, imwe yose ku mutwe yari ifise umwashi upima ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:15",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,3.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora imigufu isobekeranye ayishira ku mitwe y’izo nkingi, aca acura ibisa n’ivyamwa vyitwa amakomamanga ijana abimanika kuri iyo migufu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahagarika za nkingi imbere y’Ingoro, imwe ayishira amaja mu bumanuko iyindi amaja mu buraruko. Iyo mu bumanuko ayita Yakini, iyo mu buraruko ayita Bowazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
    }
