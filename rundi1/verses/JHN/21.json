            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramwishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
