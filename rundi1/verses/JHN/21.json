          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyatumye haba ibihuha hagati mu bizera ko uwo mwigishwa atazopfa. Ariko Yesu ntiyavuze ngo ntazopfa; yavuze ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        }
      ]
