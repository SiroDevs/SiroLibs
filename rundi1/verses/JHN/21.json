        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.5",
            "verseOrgIds": [
              "JHN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.6",
            "verseOrgIds": [
              "JHN.21.6"
            ]
          }
        },
        {
          "text": " Nuko baterera urusenga, maze ntibashobora kurukwega kubera ifi zari nyinshi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.6",
            "verseOrgIds": [
              "JHN.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
