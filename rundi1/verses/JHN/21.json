              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yavuze ivyo ashaka kwerekana Petero urupfu azopfa ahesha Imana icubahiro. Aca abwira Petero ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.19",
            "verseOrgIds": [
              "JHN.21.19"
            ]
          }
        }
