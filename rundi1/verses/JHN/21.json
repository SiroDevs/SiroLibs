          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Petero arahindukira abona wa mwigishwa Yesu yakunda ariko arabakurikira. (Uwo ni umwe yari yegamiye mu gikiriza ca Yesu bariko barafungura akamubaza ati: “Mwami, ni nde agiye kukugurisha?”) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
            "verseOrgIds": [
              "JHN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero amubonye abaza Yesu ati: “Mwami, urya we ivyiwe bizogenda gute?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        }
      ]
