          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwigishwa ni we ashingira intahe ivyo kandi ni na we yavyanditse. Kandi turazi ko intahe yiwe ari iy’ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.24",
            "verseOrgIds": [
              "JHN.21.24"
            ]
          }
        }
      ]
