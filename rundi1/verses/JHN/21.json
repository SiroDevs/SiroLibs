          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.6",
            "verseOrgIds": [
              "JHN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mwigishwa Yesu yakunda abwira Petero ati: “Ni Umwami!” Simoni Petero yumvise ko ari Umwami, aca yambara impuzu yiwe yo hejuru (kuko yari yayikuye), asimbira mu mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.7",
            "verseOrgIds": [
              "JHN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bigishwa bagumye mu bwato bakwegera rwa rusenga rwuzuye ifi ku nkengera, kuko bari nko ku ntambuko ijana",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:8",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 90.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bururutse ubwato babona umuriro w’amakara wokejeko ifi, babona n’imikate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.9",
            "verseOrgIds": [
              "JHN.21.9"
            ]
          }
        }
      ]
    },
