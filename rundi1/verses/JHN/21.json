          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Simoni Petero asubira mu bwato akwegera ku nkengera y’ikiyaga rwa rusenga rwuzuye ifi nininini, zishika ijana na mirongo itanu na zitatu. Ariko naho zari nyinshi, urusenga ntirwatabutse. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.11",
            "verseOrgIds": [
              "JHN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.12",
            "verseOrgIds": [
              "JHN.21.12"
            ]
          }
        },
        {
          "text": " Nta n’umwe muri ba bigishwa yubahutse kumubaza uwo ari we, kuko bari batahuye ko ari Umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.12",
            "verseOrgIds": [
              "JHN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yesu arabegera, abagaburira wa mukate, abaha n’ifi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.13",
            "verseOrgIds": [
              "JHN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo bwagira gatatu Yesu yiyereka abigishwa inyuma yo kuzuka kwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.14",
            "verseOrgIds": [
              "JHN.21.14"
            ]
          }
        }
