          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bati: “Oya!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.5",
            "verseOrgIds": [
              "JHN.21.5"
            ]
          }
        }
