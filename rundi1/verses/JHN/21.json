            "style": "v",
            "sid": "JHN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.4",
            "verseOrgIds": [
              "JHN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabahamagara ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.5",
            "verseOrgIds": [
              "JHN.21.5"
            ]
          }
        }
      ]
    },
    {
