        {
          "text": "Yesu yarakoze n’ibindi bintu vyinshi. Iyo vyose vyandikwa, nibaza ko n’isi yose itokwiwemwo ibitabu vyokwanditswe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.25",
