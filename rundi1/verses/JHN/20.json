              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubwira ati: “Wizeye kubera umbonye? Hahiriwe abizera batabanje kubona.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
