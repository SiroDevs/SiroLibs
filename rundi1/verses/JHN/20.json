            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toma (uwari azwi ko ari Ihasa), umwe muri ba bigishwa cumi na babiri, ntiyari kumwe n’abandi bigishwa igihe Yesu yaza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.24",
            "verseOrgIds": [
              "JHN.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bigishwa baramubwira bati: “Twabonye Umwami!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko we ababwira ati: “Ivyo sinshobora kuvyemera ntiboneye inkovu z’imisumari mu biganza, nkazikozako urutoke rwanje, ngashira n’ikiganza canje mu nkovu yo mu rubavu rwiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
