          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toma aramubwira ati: “Mwami wanje, Mana yanje!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        }
