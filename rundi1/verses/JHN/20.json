            "number": "25",
            "style": "v",
            "sid": "JHN 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haheze indwi, abigishwa ba Yesu basubira gukoranira hamwe mu nzu, kandi na Toma yari kumwe na bo. Imiryango y’inzu yari yugaye, ariko Yesu araza ahagarara hagati yabo, arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abwira Toma ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        }
      ]
    },
