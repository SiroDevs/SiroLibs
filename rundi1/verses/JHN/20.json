          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hari n’ibindi bitangaza vyinshi Yesu yakoreye mu maso y’abigishwa biwe bitanditswe muri iki gitabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
