            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura bati: “Yesu w’i Nazareti.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
