          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Anasi aca arungika Yesu aboshwe kwa Kayafa, umuherezi mukuru.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
