            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe, Simoni Petero yari agihagaze ha handi yota umuriro. Nuko baramubwira bati: “Wewe utegerezwa kuba uri umwe mu bigishwa biwe!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arabihakana ati: “Sindi we.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
