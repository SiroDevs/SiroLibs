              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.16",
            "verseOrgIds": [
              "JHN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mukobwa arinda umuryango abaza Petero ati: “Ubwo wewe nturi umwe mu bigishwa b’uwu mugabo?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero aramwishura ati: “Oya sindi we.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
