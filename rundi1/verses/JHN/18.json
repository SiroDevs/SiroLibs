          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we ababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "text": " Kandi Yuda, uwagira amugurishe, yari ahagararanye na bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu avuze ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        },
        {
          "text": " baca bagenza umugongo, baratemba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        }
      ]
