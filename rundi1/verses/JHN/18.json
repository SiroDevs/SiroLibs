            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura bati: “Ntitwemerewe gucira umuntu urubanza rwo gupfa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        },
