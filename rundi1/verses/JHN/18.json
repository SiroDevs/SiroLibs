          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze, kuko Yesu yari azi ibigiye kumushikira, arabegera arababaza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.4",
            "verseOrgIds": [
              "JHN.18.4"
            ]
          }
        }
      ]
    },
