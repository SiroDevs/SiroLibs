            "style": "v",
            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato arababwira ati: “Nimumujane mwebwe nyene mumucire urubanza mukurikije amategeko yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
