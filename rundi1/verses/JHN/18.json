            "sid": "JHN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ahejeje gusenga, ajabuka umwonga wa Kidironi ari kumwe n’abigishwa biwe, baja mw’itongo ryari hakurya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.1",
            "verseOrgIds": [
              "JHN.18.1"
            ]
          }
        }
      ]
    },
    {
