      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.1",
            "verseOrgIds": [
              "JHN.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, yamugurisheje, aho hantu yari ahazi, kuko Yesu yakunda kujana n’abigishwa biwe muri iryo tongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.2",
            "verseOrgIds": [
              "JHN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yuda aja muri iryo tongo, ajanye n’umugwi w’abasoda n’abarinzi b’urusengero barungitswe n’abaherezi bakurubakuru n’Abafarisayo. Bari bafise ibimuri, amatara n’ibigwanisho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.3",
            "verseOrgIds": [
              "JHN.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
