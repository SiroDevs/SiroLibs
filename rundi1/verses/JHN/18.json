        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Simoni Petero, yari asanganywe inkota, arayisokora, ayikubita umukozi w’umuherezi mukuru, amuca ugutwi. (Uwo mukozi yitwa Malikusi.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.10",
            "verseOrgIds": [
              "JHN.18.10"
            ]
          }
        }
      ]
    },
