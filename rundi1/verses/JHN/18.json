    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko wa mugwi w’abasoda n’umukuru wabo hamwe na ba barinzi b’urusengero bafata Yesu baramuboha, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.12",
            "verseOrgIds": [
              "JHN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "babanza kumujana kwa Anasi, sebukwe wa Kayafa, umuherezi mukuru wo muri uwo mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.13",
            "verseOrgIds": [
              "JHN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayafa ni we yari yahanuye abakuru b’Abayuda ababwira ko vyoba vyiza ko umuntu umwe apfira abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
