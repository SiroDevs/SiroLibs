          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura bati: “Ntitwari kumukuzanira ata kimwagira.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.30",
            "verseOrgIds": [
              "JHN.18.30"
            ]
          }
        }
