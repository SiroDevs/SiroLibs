            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aca abwira Petero ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        }
      ]
