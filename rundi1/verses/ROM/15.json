              "type": "text"
            }
          ]
        },
        {
          "text": "Maze, Imana ibishatse, nzoheza nze iwanyu nuzuye umunezero, gutyo nduhurwe no kubana namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
