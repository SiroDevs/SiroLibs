            "number": "17",
            "style": "v",
            "sid": "JER 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baravuze bati: “Nimuze, tugire imigambi yo kugwanya Yeremiya; kuko umuherezi ntazoreka kwigisha ivyagezwe, umunyabwenge ntazoreka gutanga impanuro, canke abavugishwa ngo bareke gushikiriza ijambo. Nimuze rero, tumugwanye mu kumuvuga nabi kandi ntitwumvirize ikintu na kimwe avuga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.18",
            "verseOrgIds": [
              "JER.18.18"
            ]
          }
        }
      ]
    }
