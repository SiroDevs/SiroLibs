            "sid": "JER 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ni ryo jambo ryatumwe kuri Yeremiya rivuye k’",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "text": ", rivuga riti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Manuka uje ku nzu y’umubumvyi, aho ni ho nzogira ico ndakubwiye.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndamanuka ku nzu y’umubumvyi, maze nsanga ariko arabumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko inkono yariko arabumbamwo iryo bumba yononekarira mu ntoke ziwe; maze wa mubumvyi aca yongera kuribumbamwo iyindi nkono, ayigira uko yagomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "text": " ambwira ijambo ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yemwe ab’inzu ya Isirayeli, mbega sinoshobora kubagira nk’uko uwo mubumvyi yagize?” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "text": " avuze. “Nk’uko ibumba rimera mu ntoke z’umubumvyi, ni ko mumeze mu kuboko kwanje, yemwe ab’inzu ya Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninamenyesha ko ihanga canke ubwami bugiye kurandurwa, gusamburwa no gusangangurwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze iryo hanga naburiye niryihana rikava mu bibi vyaryo, nzokwigarura sindabateze ivyago nari nateguye kubahanisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ikindi gihe ninamenyesha ko nzokwubaka ngashinga ihanga canke ubwami, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze iryo hanga rigakora ibibi mu nyonga zanje ntirinyumvire, nuko nanje nzoreka kubashitsako ivyiza nari nabagereye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
