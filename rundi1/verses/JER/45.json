            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe Baruki mwene Neriya yandika mu muzingo amajambo uwavugishwa n’Imana Yeremiya amubwiye, mu mwaka ugira kane umwami Yehoyakimu, mwene Yosiya umwami w’i Buyuda, ari ku ngoma, Yeremiya yabwiye Baruki ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "text": ", Imana ya Isirayeli, avuze kuri wewe Baruki: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waravuze uti: ‘Ewe jewe ndagowe! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "text": " anyongerereje imibabaro ku yo nari mfise; ncitse intege ku bwo kuniha kandi nta buruhukiro ngira.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
    {
