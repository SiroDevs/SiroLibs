            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
        {
          "text": " yambariye ngo ndakubwire nti: “Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
        {
          "text": " avuze: ‘Nzosenyura ivyo nubatse kandi nzorandura ivyo nateye, mu gihugu cose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega none woba ukwiye kwironderera ibihambaye? Ntubirondere. Kuko nzoteza ivyago abantu bose, ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.5",
            "verseOrgIds": [
              "JER.45.5"
            ]
          }
        },
        {
          "text": " avuze, ariko aho uzoja hose nzokiza ubugingo bwawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.5",
            "verseOrgIds": [
              "JER.45.5"
            ]
          }
        }
      ]
    }
