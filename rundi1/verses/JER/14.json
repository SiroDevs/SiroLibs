              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndavuga nti: “Ewe ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
        {
          "text": " Nyeninganji, abavugishwa babo baguma bababwira bati: ‘Ntimuzobona inkota canke ngo mwicwe na kigoyi. Ni ivy’ukuri, nzobaha amahoro adashira muri aha hantu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        }
      ]
    },
