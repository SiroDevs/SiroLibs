          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "text": " ambwira ati: “Abo bavugishwa bavuga ibinyoma mw’izina ryanje. Sinabatumye canke ngo ndabatoranye canke ngo mvugane na bo. Bavugishwa kuri mwebwe ivyo beretswe bitari vyo, n’indagu, ubupfumu n’uruhendo rw’ubwenge bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        }
