              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "text": " arambwira ati: “Ntusengere aba bantu ngo bamererwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho bisonzesha, sinzokwumviriza ugutakamba kwabo; naho batanga ibimazi bituriwe n’amashikanwa y’ifu, sinzobemera. Ahubwo, nzobamarisha inkota, ikigoyi n’ikiza.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
