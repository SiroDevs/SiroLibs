            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "text": " ambwira ati: “Naho Mose na Samweli bohagarara imbere yanje, basabira aba bantu umutima wanje ntiwobagirira imbabazi. Barungike kure bave imbere yanje! Nibagende! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
