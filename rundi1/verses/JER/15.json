          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobahindura akajoreza mu bwami bwose bwo kw’isi kubera ivyo Manase mwene Hezekiya umwami w’i Buyuda yakoze i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
