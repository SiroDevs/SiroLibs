          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzorungika ivyo kubazimanganya bine,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "text": " avuze, “inkota yo kubica, imbwa zo kubakwega, ibisiga hamwe n’ibikoko vyo mw’ishamba vyo kubashihagura no kubahonya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
