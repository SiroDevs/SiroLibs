              "type": "text"
            }
          ]
        },
        {
          "text": "‘Muri ico gihe,’ ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "text": " avuze, ‘amagufa y’abami n’abaganwa b’i Buyuda, ay’abaherezi n’ay’abavugishwa n’Imana, hamwe n’ay’abantu b’i Yerusalemu bose, azozurwa akurwe mu mva zayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azokwanikirwa ku zuba, ku kwezi no ku nyenyeri zose zo kw’ijuru; ibigirwamana bakunze bakabikorera kandi ivyo bakurikiye, bakabisiguza, mbere bakanabisenga. Ntazokwegeranywa ngo asubire ahambwe, ahubwo azomera nk’amase ashanjwe kw’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho nzobirukanira hose, abantu b’amasigarira bazoba barokotse bo muri iri hanga rikora ibizira bazohitamwo gupfa kuruta kubaho, ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
