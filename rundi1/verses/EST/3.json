          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Za ntumwa zigenda zihuta kubera itegeko ry’umwami, ico cagezwe kimenyeshwa abo mu gisagara c’i Suza. Umwami na Hamani baricara ngo banywe, ariko abantu bo mu gisagara c’i Suza baja mu ruhagarara.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
