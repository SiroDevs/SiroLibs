          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho umugabo yitwa Mika yava mu karere k’imisozi ya Efurayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.1",
            "verseOrgIds": [
              "JDG.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe abarira nyina wiwe ati: “Narumvise uvuma uwakwivye shekeli igihumbi n’ijana",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:2",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 13.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza. Ni jewe nazivye, ni jewe ndazifise.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina amwishura ati: “",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "text": " aguhezagire, mwana wanje.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
