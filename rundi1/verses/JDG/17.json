        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amugarukaniye za shekeli igihumbi n’ijana z’ifeza, nyina aca avuga ati: “Izi feza ndazeguriye ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        },
        {
          "text": " ku bw’umuhungu wanje kugira ngo zikorwemwo igishushanyo n’ikigirwamana cometseko ifeza. Nzoheza ndabiguhe bibe ivyawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
