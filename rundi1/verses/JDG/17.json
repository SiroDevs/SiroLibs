          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.6",
            "verseOrgIds": [
              "JDG.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe haza umusore w’Umulewi avuye i Betelehemu i Buyuda, yabaye mu muryango wa Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.7",
            "verseOrgIds": [
              "JDG.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ava i Betelehemu arondera aho yoba. Ari ku rugendo ni ho yashika kwa Mika, mu ntara y’imitumba mu gihugu ca Efurayimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.8",
            "verseOrgIds": [
              "JDG.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
