            "sid": "ECC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabonye ikindi kibi musi y’izuba, kandi kiremereye abantu: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iha umuntu ubutunzi bwinshi, n’icubahiro, kugira ngo ntagire ico akena mu vyo umutima wiwe wipfuza, ariko Imana ntimwemerere kubinezererwamwo, maze kavantara akaba ari we abinezererwamwo. Ivyo ni ubusa, ni ikibi giteye umubabaro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ashobora kugira abana ijana akaramba imyaka myinshi; ariko naho yoramba, adashobora kunezererwa ubutunzi bwiwe kandi ntahambwe neza, ndavuga nti arutwa n’ikivutse gihwereye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kivuka ari ubusa, kikazimirira mu mwiza, izina ryaco rikazimirira mu mwiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho kitigeze kibona izuba canke ngo kimenye ikintu na kimwe, kiraruhuka neza kurusha uwo muntu, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho yoramba imyaka igihumbi incuro zibiri ariko ntanezererwe ubutunzi bwiwe. Mbega bose ntibaja hamwe?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
