    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaye Abalewi bose ibigiracumi vyose bivuye mu Bisirayeli nk’umugabane wabo kubera igikorwa bakora kw’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuva ubu Abisirayeli ntibaze begere ihema ry’ibonaniro, kuko hoba inkurikizi mbi ku caha cabo bagapfa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalewi ni bo bazokora igikorwa co kw’ihema ry’ibonaniro kandi babazwe amakosa yose yokorwa kuri ryo. Iri rize ribe itegeko ryamaho uko urunganwe ruzogenda rukurikirana n’urundi. Nta mugabane bazoronka mu bandi Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, mpaye Abalewi nk’umugabane wabo ibigiracumi Abisirayeli bashikanira ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "text": ". Ni co gituma nabavuzeko nti: ‘Ntibazoronka umugabane mu Bisirayeli.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
