            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vugana n’Abalewi ubabwire uti: ‘Nimwakira ivyo bigiracumi ndabahaye nk’umugabane wanyu, muze mutange ikigiracumi c’ivyo mwakiriye nk’ishikanwa mushikaniye ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo shikanwa ryanyu rizoba ari nk’ishikanwa ry’ingano canke ry’ibinyobwa abandi batanga babikuye mu vyimburwa vyabo no mu mato yabo baganiramwo inzabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko namwe muzotanga ishikanwa k’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "text": " rivuye mu bigiracumi muronka bivuye mu Bisirayeli. Kuri ivyo bigiracumi muze mutange umugabane w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "text": " uhabwa Aroni umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mutange nk’umugabane w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "text": " umugabane urusha iyindi kwera ku bintu vyose muhawe.’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        }
      ]
