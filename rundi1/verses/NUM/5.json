              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "canke umugabo niyafatwa n’ivyiyumviro vyo kwikeka umugore wiwe. Umuherezi aze amuhagarike imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "text": " ace akoresha iryo tegeko ryose kuri we. ",
          "type": "text",
