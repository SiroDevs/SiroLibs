              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ni ryo tegeko rijanye n’ukwikeka ko umugore yahemukiye umugabo akiyanduza kandi afise umugabo wiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
