          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose arungika intumwa zivuye i Kadeshi ku mwami wa Edomu abatuma ati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.14",
            "verseOrgIds": [
              "NUM.20.14"
