        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.12",
            "verseOrgIds": [
              "NUM.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo ni yo mazi y’i Meriba, amazi y’imitongano, aho Abisirayeli batonganije ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        },
        {
          "text": " na we akerekana ukwera kwiwe muri bo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        }
      ]
    },
