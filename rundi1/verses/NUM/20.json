          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barasubira babishura bati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.20",
            "verseOrgIds": [
              "NUM.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abanyedomu baraza kubatangira ngo babagwanye bafise ingabo nyinshi kandi zikomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.20",
            "verseOrgIds": [
              "NUM.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyedomu bamaze kubima inzira ngo bace mu gihugu cabo, Abisirayeli barahindukira bicira ahandi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.21",
            "verseOrgIds": [
              "NUM.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.21",
            "verseOrgIds": [
              "NUM.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli bose bava i Kadeshi baja ku musozi Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.22",
            "verseOrgIds": [
              "NUM.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musozi Hori, hafi y’urugabano rwa Edomu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.23",
            "verseOrgIds": [
              "NUM.20.23"
            ]
          }
        },
        {
          "text": " abarira Mose na Aroni ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.23",
            "verseOrgIds": [
              "NUM.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aroni agiye gupfa ahamvye ab’iwabo. Ntazokwinjira mu gihugu ngiye guha Abisirayeli, kuko mwempi mwagararije itegeko ryanje ku mazi y’i Meriba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.24",
            "verseOrgIds": [
              "NUM.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twara Aroni n’umuhungu wiwe Eliyazeri ku musozi Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
          }
        },
        {
          "name": "verse",
