          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli babishura bati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.19",
            "verseOrgIds": [
              "NUM.20.19"
            ]
          }
