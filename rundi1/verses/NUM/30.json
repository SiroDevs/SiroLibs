          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo ni yo mategeko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        },
        {
          "text": " yahaye Mose yerekeye imigenderanire hagati y’umugabo n’umugore wiwe, no hagati ya se n’umukobwa wiwe akiba mu nzu iwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
