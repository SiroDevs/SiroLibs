          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.52",
            "verseOrgIds": [
              "NUM.26.52"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.52",
            "verseOrgIds": [
              "NUM.26.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 26:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Igihugu kize kigaburwe hisunzwe ibitigiri vy’imiryango. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.53",
            "verseOrgIds": [
              "NUM.26.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 26:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuryango munini muze muwuhe hanini, umuryango muto muwuhe hatoya; umwe wese aze aronke umugabane wiwe hisunzwe ibitigiri vyaharuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.54",
            "verseOrgIds": [
              "NUM.26.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 26:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze mukoreshe ubupfindo mu kugabura igihugu, umugwi uwo ari wo wose uzoronka umugabane wawo hisunzwe amazina y’umuryango wa ba sekuru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.55",
            "verseOrgIds": [
              "NUM.26.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 26:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabane uzotangwa hakoreshejwe ubupfindo kandi harabwe ko umuryango ari munini canke mutoya.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.56",
            "verseOrgIds": [
              "NUM.26.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
