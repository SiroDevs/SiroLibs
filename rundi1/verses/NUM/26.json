              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ico kiza ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.1",
            "verseOrgIds": [
              "NUM.26.1"
            ]
          }
        },
        {
          "text": " abarira Mose na Eliyazeri mwene Aroni, umuherezi ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.1",
            "verseOrgIds": [
              "NUM.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Harura Abisirayeli bose uko imiryango yabo iri; abamaze imyaka mirongo ibiri n’iyirenga bashobora kuja ku rugamba.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.2",
            "verseOrgIds": [
              "NUM.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bari mu biyaya vy’i Mowabu ku nkengera za Yorodani aharabana n’i Yeriko, Mose na Eliyazeri umuherezi bavugana na bo bababarira bati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.3",
            "verseOrgIds": [
              "NUM.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Harura abagabo bamaze imyaka mirongo ibiri n’iyirenga, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.4",
            "verseOrgIds": [
              "NUM.26.4"
            ]
          }
        },
        {
          "text": " yategetse Mose.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.4",
            "verseOrgIds": [
              "NUM.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
