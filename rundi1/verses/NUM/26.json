              "NUM.26.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "NUM 26:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo baharuwe na Mose na Eliyazeri umuherezi igihe baharura Abisirayeli mu kiyaya c’i Mowabu ku nkombe ya Yorodani aharabana n’i Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.63",
            "verseOrgIds": [
              "NUM.26.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "NUM 26:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta n’umwe yari muri bamwe baharurwa na Mose na Aroni umuherezi igihe babaharurira mu bugaragwa bw’i Sinayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.64",
            "verseOrgIds": [
              "NUM.26.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "NUM 26:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.65",
            "verseOrgIds": [
              "NUM.26.65"
            ]
          }
        },
        {
          "text": " yari yarabwiye abo Bisirayeli ko bazopfira mu bugaragwa, kandi nta n’umwe yari agisigaye kiretse Kalebu mwene Yefune na Yosuwa mwene Nuni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.65",
            "verseOrgIds": [
              "NUM.26.65"
            ]
          }
        }
      ]
    }
