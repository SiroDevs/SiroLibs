              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahejeje kuvuga ivyo vyose, aho bari bahagaze harasama ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
