          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abantu ibihumbi cumi na bine n’amajana indwi barapfa bishwe n’ico kiza, biyongera kuri bamwe bicwa kubera kugarariza kwa Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.49",
            "verseOrgIds": [
