              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamanuka i kuzimu ari bazima, n’ivyo bari batunze vyose; isi ica iriyugara, barahona bakurwa mu bandi Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
