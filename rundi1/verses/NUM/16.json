              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bari hafi y’aho abo bari, bumvise ugutaka kwabo barahunga, kuko batinya ko isi ibamira na bo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
