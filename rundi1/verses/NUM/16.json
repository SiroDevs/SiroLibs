          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "text": " ari we yantumye gukora ibi bintu ko bitari ivyo niyumviriye: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bantu nibapfa urupfu rusanzwe bagahura n’ibisanzwe biba ku bandi bose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "text": " azoba atantumye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        },
        {
          "text": " niyazana ikintu gishasha, isi ikasama ikabamira n’ivyabo vyose, bakaja mu mva ari bazima, aho ni ho muzomenyera ko aba bantu bakengereye ",
          "type": "text",
