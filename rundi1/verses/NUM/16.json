          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyotezo vy’abo bantu bacumuye bigatuma bapfa. Muze mubicuremwo amabati yo gupfuka igicaniro, kuko vyashikirijwe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.16.38"
            ]
          }
        },
        {
          "text": " bigaca biba ivyera. Bize bibere ikimenyetso Abisirayeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.16.38"
            ]
          }
        }
