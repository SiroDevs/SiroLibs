          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "isi yugurura akanwa kayo irabamira, n’ivyo batunze vyose n’abantu bose bari inyuma ya Kora n’ivyo bari batunze vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
