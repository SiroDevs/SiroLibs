          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahagarara hagati y’abazima n’abapfuye, ikiza kirahagarara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.48",
            "verseOrgIds": [
              "NUM.16.48"
            ]
          }
        },
