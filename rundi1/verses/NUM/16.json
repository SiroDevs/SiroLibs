          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Eliyazeri mwene Aroni, umuherezi, agende atore birya vyotezo biri mu muriro, asuke kure amakara, kuko ivyo vyotezo ari ivyera vyanje; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.37",
