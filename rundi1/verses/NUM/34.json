              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ategeka Abisirayeli ati: “Muze mugabure ico gihugu mukoresheje ubupfindo nk’umugabane wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "text": " yategetse ko kizogaburirwa imiryango icenda n’igice, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko imiryango ya Reyubeni, na Gadi n’igice c’umuryango wa Manase baronse imigabane yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo miryango ibiri n’igice yaronse umugabane wayo mu buseruko bwa Yorodani hakurya ya Yeriko.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
