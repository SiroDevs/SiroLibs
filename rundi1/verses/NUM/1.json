          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli bakora vyose nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
            "verseOrgIds": [
              "NUM.1.54"
            ]
          }
        },
        {
          "text": " yari yabitegetse Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
            "verseOrgIds": [
              "NUM.1.54"
            ]
          }
        }
      ]
