          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Mose yinjira mw’Ihema ry’ibishingantahe aca asanga inkoni ya Aroni yaserukira umuryango wa Lewi, ntiyatutuje amababi gusa ahubwo yashuritse yongera yama na alumonde zihiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose asohora za nkoni azikura imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "text": " azizanira Abisirayeli bose. Baziravye, umwe wese atora iyiwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        }
      ]
    },
