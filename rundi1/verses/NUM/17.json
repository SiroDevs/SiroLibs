            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Subiza ya nkoni ya Aroni imbere y’Isandugu y’ibishingantahe, kugira ngo ibe ikimenyetso c’abagumutse. Ivyo bizokuraho imyidodombo banyidodombera, kugira ngo ntibapfe.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aca akora nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "text": " yamutegetse nyene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        }
      ]
    },
