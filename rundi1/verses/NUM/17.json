              "NUM.17.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Abisirayeli bazane inkoni icumi na zibiri, imwimwe ku muryango wose ivuye ku mukuru aserukira uwo muryango. Uze wandike izina rya nyene inkoni ku nkoni yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nkoni ya Lewi uze wandike izina rya Aroni, kuko hategerezwa kuba inkoni imwe ku mukuru w’umuryango wose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze muzishire mw’Ihema ry’Ibonaniro imbere y’Isandugu y’Isezerano, aho mbonanira namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkoni y’uwo nzoba ntoranije izoshurika, gutyo nzoba nikuriyeho imyidogo Abisirayeli bama bakwidogera.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
