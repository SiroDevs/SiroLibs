          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose, Aroni n’Abisirayeli bose baca bakora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "text": " yategetse Mose vyose ku Balewi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abalewi bariyeza bamesura n’impuzu zabo. Maze Aroni aca abazana nk’ishikanwa rizungagizwa imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "text": " aca abatangira impongano kugira ngo abeze. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Abalewi baza gukora igikorwa cabo kw’ihema ry’ibonaniro barongowe na Aroni n’abahungu biwe. Uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        },
        {
          "text": " yari yategetse Mose, ni ko bakoze ku Balewi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
      ]
    },
