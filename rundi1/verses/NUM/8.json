              "NUM.8.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.1",
            "verseOrgIds": [
              "NUM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Aroni, uti: ‘Igihe muzoshiraho ya matara indwi, muze muyashire ahantu ashobora kumurika ku ruhande rw’imbere rw’igiterekwako amatara.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni aca akora uko; ashira amatara aho ashobora kubonesha imbere y’igiterekwako amatara, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "text": " yabitegetse Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ico giterekwako amatara cakozwe: cari gikozwe mu nzahabu yahondeshejwe inyundo; kuva musi gushika hejuru. Ico giterekwako amatara cari gikozwe nka ca kigereranyo ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        },
        {
          "text": " yari yeretse Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
