              "NUM.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.14",
            "verseOrgIds": [
              "NUM.12.14"
            ]
          }
        },
        {
          "text": " yishura Mose ati: “Mbega iyo aba ari se yamuvumye amate mu maso, ntiyari kumara iyinga ryose amaramara? Nimumukure hagati y’aho mucumbitse hahere imisi indwi, hanyuma azobone kugaruka.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.14",
            "verseOrgIds": [
              "NUM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero Miriyamu ashirwa inyuma y’aho bacumbitse amarayo imisi indwi, abantu ntibava ngaho kugeza igihe yagarukanwa muri bo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        }
      ]
