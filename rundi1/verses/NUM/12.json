        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugabo Mose yari umuntu aciye bugufi kurusha abandi bantu bose bo kw’isi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
