        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abari bicaye mu nama nkuru y’abarongoye ubwo bwoko bose bamwihweje, babona mu maso hiwe hasa n’ah’umumarayika.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.15",
            "verseOrgIds": [
              "ACT.6.15"
            ]
          }
        }
      ]
