          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we avyumvise aca aja kuri wa mukuru wabo amubwira ati: “Mbega ubigenza gute? Erega wa mugabo ni Umuroma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        }
      ]
