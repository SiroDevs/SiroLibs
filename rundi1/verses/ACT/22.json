          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mukuru ati: “Na jewe ndi we, kandi natanze amahera menshi kugira ngo ndonke ubwo bwenegihugu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
