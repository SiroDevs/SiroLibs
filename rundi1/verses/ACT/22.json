            "sid": "ACT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.1",
            "verseOrgIds": [
              "ACT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bumvise avugana na bo mu Giheburayo, baca barahora, haba agacerere kenshi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulo aca arabandanya ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndi Umuyuda, navukiye i Taruso muri Kilikiya, ariko nakuriye hano i Yerusalemu, nigishwa na Gamaliyeli kwitondera ivyagezwe vya ba sogokuruza mu kuri kwavyo kwose. Nagize ishaka ryinshi ryo kwubaha Imana nk’uko namwe muri hano uwu musi muyubaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.3",
            "verseOrgIds": [
              "ACT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahama abakurikira inzira y’Umwami Yesu gushika naho bamwe bapfa, ngafata abagore n’abagabo nkabata mw’ibohero. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo umuherezi mukuru n’abagize Inama Nkuru y’Abayuda bose bashobora kubishingira intahe. Mbere ni na bo bampaye amakete nshira Abayuda benewacu b’i Damasiko, maze njayo gufata abizera baho ngo ndabazane i Yerusalemu ari imbohe, kugira ngo bahanwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’igihe c’isaha zitandatu z’umurango, ndiko ndegereza i Damasiko, umuco uvuye mw’ijuru undasira impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.6",
            "verseOrgIds": [
              "ACT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ngwa hasi hanyuma numva ijwi rimbarira riti: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.7",
            "verseOrgIds": [
              "ACT.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.7",
            "verseOrgIds": [
              "ACT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje ndabaza nti: ‘Uri nde ga Mwami?’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.8",
            "verseOrgIds": [
              "ACT.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rya jwi riranyishura riti: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.8",
            "verseOrgIds": [
              "ACT.22.8"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.8",
            "verseOrgIds": [
              "ACT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo twari kumwe barabona umuco ariko ntibumva ijwi ry’uwo twariko turavugana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.9",
            "verseOrgIds": [
              "ACT.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.9",
            "verseOrgIds": [
              "ACT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje ndamubaza nti: ‘None nkore iki ga Mwami?’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.10",
            "verseOrgIds": [
              "ACT.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Yesu aranyishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.10",
            "verseOrgIds": [
              "ACT.22.10"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.10",
            "verseOrgIds": [
              "ACT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo twagendanye baca bamfata ukuboko bantwara i Damasiko, kuko wa muco mwinshi wari watumye mpuma amaso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ico gisagara hariho umuntu yitwa Ananiya. Yari umuntu yubaha Imana, akitondera ivyagezwe, kandi Abayuda bose baho bamushingira intahe nziza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.12",
            "verseOrgIds": [
              "ACT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko aza kundaba, ampagarara i ruhande ambwira ati: ‘Mwene Data Sawuli, humuka!’ Ako kanya nyene nca ndahumuka, ndamubona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.13",
            "verseOrgIds": [
              "ACT.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.13",
            "verseOrgIds": [
              "ACT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze aravuga ati: ‘Imana ya ba sogokuruza yagutoranirije kumenya ivyo igomba, kubona wa Mugororotsi, no kwumva ijwi ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.14",
            "verseOrgIds": [
              "ACT.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzomubera icabona co gushingira intahe ivyo wabonye n’ivyo wumvise imbere y’abantu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.15",
            "verseOrgIds": [
              "ACT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ni igiki kigutebeje? Va hasi ubatizwe, wambaze izina ryiwe, ubone kwozwa ivyaha vyawe.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kugaruka i Yerusalemu, umusi umwe ndi mu rusengero ndiko ndasenga nderekwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbona Umwami Yesu ambwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nca ndamwishura nti: ‘Mwami, aba bantu barazi ko naciye mu masinagogi yose ngata mw’ibohero nkongera ngakubitisha abakwizera. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi igihe amaraso ya Setefano uwagushingira intahe yaseseka, ni ho nari, nemeza ko yicwa, mfatiye impuzu abariko baramwica.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca arambwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gushika kuri ayo majambo, abantu bari bakiriko baramwumviriza. Maze baca batangura gushira urwamo hejuru bati: “Mukure kw’isi! Uwo ntakwiye kubaho!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 22:22"
          },
          "items": [
            {
              "text": "22",
