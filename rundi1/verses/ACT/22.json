          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagishira urwamo hejuru, bata impuzu bongera basurira umukungugu hejuru, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa mukuru w’abasoda aca ategeka ko Pawulo ajanwa mw’ikambi, bakamusambisha bamukubita kugira ngo bamenye igituma abantu bose bahagurukiye rimwe kumwiyamiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kumuboha ngo bamukubite, Pawulo aca abaza umukuru w’abasoda ijana yari ahagaze aho ati: “Mbega biremewe n’amategeko gukubita Umuroma, ata rubanza rwamutsinze?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
