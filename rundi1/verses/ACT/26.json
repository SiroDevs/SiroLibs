          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agiripa abarira Fesitusi ati: “Iyaba atari yaramaze kwungururiza kwa Kayisari, yaca arekurwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
