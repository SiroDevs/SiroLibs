          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abari bakoraniye hamwe na we baramubaza bati: “Mwami, none ubu ni ho ugomba ugarukane ya ngoma ya Isirayeli?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        }
      ]
    },
    {
