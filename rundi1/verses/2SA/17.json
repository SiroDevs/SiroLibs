            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu yari yatoye Amasa ngo abe umukuru w’ingabo mu kibanza ca Yowabu. Amasa yari umuhungu w’umugabo yitwa Yeteri, Umwisirayeli yari yarongoye Abigayili, umukobwa wa Nahashi kandi yavukana na Zeruwiya nyina wa Yowabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.25",
            "verseOrgIds": [
              "2SA.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
