            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitofeli abonye ko inama yiwe itumviwe, aca ategura indogoba yiwe ataha iwe mu gisagara c’iwabo. Aca atunganya ivyo mu rugo rwiwe hanyuma ariyahura. Apfuye, bamuhamba hamwe na se.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.23",
            "verseOrgIds": [
              "2SA.17.23"
            ]
          }
        }
