        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mugore aje aho Sawuli ari, akabona ko yagize ubwoba bwinshi, aramubwira ati: “Raba, umusavyikazi wawe nakwumviye. Nahevye amagara yanje nkora ivyo wantegetse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero umviriza ivyo umusavyikazi wawe mvuga kandi unyemerere ndakuzanire imfungurwa kugira ngo urye, usubizwemwo intege ushobore gutaha.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        }
      ]
    },
