              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aranka aravuga ati: “Sindya.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        }
