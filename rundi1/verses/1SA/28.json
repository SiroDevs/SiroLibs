            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abantu bari kumwe na we bafatanya n’uwo mugore baramwinginga, maze arabumvira. Ava hasi yicara ku buriri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        }
      ]
    },
