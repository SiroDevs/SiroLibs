          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo nyene Sawuli aca agwa hasi yubamye, yuzuye ubwoba kubera amajambo ya Samweli. Inkomezi zirahera, kuko ata co yari yariye uwo musi wose n’ijoro ryose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
