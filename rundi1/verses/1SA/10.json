              "1SA.10.22"
            ]
          }
        },
        {
          "text": " aravuga ati: “Egome, yinyegeje mu mizigo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.22",
            "verseOrgIds": [
              "1SA.10.22"
