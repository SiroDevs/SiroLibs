              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baragenda bamukurayo, kandi ahagaze mu bantu akabaruta mu burebure bose. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.23",
