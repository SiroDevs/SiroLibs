          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko basiguza ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.22",
            "verseOrgIds": [
              "1SA.10.22"
            ]
          }
        },
        {
          "text": " bati: “Mbega uwo muntu yoba araza hano?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.22",
            "verseOrgIds": [
              "1SA.10.22"
            ]
          }
        }
