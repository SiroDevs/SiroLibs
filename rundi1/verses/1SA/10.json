              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Sawuli ataha iwe i Gibeya, aherekejwe n’abahizi Imana yakoze ku mitima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
