              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntimuze mwibagire Abalewi baba mu bisagara vyanyu, kuko ata matongo canke iragi bafise mu bisagara vyabo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
