              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.22",
            "verseOrgIds": [
              "DEU.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje numvise ko ico ciyumviro ari ciza, nca ntoranya abagabo icumi na babiri, umwe mu muryango wose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
            "verseOrgIds": [
              "DEU.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraduga muri ico gihugu, bashika mu kiyaya ca Eshikoli, baracihweza neza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.24",
            "verseOrgIds": [
              "DEU.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batora n’ivyamwa vyo muri ico gihugu, barabituzanira, batubwira inkuru zaho, bati: “Igihugu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
        {
          "text": " Imana yacu aduhaye ni ciza cane.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntimwashatse kuduga ngo mucinjiremwo, mugarariza ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "text": " Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwidogeye mu mahema yanyu muvuga muti: “",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "text": " aratwanka, yadukuye muri Egiputa kugira ngo aturekurire mu maboko y’Abamori batumare. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega none tuja hehe? Benewacu ko batumye imitima yacu ishongeshwa n’ubwoba. Bavuze bati: ‘Abantu baho barakomeye kuturusha kandi mu burebure baradusumba, ibisagara vyabo ni bininibinini, inzitiro zavyo zikora ku bicu, kandi twarabonyeyo n’abakomoka kuri Anaki.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
