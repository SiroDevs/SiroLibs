              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe narababwiye nti: “Ntimucike ivutu, ntimubatinye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imana yanyu agendera imbere yanyu azobagwanira, nk’uko mwabonye ibagwanira muri Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igihe mwari mu bugaragwa. Harya mwarabonye ingene ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "text": " Imana yanyu yabateruye nk’uko umuvyeyi aterura umwana wiwe, gushika mushitse aha hantu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        }
      ]
    },
