        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose Ahamagara Abisirayeli bose arabakoranya, ababwira ati: Tega amatwi yemwe Bisirayeli! Umviriza ivyagezwe n’amabwirizwa ndabahaye uwu musi, kugira ngo muyige mwongere muyakurikize.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "text": " Imana yacu yagiranye isezerano natwe ku musozi Horebu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo sezerano ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "text": " ntiyarigiranye na ba sogokuruza, yarigiranye na twebwe, twebwe abakiriho uno musi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " yivuganiye namwe imbonankubone ari mu muriro kuri wa musozi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe nari nk’umuhuza hagati y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "text": " namwe kugira ngo ndabashikirize amajambo y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "text": ", kuko mwari mwatinye umuriro ntimwaduga ku musozi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaravuze iti:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo vyagezwe ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        },
        {
          "text": " yavuze n’ijwi rirenga abibwira ikoraniro ryanyu kuri wa musozi ari mu muriro, mu gicu no mu mwijima ukomeye; kandi nta kindi yongeyeko. Yaciye avyandika ku bisate bibiri vy’amabuye, arabimpa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko igihe mwumva ijwi riva mu mwijima, kandi umusozi wuzuyeko imbeya z’umuriro, abatware b’imiryango yanyu bose baje aho ndi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.23",
            "verseOrgIds": [
              "DEU.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barambarira bati: “",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "text": " Imana yacu yatweretse ubwiza bwiwe n’ubukuru bwiwe, kandi twiyumviye ijwi ryayo ivugira mu muriro. Uwu musi twiboneye ko Imana ishobora kuvugana n’umuntu kandi akabaho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ni kubera iki twokwishira mw’irinde ry’urupfu? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "text": " Imana yacu niyasubira kuvugana natwe, nta kabuza tuzopfa. Urya muriro uhambaye uratuyigiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega hari umuntu buntu ashobora kwumva ijwi ry’Imana ivugira mu muriro nk’uko twayumvise, hanyuma akabaho? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.26",
            "verseOrgIds": [
              "DEU.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero nabe ari wewe ugenda wegere wumvirize ico ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        },
        {
          "text": " Imana yacu avuga, hanyuma ugaruke utubwire ivyo yakubariye vyose, natwe tuzokwumvira tubikurikize.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
        {
          "text": " yarabumvise igihe mwambarira ukwo, araheza ambarira ati: “Niyumviye ivyo abo bantu bakubwiye, kandi ivyo bavuze vyose ni vyiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese imitima yabo yokwama yicisha bugufi, bakantinya bakongera bakanyubaha, bakama bakurikiza amabwirizwa yanje, kugira ngo ivyabo bize bigende neza kuri bo no ku ruvyaro rwabo, ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.29",
            "verseOrgIds": [
              "DEU.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.29",
            "verseOrgIds": [
              "DEU.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Genda ubabwire basubire mu mahema yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.30",
            "verseOrgIds": [
              "DEU.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko wewe uce ugaruka ugume ngaha ndaguhe ivyagezwe, amabwirizwa n’amategeko uzobigisha, kugira ngo bazobikurikize nibamara gushika mu gihugu ngira ndabahe ngo bacegukire.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwiyubare kugira ngo muzokore ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "text": " Imana yanyu abategeka vyose, ntihagire na kimwe muzoca i ruhande. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzogume mu nzira ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        },
        {
          "text": " Imana yanyu azobereka, ni ho ivyanyu bizogenda neza, mukarambira muri ico gihugu muhawe ngo mucegukire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        }
      ]
    }
