          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi aba rurangiranwa mu gihugu cose, kandi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        },
        {
          "text": " atuma ibihugu vyose bimutinya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
