              "1CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya mwene Yehoyada yari umugwanyi w’umuhizi yava i Kabuzeyeli, kandi yakoze ibihambaye. Yishe abahizi babiri baruta abandi mu ngabo z’Abanyamowabu. Umusi umwe shelegi iriko iragwa, amanuka mu rwobo, yica intambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we yishe Umunyegiputa yari afise ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:23",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’igihagararo. Naho uwo Munyegiputa yari afise mu minwe icumu rikwikiye mu ruti rungana n’umuhini, Benaya yagiye kumugwanya afise inkoni, amushikura rya cumu mu minwe, aba ari ryo amwicisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo bikorwa vy’ubuhizi Benaya mwene Yehoyada yakoze; na we nyene yari rurangiranwa nka bamwe batatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yari afise icubahiro kuruta bamwe mirongo itatu, ariko ntiyari uwo muri bamwe batatu. Maze Dawidi aca amugira umukuru w’abacungera umutekano wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
