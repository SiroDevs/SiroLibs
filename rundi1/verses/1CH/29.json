          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        },
        {
          "text": " ashira hejuru Salomo imbere y’Abisirayeli bose kandi amuha icubahiro ubwami bwiwe buba bwiza kurusha abami bose b’Abisirayeli bamwitangiye imbere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
