              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyabaye ku ngoma y’umwami Dawidi, kuva mu ntango gushika kw’iherezo, vyanditswe mu gitabu ca Samweli uwerekwa, mu vyanditswe vya Natani uwavugishwa n’Imana no mu vyanditswe vya Gadi uwerekwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "biri kumwe n’ido n’ido ry’ivyo ku ngoma yiwe n’ububasha bwiwe, n’ivyagiye biraba mu gihe ciwe hamwe n’Abisirayeli, n’ubwami bwose bwari buhakikije.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.30",
            "verseOrgIds": [
              "1CH.29.30"
            ]
          }
        }
