        },
        {
          "text": "Nimwimbura ivyo mu gihugu canyu, ntimuze mwimbure ivyameze hirya y’urubibe rwanyu canke ngo musubire inyuma gutoragura ivyasigaye mu mirima. Muze mubirekere abakene n’inyambukira. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        },
        {
          "text": " Imana yanyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
