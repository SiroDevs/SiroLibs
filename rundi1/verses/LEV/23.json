          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mugire igikorwa muwukorako ariko muze mushikanire ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        },
        {
          "text": " ikimazi co guturirwa.’ ”",
