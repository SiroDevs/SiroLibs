        {
          "text": "Nuko Aroni n’abahungu biwe bakora vyose nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
            "verseOrgIds": [
              "LEV.8.36"
            ]
          }
