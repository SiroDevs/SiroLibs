              "LEV.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abarira Aroni n’abahungu biwe ati: “Nimuteke inyama zisigaye, muzitekere imbere y’umuryango w’ihema ry’ibonaniro, muzirire aho nyene muzikoze imikate iri muri ca giseke c’imikate y’amashikanwa yo kurobanura, nk’uko nategetse, aho navuga nti: ‘Aroni n’abahungu biwe baze babirye.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma ibisigara kuri izo nyama no kuri iyo mikate biturirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze muve ku muryango w’ihema ry’ibonaniro, muze muhamare imisi indwi, kuko kurobanurwa kwanyu kuzomara imisi indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo twakoze vyose uwu musi, ni vyo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "text": " yategetse kugira ngo mutangirwe ikimazi c’ivyaha vyanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mugume ku muryango w’ihema ry’ibonaniro ku murango no mw’ijoro gushika imisi indwi iheze, mukore ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "text": " yategetse kugira ngo ntimupfe, kuko uko ari ko nategetswe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        }
      ]
