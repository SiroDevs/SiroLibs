          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Mose yakira ku mavuta yo kurobanura no ku maraso ari ku gicaniro abimija Aroni n’imyambaro yiwe yongera abimija abahungu biwe n’imyambaro yabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
