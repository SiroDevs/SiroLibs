        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri rize ribe ibwirizwa rihoraho kuri mwebwe: ku musi ugira icumi w’ukwezi kw’indwi muze mwisonzeshe kandi ntihagire igikorwa na kimwe mukora, yaba uwavukiye muri mwebwe canke umunyamahanga aba muri mwebwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko kuri uwo musi hazoba gucungurwa kwanyu, kugira ngo muhumanurwe. Namwe muzoba mwejejwe ivyaha vyanyu vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izoba ari Isabato y’ukuruhuka, muze muwuruhukeko kandi mwisonzeshe; iri rize ribe ibwirizwa rihoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi yasizwe amavuta kandi yatoranirijwe gusubirira se wiwe nk’umuherezi mukuru ni we azotanga ikimazi co gucungura. Aze yambare za mpuzu zera derere, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "atange ikimazi co gucungura Ahera Cane, ihema ry’ibonaniro, igicaniro, abaherezi n’abantu bose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
