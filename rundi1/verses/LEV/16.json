          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri rize ribe ibwirizwa rihoraho kuri mwebwe: ico kimazi co gucungura kizohora gitangwa rimwe mu mwaka gitangirwe ivyaha vyose vy’Abisirayeli.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
