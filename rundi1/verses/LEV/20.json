          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo niyaryamana n’umugore ari mu miziro y’ukwezi, aze azire ko yerekanye isoko y’amaraso y’uwo mugore, uwo mugore na we ko yemeye kwiyambura no kuyerekana. Bompi baze bakurwe mu bwoko bwabo, kuko bemeranije kwerekana isoko y’amaraso y’uwo mugore.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        }
      ]
