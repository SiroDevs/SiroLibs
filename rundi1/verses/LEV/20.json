          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo niyarongora umugore na nyina w’uwo mugore, ico ni ubuyobe, yaba uwo mugabo, baba abo bagore, bose baze baturirwe, kugira ngo mukure ubuyobe muri mwebwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
