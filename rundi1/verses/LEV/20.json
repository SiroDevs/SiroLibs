              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore niyasambana n’igikoko, muze mwice uwo mugore n’ico gikoko. Vyompi bize vyicwe kandi amaraso yavyo azoje ku mutwe wiwe n’uw’ico gikoko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
