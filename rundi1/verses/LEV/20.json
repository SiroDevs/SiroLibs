      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo canke umugore ahamagara imizimu canke abapfumu ari muri mwebwe aze yicwe. Muze mumwicishe amabuye; amaraso yiwe azoje ku mutwe wiwe ubwiwe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
