        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo niyasambana n’uwundi mugabo nk’uko umugabo asambana n’umugore, bompi bazoba bakoze ivyo kwankwa urunuka. Baze bicwe; amaraso yabo azoje ku mitwe yabo ubwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
