            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo niyasambana n’umukazana wiwe, bompi baze bicwe. Kuko bazoba bakoze ikizira; amaraso yabo azoje ku mitwe yabo ubwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
