          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo niyarongora mushikiwe, yaba uwo bavukana kuri se canke kuri nyina, bakaryamana, ni agatetereza. Baze bakurwe imbere yanyu. Kuko azoba yatetereje mushikiwe, azobizire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        }
