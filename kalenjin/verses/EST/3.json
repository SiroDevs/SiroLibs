          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiba anyun bik che kiga kiyokto kochakta eng’ ng’atutietab laitoriat, ak kigigon ng’atutionoto eng’ Susan, nganaset ne o: ak kiteb ng’ony laitoriat ak Haman koeeiso; ago kiimgei nganasetab Susan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
