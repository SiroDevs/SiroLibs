              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuto ko borotosiek che kipchei eng’ barbarek Eleasar tisiindet, ak Josua weritab Nun, koboto che eechen eng’ gorikab kwanisiek, che bo bororiosiekab lagokab Israel, kipchei eng’ Silo koek borotet eng’ taitab Jehovah, eng’ kurgetab emait ne kituiyechin. Kiiges anyun pcheetab emet.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
      ]
