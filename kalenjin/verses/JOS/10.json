          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinam Josua laitorinichoto tugul, ak emotinwekwak eng’ betusiechoto, amu kiyai Jehovah, Kamuktaindetab Israel, luget agobo Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
