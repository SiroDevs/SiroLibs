            }
          ]
        },
        {
          "text": "Ak kisiirto Josua eng’ Libna, koboto Israel tugul, koba Lakis, ak koteech taitab nganasanato, ak kobargei: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
