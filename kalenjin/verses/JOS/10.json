              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kisiirto Josua eng’ Makeda, koboto Israel tugul, koba Libna, ak kobargei ak Libna: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
