          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kinam eng’ betunoto, ak kobar eng’ rotwetab chok bik tugul che kimi orit, ak kibar kogesgei eng’ betunoto ko u tugul che kiga yachi Lakis.",
          "type": "text",
