              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitogosta Josua eng’ Eglon, koboto Israel tugul, koba Hebron; ak kobargei: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
