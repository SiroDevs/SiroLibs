          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiigoito Jehovah nganasanato agine, koboto laitoriandennyi, konde eunekab Israel; ak kibar nganasanato koboto bik tugul che kimi orit eng’ rotwetab chok; ma bagakta agot agenge eng’ orit; ak kiyachi laitoriandennyi ko u ye kiga yachi laitoriatab Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
