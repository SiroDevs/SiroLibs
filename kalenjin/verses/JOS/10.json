          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiinde Jehovah Lakis eunekab Israel, ak kinam eng’ betut ne bo aeng’, ak kobar koboto bik tugul che kimi orit, eng’ rotwetab chok, ko u tugul che kiga yachi Libna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
