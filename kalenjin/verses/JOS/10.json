          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kinam, ak kobar eng’ rotwetab chok, bik tugul che kimi orit; koboto laitoriandennyi, ak nganasokyik tugul, ma bagakta agot agenge, ko u tugul che kiga yachi Eglon; king’em koges, koboto bik tugul che kimi orit.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
