              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kisiirto Josua eng’ Lakis, koboto Israel tugul, koba Eglon, ak koteech taitab nganasanato, ak kobargei; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
