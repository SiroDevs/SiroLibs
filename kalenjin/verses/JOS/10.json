          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kinam, koboto laitoriandennyi, ak nganasokyik tugul; ak kobar ichek eng’ rotwetab chok, ak kobar bik tugul che kimi orit kogesgei; ma bagakta agot agenge: ko u ye kiga yachi Hebron, koyachi Debir ko u noto, koboto laitoriandennyi; ko u ye kiga yachi Libna agine ak laitoriandennyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
