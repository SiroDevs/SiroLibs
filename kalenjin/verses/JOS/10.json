          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiweek Josua, koboto Israel tugul, koba nganaset eng’ Gilgal.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
