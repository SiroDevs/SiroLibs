          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibar anyun Josua emet tugul, emetab tulonok, ak komostab Murot ne bo Tai, ak warenget, ak chepkeigeusiek, koboto laitorinikwak tugul; ma bagakta kong’et agot agenge: kibar koges tugul che kitinyei kabuset, ko u ye king’at Jehovah Kamuktaindetab Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibar Josua ichek koboch Kades-barnea agoi Gasa, ak emet komugul ne bo Gosen, agoi Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
