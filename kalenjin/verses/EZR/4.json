          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kogirindoi bunik teeksetab irimoikab Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingogas anyun bunikab Juda ak Benjamin kole kateekyi Jehovah, Kamuktaindetab Israel, hekalut, lagokab luulenik, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "korikta anyun ole mi Serubabel, ak kandoikab gorikab kwanisiek, ak kolenji ichek, Ongeteech tugul: amu kicheng’e Kamuktaindeng’wong’, ko u okwek; ak keeng’jini inendet tiseiywek koboch betusiekab Esar-hadon laitoriatab Asuria ne kiimutwech kebwa olito.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kilenji ichek Serubabel, koboto Jesua, ak kandoik tugul che bo gorikab kwanisiek che bo Israel, Magiting’ege yamdao ak okwek keteech tugul gotab Kamuktaindennyo; ago kiteekyini achege Jehovah, Kamuktaindetab Israel, got, ko u ye king’atech laitoriat Kirus laitoriatab Persia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiigochi anyun bikab emonoto bikab Juda kochorirenso, ak koiim ichek eng’ teekset. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kisir ng’omotik che bo melekto, si kogirinda ichek kowal magenywa koek buch, eng’ betusiek tugul che bo Kirus laitoriatab Persia, agoi koit laitornatetab Darius laitoriatab Persia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kisir bichoto kataamset agobo bik che kimenyei Juda ak Jerusalem eng’ betusiekab laitornatetab Aasuerus, eng’ taunetab laitornatennyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ betusiekab Artaserses kosirji baruet Bislam, Mitredat, Tabeel, koboto choronokwak tugul, kosirji Artaserses laitoriandanato bo Persia; ak kigisire baruanato sirutikab Suria, ak kemwae kutitab Suria.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisir anyun baruet Reum bounindetab kiruoget ak Simsai sirindet, kosirji laitoriat Artaserses, kotaam Jerusalem ko u ni: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisir anyun Reum bounindetab kiruoget, ak Simsai sirindet, koboto choronokwak tugul, Dinaik, Aparsatkik, Tarpelik, Aparsik, Arkebik, Babulonik, Susankik, Deaik, ak Elamik, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak bororiosiek alak che kiimutu Osnaper ne o ak ko toogunot, kolong’ kobwa nganasetab Samaria, ak emet ne mi ainet bitonin.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu anyun ng’alek che bo baruanato kigiyoktochin laitoriat Artaserses: Achek otwogiguk che kimi bitoni, ak alak. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingonaak eng’ laitoriat kole, Yahudik che kibunu oldang’ung’ ko kogoitwech eng’ Jerusalem; teechei nganaset ne ngeleliot ak ko ya, ak kogoges irimoik, ak kogoteech kogeny lumeiywot ne kiga kobutok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingonaak nguno eng’ laitoriat kole, Ngot koteech nganasani, ak koges irimoikyik, ko ma kogoitoi kodi, ak aisurut, anan ko aisurutab tuguk, ak eng’ let, kong’em laitorinik. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.13",
            "verseOrgIds": [
              "EZR.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara anyun, amu kiame munyuk che bo gotab laitoriat, ak ma nyoljinech kegeer keng’emjin laitoriat teegisto, kagiyogu anyun amu noto kiborji laitoriat; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.14",
            "verseOrgIds": [
              "EZR.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kobiit kecheng’ eng’ bukuit ne bo ng’alekab betusiekab kwanisieguk: si kobiit inyorji bukuinoto bo ng’alekab betusiek, ak inai ile ngeleliot nganasani, ak koiimi laitorinik ak emotinwek, ak kigong’eet chaamset koboch keny: noto anyun ne kiigochi nganasanito keng’em. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.15",
            "verseOrgIds": [
              "EZR.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiborjini anyun laitoriat kelenjini, ngot keteech nganasani, ak kiges irimoik, koboru noto kole, ma itinye kebeberta eng’ ainet bitoni.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiiyokyi anyun laitoriat wolunet Reum bounindetab kiruoget, ak Simsai sirindet, ak choronokwak tugul che kimenyei Samaria, ak emet tugul ne mi ainet bitonin, kole, Ingoteb kalyet ko u noto.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruet ne kigooyokwech ko kagesoman komie eng’ tainnyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.18",
            "verseOrgIds": [
              "EZR.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koang’at, ak kogecheng’, ak kenyor kele king’eetyo nganasanito bo keny kobistoe laitorinik, ak kogobiitune ngelelnatet ak chaamset. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.19",
            "verseOrgIds": [
              "EZR.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimitei kogeny laitorinik che ki kimen che kibou Jerusalem, che kibou emet tugul ne mi ainet bitonin; ak kigigochin kodi, ak aisurut, ak aisurutab tuguk. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ong’at anyun kit ne igochin bichoto kosisyo, si mata koteech nganasani, agoi tun ang’at. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oripge anyun si mogaege ng’olyondonoto: amu nee si kotesak ng’emisiet ne inyalili laitorinik?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingo kagesoman ng’alekab baruetab laitoriat Artaserses eng’ taitab Reum, ak Simsai sirindet ak choronokwak, kochakta Jerusalem ole mi Yahudik, kwo kong’at ichek eng’ koromnatet ak kimnatet kobagakta boisiet.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
