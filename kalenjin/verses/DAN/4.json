      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alosu anyun ane Nebukadnesar, ak atorori ak agonyiti Laitoriatab kipsengwet; amu bo iman boisionikyik tugul, ak ko bo kiruoget ortinwekyik: ak imuchi koming’in ichek che bendoti eng’ menotet.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.37"
            ]
          }
        }
