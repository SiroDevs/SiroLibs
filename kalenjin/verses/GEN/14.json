  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "GEN 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lugetab laitorinik. Luuletab Lot ak ole kigisorundo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibiit ko u ni eng’ betusiek che bo Amrapel, laitoriatab Sinar, ak Ariok, laitoriatab Elasar, ak Kedolaomer, laitoriatab Elam, ak Tidal, laitoriatab Goim, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.1",
            "verseOrgIds": [
              "GEN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiborio laitorinichuto ak Bera, laitoriatab Sodom, ak Birisa, laitoriatab Gomora, ak Sinab, laitoriatab Adma, ak Semeba, laitoriatab Seboim, ak laitoriatab Bela (noto ko Soar). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiiyomogei chuto tugul eng’ atebwetab Sidim (noto ko Araraita ne bo Munyuk). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.3",
            "verseOrgIds": [
              "GEN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiot ichek Kedolaomer kenyisiek taman ak aeng’, ak eng’ kenyitab taman ak somok kongelelso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.4",
            "verseOrgIds": [
              "GEN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo Kedolaomer koboto laitorinik che kimi ak inendet, eng’ kenyitab taman ak ang’wan, kwo kobar Repaik eng’ Asterot-Karnaim, ak Susik eng’ Am, ak Emik eng’ Sabe-Kiriataim, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak Horik, eng’ tulwenywa Seir, agoi El-paran, ne negite ong’atet. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koweek kobwa En-mispet (noto ko Kades) ak kobar koret tugul ne bo Amalekik, ak Amorik agichek, che kimenyei Hasason-tamar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimanda laitoriatab Sodom, ak laitoriatab Gomora, ak laitoriatab Adma, ak laitoriatab Seboim, ak laitoriatab Bela (noto ko Soar); kitet luget kotuiyo eng’ atebwetab Sidim, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.8",
            "verseOrgIds": [
              "GEN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiba koborio ak Kedolaomer, laitoriatab Elam, ak Tidal, laitoriatab Goim, ak Amrapel, laitoriatab Sinar, ak Ariok, laitoriatab Elasar; koborio laitorinik ang’wanu ak laitorinik mut. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki nyiitat atebwetab Sidim keringonik che bo lamit; ak kimwei laitorinik che bo Sodom ak che bo Gomora, ak kirorokyi oloto, ak kimwechi chun kang’et tulwet. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiluul tuguk tugul che bo Sodom ak che bo Gomora, ak amitwogikwak tugul, ak koba bandanywa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiluul Lot weritab ng’etab kametab Abram, ne kimenyei Sodom, ak tugukyik, ak koba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwa chito ne kigachilil, si komwachi Abram Hebranindet: ne tebune ole negite ketikab Mamre, Amorindet ne tupcho ak Eskol, ng’etab kam bo Aner; ak kinamegei bichuto ak Abram. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogas Abram kole, Kageluul ne bo ornywa, koawen koboto otwogikyik che kiginet luget, che kigisikyin gonnyi, bik bogol somok ak taman ak sisit, ak kiisub laitorinichoto agoi koit Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiyiem inendet ak otwogikyik bunik kemoi, ak kobar ichek, ak kiisub agoi koit Hoba ne mi eutab katam ne bo Damasko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kisor tuguk tugul, ak koweech Lot ne bo ornywa, ak tugukyik, ak kobogorisiek agichek, ak bik.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koberuri Melkisedek Abram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimong’ anyun laitoriatab Sodom kotorok inendet, ye kiweeksei kobunu baretab Kedolaomer ak laitorinik che kimitei koboto inendet, eng’ atebwetab Sabe (noto ko atebwetab laitoriat). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiibu Melkisedek laitoriatab Salem makatinik ak divaik: ki tisiindetab Kamuktaindet ne Toror Mising’. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiberur inendet, ak kole, Ingoberurok Abram eng’ Kamuktaindet ne Toror Mising’ ne chechik kipsengwetisiek ak ng’ony. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iberurot Kamuktaindet ne Toror Mising’, ne kiinde buniguk euneguk. Ak kiigochi Abram inendet kebeberta ne bo taman ne bo kiy tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji laitoriatab Sodom Abram, Kona bik, ak iib inye tuguk kobunjin. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji Abram laitoriatanb Sodom, Kaaiitochi eunnyu Jehovah, Kamuktaindet ne Toror Mising’, ne chechik kipsengwetisiek ak ng’ony, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
              "GEN.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ale maname agot inet anan tapsiniet, agot kiy age tugul neng’ung’, si memwa ile, Kaayai Abram koek magorio: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.23",
            "verseOrgIds": [
              "GEN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kobate choto che kigoam murenik, ak motwetab bik che kigibe tugul; Aner, ak Eskol, ak Mamre, ingoib ichek kebebertanywa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.24",
            "verseOrgIds": [
              "GEN.14.24"
            ]
          }
        }
      ]
    }
  ],
