          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kitar Arbaksat kenyisiek bogol ang’wan ak somok ye kingo kagosich Sela, ak kisich werik ak tibik.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
      ]
