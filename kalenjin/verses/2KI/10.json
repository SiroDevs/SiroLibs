          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitoi Jehovah eng’ betusiechoto kotil Israel kong’ering’itu: ak kibar Hasael ichek eng’ kiwotosiek tugul che bo Israel; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kong’eete Jordan komostab kong’asis, emet tugul ne bo Gilead, ne bo Gadik, ak ne bo Reubenik, ak ne bo Manasik, kong’eete Aroer ne mi ole bo atebwetab Arnon, choto ko Gilead ak Basan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        }
      ]
    },
