              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiiywei anyun bororiosiechuto Jehovah, ak kootei kanamonikwak che kigiwai; kiyai ko u noto lagokwak, ak lagokab lagokwak, ko u ye kiyai kwanisiekwak, koyaei ko u noto agoi ra.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
