              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyo Tiglat-peleser laitoriatab Asuria eng’ betusiekab Peka laitoriatab Israel, ak kinam Ijon, ak Abel-bet-maaka, koboto Janoa, ak Kedes, ak Hasor, ak Gilead, ak Galili, emet tugul ne bo Naptali; ak kiluul ichek komut koba Asuria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        }
