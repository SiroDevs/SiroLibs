          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak boisionik che ng’etunotin che bo Jotam, ak tuguk tugul che kiyai, ko tos ma sirotin eng’ bukuitab ateptab betusiek che bo laitorinikab Juda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitoi Jehovah eng’ betusiechoto koyokyi Juda Resin laitoriatab Suria ak Peka weritab Remalia, kobargei. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiru Jotam ak kwanisiekyik, ak kigitub koboto kwanisiekyik, eng’ nganasetab Daudi kwandanyi: ak kilaitoran Ahas werinnyi kogeer inendet.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
      ]
