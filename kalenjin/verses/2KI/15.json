          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitoi kolaitoran Peka weritab Remalia eng’ Israel eng’ Samaria, eng’ kenyitab konom ak aeng’ ne bo Asaria laitoriatab Juda, ak kilaitoran kenyisiek tiptem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyai yaitiet eng’ taitab Jehovah: ma istoegei tengekwogikab Jeroboam weritab Nebat, che kiibeete Israel si koyai tengekto.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        }
