  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2KI 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koyiemei bunik Jerusalem, ak kobarei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ kenyitab sogol ne bo laitornatennyi, eng’ arawetab taman, eng’ betutab taman ne bo arawanato, konyo Nebukadnesar laitoriatab Babulon, inendet ak lugennyi tugul, kobokyi Jerusalem, ak koteech kotokyigei nganaset; ak kiteech ichek irimoik koyiem. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyiem anyun nganaset agoi kenyitab taman ak agenge ne bo laitoriat Sedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "King’wanit rubet eng’ nganaset eng’ betutab sogol ne bo arawetab ang’wan, ne kima komi amitwogik che amei bik eng’ emet. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobut anyun bik irimetab nganaset, ak kimwei murenik tugul che bo luget kemoi kobun oretab ormarichet ne kimi kwenutab inatusiek aeng’, ye kimi ole negite seremutab laitoriat: (kiga yiem Kaldeik nganaset:) ak kibun laitoriat oretab Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kion lugetab Kaldeik laitoriat, ak kinam inendet eng’ warengosiekab Jeriko: ak kiiyesta lugennyi tugul kometo inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komut anyun laitoriat, ak komut kwo ole mi laitoriatab Babulon eng’ Ribla; ak kiiruokyi inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibar werikab Sedekia kogeerei inendet, ak kobar konyekab Sedekia, ak korat inendet eng’ sirimwek, ak komut kwo Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinyo Jerusalem Nebusaradan kiptaiyatab ribik, otwogindetab laitoriatab Babulon, eng’ arawetab mut, betutab tisab, ne ki kenyitab taman ak sogol ne bo laitoriat Nebukadnesar, laitoriatab Babulon: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kibeel gotab Jehovah, ak gotab laitoriat; ak gorik tugul che bo Jerusalem, got age tugul ne o, ko kibeel eng’ mat. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibut luget tugul ne bo Kaldeik ne kimi koboto kiptaiyatab ribik, irimosiekab Jerusalem komoswek tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiimut koluul Nebusaradan kiptaiyatab ribik, bik che kiga ng’et eng’ nganaset, ak che kiga chililso, che kiigochigei laitoriatab Babulon, ak bikab tuiyet che kiga ng’et. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kibagakta kiptaiyatab ribik, bik che kibananok mising’ eng’ emet, koek ribikab sabibuk ak koek semberik. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitui Kaldeik tolochikab sugunonik che kimi gotab Jehovah, ak ng’echerok che kitebe ak nyanjet ne bo sugunwet che kimi gotab Jehovah, ak koib sugunonikab tuguchoto koba Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiib terenik, ak kechigosiek che eechen, ak magasisiek che kitile ole lalei eng’ taisiek, ak kechigosiek, ak terenik tugul che bo sugunonik che kiboisie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak tuguk che kiibe mat, ak tabok; ak kiib kiptaiyatab ribik tuguk che kigiyae tahabu, ko tahabu, ak tuguk che kigiyae feda, ko feda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolochichoto aeng’, koboto nyanjanato agenge, ak ng’echerok che kitebe, che kiga yachi Solomon gotab Jehovah; ma kimuch kenai nyigisindab sugononikab tuguchuto tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koindab tononetab toloita agenge ko ki kakwautik taman ak sisiit che bo eut, ak kimi metitab sugunwet baragunnyi; ak koindab tononetab metoto ko ki kakwautik somok che bo eut; koboto karik che regerotin ak logoek che kimi metoto komoswek tugul, che ki bo tugul sugunonik: ak kitinyei toloita ne bo aeng’ tuguk che u choto, koboto karik che regerotin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiimut kiptaiyatab ribik Seraia tisiindet ne o ak Sepania tisiindet ne bo aeng’ ak ribik somok che kiribei kurget: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiimut eng’ nganaset kiptaiyat ne kibou murenikab luget; ak bik mut eng’ ichek che kigeerei togetab laitoriat, che kimi nganaset; ak sirindet, kiptaiyatab luget, ne kiiyumi bikab emet; ak bik tamanwogik lo che bo emet, che kiginyorji nganaset. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiimut Nebusaradan kiptaiyatab ribik bichoto, komutyi laitoriatab Babulon eng’ Ribla. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kibir laitoriatab Babulon bichoto ak kobar eng’ Ribla eng’ emetab Hamat. Kigimut anyun Juda keluul komanda eng’ emennyi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyai Nebukadnesar Kedalia weritab Aikam weritab Sapan koek bounindetab bik che kiga ng’et eng’ emetab Juda, che kiga bagakta Nebukadnesar laitoriatab Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogas kiptainik tugul che bo lugosiek, icheget ak bikwak, kole kogoyai laitoriatab Babulon Gedalia koek bounindet, kobwa ole mi Gedalia eng’ Mispa, choto ko ki Ismael weritab Netania, ak Johanan weritab Karea, ak Seraia weritab Tanumet Netopatindet, ak Jaasania weritab Maakatindet, icheget ak bikwak. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyosiechi ichek Gedalia ak koyosiechi bikwak, kolenji, Amoiywei amu otwogikab Kaldeik: omeny emet ak oot laitoriatatab Babulon, si komieit eng’ okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kinyo eng’ arawetab tisap Ismael weritab Netania, weritab Elisama, ne bo keswekab gab laitoriat, ak kibwa ak bik taman, ak kobar Kedalia kome. Koboto Yahudik ak Kaldeik che kimi koboto inendet eng’ Mispa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’eetyo bik tugul che mengech ak che eechen, ak kiptainikab luget, ak kobwa Misri: amu kiiywei Kaldeik.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ kenyitab sosom ak tisab ne bo luuletab Jeoiakin laitoriatab Juda, eng’ arawetab taman ak aeng’, eng’ betutab tiptem ak tisab ne bo arawanato, kotiach Ebil-merodak laitoriatab Babulon, eng’ kenyit ne kitau kolaitorane, Jeoiakin laitoriatab Juda komong’ eng’ korgoret; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak king’alalji inendet eng’ rirenetab ge, ak konde ng’echerennyi ne bo laitornatet kotororit eng’ che bo laitorinik che kimi Babulon koboto inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
