              "type": "text"
            }
          ]
        },
        {
          "text": "Kirib eng’ Damasko bounindetab laitoriat Areta, nganasetab Damaskik, kole konama: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
