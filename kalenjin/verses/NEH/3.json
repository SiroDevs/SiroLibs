        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteech kogeny kitang’ikab tahabu ak chemung’arainik kwenutab ole kitogostoe eng’ luita ak ormarichetab kechirek.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
        }
