              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos kigasak it anyun keyai yaitioni o tugul, kingelelji Kamuktaindennyo kitun tibikab bororiosiek alak?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
