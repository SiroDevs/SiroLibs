          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibwat ichek, ee Kamuktaindennyu, amu kigong’wanit tiseinatet, ak kayomisutietab tiseinatet, ak ne bo Lawik.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
