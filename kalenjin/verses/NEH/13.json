              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ki sandetab Sanbalat Horonindet, age eng’ werikab Joiada, weritab Eliasib tisiindet ne o: kiaon anyun inendet kwo eng’ ole ami. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
