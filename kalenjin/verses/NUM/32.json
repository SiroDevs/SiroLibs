            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiba lagokab Makir weritab Manase Gilead, ak kinam korebe Amorik che kimi oloto. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigochi Musa Makir weritab Manase, Gilead; ak kimeny oloto. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwa Jair weritab Manase konam nganasokwak, ak koguure Habot-jair. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwa Noba konam Kenat, ak nganasokyik che mengechen, ak kiguure Noba, koguurtoe kainennyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
