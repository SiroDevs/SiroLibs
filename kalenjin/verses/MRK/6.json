  "copyright": "PUBLIC DOMAIN",
  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MRK 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keesioi Jesu eng’ Nasaret",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimong’ eng’ oloto; ak konyo agoi emennyi; ak kiisub inendet alamalyennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.1",
            "verseOrgIds": [
              "MRK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingoit sabato, kotoi konetis eng’ sunagogit: ak kingogas che chang’ kokwong’io, kolen, Nyorune ano chichi tuguchu? Ak, Nee ng’omnatoni kigigochi chichi, ak, Nee boisionichu kimen yaoksei eng’ eunekyik? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.2",
            "verseOrgIds": [
              "MRK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos ma musogindet nito, weritab Maria, ne tupcho ak Jakobo, Joses, Juda, ak Simon? Ak tos mami kobotech eng’ olinyo chepkametisiekyik? Ak kinyor kanagutiet eng’ inendet.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.3",
            "verseOrgIds": [
              "MRK.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.3",
            "verseOrgIds": [
              "MRK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu ichek, Mabetyin maotio teegisto, kobate eng’ emennyi, ak eng’ che bo orennyi, ak eng’ gonnyi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.4",
            "verseOrgIds": [
              "MRK.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.4",
            "verseOrgIds": [
              "MRK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimata komuch koyai boisiet age tugul ne kimi eng’ oloto, kobate bik che ng’ering’ che kimiandos che kigonoor eunekyik, ak kiisoob ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.5",
            "verseOrgIds": [
              "MRK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kikwong’ inendet amu bistoenywa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.6",
            "verseOrgIds": [
              "MRK.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boisiet ne kigiyoktae alamlyet taman ak aeng’",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.6",
            "verseOrgIds": [
              "MRK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiguurjigei anyun taman ak aeng’, ak kotoi koyokto kobee aeng’ aeng’; ak kiigochi kimnatet koterter tamirmirik che muruonen; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.7",
            "verseOrgIds": [
              "MRK.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak king’at ichek kole, amat koib kiy ne bo bandanywa, agot makatiat, anan suberet, anan senteisiek eng’ lolet; kobate kirokto kityo; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.8",
            "verseOrgIds": [
              "MRK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago oba olaachi kweonik; ak amat olaach sumotik aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.9",
            "verseOrgIds": [
              "MRK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Got age tugul ne obendi, otebi eng’ yoto agoi obe eng’ oloto. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.10",
            "verseOrgIds": [
              "MRK.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak oldo age tugul ne mataachak, ama cham kogasak, ye omande eng’ oloto, olelekte temburiek che mi kelyekwok si kobiit koek baornatet eng’ ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.11",
            "verseOrgIds": [
              "MRK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimanda anyun, koba koamdaat kole kanyol kosik bik. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.12",
            "verseOrgIds": [
              "MRK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kion oik che chang’, ak koile mwaita che chang’ che kimiandos, ak kosoob ichek.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.13",
            "verseOrgIds": [
              "MRK.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meetab Johana Kabatisanindet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.13",
            "verseOrgIds": [
              "MRK.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigas laitoriat Herod agobo noto; amu kiga konaak kainennyi; ak kole, Kagong’eet Johana Kabatisanindet eng’ che kibek, noto anyun boisiei kimnatosiechu eng’ orinnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.14",
            "verseOrgIds": [
              "MRK.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kimwaei alak kole, Elija inendet. Ak kile alak, Maotio inendet, anan u age eng’ maotik.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.15",
            "verseOrgIds": [
              "MRK.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.15",
            "verseOrgIds": [
              "MRK.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kingogas Herod, kole, Johana nito, ne kiatile metit; kagong’eet.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.16",
            "verseOrgIds": [
              "MRK.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.16",
            "verseOrgIds": [
              "MRK.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kiga koyokto Herod inendet bik, koba konam Johana, ak korat eng’ korgoret, amu Herodia osotiotab Pilipu ng’etab kamet: amu kiga kobaigei inendet ak kwonyoto. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.17",
            "verseOrgIds": [
              "MRK.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kimwachi Johana Herod, kolenji, Etei ng’atutik otebi ak osotiotab ng’etab komet.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.18",
            "verseOrgIds": [
              "MRK.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.18",
            "verseOrgIds": [
              "MRK.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiwech Herodia inendet, ak kimach kobar; ago ma imuch; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.19",
            "verseOrgIds": [
              "MRK.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kiiywei Herod Johana, amu kiingen kole, inendet ko chi ne bo imanda, ak ko tilil, ak kirib. Ak ye kingogas Herod ng’alekyik, koiimgei mising’: ago kigasyi inendet eng’ boiboiyet.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.20",
            "verseOrgIds": [
              "MRK.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.20",
            "verseOrgIds": [
              "MRK.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingoit betut ne nyolu, koyai Herod igorta ne bo betutab sigennyi, koyachi bikyik che eechen, kiptainik, ak che toogunotin che bo Galili. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.21",
            "verseOrgIds": [
              "MRK.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingonyo go cheptab Herodia ak koureren, kobaibai Herod ak ichek che kitebyei eng’ amisiet koboto inendet; kolenji anyun laitoriat cheboto, Soma kiy age tugul ne imache si agonin. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.22",
            "verseOrgIds": [
              "MRK.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyosiechi kole, Kiy age tugul ne isoma agonin, agot kebebertab bounatennyu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.23",
            "verseOrgIds": [
              "MRK.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.23",
            "verseOrgIds": [
              "MRK.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimanda, ak kolenji kamet, Asom nee? Ak kilenji, Metit ne bo Johana Kabatisanindet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.24",
            "verseOrgIds": [
              "MRK.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak yeityo konyo kochok agoi ole mi laitoriat, ak kosom kole, Amache ale igona nguno metit ne bo Johana Kabatisanindet eng’ tageito.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.25",
            "verseOrgIds": [
              "MRK.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.25",
            "verseOrgIds": [
              "MRK.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiarogen anyun mising’ laitoriat; ago amu kayosiautikyik, ak amu icheget che kitebyei eng’ amisiet, ko mata koete inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.26",
            "verseOrgIds": [
              "MRK.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ngunoto koyokto laitoriat askarindet age eng’ che kiripsei, ak kong’at keib konyo metitab Johana: kiwa anyun kotil metit eng’ korgoret, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.27",
            "verseOrgIds": [
              "MRK.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiib metoto bo Johana eng’ tageito, ak kogochi cheboto; ak kogochi cheboto kamet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.28",
            "verseOrgIds": [
              "MRK.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingogas alamalyennyi agobo ng’olyondonoto, kobwa kosut mustanyi, ak konde kererit.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.29",
            "verseOrgIds": [
              "MRK.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koweeksei alamalyet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.29",
            "verseOrgIds": [
              "MRK.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyumjigei Jesu che kiyoktoi; ak komwachi inendet tuguk tugul, kit age tugul ne kiga koyai, ak kit age tugul ne kiga konet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.30",
            "verseOrgIds": [
              "MRK.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi ichek kolenji, Obwa okwege taban ole surkwen, si omuuny kitigin. Amu ki chang’ che kibwanei ak kobendi, ak kima kotinyei agot boroindo ne amisie. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.31",
            "verseOrgIds": [
              "MRK.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiba ichegei eng’ moingetab beek kolang’ji surkwen.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.32",
            "verseOrgIds": [
              "MRK.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.32",
            "verseOrgIds": [
              "MRK.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigeeroti bik kobendi, ak kinai che chang’, ak kiruai koba oloto kibagenge kobunu nganasok tugul, ak kondoe icheget. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.33",
            "verseOrgIds": [
              "MRK.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingolang’ Jesu kogeer tuiyet ne o, ak koriregei ichek, amu ki u kechirek che matinyei mestowo: ak kitoi konet ichek tuguk che chang’.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.34",
            "verseOrgIds": [
              "MRK.6.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobaei Jesu bik elfusiek mut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.34",
            "verseOrgIds": [
              "MRK.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kimachei koimen, kobwanji inendet alamalyennyi, ak kole, Surkwen oli, ak machei koimen nguno: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.35",
            "verseOrgIds": [
              "MRK.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "unde bik koba emet ak nganasok che mi komoswek ole negit, si koaljigei tuguk che amei. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.36",
            "verseOrgIds": [
              "MRK.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwolji kolenji, Ogochi okwek amitwogik. Ak kilenji, Kibe keal makatinik che bo denarisiek bogol aeng’, si kigochi koam? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.37",
            "verseOrgIds": [
              "MRK.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji ichek, Otinye makatinik ata? Oba ogeer. Ak kingo kagonai, kole, Mut, ak njirenik aeng’.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.38",
            "verseOrgIds": [
              "MRK.6.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.38",
            "verseOrgIds": [
              "MRK.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’at kole kobuur bik eng’ suswek che nyalilen, korurugotgei. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.39",
            "verseOrgIds": [
              "MRK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteb ng’ony kotetatgei, kobee bogol ak kobee konom. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.40",
            "verseOrgIds": [
              "MRK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kinam makatinichoto mut ak njirenik aeng’, ak konyal kipsengwet, koberur, ak kotonaton makatinik; ak kiigochi alamalyennyi si konde tainywa; ak kipchechi icheget tugul njirenichoto aeng’. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.41",
            "verseOrgIds": [
              "MRK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiamis tugul, kobiyong’so. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.42",
            "verseOrgIds": [
              "MRK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak koyum katuganik, konyi kerebonik taman ak aeng’, ak che bo njirenik agichek. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.43",
            "verseOrgIds": [
              "MRK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak icheget che kiam makatinichoto ko ki murenik elfusiek mut.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.44",
            "verseOrgIds": [
              "MRK.6.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kowendote Jesu araraita barak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.44",
            "verseOrgIds": [
              "MRK.6.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo kochiich alamalyennyi kolany moingetab beek, kondoe inendet koba bitonin agoi Betsaida, ak kiigochi inendet tuiyet koba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.45",
            "verseOrgIds": [
              "MRK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagobagakta ichek, kwo tulwet kosa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.46",
            "verseOrgIds": [
              "MRK.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimi moinget kwenutab araraita koskoleny, ak kimi inegei emet ne yaamat. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.47",
            "verseOrgIds": [
              "MRK.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MRK 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogeer icheget konyalildos eng’ boisietab mugangok che kikwerie moinget, amu kigirindoi usonet icheget, konyo ole mi icheget eng’ ripset ne bo ang’wan ne bo kemoi, kowendote araraita barak: ak kimachei kosiirtoe icheget: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.48",
            "verseOrgIds": [
              "MRK.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MRK 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago kingogeer ichek inendet kowendoti eng’ araraita barak, kolen icheget abere tamirmiriet, ak kiwaach: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.49",
            "verseOrgIds": [
              "MRK.6.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MRK 6:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kigeer ichek tugul inendet, ak kiiyweis. Ak ngunoto anyun kotwekyi ichek, kolenji, Onyiganitu: a inendet; amoiyweisie. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.50",
            "verseOrgIds": [
              "MRK.6.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MRK 6:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilany moinget kwo ole mi ichek; ak kisis usonet: ak kikwong’io mising’ bichoto; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.51",
            "verseOrgIds": [
              "MRK.6.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MRK 6:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kima nai ichek agobo makatinik, amu ki uuen mugulelwekwak.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.52",
            "verseOrgIds": [
              "MRK.6.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kisoobi bik eng’ Genesaret",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MRK 6:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.52",
            "verseOrgIds": [
              "MRK.6.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
