          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagolanda, koit emetab Genesaret, korat moinget eng’ ngegut. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.53",
            "verseOrgIds": [
              "MRK.6.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MRK 6:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingomong’ eng’ moinget, konai bik inendet eng’ sainato, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.54",
            "verseOrgIds": [
              "MRK.6.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
