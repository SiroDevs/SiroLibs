          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak koruaat eng’ koronoto komugul, ak kotoi komut che miandos eng’ itogusiekwak, koba ole kiga kasyi inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.55",
            "verseOrgIds": [
              "MRK.6.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
