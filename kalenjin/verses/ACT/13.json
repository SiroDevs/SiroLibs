{
  "id": "ACT.13",
  "number": "13",
  "bookId": "ACT",
  "reference": "Boisionikab Che Kiyoktoi 13",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
