  "bookId": "JHN",
  "reference": "Johana 11",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JHN 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "King’eeti Lasaro eng’ che kibek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimian chito age ne kiguure Lasaro, ne bo Betania, ne bo nganasetab Maria ak chepkamet Marta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.1",
            "verseOrgIds": [
              "JHN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ki Maria nito ne kiil Kiptaiyat eng’ mwaita, ak kouuse kelyekyik sumeekyik, ne kitinyei ng’etab kamet, Lasaro, ne kimian. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.2",
            "verseOrgIds": [
              "JHN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiiyokyi chepkametwogichato inendet ng’olyot, kolenji, Kiptaiyandani, keero, miani inendet ne ichame.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.3",
            "verseOrgIds": [
              "JHN.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.3",
            "verseOrgIds": [
              "JHN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kingogas Jesu noto, kole, Ma bo meet mianoto, ago bo torornatetab Jehovah, ak kilosune Weritab Jehovah noto.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.4",
            "verseOrgIds": [
              "JHN.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.4",
            "verseOrgIds": [
              "JHN.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kichamei Jesu Marta, ak chepkamet, ak Lasaro. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.5",
            "verseOrgIds": [
              "JHN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingogas anyun kole miani, kota kotebi betusiek aeng’ eng’ ole kimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.6",
            "verseOrgIds": [
              "JHN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingobatga nito anyun, kolenji alamalyet, Ongebe Judea kogeny. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.7",
            "verseOrgIds": [
              "JHN.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji alamalyet, Rabbi, kocheng’ei Yahudik kolachin eng’ koik; ak iwendi olindo kogeny? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.8",
            "verseOrgIds": [
              "JHN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowol Jesu kole, Tos mami saisiek tamanu ak aeng’ eng’ betut? Ngo wendot chi bet, ko maginachi, amu keerei lapkeiyetab ng’onyuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.9",
            "verseOrgIds": [
              "JHN.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngo wendot chi kemoi, kinachi, amu mami lapkeiyet eng’ inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.10",
            "verseOrgIds": [
              "JHN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komwa tuguchu: ak ye ibata kolenji ichek, Inuuchi choruennyu Lasaro; ago awendi, si ang’eet inendet eng’ ruondo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.11",
            "verseOrgIds": [
              "JHN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun alamalyet inendet, Kiptaiyandani, ngot konuuchi, ko kaga ta kosobei. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.12",
            "verseOrgIds": [
              "JHN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kimwaei Jesu agobo meennyi: ak kilen ichek abere mwaei agobo ruondo ne kiga konuuch. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.13",
            "verseOrgIds": [
              "JHN.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwachi anyun Jesu ichek komie, kolenji, Kogome Lasaro. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.14",
            "verseOrgIds": [
              "JHN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago abaibai agobo okwek amu kima ami olindo, si kobiit oyan; ago ongebe ole mi inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.15",
            "verseOrgIds": [
              "JHN.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun Tomas, ne kiguure Didumo, alamalyet chun alak, Ongebe ak achek, si kobiit kebegu ak inendet.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.16",
            "verseOrgIds": [
              "JHN.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.16",
            "verseOrgIds": [
              "JHN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kingoit Jesu anyun, konyor kole kiga kotebe kererit betusiek ang’wan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.17",
            "verseOrgIds": [
              "JHN.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki negite Betania Jerusalem, ki bo olo bo maelisiek aeng’; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.18",
            "verseOrgIds": [
              "JHN.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kigabwanji che chang’ che bo Yahudik Marta ak Maria si kogaigai ichek agobo ng’etab kamet.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.19",
            "verseOrgIds": [
              "JHN.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.19",
            "verseOrgIds": [
              "JHN.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingogas anyun Marta kole, nyonei Jesu, kwo kotorokta inendet; ago kita kotebi Maria eng’ go. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.20",
            "verseOrgIds": [
              "JHN.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji Marta anyun Jesu, Kiptaiyandani, nda kiimi yu, ta kima komeei werit ne kitupche. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.21",
            "verseOrgIds": [
              "JHN.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago angen agot nguno ale, kit age tugul ne isome Jehovah, kogonin Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.22",
            "verseOrgIds": [
              "JHN.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji Jesu inendet, Ta kong’eetei ng’etab komet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.23",
            "verseOrgIds": [
              "JHN.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji Marta inendet, Angen ale ng’eetei eng’ ng’eetyet ne bo betutab let. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.24",
            "verseOrgIds": [
              "JHN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji Jesu, A ng’eetyet, ak sobondo: inendet ne iyana, agot ngo me, ko ta kosobei: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.25",
            "verseOrgIds": [
              "JHN.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak chi age tugul ne sobei ak koyanan ko mameei matiny. Tos iyani inye nito? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.26",
            "verseOrgIds": [
              "JHN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji, We, Kiptaiyandani; kaayan ale i Kristo, Weritab Jehovah, ne nyonei ng’ony.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.27",
            "verseOrgIds": [
              "JHN.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.27",
            "verseOrgIds": [
              "JHN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagomwa nito cheboto, kwo, ak koguur Maria, chepkamet, eng’ ung’ot, kole, Mitei yu Konetindet; kuurin. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.28",
            "verseOrgIds": [
              "JHN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingogas noto, kong’eet kochakta kwo ole mi inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.29",
            "verseOrgIds": [
              "JHN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ago kitomo koit Jesu nganasanato, ago kita komi ole kiga tuiyechi ak Marta.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.30",
            "verseOrgIds": [
              "JHN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisub anyun Yahudik cheboto, icheget che kimi koboto inendet eng’ go kogoigoi, ye kingogeer kong’eet Maria, ak kochakta komanda sang’, kolen wendi kererit korirei eng’ oloto.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.31",
            "verseOrgIds": [
              "JHN.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.31",
            "verseOrgIds": [
              "JHN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kingoit anyun Maria ole mi Jesu, ak kogeer inendet, kobutyi kelyekyik, ak kolenji, Kiptaiyandani, nda kiimi yu, ta kima komeei werit ne kitupche. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.32",
            "verseOrgIds": [
              "JHN.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kingogeer Jesu anyun inendet korirei, ak korirtos agichek Yahudik che kigabwa koboto inendet, kogas king’wan eng’ tamirmiriet, koarogen, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.33",
            "verseOrgIds": [
              "JHN.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kole, Kionde ano? Kolenji, Nyo, Kiptaiyandani, keer. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.34",
            "verseOrgIds": [
              "JHN.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korir Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.35",
            "verseOrgIds": [
              "JHN.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole anyun Yahudik, Ogeer anyun-o ole kichamdoi inendet! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.36",
            "verseOrgIds": [
              "JHN.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kile alak eng’ ichek, Kiga temene chichi, ne kiyatei konyekab chito ne ki korat, koger si mame agine chichi?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.37",
            "verseOrgIds": [
              "JHN.11.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.37",
            "verseOrgIds": [
              "JHN.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kogas anyun Jesu king’wan kogeny eng’ orinnyi konyonei kererit. Ki kebenet, ak kigegere koita kurget. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.38",
            "verseOrgIds": [
              "JHN.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Jesu, Oiste koita. Kolenji Marta, chepkametab inendet ne kime, Kiptaiyandani, kogobul: amu koboch ngome ko betusiek ang’wan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.39",
            "verseOrgIds": [
              "JHN.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji Jesu inendet, Kama amwaun, ale, ngiyani, igeere torornatetab Jehovah? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.40",
            "verseOrgIds": [
              "JHN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koisto anyun koita. Ak kiyot met Jesu ak kole, Baba, amwaun kongoi ale kaigasa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.41",
            "verseOrgIds": [
              "JHN.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kaanai ale igasa eng’ ui tugul: ago kaamwa ni amu tuiyoni tononi eng’ yuto, si kobiit koyan kole kiiyokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.42",
            "verseOrgIds": [
              "JHN.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kingo kagomwa ko u noto, komwa eng’ kutit ne o, kole, Lasaro, mong’u. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.43",
            "verseOrgIds": [
              "JHN.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komong’ anyun inendet ne kiga me, ko ratotin eunek ak kelyek eng’ ngoroik che bo kererit; ak kiga kirate togennyi anget. Kolenji Jesu bichoto, Otiach, ak ounde kwo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.44",
            "verseOrgIds": [
              "JHN.11.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.44",
            "verseOrgIds": [
              "JHN.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiiyan anyun inendet che chang’ che bo Yahudik che kigabwa ole mi Maria, ak kogeer tuguk che kayai Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.45",
            "verseOrgIds": [
              "JHN.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiba alak ole mi Parisaik, ak komwachi ichek tuguk che kagoyai Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.46",
            "verseOrgIds": [
              "JHN.11.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kochobei tisiik che eechen kobar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.46",
            "verseOrgIds": [
              "JHN.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiguur anyun kiruoget tisiik che eechen ak Parisaik, ak kole, Kiyai nee? Amu yaei chichi kaborunoik che chang’. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.47",
            "verseOrgIds": [
              "JHN.11.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 11:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngot kebagakte inendet ko u ni, koyani inendet bik tugul: asi kobwa Romanik korebenech emennyo ak bororiennyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.48",
            "verseOrgIds": [
              "JHN.11.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 11:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji age eng’ ichek, ne inendet ko Kaiapa ne ki tisiindet ne o kenyinoto, Mongen okwek kiy age tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.49",
            "verseOrgIds": [
              "JHN.11.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 11:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "mongen ole mieitu eng’ okwek ngo mechi bik chito agenge, si ma bet bororiet komugul. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.50",
            "verseOrgIds": [
              "JHN.11.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 11:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kima komwaei inegei noto: ago kimaoten amu ki tisiindet ne o kenyinoto, kole, komechi Jesu bororiet; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.51",
            "verseOrgIds": [
              "JHN.11.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 11:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma agobo bororiet inegei, ago si kobiit koyum lagokab Jehovah che yestootin si kobiit koek agenge.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.52",
            "verseOrgIds": [
              "JHN.11.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 11:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.52",
            "verseOrgIds": [
              "JHN.11.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 11:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboch betunoto anyun ak kwo tai, koruogot agobo ole bartoi inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.53",
            "verseOrgIds": [
              "JHN.11.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 11:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mata kowendot Jesu anyun eng’ ole toogu eng’ ole mi Yahudik, ago kiwa eng’ oloto kwo emet ne negite surkwen, agoi nganaset ne kiguure Epraim; ak kitebi eng’ oloto koboto alamalyet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.54",
            "verseOrgIds": [
              "JHN.11.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 11:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiga korik paska ne bo Yahudik: ak kiba che chang’ eng’ emet kotogosta Jerusalem kotom koit paska, koba koanyinygei. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.55",
            "verseOrgIds": [
              "JHN.11.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 11:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicheng’ anyun Jesu, ak kolenjigei, kotonondos eng’ hekalut, Obwati nee okwek? Tos olen manyonei inendet igorta? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.56",
            "verseOrgIds": [
              "JHN.11.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 11:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiga ng’at tisiik che eechen ak Parisaik, kole, ngo nai chi age tugul ole mitei, kobor, si kobiit konam ichek inendet.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.57",
            "verseOrgIds": [
              "JHN.11.57"
            ]
          }
        }
      ]
    }
  ],
