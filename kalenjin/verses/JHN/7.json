{
  "id": "JHN.7",
  "number": "7",
  "bookId": "JHN",
  "reference": "Johana 7",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JHN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu koboto tupchosiekyik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingobata tuguchu kowendot Jesu eng’ Galili: amu ma cham kowendot eng’ Judea, amu kicheng’ei Yahudik kobar inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.1",
            "verseOrgIds": [
              "JHN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiga rik igortab Yahudik, igorta ne bo keriosiek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.2",
            "verseOrgIds": [
              "JHN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenji anyun tupchosiekyik, Ui eng’ oli, ui agoi Judea, si kogeer alamalyeng’ung’ agichek boisioniguk che iyae. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.3",
            "verseOrgIds": [
              "JHN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu mami chi ne yaei kiy eng’ ung’ot, ak kocheng’ kobartagei. Ngiyai tuguchu, iborjige ng’ony. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.4",
            "verseOrgIds": [
              "JHN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu agot tupchosiekyik agichek, ko ma iyan inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.5",
            "verseOrgIds": [
              "JHN.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun Jesu ichek, Tom koit betunnyu; ago mi betung’wong’ kotugul. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maimuchi ng’ony kowechok; ago wecha ane, amu abaoriani agobo ng’ony, ale, yaach boisionikyik. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.7",
            "verseOrgIds": [
              "JHN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otogosyi okwek igorta: tom atogosyini ane igorita; amu tom kosulda betunnyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.8",
            "verseOrgIds": [
              "JHN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingo kagomwachi tuguchuto, kota kotebi eng’ Galili.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kingotogosta tupchosiekyik igorta, kotogosta agine, ago ma ibartaatgei, ago kiwa ko u ne ung’otegei. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.10",
            "verseOrgIds": [
              "JHN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicheng’ anyun Yahudik inendet eng’ igorta, ak kole, Mi ano inendet?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi kang’unyng’unyet ne o eng’ tuiyosiek agobo inendet: amu kile alak, Mie chichi; kole alak, Achicha, ago imaasi tuiyet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ma mwa chi ng’olyo kotook agobo inendet amu kiiywei Yahudik.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Konetisiei Jesu eng’ Jerusalem kole bunu inendet Jehovah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye kingo kagoit kwenutab igorta kotogosta Jesu kwo hekalut, ak konetis. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.14",
            "verseOrgIds": [
              "JHN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokwong’io anyun Yahudik kole, Kinaita ano chichi sirutik, ago tom konetgei? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.15",
            "verseOrgIds": [
              "JHN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji anyun Jesu kolenji, Konetisiennyu ko ma nenyu, ago bo inendet ne kiiyokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo machei chi age tugul koyai magetab Jehovah, konai konetisioni, ngo bo Jehovah, anan ngamwae anege. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.17",
            "verseOrgIds": [
              "JHN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inendet ne mwaei che chechik inegei kocheng’ei torornatennyi: ago ne cheng’ei torornatetab ne kiiyok inendet ko bo iman, ama mi kiy ne ma bo imanda eng’ inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.18",
            "verseOrgIds": [
              "JHN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos kima konok Musa Ng’atutiet, ago mami chi eng’ okwek ne yaei Ng’atutiet? Amu nee si ocheng’e obara? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.19",
            "verseOrgIds": [
              "JHN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowol tuiyet, kole, Itinye oindet: cheng’ei ng’o kobarin?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.20",
            "verseOrgIds": [
              "JHN.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.20",
            "verseOrgIds": [
              "JHN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji Jesu kolenji, Kiayai boisiet agenge, ak okwong’ie okwek tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigonok Musa kamuratanet amu noto (ago ma bo Musa, bo kwanisiek); ak omuratani chi eng’ saboto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.22",
            "verseOrgIds": [
              "JHN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeyatitoi chi eng’ betutab sabato, si mabutok Ng’atutietab Musa, ko tos onerekyina, amu kaasoob chi komie eng’ betutab sabato? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.23",
            "verseOrgIds": [
              "JHN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoruoch ko u ye ogeere, ago oruoch kiruoget ne bo imanda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.24",
            "verseOrgIds": [
              "JHN.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.24",
            "verseOrgIds": [
              "JHN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwa alak eng’ choto bo Jerusalem kole, Ma inendet ni ne kocheng’ei ichek kobar? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.25",
            "verseOrgIds": [
              "JHN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ogeero, mwaitooti kotook, ama mwachi kiy ichek inendet. Tos ingen bounik komie kole, nito ko Kristo? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.26",
            "verseOrgIds": [
              "JHN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kingen ole bunu chichi: ago ye nyo Kristo, ko manaei chi ole bunu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.27",
            "verseOrgIds": [
              "JHN.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.27",
            "verseOrgIds": [
              "JHN.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "King’alal anyun Jesu eng’ kutit ne o eng’ hekalut, konetisiei, kole, Ongena, ak ongen ole abunu; ak kama anyo anege, ago bo iman inendet ne kiiyokwa, ne mongen okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angen inendet; amu abunu inendet, ak kiiyokwa inendet.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.29",
            "verseOrgIds": [
              "JHN.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.29",
            "verseOrgIds": [
              "JHN.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicheng’ anyun bichoto konam inendet: ama nam chi inendet, amu kitom koit betunnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.30",
            "verseOrgIds": [
              "JHN.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiyan inendet che chang’ che bo tuiyet; ak kile, Ye nyo Kristo, ko tos yai kaborunoik che siirei cho koyaei chichi?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.31",
            "verseOrgIds": [
              "JHN.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.31",
            "verseOrgIds": [
              "JHN.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigasei Parisaik kong’unyng’ung’jin tuiyet tuguchuto agobo inendet; ak kiiyok tisiik che eechen ak Parisaik kiptainik kobwa konam inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.32",
            "verseOrgIds": [
              "JHN.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole Jesu anyun, Ta ami kobotok ne matia, si awa ole mi inendet ne kiiyokwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tun ocheng’a, amonyorua: ak ole ami, ko momuchi obwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.34",
            "verseOrgIds": [
              "JHN.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komwachigei anyun Yahudik kole, Wendi ano chichi si ma kinyoru inendet? Tos wendi ole mi icheget che kigoiyestochi Yunanik, si konet Yunanik? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.35",
            "verseOrgIds": [
              "JHN.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee anyun ng’olyondoni kamwa, kole, Ocheng’a, amonyorua: ak ole ami, ko momuchi obwa?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Beek che soptos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ betut ne bo let, betunoto o bo igorta, kotonon Jesu ak komwa eng’ kutit ne o, kole, Ngo amei chi melel, ko ingonyonja, ak koee. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inendet ne iyana, ko u ye kigomwa sirutiet, kole, bunu moennyi ainosiekab beek che sobei. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.38",
            "verseOrgIds": [
              "JHN.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kimwaei nito agobo Tamirmiriet, ne tun taachei ichek che iyani inendet: amu kitom kegon Tamirmiriet; amu kitom kitoror Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.39",
            "verseOrgIds": [
              "JHN.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.39",
            "verseOrgIds": [
              "JHN.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kingogas alak che bo tuiyet ng’alechuto, kole, Nito maotiot iman. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.40",
            "verseOrgIds": [
              "JHN.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kole alak, Nito ko Kristo. Ago kile alage, Tos bunu Kristo Galili? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mwa sirutiet, kole, mong’une Kristo keswek che bo Daudi, ak kobun Betlehem, nganaset ole kimi Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.42",
            "verseOrgIds": [
              "JHN.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibiit anyun toiyet eng’ tuiyet agobo inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.43",
            "verseOrgIds": [
              "JHN.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimach alak konam inendet; ago ma nam chi inendet.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.44",
            "verseOrgIds": [
              "JHN.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.44",
            "verseOrgIds": [
              "JHN.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibwa anyun kiptainik ole mi tisiik che eechen ak Parisaik; ak kolenji, Kalya si momutu inendet? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.45",
            "verseOrgIds": [
              "JHN.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowol kiptainik kole, Kitom kong’alali chi ko u ni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.46",
            "verseOrgIds": [
              "JHN.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji anyun Parisaik ichek, kolenji, Kagibeetok ak okwek? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.47",
            "verseOrgIds": [
              "JHN.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigoyan inendet age tugul eng’ bounik, anan eng’ Parisaik? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.48",
            "verseOrgIds": [
              "JHN.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago chubotin bichu che manaei Ng’atutiet.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.49",
            "verseOrgIds": [
              "JHN.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.49",
            "verseOrgIds": [
              "JHN.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilenji Nikodemo (ne kigawa ole mi inendet atkinye tai, ne ki age eng’ ichek), ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.50",
            "verseOrgIds": [
              "JHN.7.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos iruokyin chi Ng’atutiennyo, kotom kegas ng’alekyik ak kenai kit ne yaei? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.51",
            "verseOrgIds": [
              "JHN.7.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 7:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowolji anyun inendet kolenji, I bo Galili aginye? Cheng’, ak igeer amu mamong’une Galili maotiondo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.52",
            "verseOrgIds": [
              "JHN.7.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 7:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "[ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.52",
            "verseOrgIds": [
              "JHN.7.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 7:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwa chi ktugul anyun gonnyi:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.53",
            "verseOrgIds": [
              "JHN.7.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobogoriot ne kiginamji ibetab",
          "type": "text"
        }
      ]
    }
  ],
