          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maoten inye weritab chi, ile, Mwaei Kiptaiyat Jehovah agobo lagokab Amon, ak agobo tewernatenywa, ko u ni kole; mwa ile, Rotwetab chok, kaging’us rotwetab chok, kagesit agobo barisiet, si kobiit kobaris, si koigei kalyelet: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kota kogeerjinin tangoita, kota kong’orei lembechek agobo inye, si kondein kaatwekab kiptengeginik che kigiguoten ne bo meet, che kagonyo betunywa, eng’ betusiekab yaitiet ne bo let.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        }
