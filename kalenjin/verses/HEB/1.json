            "number": "1",
            "style": "v",
            "sid": "HEB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovah, ne king’alalji kwanisiekyok keny eng’ maotik, eng’ kebeberwek che chang’ ak eng’ ortinwek che chang’, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko ne kagong’alalwech eng’ betusiechu bo let, eng’ Werit, ne kigonde koek ne namei tuguk tugul, ak kiyai inendet ng’ony agine eng’ inendet; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inendet ko kakweng’etab lilindanyi, ak itondo ne bo indennyi, ak kotononi tuguk tugul eng’ ng’olyotab kamuktaennyi, kingo kagoyai kaundoetab tengekwogik, kwo kotebe eutab tai ne bo Etunatet eng’ barak;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko kagoek ne kararan kosiir malaikaisiek, ko u ye konyitot kainet ne kigonam inendet, kosiir kainenywa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "O Weritab Jehovah kosiir malaikaisiek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
