          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tos choto tugul ko ma tamirmirik che boisiei, che kiyoktoi kobois agobo ichek che tun nyoru yetunet?",
          "type": "text",
          "attrs": {
