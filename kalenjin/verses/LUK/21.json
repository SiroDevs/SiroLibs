{
  "id": "LUK.21",
  "number": "21",
  "bookId": "LUK",
  "reference": "Luka 21",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "LUK 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sendesiek aeng’ che bo mosoget",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiyot met, kogeer magorek kondoi kagochinoikwak ole kiyumjin. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigeer mosoget age ne kibanania kondoi sendeisiek aeng’ che u kebebertab pesaiyat. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile, Amwawok iman ale, Kagonde mosogani banan che siirei cho tugul: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kagonde chu tugul eng’ chang’indanywa ole kindoi kagochinoik; ago kagonde inendet eng’ banandanyi tugul che tinyei, agot che kosobe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.4",
            "verseOrgIds": [
              "LUK.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sib komwaei Jesu agobo kabutetab Jerusalem ak agobo kagesunnetab betusiek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.4",
            "verseOrgIds": [
              "LUK.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingota kong’alali alak agobo hekalut, ole kigimusaganda eng’ koik che kororon ak kagochinoik, kole, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng’ tuguchu ogeere, ko tun bwanei betusiek, che mang’etune koita agot agenge, baragutab age, ne ma tun kiwirjin ng’ony.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.6",
            "verseOrgIds": [
              "LUK.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.6",
            "verseOrgIds": [
              "LUK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteebe, kole, Konetindoni, egu anyun tuguchuto auyo? Ak u nee kaborunet ye tun machei korik kosulda tuguchuto?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile, Oripge si ma kibeetok: amu tun bwanei bik che chang’ eng’ kainennyu, kolen, A inendet; ak, Kagorik betusiek: amosub ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye tun ogas agobo lugosiek ak chemarget, ko mat oarogense: amu kanyol kosib kosulda tuguchoto korok; ago tom korik kagesunet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.9",
            "verseOrgIds": [
              "LUK.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.9",
            "verseOrgIds": [
              "LUK.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolenji anyun ichek, Tun setyin bororiet age bororiet age, ak setyin bounatet age bounatet age: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kobiit botanosiek che eechen che bo ng’ony, ak rubosiek eng’ oldinwek alak, ak korotwek; ak kobiit kamuisosiek ak kaborunoik che eechen che bunu kipsengwet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.11",
            "verseOrgIds": [
              "LUK.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ye tom kobiit chuto, konamak eng’ eunekwak, ak kousok, ak komutak obe sunagogisiek ak korgorosiek, komutak taitab laitorinik ak bounik agobo kainennyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egu baornatet eng’ okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oegu che begechinotin eng’ mugulelwekwok, si mosib ogerer met agobo ole owolundoi: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu agonok kutit ak ng’omnatet, ne maimuchi bunikwok tugul kota kowol kiy anan kogirindaak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kong’wektak sigikwok, ak che otupche, ak che bo oreng’wong’, ak choronok; ak kebar alak eng’ okwek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kowechok bik tugul agobo kainennyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak mabetei sumeiyot agenge ne bo metowekwok. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ muitaeng’wong’ onyoru sobonwekwok.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.19",
            "verseOrgIds": [
              "LUK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.19",
            "verseOrgIds": [
              "LUK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye tun ogeer lugosiek koyiem Jerusalem, onai anyun ole, kagorik ng’emisiennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingomwechi anyun chi mi Judea tulonok; ak ingomanda che mi kwenutab nganasanato; ak amat kota koba orit ichek che mi emonoto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu chuto ko betusiekab mugetut, si kobiit kosulda tuguk tugul che kigisir. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwa eng’ ichek che chio ak che reritos eng’ besiosiechoto! Amu biitu bichiindo ne o eng’ ng’ony, ak nereknatet eng’ bichuto. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kobutyo ichek eng’ ng’atibindab rotwetab chok, ak kimut luulenik koba bororiosiek tugul: ak kotiech Bororiosiek Jerusalem, agoi kosulda betusiekab Bororiosiek.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.24",
            "verseOrgIds": [
              "LUK.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.24",
            "verseOrgIds": [
              "LUK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kobiit kaborunoik eng’ asista ak eng’ arawet ak eng’ kecheik; ak kobiit eng’ ng’ony bichiindab bororiosiek, ak beng’jinet amu kamuutetab nyanjet ak beek che mildogei; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kobek mugulelwekab bik amu kaiyweisiet, ak amu kagenisietab tuguk che bwanjin ng’ony: amu kitumdum kimnatosiekab kipsengwetisiek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak eng’ betunoto kogeer anyun Weritab chi konyonei eng’ boldet koboto kimnatet ak lilindo ne o. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye toi kosulda tuguchuto, ogeer barak, ak oyot metowekwok; am karik katiageng’wong’.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanyol keripge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi ichek kalewenet; kole, Ogeer mogoiywet, ak ketik tugul: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ye ing’atyo ogeere ak onae okwek ole, karik kesisiet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "U noto anyun ak okwek, ye ogeer koyaagis tuguchuto, onai ole karik bounatetab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.31",
            "verseOrgIds": [
              "LUK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwawok iman ale, Masiirtoi ibini, agoi kosulda tuguk tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siirtoi kipsengwet ak ng’ony: ago magoi siirto ng’alekyuk.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago oripge anyun okwek, si manyi mugulelwekwok keiyandit, ak bogitet, ak kaiimutikab sobetab betusiechu, ak konyonjok betunoto kocheak ko u mestet: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu u noto tun nyonjin bik tugul che menyei ng’ony komugul. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago oripge eng’ betut age tugul, ak osae, si kobiit oterterisie, ochilile tuguchuto tugul bwanei, ak otononse eng’ taitab Weritab chi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.36",
            "verseOrgIds": [
              "LUK.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.36",
            "verseOrgIds": [
              "LUK.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiinetisiei eng’ hekalut betut age tugul; ak kimandoi kemout age tugul, kowendi kotebyei eng’ tulwet ne kiguure tulwetab Emitik. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimusyin bik tugul inendet eng’ hekalut, si kobiit kogas inendet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
          }
        }
      ]
    }
