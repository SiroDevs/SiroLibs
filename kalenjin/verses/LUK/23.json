{
  "id": "LUK.23",
  "number": "23",
  "bookId": "LUK",
  "reference": "Luka 23",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LUK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Komi Jesu taitab Pilato, bounindet ne bo Rom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "King’eetyo anyun tuiyet komugul, ak komutyi inendet Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.1",
            "verseOrgIds": [
              "LUK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitoi anyun kotaam inendet, kole, Kiginyoru chichi komaasi bororiennyo, ak koetei kigochi Kaisari kodi, ak komwaei inendet kole, A Kristo laitoriat. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.2",
            "verseOrgIds": [
              "LUK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteebe inendet Pilato, kole, I laitoriatab Yahudik? Ak kiwolji kole, Kaimwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.3",
            "verseOrgIds": [
              "LUK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Pilato tisiik che eechen ak tuiyosiek, Ma anyorji lelutiet chichi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.4",
            "verseOrgIds": [
              "LUK.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiisimji mising’, kole, Kiinde chaamset bik, konetoti eng’ Judea komugul, kotoune Galili agoi koit oli.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Komi Jesu taitab Herod",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.5",
            "verseOrgIds": [
              "LUK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kingogas Pilato ng’olyondonoto, koteeb kole, Tos Galilindet chichi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.6",
            "verseOrgIds": [
              "LUK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingonai kole bo bounatet ne bo Herod, koyokto kimutyi Herod, ne kimi agine Jerusalem betusiechoto.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.7",
            "verseOrgIds": [
              "LUK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingogeer Herod Jesu, kobaibait mising’: amu kimachei koboch keny kogeer inendet, amu kiga kogas tuguk che chang’ agobo inendet; ak kimachei kogeer kwong’utiet age koyaak eng’ inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.8",
            "verseOrgIds": [
              "LUK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiteepse inendet eng’ ng’alek che chang’; ago ma wolji kiy. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.9",
            "verseOrgIds": [
              "LUK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitonondos tisiik che eechen ak sirik, ak kotaam inendet eng’ kimnatet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.10",
            "verseOrgIds": [
              "LUK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiiming’in inendet Herod ak askarikyik, ak kochombil, ak kolaakyi ngoriet ne kararan mising’ ak koweekyi Pilato kogeny. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.11",
            "verseOrgIds": [
              "LUK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiek choronoi Herod ak Pilato eng’ betunoto: amu kita kosurtos ichegei eng’ tai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pilato, Baraba ak Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.12",
            "verseOrgIds": [
              "LUK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiguur anyun Pilato tisiik che eechen ak bounik koboto bik kobwa tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.13",
            "verseOrgIds": [
              "LUK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kilenji ichek, Komutwa chichi, ak komwa ole imaasi bik: ak ogeero, kaatebe anendet eng’ taing’wong’, ak ma anyorji chichi lelutiet eng’ ng’alechato otaame inendet: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.14",
            "verseOrgIds": [
              "LUK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "achicha, agot Herod agine; amu kaweekwech inendet; ak ogeero, ma yai kiy inendet ne nyoljin meet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.15",
            "verseOrgIds": [
              "LUK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noto anyun, abire inendet, si atiach. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.16",
            "verseOrgIds": [
              "LUK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ki ng’atutiet kotiakyi agenge eng’ betutab igorta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.17",
            "verseOrgIds": [
              "LUK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kibolyo tugul, kole, Iste chichi, ak itiakwech Baraba: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.18",
            "verseOrgIds": [
              "LUK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kiga kitoorji korgoret, amu chaamset ne kiyai eng’ nganaset, ak rumisiet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.19",
            "verseOrgIds": [
              "LUK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak king’alalji Pilato icheget kogeny, komachei kotiach Jesu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.20",
            "verseOrgIds": [
              "LUK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago kibolyo ichek, kole, Igartat eng’ kimurtoiyot, igartat inendet eng’ kimurtoiyot. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.21",
            "verseOrgIds": [
              "LUK.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimwachi ichek ne bo somok, kolenji, Kalya, nee yaitiet ne kiyai chichi? Ma anyorji ng’olyot inendet ne nyoljin kome: noto anyun abire inendet si atiach.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.22",
            "verseOrgIds": [
              "LUK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kites kobolyo mising’, komachei kole kigartat. Ak kiiterteris kutuswekwak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.23",
            "verseOrgIds": [
              "LUK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitil anyun Pilato kiruoget koyaak ko u ye kimach ichek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.24",
            "verseOrgIds": [
              "LUK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiitiach inendet ne kiga kitoorji korgoret agobo chaamset ak rumisiet, ne kaga kosom ichek; ago kiigoito inendet Jesu si kobiit koyachi ko u ye kimachei.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kigartati Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.25",
            "verseOrgIds": [
              "LUK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingota komuti inendet, konam Simon, Kurenindet, ne kibunu koret age, ak kosutyi kimurtoiyot, si kobiit koib kosubi Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.26",
            "verseOrgIds": [
              "LUK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiisubi tuiyet ne o ne bo bik, koboto kobogorisiek che kiiteiyoti ak korirjinoti inendet. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.27",
            "verseOrgIds": [
              "LUK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiweleljigei Jesu ichek kolenji, Tibikab Jerusalem, amoririe agobo ane, ago orirjige, ak lagokwok. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.28",
            "verseOrgIds": [
              "LUK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu, ogeero, bwanei betusiek, che tun len ichek, Kiberuri sonotinwek, ak mootinwek che ma iiyo, ak kinaik che ma kireri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.29",
            "verseOrgIds": [
              "LUK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo kotoi ichek kolenji tulonok, Oluuljech; ak kolenji tulonok che mengech, Otuchech. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.30",
            "verseOrgIds": [
              "LUK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ngot koyai tuguchu eng’ ketit ne tuon, koteptoi ano anyun eng’ ne yaamat?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.31",
            "verseOrgIds": [
              "LUK.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimitei kiptengeginik aeng’u, che kigimuti koboto inendet, koba kebar. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.32",
            "verseOrgIds": [
              "LUK.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingoit ye kiguure Terta, ko yoto ole kigigartate inendet ak kiptengeginichoto, age eng’ komostab tai ak age eng’ komostab katam. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.33",
            "verseOrgIds": [
              "LUK.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile Jesu, Baba, nyochi kaat ichek; amu ma nai kit ne yaei. Ak kipchechigei ngoroikyik, eng’ seretab barbarek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.34",
            "verseOrgIds": [
              "LUK.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitonondos bik kogeerei. Ak kororechi inendet bounik kole, Kisoru alak; ingosorgei ibak, ngo Kristo nito, ne lewenot ne bo Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.35",
            "verseOrgIds": [
              "LUK.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kichurachur agichek askarik inendet, kobwanei ye mi inendet, kogochin siki, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.36",
            "verseOrgIds": [
              "LUK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolen, Ngo i Laitoriatab Yahudik, isoruge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.37",
            "verseOrgIds": [
              "LUK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kimi sirutik metinnyi barak, che mwaei kolen, NI KO LAITORIAT NE BO YAHUDIK.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.38",
            "verseOrgIds": [
              "LUK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kichurachur inendet age eng’ kiptengeginichoto kiga kigartat, kole, Tos ma i Kristo inye? Soruge ak isoruech ak achek. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.39",
            "verseOrgIds": [
              "LUK.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago kiwol age, ak koger kong’ kole, Meiywei Jehovah, agot inye, ak imi kagikyinonoto? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.40",
            "verseOrgIds": [
              "LUK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago bo iman nenyo; amu kagigonech ko u boisionikyok: ago ma yai chichi kiy ne ma nyolu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.41",
            "verseOrgIds": [
              "LUK.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kile, Jesu, ibwata ye tun inyone eng’ bounateng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.42",
            "verseOrgIds": [
              "LUK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilenji Jesu inendet, Amwaun iman, ale, Kitebye tuwai rani eng’ Paradis.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meetab Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.43",
            "verseOrgIds": [
              "LUK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ki olo bo sait lo, koimenit emet komugul agoi sait sogol, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kima kota koluu asista: ak kigerer kwenutab anget ne kiga kioiye ole tilil. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitwek Jesu eng’ kutit ne o, kole, Baba, kande tamirmiriennyu euneguk: ak kingo kagomwa ni, kogoito tamirmiriet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogeer kiptaiyatab bogol tuguk che kayaagis, kolos Jehovah, kole, Koga bo iman chichi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingogeer tuguk che kayaagis tuiyosiek tugul che kiga koyumgei si korat setio, koweeigei kolugotegei tegetik. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kitonondos eng’ ye loo tugul che kiingengei, ak kobogorisiek che kiisubu inendet kobunu Galili, kole si kogeer tuguchuto.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tubetab Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ogeero, chito ne kigiguure Josep, chitab kapkiruok, chito ne mie, ak ko bo imanda ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "(ak kima kochamei chichoto kiruogenywa ak boisienywa), ki bo Arimatea inendet, nganaset ne bo Yahudik, ne kiigeni agine bounatetab Jehovah: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiwa chichito ole mi Pilato, kwo kosom bortab Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kochoor konyo ng’ony, ak kotaae anget ne bo katanit, ak konde kererit ne kigibal ruandet, ne kitom ketupchi chi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ki betutab Chobet, ak kiga rik sabato.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 23:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiisubu kobogorisiek, che kigabwa koboto inendet kobunu Galili, ak kogeer kererit, ak ole kigindoitoi bortanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
            "verseOrgIds": [
              "LUK.23.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 23:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiweeigei, koba kochob nyamdutik ak mwanik. Ak kiimuuny eng’ betutab sabato ko u ng’atutiet.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.56",
            "verseOrgIds": [
              "LUK.23.56"
            ]
          }
        }
      ]
    }
  ],
