{
  "id": "DEU.26",
  "number": "26",
  "bookId": "DEU",
  "reference": "Ng'Atutik 26",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "DEU 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kagoitoetab tongoanik ak kebeberwekab taman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak ye kaiit emet ne konin Jehovah Kamuktaindeng’ung’ koek borotet kobunjin, ak imeny oloto; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "inam anyun eng’ tongoanik tugul che bo logoek che bo emet che iibu eng’ emeng’ung’ ne konin Jehovah Kamuktaindeng’ung’; inde kitonget, iib koba ole leweni Jehovah Kamuktaindeng’ung’ kole konde kainennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak inyo anyun ole mi tisiindet ne mi eng’ betusiechoto, nyo ilenji, Aborjini rani Jehovah Kamuktaindeng’ung’ alenjini, Kaitu emet ne kiiyosiechi Jehovah kwanisiekyok kole konech.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeityo koib tisiindet kitonget eng’ eung’ung’, ak konde taitab kaptisisietab Jehovah Kamuktaindeng’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak iwolu eng’ taitab Jehovah Kamuktaindeng’ung’ ile, Ki Suriaindet baba ne kimachei kobet, kichortagei Misri, komeny oloto, kima kotia; ak kiek bororiet ne o eng’ oloto, kogimit, ak kochang’ait. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiyaiywech ne ya Misrik, kiinyalilech, ak koratyech boisiet ne nyigis: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kigirirji Jehovah, Kamuktaindetab kwanisiekyok, ak kigas Jehovah kutinnyo, kigeer nyalildanyo, ak birtoennyo bo ge, ak sastaet ne kigisastaenech: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiimoong’wech Jehovah eng’ Misri, eng’ eut ne kim, ak eng’ eut ne chuulat, ak eng’ kamuiset ne o, ak eng’ kaborunoik, ak kwong’utik: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kigomutwech keitu olito, ak kigonech emoni, emet ne nyiitat chego ak kumik. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keer nguno anyun, kaibu tongoanik che bo logoek che bo emet ne kiigona inye Jehovah. Yeityo inde ng’ony eng’ taitab Jehovah Kamuktaindeng’ung’, ak ilosu Jehovah Kamuktaindeng’ung’: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ibaibaitu eng’ mieindo tugul ne kigonin Jehovah Kamuktaindeng’ung’, ak gong’ung’, inye ak Lawindet, ak toondet ne mi kwenung’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye kainemu iges kebeberwek che bo taman che bo kebeberwekab rurateng’ung’ eng’ kenyit ne bo somok, noto kenyit ne kigoitoe kebeberta, igochi choto anyun Lawindet, ak toondet, ak ne matinyei kwanda, ak mosoget, si koamis eng’ kurgotiguk kobiyong’so; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeityo imwa eng’ taitab Jehovah Kamuktaindeng’ung’, ile, Kaanemu eng’ gonnyu tuguk che itabanotin, kaagochi agine Lawindet, ak tondet, ak ne matinyei kwanda, ak mosoget, ko u ng’atutieng’ung’ tugul ne kiing’ata: ma abistoe ng’atutiguk alak tugul, ama autie: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma aam tukchoto eng’ rirekyuk, ama aiste alak eng’ choto, aboisie eng’ boisiet ne ma tilil, ama agoite amu che kigobek: kiagas it kutitab Jehovah Kamuktaindennyu, kiayai ko u tugul che kiing’ata. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keer anyun ng’ony eng’ meng’ateng’ung’ ne tilil, eng’ kipsengwet, ak iberur biguk Israel, ak emet ne kiigonech, ko u ye kiiyosiechi kwanisiekyok, emet ne nyiitat chego ak kumik.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kang’atin rani Jehovah Kamuktaindeng’ung’ iyai konetisiosiechu ak kiruogutichu: rib anyun ak iyai eng’ muguleldang’ung’ komugul, ak eng’ sobondang’ung’ komugul. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keng’any rani Jehovah, ile, inendet ko Kamuktaindeng’ung’ ak ile kanyol iwendote ortinwekyik, ak irib konetisiosiekyik, ak ng’atutikyik, ak kiruogutikyik, ak igas it kutinnyi: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kang’any Jehovah rani kole, I bororiet ne kigitabanin iegu nenyi, ko u ye kiiarorun, ak si kobiit irib ng’atutikyik tugul; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak koyain itororitu isiir bororiosiek tugul che kiyai inendet eng’ kalosunet, ak kainet, ak teegisto; si iegu bororiet ne tilil eng’ Jehovah Kamuktaindeng’ung’, ko u ye kimwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
      ]
    }
  ],
