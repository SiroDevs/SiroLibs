{
  "id": "JER.18",
  "number": "18",
  "bookId": "JER",
  "reference": "Jeremia 18",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
