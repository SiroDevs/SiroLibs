    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tiendab Daudi ne bo kalosunet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiib anyun moingetab Kamuktaindet, ak konde kwenutab emait ne kiga teekyi Daudi; ak kiigoito kagochinoik che kibeelei ak kagochinoikab kalyet eng’ taitab Kamuktaindet. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kingo kagoges Daudi kogoitoetab kagochinet ne kibeelei ak kagochinoikab kalyet, koberur bik eng’ kainetab Jehovah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiigochi chi age tugul ne bo Israel, ne muren ak kwonyu, kiigochi chi age tugul makatiat, ak bendo kitigin, ak makatiatab sabibuk che yaamnyotin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kilewen alak eng’ Lawik kobois eng’ taitab moingetab Jehovah, ak koyai kabwatet, ak komwachin kongoi Jehovah Kamuktaindetab Israel, ak kolosu inendet: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki ne o Asap, ak ki ne rubei Sekaria, Jeiel, Semiramot, Jehiel, Matitia, Eliab, Benaia, Obed-edom ak Jeiel, kobutei kibugandinik ak ketubosiek; ak kibirei Asap sanisiek che bo sugunonik, kocheiyo mising’; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kiguutei kotugul iriagok Benaia ak Jahasiel tisiik, eng’ taitab moingetab arorutietab Kamuktaindet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kong’at anyun Daudi eng’ betunoto, kigochi Jehovah kongoi korok, eng’ Asap ak tupchosiekyik.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobagach anyun eng’ yoto, eng’ taitab moingetab arorutietab Jehovah, Asap ak tupchosiekyik, si kobiit kobois eng’ taitab moinget betusiek tugul, ko u ye yamegei ak boisietab betut age tugul. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak Obed-edom, koboto tupchosiekwak, bik tamanwogik lo ak sisiit; ak kobagach agine Obed-edom weritab Jedutun ak Hosa koek ribikab kurget: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kobagach Sadok tisiindet ak tupchosiekyik tisiik, eng’ taitab gotab Jehovah eng’ komosta ne toror ne kimi Gibeon, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kogochin Jehovah kagochinoik che kibeelei eng’ kaptisisietab kagochinet ne kibeelei kotugul karon ak koskoleny, ko u tugul che kigisirji Ng’atutikab Jehovah, che king’atyi Israel; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
            "verseOrgIds": [
              "1CH.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kimi koboto ichek Heman ak Jedutun ak che kiga ng’et tugul che kigilewen, che kigimwa eng’ kainaikwak, koweekyi kongoi Jehovah, amu tebyei rirenennyi koigeny; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kimi koboto ichek Heman ak Jedutun che kitinyei iriagok ak sanisiek che bo sugunonik che kibirei, che bo ichek che birei kocheiyo mising’, ak tuguk che kibutei che bo tienwogikab Kamuktaindet: ak kotebe werikab Jedutun ormarich. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kiba bik tugul kwo chi tugul gonnyi: ak kiweek Daudi kwo koberur gonnyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
          }
        }
      ]
    }
  ],
