          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimong’ barbariat ne bo tai, kobunji Josep agobo Asap: kobunji ne bo aeng’ Gedalia; ki taman ak aeng’ koboto tupchosiekyik ak werikyik: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
