          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kobunji ne bo ang’wan Isri, ki taman ak aeng’ werikyik ak tupchosiekyik: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
