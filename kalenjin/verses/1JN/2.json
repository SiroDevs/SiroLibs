          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak nguno anyun, lagochu mengech, omeny inendet; si ye tun kaging’any inendet, kesich nyiganatet, ama kililani eng’ tainnyi eng’ nyonunennyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngot ongen ole bo imanda inendet, ongen ole age tugul ne yaei imanda ko kigesich agine eng’ inendet.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
