              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaasirwak tuguchu agobo ichek che machei kobeetok. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak okwek anyun, komenyok kaiilet ne kionyoru eng’ inendet, ak manyol konetak chi; ago ko u ye inetok kaiilennyi agobo tuguk tugul, ak ko bo iman, ma lembech, ak ko u ye kigonetak, omeny inendet.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
