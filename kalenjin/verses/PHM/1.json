        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’alek che indou",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, kimonjororiotab Kristo Jesu, ak Timoteo tupchennyo, kisirjini Pilemon chamanennyo ne kiboitiot ne kiboisiei tugul, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak Apia, chepkamennyo, ak Arkipa askarindet ne kiboisiei tugul, ak kaniset ne mi gong’ung’:",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingoteb mieindo kobotok ak kalyet, che bunu Jehovah Kwandanyo ak Kiptaiyat Jesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rirenet ne kigisomji otwogindet ne kiga komwei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwachini Jehovah nenyu kongoi kotugul, amwain eng’ sautikyuk, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.4",
            "verseOrgIds": [
              "PHM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "agase agobo chamnyeng’ung’, ak kayanet ne itinye eng’ Kiptaiyat Jesu, ak eng’ che tililen tugul; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.5",
            "verseOrgIds": [
              "PHM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "si koek yamdaetab kayaneng’ung’ ne boisie komie, eng’ naetab kiy age tugul ne mie ne mitech, eng’ Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.6",
            "verseOrgIds": [
              "PHM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kiatinye boiboiyet ne o ak kagaigaet eng’ chamnyeng’ung’, amu kigonyor kamuung’et mugulelwekab bik che tililen agobo inye, ne kitupche.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noto anyun, agot nga ndatinye nyiganatet eng’ Kristo si ang’atin agobo noto ne nyolu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.8",
            "verseOrgIds": [
              "PHM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago, amu chamnyet asomin mising’, ane Paulo ne koaositu, ak nguno kogeny ko a kimonjororiot ne bo Kristo Jesu: ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "asomin mising’ agobo lakwennyu Onesimo, ne kiasich eng’ monjorornatosiekyuk, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.10",
            "verseOrgIds": [
              "PHM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "inendet ne kima kotoretin eng’ kiy eng’ tai, ago nguno kotoretin ak kotoreta:",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.11",
            "verseOrgIds": [
              "PHM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.11",
            "verseOrgIds": [
              "PHM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kaaweegun inendet ne muguleldanyu: ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.12",
            "verseOrgIds": [
              "PHM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kitamache arany ketebi tuwai, si kotoreta kogeerenengei eng’ monjorornatosiekab logoiywek che miach: ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.13",
            "verseOrgIds": [
              "PHM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ago ma amach ayai kiy kotom agas kit ne ibwati; si mabun mieindang’ung’ torjinet, ago chamdaeng’ung’.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu abere kiibesienengei eng’ betusiek che matia, si kobiit otebi tuwai kogeny agoi; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.15",
            "verseOrgIds": [
              "PHM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ko u otwogin kogeny, ago kogosiir otwogin, tupchet ne chamat, mising’ ko eng’ ane, ago siirei ne tia anyun eng’ inye, eng’ borto ak eng’ Kiptaiyat.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noto anyun ngiita ile ki agenge eng’ boisiet, itaach anyun ko u ye imuchi itaacha anendet. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.17",
            "verseOrgIds": [
              "PHM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ngo kigoyaun kiy ne ya, anan ngo kigobesenin kiy, iitya noto; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.18",
            "verseOrgIds": [
              "PHM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "anendet Paulo ne kasir eng’ eunnyu, ale ayaagun; ago mamwaun ale itinye besendanyu, u kele, inyendet noto. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.19",
            "verseOrgIds": [
              "PHM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, tupchennyu, inganyorunenen boiboiyet eng’ Kiptaiyat: imuung’ji muguleldanyu eng’ Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ng’alek che bo let",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasirun amu amang’u kaseng’ung’ bo it, angen ale iyae agot che siirei che amwae. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.21",
            "verseOrgIds": [
              "PHM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago koboto choto ichobwa ole anyo arue: amu amang’u ale eng’ sautikwok amuchi abiit.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.22",
            "verseOrgIds": [
              "PHM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.22",
            "verseOrgIds": [
              "PHM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igatin Epapra ne ki kimonjororinik tuwai, eng’ Kristo Jesu; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko u noto Mariko, Aristarko, Dema, ak Luka, che ki kiboitinik tugul.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.24",
            "verseOrgIds": [
              "PHM.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.24",
            "verseOrgIds": [
              "PHM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingoteb mieindab Kiptaiyandennyo Jesu Kristo koboto tamirmirikwok. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.25",
            "verseOrgIds": [
              "PHM.1.25"
            ]
          }
        }
      ]
    }
  ],
