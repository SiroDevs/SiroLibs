              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.30"
              },
              "items": [
                {
                  "text": "Mdo 28:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.22"
              },
              "items": [
                {
                  "text": "Flp 4:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.1"
              },
              "items": [
                {
                  "text": "Efe 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " hata vifungo vyangu vimekuwa dhahiri katika Kristo, miongoni mwa askari, na kwa wengine wote pia. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wengi wa hao ndugu walio katika Bwana, wakapata kuthibitika kwa ajili ya kufungwa kwangu, wamezidi sana kuthubutu kunena neno la Mungu pasipo hofu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wengine wanahubiri habari za Kristo kwa sababu ya husuda na fitina; na wengine kwa nia njema. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa wanamhubiri kwa pendo, wakijua ya kuwa nimewekwa ili niitetee Injili; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
