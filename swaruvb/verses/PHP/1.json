        },
        {
          "text": " Paulo na Timotheo, watumwa wa Kristo Yesu, kwa watakatifu wote katika Kristo Yesu, walioko Filipi, pamoja na maaskofu",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Askofu:",
              "type": "text"
            },
            {
              "text": "maana yake ni, Mwangalizi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na mashemasi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Shemasi:",
              "type": "text"
            },
            {
              "text": "maana yake ni, Mtumishi wa kanisa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
