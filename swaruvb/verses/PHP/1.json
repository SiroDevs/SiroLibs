              "items": [
                {
                  "text": "Rum 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neema na iwe kwenu na amani zitokazo kwa Mungu Baba yetu na kwa Bwana Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
