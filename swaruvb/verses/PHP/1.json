              "type": "text"
            }
          ]
        },
        {
          "text": " Lakini, ndugu zangu, nataka mjue ya kuwa mambo yote yaliyonipata yametokea zaidi kwa kuieneza Injili; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
