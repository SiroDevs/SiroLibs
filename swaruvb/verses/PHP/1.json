              "items": [
                {
                  "text": "2 Kor 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.5"
              },
              "items": [
                {
                  "text": "1 The 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana Mungu ni shahidi wangu, jinsi ninavyowaonea shauku ninyi nyote katika moyo wake Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hii ndiyo dua yangu, kwamba pendo lenu lizidi kuwa jingi sana, katika hekima na ufahamu wote; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
