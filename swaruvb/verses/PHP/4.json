                  "text": "1 Tim 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Si kwamba nasema haya kwa kuwa nina mahitaji; maana nimejifunza kuwa radhi na hali yoyote niliyo nayo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
