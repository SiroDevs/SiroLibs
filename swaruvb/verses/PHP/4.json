                }
              ]
            }
          ]
        },
        {
          "text": " Nayaweza mambo yote katika yeye anitiaye nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
