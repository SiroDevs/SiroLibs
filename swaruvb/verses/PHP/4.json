                  "text": "Mdo 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kuwa hata huko Thesalonike mliniletea msaada kwa mahitaji yangu, wala si mara moja. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.16",
