              "type": "text"
            }
          ]
        },
        {
          "text": "Wale wajumbe wakarudi, na mfalme akawaambia, Mbona mmerudi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
