                  "text": "Isa 26:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akatuma tena kiongozi wa hamsini mwingine pamoja na hamsini wake, wamwendee. Akajibu, akamwambia, Ewe mtu wa Mungu, mfalme asema, Shuka upesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
