                  "text": "Lk 9:54",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eliya akajibu, akamwambia yule kamanda wa hamsini, Ikiwa mimi ni mtu wa Mungu, na ushuke moto kutoka mbinguni, ukuteketeze wewe na hamsini wako. Moto ukashuka, ukamteketeza, yeye na hamsini wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        },
        {
