                "loc": "ZEC.13.4"
              },
              "items": [
                {
                  "text": "Zek 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.4"
              },
              "items": [
                {
                  "text": "Mt 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakamwambia, Alikuwa amevaa vazi la manyoya, tena amejifunga shuka ya ngozi kiunoni mwake. Naye akasema, Ndiye yule Eliya Mtishbi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
