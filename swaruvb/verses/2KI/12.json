                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini fedha ya matoleo ya kosa, na fedha ya matoleo ya dhambi, haikuletwa nyumbani mwa BWANA; hiyo ilikuwa ya makuhani wenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        }
      ]
    },
