              "type": "text"
            }
          ]
        },
        {
          "text": " Katika mwaka wa saba wa Yehu, Yoashi alianza kutawala; akatawala miaka arubaini huko Yerusalemu; na jina la mama yake aliitwa Sibia wa Beer-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoashi akafanya yaliyo mema machoni pa BWANA siku zake zote Yehoyada kuhani alizomfundisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.1"
              },
              "items": [
                {
                  "text": "2 Nya 24:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ila mahali pa juu hapakuondolewa; watu wakaendelea kutoa sadaka na kufukiza uvumba katika mahali pa juu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        }
      ]
    },
