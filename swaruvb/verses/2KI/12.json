        },
        {
          "text": " Walakini hawakufanya hesabu na hao watu, waliokabidhiwa fedha hiyo ili wawape watenda kazi; kwa kuwa walitenda kwa uaminifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
