                }
              ]
            }
          ]
        },
        {
          "text": " Nao watumishi wa Amoni wakamfitinia, wakamwua mfalme ndani ya nyumba yake mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
