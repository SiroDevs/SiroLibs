          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini watu wa nchi wakawaua wote waliomfitinia mfalme Amoni, watu wa nchi wakamfanya Yosia mwanawe awe mfalme mahali pake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
              "2KI.21.24"
            ]
          }
        },
