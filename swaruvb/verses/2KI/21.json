              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mambo yote ya Amoni yaliyosalia, aliyoyafanya, je! Hayakuandikwa katika Kitabu cha Kumbukumbu za Wafalme wa Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
