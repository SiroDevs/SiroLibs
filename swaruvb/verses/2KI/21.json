              "items": [
                {
                  "text": "2 Nya 33:11-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi mambo yote ya Manase yaliyosalia, na yote aliyoyafanya, na kosa lake alilolikosa, je! Hayakuandikwa katika Kitabu cha Kumbukumbu za Wafalme wa Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
