              "items": [
                {
                  "text": "Hes 11:17-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata ikawa, walipokwisha kuvuka, Eliya akamwambia Elisha, Omba kwangu lolote utakalo nikutendee, kabla sijaondolewa kwako. Elisha akasema, Nakuomba, sehemu maradufu ya roho yako na iwe juu yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
