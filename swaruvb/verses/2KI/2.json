                  "text": "Yn 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akalitwaa lile vazi la Eliya lililomwangukia, akayapiga maji, akasema, Yuko wapi BWANA, Mungu wa Eliya? Naye alipoyapiga maji, yakagawanyika huku na huku, Elisha akavuka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hao wana wa manabii, waliokuwako Yeriko wakimkabili, walipomwona, walisema, Roho ya Eliya inakaa juu ya Elisha. Wakaja kuonana naye, wakainama kifudifudi mbele yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
