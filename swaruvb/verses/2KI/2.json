                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema, Umeomba neno gumu; lakini, ukiniona nitakapoondolewa kwako, utalipata; la hukuniona, hulipati. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
