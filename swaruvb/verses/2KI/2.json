              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamsisitiza hata akaona haya, akasema, Haya! Watumeni. Basi wakatuma watu hamsini; nao wakatafuta siku tatu, wasimwone. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamrudia, alipokuwa anakawia Yeriko; akawaambia, Je! Mimi sikuwaambia, Msiende?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
