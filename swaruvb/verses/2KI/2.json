        },
        {
          "text": "Kisha akaliokota lile vazi la Eliya lililomwangukia, akarudi, akasimama katika ukingo wa Yordani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
