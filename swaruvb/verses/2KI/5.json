              "items": [
                {
                  "text": "Yak 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je! Abana na Farpari, mito ya Dameski, si bora kuliko maji yote ya Israeli? Je! Siwezi kujiosha ndani yake, na kuwa safi? Akageuka, akaondoka kwa hasira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        }
