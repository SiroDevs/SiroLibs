              "items": [
                {
                  "text": "Kut 4:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikawa, Elisha, yule mtu wa Mungu, aliposikia kwamba mfalme wa Israeli ameyararua mavazi yake, ndipo akatuma mtu kwa mfalme, akisema, Mbona umeyararua mavazi yako? Na aje sasa kwangu mimi, naye atajua ya kuwa yuko nabii katika Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Naamani akaja na farasi wake na magari yake, akasimama mlangoni pa nyumba ya Elisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.41"
              },
              "items": [
                {
                  "text": "2 Fal 4:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.7"
              },
              "items": [
                {
                  "text": "Yn 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Elisha akampelekea mjumbe, akisema, Nenda ukaoge katika Yordani mara saba, na nyama ya mwili wako itakurudia, nawe utakuwa safi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.14"
              },
              "items": [
                {
                  "text": "1 Kor 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini Naamani akakasirika, akaondoka, akasema, Tazama, nilidhania, Bila shaka atatoka kwangu, na kusimama, na kuomba kwa jina la BWANA, Mungu wake, na kupitisha mkono wake mahali penye ugonjwa, na kuniponya mimi mwenye ukoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
