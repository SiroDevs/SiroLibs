              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Gehazi akamfuata Naamani. Naye Naamani, alipoona mtu apigaye mbio anakuja nyuma yake, alishuka garini amlaki, akasema, Je! Ni amani? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
