          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye alipofika kilimani, alivichukua kutoka mikononi mwao, akaviweka nyumbani; akawaacha wale watu kuondoka, nao wakaenda zao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
