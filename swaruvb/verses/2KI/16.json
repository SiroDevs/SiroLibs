              "items": [
                {
                  "text": "Yer 17:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha akatoa sadaka na kufukiza uvumba katika mahali pa juu, na juu ya vilima, na chini ya kila mti mbichi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.1"
              },
              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hapo ndipo akakwea Resini mfalme wa Shamu pamoja na Peka mwana wa Remalia mfalme wa Israeli juu ya Yerusalemu ili wapigane; wakamhusuru Ahazi, ila hawakuweza kumshinda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.22"
              },
              "items": [
                {
                  "text": "2 Fal 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakati huo Resini mfalme wa Shamu akawarudishia Washami Elathi, akawafukuza Wayahudi kutoka Elathi; nao Washami wakaja Elathi, wakakaa humo hata leo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2 Fal 15:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.5.26"
              },
              "items": [
                {
                  "text": "1 Nya 5:26",
