              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mambo yote ya Ahazi yaliyosalia, aliyoyafanya, je! Hayakuandikwa katika Kitabu cha Kumbukumbu za Wafalme wa Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
