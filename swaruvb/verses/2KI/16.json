        {
          "text": " Lakini aliiendea njia ya wafalme wa Israeli, hata akampitisha mwanawe motoni, sawasawa na machukizo ya mataifa BWANA aliowafukuza mbele ya wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
