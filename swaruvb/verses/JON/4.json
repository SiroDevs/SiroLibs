                "loc": "MAT.20.15"
              },
              "items": [
                {
                  "text": "Mt 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lakini jambo hili lilimchukiza Yona sana, naye akakasirika. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Kut 34:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akamwomba BWANA, akasema, Nakuomba, Ee BWANA; sivyo hivyo nilivyosema, hapo nilipokuwa katika nchi yangu? Hii ndiyo sababu nilifanya haraka kukimbilia Tarshishi; kwa maana nilijua ya kuwa wewe u Mungu mwenye neema, umejaa huruma, si mwepesi wa hasira, u mwingi wa rehema, nawe waghairi mabaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.4"
              },
              "items": [
                {
                  "text": "1 Fal 19:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, sasa, Ee BWANA, nakuomba, uniondolee uhai wangu; maana ni afadhali nife mimi kuliko kuishi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye BWANA akasema, Je! Unatenda vema kukasirika? ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yona akatoka mjini, akaketi upande wa mashariki wa mji, akajitengenezea kibanda huko, akakaa chini yake uvulini, hadi aone mji ule utakuwaje. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na BWANA Mungu aliutayarisha mtango, akaufanya ukue juu ya Yona, ili uwe kivuli juu ya kichwa chake, na kumponya katika hali yake mbaya. Basi Yona akafurahi sana kwa sababu ya ule mtango. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini siku ya pili kulipopambazuka, Mungu akatayarisha buu, nalo likautafuna ule mtango, ukakatika. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.121.6"
              },
              "items": [
                {
                  "text": "Zab 121:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi ikawa, jua lilipopanda juu, Mungu akatayarisha upepo wa mashariki, wenye joto jingi; jua likampiga Yona kichwani, hata akazimia, naye akajitakia kufa, akasema, Ni afadhali nife mimi kuliko kuishi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yona akemewa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akamwambia Yona, Je! Unatenda vema kukasirika kwa ajili ya mtango? Naye akasema, Ndiyo, natenda vema kukasirika hata kufa. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana akamwambia, Wewe umeuhurumia mtango, ambao hukuufanyia kazi, wala kuuotesha; uliomea katika usiku mmoja, na kuangamia katika usiku mmoja; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.11"
              },
              "items": [
                {
                  "text": "Eze 33:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.39"
              },
              "items": [
                {
                  "text": "Kum 1:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.36.6"
              },
              "items": [
                {
                  "text": "Zab 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na mimi, je! Haikunipasa kuuhurumia Ninawi, mji ule mkubwa; ambao ndani yake wamo watu zaidi ya elfu mia moja na ishirini, wasioweza kupambanua katika mkono wao wa kulia na mkono wao wa kushoto; tena wamo wanyama wa kufugwa wengi sana?",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
