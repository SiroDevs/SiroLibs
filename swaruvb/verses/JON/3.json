              "items": [
                {
                  "text": "Omb 3:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.10"
              },
              "items": [
                {
                  "text": "Mik 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Habari ikamfikia mfalme wa Ninawi, naye akaondoka katika kiti chake cha enzi, akavua vazi lake, akajivika nguo za magunia, na kuketi katika majivu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 3:7"
          },
          "items": [
