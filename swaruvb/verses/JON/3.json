              "items": [
                {
                  "text": "Yoe 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye akapiga mbiu, akatangaza habari katika mji wa Ninawi, kwa amri ya mfalme na wakuu wake; kusema, Mwanadamu asionje kitu, wala mnyama wala makundi ya ng'ombe, wala makundi ya kondoo; wasile, wala wasinywe maji; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
