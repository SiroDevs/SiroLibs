                "loc": "ISA.1.16"
              },
              "items": [
                {
                  "text": "Isa 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.11"
