              },
              "items": [
                {
                  "text": "2 Pet 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini kwenu ninyi mnaolicha jina langu, jua la haki litawachomozea, likiwa na uwezo wa kuponya katika miale yake; nanyi mtatoka nje, na kuchezacheza kama ndama watokapo mazizini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
