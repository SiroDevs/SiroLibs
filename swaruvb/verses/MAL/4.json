              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:1",
              "type": "text"
            },
            {
              "text": "Kwa maana, Sura ya 4:1-6 ni Sura 3:19-24 katika Kiebrania.",
              "type": "text"
            }
          ]
        },
        {
          "text": " angalieni, siku ile inakuja, inawaka kama tanuri; na watu wote wenye kiburi, nao wote watendao uovu, watakuwa makapi; na siku ile inayokuja itawateketeza, asema BWANA wa majeshi; hata haitawaachia shina wala tawi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
