                "loc": "MIC.7.10"
              },
              "items": [
                {
                  "text": "Mik 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanyi mtawakanyaga waovu; maana watakuwa majivu chini ya nyayo za miguu yenu; katika siku ile niifanyayo, asema BWANA wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        }
