        },
        {
          "text": "Na sasa, enyi makuhani, amri hii yawahusu ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.1",
            "verseOrgIds": [
              "MAL.2.1"
            ]
          }
        },
        {
