                "loc": "NUM.25.12"
              },
              "items": [
                {
                  "text": "Hes 25:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Agano langu naye lilikuwa agano la uhai na amani; nami nikampa ili aogope, naye akanicha na kulihofu jina langu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
