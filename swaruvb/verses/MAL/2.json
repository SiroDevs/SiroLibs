                "loc": "PSA.100.3"
              },
              "items": [
                {
                  "text": "Zab 100:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je! Sisi sote hatuna Baba mmoja? Mungu aliyetuumba siye mmoja tu? Basi, mbona kila mmoja wetu anamtenda ndugu yake mambo ya hiana, tukilinajisi agano la baba zetu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.23"
              },
              "items": [
                {
                  "text": "Neh 13:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda ametenda kwa hiana, na chukizo limetendeka katika Israeli, na katika Yerusalemu; maana Yuda ameunajisi utakatifu wa BWANA aupendao, naye amemwoa binti ya mungu mgeni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA atamtenga mtu atendaye hayo, yeye aliye macho, na yeye ajibuye, atamtenga na hema za Yakobo, pia atamtenga yeye amtoleaye BWANA wa majeshi dhabihu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena mnatenda haya nayo; mnaifunikiza madhabahu ya BWANA kwa machozi, kwa kulia na kwa kuugua, hata asiiangalie tena hiyo dhabihu, wala kuitakabali mikononi mwenu na kuiridhia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.13",
            "verseOrgIds": [
              "MAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ninyi mwasema, Ni kwa sababu gani? Ni kwa sababu BWANA amekuwa shahidi kati ya wewe na mke wa ujana wako, uliyemtenda mambo ya hiana, ingawa yeye ni mwenzako, na mke wa agano lako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.14",
            "verseOrgIds": [
              "MAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.4"
              },
              "items": [
                {
                  "text": "Mt 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hakuna mtu mmoja aliyetenda hivi, ambaye alikuwa na ufahamu kidogo. Au je! Kuna mtu mmoja atafutaye mzawa mwenye kumcha Mungu? Kwa hiyo jihadharini roho zenu; mtu awaye yote asimtende mke wa ujana wake mambo ya hiana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.15",
            "verseOrgIds": [
              "MAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.1"
              },
              "items": [
                {
                  "text": "Kum 24:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana mimi nakuchukia kuachana, asema BWANA, Mungu wa Israeli; naye aifunikizaye nguo yake kwa udhalimu namchukia, asema BWANA wa majeshi; basi jihadharini roho zenu, msije mkatenda kwa hiana.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        }
      ]
    },
