          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmemchokesha BWANA kwa maneno yenu. Lakini ninyi mwasema, Tumemchokesha kwa maneno gani? Kwa kuwa mwasema, Kila atendaye mabaya ni mwema machoni pa BWANA, naye huwafurahia watu hao, au, Mungu mwenye haki yuko wapi?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
