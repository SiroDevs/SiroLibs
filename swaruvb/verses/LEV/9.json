                "loc": "LEV.4.8"
              },
              "items": [
                {
                  "text": "4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lakini mafuta, na figo, na kitambi kilichotoka katika ini ya hiyo sadaka ya dhambi, akaviteketeza juu ya madhabahu, kama BWANA alivyomwagiza Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
        {
