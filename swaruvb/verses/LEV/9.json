              "type": "tag",
              "attrs": {
                "loc": "LEV.4.7"
              },
              "items": [
                {
                  "text": "4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha wana wa Haruni wakamsogezea Haruni ile damu; naye akatia kidole chake katika damu, na kuitia katika pembe za madhabahu, kisha akaimwaga hiyo damu hapo chini ya madhabahu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 9:10"
          },
