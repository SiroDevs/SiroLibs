        },
        {
          "text": " na ng'ombe dume, na kondoo dume, kwa sadaka za amani, ili kuwachinja mbele za BWANA; na sadaka ya unga uliochanganywa na mafuta; kwa maana, BWANA hivi leo atawatokea. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        },
        {
