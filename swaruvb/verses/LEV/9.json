              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.16"
              },
              "items": [
                {
                  "text": "Law 8:16",
                  "type": "text"
                }
              ]
            },
