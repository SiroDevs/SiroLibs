              "items": [
                {
                  "text": "Eze 44:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyamafu au mnyama aliyeraruliwa na wanyama asile, asijitie unajisi kwa hiyo nyama; mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
