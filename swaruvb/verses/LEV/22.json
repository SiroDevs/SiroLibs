                "loc": "1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mgeni yeyote asile katika kitu kitakatifu; mgeni wa kuhani akaaye kwake, au mtumishi aliyeajiriwa, asile katika kitu kitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kuhani akinunua mtu yeyote kwa fedha zake, yeye atakula katika hicho; na hao waliozaliwa nyumbani mwake watakula katika chakula chake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na binti ya kuhani ikiwa ameolewa na mgeni, asile katika sadaka ya kuinuliwa katika vitu vile vitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
