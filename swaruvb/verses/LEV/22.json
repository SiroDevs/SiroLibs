              },
              "items": [
                {
                  "text": "Law 7:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waambie, Mtu yeyote wa kizazi chenu chote katika vizazi vyenu, atakayevikaribia vile vitu vitakatifu, ambavyo wana wa Israeli wamtakasia BWANA, naye ana unajisi, mtu huyo atatengwa asiwe mbele zangu; mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
