              },
              "items": [
                {
                  "text": "Hes 18:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala wasivinajisi vitu vitakatifu vya wana wa Israeli, wavisongezavyo kwa BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata wakawatwika ule uovu uletao hatia, hapo walapo vitu vyao vitakatifu; kwa kuwa mimi ndimi BWANA niwatakasaye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
