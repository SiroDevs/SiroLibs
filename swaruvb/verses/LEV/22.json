              "items": [
                {
                  "text": "Mwa 38:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.11"
              },
              "items": [
                {
                  "text": "Hes 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini ikiwa binti ya kuhani ni mjane, au ameachwa na mumewe, wala hana mtoto, kisha amerudi na kuishi katika nyumba ya baba yake, kama vile katika ujana wake, yeye atakula katika chakula cha baba yake; lakini mgeni yeyote asile katika chakula hicho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
