              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.22"
              },
              "items": [
                {
                  "text": "Hes 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi kwa hiyo watayashika maagizo yangu, wasije wakachukua dhambi kwa hayo, nao wakafa humo, wakiyanajisi; mimi ndimi BWANA niwatakasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
