              "items": [
                {
                  "text": "Hes 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jua likiisha kuchwa atakuwa safi; kisha baadaye atakula katika vitu vitakatifu, maana ni chakula chake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
