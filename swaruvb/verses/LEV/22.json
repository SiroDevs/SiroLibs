              },
              "items": [
                {
                  "text": "Ebr 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " huyo mtu atakayegusa kitu chochote namna hiyo atakuwa najisi hata jioni, naye hatakula katika vitu vitakatifu, asipooga mwili wake majini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
