                "loc": "LEV.5.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena kama mtu yeyote akila katika kitu kilicho kitakatifu pasipo kukijua, ndipo ataongeza sehemu ya tano juu ya kitu hicho, na kumpa kuhani kitu hicho kitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
