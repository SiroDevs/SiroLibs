        },
        {
          "text": " Naye atamchinja huyo ng'ombe mbele ya BWANA; kisha wana wa Haruni, hao makuhani, wataileta karibu hiyo damu, na kuinyunyiza damu yake kandokando katika madhabahu iliyo hapo mlangoni pa hema ya kukutania ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha atachuna sadaka ya kuteketeza na kuikata vipande vyake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
