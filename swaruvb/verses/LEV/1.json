              "items": [
                {
                  "text": "Mwa 22:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha wana wa Haruni, watatia moto juu ya madhabahu, na kuzipanga kuni juu ya moto, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha wana wa Haruni, makuhani, watazipanga kuni zilizo juu ya moto uliopo juu ya madhabahu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
