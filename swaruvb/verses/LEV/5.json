            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.4.35"
              },
              "items": [
                {
                  "text": "Law 4:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye atamletea kuhani, na kuhani atatwaa konzi yake ya huo unga kuwa ukumbusho wake, na kuuteketeza juu ya madhabahu, juu ya sadaka zilizosongezwa kwa BWANA kwa njia ya moto; ni sadaka ya dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na huyo kuhani atamfanyia upatanisho kwa ajili ya dhambi yake ambayo katika mambo hayo mojawapo amefanya dhambi, naye atasamehewa; na unga uliosalia utakuwa wa kuhani, kama hiyo sadaka ya unga ilivyokuwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
