                "loc": "EZK.44.17"
              },
              "items": [
                {
                  "text": "Eze 44:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye kuhani atavaa nguo yake ya kitani, na suruali zake za kitani atazivaa mwilini mwake; naye atayazoa majivu ambayo huo moto umeiteketezea sadaka juu ya madhabahu, kisha atayaweka kando ya madhabahu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
