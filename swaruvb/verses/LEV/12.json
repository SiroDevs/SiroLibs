          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na huyo mwanamke atakaa muda wa siku thelathini na tatu ili kutakata damu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
