          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama amezaa mtoto wa kike naye atakaa muda wa siku sitini na sita ili kutakata damu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
