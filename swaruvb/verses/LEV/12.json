        {
          "text": " Siku ya nane mtoto atatahiriwa govi ya zunga lake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
