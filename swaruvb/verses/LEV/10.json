              "items": [
                {
                  "text": "2 Sam 24:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Musa akamwambia Haruni na wanawe Eleazari na Ithamari, Msiache wazi nywele za vichwani mwenu, wala msiyararue mavazi yenu; ili kwamba msife, tena asiukasirikie mkutano wote; lakini ndugu zenu, nyumba yote ya Israeli, na waomboleze kwa ajili ya waliochomwa na moto wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.6",
            "verseOrgIds": [
              "LEV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
