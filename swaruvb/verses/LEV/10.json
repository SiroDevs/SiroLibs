              "items": [
                {
                  "text": "2 Sam 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha moto ukatoka hapo mbele za BWANA, na ukawateketeza, nao wakafa mbele za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.2",
            "verseOrgIds": [
              "LEV.10.2"
            ]
          }
        },
