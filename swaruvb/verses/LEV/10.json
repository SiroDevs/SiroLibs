              "items": [
                {
                  "text": "Kut 28:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala hamtatoka nje mlangoni mwa hema ya kukutania, msije mkafa; kwa sababu mafuta ya kutiwa ya BWANA yako juu yenu. Nao wakafanya kama hilo neno la Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
