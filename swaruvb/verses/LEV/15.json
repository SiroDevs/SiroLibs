              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kila nguo au ngozi, ambayo ina shahawa, itafuliwa kwa maji, nayo itakuwa najisi hata jioni. ",
          "type": "text",
          "attrs": {
