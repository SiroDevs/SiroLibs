          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku ya nane atajipatia hua wawili, au makinda mawili ya njiwa, na kumletea kuhani, mlangoni pa hema ya kukutania. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
