        },
        {
          "text": " Na mtu yeyote akitokwa na shahawa yake, ndipo ataoga mwili wake wote majini, naye atakuwa najisi hadi jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
