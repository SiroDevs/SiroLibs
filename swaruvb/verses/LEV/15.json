                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwanamke yeyote aliye na hedhi, atatengwa kwa muda wa siku saba; na mtu yeyote atakayemgusa atakuwa najisi hadi jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
            "verseOrgIds": [
              "LEV.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kitu chochote ambacho anakalia katika kutengwa kwake kitakuwa najisi; na kila kitu ambacho amekalia kitakuwa najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu yeyote atakayekigusa kitanda chake huyo mwanamke atazifua nguo zake, na kuoga majini, naye atakuwa najisi hadi jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
              "LEV.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.1"
              },
              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.22"
              },
              "items": [
                {
                  "text": "Ebr 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtu yeyote atakayekigusa chochote ambacho huyo mwanamke amekalia atazifua nguo zake, na kuoga majini, naye atakuwa najisi hadi jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwe ni katika kitanda, au chochote alichokikalia huyo mwanamke, atakapokigusa kitu hicho, atakuwa najisi hadi jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.18"
              },
              "items": [
                {
                  "text": "Law 20:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mtu yeyote atakayelala na mwanamke na unajisi ukawa juu yake, atakuwa najisi muda wa siku saba; na kila kitanda alichokilalia kitakuwa najisi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
