              "items": [
                {
                  "text": "1 Kor 15:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mtu yeyote atakayeguswa na mwenye kisonono, ambaye hajanawa mikono yake majini, atazifua nguo zake, na kuoga majini, naye atakuwa najisi hadi jioni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.11",
            "verseOrgIds": [
              "LEV.15.11"
            ]
          }
        },
