                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na chombo cha udongo ambacho amekigusa mwenye kisonono, kitavunjwavunjwa; na kila chombo cha mti kitaoshwa majini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
