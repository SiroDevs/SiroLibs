                "loc": "EZK.12.23+EZK.12.24+EZK.12.25"
              },
              "items": [
                {
                  "text": "Eze 12:23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ajali yako imekujia, wewe ukaaye katika nchi hii; majira yamewadia, siku ile inakaribia; siku ya fujo, wala si ya shangwe milimani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.7",
            "verseOrgIds": [
              "EZK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
