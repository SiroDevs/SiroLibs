          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana MUNGU asema hivi; Ni jambo baya, jambo baya la namna ya peke yake; angalia, linakuja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.5",
            "verseOrgIds": [
              "EZK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisho umekuja, mwisho huu umekuja; unaamka ukupate; angalia, unakuja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.6",
            "verseOrgIds": [
              "EZK.7.6"
            ]
          }
        },
