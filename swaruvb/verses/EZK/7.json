              "items": [
                {
                  "text": "Mt 24:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wewe, mwanadamu, Bwana MUNGU aiambia hivi nchi ya Israeli; Ni mwisho; mwisho umezijia pembe nne za nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa mwisho huu unakupata, nami nitakuletea hasira yangu, nitakuhukumu kulingana na njia zako; nami nitakupatiliza machukizo yako yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.11"
              },
              "items": [
                {
                  "text": "Eze 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jicho langu halitakuachilia, wala sitaona huruma; bali nitakupatiliza njia zako, na machukizo yako yatakuwa katikati yako; nanyi mtajua ya kuwa mimi ndimi BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        }
      ]
