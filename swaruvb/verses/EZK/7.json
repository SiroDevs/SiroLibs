                "loc": "ISA.13.7"
              },
              "items": [
                {
                  "text": "Isa 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mikono yote itakuwa dhaifu, na magoti yote yatalegea kama maji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.17",
            "verseOrgIds": [
              "EZK.7.17"
            ]
          }
        },
        {
          "name": "verse",
