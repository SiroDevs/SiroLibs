              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitapatia katika mikono ya wageni pawe mateka yao, na katika mikono ya waovu wa duniani pawe mawindo yao, nao watapanajisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.21",
            "verseOrgIds": [
              "EZK.7.21"
            ]
          }
        }
