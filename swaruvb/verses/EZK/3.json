                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo roho ikaniinua, nami nikasikia nyuma yangu sauti kama mshindo wa radi kuu, ikisema, Na uhimidiwe utukufu wa BWANA tokea mahali pake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikasikia mshindo wa mabawa ya vile viumbe hai, walipogusana, na mshindo wa yale magurudumu kando yao, mshindo wa radi kuu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
