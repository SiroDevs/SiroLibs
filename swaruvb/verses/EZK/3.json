                "loc": "REV.10.9+REV.10.10"
              },
              "items": [
                {
                  "text": "Ufu 10:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaniambia, Mwanadamu, kula uonacho; kula gombo hili, kisha nenda ukaseme na wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikafunua kinywa changu, naye akanilisha lile gombo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaniambia, Mwanadamu, lisha tumbo lako, ulijaze tumbo lako kwa hili gombo nikupalo. Ndipo nikalila, nalo kinywani mwangu lilikuwa tamu, kama utamu wa asali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaniambia, Mwanadamu, haya! Waendee wana wa Israeli ukawaambie maneno yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana wewe hukutumwa kwa watu wa lugha isiyoeleweka, ama wa lugha ngumu, bali kwa nyumba ya Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kwa watu wa kabila nyingi wenye usemi usioeleweka, na lugha ngumu, ambao huwezi kufahamu maneno yao. Bila shaka, kama ningekutuma kwa watu hao, wangekusikiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.20"
              },
              "items": [
                {
                  "text": "Yn 15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali nyumba ya Israeli hawatakusikiliza wewe; kwa kuwa hawanisikilizi mimi; maana nyumba yote ya Israeli wana vipaji vigumu, na mioyo yenye ukaidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, nimeufanya uso wako kuwa mgumu juu ya nyuso zao, na kipaji cha uso chako kuwa kigumu juu ya vipaji vya nyuso zao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.18"
              },
              "items": [
                {
                  "text": "Yer 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kama almasi ilivyo ngumu kuliko gumegume, ndivyo nilivyokifanya kipaji chako; usiwaogope, wala usifadhaike kwa sababu ya nyuso zao, wajapokuwa ni nyumba ya kuasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akaniambia, Mwanadamu, maneno yangu yote nitakayokuambia, yapokee moyoni mwako, na kuyasikia kwa masikio yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya! Nenda uwafikie watu hao waliohamishwa, kwa wana wa watu wako, ukaseme nao, na kuwaambia, Bwana MUNGU asema hivi; iwe watasikia au hawataki kusikia.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezekieli akiwa mto Kebari",
          "type": "text"
        }
