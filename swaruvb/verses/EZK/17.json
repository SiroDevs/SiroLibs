            "number": "2",
            "style": "v",
            "sid": "EZK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanadamu, tega kitendawili, ukawaambie nyumba ya Israeli mithali; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.2",
            "verseOrgIds": [
              "EZK.17.2"
            ]
