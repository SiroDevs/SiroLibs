                "loc": "PRO.17.5"
              },
              "items": [
                {
                  "text": "Mit 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uwaambie hao wana wa Amoni, Lisikieni neno la Bwana MUNGU; Bwana MUNGU asema hivi; Kwa sababu umesema, Aha! Juu ya patakatifu pangu, palipotiwa unajisi; na juu ya nchi ya Israeli, ilipoharibiwa; na juu ya nyumba ya Israeli, walipokwenda kifungoni; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.18"
              },
              "items": [
                {
                  "text": "Mwa 45:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " basi, kwa sababu hiyo, nitakutia katika mikono ya wana wa mashariki uwe milki yao, nao watajenga kambi yao ndani yako, kufanya maskani zao ndani yako; watakula matunda yako, na kunywa maziwa yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
