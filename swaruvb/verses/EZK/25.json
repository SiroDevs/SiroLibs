        },
        {
          "text": " Bwana MUNGU asema hivi; Kwa sababu Moabu na Seiri husema, Tazama, nyumba ya Israeli ni sawasawa na mataifa yote; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi, tazama, nitawafunulia wana wa mashariki ubavu wa Moabu toka miji yake, toka miji yake iliyo mipakani mwake, utukufu wa nchi hiyo, Beth-yeshimothi, na Baal-meoni, na Kiriathaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamoja na wana wa Amoni, nami nitawatoa kuwa milki, ili wana wa Amoni wasikumbukwe kati ya mataifa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitatoa hukumu juu ya Moabu; nao watajua ya kuwa mimi ndimi BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
