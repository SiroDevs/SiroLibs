                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwanadamu, uwaelekezee wana wa Amoni uso wako, ukatabiri juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 25:3"
          },
          "items": [
            {
