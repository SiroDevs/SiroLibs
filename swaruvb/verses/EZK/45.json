                  "text": "Eze 48:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena, mtakapoigawanya nchi kwa kura iwe urithi, mtamtolea BWANA toleo, sehemu takatifu ya nchi, urefu wake utakuwa urefu wa mianzi elfu ishirini na tano, na upana wake elfu kumi; itakuwa takatifu ndani ya mipaka yake yote pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.42.20"
              },
              "items": [
                {
                  "text": "Eze 42:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika hiyo itakuwako sehemu kwa mahali patakatifu, urefu wake mia tano, na upana wake mia tano, mraba pande zote; na dhiraa ishirini kwa viunga vyake pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa kipimo hicho utapima, urefu wa elfu ishirini na tano, na upana wa elfu kumi; na ndani yake patakuwa patakatifu, palipo patakatifu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.15"
              },
              "items": [
                {
                  "text": "Eze 44:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hiyo ni sehemu takatifu ya nchi; itakuwa ya makuhani, wahudumu wa patakatifu, wakaribiao kumhudumia BWANA; nayo itakuwa mahali kwa nyumba zao, na patakatifu kwa mahali patakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.13"
