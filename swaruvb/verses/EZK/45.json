            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.25"
              },
              "items": [
                {
                  "text": "Law 27:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo shekeli itakuwa gera ishirini; shekeli tano zitakuwa shekeli tano, shekeli kumi zitakuwa kumi, na shekeli hamsini zitakuwa mane yenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
