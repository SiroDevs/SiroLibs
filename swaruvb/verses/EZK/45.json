              "items": [
                {
                  "text": "Law 19:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtakuwa na mizani ya haki, na efa ya haki, na bathi ya haki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efa na bathi zitakuwa za kipimo kimoja; ili kwamba bathi ichukue sehemu ya kumi ya homeri, na efa sehemu ya kumi ya homeri; kipimo chake kitakuwa kwa kadiri ya cheo cha kawaida cha homeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
