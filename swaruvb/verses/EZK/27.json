        },
        {
          "text": " Merikebu za Tarshishi zilikuwa misafara yako, kwa bidhaa yako; nawe ulijazwa sana, ukawa mtukufu sana, katika moyo wa bahari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
