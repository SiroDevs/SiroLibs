        },
        {
          "text": " Harani, na Kane, na Adini, wachuuzi wa Sheba, na Ashuru, na Kilmadi, walikuwa wachuuzi wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
