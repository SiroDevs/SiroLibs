              },
              "items": [
                {
                  "text": "Eze 26:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wote wakaao katika visiwa vile watakustaajabia, na wafalme wao wameogopa sana, wamefadhaika nyuso zao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.35",
            "verseOrgIds": [
              "EZK.27.35"
            ]
          }
        },
