              },
              "items": [
                {
                  "text": "Eze 26:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wewe, mwanadamu, mfanyie Tiro maombolezo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
