              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Eze 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.3"
              },
              "items": [
                {
                  "text": "Isa 23:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " umwambie Tiro, Ewe ukaaye penye maingilio ya bahari, uliye mchuuzi wa watu wa kabila nyingi, mpaka visiwa vingi, Bwana MUNGU asema hivi; Wewe, Tiro, umesema, Mimi ni ukamilifu wa uzuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mipaka yako i kati ya moyo wa bahari; wajenzi wako wameukamilisha uzuri wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.4",
            "verseOrgIds": [
              "EZK.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.9"
              },
              "items": [
                {
                  "text": "Kum 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbao zako zote wamezifanya kwa misonobari itokayo Seniri; wametwaa mierezi ya Lebanoni ili kukufanyia mlingoti; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.10"
              },
              "items": [
                {
                  "text": "Yer 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kwa mialoni ya Bashani wamefanya makasia yako; na sitaha zako wamezifanya kwa pembe iliyotiwa kazi ya njumu katika mti wa mihugu itokayo Kitimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.4"
              },
              "items": [
                {
                  "text": "Mwa 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tanga lako lilikuwa la kitani safi itokayo Misri, iliyotiwa taraza, ili iwe bendera kwako; na chandarua chako kilikuwa cha rangi ya samawati na urujuani toka visiwa vya Elisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaao Sidoni na Arvadi ndio waliovuta makasia yako; wana wako wenye akili, Ee Tiro, walikuwa ndani yako, ndio waliokuwa rubani zako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.8",
            "verseOrgIds": [
              "EZK.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.5"
              },
              "items": [
                {
                  "text": "Yos 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wazee wa Gebali na wenye akili wake walikuwa ndani yako, wenye kutia kalafati; merikebu zote za bahari na mabaharia wao walikuwa ndani yako, ili kubadiliana biashara yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.9"
              },
              "items": [
                {
                  "text": "Yer 46:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.5"
              },
              "items": [
                {
                  "text": "Eze 30:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watu wa Uajemi na Ludi na Putu walikuwa katika jeshi lako, watu wako wa vita; walitungika ngao na chapeo ndani yako; wakadhihirisha uzuri wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa Arvadi, pamoja na jeshi lako, walikuwa juu ya kuta zako pande zote, na Wagamadi walikuwa ndani ya minara yako; walitungika ngao zao juu ya kuta zako pande zote; wakaukamilisha uzuri wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.36"
              },
              "items": [
                {
                  "text": "2 Nya 20:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tarshishi alikuwa mfanya biashara kwako, kwa sababu ya wingi wa utajiri wa kila aina; kwa fedha, na chuma, na bati, na risasi, walifanya biashara, wapate vitu vyako vilivyouzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.5"
              },
              "items": [
                {
                  "text": "1 Nya 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.6"
              },
              "items": [
                {
                  "text": "Yoe 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ugiriki na Tubali na Mesheki ndio waliokuwa wachuuzi wako; walitoa wanadamu, na vyombo vya shaba, kwa biashara yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.3"
              },
              "items": [
                {
                  "text": "Mwa 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.6"
              },
              "items": [
                {
                  "text": "1 Nya 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watu wa nyumba ya Togarma walifanya biashara, kwa farasi, naam, farasi wa vita, na nyumbu, wapate vitu vyako vilivyouzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.7"
              },
              "items": [
                {
                  "text": "Mwa 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.9"
              },
              "items": [
                {
                  "text": "1 Nya 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wadedani walikuwa wachuuzi wako, visiwa vingi vilikuwa soko la mkono wako; walikuletea pembe, na mpingo, ili kuvibadili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamu alikuwa mfanya biashara kwako, kwa sababu ya wingi wa kazi za mkono wako walifanya biashara kwa zumaridi, urujuani, kazi ya taraza, kitani safi, marijani na akiki, wapate vitu vyako vilivyouzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.9"
              },
              "items": [
                {
                  "text": "1 Fal 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.20"
              },
              "items": [
                {
                  "text": "Mdo 12:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda, na nchi ya Israeli, walikuwa wachuuzi wako; walitoa badala ya bidhaa yako ngano ya Minithi, na mtama, na asali, na mafuta, na zeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dameski alikuwa mfanya biashara kwako, kwa habari ya wingi wa kazi za mkono wako, kwa ajili ya wingi wa aina zote za utajiri; akaleta divai ya Helboni, na sufu nyeupe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wedani, na Yavani, walifanya biashara toka Uzali kwa vitu vyako; chuma kilichofuliwa, na mdalasini, na mchai, vilikuwa katika bidhaa yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.3"
              },
              "items": [
                {
                  "text": "Mwa 25:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dedani alikuwa mchuuzi wako, kwa nguo za thamani za kutandikia farasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.13"
              },
              "items": [
                {
                  "text": "Mwa 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.29"
              },
              "items": [
                {
                  "text": "1 Nya 1:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Arabuni, na wakuu wote wa Kedari, ndio waliokuwa wafanya biashara wa mkono wako; kwa wana-kondoo, na kondoo dume, na mbuzi; kwa hao walifanya biashara nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
