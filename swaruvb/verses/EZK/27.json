              "items": [
                {
                  "text": "Ufu 18:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wote wavutao kasia, wanamaji, na rubani zote wa baharini, watashuka katika merikebu zao, na kusimama katika nchi kavu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
