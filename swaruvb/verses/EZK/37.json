          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi mtajua ya kuwa mimi ndimi BWANA, nitakapoyafunua makaburi yenu, na kuwatoa ninyi katika makaburi yenu, enyi watu wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
