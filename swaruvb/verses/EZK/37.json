            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.17"
              },
              "items": [
                {
                  "text": "Rum 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaniambia tena, Toa unabii juu ya mifupa hii, uiambie, Enyi mifupa mikavu, lisikieni neno la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.30"
              },
              "items": [
                {
                  "text": "Zab 104:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwana MUNGU aiambia mifupa hii maneno haya; Tazama, nitatia pumzi ndani yenu, nanyi mtaishi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
