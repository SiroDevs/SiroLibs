                "loc": "EZK.36.27"
              },
              "items": [
                {
                  "text": "Eze 36:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitatia roho yangu ndani yenu, nanyi mtaishi, nami nitawawekeni katika nchi yenu, nanyi mtajua ya kuwa mimi, BWANA, nimesema hayo, na kuyatimiza, asema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
