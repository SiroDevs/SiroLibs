                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wewe mwanadamu, twaa kijiti kimoja; ukaandike juu yake, Kwa Yuda, na kwa wana wa Israeli wenzake; kisha, twaa kijiti cha pili; ukaandike juu yake, Kwa Yusufu, kijiti cha Efraimu, na kwa nyumba yote ya Israeli wenzake; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
