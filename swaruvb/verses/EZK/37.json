              "items": [
                {
                  "text": "Isa 49:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha akaniambia, Mwanadamu, mifupa hii ni nyumba yote ya Israeli; tazama, wao husema, Mifupa yetu imekauka, matumaini yetu yametupotea; tumekatiliwa mbali kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.11",
            "verseOrgIds": [
              "EZK.37.11"
            ]
          }
        },
        {
