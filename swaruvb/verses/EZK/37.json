                "loc": "2CO.1.9"
              },
              "items": [
                {
                  "text": "2 Kor 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaniambia, Mwanadamu, je! Mifupa hii yaweza kuishi? Nami nikajibu, Ee Bwana MUNGU, wajua wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.11"
              },
              "items": [
                {
                  "text": "Isa 55:11",
