          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukaviunge pamoja kwa ajili yako hiki na hiki viwe kijiti kimoja, viwe kimoja katika mkono wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.17",
            "verseOrgIds": [
