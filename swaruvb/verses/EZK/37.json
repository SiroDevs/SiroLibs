          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanipitisha karibu nayo pande zote; na tazama, palikuwa na mifupa mingi katika ule uwanda! Nayo, tazama, ilikuwa mikavu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
