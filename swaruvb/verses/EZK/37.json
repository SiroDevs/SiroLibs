              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "Eze 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.27"
              },
              "items": [
                {
                  "text": "Yoe 2:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitatia mishipa juu yenu, nami nitaleta nyama iwe juu yenu, na kuwafunika ngozi, na kutia pumzi ndani yenu, nanyi mtaishi; nanyi mtajua ya kuwa mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikatoa unabii kama nilivyoamriwa; hata nilipokuwa nikitoa unabii, palikuwa na mshindo mkuu; na tazama, tetemeko la nchi, na ile mifupa ikasogeleana, mfupa kwa mfupa mwenziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.7",
            "verseOrgIds": [
              "EZK.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikatazama, kumbe! Kulikuwa na mishipa juu yake, nyama ikatokea juu yake, ngozi ikaifunika juu yake; lakini haikuwemo pumzi ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.8",
            "verseOrgIds": [
              "EZK.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akaniambia, Tabiri, utabirie upepo, mwanadamu, ukauambie upepo, Bwana MUNGU asema hivi; Njoo, kutoka pande za pepo nne, Ee pumzi, ukawapulizie hawa waliouawa, wapate kuishi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.11"
              },
              "items": [
                {
                  "text": "Ufu 11:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi nikatabiri kama alivyoniamuru; pumzi ikawaingia, wakaishi, wakasimama kwa miguu yao, jeshi kubwa mno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.10",
            "verseOrgIds": [
              "EZK.37.10"
            ]
          }
        },
        {
