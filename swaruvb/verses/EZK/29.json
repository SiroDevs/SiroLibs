        },
        {
          "text": " Na watu wote wakaao Misri watajua ya kuwa mimi ndimi BWANA, kwa sababu wamekuwa mwanzi wa kutegemewa kwa nyumba ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "verse",
