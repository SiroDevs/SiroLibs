              "items": [
                {
                  "text": "Yer 37:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walipokushika kwa mkono wako, ulivunjika, ukawararua mabega yao yote; nao walipokutegemea, ulivunjika, ukawatetemesha viuno vyao vyote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.7",
            "verseOrgIds": [
              "EZK.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, Bwana MUNGU asema hivi; Tazama, nitaleta upanga juu yako, nami nitakatilia mbali nawe wanadamu na wanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
