                  "text": "Eze 30:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, tazama, mimi ni juu yako, na juu ya mito yako, nami nitaifanya nchi ya Misri kuwa jangwa tupu, na ukiwa, toka Migdoli hata Sewene, hata mpaka wa Kushi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
