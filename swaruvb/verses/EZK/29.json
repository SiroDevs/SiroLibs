                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hautapita kati yake mguu wa mwanadamu, wala hautapita kati yake mguu wa mnyama, wala haitakaliwa na watu, muda wa miaka arubaini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
