            }
          ]
        },
        {
          "text": " Nami nitatia kulabu katika taya zako, nami nitawashikamanisha samaki wa mito yako na magamba yako; nami nitakutoa katika mito yako, pamoja na samaki wa mito yako walioshikamana na magamba yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        },
