              "items": [
                {
                  "text": "Eze 1:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo nikaangalia, na tazama, palikuwa na kitu kilichofanana na mwanadamu;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:2",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni moto.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuanzia kilichoonekana kama viuno vyake kwenda chini ilikuwa moto; na kuanzia kilichoonekana kama viuno vyake kwenda juu, ilikuwa mfano wa mwangaza, kama rangi ya kaharabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
