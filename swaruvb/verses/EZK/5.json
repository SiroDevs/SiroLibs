              "items": [
                {
                  "text": "Yer 40:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe twaa nywele chache katika hizo, na kuzifunga katika upindo wa mavazi yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.3",
            "verseOrgIds": [
              "EZK.5.3"
            ]
          }
        },
