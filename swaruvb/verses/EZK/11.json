          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmewaongeza watu wenu waliouawa ndani ya mji wenu, nanyi mmezijaza njia kuu zake waliouawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.6",
            "verseOrgIds": [
              "EZK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
