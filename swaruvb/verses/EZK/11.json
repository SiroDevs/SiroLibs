              "type": "text"
            }
          ]
        },
        {
          "text": "Akaniambia, Mwanadamu, hawa ndio watu wale watungao uovu, na kutoa mashauri mabaya ndani ya mji huu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.2",
            "verseOrgIds": [
