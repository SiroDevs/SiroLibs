                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitawatoa ninyi nje kutoka katikati yake, na kuwatia katika mikono ya wageni, nami nitafanya hukumu kati yenu. ",
          "type": "text",
          "attrs": {
