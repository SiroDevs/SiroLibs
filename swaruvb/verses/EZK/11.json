                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtaanguka kwa upanga; nitawahukumu katika mpaka wa Israeli; nanyi mtajua ya kuwa mimi ndimi BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
