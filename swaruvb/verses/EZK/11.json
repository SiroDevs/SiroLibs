          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanadamu, ndugu zako, naam, ndugu zako, watu wa jamaa zako, na nyumba yote ya Israeli, wote pia, ndio hao ambao wenyeji wa Yerusalemu wamewaambia, Jitengeni mbali na BWANA, nchi hii tumepewa sisi, iwe milki yetu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.15",
            "verseOrgIds": [
              "EZK.11.15"
            ]
          }
        },
