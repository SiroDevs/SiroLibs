                  "text": "Mik 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Bwana MUNGU asema hivi; Watu wenu waliouawa, ambao mmewalaza katikati yake, hao ndio nyama hiyo, na mji huu ndio sufuria; lakini ninyi mtatolewa nje kutoka katikati yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.7",
            "verseOrgIds": [
              "EZK.11.7"
            ]
