            }
          ]
        },
        {
          "text": " basi nena, Bwana MUNGU asema hivi, Ikiwa mimi nimewahamisha, wakae katika mataifa, na ikiwa mimi nimewatawanya katika nchi kadha wa kadha, pamoja na hayo nitakuwa patakatifu kwao kwa muda mchache, katika nchi zile walizozifika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.16",
            "verseOrgIds": [
              "EZK.11.16"
            ]
          }
        },
