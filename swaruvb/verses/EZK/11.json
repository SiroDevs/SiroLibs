                  "text": "Mit 10:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ninyi mmeuogopa upanga; nami nitauleta upanga juu yenu, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.8",
            "verseOrgIds": [
              "EZK.11.8"
            ]
