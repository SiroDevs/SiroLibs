                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wasemao, Wakati wa kujenga nyumba hauko karibu; mji huu ni sufuria na sisi ni nyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.3",
            "verseOrgIds": [
              "EZK.11.3"
            ]
