                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mesheki yuko huko, na Tubali, na watu wake umati wote; makaburi yake yamzunguka; wote pia hawakutahiriwa, wameuawa kwa upanga; maana walitisha katika nchi ya walio hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
