                  "text": "26:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitawashangaza watu wa kabila nyingi kwa habari zako, na wafalme wao wataogopa sana kwa ajili yako, nitakapoutikisa upanga wangu mbele yao; nao watatetemeka kila dakika, kila mtu kwa ajili ya uhai wake, katika siku ya kuanguka kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        },
