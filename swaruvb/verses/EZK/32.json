          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuru yuko huko, na watu wake umati wote; makaburi yake yamzunguka; wote pia wameuawa, wameanguka kwa upanga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.22",
            "verseOrgIds": [
              "EZK.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
