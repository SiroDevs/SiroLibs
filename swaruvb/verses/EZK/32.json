              "items": [
                {
                  "text": "Isa 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ambao makaburi yao yamewekwa pande za shimo zilizo mbali sana, umati wote wamezunguka kaburi lake; wote pia wameuawa, wameanguka kwa upanga, waliotisha katika nchi yao walio hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        },
        {
