              "items": [
                {
                  "text": "Isa 14:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je! Wasilale pamoja na mashujaa wao wasiotahiriwa, walioanguka, walioshuka kuzimu pamoja na silaha zao za vita, ambao wameweka panga zao chini ya vichwa vyao, na maovu yao mifupani mwao? Maana waliwatisha mashujaa katika nchi ya walio hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini utavunjika kati ya hao wasiotahiriwa, nawe utalala pamoja nao waliouawa kwa upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
