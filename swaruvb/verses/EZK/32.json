              },
              "items": [
                {
                  "text": "Eze 31:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitaweka nyama yako juu ya milima, na kuyajaza mabonde kwa urefu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
