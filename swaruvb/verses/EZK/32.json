                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwana MUNGU asema hivi; Nitautanda wavu wangu juu yako, kwa kusanyiko la watu wa kabila nyingi; nao watakuvua katika jarife langu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
