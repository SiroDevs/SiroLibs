              "items": [
                {
                  "text": "29:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa panga za mashujaa nitawaangusha watu wako umati wote; hao wote ni watu wa mataifa watishao, nao watakiharibu kiburi cha Misri, na jamii ya watu wake wengi wataangamia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
