          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nitakapoyafanya maji yao kuwa safi, na kuiendesha mito yao kama mafuta, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
