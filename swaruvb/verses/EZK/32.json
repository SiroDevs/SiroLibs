                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena nitawaangaza mifugo wake wote, toka kando ya maji mengi; na mguu wa mwanadamu hautayatibua tena, wala kwato za mnyama hazitayatibua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
