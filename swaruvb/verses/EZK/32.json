              "items": [
                {
                  "text": "Eze 25:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Edomu yuko huko, wafalme wake, na wakuu wake wote, ambao katika uwezo wao wamelazwa pamoja nao waliouawa kwa upanga; watalala pamoja na hao wasiotahiriwa, na pamoja na hao washukao shimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
