        },
        {
          "text": " Nami nitakuacha juu ya nchi kavu, nitakutupa juu ya uso wa uwanda, nami nitawaleta ndege wote wa angani watue juu yako, nami nitawashibisha wanyama wa dunia yote kwako wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
