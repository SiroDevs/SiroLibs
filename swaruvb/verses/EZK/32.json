                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana Bwana MUNGU asema hivi; Upanga wa mfalme wa Babeli utakujia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
