              },
              "items": [
                {
                  "text": "28:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umemshinda nani kwa uzuri? Shuka, ukalazwe pamoja na wasiotahiriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
