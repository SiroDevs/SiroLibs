            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wataanguka kati ya watu waliouawa kwa upanga; ametolewa apigwe na upanga; mvuteni aende mbali pamoja na watu wake wote jamii. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
