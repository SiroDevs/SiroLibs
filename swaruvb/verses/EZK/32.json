            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena kwa damu yako nitainywesha nchi, ambayo waogelea juu yake, hata milimani; na mifereji ya maji itajawa nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        },
