              "items": [
                {
                  "text": "Eze 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Farao atawaona, naye atapata faraja juu ya watu wake umati wote; naam, Farao, jeshi lake lote waliouawa kwa upanga, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana nimeweka utisho wake katika nchi ya walio hai; naye atalazwa kati yao wasiotahiriwa, pamoja na hao waliouawa kwa upanga; yeye Farao na watu wake wote jamii, asema Bwana MUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
