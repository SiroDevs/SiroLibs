          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.10"
              },
              "items": [
                {
                  "text": "Eze 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitawatawanya kwa pepo zote wote wamzungukao ili wamsaidie, na vikosi vyake vyote; nami nitaufuta upanga nyuma yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 12:15"
          },
          "items": [
