                "loc": "ISA.6.9+ISA.6.10"
              },
              "items": [
                {
                  "text": "Isa 6:9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.21"
              },
              "items": [
                {
                  "text": "Yer 5:21",
