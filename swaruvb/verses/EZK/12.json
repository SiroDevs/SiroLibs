                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.18"
              },
              "items": [
                {
                  "text": "Mk 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwanadamu, wewe unakaa kati ya nyumba iliyoasi, watu ambao wana macho ya kuona, ila hawaoni, wana masikio ya kusikia, ila hawasikii; kwa maana ni nyumba iliyoasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.2",
            "verseOrgIds": [
              "EZK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mwanadamu, funga tayari vyombo kwa uhamisho, ukahame wakati wa mchana mbele ya macho yao; nawe utahama toka mahali pako hapa mpaka mahali pengine mbele ya macho yao; labda watafahamu, wajapokuwa ni nyumba iliyoasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.3",
            "verseOrgIds": [
              "EZK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe utatoa vyombo vyako, wakati wa mchana, mbele ya macho yao, kana kwamba ni vyombo vya kuhamishwa; nawe mwenyewe utatoka, wakati wa jioni, mbele ya macho yao, kama watu watokavyo katika kuhamishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.4",
            "verseOrgIds": [
              "EZK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboa mahali ukutani mbele ya macho yao, ukachukue vitu kwa kuvipitisha pale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.5",
            "verseOrgIds": [
              "EZK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.18"
              },
              "items": [
                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.3"
              },
              "items": [
                {
                  "text": "Eze 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbele ya macho yao utajitwika begani pako, na kuvichukua nje gizani; utafunika uso wako, hata usiione nchi; kwa maana nimekuweka uwe ishara kwa nyumba ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikafanya vile vile kama nilivyoamriwa; nilitoa vyombo vyangu wakati wa mchana kana kwamba ni vyombo vya kuhamishwa, na wakati wa jioni nikautoboa ukuta kwa mkono wangu; nikavitoa gizani, nikavichukua begani, mbele ya macho yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubuhi neno la BWANA likanijia, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.19"
              },
              "items": [
                {
                  "text": "Eze 24:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwanadamu, nyumba ya Israeli, je! Nyumba ile iliyoasi, hawakukuambia, Unafanya nini wewe? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.9",
            "verseOrgIds": [
              "EZK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.1"
              },
              "items": [
                {
                  "text": "Mal 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waambie, Bwana MUNGU asema hivi; Ufunuo huu wamhusu mkuu wa Yerusalemu, na nyumba yote ya Israeli walio kati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sema, Mimi ni ishara kwenu; kama mimi nilivyotenda, wao nao watatendwa vile vile; watahamishwa, watakwenda kufungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.4"
              },
              "items": [
                {
                  "text": "Yer 39:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye mkuu aliye kati yao atachukua begani katika giza; naye atatoka kwenda zake; watatoboa mahali ukutani, wapate kuvichukua vyombo vyao nje; atafunika uso wake, kwa sababu hataiona nchi kwa macho yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.12",
            "verseOrgIds": [
              "EZK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 12:13"
