              "type": "text"
            }
          ]
        },
        {
          "text": "Neno la BWANA likanijia tena, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
