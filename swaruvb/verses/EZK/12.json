              "items": [
                {
                  "text": "Isa 26:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao watajua ya kuwa mimi ndimi BWANA; nitakapowatawanya kati ya mataifa, na kuwatapanya katika nchi zote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
