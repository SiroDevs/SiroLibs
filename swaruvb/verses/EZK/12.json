            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.8"
              },
              "items": [
                {
                  "text": "Eze 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini nitawasaza watu wachache miongoni mwao na kuwaokoa na upanga, na njaa, na tauni ili watangaze habari ya machukizo yao yote, kati ya mataifa huko waendako; nao watajua ya kuwa mimi ndimi BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
      ]
