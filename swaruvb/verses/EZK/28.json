          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa hekima yako na kwa fahamu zako umejipatia utajiri, nawe umepata dhahabu na fedha katika hazina zako; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        },
