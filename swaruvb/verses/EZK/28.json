        },
        {
          "text": " basi, tazama, nitaleta wageni juu yako, watu wa mataifa wenye kutisha; nao watafuta panga zao juu ya uzuri wa hekima yako, nao watautia uchafu mwangaza wako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        },
        {
          "name": "verse",
