                }
              ]
            }
          ]
        },
        {
          "text": " Mwanadamu, umfanyie maombolezo mfalme wa Tiro, umwambie, Bwana MUNGU asema hivi; Wewe wakitia mhuri kipimo, umejaa hekima, na ukamilifu wa uzuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
