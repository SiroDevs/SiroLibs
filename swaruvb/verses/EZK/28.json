          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.18"
              },
              "items": [
                {
                  "text": "Eze 31:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Utakufa kifo cha hao wasiotahiriwa, kwa mikono ya wageni; kwa maana mimi nimenena neno hili, asema Bwana MUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
