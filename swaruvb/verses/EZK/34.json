          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa mmesukuma kwa ubavu, na kwa mabega, na kuwapiga wenye maradhi kwa pembe zenu, hata mkawatawanyia mbali; ",
          "type": "text",
          "attrs": {
