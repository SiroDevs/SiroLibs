        {
          "text": " Nao wakatawanyika, kwa sababu hapakuwa na mchungaji; wakawa chakula cha wanyamamwitu, wakatawanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.5",
            "verseOrgIds": [
