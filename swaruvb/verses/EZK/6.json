        },
        {
          "text": " Na hao wa kwenu watakaookoka watanikumbuka kati ya mataifa, watakakochukuliwa mateka, jinsi nilivyoiponda mioyo yao ya kikahaba, iliyoniacha, na macho yao, yaendayo kufanya uasherati na vinyago vyao; nao watajichukia nafsi zao machoni pao wenyewe, kwa sababu ya mabaya yao yote, waliyoyatenda kwa machukizo yao yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watajua ya kuwa mimi ndimi BWANA; sikusema bure kama nitawatenda mabaya hayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        }
