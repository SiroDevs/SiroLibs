                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwanadamu, uelekeze uso wako uitazame milima ya Israeli, ukaitabirie, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
