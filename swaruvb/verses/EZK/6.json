                  "text": "5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwana MUNGU asema hivi; Piga kwa mkono wako, ipige nchi kwa mguu wako, ukaseme, Ole! Kwa sababu ya machukizo maovu yote ya nyumba ya Israeli; maana wataanguka kwa upanga, na kwa njaa, na kwa tauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye aliye mbali sana atakufa kwa tauni; na yeye aliye karibu atakufa kwa upanga; na yeye atakayesalia, na kuhusuriwa katika mji, atakufa kwa njaa, hivyo ndivyo nitakavyoitimiza ghadhabu yangu juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
