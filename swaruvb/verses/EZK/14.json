          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo uwaambie nyumba ya Israeli, Bwana MUNGU asema hivi; Rudini ninyi, mkageuke na kuviacha vinyago vyenu; mkageuze nyuso zenu zisielekee machukizo yenu yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.6",
            "verseOrgIds": [
              "EZK.14.6"
            ]
          }
        },
