                  "text": "Ebr 3:12-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ili niwakamate nyumba ya Israeli kwa mioyo yao wenyewe, kwa sababu wamefarakana nami kwa vinyago vyao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.5",
            "verseOrgIds": [
              "EZK.14.5"
            ]
          }
