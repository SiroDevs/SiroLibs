                "loc": "EZK.6.2"
              },
              "items": [
                {
                  "text": "Eze 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakamtia katika tundu kwa kulabu, wakamleta kwa mfalme wa Babeli wakamtia ndani ya ngome, sauti yake isisikiwe tena juu ya milima ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
