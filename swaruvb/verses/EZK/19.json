                  "text": "Kum 8:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mama yako alikuwa kama mzabibu, katika damu yako, uliopandwa karibu na maji; akazaa sana na kujaa matawi, kwa sababu ya maji mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.11"
              },
              "items": [
                {
                  "text": "Dan 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye alikuwa na vijiti vya nguvu, kwa fimbo za enzi zao watawalao, na kimo chao kiliinuka kati ya matawi manene, wakaonekana kwa urefu wao, pamoja na wingi wa matawi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.15"
              },
              "items": [
                {
                  "text": "Hos 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini aling'olewa kwa ghadhabu, akaangushwa chini, upepo wa mashariki ukakausha matunda yake; vijiti vyake vya nguvu vikavunjika, vikakauka; moto ulivila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.12",
            "verseOrgIds": [
              "EZK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.48"
              },
              "items": [
                {
                  "text": "Kum 28:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na sasa umepandwa jangwani, katika nchi kavu, ya ukame. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.13",
            "verseOrgIds": [
              "EZK.19.13"
            ]
          }
        },
        {
