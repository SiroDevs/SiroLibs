                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, roho zote ni mali yangu; kama vile roho ya baba ni mali yangu, ndivyo ilivyo roho ya mwana mali yangu; roho ile itendayo dhambi itakufa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
