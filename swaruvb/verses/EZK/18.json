              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu atafakari, na kughairi, na kuyaacha makosa yake yote aliyoyatenda, hakika ataishi, hatakufa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
            "verseOrgIds": [
