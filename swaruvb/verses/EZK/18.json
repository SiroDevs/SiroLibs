          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mimi niishivyo, asema Bwana MUNGU, hamtakuwa na sababu ya kuitumia tena mithali hii katika Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
