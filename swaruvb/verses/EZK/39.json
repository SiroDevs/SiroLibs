              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, itakuwa katika siku hiyo, nitampa Gogu pa kuzikia katika Israeli, bonde la wapitao, upande wa mashariki wa bahari; nalo litawazuia wapitao; na huko watamzika Gogu na jamii ya watu wake wote; nao wataliita, Bonde la Hamon-Gogu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Kum 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kwa muda wa miezi saba, nyumba ya Israeli watakuwa wakiwazika, wapate kuitakasa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.12",
            "verseOrgIds": [
              "EZK.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.126.2"
              },
              "items": [
                {
                  "text": "Zab 126:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naam, watu wote wa nchi hiyo watawazika; itakuwa ni sifa kwao katika siku ile nitakapotukuzwa, asema Bwana MUNGU. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.13",
            "verseOrgIds": [
              "EZK.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watawachagua watu wa kufanya kazi ya daima, watakaopita kati ya nchi, ili kuwazika waliosalia juu ya uso wa nchi, ili kuisafisha; miezi saba itakapokwisha kupita watachunguza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.14",
            "verseOrgIds": [
              "EZK.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hao wapitao kati ya nchi watachunguza; na mtu yeyote aonapo mfupa wa mtu, ndipo atakapoweka alama karibu nao, hadi wazikaji watakapouzika katika bonde la Hamon-Gogu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.15",
            "verseOrgIds": [
              "EZK.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, Hamona litakuwa jina la mji. Hivyo ndivyo watakavyotakasa nchi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        }
      ]
    },
