              "type": "text"
            }
          ]
        },
        {
          "text": " Na wewe, mwanadamu, tabiri juu ya Gogu, useme, Bwana MUNGU asema hivi, Tazama, mimi ni juu yako, Ewe Gogu, mkuu wa Roshi, Mesheki, na Tubali; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.1",
            "verseOrgIds": [
              "EZK.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitakugeuza na kukuongoza, nami nitakupandisha toka pande za mwisho za kaskazini; nami nitakuleta juu ya milima ya Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.2",
            "verseOrgIds": [
              "EZK.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitaupiga upinde wako, utoke katika mkono wako wa kushoto, na mishale yako nitaiangusha, itoke katika mkono wako wa kulia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.3",
            "verseOrgIds": [
              "EZK.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 39:4"
          },
          "items": [
