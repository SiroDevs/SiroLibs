              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa wayaondoe mambo yao ya kikahaba, na mizoga ya wafalme wao, yawe mbali nami, nami nitakaa kati yao milele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
