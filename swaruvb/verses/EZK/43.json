                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na huo utukufu wa BWANA ukaingia ndani ya nyumba, kwa njia ya lango lile lielekealo upande wa mashariki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
