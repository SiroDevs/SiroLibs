                  "text": "1 Fal 8:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Roho ikaniinua, ikanichukua mpaka katika ua wa ndani; na tazama, utukufu wa BWANA uliijaza nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
