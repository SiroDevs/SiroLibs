              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.26"
              },
              "items": [
                {
                  "text": "Kut 20:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na daraja, urefu wake dhiraa kumi na nne, na upana wake dhiraa kumi na nne, pande zake nne; na pambizo yake nusu dhiraa; na kitako chake dhiraa moja, kotekote, na madaraja yake yataelekea upande wa mashariki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
