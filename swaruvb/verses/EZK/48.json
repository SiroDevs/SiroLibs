          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena mpakani mwa Simeoni, toka upande wa mashariki hata upande wa magharibi; Isakari, fungu moja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
