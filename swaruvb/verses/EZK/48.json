                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Patakuwa kwa makuhani wa wana wa Sadoki, waliotakasika, waliofuata maagizo yangu, wasioasi, wana wa Israeli walipoasi, kama Walawi walivyoasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na matoleo hayo ya nchi yatolewayo, yatakuwa kwao kitu kitakatifu sana, karibu na mpaka wa Walawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuukabili mpaka wa makuhani, Walawi watakuwa na fungu, urefu wake mianzi elfu ishirini na tano, na upana wake mianzi elfu kumi; urefu wote utakuwa mianzi elfu ishirini na tano, na upana wake mianzi elfu kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
