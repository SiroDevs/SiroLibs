                  "text": "Ufu 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hao wafanyao kazi mjini, wa kabila zote za Israeli, watailima nchi hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
