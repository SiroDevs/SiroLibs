          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena tokea milki ya Walawi, na tokea milki ya mji, kwa kuwa ni katikati ya nchi iliyo ya mkuu, katikati ya mpaka wa Yuda na mpaka wa Benyamini, itakuwa ya mkuu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
