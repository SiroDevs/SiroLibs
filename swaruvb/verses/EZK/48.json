              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena mpakani mwa Benyamini, toka upande wa mashariki hata upande wa magharibi; Simeoni, fungu moja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
