                  "text": "Ufu 21:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na malango ya mji yatatajwa kwa majina ya makabila ya Israeli, malango matatu upande wa kaskazini; lango la Reubeni, moja; lango la Yuda, moja; na lango la Lawi, moja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na upande wa mashariki, mianzi elfu nne na mia tano, kwa kipimo; na malango matatu; lango la Yusufu, lango la Benyamini; lango la Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na upande wa kusini, mianzi elfu nne na mia tano kwa kupima; na malango matatu; lango la Simeoni; lango la Isakari, lango la Zabuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na upande wa magharibi, mianzi elfu nne na mia tano; pamoja na malango yake matatu; lango la Gadi, lango la Asheri; na lango la Naftali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
