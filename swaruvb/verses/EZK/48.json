                  "text": "Law 27:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala hawatauza sehemu yake, wala kuibadili, wala hawatawapa wengine malimbuko ya nchi; maana ni matakatifu kwa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
