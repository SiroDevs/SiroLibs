              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kila mmoja alikuwa na nyuso nne, na kila mmoja alikuwa na mabawa manne. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
