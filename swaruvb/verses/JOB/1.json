        },
        {
          "text": " Ilitukia siku moja hao watoto wake wa kiume na kike walipokuwa wakila na kunywa divai katika nyumba ya ndugu yao mkubwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
