        },
        {
          "text": " Ilikuwa, siku moja ambayo hao wana wa Mungu walikwenda kujiweka mbele za BWANA, Shetani naye akaenda kati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
