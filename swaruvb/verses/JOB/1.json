          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mjumbe akamfikia Ayubu na kumwambia, Hao ng'ombe walikuwa wakilima, na punda walikuwa wakila karibu nao; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
