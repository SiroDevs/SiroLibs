                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.8"
              },
              "items": [
                {
                  "text": "1 Pet 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akamwuliza Shetani, Umetoka wapi wewe? Ndipo Shetani akamjibu BWANA, na kusema, Natoka katika kuzungukazunguka duniani, na katika kutembea huku na huku humo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha BWANA akamwuliza Shetani, Je! Umemwangalia huyo mtumishi wangu Ayubu? Kwa kuwa hapana mmoja aliye kama yeye duniani, mtu mkamilifu na mwelekevu, mwenye kumcha Mungu na kuepukana na uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Ufu 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Shetani akamjibu BWANA, na kusema, Je! Huyo Ayubu anamcha BWANA bure? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
