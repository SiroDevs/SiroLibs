          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kwamba mwenye kuua mtu, aliyemwua mtu yeyote pasipo kukusudia, na pasipo kujua, apate kukimbilia huko; nayo itakuwa ni mahali pa kukimbilia kwenu, kumkimbia huyo ajilipizaye kisasi cha damu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
