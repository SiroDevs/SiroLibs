        {
          "text": " Nena wewe na wana wa Israeli, uwaambie, Haya, toeni hiyo miji ya makimbilio, ambayo niliwaambia habari zake kwa mkono wa Musa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
