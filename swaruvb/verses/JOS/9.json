          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha ikawa, mwisho wa siku ya tatu baada ya kufanya hilo agano nao, walisikia habari ya kuwa watu hao ni jirani zao, na ya kwamba waliketi kati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
