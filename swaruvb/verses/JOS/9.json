                }
              ]
            }
          ]
        },
        {
          "text": " Basi sasa mmelaaniwa kisha hatakosekana kuwapo mtu wa kwenu aliye mtumwa, wenye kupasua kuni, na wenye kuteka maji, kwa ajili ya nyumba ya Mungu wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
