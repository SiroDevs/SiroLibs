              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na viatu vilivyotoboka na kushonwashonwa katika miguu yao, na mavazi makuukuu tena mkate wote wa chakula chao ulikuwa umekauka na kuota ukungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
              "JOS.9.5"
