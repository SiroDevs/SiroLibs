        {
          "text": " Naye Yoshua akafanya amani pamoja nao, na kufanya agano nao, ili kwamba waachwe hai; na wakuu wa mkutano wakawaapia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        },
        {
          "name": "verse",
