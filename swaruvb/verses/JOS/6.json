              "items": [
                {
                  "text": "2 Nya 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata mara ya saba makuhani wakayapiga mabaragumu, Yoshua akawaambia watu, Pigeni kelele; kwa maana BWANA amewapeni mji huu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
