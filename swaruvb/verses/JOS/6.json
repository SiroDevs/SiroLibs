            "sid": "JOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yeriko ulikuwa umefungwa kabisa kwa sababu ya Waisraeli; hapana mtu aliyetoka wala hapana mtu aliyeingia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.1",
            "verseOrgIds": [
              "JOS.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
