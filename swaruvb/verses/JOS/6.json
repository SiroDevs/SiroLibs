                }
              ]
            }
          ]
        },
        {
          "text": " Naye Yoshua akawaambia wale wanaume wawili walioipeleleza nchi, Ingieni katika nyumba ya yule kahaba, mkamtoe huyo mwanamke mwenyewe na vitu vyote alivyo navyo, kama mlivyomwapia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
