                "loc": "NEH.9.24"
              },
              "items": [
                {
                  "text": "Neh 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.18"
              },
              "items": [
                {
                  "text": "Dan 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akamwambia Yoshua, Tazama, nimeutia Yeriko katika mkono wako, na mfalme wake, na mashujaa wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi mtauzunguka mji huu, wapiganaji wote, mkiuzunguka mji mara moja. Fanya hivi siku sita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.16"
              },
              "items": [
                {
                  "text": "Amu 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.8"
              },
              "items": [
                {
                  "text": "Hes 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na makuhani saba watachukua baragumu saba za pembe za kondoo dume, watatangulia mbele za hilo sanduku; na siku ya saba mtauzunguka mji mara saba, nao makuhani watapiga baragumu zao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha itakuwa watakapopiga hizo pembe za kondoo dume kwa nguvu, nanyi mtakaposikia kwa mlio wa baragumu, watu wote watapiga kelele kwa sauti kuu; na ukuta wa mji utaanguka chini pale pale, na hao watu watapanda, kila mtu akiendelea mbele kukabili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali Yoshua, mwana wa Nuni, akawaita makuhani, akawaambia, Lichukueni sanduku la Agano, tena makuhani saba na wachukue mabaragumu saba za pembe za kondoo dume watangulie mbele ya sanduku la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akawaambia watu, Piteni mbele, mkauzunguke mji, na hao watu wenye silaha na watangulie mbele ya sanduku la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.4.13"
              },
              "items": [
                {
                  "text": "Yos 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi ikawa Yoshua alipokwisha kusema na watu, wale makuhani saba, wenye kuzichukua baragumu saba za pembe za kondoo dume mbele za BWANA, watatangulia, wakayapiga hayo mabaragumu; nalo sanduku la Agano la BWANA likawafuata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.25"
              },
              "items": [
                {
                  "text": "Hes 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.12"
              },
              "items": [
                {
                  "text": "Isa 42:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wale watu wenye silaha walikwenda mbele ya hao makuhani walioyapiga mabaragumu, na wale waliokuwa nyuma wakalifuata hilo sanduku; makuhani wakiyapiga mabaragumu walipokuwa wakienda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akawaamuru watu, akasema Msipige kelele, wala sauti zenu zisisikiwe, wala neno lolote lisitoke kinywani mwenu, hadi siku ile nitakapowaamuru kupiga kelele, ndipo mtakapopiga kelele. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akalipeleka sanduku la BWANA liuzunguke huo mji, likauzunguka mara moja, kisha wakaenda kambini wakakaa humo kambini.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
      ]
    },
