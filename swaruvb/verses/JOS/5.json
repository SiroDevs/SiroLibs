              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Kut 16:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo ile mana ikakoma siku ya pili yake, baada ya wao kuyala hayo mazao ya nchi; na hao wana wa Israeli hawakuwa na mana tena; lakini wakala mazao ya nchi ya Kanaani mwaka huo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
