              "type": "text"
            }
          ]
        },
        {
          "text": " Wakati huo BWANA akamwambia Yoshua, Haya, jifanyie visu vya mawe ya gumegume, watahiri tena wana wa Israeli mara ya pili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoshua akajifanyia visu vya mawe ya gumegume, akawatahiri wana wa Israeli huko Gibea-haaralothi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:3",
              "type": "text"
            },
            {
              "text": "Maana yake ni ‘mlima wa Magovi’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
