            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.31"
              },
              "items": [
                {
                  "text": "Hes 14:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na watoto wao, aliowainua badala yao ndio hao aliowatahiri Yoshua; kwa kuwa wao walikuwa hawajatahiriwa, kwa maana hawakuwatahiri njiani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.25"
              },
              "items": [
                {
                  "text": "Mwa 34:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ilikuwa walipokwisha kutahiriwa taifa zima, wakakaa kila mtu mahali pake kambini, hadi walipopoa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
