                }
              ]
            }
          ]
        },
        {
          "text": " Basi wana wa Israeli wakapanga hema zao huko Gilgali; nao wakala sikukuu ya Pasaka siku ya kumi na nne ya mwezi, jioni, katika nchi tambarare za Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
