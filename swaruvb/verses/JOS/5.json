              "items": [
                {
                  "text": "Kum 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na sababu ya Yoshua kutahiri ni hii; watu wote wanaume waliotoka Misri, waliokuwa wapiganaji vita wote walifariki katika safari jangwani baada ya kutoka Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa watu wote waliotoka walikuwa wamekwisha kutahiriwa; lakini watu wote waliozaliwa katika safari jangwani walipokwisha kutoka Misri, hao hawakutahiriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
