                "loc": "HEB.3.11"
              },
              "items": [
                {
                  "text": "Ebr 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kuwa wana wa Israeli walitembea muda wa miaka arubaini barani, hadi hilo taifa zima, yaani, watu wanaume wapiganaji vita, waliotoka Misri, walipokuwa wameangamia; kwa sababu hawakuisikiza sauti ya BWANA; nao ndio BWANA aliowaapia ya kwamba hatawaacha waione hiyo nchi, ambayo BWANA aliwaapia baba zao kwamba atatupa sisi; nchi itiririkayo maziwa na asali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
