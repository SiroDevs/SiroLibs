            }
          ]
        },
        {
          "text": " BWANA akamwambia Yoshua, Siku hii ya leo nimeivingirisha hiyo aibu ya Misri iondoke juu yenu. Kwa hiyo jina la mahali pale likaitwa Gilgali,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:9",
              "type": "text"
            },
            {
              "text": "Kwa maana ya kuvingirisha.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hata hivi leo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
