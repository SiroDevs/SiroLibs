            }
          ]
        },
        {
          "text": " Vile vile kama BWANA alivyomwamuru Musa mtumishi wake, ndivyo Musa alivyomwamuru Yoshua; naye Yoshua akafanya hivyo; hakukosa kufanya neno lolote katika hayo yote BWANA aliyomwamuru Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
