              "items": [
                {
                  "text": "Yos 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " hadi BWANA atakapowapa ndugu zenu raha, kama alivyowapa ninyi, na wao pia wamepata kuimiliki nchi awapayo BWANA, Mungu wenu; ndipo mtakapoirudia nchi ya milki yenu na kuimiliki, ambayo Musa mtumishi wa BWANA aliwapeni ng'ambo ya Yordani upande wa maawio ya jua. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamjibu Yoshua, wakasema, Hayo yote uliyotuamuru tutayafanya, na kila mahali utakakotutuma tutakwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.16",
            "verseOrgIds": [
