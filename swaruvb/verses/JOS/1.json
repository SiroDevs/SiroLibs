                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila mahali zitakapopakanyaga nyayo za miguu yenu, nimewapa ninyi, kama nilivyomwapia Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.3",
