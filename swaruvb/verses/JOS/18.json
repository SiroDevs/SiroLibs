              },
              "items": [
                {
                  "text": "Yos 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha mpaka ukaendelea kutoka hapo na kufikia mji wa Luzu, ubavuni mwa Luzu (ndio Betheli), kwa upande wa kusini; kisha mpaka ukateremkia Ataroth-adari, karibu na mlima ulio upande wa kusini wa Beth-horoni wa chini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.13",
            "verseOrgIds": [
              "JOS.18.13"
            ]
          }
        },
