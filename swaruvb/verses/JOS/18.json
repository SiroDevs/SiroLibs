        },
        {
          "text": "kisha ukaendelea mbele ubavuni kuikabili Araba, upande wa kuelekea kaskazini, nao ukateremka hadi hiyo Araba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
