              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.1"
              },
              "items": [
                {
                  "text": "Yos 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.1+JOS.16.2+JOS.16.3+JOS.16.4"
              },
              "items": [
                {
                  "text": "16:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watu hao wataigawanya nchi iwe mafungu saba; Yuda atakaa katika mpaka wake huko upande wa kusini, na nyumba ya Yusufu watakaa katika mpaka wao upande wa kaskazini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.2"
              },
              "items": [
                {
                  "text": "Yos 14:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanyi mtaiandika nchi iwe mafungu saba, kisha hayo maandiko yake mtaniletea mimi hapa; nami nitawapigia kura hapa mbele ya BWANA, Mungu wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
