              "items": [
                {
                  "text": "Mit 16:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Yoshua akapiga kura kwa ajili yao hapo mbele za BWANA katika Shilo; huko Yoshua akawagawanyia wana wa Israeli hiyo nchi sawasawa na mafungu yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        }
      ]
