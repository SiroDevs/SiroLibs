          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalikuwa yamebaki kati yao makabila saba ya wana wa Israeli ambayo yalikuwa hayajagawiwa urithi wao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
