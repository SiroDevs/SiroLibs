            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha ilizuka kura ya kabila la wana wa Benyamini kwa kulingana na jamaa zao; na mpaka wa hiyo kura yao ukatokea kati ya wana wa Yuda na wana wa Yusufu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.11",
            "verseOrgIds": [
              "JOS.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.1"
              },
              "items": [
                {
                  "text": "Yos 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mpaka wao upande wa kaskazini ulikuwa kutoka mto wa Yordani; kisha mpaka ukaendelea kufikia ubavuni mwa mji wa Yeriko upande wa kaskazini, kisha ukaendelea kati ya nchi ya vilima kwa kuelekea upande wa magharibi; na matokeo yake yalikuwa hapo penye nyika ya Beth-aveni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
