        },
        {
          "text": " Kisha mkutano mzima wa wana wa Israeli walikutana pamoja hapo Shilo, wakasimamisha hema ya kukutania huko; nayo nchi ilikuwa imeshindwa mbele zao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
