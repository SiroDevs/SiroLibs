                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " siku zile mfalme Ahasuero alipoketi katika kiti cha enzi cha ufalme wake, huko Susa, mji mkuu ngomeni; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
