              "type": "text"
            }
          ]
        },
        {
          "text": " Basi mabikira walipokusanyika mara ya pili, Mordekai alikuwa akiketi",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
            "verseOrgIds": [
              "EST.2.19"
            ]
