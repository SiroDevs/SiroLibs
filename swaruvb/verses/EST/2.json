            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi palikuwa na Myahudi mmoja huko Susa, mji mkuu; jina lake Mordekai, mwana wa Yairi, mwana wa Shimei, mwana wa Kishi, wa kabila la Benyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
