                "loc": "2TI.4.18"
              },
              "items": [
                {
                  "text": "2 Tim 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakati ilipowadia zamu yake Esta, binti Abihaili, mjomba wake Mordekai, ambaye alimtwaa kuwa binti yake, ili aingie kwa mfalme, yeye hakutaka kitu, ila vile vilivyoagizwa na Hegai, msimamizi wake mfalme, aliyewalinda wanawake. Naye huyu Esta alikuwa amepata kibali machoni pa wote waliomwona. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
