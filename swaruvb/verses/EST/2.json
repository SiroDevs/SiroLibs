                "loc": "EST.3.7"
              },
              "items": [
                {
                  "text": "Est 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Esta alipelekwa kwa mfalme Ahasuero, katika nyumba ya kifalme, mwezi wa kumi, ndio mwezi wa Tebethi, mwaka wa saba wa kutawala kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
