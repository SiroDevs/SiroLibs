        },
        {
          "text": " Baada ya hayo, hasira yake mfalme Ahasuero ilipotulia, alimkumbuka Vashti, na vile alivyotenda, na yale yaliyoamriwa juu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
