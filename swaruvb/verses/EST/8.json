                "loc": "EST.2.7"
              },
              "items": [
                {
                  "text": "Est 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Siku ile mfalme Ahasuero alimpa malkia Esta nyumba yake Hamani, yule adui ya Wayahudi. Mordekai naye akaja mbele ya mfalme; kwa maana Esta alikuwa amedhihirisha alivyomhusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.1",
            "verseOrgIds": [
              "EST.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.42"
              },
              "items": [
                {
                  "text": "Mwa 41:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.10"
              },
              "items": [
                {
                  "text": "Est 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.29"
              },
              "items": [
                {
                  "text": "Dan 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.22"
              },
              "items": [
                {
                  "text": "Lk 15:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi mfalme akaivua pete yake, aliyompokonya Hamani, akampa Mordekai. Naye Esta akamweka Mordekai kuwa juu ya mlango wake Hamani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.2",
            "verseOrgIds": [
              "EST.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Esta akasema na mfalme mara ya pili, akaanguka miguuni pake, akamsihi kwa machozi ayaondoe madhara ya Hamani, Mwagagi, na shauri alilowafanyia Wayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.3",
            "verseOrgIds": [
              "EST.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.4.11"
              },
              "items": [
                {
                  "text": "Est 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo mfalme alipomnyoshea Esta fimbo yake ya dhahabu. Basi Esta akaondoka, akasimama mbele ya mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.4",
            "verseOrgIds": [
              "EST.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Mfalme akiona vema, nami nikiwa nimepata kibali machoni pake, na neno likionekana jema mbele ya mfalme, nami nikimpendeza machoni pake, na iandikwe amri kuzitangua barua za Hamani mwana wa Hamedatha, Mwagagi, alizotunga na kuziandika ili kuwaangamiza Wayahudi walioko katika mikoa yote ya mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.5",
            "verseOrgIds": [
              "EST.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.3"
              },
              "items": [
                {
                  "text": "Neh 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.6"
              },
              "items": [
                {
                  "text": "Zab 137:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana, ninawezaje kustahimili kuyaona mabaya yatakayowajia watu wangu? Au kuyatazama maangamizi ya jamaa zangu? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.6",
            "verseOrgIds": [
              "EST.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.22"
              },
              "items": [
                {
                  "text": "Mit 13:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mfalme Ahasuero akawaambia malkia Esta na Mordekai, Myahudi, akasema, Tazama, nimekwisha kumpa Esta nyumba yake Hamani, naye mwenyewe wamekwisha kumtundika juu ya mti, kwa sababu aliwatia mikono Wayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.7",
            "verseOrgIds": [
              "EST.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.6.8"
              },
              "items": [
                {
                  "text": "Dan 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.19"
              },
              "items": [
                {
                  "text": "2 Tim 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi nanyi pia waandikieni Wayahudi vyovyote mpendavyo, kwa jina la mfalme, mkatie mhuri kwa pete ya mfalme; kwa kuwa andiko lililoandikwa kwa jina la mfalme na kutiwa mhuri kwa pete ya mfalme, hakuna awezaye kulitangua.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.8",
            "verseOrgIds": [
              "EST.8.8"
            ]
          }
        }
      ]
    },
