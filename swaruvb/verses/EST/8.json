                "loc": "EST.1.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, waandishi wa mfalme wakaitwa pale pale, siku ya ishirini na tatu ya mwezi wa tatu, ndio mwezi wa Siwani; na kama vile Mordekai alivyoamuru, Wayahudi wakaandikiwa, pamoja na wakuu wa tarafa na wakuu wa mikoa kuanzia Bara Hindi mpaka Kushi, mikoa mia moja na ishirini na saba, kila mkoa kwa mwandiko wake, na kila taifa kwa lugha yake; na Wayahudi kwa mwandiko wao na kwa lugha yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.8"
              },
              "items": [
                {
                  "text": "1 Fal 21:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaandika kwa jina la mfalme Ahasuero, na kutia mhuri kwa pete ya mfalme, barua zikapelekwa na matarishi, wamepanda farasi, wamepanda wanyama wepesi sana waliotumika kwa huduma ya mfalme, ndio waliozalishwa katika zizi la mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.10",
            "verseOrgIds": [
              "EST.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
