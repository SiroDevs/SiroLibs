              "items": [
                {
                  "text": "Est 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.6"
              },
              "items": [
                {
                  "text": "Isa 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika barua hizo mfalme aliwaruhusu Wayahudi katika kila mji wakusanyike na kuyalinda maisha yao, kwa kuangamiza, kuua, na kulimaliza jeshi lote la watu au mkoa watakaowashambulia, pamoja na watoto na wanawake; na kuyachukua mali yao kuwa nyara; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.11",
            "verseOrgIds": [
              "EST.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 8:12"
          },
          "items": [
            {
