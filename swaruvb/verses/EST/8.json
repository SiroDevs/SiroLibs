              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " siku moja, katika mikoa yote ya mfalme Ahasuero, yaani, siku ya kumi na tatu ya mwezi wa kumi na mbili, ndio mwezi wa Adari. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
