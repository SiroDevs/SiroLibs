        },
        {
          "text": " Baada ya hayo mfalme Ahasuero alimpandisha cheo Hamani mwana wa Hamedatha, Mwagagi,",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
