        },
        {
          "text": " Hata Hamani alipoona ya kwamba Mordekai hamwinamii wala kumsujudia, alighadhibika sana. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
