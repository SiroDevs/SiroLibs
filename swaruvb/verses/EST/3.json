            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:1",
              "type": "text"
            },
            {
              "text": "Agagi alikuwa mfalme wa Amaleki, wa Israeli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akamwinua, akamwekea kiti chake juu ya wakuu wote waliokuwapo pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
