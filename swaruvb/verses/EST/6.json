        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hamani akawasimulia Zereshi mkewe na marafiki zake wote kila neno lililompata. Kisha watu wake wenye hekima na Zereshi mkewe wakamwambia, Ikiwa huyu Mordekai, ambaye umeanza kuanguka mbele yake, ni wa uzao wa Wayahudi, wewe hutamweza, bali kuanguka utaanguka mbele yake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
    {
