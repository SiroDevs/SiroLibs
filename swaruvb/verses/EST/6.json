        "style": "s1"
      },
      "items": [
        {
          "text": "Mfalme Amtunza Mordekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
