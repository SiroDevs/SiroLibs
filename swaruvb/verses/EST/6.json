          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walipokuwa wangali wakisema naye, matowashi wa mfalme walifika, wakahimiza kumleta Hamani katika karamu ile aliyoiandaa Esta.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
