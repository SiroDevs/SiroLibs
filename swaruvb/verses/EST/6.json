            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.11"
              },
              "items": [
                {
                  "text": "Ayu 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.11"
              },
              "items": [
                {
                  "text": "Lk 14:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi mfalme akamwambia Hamani, Hima! Twaa mavazi na farasi kama ulivyosema, ukamfanyie vivyo hivyo Mordekai, Myahudi, aketiye mlangoni pa mfalme; lisipungue neno lolote katika yote uliyoyasema. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Hamani alipoyatwaa mavazi na farasi, akamvika Mordekai yale mavazi, akampandisha juu ya farasi na kumtembeza kupitia njia kuu ya mjini, akapiga mbiu mbele yake, Hivyo ndivyo atakavyofanyiwa mtu yule ambaye mfalme apenda kumheshimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.19"
              },
              "items": [
                {
                  "text": "Est 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.131.1"
              },
              "items": [
                {
                  "text": "Zab 131:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.30"
              },
              "items": [
                {
                  "text": "2 Sam 15:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Mordekai akarudi kwenye lango la mfalme. Bali Hamani akaenda mbio nyumbani kwake, akiomboleza na kichwa chake kimefunikwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        }
      ]
    },
