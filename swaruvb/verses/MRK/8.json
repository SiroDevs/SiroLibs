              "type": "tag",
              "attrs": {
                "loc": "LUK.9.18+LUK.9.19+LUK.9.20+LUK.9.21+LUK.9.22+LUK.9.23+LUK.9.24+LUK.9.25+LUK.9.26+LUK.9.27"
              },
              "items": [
                {
                  "text": "Lk 9:18-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akatoka Yesu na wanafunzi wake, wakaenda kwenye vijiji vya Kaisaria-Filipi; na njiani akawauliza wanafunzi wake, akasema, Watu huninena mimi kuwa ni nani? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
