              "items": [
                {
                  "text": "Yn 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akamshika mkono yule kipofu, akamchukua nje ya kijiji, akamtemea mate katika macho, akamwekea mikono yake, akamwuliza, Waona kitu? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatazama juu, akasema, Naona watu kama miti, inakwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akaweka tena mikono yake juu ya macho yake, naye akatazama sana; akawa mzima, akaona vyote waziwazi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.36"
              },
              "items": [
                {
                  "text": "Mk 7:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akamwagiza aende nyumbani kwake, akisema, Hata kijijini usiingie. Petro Amkiri Yesu kuwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        }
