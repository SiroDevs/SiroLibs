              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baada ya hayo akawatokea wawili miongoni mwao, akiwa na sura nyingine; nao walikuwa wakitembea njiani kwenda mashambani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hao wakaenda zao wakawapa habari wale wengine; wala hao hawakuwaamini.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        }
      ]
