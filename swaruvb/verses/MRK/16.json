              "items": [
                {
                  "text": "Mt 28:18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akawaambia, Nendeni ulimwenguni kote, mkaihubiri Injili kwa kila kiumbe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
