              "items": [
                {
                  "text": "Yn 20:11-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye alipofufuka alfajiri siku ya kwanza ya juma, alimtokea kwanza Mariamu Magdalene, ambaye alikuwa amemtoa pepo saba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo akashika njia akawapasha habari wale waliokuwa pamoja naye, nao wapokuwa wanaomboleza na kulia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hao waliposikia kwamba yu hai, naye amemwona, hawakuamini.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu awatokea wanafunzi wawili",
          "type": "text"
        }
      ]
    },
