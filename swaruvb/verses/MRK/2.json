              "type": "text"
            }
          ]
        },
        {
          "text": "Mafarisayo wakamwambia, Tazama, mbona wanafanya lisilokuwa halali siku ya sabato? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
