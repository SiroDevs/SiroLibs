                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akawaambia, Hamkusoma popote alivyofanya Daudi, alipokuwa akiona njaa na kuhitaji chakula, yeye na wenziwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
