                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akawaambia, Mwaonaje? Taa huja ili kuwekwa chini ya pishi, au mvunguni? Si kuwekwa juu ya kiango?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.15"
              },
              "items": [
                {
                  "text": "Mt 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
