          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala pasipo mfano hakusema nao; lakini akawaeleza wanafunzi wake mwenyewe mambo yote kwa faragha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
