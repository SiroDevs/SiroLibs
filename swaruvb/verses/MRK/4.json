              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana nchi huzaa yenyewe; kwanza jani, tena suke, kisha ngano pevu katika suke. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
