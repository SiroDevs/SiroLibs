              "items": [
                {
                  "text": "Lk 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.26"
              },
              "items": [
                {
                  "text": "Mt 10:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.2"
              },
              "items": [
                {
                  "text": "Lk 12:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana hakuna neno lililositirika, ila kusudi lije kudhihirika; wala hakuna lililofichwa, ila kusudi lije kutokea wazi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu akiwa na masikio ya kusikilia, na asikie. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
