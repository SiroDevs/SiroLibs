              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kama punje ya haradali, ambayo ipandwapo katika nchi, ingawa ni ndogo kuliko mbegu zote zilizo katika nchi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
