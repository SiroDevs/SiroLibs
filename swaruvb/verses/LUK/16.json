                "loc": "MAT.23.14"
              },
              "items": [
                {
                  "text": "Mt 23:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Basi Mafarisayo, ambao wenyewe ni wapenda fedha, waliyasikia hayo yote, wakamdhihaki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
