                "loc": "PRO.6.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akawaambia, Ninyi ndinyi mnaojidai haki mbele ya wanadamu, lakini Mungu awajua mioyo yenu; kwa kuwa lililotukuka kwa wanadamu huwa chukizo mbele za Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.12+MAT.11.13"
              },
              "items": [
                {
                  "text": "Mt 11:12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Torati na Manabii vilikuwapo mpaka Yohana; tangu wakati huo Habari Njema ya ufalme wa Mungu hutangazwa, na kila mtu hujiingiza kwa nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mt 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini ni rahisi zaidi mbingu na nchi vitoweke, kuliko itanguke nukta moja ya torati. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        },
        {
