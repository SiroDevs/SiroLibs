                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1 Kor 7:10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila amwachaye mkewe na kumwoa mke mwingine azini; naye amwoaye yeye aliyeachwa na mumewe azini.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
