            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.6.16"
              },
              "items": [
                {
                  "text": "Mit 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
