                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akapewa kitabu cha nabii Isaya, akakifungua kitabu, akapata mahali palipoandikwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
