                "loc": "MAT.8.1+MAT.8.2+MAT.8.3+MAT.8.4"
              },
              "items": [
                {
                  "text": "Mt 8:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.40+MRK.1.41+MRK.1.42+MRK.1.43+MRK.1.44+MRK.1.45"
              },
              "items": [
                {
                  "text": "Mk 1:40-45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa, alipokuwa katika mmojawapo wa miji ile, tazama, palikuwa na mtu amejaa ukoma; naye alipomwona Yesu alianguka kifudifudi, akamwomba akisema, Bwana, ukitaka, waweza kunitakasa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.12",
            "verseOrgIds": [
              "LUK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akaunyosha mkono wake, akamgusa akisema, Nataka; takasika. Na mara ukoma wake ukamwondoka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 5:14"
          },
          "items": [
            {
