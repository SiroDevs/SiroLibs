                "loc": "MAT.9.9+MAT.9.10+MAT.9.11+MAT.9.12+MAT.9.13"
              },
              "items": [
                {
                  "text": "Mt 9:9-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.13+MRK.2.14+MRK.2.15+MRK.2.16+MRK.2.17"
              },
              "items": [
                {
                  "text": "Mk 2:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Baada ya hayo akatoka, akaona mtoza ushuru, jina lake Lawi, ameketi forodhani, akamwambia, Nifuate. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaacha vyote, akaondoka, akamfuata. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.1"
              },
              "items": [
                {
                  "text": "Lk 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Lawi akamfanyia karamu kubwa nyumbani mwake; palikuwa na mkutano mkuu wa watoza ushuru na watu wengineo waliokuwa wameketi chakulani pamoja nao. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.1+LUK.15.2"
              },
              "items": [
                {
                  "text": "Lk 15:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa Mafarisayo na waandishi wao kuwanung'unikia wanafunzi wake, wakisema, Mbona mnakula na kunywa pamoja na watoza ushuru na wenye dhambi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu akawaambia, Wenye afya hawana haja na tabibu, isipokuwa walio wagonjwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikuja kuwaita wenye haki, bali wenye dhambi, wapate kutubu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.32",
            "verseOrgIds": [
              "LUK.5.32"
            ]
          }
        }
      ]
    },
    {
