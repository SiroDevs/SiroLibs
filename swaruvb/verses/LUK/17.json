          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia wanafunzi wake, Vikwazo havina budi kuja, lakini ole wake mtu yule ambaye vinakuja kwa sababu yake! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.6"
              },
              "items": [
                {
                  "text": "Mt 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ingemfaa zaidi mtu huyo jiwe la kusagia lifungwe shingoni mwake, akatupwe baharini, kuliko kumkosesha mmojawapo wa wadogo hawa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.2",
            "verseOrgIds": [
              "LUK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.15"
              },
              "items": [
                {
                  "text": "Mt 18:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jilindeni; kama ndugu yako akikosa, mwonye; akitubu msamehe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.21"
              },
              "items": [
                {
                  "text": "Mt 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kama akikukosea mara saba katika siku moja, na kurudi kwako mara saba, akisema, Nimetubu, msamehe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.4",
            "verseOrgIds": [
              "LUK.17.4"
            ]
          }
        }
      ]
    },
    {
