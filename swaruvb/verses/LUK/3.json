          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, kwa maonyo mengine mengi aliwahubiria watu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        },
        {
