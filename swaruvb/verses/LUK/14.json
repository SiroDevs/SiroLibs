                  "text": "Mk 9:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Chumvi ni kitu chema; lakini chumvi ikiwa imeharibika, itiwe nini ikolee? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
