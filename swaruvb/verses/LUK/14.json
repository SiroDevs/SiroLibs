              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makutano mengi walipokuwa wakifuatana naye, aligeuka, akawaambia, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
