          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na alipofikisha umri wa miaka kumi na miwili, walipanda kama ilivyokuwa desturi ya sikukuu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
