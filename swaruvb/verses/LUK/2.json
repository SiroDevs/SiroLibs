                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisha, zilipotimia siku za kutakasika kwao, kama ilivyo Torati ya Musa walikwenda naye hata Yerusalemu, wamweke kwa Bwana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Kut 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (kama ilivyoandikwa katika sheria ya Bwana, Kila mtoto wa kiume aliye kifungua mimba wa mamaye na aitwe mtakatifu kwa Bwana), ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.11"
              },
              "items": [
                {
                  "text": "Law 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.12.8"
              },
              "items": [
                {
                  "text": "12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wakatoe na sadaka, kama ilivyonenwa katika sheria ya Bwana, Hua wawili au makinda ya njiwa wawili. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.1"
              },
              "items": [
                {
                  "text": "Isa 40:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.13"
              },
              "items": [
                {
                  "text": "49:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na tazama, pale Yerusalemu palikuwa na mtu, jina lake Simeoni, naye ni mtu mwenye haki, mcha Mungu, akiitarajia faraja ya Israeli; na Roho Mtakatifu alikuwa juu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.25",
            "verseOrgIds": [
              "LUK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye alikuwa ameonywa na Roho Mtakatifu ya kwamba hataona mauti kabla ya kumwona Kristo wa Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.26",
            "verseOrgIds": [
              "LUK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akaja hekaluni ameongozwa na Roho; na wale wazazi walipomleta mtoto Yesu ndani, ili wamfanyie kama ilivyokuwa desturi ya sheria, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.27",
            "verseOrgIds": [
              "LUK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye mwenyewe alimpokea mikononi mwake, akamshukuru Mungu, akisema,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.28",
            "verseOrgIds": [
              "LUK.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
