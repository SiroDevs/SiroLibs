                "loc": "JHN.2.16"
              },
              "items": [
                {
                  "text": "Yn 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akawaambia, Kwa nini mnitafute? Hamkujua ya kuwa imenipasa kuwamo katika nyumba ya Baba yangu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao hawakuelewa neno hilo alilowaambia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        },
