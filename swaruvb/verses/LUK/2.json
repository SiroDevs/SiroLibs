        },
        {
          "text": " Basi, wazee wake huenda Yerusalemu kila mwaka, wakati wa sikukuu ya Pasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
