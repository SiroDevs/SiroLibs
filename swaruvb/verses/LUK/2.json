              "items": [
                {
                  "text": "Lk 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.59"
              },
              "items": [
                {
                  "text": "59",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata zilipotumia siku nane za kumtahiri, aliitwa jina lake Yesu; kama alivyoitwa na malaika kabla hajachukuliwa mimba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu apelekwa hekaluni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
