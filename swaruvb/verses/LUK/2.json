              "items": [
                {
                  "text": "Lk 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akashuka pamoja nao mpaka Nazareti, naye alikuwa akiwatii; na mamaye aliyaweka hayo yote moyoni mwake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
