                  "text": "Isa 3:18-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kujipamba kwenu, kusiwe kujipamba kwa nje, yaani, kusuka nywele; na kujitia dhahabu, na kuvalia mavazi; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
