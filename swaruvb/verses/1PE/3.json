                  "text": "Mit 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kama vile Sara alivyomtii Abrahamu, akamwita bwana; nanyi ni watoto wake, mfanyapo mema, pasipo kutishwa na hofu yoyote. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
