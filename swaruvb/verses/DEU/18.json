              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.4"
              },
              "items": [
                {
                  "text": "2 Nya 31:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.44"
              },
              "items": [
                {
                  "text": "Neh 12:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wawe na fungu sawasawa la kula, pamoja na haya yaliyomfikia kwa kuuzwa urithi wa baba zake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Utoaji watoto kafara, upigaji ramli na uchawi zakatazwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
