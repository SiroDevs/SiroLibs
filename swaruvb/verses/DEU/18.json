              "items": [
                {
                  "text": "Kum 12:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Utakapokwisha kuingia katika nchi akupayo BWANA, Mungu wako usijifunze kutenda kwa mfano wa machukizo ya mataifa yale. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
