                "loc": "1CO.9.13"
              },
              "items": [
                {
                  "text": "1 Kor 9:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Makuhani Walawi, kabila yote ya Lawi, wasiwe na fungu wala urithi pamoja na Israeli; watakula sadaka za BWANA zifanywazo kwa moto, na urithi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Hes 18:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala wasiwe na urithi kati ya ndugu zao; BWANA ndiye urithi wao, kama alivyowaambia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.30"
              },
              "items": [
                {
                  "text": "Law 7:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hii itakuwa haki ya makuhani kwa watu hao wasongezao sadaka, ikiwa ni ng'ombe au kondoo wampe kuhani mkono, na mashavu mawili, na tumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.3",
            "verseOrgIds": [
              "DEU.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.29"
              },
              "items": [
                {
                  "text": "Kut 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12"
              },
              "items": [
                {
                  "text": "Hes 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malimbuko ya nafaka zako, na divai yako, na mafuta yako, na manyoya ya kwanza ya kondoo wako, umpe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.8"
              },
              "items": [
                {
                  "text": "Kum 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwani BWANA, Mungu wako, amemchagua katika kabila zako zote, asimame atumike kwa jina la BWANA, yeye na wanawe milele.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        }
      ]
    },
