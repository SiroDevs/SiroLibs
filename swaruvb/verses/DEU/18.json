              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe ukisema moyoni mwako, Tutajuaje neno asilolinena BWANA? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
            "verseOrgIds": [
              "DEU.18.21"
            ]
          }
