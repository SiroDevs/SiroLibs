        },
        {
          "text": " BWANA, Mungu wako, atakupa nabii miongoni mwa ndugu zako kama nilivyo mimi; msikilizeni yeye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile ulivyotaka kwa BWANA, Mungu wako, huko Horebu, siku ya kusanyiko, ukisema, Nisisikie tena sauti ya BWANA, Mungu wangu, wala nisiuone tena moto huu mkubwa, nisije nikafa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akaniambia, Wametenda vema kusema walivyosema. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.17",
            "verseOrgIds": [
              "DEU.18.17"
            ]
          }
        },
