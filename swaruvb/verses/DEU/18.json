                }
              ]
            }
          ]
        },
        {
          "text": " Hata itakuwa, mtu asiyesikiliza maneno yangu atakayosema yule kwa jina langu, nitalitaka kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.19",
