                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na akija Mlawi atokaye katika malango yako mojawapo, katika Israeli yote alipokuwa akikaa, akaja kwa mapenzi yote ya nafsi yake mahali atakapochagua BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atumike kwa jina la BWANA, Mungu wake, kama wafanyavyo ndugu zake wote, Walawi wasimamao huko mbele za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
