          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makundi yako ya ng'ombe na kondoo yatakapoongezeka, na fedha yako na dhahabu yako itakapoongezeka, na kila kitu ulicho nacho kitakapoongezeka; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
