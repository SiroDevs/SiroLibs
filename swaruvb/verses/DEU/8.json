        },
        {
          "text": " Akakunyenyekeza, akakuacha uone njaa, akakulisha kwa mana, usiyoijua wewe wala baba zako hawakuijua; apate kukujulisha ya kuwa mwanadamu haishi kwa mkate tu, bali huishi kwa kila litokalo katika kinywa cha BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
