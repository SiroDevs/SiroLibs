                  "text": "1 Tim 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe utakula ushibe, utamshukuru BWANA, Mungu wako, kwa nchi nzuri aliyokupa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
