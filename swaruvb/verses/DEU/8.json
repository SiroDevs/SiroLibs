        },
        {
          "text": "Amri hii ninayokuamuru leo mtaizingatia, mpate kuishi na kuongezeka, na kuingia katika nchi ile ambayo BWANA aliwaapia baba zenu; nanyi mtaimiliki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
