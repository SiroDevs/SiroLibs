              "items": [
                {
                  "text": "Ufu 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe fikiri moyoni mwako, ya kuwa kama vile baba amrudivyo mwanawe, ndivyo BWANA, Mungu wako, akurudivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe uzishike amri za BWANA, Mungu wako, upate kwenda katika njia zake, na kumcha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa BWANA, Mungu wako, anakuingiza katika nchi nzuri, nchi yenye vijito vya maji, na chemchemi, na visima, vibubujikavyo katika mabonde na milima; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nchi ya ngano na shayiri, na mizabibu, na mitini, na mikomamanga; nchi ya mizeituni yenye mafuta, na asali; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nchi utakayokula mikate humo, pasina shida, hutapungukiwa na kitu ndani yake; nchi ambayo mawe yake ni chuma, na milima yake mnaweza kuchimba shamba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
