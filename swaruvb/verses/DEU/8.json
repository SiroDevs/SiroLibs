              },
              "items": [
                {
                  "text": "Neh 9:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mavazi yako hayakuchakaa, wala mguu wako haukuvimba, miaka hiyo arubaini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
