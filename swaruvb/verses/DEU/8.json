                  "text": "Hos 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Angalia, utakapokuwa umekula na kushiba, na kujenga nyumba nzuri na kukaa ndani yake; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
