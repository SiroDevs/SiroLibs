        {
          "text": " na wazee wote wa mji ule, ulio karibu sana na yule aliyeuawa, na waoshe mikono yao juu ya huyo mtamba aliyevunjwa shingo yake humo bondeni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
