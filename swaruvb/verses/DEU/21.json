                {
                  "text": "Zab 45:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " avue na mavazi ya uteka wake akae nyumbani mwako, awakalie matanga babaye na mamaye mwezi mzima, kisha uingie kwake uwe mumewe, naye awe mkeo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
