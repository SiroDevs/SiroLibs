            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.13"
              },
              "items": [
                {
                  "text": "Kum 19:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndivyo utakavyoindoa damu ya asiye makosa katikati yako, utakapofanya yaliyo sawa machoni pa BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
