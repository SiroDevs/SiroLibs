                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena utakapokuwa huna furaha naye, mpe ruhusa aende atakako; lakini usimwuze kabisa kwa fedha, usimfanye kama mtumwa, kwa kuwa ulimtweza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
