                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nao makuhani wana wa Lawi wasongee karibu, kwa kuwa ndio aliowachagua BWANA, Mungu wako, wamtumikie, na kubariki katika jina la BWANA na kila neno lishindaniwalo, na kila pigo, litakuwa kwa kufuata maneno yao; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
