          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo umchukue kwenu nyumbani kwako, naye atanyoa kichwa, akate na kucha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
