                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Utakapokwenda vitani kupigana juu ya adui zako, na BWANA, Mungu wako, awatiapo mikononi mwako, nawe uwachukuapo mateka, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
