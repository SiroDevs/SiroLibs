                }
              ]
            }
          ]
        },
        {
          "text": " Ee BWANA, wasamehe watu wako Israeli, uliowakomboa, wala usiiache damu ya asiye makosa ikakaa katikati ya watu wako Israeli. Na ile damu utasamehewa kwao. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
