                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aonekanapo mtu ameuawa katika nchi akupayo BWANA, Mungu wako, kuimiliki, amelala kondeni, wala haijulikani ni nani aliyempiga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na watoke nje wazee wako na waamuzi wako, nao wapime hapo mpaka miji iliyomzunguka huyo aliyeuawa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na iwe, mji ulio karibu na yule aliyeuawa, wale wazee wake mji huo watwae mtamba katika kundi la ng'ombe, ambaye hajafanya kazi, wala hajakokota jembe la nira; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wazee wa mji huo na wamshushe yule mtamba mpaka bonde lenye maji ya mtoni, lisilolimwa wala kupandwa, wakamvunje yule mtamba shingo yake humo bondeni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
