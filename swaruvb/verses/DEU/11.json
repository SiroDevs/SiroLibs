            }
          ]
        },
        {
          "text": " Kwa hiyo yaangalieni maagizo yote niwaagizayo leo, mpate kuwa na nguvu, na kuingia mkaimiliki nchi mwivukiayo kuimiliki; ",
          "type": "text",
          "attrs": {
