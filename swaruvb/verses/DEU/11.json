          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Haiwi ng'ambo ya Yordani? Nyuma ya njia ya machweo ya jua, katika nchi ya Wakanaani waishio katika Araba kuelekea Gilgali, kando ya hiyo mialoni ya More? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
