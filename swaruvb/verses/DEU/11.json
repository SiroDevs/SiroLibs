                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kuwa nchi mwingiayo kuimiliki, si mfano wa nchi ya Misri mlikotoka, uliyokuwa ukipanda mbegu zako humo na kuinyunyizia maji kwa mguu wako, kama shamba la mboga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
