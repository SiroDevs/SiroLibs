          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwani ninyi mtavuka Yordani mwingie kuimiliki nchi awapayo BWANA, Mungu wenu, nanyi muimiliki na kuketi humo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyi angalieni mzifanye amri na hukumu zote niwawekeazo leo mbele yenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
