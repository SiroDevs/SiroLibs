                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitakupa nyasi katika mavue yako kulisha wanyama wako wa mifugo, nawe utakula na kushiba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
