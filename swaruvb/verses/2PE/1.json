            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro, mtumwa na mtume wa Yesu Kristo, kwa wale waliopata imani moja na sisi, yenye thamani, katika hali ya Mungu wetu, na Mwokozi Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.2"
              },
              "items": [
                {
                  "text": "Yud 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neema na iwe kwenu na amani iongezwe katika kumjua Mungu na Yesu Bwana wetu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wito na uteuzi wa Mkristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
