                "loc": "1KI.5.6"
              },
              "items": [
                {
                  "text": "1 Fal 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na mierezi isiyo na idadi; kwa kuwa Wasidoni na watu wa Tiro walimletea Daudi mierezi tele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
        {
