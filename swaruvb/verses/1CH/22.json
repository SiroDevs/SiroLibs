                "loc": "1KI.7.47"
              },
              "items": [
                {
                  "text": "1 Fal 7:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akaweka akiba tele ya chuma kwa misumari ya tarabe za malango, na kwa mafungo; na ya shaba akiba tele isiyoweza kupimika; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
