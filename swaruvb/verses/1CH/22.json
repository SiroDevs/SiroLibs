        },
        {
          "text": " Basi Daudi akaamuru wakusanyike wageni waliokuwa katika nchi ya Israeli; akaweka waashi wachonge mawe ili kujenga nyumba ya Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
