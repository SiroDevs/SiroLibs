              "attrs": {
                "loc": "1CH.29.1"
              },
              "items": [
                {
                  "text": "1 Nya 29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akasema, Sulemani mwanangu angali ni mchanga bado, na hana uzoefu, nayo nyumba atakayojengewa BWANA haina budi kuwa nzuri mno, yenye sifa na yenye fahari katika nchi zote; kwa hiyo mimi nitaiwekea akiba. Basi Daudi akaweka akiba tele kabla hajafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maagizo ya Daudi kwa Sulemani na viongozi",
          "type": "text"
        }
      ]
    },
