              },
              "items": [
                {
                  "text": "1 Nya 28:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini neno la BWANA likanijia, kusema, Wewe umemwaga damu nyingi, na vita vikubwa umevifanya; wewe hutajenga nyumba kwa ajili ya jina langu, kwa sababu umemwaga damu nyingi juu ya nchi machoni pangu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
