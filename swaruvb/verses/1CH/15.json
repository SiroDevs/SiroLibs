          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na pamoja nao ndugu zao kwa cheo cha pili, Zekaria, na Yaasieli, na Shemiramothi, na Yehieli, na Uni, na Eliabu; na Benaya, na Maaseya, na Matithia, na Elifelehu, na Mikneya, na Obed-edomu, na Yeieli, mabawabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
