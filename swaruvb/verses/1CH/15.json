          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Zekaria, na Yaasieli na Shemiramothi, na Yehieli, na Uni, na Eliabu, na Maaseya, na Benaya, wenye vinanda vya sauti ya Alamothi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
