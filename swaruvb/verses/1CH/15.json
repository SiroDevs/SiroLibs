        {
          "text": " Basi Daudi akawakusanya Israeli wote huko Yerusalemu, ili kulipandisha sanduku la BWANA, mpaka mahali pake alipoliwekea tayari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
