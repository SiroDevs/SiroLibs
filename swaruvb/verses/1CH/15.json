            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo hao waimbaji, Hemani, Asafu, na Ethani, wakaagizwa kupiga matoazi yao ya shaba kwa sauti kuu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
