          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "waongoze. Na Kenania, mkuu wa Walawi katika uimbaji, asimamie uimbaji, kwa sababu alikuwa stadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
