        },
        {
          "text": " Basi Walawi wakamwagiza Hemani mwana wa Yoeli; na wa nduguze, Asafu mwana wa Berekia; na wa wana wa Merari ndugu zao, Ethani mwana wa Kishi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
