          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Metithia, na Elifelehu, na Mikneya, na Obed-edomu, na Yeieli, na Azazia, wenye vinubi vya sauti ya Sheminithi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
