        {
          "text": "wa wana wa Merari; Asaya mkuu wao, na nduguze mia mbili na ishirini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
