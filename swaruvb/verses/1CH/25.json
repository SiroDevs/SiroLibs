                }
              ]
            }
          ]
        },
        {
          "text": " Wakapigiwa kura ya huduma zao, kwa pamoja, mdogo kwa mkubwa, mwalimu kwa mwanafunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        },
