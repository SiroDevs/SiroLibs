              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kura ya kwanza ikamtokea Yusufu, kwa Asafu; ya pili Gedalia; yeye na nduguze na wanawe, kumi na wawili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
