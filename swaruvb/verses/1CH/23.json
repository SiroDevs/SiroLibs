              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa Daudi alisema, BWANA, Mungu wa Israeli, amewastarehesha watu wake; naye hukaa Yerusalemu milele; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
            "verseOrgIds": [
