              ]
            }
          ]
        },
        {
          "text": " Wana wa Musa; Gershomu na Eliezeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Gershomu; Shebueli mkuu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wana wa Eliezeri; Rehabia mkuu wao. Yeye Eliezeri hakuwa na wana wengine; lakini wana wa Rehabia walikuwa wengi sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Ishari; Shelomithi mkuu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        },
