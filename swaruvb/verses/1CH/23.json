              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawakusanya wakuu wote wa Israeli, pamoja na makuhani na Walawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
