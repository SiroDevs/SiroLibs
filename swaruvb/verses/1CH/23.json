              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kwa maneno ya mwisho ya Daudi, hao wana wa Lawi walihesabiwa, wenye miaka ishirini na zaidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
