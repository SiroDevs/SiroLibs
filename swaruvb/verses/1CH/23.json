            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Hebroni; Yeria mkuu wao, Amaria wa pili, Yahazieli wa tatu, na Yekameamu wa nne. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        },
        {
