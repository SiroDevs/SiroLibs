          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Uzieli; Mika mkuu wao, na Ishia wa pili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Merari; Mali na Mushi. Wana wa Mali; Eleazari, na Kishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
