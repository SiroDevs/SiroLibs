          ]
        },
        {
          "text": " Hao walikuwa wana wa Lawi, kwa kufuata koo za baba zao, yaani, vichwa vya koo za baba zao waliohesabiwa, kwa hiyo hesabu ya majina yao, hao walioifanya kazi ya utumishi wa nyumba ya BWANA, wenye miaka ishirini na zaidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
