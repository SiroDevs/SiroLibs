                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wala Walawi hawahitaji tena kuichukua maskani, na vyombo vyake vyote kwa utumishi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
