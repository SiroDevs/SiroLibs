                "loc": "NUM.36.6"
              },
              "items": [
                {
                  "text": "Hes 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akafa Eleazari, wala hakuwa na wana, ila binti tu; na ndugu zao, wana wa Kishi, wakawaoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.22",
            "verseOrgIds": [
              "1CH.23.22"
            ]
          }
        },
