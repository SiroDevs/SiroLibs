        },
        {
          "text": " Wana wa Amramu; Haruni na Musa; naye Haruni akatengwa, ili ayatakase yaliyo matakatifu sana, yeye na wanawe milele, ili kufukiza uvumba mbele za BWANA, kumtumikia, na kubariki kwa jina lake, milele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
