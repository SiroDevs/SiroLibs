        },
        {
          "text": " Basi Daudi alipokuwa mzee kwa kuishi siku nyingi; alimtawaza mwanawe Sulemani awe mfalme wa Waisraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
