          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndugu zao wa koo za baba zao; Mikaeli, na Meshulamu, na Sheba, na Yorai, na Yakani, na Zia, na Eberi, watu saba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
