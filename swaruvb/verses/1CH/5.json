              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao ndio wana wa Abihaili, mwana wa Huri, mwana wa Yaroa, mwana wa Gileadi, mwana wa Mikaeli, mwana wa Yehishai, mwana wa Yado, mwana wa Buzi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
