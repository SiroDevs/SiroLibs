          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwanawe huyo ni Mika, na mwanawe huyo ni Reaya, na mwanawe huyo ni Baali; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
