              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nduguze kwa jamaa zao, hapo ilipohesabiwa nasaba ya vizazi vyao; mkuu wao, Yeieli, na Zekaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
