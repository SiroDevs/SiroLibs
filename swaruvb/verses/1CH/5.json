              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeli, alikuwa mkuu wao, na wa pili Shafamu, na Yanai, na Shafati, katika Bashani; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
