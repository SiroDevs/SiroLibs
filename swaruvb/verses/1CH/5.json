              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Yoeli; mwanawe huyo ni Shemaya, na mwanawe huyo ni Gogu, na mwanawe huyo ni Shimei; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
