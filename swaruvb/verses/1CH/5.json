        {
          "text": " Na wana wa Gadi walipakana na wana wa Reubeni, katika nchi ya Bashani mpaka Saleka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
