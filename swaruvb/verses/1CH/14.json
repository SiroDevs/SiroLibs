                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.5"
              },
              "items": [
                {
                  "text": "1 Nya 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na haya ndiyo majina ya watoto aliozaliwa huko Yerusalemu; Shamua, na Shobabu, na Nathani, na Sulemani; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ibhari, na Elishua, na Elpeleti; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Noga, na Nefegi, na Yafia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
