              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tena Daudi akazidi kuoa wake huko Yerusalemu; akazidi kuzaa wana na binti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
