              "items": [
                {
                  "text": "2 Sam 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Daudi akamwuliza Mungu tena; naye Mungu akamwambia, Hutapanda kuwafuata; zunguka mbali nao, na kuwajia ukielekea miforsadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha itakuwa utakapoisikia sauti ya kwenda katika vilele vya miforsadi, ndipo utakapokwenda nje vitani; kwa maana ndipo Mungu ametoka mbele yako, awapige jeshi la Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.25"
              },
              "items": [
                {
                  "text": "2 Sam 5:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akafanya kama vile Mungu alivyomwamuru; wakawapiga jeshi la Wafilisti toka Geba mpaka Gezeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
