              "type": "text"
            }
          ]
        },
        {
          "text": " Lakini hao Wafilisti wakajitawanya tena mara ya pili bondeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
