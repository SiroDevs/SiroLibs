                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Hiramu, mfalme wa Tiro, akatuma wajumbe kwa Daudi, akampelekea na mierezi, na waashi, na maseremala, ili wamjengee nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
