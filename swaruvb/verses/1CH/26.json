        },
        {
          "text": " Hosa naye, wa wana wa Merari, alikuwa na wana; Shimri mkuu wao; (kwani ajapokuwa yeye si mzaliwa wa kwanza, babaye alimweka mkuu); ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkia wa pili, Tebalia wa tatu, Zekaria wa nne; wana wote wa Hosa pamoja na nduguze walikuwa watu kumi na watatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika hao zilikuwa zamu za mabawabu, yaani, katika hao wakuu, wenye huduma kama ndugu zao, wa kutumika katika nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.12",
            "verseOrgIds": [
              "1CH.26.12"
            ]
          }
        },
