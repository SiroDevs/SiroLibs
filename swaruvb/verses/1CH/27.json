              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na, baada ya Ahithofeli, walikuwa Yehoyada mwana wa Benaya, na Abiathari; na jemadari wa jeshi la mfalme alikuwa Yoabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
