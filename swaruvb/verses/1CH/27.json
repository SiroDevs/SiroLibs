              },
              "items": [
                {
                  "text": "1 Fal 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kamanda wa tatu wa jeshi mwezi wa tatu alikuwa Benaya, mwana wa Yehoyada, kuhani; alikuwa mkuu, na katika zamu yake walikuwa watu elfu ishirini na nne. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
