                "loc": "2SA.23.9"
              },
              "items": [
                {
                  "text": "2 Sam 23:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na juu ya zamu ya mwezi wa pili alikuwa Dodai, Mwahohi, na zamu yake; na Miklothi alikuwa afisa mkuu; na katika zamu yake walikuwa watu elfu ishirini na nne. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
