          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na juu ya makundi ya kondoo alikuwa Yazizi, Mhagri. Hao wote walikuwa watumishi wa akiba alizokuwa nazo mfalme Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
