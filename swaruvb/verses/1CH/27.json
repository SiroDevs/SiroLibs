                "loc": "GEN.38.29"
              },
              "items": [
                {
                  "text": "Mwa 38:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeye alikuwa wa wana wa Peresi, mkuu wa makamanda wote wa jeshi mwezi wa kwanza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
