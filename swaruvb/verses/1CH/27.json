              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa wana wa Efraimu, Hoshea mwana wa Azazia, wa nusu kabila la Manase, Yoeli mwana wa Pedaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
