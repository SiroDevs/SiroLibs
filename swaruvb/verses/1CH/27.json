                  "text": "Wim 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na juu ya mashamba ya mizabibu alikuwa Shimei, Mramathi; na juu ya mazao ya mizabibu kwa ghala za mvinyo alikuwa Zabdi, Mshifmi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
