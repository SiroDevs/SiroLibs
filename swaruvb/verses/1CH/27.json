              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa nusu kabila la Manase katika Gileadi, Ido mwana wa Zekaria; wa Benyamini, Yaasieli mwana wa Abneri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
