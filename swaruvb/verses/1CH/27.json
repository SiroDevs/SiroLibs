              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.8"
              },
              "items": [
                {
                  "text": "2 Sam 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
