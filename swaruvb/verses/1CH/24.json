        },
        {
          "text": " Na zamu za wana wa Haruni ni hizi. Wana wa Haruni; Nadabu, na Abihu, na Eleazari, na Ithamari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
