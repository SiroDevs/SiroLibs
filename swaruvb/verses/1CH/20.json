                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata ikawa, mwanzo wa mwaka mpya, wakati watokapo wafalme kwenda vitani, Yoabu akawaongoza mashujaa wa jeshi, akaiteka nyara nchi ya wana wa Amoni, akaja akauzingira Raba. Lakini Daudi akakaa Yerusalemu. Naye Yoabu akaupiga Raba akauangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.30"
              },
              "items": [
                {
                  "text": "2 Sam 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Daudi akatwaa taji la Milkomu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:2",
              "type": "text"
            },
            {
              "text": "Katika makala zingine ni mfalme wao.",
              "type": "text"
            }
          ]
        },
        {
          "text": " toka kichwani pake, akaona ya kwamba uzani wake ni talanta ya dhahabu, na kulikuwa na vito vya thamani ndani yake; akavikwa Daudi kichwani; akazitoa nyara za mji, nyingi sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hao watu waliokuwamo akawatoa, akawawafanyisha kazi kwa misumeno, na kwa sululu za chuma, na kwa mashoka. Ndivyo alivyofanya Daudi kwa miji yote ya wana wa Amoni. Nao wakarudi Yerusalemu Daudi na watu wote.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kushindwa kwa Wafilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa baada ya hayo, kulitokea vita na Wafilisti huko Gezeri; ndipo Sibekai, Mhushathi, alipomwua Safu, mmojawapo wa Warefai;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:4",
              "type": "text"
            },
            {
              "text": "Au, wana wa jitu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nao Wafilisti",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:4",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania hakuna Wafilisti.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wakashindwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na vita tena na Wafilisti; na Elhanani, mwana wa Yairi akamwua Lahmi nduguye Goliathi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:5",
              "type": "text"
            },
            {
              "text": "Au, Mbethlehemi akamwua nduguye Goliathi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mgiti, ambaye mti wa mkuki wake ulikuwa kama mti wa mfumaji. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulikuwa na vita tena huko Gathi; ambapo palikuwa na mtu mrefu sana, mwenye vidole vya mikono na miguu ishirini na vinne, kila mguu sita, na kila mkono sita; naye alizaliwa na Mrefai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:6,8",
              "type": "text"
            },
            {
              "text": "Au, huyu jitu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye huyo alipowatukana Israeli, Yonathani, mwana wa Shama, nduguye Daudi, akamwua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao walizaliwa kwake huyo Mrefai",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:6,8",
              "type": "text"
            },
            {
              "text": "Au, huyu jitu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa Gathi, nao wakaanguka kwa mkono wa Daudi, na kwa mkono wa watumishi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
