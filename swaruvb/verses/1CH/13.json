              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.5"
              },
              "items": [
                {
                  "text": "2 Sam 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakacheza Daudi na Israeli wote, mbele za Mungu, kwa nguvu zao zote; na kwa nyimbo na kwa vinubi, na kwa vinanda, na kwa matari, na kwa matoazi, na kwa tarumbeta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
