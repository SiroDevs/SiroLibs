                  "text": "Law 10:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo hasira ya BWANA ikawaka juu ya Uza, naye akampiga, kwa sababu alilinyoshea sanduku mkono wake, hadi akafa pale pale mbele za Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi akaona uchungu, kwa kuwa BWANA amemfurikia Uza; akapaita mahali pale Peres-uza",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:11",
              "type": "text"
            },
            {
              "text": "Tazama 2 Sam 6:8",
              "type": "text"
            }
          ]
        },
        {
          "text": " hata leo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi akamwogopa Mungu siku ile, akasema, Nitajileteaje sanduku la Mungu kwangu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi hakujichukulia sanduku mjini mwa Daudi, ila akalihamisha kando na kulitia nyumbani kwa Obed-edomu, Mgiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
