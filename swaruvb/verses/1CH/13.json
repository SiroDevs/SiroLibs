              "items": [
                {
                  "text": "1 Sam 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Daudi akapanda, yeye na Israeli wote, mpaka Baala, ndio Kiriath-yearimu, ulio wa Yuda, ili kulileta toka huko sanduku la Mungu, BWANA akaaye juu ya makerubi, lililoitwa kwa Jina lake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
