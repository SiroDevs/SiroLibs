        },
        {
          "text": " nasi tujirudishie tena sanduku la Mungu wetu; maana hatukulitilia maanani katika siku za Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
