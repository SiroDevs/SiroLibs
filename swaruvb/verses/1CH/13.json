              "items": [
                {
                  "text": "2 Sam 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata walipofika penye uga wa Nakoni, Uza akaunyosha mkono wake alishike sanduku; kwa maana wale ng'ombe walijikwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
