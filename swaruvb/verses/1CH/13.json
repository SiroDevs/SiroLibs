              },
              "items": [
                {
                  "text": "Hes 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakalipandisha sanduku la Mungu juu ya gari jipya kutoka nyumba ya Abinadabu; na Uza na Ahio wakaliendesha lile gari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
