              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao jamii nzima wakasema ya kwamba watafanya hivyo; kwa kuwa neno hilo lilikuwa jema machoni pa watu wote. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        },
        {
