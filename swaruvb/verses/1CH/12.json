          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elkana, na Ishia, na Azaleli, na Yoezeri, na Yashobeamu, Wakora; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
