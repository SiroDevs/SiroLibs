        },
        {
          "text": " Basi hawa ndio wale waliomjia Daudi huko Siklagi, alipokuwa akijificha kwa ajili ya Sauli, mwana wa Kishi; nao walikuwamo miongoni mwa wale mashujaa, waliomsaidia vitani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
