          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yoela, na Zebadia, wana wa Yerohamu, wa Gedori. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
