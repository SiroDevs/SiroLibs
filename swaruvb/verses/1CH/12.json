                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Yud 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Daudi akatoka ili kuwalaki, akajibu, akawaambia, Kama mmenijia kwa amani ili kunisaidia, basi nitawapokea kwa moyo wote; lakini kama mmekuja ili kunisaliti kwa adui zangu, ingawa hamna udhalimu mikononi mwangu, Mungu wa baba zetu na alitazame neno hili, na kulikemea. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
