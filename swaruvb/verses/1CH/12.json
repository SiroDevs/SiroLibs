                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.8"
              },
              "items": [
                {
                  "text": "1 Nya 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.15"
              },
              "items": [
                {
                  "text": "Eze 44:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tena Sadoki, kijana shujaa, na wa nyumba ya babaye, makamanda ishirini na wawili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa wana wa Benyamini nduguze Sauli, elfu tatu; kwani hata sasa walio wengi wao walikuwa wameuhifadhi uaminifu wao kwa nyumba ya Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa wana wa Efraimu, elfu ishirini na mia nane, wanaume mashujaa, watu wenye sifa katika koo za baba zao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa nusu kabila la Manase, elfu kumi na nane, waliotajwa majina yao, ili waje kumtawaza Daudi awe mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.13"
              },
              "items": [
                {
                  "text": "Est 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wa wana wa Isakari, watu wenye akili za kujua nyakati, kuyajua yawapasayo Israeli wayatende; vichwa vyao walikuwa watu mia mbili na ndugu zao wote walikuwa chini ya amri yao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa Zabuloni, watu wawezao kwenda pamoja na jeshi, hodari wa kupanga vita, wenye zana za vita za kila namna, elfu hamsini; askari stadi waliolenga tu kumsaidia Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa Naftali, makamanda elfu moja, na pamoja nao watu wenye ngao na mkuki elfu thelathini na saba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa Wadani, watu hodari wa kupanga vita, elfu ishirini na nane na mia sita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa Asheri, watu wawezao kwenda pamoja na jeshi, hodari wa kupanga vita, elfu arubaini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, ng'ambo ya pili ya Yordani, wa Wareubeni, na wa Wagadi, na wa nusu kabila la Manase, wenye zana za vita za kupigania za kila namna, elfu mia moja na ishirini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao wote, watu wa vita, askari stadi, wakaja Hebroni wakiwa na nia moja ya kumtawaza Daudi awe mfalme juu ya Israeli wote; tena wote waliosalia wa Israeli nao walikuwa na moyo mmoja kwamba wamtawaze Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao walikuwako huko pamoja na Daudi siku tatu, wakila na kunywa; kwani ndugu zao walikuwa wamewaandalia tayari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaidi ya hayo, wale waliokuwa karibu nao, hata mpaka kwa Isakari, na Zabuloni, na Naftali, wakaleta chakula juu ya punda, na ngamia, na nyumbu, na ng'ombe, vyakula vya unga, mikate ya tini, na vichala vya zabibu kavu, na divai, na mafuta, na ng'ombe, na kondoo tele; kwa kuwa kulikuwa na furaha katika Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    }
