              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Daudi akawakaribisha, akawaweka wawe makamanda wa kile kikosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
