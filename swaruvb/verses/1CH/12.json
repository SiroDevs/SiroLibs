              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao Wagadi walikuwa makamanda wa jeshi, yeye aliyekuwa mdogo amelingana na mia moja, na yeye aliyekuwa mkuu, na elfu moja. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
