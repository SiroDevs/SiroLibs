                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo roho ikamjia Abishai, mkuu wa wale thelathini, naye akasema,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
