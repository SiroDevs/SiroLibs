                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.1"
              },
              "items": [
                {
                  "text": "1 Sam 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hizi ni hesabu za vichwa vya watu wenye silaha za vita, waliokuja Hebroni kwa Daudi, ili kumpa ufalme wa Sauli, sawasawa na neno la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Yuda, waliochukua ngao na mkuki, walikuwa elfu sita na mia nane, wenye silaha za vita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa wana wa Simeoni, wanaume mashujaa wa vita, elfu saba na mia moja. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa wana wa Lawi, elfu nne na mia sita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yehoyada alikuwa kichwa cha ukoo wa Haruni, na pamoja naye walikuwa watu elfu tatu na mia saba; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.17"
              },
              "items": [
                {
                  "text": "2 Sam 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.8"
              },
              "items": [
                {
                  "text": "1 Fal 1:8",
                  "type": "text"
                }
