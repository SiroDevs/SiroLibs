                  "text": "Amu 20:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walikuwa wenye kupinda upinde, nao walikuwa hodari wa kutumia mkono wa kulia na wa kushoto, kwa kutupa mawe ya teo, na kwa kupiga mishale ya upinde; walikuwa wa nduguze Sauli, wa Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
