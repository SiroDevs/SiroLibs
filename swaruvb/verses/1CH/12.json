        },
        {
          "text": " Na wa Wagadi wakajitenga kumfuata Daudi ngomeni huko nyikani, wanaume mashujaa, watu waliozoea vita, walioweza kutumia ngao na mkuki; ambao nyuso zao zilikuwa kama nyuso za simba, nao walikuwa wepesi kama kulungu juu ya milima; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezeri mkubwa wao, Obadia wa pili, Eliabu wa tatu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishmana wa nne, Yeremia wa tano; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atai wa sita, Elieli wa saba; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana wa nane, Elzabadi wa tisa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia wa kumi, Makbanai wa kumi na moja.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        }
