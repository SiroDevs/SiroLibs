          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eluzai, na Yerimothi, na Bealia, na Shemaria, na Shefatia Mharufi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
