              "items": [
                {
                  "text": "49:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hao ndio wale waliovuka Yordani katika mwezi wa kwanza, ulipofurika kingo zake zote; nao wakawakimbiza wote wa bondeni kuelekea mashariki na magharibi pia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena wakafika ngomeni kwa Daudi baadhi ya wana wa Benyamini na Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
