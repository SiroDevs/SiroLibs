              "items": [
                {
                  "text": "1 Nya 16:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.4"
              },
              "items": [
                {
                  "text": "1 Fal 3:4",
