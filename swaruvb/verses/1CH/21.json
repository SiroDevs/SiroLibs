                  "text": "1 Sam 9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye BWANA akanena na Gadi, mwonaji wake Daudi, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.9",
            "verseOrgIds": [
              "1CH.21.9"
            ]
          }
