              "items": [
                {
                  "text": "2 Nya 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana ile maskani ya BWANA, aliyoifanya Musa jangwani, na madhabahu ya sadaka ya kuteketezwa, vilikuwapo wakati huo mahali pa juu pa Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
