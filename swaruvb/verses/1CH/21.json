            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati huo, Daudi alipoona ya kwamba BWANA amemwitikia katika kiwanja cha Arauna, Myebusi, ndipo alipotoa dhabihu huko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
