          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.24"
              },
              "items": [
                {
                  "text": "Law 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1"
              },
              "items": [
                {
                  "text": "2 Nya 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.7.1"
              },
              "items": [
                {
                  "text": "7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Daudi akamjengea BWANA madhabahu huko, akatoa sadaka za kuteketezwa na sadaka za amani, akamlingana BWANA; naye akamwitikia kutoka mbinguni kwa moto juu ya madhabahu hiyo ya sadaka ya kuteketezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA naye akamwamuru malaika; naye akaurudisha upanga wake alani mwake tena.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        }
      ]
    },
    {
