        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda ukanene na Daudi, ukisema, BWANA asema hivi, Nakuwekea mambo matatu; katika haya ujichagulie moja, nikutendee hilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Gadi akamwendea Daudi, akamwambia, BWANA asema hivi, Jichagulie upendavyo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
