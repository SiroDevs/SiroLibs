                  "text": "Mwa 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.18"
              },
              "items": [
                {
                  "text": "Amu 2:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Mungu akatuma malaika aende Yerusalemu ili auangamize; naye alipokuwa tayari kuangamiza, BWANA akatazama, akaghairi katika mabaya, akamwambia malaika aharibuye, Basi yatosha; sasa ulegeze mkono wako. Naye malaika wa BWANA akasimama karibu na kiwanja cha kupuria cha Arauna,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:15",
              "type": "text"
            },
            {
              "text": "Au, Ornani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Myebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1"
              },
              "items": [
                {
                  "text": "2 Nya 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akainua macho yake, akamwona huyo malaika wa BWANA amesimama kati ya nchi na mbingu, naye alikuwa na upanga wazi mkononi, umenyoshwa juu ya Yerusalemu. Ndipo Daudi na wazee wakaanguka kifudifudi, nao wamevaa nguo za magunia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.16",
            "verseOrgIds": [
              "1CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akamwambia Mungu, Je! Si mimi niliyeamuru watu wahesabiwe? Naam, mimi ndimi niliyekosa, na kufanya yaliyo maovu sana; lakini kondoo hawa, wamefanya nini? Mkono wako, nakusihi, Ee BWANA, Mungu wangu, na uwe juu yangu, na juu ya nyumba ya babangu; wala si juu ya watu wako, hata wao wapigwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Madhabahu ya Daudi na sadaka yake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo huyo malaika wa BWANA akamwamuru Gadi kwamba amwambie Daudi, ya kuwa Daudi akwee, akamwinulie BWANA madhabahu katika kiwanja cha kupuria cha Arauna, Myebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi akakwea kulingana na neno la Gadi, alilolinena kwa jina la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna alipogeuka, na kumwona yule malaika, ndipo yeye na wanawe wanne waliokuwa pamoja naye wakajificha. Naye Arauna alikuwa akipura ngano. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
              "1CH.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi alipokuwa akimjia Arauna, Arauna akatazama, akamwona Daudi, akatoka katika kile kiwanja, akamsujudia Daudi kifudifudi hadi chini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.48"
              },
              "items": [
                {
                  "text": "Hes 16:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.8"
              },
              "items": [
                {
                  "text": "25:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Daudi akamwambia Arauna, Unipe mahali pa kiwanja hiki, ili kwamba nimjengee BWANA madhabahu hapa; kwa thamani yake kamili utanipa; ili kwamba tauni izuiliwe katika watu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna akamwambia Daudi, Ujitwalie, na bwana wangu mfalme na afanye yaliyo mema machoni pake; tazama, ng'ombe kwa sadaka za kuteketezwa, na vyombo vya kupuria kwa kuni, na ngano kwa sadaka ya unga, nazitoa; zote nazitoa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme Daudi akamwambia Arauna, La, sivyo, lakini kweli nitazinunua kwa thamani yake kamili; kwani sitamtwalia BWANA kilicho chako, wala kutoa sadaka ya kuteketezwa isiyo na gharama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.24"
              },
              "items": [
                {
                  "text": "2 Sam 24:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Daudi akampimia Arauna thamani ya mahali pale shekeli mia sita za dhahabu kwa uzani ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
