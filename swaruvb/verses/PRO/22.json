              "type": "text"
            }
          ]
        },
        {
          "text": "Tega sikio lako uyasikie maneno ya wenye hekima, na kuuelekeza moyo wako kwa maarifa yangu; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
              "PRO.22.17"
            ]
          }
        },
        {
