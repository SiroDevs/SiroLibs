          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili matumaini yako uyaweke kwa BWANA, leo nimekujulisha wewe haya, naam, wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        },
        {
