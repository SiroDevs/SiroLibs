          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "maana ni vizuri kuyahifadhi ndani yako, hali yakithibitika pamoja midomoni mwako. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        },
        {
