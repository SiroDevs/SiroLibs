          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwapa wajinga werevu, na kijana maarifa na tahadhari; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwenye hekima asikie na kuongezewa elimu, na mwenye ufahamu ayafikie mashauri yenye njia. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufahamu mithali na kitendawili, na maneno ya wenye hekima na mafumbo yao. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        },
