              "items": [
                {
                  "text": "Mit 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kufundishwa matendo ya busara, katika haki na hukumu na adili. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
