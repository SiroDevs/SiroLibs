                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bali, kinyume cha hayo, walipoona ya kuwa nimekabidhiwa Injili ya wasiotahiriwa, kama vile Petro alivyokabidhiwa ya waliotahiriwa; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
