          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.3"
              },
              "items": [
                {
                  "text": "Mdo 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini Tito aliyekuwa pamoja nami, naye ni Mgiriki, hakulazimishwa kutahiriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
