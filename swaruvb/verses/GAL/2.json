              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Kefa alipokuja Antiokia, nilishindana naye uso kwa uso, kwa sababu alistahili hukumu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
