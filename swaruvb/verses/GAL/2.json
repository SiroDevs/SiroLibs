            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ikiwa sisi wenyewe, kwa kutafuta kuhesabiwa haki katika Kristo, tulionekana kuwa wenye dhambi, je! Kristo amekuwa mtumishi wa dhambi? La hasha! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
