              "attrs": {
                "loc": "GAL.6.9"
              },
              "items": [
                {
                  "text": "Gal 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nilikwenda kwa kuwa nilifunuliwa, nikawaeleza Injili ile niihubiriyo katika Mataifa, lakini kwa faragha kwa hao viongozi waliosifika, isiwe labda napiga mbio bure, au nilipiga mbio bure. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
