          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(maana yeye aliyemwezesha Petro kuwa mtume wa waliotahiriwa ndiye aliyeniwezesha mimi kwenda kwa Mataifa); ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
