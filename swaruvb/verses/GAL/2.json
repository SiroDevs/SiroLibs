                  "text": "Yn 1:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tena Yakobo, Kefa, na Yohana, waliosifika kuwa ni nguzo, walipoitambua ile neema niliyopewa, walinipa mimi na Barnaba mkono wa kulia wa kuonesha ushirikiano; ili sisi tuende kwa Mataifa, na wao waende kwa watu wa tohara; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
