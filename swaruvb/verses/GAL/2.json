                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha, baada ya miaka kumi na minne, nilipanda tena kwenda Yerusalemu pamoja na Barnaba, nikamchukua na Tito pamoja nami. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
