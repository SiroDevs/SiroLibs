                "loc": "ACT.15.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali kwa ajili ya ndugu za uongo walioingizwa kwa siri; ambao waliingia kwa siri ili kuupeleleza uhuru wetu tulio nao katika Kristo Yesu, ili watutie utumwani; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
