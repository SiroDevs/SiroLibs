              "items": [
                {
                  "text": "Mdo 11:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana kabla hawajaja watu kadhaa waliotoka kwa Yakobo, alikuwa akila pamoja na watu wa Mataifa; lakini hao walipokuja, akarudi nyuma akajitenga, huku akiwaogopa waliotahiriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hao Wayahudi wengine wakajigeuza pamoja naye, hata na Barnaba pia akachukuliwa na unafiki wao. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini, nilipoona ya kuwa njia yao haiendi sawasawa na ile kweli ya Injili, nilimwambia Kefa mbele ya wote, Ikiwa wewe uliye Myahudi wafuata desturi za Mataifa, wala si za Wayahudi, kwa nini unawashurutisha Mataifa kufuata desturi za Wayahudi?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wayahudi na Mataifa huokolewa kwa imani",
          "type": "text"
        }
      ]
