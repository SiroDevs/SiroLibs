              },
              "items": [
                {
                  "text": "Gal 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ambao hata saa moja hatukujitia chini yao, ili kwamba kweli ya Injili ikae pamoja nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
