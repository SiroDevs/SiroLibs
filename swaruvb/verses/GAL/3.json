        },
        {
          "text": " Torati ni nini basi? Iliingizwa kwa sababu ya makosa, hadi aje huyo mzao aliyepewa ile ahadi; iliamriwa kwa utumishi wa malaika kwa mkono wa mjumbe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.19",
            "verseOrgIds": [
              "GAL.3.19"
            ]
          }
        },
        {
          "name": "verse",
