          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi aliye mjumbe si mjumbe wa mmoja; bali Mungu ni mmoja. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
        },
        {
