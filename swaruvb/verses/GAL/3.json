                "loc": "ROM.11.6"
              },
              "items": [
                {
                  "text": "11:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana urithi ukiwa kwa sheria, hauwi tena kwa ahadi; lakini Mungu alimkirimia Abrahamu kwa njia ya ahadi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
