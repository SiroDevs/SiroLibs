            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.7"
              },
              "items": [
                {
                  "text": "24:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi ahadi zilinenwa kwa Abrahamu na kwa mzao wake. Hasemi, Kwa wazawa, kana kwamba ni wengi, bali kana kwamba ni mmoja, Kwa mzao wako, yaani, Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Kut 12:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nisemalo ni hili; agano lililothibitishwa kwanza na Mungu, torati iliyotokea miaka mia nne na thelathini baadaye hailitangui, hata kuibatilisha ile ahadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
