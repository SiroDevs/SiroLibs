                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Rum 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Fahamuni basi, ya kuwa wale walio wa imani, hao ndio wana wa Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Mwa 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.18"
              },
              "items": [
                {
                  "text": "18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Mdo 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na andiko, kwa vile lilivyoona tangu zamani kwamba Mungu atawahesabia haki Mataifa kwa imani, lilimhubiria Abrahamu Habari Njema zamani, kusema, Katika wewe Mataifa yote watabarikiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Rum 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi hao walio wa imani hubarikiwa pamoja na Abrahamu aliyekuwa mwenye imani. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.26"
              },
              "items": [
                {
                  "text": "Kum 27:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana wale wote walio wa matendo ya sheria, wako chini ya laana; maana imeandikwa, Amelaaniwa kila mtu asiyedumu katika yote yaliyoandikwa katika kitabu cha Torati, ayafanye. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Hab 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.17"
              },
              "items": [
                {
                  "text": "Rum 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.38"
              },
              "items": [
                {
                  "text": "Ebr 10:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni dhahiri ya kwamba hakuna mtu ahesabiwaye haki mbele za Mungu katika sheria; kwa sababu Mwenye haki ataishi kwa imani. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.11",
            "verseOrgIds": [
              "GAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Law 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.5"
              },
              "items": [
                {
                  "text": "Rum 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na torati haikuja kwa imani, bali, Ayatendaye hayo ataishi katika hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.12",
            "verseOrgIds": [
              "GAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
