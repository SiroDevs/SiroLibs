            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.21"
              },
              "items": [
                {
                  "text": "2 Kor 5:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kristo alitukomboa katika laana ya torati, kwa kuwa alifanywa laana kwa ajili yetu; maana imeandikwa, Amelaaniwa kila mtu aangikwaye juu ya mti; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kwamba baraka ya Abrahamu iwafikie Mataifa katika Yesu Kristo, tupate kupokea ahadi ya Roho kwa njia ya imani.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
