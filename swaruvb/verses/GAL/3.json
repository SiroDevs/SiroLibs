        },
        {
          "text": " Lakini kabla ya kuja ile imani tulikuwa tumewekwa chini ya sheria, tumefungwa mpaka ije ile imani itakayofunuliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
