              "items": [
                {
                  "text": "2 Kor 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nina matumaini kwenu katika Bwana, ya kwamba hamtakuwa na nia ya namna nyingine. Lakini yeye anayewasumbua atachukua hukumu yake, awaye yote. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.10",
            "verseOrgIds": [
              "GAL.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.23"
              },
              "items": [
                {
                  "text": "1 Kor 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami, ndugu zangu ikiwa ninahubiri habari ya kutahiriwa, kwa nini ningali ninaudhiwa? Kwa kufanya hivyo kikwazo cha msalaba kimeondolewa! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.11",
            "verseOrgIds": [
              "GAL.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.12.3"
              },
              "items": [
                {
                  "text": "Zab 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Laiti hao wanaowatia mashaka wangejikata nafsi zao!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.12",
            "verseOrgIds": [
              "GAL.5.12"
            ]
