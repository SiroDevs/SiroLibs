                "loc": "1CO.5.6"
              },
              "items": [
                {
                  "text": "1 Kor 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Chachu kidogo huchachua donge zima. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.9",
            "verseOrgIds": [
              "GAL.5.9"
            ]
          }
