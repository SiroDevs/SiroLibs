                "loc": "GAL.1.6"
              },
              "items": [
                {
                  "text": "Gal 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kushawishi huku hakukutoka kwake yeye anayewaita ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.8",
            "verseOrgIds": [
              "GAL.5.8"
            ]
          }
        },
        {
