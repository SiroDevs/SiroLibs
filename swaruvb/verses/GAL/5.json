              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nasema, Nendeni kwa Roho, wala hamtazitimiza kamwe tamaa za mwili. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
