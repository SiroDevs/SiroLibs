              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Law 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana torati yote imetimilika katika neno moja, nalo ni hili, Umpende jirani yako kama nafsi yako. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.14",
            "verseOrgIds": [
              "GAL.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mkiumana na kulana, angalieni msije mkaangamizana.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        }
