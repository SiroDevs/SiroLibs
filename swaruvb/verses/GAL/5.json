              "items": [
                {
                  "text": "1 Pet 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu mwili hutamani ukishindana na Roho, na Roho kushindana na mwili; kwa maana hizi zimepingana, hata hamwezi kufanya mnayotaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
