              "type": "text"
            }
          ]
        },
        {
          "text": " Maana ninyi, ndugu, mliitwa mpate uhuru; lakini uhuru wenu usiwe sababu ya kuufuata mwili, bali tumikianeni kwa upendo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
