              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana, ndugu zangu, Injili hiyo niliyowahubiria, nawajulisha ya kuwa siyo ya namna ya kibinadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa sikuipokea kwa mwanadamu wala sikufundishwa na mwanadamu, bali kwa ufunuo wa Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
