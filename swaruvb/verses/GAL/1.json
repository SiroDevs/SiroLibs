                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neema na iwe kwenu, na amani, zitokazo kwa Mungu Baba, na kwa Bwana wetu Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
