        },
        {
          "text": " ambaye alijitoa nafsi yake kwa ajili ya dhambi zetu, ili atuokoe na dunia hii mbovu iliyopo sasa, kama alivyopenda Mungu, Baba yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
