                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami niliendelea katika dini ya Kiyahudi kuliko wengi walio hirimu zangu katika kabila yangu, nikajitahidi sana katika kuyashika mapokeo ya baba zangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
