            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala si nyingine; lakini wapo watu wawataabishao na kutaka kuigeuza Injili ya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.22"
              },
              "items": [
                {
                  "text": "1 Kor 16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini ijapokuwa sisi au malaika wa mbinguni atawahubiria ninyi Injili yoyote isipokuwa hiyo tuliyowahubiria, na alaaniwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama tulivyotangulia kusema, na sasa, nasema tena, mtu awaye yote akiwahubiria ninyi Injili yoyote isipokuwa hiyo mliyoipokea, na alaaniwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        }
