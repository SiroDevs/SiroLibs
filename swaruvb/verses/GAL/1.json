                }
              ]
            }
          ]
        },
        {
          "text": " Paulo, mtume, (si mtume wa wanadamu, wala kutumwa na mwanadamu, bali na Yesu Kristo, na Mungu Baba aliyemfufua kutoka kwa wafu), ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
