              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashangaa kwa kuwa mnamwacha upesi hivi yeye aliyewaita katika neema ya Kristo, na kugeukia Injili ya namna nyingine. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
