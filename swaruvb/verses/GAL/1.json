                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana mmesikia habari za mwenendo wangu zamani katika dini ya Kiyahudi, kwamba nililitesa kanisa la Mungu kupita kiasi, nikaliharibu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
