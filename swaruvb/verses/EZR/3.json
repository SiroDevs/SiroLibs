              "type": "text"
            }
          ]
        },
        {
          "text": "Tangu siku ya kwanza ya mwezi wa saba walianza kumtolea BWANA sadaka za kuteketezwa, lakini msingi wa hekalu la BWANA ulikuwa haujawekwa bado. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
