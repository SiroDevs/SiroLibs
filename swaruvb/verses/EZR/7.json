          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ezra akafika Yerusalemu mwezi wa tano katika mwaka wa saba wa huyo mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
