              "items": [
                {
                  "text": "Ezr 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa katika mwaka wa kwanza wa Koreshi, mfalme wa Uajemi, ili kwamba neno la BWANA alilolisema kwa kinywa cha Yeremia lipate kutimizwa, BWANA akaamsha roho yake Koreshi, mfalme wa Uajemi, hata akapiga mbiu katika ufalme wake wote, akaiandika pia, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
