            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Isa 44:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Koreshi, mfalme wa Uajemi asema hivi;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        }
