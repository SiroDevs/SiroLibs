              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.13"
              },
              "items": [
                {
                  "text": "Flp 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo wakaondoka wakuu wa koo za mababa, wa Yuda na Benyamini, na makuhani, na Walawi, naam, watu wote ambao Mungu ameamsha roho zao kukwea, ili kuijenga nyumba ya BWANA, iliyoko Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na watu wote waliokaa karibu nao pande zote wakawatia nguvu mikono yao, kwa vyombo vya fedha, kwa dhahabu, kwa mali, na kwa wanyama, na vitu vya thamani, zaidi ya vile vilivyotolewa kwa hiari ya mtu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.14"
              },
              "items": [
                {
                  "text": "Ezr 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.5"
              },
              "items": [
                {
                  "text": "6:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.13"
              },
              "items": [
                {
                  "text": "2 Fal 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Nya 36:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena Koreshi, mfalme, alivitoa vyombo vya nyumba ya BWANA, alivyokuwa amevileta Nebukadneza",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:7",
              "type": "text"
            },
            {
              "text": "Au, Nebukadreza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " toka Yerusalemu, na kuvitia katika nyumba ya miungu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.14"
              },
              "items": [
                {
                  "text": "Ezr 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Hag 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naam, vyombo vile ndivyo alivyovitoa Koreshi, mfalme wa Uajemi, kwa mkono wa Mithredathi, mtunza hazina; naye akavihesabu mbele ya Sheshbaza, mkuu wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hii ndiyo hesabu yake; sinia za dhahabu thelathini, sinia za fedha elfu moja, visu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:9",
              "type": "text"
            },
            {
              "text": "Au, vyetezo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ishirini na tisa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mabakuli ya dhahabu thelathini, mabakuli ya fedha ya namna ya pili mia nne na kumi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:10",
              "type": "text"
            },
            {
              "text": "Au; mabakuli ya fedha elfu mbili mia nne na kumi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na vyombo vingine elfu moja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyombo vyote vya dhahabu na vya fedha vilikuwa jumla yake elfu tano na mia nne. Hivyo vyote Sheshbaza akakwea navyo, hapo walipokwea wale wa uhamisho kutoka Babeli mpaka Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
