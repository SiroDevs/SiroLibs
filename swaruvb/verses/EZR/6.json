        {
          "text": " wapate kumtolea Mungu wa mbinguni sadaka zenye harufu nzuri, na kumwombea mfalme, na wanawe, wapate uzima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
            "verseOrgIds": [
