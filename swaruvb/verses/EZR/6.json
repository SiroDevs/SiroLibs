            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kitabu kimoja kilipatikana huko Akmetha, katika nyumba ya mfalme iliyo katika wilaya ya Umedi, na ndani yake maneno haya yameandikwa ili yakumbukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika mwaka wa kwanza wa mfalme Koreshi, mfalme Koreshi alitoa amri, Kuhusu nyumba ya Mungu huko Yerusalemu, nyumba hiyo na ijengwe, mahali watoapo dhabihu, na misingi yake ipigwe na kufanywa imara sana; kuinuka kwake kuwe mikono sitini, na upana wake mikono sitini; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
