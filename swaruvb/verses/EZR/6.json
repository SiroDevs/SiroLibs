              "type": "text"
            }
          ]
        },
        {
          "text": " Ndipo mfalme Dario akatoa amri, na watu wakachunguza katika nyumba ya kuhifadhia vitabu vya kumbukumbu ambapo hati ziliwekwa katika Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
