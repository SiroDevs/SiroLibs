              "items": [
                {
                  "text": "Isa 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana sisi tu watumwa; lakini Mungu wetu hakutuacha katika utumwa wetu, bali ametufikishia rehema zake, mbele ya wafalme wa Uajemi, ili kutupa maisha mapya, kuisimamisha nyumba ya Mungu wetu, na kuitengeneza palipobomoka, na atulinde",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.9",
            "verseOrgIds": [
              "EZR.9.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:9",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni ‘atupe ukuta’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " katika Yuda na Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.9",
            "verseOrgIds": [
              "EZR.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sasa, Ee Mungu wetu, tuseme nini baada ya hayo? Maana tumeziacha amri zako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.10",
            "verseOrgIds": [
              "EZR.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ulizoziamuru kwa midomo ya watumishi wako, manabii, ukisema, Nchi ile, mnayoiendea ili kuimiliki, ni nchi ya uchafu, kwa sababu ya uchafu wa watu wa nchi zile, kwa ajili ya machukizo yao, yaliyoijaza tangu upande huu mpaka upande huu, kwa uchafu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.11",
            "verseOrgIds": [
              "EZR.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
