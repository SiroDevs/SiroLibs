              "items": [
                {
                  "text": "Mit 13:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, msiwape wana wao binti zenu, wala msitwae binti zao kuwa wake za wana wenu, wala msiwatakie amani wala kufanikiwa milele; ili mpate kuwa hodari, na kula wema wa nchi hiyo, na kuwaachia watoto wenu iwe urithi wa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.12",
            "verseOrgIds": [
              "EZR.9.12"
            ]
          }
        },
