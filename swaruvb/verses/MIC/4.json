                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali wataketi kila mtu chini ya mzabibu wake, na chini ya mtini wake; wala hapana mtu atakayewatia hofu; kwa kuwa kinywa cha BWANA wa majeshi kimesema hivi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
