                {
                  "text": "Dan 2:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini itakuwa katika siku za mwisho, ya kwamba mlima wa nyumba ya BWANA utawekwa imara juu ya milima, nao utainuliwa juu ya vilima; na watu wa mataifa watauendea makundi makundi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
