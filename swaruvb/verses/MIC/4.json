                {
                  "text": "Isa 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.14"
              },
              "items": [
                {
                  "text": "Dan 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.33"
              },
              "items": [
                {
                  "text": "Lk 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Ufu 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitamfanya yeye aliyechechemea kuwa mabaki, na yeye aliyetupwa mbali kuwa taifa lenye nguvu, na BWANA atawamiliki katika mlima Sayuni tangu sasa na hata milele. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wewe, Ee mnara wa kundi, kilima cha binti Sayuni, utajiliwa; naam, mamlaka ya kwanza yatakuja, ufalme wa binti Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa mbona unapiga kelele? Je! Hakuna mfalme kwako, mshauri wako amepotea, hata umeshikwa na uchungu kama mwanamke wakati wa kuzaa? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe na uchungu, utaabike ili uzae, Ee binti Sayuni, kama mwanamke mwenye uchungu; maana sasa utatoka mjini, nawe utakaa katika mashamba; utafika hata Babeli; huko ndiko utakakookolewa; huko ndiko BWANA atakakokukomboa kutoka kwa mikono ya adui zako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.10",
            "verseOrgIds": [
              "MIC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sasa mataifa mengi wamekusanyika juu yako, wasemao, Na atiwe unajisi; macho yetu na yaone shari ya Sayuni. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.11",
            "verseOrgIds": [
              "MIC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wao hawayajui mawazo ya BWANA, wala hawafahamu shauri lake; kwamba amewakusanya kama miganda mahali pa kupuria. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.12",
            "verseOrgIds": [
              "MIC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.24"
              },
              "items": [
                {
                  "text": "Ufu 21:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haya, simama upure, Ee binti Sayuni; kwa maana nitafanya pembe yako kuwa chuma, na kwato zako kuwa shaba; nawe utapondaponda mataifa mengi, na faida yao utaiweka wakfu kwa BWANA, na mali zao kwa BWANA wa dunia yote.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.13",
            "verseOrgIds": [
              "MIC.4.13"
            ]
          }
        }
      ]
    }
