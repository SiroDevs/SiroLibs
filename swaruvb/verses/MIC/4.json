                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika siku ile, asema BWANA, nitamkusanya yeye achechemeaye, nami nitamrudisha yeye aliyefukuzwa, na yeye niliyemtesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
