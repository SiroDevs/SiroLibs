                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana mataifa yote watakwenda, kila moja kwa jina la mungu wake, na sisi tutakwenda kwa jina la BWANA, Mungu wetu, milele na milele.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
