                "loc": "JER.2.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enyi watu wangu, nimewatenda nini? Nami nimewachosha kwa kitu gani? Shuhudieni juu yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
