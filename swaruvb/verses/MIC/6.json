                "loc": "REV.2.14"
              },
              "items": [
                {
                  "text": "Ufu 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1"
              },
              "items": [
                {
                  "text": "Hes 25:1",
