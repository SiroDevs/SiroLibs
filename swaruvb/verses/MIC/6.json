        "style": "s1"
      },
      "items": [
        {
          "text": "Mungu awashutumu Waisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
