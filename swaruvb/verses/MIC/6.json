            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana nilikupandisha kutoka nchi ya Misri, na kukukomboa utoke katika nyumba ya utumwa, nami niliwatuma Musa, na Haruni, na Miriamu, watangulie mbele yako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
