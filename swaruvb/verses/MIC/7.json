              },
              "items": [
                {
                  "text": "Hab 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtu amchaye Mungu ametoweka, asionekane katika nchi, wala hapana mtu mwenye adili katika wanadamu; wote huotea ili kumwaga damu; kila mtu humwinda ndugu yake kwa wavu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
