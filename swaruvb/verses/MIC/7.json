                "loc": "DEU.33.28"
              },
              "items": [
                {
                  "text": "Kum 33:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walishe watu wako kwa fimbo yako, kundi la urithi wako, wakaao peke yao, msituni katikati ya Karmeli; na walishe katika Bashani na Gileadi, kama siku za kale. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama katika siku zile za kutoka kwako katika nchi ya Misri nitamwonesha mambo ya ajabu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.15",
            "verseOrgIds": [
              "MIC.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.11"
              },
              "items": [
                {
                  "text": "Isa 26:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mataifa wataona, na kuziaibikia nguvu zao zote; wataweka mikono yao juu ya vinywa vyao, masikio yao yatakuwa na uziwi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watayaramba mavumbi kama nyoka, kama vitu vitambaavyo juu ya nchi watatoka katika mahali walimojificha, wakitetemeka; watakuja kwa BWANA, Mungu wetu, kwa hofu, nao wataogopa kwa sababu yako.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Huruma na fadhili za Mungu",
          "type": "text"
        }
      ]
    },
