              "attrs": {
                "loc": "GEN.9.22+GEN.9.23+GEN.9.24"
              },
              "items": [
                {
                  "text": "Mwa 9:22-24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.35+MAT.10.36"
