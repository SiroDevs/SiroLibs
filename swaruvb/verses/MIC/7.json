              "items": [
                {
                  "text": "Omb 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Usifurahi juu yangu, Ee adui yangu; niangukapo, nitasimama tena; nikaapo gizani, BWANA atakuwa nuru kwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitaivumilia ghadhabu ya BWANA, kwa kuwa nimemwasi; hata atakaponitetea shutuma yangu, na kunifanyia hukumu; atanileta nje kwenye nuru, nami nitaiona haki yake. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo adui yangu ataliona jambo hilo, na aibu itamfunika, yeye aliyeniambia, Yuko wapi BWANA, Mungu wako? Macho yangu yatamtazama; sasa atakanyagwa kama matope ya njia kuu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Unabii kuhusu kurudishwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
