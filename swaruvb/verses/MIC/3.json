                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikasema, Tafadhali sikieni, enyi vichwa vya Yakobo, mnaoitawala nyumba ya Israeli. Je! Haiwapasi ninyi kujua hukumu? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi mnaoyachukia mema, na kuyapenda mabaya; ninyi mnaowachuna watu ngozi yao, na nyama mifupani mwao. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.14.4"
              },
              "items": [
                {
                  "text": "Zab 14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naam, mnakula nyama ya watu wangu, na kuwachuna ngozi zao, na kuivunja mifupa yao; naam, kuwakata vipande vipande kama kwa kutiwa chunguni, na kama nyama sufuriani. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.28"
              },
              "items": [
                {
                  "text": "Mit 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo watakapomwomba BWANA, asiwaitikie; naam, atawaficha uso wake wakati huo, kwa kadiri walivyotenda mabaya kwa matendo yao. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.10"
              },
              "items": [
                {
                  "text": "Isa 56:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.15"
              },
              "items": [
                {
                  "text": "Mt 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA asema hivi kuhusu manabii wanaowakosesha watu wangu; hao waumao kwa meno yao, na kulia, Amani; na mtu awaye yote asiyetia kitu vinywani mwao, wao humwandalia vita. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.23"
              },
              "items": [
                {
                  "text": "Eze 13:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo itakuwa usiku kwenu, msipate kuona maono; tena itakuwa giza kwenu, msiweze kubashiri; nalo jua litawachwea manabii, nao mchana utakuwa mweusi juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.9"
              },
              "items": [
                {
                  "text": "Zab 74:9",
