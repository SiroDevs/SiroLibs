          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikieni haya, tafadhali, enyi vichwa vya nyumba ya Yakobo, mnaoitawala nyumba ya Israeli, mnaochukia hukumu, na kuipotosha adili. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanaoijenga Sayuni kwa damu, na Yerusalemu kwa uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
        },
