              "attrs": {
                "loc": "ISA.58.1"
              },
              "items": [
                {
                  "text": "Isa 58:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali mimi, hakika nimejaa nguvu kwa Roho ya BWANA; nimejaa hukumu na uwezo; nimhubirie Yakobo kosa lake, na Israeli dhambi yake.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
