                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.11"
              },
              "items": [
                {
                  "text": "Amo 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hao waonaji wataaibika, na wenye kubashiri watafadhaika; naam, hao wote watajifunika midomo yao; kwa maana; hapana jawabu la Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        },
        {
