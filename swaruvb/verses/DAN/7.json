          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanyama hao wakubwa walio wanne ni wafalme wanne watakaotokea duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.17",
            "verseOrgIds": [
              "DAN.7.17"
            ]
          }
        },
