              "items": [
                {
                  "text": "20:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mto kama wa moto ukatoka ukapita mbele zake; maelfu wakamtumikia, na mamilioni wakasimama mbele zake; hukumu ikawekwa, na vitabu vikafunuliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
