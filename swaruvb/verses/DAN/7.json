          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Ufu 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikatazama wakati huo; kwa sababu ya sauti ya yale maneno makubwa iliyoyasema ile pembe; nilitazama hata mnyama yule akauawa, mwili wake ukaharibiwa, akatolewa ateketezwe kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa habari za wale wanyama wengine, walinyang'anywa mamlaka yao; lakini maisha yao yalidumishwa kwa wakati na majira. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        },
