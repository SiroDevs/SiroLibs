              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mimi Danieli, roho yangu ilihuzunika ndani yangu, na hayo maono ya kichwa changu yakanifadhaisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.15",
            "verseOrgIds": [
              "DAN.7.15"
            ]
          }
