          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikamkaribia mmoja wa hao waliosimama karibu, nikamwuliza maana ya kweli ya hayo yote. Basi akaniambia, akanijulisha tafsiri ya mambo hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.16",
            "verseOrgIds": [
              "DAN.7.16"
            ]
          }
        },
        {
