              "items": [
                {
                  "text": "Ufu 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini watakatifu wake Aliye Juu wataupokea ufalme, na kuumiliki huo ufalme milele, naam hata milele na milele. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
