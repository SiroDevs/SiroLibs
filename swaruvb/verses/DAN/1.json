            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Au, Nebukadreza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mfalme wa Babeli, alikwenda Yerusalemu akauhusuru. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
