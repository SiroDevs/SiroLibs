                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwana akamtia Yehoyakimu, mfalme wa Yuda, katika mkono wake, pamoja na baadhi ya vyombo vya nyumba ya Mungu; naye akavichukua mpaka nchi ya Shinari, mpaka nyumba ya mungu wake; akaviingiza vile vyombo katika nyumba ya hazina ya mungu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akamwambia Ashpenazi, mkuu wa matowashi wake, awalete baadhi ya wana wa Israeli, wa uzao wa kifalme, na wa uzao wa watu mashuhuri; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.18"
              },
              "items": [
                {
                  "text": "Law 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.8.18"
              },
              "items": [
                {
                  "text": "Amu 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.20"
              },
              "items": [
                {
                  "text": "Mdo 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " vijana wasio na kasoro, wazuri wa uso, wajuzi wa hekima, werevu kwa sababu ya maarifa yao, wenye kufahamu elimu, watakaoweza kusimama katika jumba la mfalme; tena alimwambia awafundishe kusoma na kuandika, lugha ya Wakaldayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo mfalme akawaagizia wapewe chakula kama cha mfalme, na divai aliyokunywa, akaagiza walishwe hivyo muda wa miaka mitatu; ili kwamba hatimaye wasimame mbele ya mfalme.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
