            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi katika hao walikuwapo baadhi ya wana wa Yuda, Danieli, na Hanania, na Mishaeli, na Azaria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.45"
              },
              "items": [
                {
                  "text": "Mwa 41:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.12"
              },
              "items": [
                {
                  "text": "Dan 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mkuu wa matowashi akawapa majina; alimwita Danieli, Belteshaza; na Hanania akamwita Shadraka; na Mishaeli akamwita Meshaki; na Azaria akamwita Abednego. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.38"
              },
              "items": [
                {
                  "text": "Kum 32:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.4"
              },
              "items": [
                {
                  "text": "Zab 141:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.13"
              },
              "items": [
                {
                  "text": "Eze 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.3"
              },
              "items": [
                {
                  "text": "Hos 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini Danieli aliazimu moyoni mwake ya kuwa hatajitia unajisi kwa chakula cha mfalme, wala kwa divai aliyokunywa; basi akamwomba yule mkuu wa matowashi ampe ruhusa asijitie unajisi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.21"
              },
              "items": [
                {
                  "text": "Mwa 39:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.50"
              },
              "items": [
                {
                  "text": "1 Fal 8:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Mungu alimjalia Danieli kupata kibali na huruma machoni pa huyo mkuu wa matowashi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkuu wa matowashi akamwambia Danieli, Mimi namwogopa bwana wangu, mfalme, aliyewaagizia ninyi chakula chenu na kinywaji chenu; kwa nini azione nyuso zenu kuwa hazipendezi kama nyuso za vijana wa rika lenu? Basi kwa kufanya hivyo mtahatarisha kichwa changu mbele ya mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Danieli akamwambia yule msimamizi, ambaye mkuu wa matowashi amemweka juu ya Danieli, na Hanania, na Mishaeli, na Azaria, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tafadhali utujaribu sisi watumishi wako muda wa siku kumi; na watupe mboga za majani tule, na maji tunywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nyuso zetu zitazamwe mbele yako, na nyuso za wale vijana wanaokula chakula cha mfalme; ukatutendee sisi watumishi wako kadiri ya utakavyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akawasikiliza katika jambo hilo, akawajaribu siku kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata mwisho wa zile siku kumi nyuso zao zilikuwa nzuri zaidi, na miili yao ilikuwa imenenepa zaidi, kuliko wale vijana wote waliokula chakula cha mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi yule msimamizi akaiondoa posho yao ya chakula, na ile divai waliyopewa wanywe, akawapa mtama tu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
