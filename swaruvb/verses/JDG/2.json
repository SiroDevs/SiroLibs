        {
          "text": " Basi kwa ajili ya hayo mimi nilisema zaidi, Mimi sitawafukuza watoke mbele zenu; lakini watakuwa kama miiba mbavuni mwenu, na miungu yao itakuwa ni mtego kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, hapo huyo malaika wa BWANA alipoyanena maneno haya, kuwaambia wana wa Israeli wote, ndipo hao watu wakainua sauti zao na kulia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wakaliita jina la mahali pale Bokimu;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:5",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni ‘Wanaolia’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nao wakamchinjia BWANA sadaka huko.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
