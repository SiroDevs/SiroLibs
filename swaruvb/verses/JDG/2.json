                  "text": "Yos 19:49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao wakamzika katika mpaka wa urithi wake katika Timnath-heresi, katika nchi ya vilima vilima ya Efraimu, upande wa kaskazini wa mlima wa Gaashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
