            "sid": "JDG 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.10"
              },
              "items": [
                {
                  "text": "1 Sam 25:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.9"
              },
              "items": [
                {
                  "text": "Zab 78:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Yeftha akawakutanisha watu wote wa Gileadi, na kupigana na Efraimu; na hao watu wa Gileadi wakawapiga Efraimu, kwa sababu walisema, Ninyi Wagileadi ni watoro mliotoroka Efraimu, na kukaa kati ya Efraimu na Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.4",
            "verseOrgIds": [
              "JDG.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
