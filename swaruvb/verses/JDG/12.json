              },
              "items": [
                {
                  "text": "Ufu 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nilipoona ya kuwa ninyi hamniokoi, niliuhatarisha uhai wangu, na kuvuka ili nipigane na wana wa Amoni, BWANA naye akawatia mkononi mwangu; basi kwa nini ninyi kunijia hivi leo kutaka kupigana nami? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.3",
            "verseOrgIds": [
              "JDG.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
