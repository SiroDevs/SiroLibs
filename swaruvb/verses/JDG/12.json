            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Eloni, Abdoni mwana wa Hileli, Mpirathoni, akawa mwamuzi wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
