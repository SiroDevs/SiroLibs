              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya Ibzani, Eloni, Mzabuloni, akawa mwamuzi wa Israeli akawaamua Israeli muda wa miaka kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.11",
            "verseOrgIds": [
              "JDG.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo Eloni, Mzabuloni, akafa, akazikwa katika Aiyaloni katika nchi ya Zabuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        }
      ]
