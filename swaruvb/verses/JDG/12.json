            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huyo Yeftha akawa mwamuzi wa Israeli muda wa miaka sita. Ndipo akafa Yeftha, Mgileadi, akazikwa katika miji ya Gileadi mmojawapo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibzani, Eloni na Abdoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
