              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa akamwambia huyo malaika wa BWANA, Jina lako ni nani, ili kwamba hapo hayo maneno yako yatakapotimia nipate kukutukuza? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
