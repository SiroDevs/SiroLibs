                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Manoa akamwambia huyo malaika wa BWANA, Nakuomba, tukuzuie, ili tupate kuandaa mwana-mbuzi kwa ajili yako. ",
          "type": "text",
          "attrs": {
