              "items": [
                {
                  "text": "Kut 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitapiga kambi yangu pande zote za nyumba yangu ili kuwapinga adui, mtu awaye yote asipite ndani yake wala kurudi; wala mtu aoneaye hatapita tena kati yao; kwa maana sasa nimeona kwa macho yangu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
