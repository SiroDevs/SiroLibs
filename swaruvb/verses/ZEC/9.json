        },
        {
          "text": " na Hamathi pia iliyo mpakani mwake; na Tiro, na Sidoni, kwa maana ana akili nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Tiro alijijengea ngome, akakusanya fedha kama mchanga, dhahabu safi kama matope ya njia kuu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
