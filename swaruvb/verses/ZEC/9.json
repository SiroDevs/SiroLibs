              },
              "items": [
                {
                  "text": "Eze 26:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, Bwana atamwondolea mali zake, naye ataupiga uwezo wake alio nao baharini, naye mwenyewe atateketezwa kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
