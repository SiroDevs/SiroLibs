                  "text": "Mk 14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amka, Ee upanga, juu ya mchungaji wangu, na juu ya mtu aliye mwenzangu, asema BWANA wa majeshi; mpige mchungaji, nao kondoo watatawanyika; nami nitaugeuza mkono wangu juu ya wadogo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
