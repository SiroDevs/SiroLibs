                  "text": "Rum 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata itakuwa, ya kwamba katika nchi yote mafungu mawili yatakatiliwa mbali, nao watakufa, asema BWANA; lakini fungu la tatu litabaki humo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        },
