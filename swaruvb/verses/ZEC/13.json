                "loc": "2PE.2.1"
              },
              "items": [
                {
                  "text": "2 Pet 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha itakuwa katika siku hiyo, asema BWANA wa majeshi, nitakatilia mbali majina ya sanamu katika nchi, yasikumbukwe tena; pia nitawafukuza manabii, na roho ya uchafu, watoke katika nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.2",
            "verseOrgIds": [
              "ZEC.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.6"
              },
              "items": [
                {
                  "text": "Kum 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena itakuwa ya kwamba, mtu awaye yote atakapotoa unabii, basi baba yake na mama yake waliomzaa watamwambia, Hutaishi; kwa maana unanena maneno ya uongo kwa jina la BWANA; na baba yake na mama yake waliomzaa watamtumbua atoapo unabii. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.3",
            "verseOrgIds": [
              "ZEC.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena itakuwa siku hiyo, ya kwamba manabii, kila mmoja wao, atayaonea haya maono yake atoapo unabii; wala hawatavaa joho la nywele ili kudanganya watu; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.4",
            "verseOrgIds": [
              "ZEC.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bali atasema, Mimi si nabii kamwe; mimi ni mkulima wa nchi; kwa maana nilifanywa mtumwa tokea ujana wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.5",
            "verseOrgIds": [
              "ZEC.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mtu yeyote akimwuliza, Je! Majeraha haya yote uliyo nayo katikati ya mikono yako ni nini? Naye atajibu, Ni majeraha niliyotiwa katika nyumba ya rafiki zangu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        }
      ]
    },
