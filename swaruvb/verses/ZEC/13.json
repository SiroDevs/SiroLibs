                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika siku hiyo watu wa nyumba ya Daudi, na wenyeji wa Yerusalemu, watafunguliwa chemchemi ya kuwatakasa kutoka kwa dhambi na kwa unajisi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.1",
            "verseOrgIds": [
