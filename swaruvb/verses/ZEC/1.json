              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.13"
              },
              "items": [
                {
                  "text": "Zab 103:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.10"
              },
              "items": [
                {
                  "text": "Ufu 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
