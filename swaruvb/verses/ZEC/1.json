                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.7.5"
              },
              "items": [
                {
                  "text": "Zek 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo yule malaika wa BWANA akajibu, akasema, Ee BWANA wa majeshi, hadi lini utakataa kuurehemu Yerusalemu, na miji ya Yuda uliyoikasirikia miaka hii sabini? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.1"
              },
              "items": [
                {
                  "text": "Isa 40:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "Yer 29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye BWANA akamjibu yule malaika aliyesema nami kwa maneno mazuri, maneno yenye faraja. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.18"
              },
              "items": [
                {
                  "text": "Yoe 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.2"
              },
              "items": [
                {
                  "text": "Zek 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi yule malaika aliyesema nami akaniambia, Haya, piga kelele na kusema, BWANA wa majeshi asema hivi, Naona wivu kwa ajili ya Yerusalemu, na kwa ajili ya Sayuni; naona wivu mkuu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.6"
              },
              "items": [
                {
                  "text": "Isa 47:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami ninayakasirikia sana mataifa yanayostarehe; kwa maana mimi nilikuwa nimekasirika kidogo tu, nao wakayazidisha maafa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
