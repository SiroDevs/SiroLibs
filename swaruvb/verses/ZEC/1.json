                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Msiwe ninyi kama baba zenu, ambao manabii wa zamani waliwalilia, wakisema, BWANA wa majeshi asema hivi, Rudini sasa, na kuziacha njia zenu mbovu, na matendo yenu maovu; lakini hawakusikia, wala kunitii, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je, Baba zenu wako wapi? Je, manabii nao wanaishi milele? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
