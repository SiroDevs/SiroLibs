              },
              "items": [
                {
                  "text": "Lk 15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, uwaambie, BWANA wa majeshi asema hivi, Nirudieni mimi, asema BWANA wa majeshi, nami nitawarudia ninyi, asema BWANA wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
