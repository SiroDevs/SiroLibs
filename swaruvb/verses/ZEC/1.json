              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.18"
              },
              "items": [
                {
                  "text": "Omb 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini maneno yangu, na amri zangu nilizowaagiza hao manabii, watumishi wangu, je, Hazikuwapata baba zenu? Nao wakatubu na kusema, BWANA wa majeshi ametutenda kulingana na njia zetu, na matendo yetu, kama alivyokusudia kutenda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maono ya kwanza: Wapanda farasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
