              "items": [
                {
                  "text": "Zek 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha nikainua macho yangu, nikaona, na tazama, mtu mwenye kamba ya kupimia mkononi mwake. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.1",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.1"
              },
              "items": [
                {
                  "text": "Ufu 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo nikasema, Unakwenda wapi? Akaniambia, Ninakwenda kuupima Yerusalemu, nione upana wake ulivyo na urefu wake ulivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tazama, yule malaika aliyesema nami akasimama karibu, na malaika mwingine akatoka ili kuonana naye; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.3",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.10"
              },
              "items": [
                {
                  "text": "Eze 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " naye akamwambia, Nenda mbio ukamwambie kijana huyu, na kusema, Yerusalemu utakaliwa na watu, kama vijiji visivyo na kuta, kwa sababu ya wingi wa watu na mifugo iliyomo ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.4",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
