              "items": [
                {
                  "text": "Eze 33:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mataifa mengi watajiunga na BWANA katika siku ile, nao watakuwa watu wangu; nami nitakaa kati yako, nawe utajua ya kuwa BWANA wa majeshi amenituma kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
