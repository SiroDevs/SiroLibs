              "type": "tag",
              "attrs": {
                "loc": "REV.21.23"
              },
              "items": [
                {
                  "text": "Ufu 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana mimi, asema BWANA, nitakuwa ukuta wa moto kuuzunguka pande zote, nami nitakuwa huo utukufu ndani yake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        }
      ]
    },
