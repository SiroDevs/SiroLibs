              "type": "tag",
              "attrs": {
                "loc": "DEU.32.9"
              },
              "items": [
                {
                  "text": "Kum 32:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na BWANA atairithi Yuda, iwe sehemu yake katika nchi takatifu, naye atachagua Yerusalemu tena. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
