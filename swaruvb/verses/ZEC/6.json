          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikainua macho yangu tena, nikaona, na tazama, yanatokea magari ya vita manne, yanatoka kati ya milima miwili, na milima hiyo ilikuwa ni milima ya shaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.1",
            "verseOrgIds": [
              "ZEC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
