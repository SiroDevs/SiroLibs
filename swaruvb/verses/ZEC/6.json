                "loc": "ZEC.5.10"
              },
              "items": [
                {
                  "text": "Zek 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikajibu, nikamwuliza yule malaika aliyesema nami, Hawa ni nini, Bwana wangu? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.4",
            "verseOrgIds": [
              "ZEC.6.4"
            ]
