            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.17"
              },
              "items": [
                {
                  "text": "Mwa 13:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Farasi wale walipotoka, walitaka kwenda huku na huko katika dunia; naye akawaambia, Haya! Tokeni, mwende huku na huko katika dunia. Basi wakaenda huku na huko katika dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.7",
            "verseOrgIds": [
              "ZEC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
