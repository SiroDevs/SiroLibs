                "loc": "REV.6.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika gari la kwanza walikuwa farasi wekundu; na katika gari la pili walikuwa farasi weusi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.2",
            "verseOrgIds": [
              "ZEC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.2"
              },
              "items": [
                {
                  "text": "Ufu 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na katika gari la tatu walikuwa farasi weupe; na katika gari la nne walikuwa farasi wa rangi ya kijivujivu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.3",
            "verseOrgIds": [
              "ZEC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 6:4"
          },
          "items": [
