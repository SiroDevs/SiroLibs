        {
          "text": " Malaika akajibu, akaniambia, Hawa ni pepo nne za mbinguni, zitokeazo baada ya kusimama mbele za Bwana wa dunia yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.14"
              },
              "items": [
                {
                  "text": "Yer 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gari lile lenye farasi weusi latoka kwenda hata nchi ya kaskazini; nao farasi weupe wanatoka kwenda katika nchi ya magharibi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.6",
            "verseOrgIds": [
              "ZEC.6.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:6",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni ‘wakatoka kufuata nyuma yao’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na wale wa rangi ya kijivujivu wakatoka kwenda hadi nchi ya kusini. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.6",
            "verseOrgIds": [
              "ZEC.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 6:7"
