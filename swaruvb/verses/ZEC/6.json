              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.10.4"
              },
              "items": [
                {
                  "text": "Mhu 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo akaniita, akaniambia akisema, Tazama, wale waendao mpaka nchi ya kaskazini wameituliza roho yangu katika nchi ya kaskazini.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.8",
            "verseOrgIds": [
              "ZEC.6.8"
            ]
