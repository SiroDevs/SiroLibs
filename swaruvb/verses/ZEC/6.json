                "loc": "ZEC.1.8"
              },
              "items": [
                {
                  "text": "Zek 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.4"
              },
              "items": [
                {
                  "text": "Ufu 6:4",
