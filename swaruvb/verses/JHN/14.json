          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.27"
              },
              "items": [
                {
                  "text": "Yn 14:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.22"
              },
              "items": [
                {
                  "text": "Mk 11:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Msifadhaike mioyoni mwenu; mnamwamini Mungu, niaminini na mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumbani mwa Baba yangu mna makao mengi; kama sivyo, ningaliwaambia; maana naenda kuwaandalia mahali. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.26"
              },
              "items": [
                {
                  "text": "Yn 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.24"
              },
              "items": [
                {
                  "text": "17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi mimi nikienda na kuwaandalia mahali, nitakuja tena niwakaribishe kwangu; ili nilipo mimi, nanyi muwepo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami niendako mwaijua njia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.4",
            "verseOrgIds": [
              "JHN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomaso akamwambia, Bwana, sisi hatujui uendako; nasi tunaijuaje njia? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.20"
              },
              "items": [
                {
                  "text": "Ebr 10:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mt 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.25"
              },
              "items": [
                {
                  "text": "Yn 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.1"
              },
              "items": [
                {
                  "text": "Rum 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu akamwambia, Mimi ndimi njia, na kweli, na uzima; mtu haji kwa Baba, ila kwa njia ya mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mngalinijua mimi, mngalimjua na Baba; tangu sasa mnamjua, tena mmemwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.7",
            "verseOrgIds": [
              "JHN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo akamwambia, Bwana, utuoneshe Baba, yatutosha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.8",
            "verseOrgIds": [
              "JHN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.45"
              },
              "items": [
                {
                  "text": "Yn 12:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.1.3"
              },
              "items": [
                {
                  "text": "Ebr 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.17"
              },
              "items": [
                {
                  "text": "Mt 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu akamwambia, Mimi nimekuwapo pamoja nanyi siku hizi zote, wewe usinijue, Filipo? Aliyeniona mimi amemwona Baba; basi wewe wasemaje, Utuoneshe Baba? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.49"
              },
              "items": [
                {
                  "text": "Yn 12:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Husadiki ya kwamba mimi ni ndani ya Baba, na Baba yu ndani yangu? Hayo maneno niwaambiayo mimi siyasemi kwa shauri langu; lakini Baba akaaye ndani yangu huzifanya kazi zake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.10",
            "verseOrgIds": [
              "JHN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.20"
              },
              "items": [
                {
                  "text": "Yn 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.25"
              },
              "items": [
                {
                  "text": "Yn 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mnisadiki ya kwamba mimi ni ndani ya Baba, na Baba yu ndani yangu; la! Hamsadiki hivyo, sadikini kwa sababu ya kazi zenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.11",
            "verseOrgIds": [
              "JHN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.19"
              },
              "items": [
                {
                  "text": "Mk 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amin, amin, nawaambieni, Yeye aniaminiye mimi, kazi nizifanyazo mimi, yeye naye atazifanya; naam, na kubwa kuliko hizo atafanya, kwa kuwa mimi naenda kwa Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.12",
            "verseOrgIds": [
              "JHN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.7"
              },
              "items": [
                {
                  "text": "Yn 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mk 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.14"
              },
              "items": [
                {
                  "text": "1 Yoh 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanyi mkiomba lolote kwa jina langu, hilo nitalifanya, ili Baba atukuzwe ndani ya Mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.13",
            "verseOrgIds": [
              "JHN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 14:14"
          },
          "items": [
