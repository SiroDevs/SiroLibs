        {
          "text": " Akasema, Amin, amin, nakuambia, Wakati ulipokuwa kijana, ulikuwa ukijifunga mwenyewe na kwenda utakako; lakini utakapokuwa mzee, utainyosha mikono yako, na mwingine atakufunga na kukuchukua usikotaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.18",
            "verseOrgIds": [
              "JHN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.36"
              },
              "items": [
                {
                  "text": "Yn 13:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema neno hilo kwa kuonesha ni kwa mauti gani atakayomtukuza Mungu. Naye akiisha kusema hayo akamwambia, Nifuate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.19",
            "verseOrgIds": [
              "JHN.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu na manafunzi aliyempenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
