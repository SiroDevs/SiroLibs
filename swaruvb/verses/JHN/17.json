                "loc": "PHP.2.6"
              },
              "items": [
                {
                  "text": "Flp 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na sasa, Baba, unitukuze mimi pamoja nawe, kwa utukufu ule niliokuwa nao pamoja nawe kabla ya ulimwengu kuwako. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
