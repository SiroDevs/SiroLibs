                "loc": "1JN.5.20"
              },
              "items": [
                {
                  "text": "1 Yoh 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.1.9"
              },
              "items": [
                {
                  "text": "1 The 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na uzima wa milele ndio huu, Wakujue wewe, Mungu wa pekee wa kweli, na Yesu Kristo uliyemtuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.34"
              },
              "items": [
                {
                  "text": "Yn 4:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi nimekutukuza duniani, nikiwa nimeimaliza kazi ile uliyonipa niifanye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
