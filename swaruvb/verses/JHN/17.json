          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.37"
              },
              "items": [
                {
                  "text": "Yn 6:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi nawaombea hao; siuombei ulimwengu; bali hao ulionipa, kwa kuwa hao ni wako; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
