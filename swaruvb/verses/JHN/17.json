            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.15"
              },
              "items": [
                {
                  "text": "Yn 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.31"
              },
              "items": [
                {
                  "text": "Lk 15:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na wote walio wangu ni wako, na walio wako ni wangu; nami nimetukuzwa ndani yao.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        }
