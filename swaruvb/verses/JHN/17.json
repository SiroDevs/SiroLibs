                  "text": "Mt 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala mimi simo tena ulimwenguni, lakini hawa wamo ulimwenguni, nami naja kwako. Baba mtakatifu, kwa jina lako ulilonipa uwalinde hawa, ili wawe na umoja kama sisi tulivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
