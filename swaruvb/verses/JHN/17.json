              },
              "items": [
                {
                  "text": "Yn 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi nimewapa neno lako; na ulimwengu umewachukia; kwa kuwa wao si wa ulimwengu, kama mimi nisivyo wa ulimwengu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
