              "items": [
                {
                  "text": "2 The 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nilipokuwapo pamoja nao, mimi niliwalinda kwa jina lako ulilonipa, nikawatunza; wala hapana mmojawapo wao aliyepotea, ila yule mwana wa upotevu, ili andiko litimie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
