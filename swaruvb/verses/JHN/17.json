          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mt 11:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kama vile ulivyompa mamlaka juu ya watu wote,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:2",
              "type": "text"
            },
            {
              "text": "au wote wenye mwili.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ili kwamba wote uliompa awape uzima wa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
