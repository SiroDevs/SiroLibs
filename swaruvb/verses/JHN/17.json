              },
              "items": [
                {
                  "text": "Yn 15:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na sasa naja kwako; na maneno haya nayasema ulimwenguni, ili wawe na furaha yangu imetimizwa ndani yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
