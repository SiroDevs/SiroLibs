                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maneno hayo aliyasema Yesu; akainua macho yake kuelekea mbinguni, akasema, Baba, saa imekwisha kufika. Mtukuze Mwanao, ili Mwana wako naye akutukuze wewe; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
