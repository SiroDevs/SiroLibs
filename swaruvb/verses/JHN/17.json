                  "text": "Lk 22:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi siombi kwamba uwatoe katika ulimwengu; bali uwalinde na yule mwovu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
