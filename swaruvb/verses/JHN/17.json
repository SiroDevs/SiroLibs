                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.9"
              },
              "items": [
                {
                  "text": "Mt 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jina lako nimewadhihirishia watu wale ulionipa katika ulimwengu; walikuwa wako, ukanipa mimi, na neno lako wamelishika. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sasa wamejua ya kuwa yote uliyonipa yatoka kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.30"
              },
              "items": [
                {
                  "text": "Yn 16:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kuwa maneno uliyonipa nimewapa wao; nao wakayapokea, wakajua hakika ya kuwa nilitoka kwako, wakasadiki ya kwamba wewe ndiwe uliyenituma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
