            }
          ]
        },
        {
          "text": " Kristo atakapofunuliwa, aliye uhai wetu, ndipo na ninyi mtafunuliwa pamoja naye katika utukufu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
