                {
                  "text": "Mt 6:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yafikirini yaliyo juu, siyo yaliyo katika nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.2",
            "verseOrgIds": [
              "COL.3.2"
