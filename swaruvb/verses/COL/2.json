                  "text": "14:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana nijapokuwa sipo kwa mwili, lakini nipo pamoja nanyi kwa roho, nikifurahi na kuuona utaratibu wenu na uthabiti wa imani yenu katika Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
