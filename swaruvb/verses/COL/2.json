                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na ninyi mmetimilika katika yeye aliye kichwa cha enzi yote na mamlaka. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
