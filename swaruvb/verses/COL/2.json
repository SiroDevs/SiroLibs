                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana katika yeye unakaa utimilifu wote wa Mungu, kwa jinsi ya kimwili. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.9",
            "verseOrgIds": [
