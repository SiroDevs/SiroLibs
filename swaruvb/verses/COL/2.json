              "items": [
                {
                  "text": "Efe 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ili wafarijiwe mioyo yao, wakiunganishwa katika upendo, wakapate utajiri wote wa kufahamu kwa hakika, wapate kujua kabisa siri ya Mungu, yaani, Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
