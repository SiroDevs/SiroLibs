                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nasema neno hili, mtu asije akawadanganya kwa maneno ya kuwashawishi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
