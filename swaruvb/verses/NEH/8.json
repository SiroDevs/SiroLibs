          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata siku ya pili wakuu wa mbari za mababu za watu wote, na makuhani, na Walawi, wakamkusanyikia Ezra, mwandishi, ili wapate kujifunza maneno ya torati. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
