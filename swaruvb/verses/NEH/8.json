                "loc": "JDG.3.20"
              },
              "items": [
                {
                  "text": "Amu 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ezra akakifunua kitabu machoni pa watu wote; (maana alikuwa juu ya watu wote); na hapo alipokifungua, watu wote walisimama; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
