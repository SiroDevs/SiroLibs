              "items": [
                {
                  "text": "Law 10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena Yeshua, na Bani, na Sherebia, na Yamini, na Akubu, na Shabethai, na Hodai, na Maaseya, na Kelita, na Azaria, na Yozabadi, na Hanani, na Pelaya, nao ni Walawi, wakawafahamisha watu torati; na watu wakasimama mahali pao. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
