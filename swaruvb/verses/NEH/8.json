                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ezra akamhimidi BWANA, Mungu Mkuu. Nao watu wote wakaitika, Amina, Amina, pamoja na kuinua mikono yao; kisha wakainamisha vichwa vyao, wakamsujudu BWANA kifudifudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
