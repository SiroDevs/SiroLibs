          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya kwamba wahubiri na kutangaza katika miji yao yote, na katika Yerusalemu, kusema, Nendeni mlimani, mkalete matawi ya mzeituni, na matawi ya mzeituni mwitu, na matawi ya mihadasi, na matawi ya mitende, na matawi ya miti minene, ili kufanya vibanda, kama ilivyoandikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
