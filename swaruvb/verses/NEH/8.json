                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao wakasoma katika kitabu, katika Torati ya Mungu, kwa sauti ya kusikika; wakaeleza maana yake, hata wakayafahamu yaliyosomwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
