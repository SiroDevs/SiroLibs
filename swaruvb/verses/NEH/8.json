              ]
            }
          ]
        },
        {
          "text": " Wakaona ya kuwa imeandikwa katika torati, jinsi BWANA alivyoamuru kwa mkono wa Musa, ya kwamba wana wa Israeli wakae katika vibanda, katika sikukuu ya mwezi wa saba; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
