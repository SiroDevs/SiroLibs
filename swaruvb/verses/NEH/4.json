        {
          "text": " Lakini ikawa, Sanbalati aliposikia ya kwamba tulikuwa tukiujenga ukuta, akaghadhibika, akawa na uchungu sana, akawadhihaki Wayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
              "NEH.4.1"
            ]
          }
        },
