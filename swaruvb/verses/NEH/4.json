            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi tukaujenga ukuta; nao ukuta wote ukaunganishwa kiasi cha nusu ya kimo chake; maana watu walikuwa na moyo wa kufanya kazi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
