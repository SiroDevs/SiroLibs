                }
              ]
            }
          ]
        },
        {
          "text": " Basi Tobia, Mwamoni, alikuwa karibu naye, akasema, Hata hiki wanachokijenga, angepanda mbweha, angeubomoa ukuta wao wa mawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
              "NEH.4.3"
            ]
