        },
        {
          "text": " Ikawa adui zetu wote waliposikia, ndipo wamataifa wote waliotuzunguka wakaogopa, nao wakakata tamaa sana machoni pao wenyewe; maana waliitambua kazi hiyo ilivyotendwa na Mungu wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
