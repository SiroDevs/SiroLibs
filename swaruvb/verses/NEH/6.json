              "items": [
                {
                  "text": "2 Kor 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwani hao wote walitaka kutuogofya, wakisema, Kwa kuwa mikono yao italegea katika kazi, kazi isifanyike. Lakini sasa Ee Mungu, itie nguvu mikono yangu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
