        },
        {
          "text": "Basi huo ukuta ukakamilika siku ya ishirini na tano ya mwezi wa Eluli, katika muda wa siku hamsini na mbili. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.15",
