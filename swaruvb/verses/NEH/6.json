            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.10"
              },
              "items": [
                {
                  "text": "Mit 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao wakaniletea mwito huo mara nne; nikawajibu maneno yale yale. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Sanbalati akamtuma kwangu mtumishi wake vile vile mara ya tano, na barua wazi mkononi mwake; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.5",
            "verseOrgIds": [
              "NEH.6.5"
            ]
          }
        },
