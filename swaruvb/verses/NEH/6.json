          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana walikuwa watu wengi katika Yuda waliomwapia, kwa sababu alikuwa mkwewe Shekania, mwana wa Ara; naye Yehohanani mwanawe amemwoa binti Meshulamu, mwana wa Berekia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
