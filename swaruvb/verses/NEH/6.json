            "sid": "NEH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe umewaweka manabii ili wakuhubirie huko Yerusalemu kwa kusema, Yuko mfalme katika Yuda; basi sasa mfalme ataarifiwa mambo haya, Basi sasa, njoo ili tushauriane. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.7",
            "verseOrgIds": [
              "NEH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
