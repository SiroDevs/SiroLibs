        },
        {
          "text": " nayo yakaandikwa humo, Habari imeenea katika mataifa, naye Geshemu asema neno lilo hilo, ya kwamba wewe na Wayahudi mnakusudia kuasi; ndiyo sababu unaujenga huo ukuta; nawe unataka kuwamiliki, ndivyo wasemavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
