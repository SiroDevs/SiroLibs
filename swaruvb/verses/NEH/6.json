          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena siku zile wakuu wa Yuda walimtumia nyaraka nyingi Tobia nazo nyaraka za Tobia ziliwafikia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
