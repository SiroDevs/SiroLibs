              "items": [
                {
                  "text": "Dan 11:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo mimi nikatuma kwake wajumbe, kusema, Hakukufanyika mambo kama hayo uyasemayo, lakini kwa moyo wako wewe mwenyewe umeyabuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        },
