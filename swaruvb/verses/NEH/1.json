              },
              "items": [
                {
                  "text": "2 Fal 25:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakaniambia, Watu waliosalimika, waliosalia huko katika mkoa ule, wamo katika hali ya dhiki kubwa na aibu; tena ukuta wa Yerusalemu umebomolewa, na malango yake yameteketezwa kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        },
        {
