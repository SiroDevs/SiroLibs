                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakuomba, likumbuke neno lile ulilomwamuru Musa, mtumishi wako, ukisema, Mkikosa, nitawatawanya kati ya mataifa; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
