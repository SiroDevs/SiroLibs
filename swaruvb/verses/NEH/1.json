              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo niliposikia maneno hayo, nikaketi, nikalia, nikaomboleza siku kadhaa; kisha nikafunga, nikaomba mbele za Mungu wa mbinguni; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.4",
