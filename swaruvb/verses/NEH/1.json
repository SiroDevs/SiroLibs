        },
        {
          "text": " Habari za Nehemia, mwana wa Hakalia. Ikawa katika mwezi wa Kislevu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Katika kalenda ya Kiyahudi Kislevu ni mwezi wa tisa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwaka wa ishirini, nilipokuwapo Shushani ngomeni, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani, mmoja wa ndugu zangu, akanijia, yeye na watu wengine waliotoka Yuda; nami nikawauliza habari za Wayahudi waliosalimika, ambao hawakuchukuliwa uhamishoni na habari za Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 1:3"
          },
