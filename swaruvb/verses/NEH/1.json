                }
              ]
            }
          ]
        },
        {
          "text": " Tumetenda maovu mengi juu yako, wala hatukuzishika amri, wala sheria, wala hukumu, ulizomwamuru Musa, mtumishi wako. ",
          "type": "text",
          "attrs": {
