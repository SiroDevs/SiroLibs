                "loc": "JDG.5.9"
              },
              "items": [
                {
                  "text": "Amu 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hao watu wakawabariki wote waliojitoa kwa hiari wakae Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        },
        {
