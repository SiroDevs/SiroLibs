            "caller": "#"
          },
          "items": [
            {
              "text": "3:9",
              "type": "text"
            },
            {
              "text": "katika Kigiriki hakuna ‘wanaume wawili’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ulivyokuwa dhahiri.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
