              "items": [
                {
                  "text": "2 Tim 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali wewe ukae katika mambo yale uliyofundishwa na kuhakikishwa, kwa maana unajua ni akina nani ambao ulijifunza kwao; ",
          "type": "text",
          "attrs": {
