                {
                  "text": "1 Tim 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini watu waovu na wadanganyaji wataendelea, na kuzidi kuwa waovu, wakidanganya na kudanganyika. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
