                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naam, na wote wapendao kuishi maisha ya utauwa katika Kristo Yesu wataudhiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
