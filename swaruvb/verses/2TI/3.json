              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini hawataendelea sana; maana upumbavu wao utakuwa dhahiri kwa watu wote, kama vile na upumbavu wa hao wanaume wawili",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        },
