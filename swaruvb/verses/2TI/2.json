                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mkumbuke Yesu Kristo, aliyefufuka katika wafu, wa uzao wa Daudi kama inenavyo Injili yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
