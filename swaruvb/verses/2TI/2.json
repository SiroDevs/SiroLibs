                  "text": "Kol 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa ajili ya hilo nastahimili mambo yote, kwa ajili ya wateule, ili wao nao waupate wokovu ule ulio katika Kristo Yesu, pamoja na utukufu wa milele.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
