                {
                  "text": "Nah 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mashujaa wako, Ee Temani, watafadhaika, hata iwe kila mtu akatiliwe mbali kwa kuuawa katika kilima cha Esau.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
