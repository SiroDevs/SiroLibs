                  "text": "Nah 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku ile uliposimama upande, siku ile wageni walipochukua mali zake, na watu wa kabila nyingine walipoingia katika malango yake, na kumpigia kura Yerusalemu, wewe nawe ulikuwa kama mmoja wao. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
