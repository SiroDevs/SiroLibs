              "items": [
                {
                  "text": "Sef 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na watu wa Negebu wataumiliki mlima wa Esau; na watu wa Shefela watawamiliki Wafilisti; nao wataimiliki nchi ya Efraimu, na nchi ya Samaria, na Benyamini atamiliki Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.19",
            "verseOrgIds": [
              "OBA.1.19"
            ]
          }
        },
