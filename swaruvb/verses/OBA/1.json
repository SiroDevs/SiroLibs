              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo, je! Sitawaangamiza watu wenye akili katika Edomu, na wenye ufahamu katika kilima cha Esau? Asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        },
        {
