        },
        {
          "text": " Kwa sababu ya udhalimu aliotendwa ndugu yako Yakobo, aibu itakufunika, nawe utakatiliwa mbali hata milele. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
