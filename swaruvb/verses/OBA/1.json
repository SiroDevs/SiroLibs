            "number": "16",
            "style": "v",
            "sid": "OBA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana kama vile mlivyokunywa juu ya mlima wangu mtakatifu, ndivyo mataifa yote watakavyokunywa daima; naam, watakunywa na kuyumbayumba, nao watakuwa kana kwamba hawakuwa kamwe.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.16",
            "verseOrgIds": [
              "OBA.1.16"
            ]
          }
        }
