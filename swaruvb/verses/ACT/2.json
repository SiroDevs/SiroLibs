                "loc": "ACT.4.31"
              },
              "items": [
                {
                  "text": "Mdo 4:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kukaja ghafla toka mbinguni sauti kama mvumo wa upepo mkali ukienda kasi, ukaijaza nyumba yote waliyokuwa wameketi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.11"
              },
              "items": [
                {
                  "text": "Mt 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kukawatokea ndimi zilizogawanyikana, kama ndimi za moto uliowakalia kila mmoja wao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
