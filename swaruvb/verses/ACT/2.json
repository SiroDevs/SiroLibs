              },
              "items": [
                {
                  "text": "19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wote wakajazwa Roho Mtakatifu, wakaanza kusema kwa lugha nyingine, kama Roho alivyowajalia kutamka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        }
      ]
    },
