                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakati ilipotimia siku ya Pentekoste walikuwako wote mahali pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
