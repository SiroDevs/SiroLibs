                "loc": "ACT.13.26"
              },
              "items": [
                {
                  "text": "Mdo 13:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na walikuwako Yerusalemu Wayahudi wakikaa, watu watauwa, watu wa kila taifa chini ya mbingu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sauti hii iliposikiwa makutano walikutanika, wakashikwa na fadhaa, kwa kuwa kila mmoja aliwasikia wakisema kwa lugha yake mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashangaa wote, wakastaajabu wakiambiana, Tazama, hawa wote wasemao si Wagalilaya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imekuwaje basi sisi kusikia kila mtu lugha yetu tuliyozaliwa nayo? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waparthi na Wamedi na Waelami, nao wakaao Mesopotamia, Yudea na Kapadokia, Ponto na Asia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Frigia na Pamfilia, Misri na pande za Libya karibu na Kirene, na wageni watokao Rumi, Wayahudi na waongofu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakrete na Waarabu; tunawasikia hawa wakisema kwa lugha zetu matendo makuu ya Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashangaa wote wakaingiwa na shaka, wakiambiana, Maana yake nini mambo haya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wengine walidhihaki, wakisema, wamelewa kwa mvinyo mpya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro ahutubia mkutano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
