                "loc": "JOL.2.28+JOL.2.29+JOL.2.30+JOL.2.31+JOL.2.32"
              },
              "items": [
                {
                  "text": "Yoe 2:28-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lakini jambo hili ni lile lililonenwa kwa kinywa cha nabii Yoeli,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
