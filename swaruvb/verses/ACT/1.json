        },
        {
          "text": " hadi siku ile alipochukuliwa juu, alipokuwa amekwisha kuwaagiza kwa Roho Mtakatifu wale mitume aliowachagua; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.2",
            "verseOrgIds": [
              "ACT.1.2"
            ]
