                "loc": "ACT.22.20"
              },
              "items": [
                {
                  "text": "22:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku ile kukatokea mateso makuu kwa kanisa lililokuwa katika Yerusalemu; wote wakatawanyika katika nchi ya Yudea na Samaria, isipokuwa hao mitume. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.12"
              },
              "items": [
                {
                  "text": "Mt 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watu watauwa wakamzika Stefano, wakamfanyia maombolezo makuu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
