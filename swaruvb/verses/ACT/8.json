          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Filipo akaenda mbio, akamsikia anasoma kitabu cha nabii Isaya; akanena, Je! Yamekuelea haya unayosoma? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        },
