                  "text": "Ebr 12:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana nakuona uko katika uchungu kama nyongo, na tena uko katika kifungo cha uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
