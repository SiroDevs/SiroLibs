          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni akajibu, akasema, Niombeeni ninyi kwa Bwana, yasinifikie mambo haya mliyosema hata moja.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
