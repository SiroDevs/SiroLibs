            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.18"
              },
              "items": [
                {
                  "text": "Gal 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa nilipokwisha kurudi Yerusalemu, nilipokuwa nikisali ndani ya hekalu, nikawa katika hali ya kuzimia roho, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikamwona, naye akiniambia, Hima, utoke Yerusalemu upesi, kwa sababu hawatakubali ushuhuda wako kuhusu habari zangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "Mdo 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nikasema, Bwana, wanajua hao ya kuwa mimi nilikuwa nikiwafunga gerezani wale wanaokuamini na kuwapiga katika kila sinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
