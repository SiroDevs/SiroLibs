            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wakamsikiliza mpaka neno lile, wakapaza sauti zao, wakisema, Mwondoe huyu katika nchi, kwa maana haifai aishi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
