                  "text": "Law 23:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na itakuwa ya kwamba kila mtu asiyemsikiliza nabii huyo ataangamizwa na kutengwa na watu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.23",
            "verseOrgIds": [
