              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambaye ilimpasa kupokewa mbinguni hata zije zamani za kufanywa upya vitu vyote, zilizonenwa na Mungu kwa kinywa cha manabii wake watakatifu tokea mwanzo wa ulimwengu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.21",
            "verseOrgIds": [
              "ACT.3.21"
            ]
