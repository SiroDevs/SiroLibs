                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana Musa kweli alisema ya kwamba, Bwana Mungu wenu atawainulieni nabii, katika ndugu zenu, kama mimi; msikieni yeye katika mambo yote atakayonena nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.22",
            "verseOrgIds": [
              "ACT.3.22"
            ]
          }
