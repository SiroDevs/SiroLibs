          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "apate kumtuma Kristo Yesu mliyewekewa tangu zamani; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.20",
            "verseOrgIds": [
              "ACT.3.20"
            ]
          }
        },
