                  "text": "1 Tim 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi sasa, ndugu, najua ya kuwa mliyatenda haya kwa kutokujua kwenu, kama na wakuu wenu walivyotenda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.17",
