                }
              ]
            }
          ]
        },
        {
          "text": " mkamwua yule Mkuu wa uzima, ambaye Mungu amemfufua katika wafu; na sisi tu mashahidi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.15",
