        },
        {
          "text": " Tubuni basi, mrejee, ili dhambi zenu zifutwe, zipate kuja nyakati za kuburudishwa kwa kuwako kwake Bwana; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.19",
            "verseOrgIds": [
              "ACT.3.19"
            ]
          }
        },
