            "sid": "ACT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Festo alipokwisha kuingia katika mkoa, baada ya siku tatu akapanda kwenda Yerusalemu kutoka Kaisaria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        }
      ]
    },
    {
