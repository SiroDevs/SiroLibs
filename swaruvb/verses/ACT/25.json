        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 25:2"
          },
          "items": [
            {
