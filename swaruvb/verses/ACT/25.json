              "ACT.25.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.18"
              },
              "items": [
                {
                  "text": "Mt 10:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kesho yake asubuhi Agripa akaja pamoja na Bernike kwa fahari nyingi, wakaingia mahali pa kusikia maneno, pamoja na maofisa wakuu na watu wakuu wa mji; Festo akatoa amri, Paulo akaletwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.23",
            "verseOrgIds": [
              "ACT.25.23"
            ]
          }
        },
        {
