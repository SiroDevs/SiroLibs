                  "text": "Mt 11:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi sasa mbona mnamjaribu Mungu na kuweka kongwa juu ya shingo za wanafunzi, ambalo baba zetu wala sisi hatukuweza kulibeba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.10",
            "verseOrgIds": [
