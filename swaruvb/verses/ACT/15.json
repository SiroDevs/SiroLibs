                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Barnaba akaazimu kumchukua Yohana aliyeitwa Marko pamoja nao. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
