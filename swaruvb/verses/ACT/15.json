              "items": [
                {
                  "text": "Mdo 10:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wala hakufanya tofauti kati yetu sisi na wao, akiwasafisha mioyo yao kwa imani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
