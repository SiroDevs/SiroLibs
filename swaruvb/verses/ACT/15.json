                "loc": "ACT.13.1"
              },
              "items": [
                {
                  "text": "13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena Yuda na Sila, kwa kuwa wao wenyewe ni manabii, wakawausia ndugu kwa maneno mengi, wakawathibitisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wakiisha kukaa huko muda, wakaruhusiwa na ndugu waende kwa amani kwa hao waliowatuma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        }
