            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.1"
              },
              "items": [
                {
                  "text": "Gal 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi baada ya Paulo na Barnaba kushindana na watu hawa na kuhojiana nao sana, ndugu wakaamuru kwamba Paulo na Barnaba na wengine miongoni mwao wapande kwenda Yerusalemu kwa mitume na wazee ili kuzungumza juu ya suala hilo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.2",
            "verseOrgIds": [
              "ACT.15.2"
            ]
          }
        }
      ]
    },
    {
