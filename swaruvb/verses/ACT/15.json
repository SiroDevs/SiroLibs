            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.4"
              },
              "items": [
                {
                  "text": "13:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi palitokea mashindano baina yao hata wakatengana. Barnaba akamchukua Marko akaabiri kwenda Kipro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
