                  "text": "Kol 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali Paulo hakuona vema kumchukua huyo aliyewaacha huko Pamfilia, asiende nao kazini. ",
          "type": "text",
          "attrs": {
