              "attrs": {
                "loc": "ACT.10.44"
              },
              "items": [
                {
                  "text": "10:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Mungu, ajuaye mioyo ya watu, akawashuhudia, akiwapa Roho Mtakatifu vile vile kama alivyotupa sisi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.8",
            "verseOrgIds": [
              "ACT.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
