              "items": [
                {
                  "text": "Gal 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hao walipokwisha kunyamaza Yakobo akajibu, akisema, Ndugu zangu, nisikilizeni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
