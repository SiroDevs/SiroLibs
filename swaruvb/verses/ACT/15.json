          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Paulo akamchagua Sila, akaondoka, akiombewa na wale ndugu apewe neema ya Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
