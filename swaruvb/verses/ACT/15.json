              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hao wakiisha kupewa ruhusa wakateremka kwenda Antiokia; na baada ya kuwakusanya jamii yote wakawapa ile barua. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
