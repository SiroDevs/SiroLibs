                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakashuka watu waliotoka Yudea wakawafundisha wale ndugu ya kwamba, Msipotahiriwa kama desturi ya Musa hamuwezi kuokoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
