              "ACT.20.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.2"
              },
              "items": [
                {
                  "text": "1 Kor 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.42"
              },
              "items": [
                {
                  "text": "Mdo 2:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku ya kwanza ya juma, tulipokuwa tumekutana ili kumega mkate, Paulo akawahutubia, maana aliazimia kusafiri siku iliyofuata, naye akafululiza maneno yake hadi usiku wa manane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.7",
            "verseOrgIds": [
              "ACT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palikuwa na taa nyingi katika ghorofa lile tulipokuwa tumekusanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.8",
            "verseOrgIds": [
              "ACT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijana mmoja, jina lake Eutiko, alikuwa ameketi dirishani, akalemewa na usingizi sana; hata Paulo alipoendelea sana kuhubiri, akazidiwa na usingizi wake akaanguka toka ghorofa ya tatu; akainuliwa amekwisha kufa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.9",
            "verseOrgIds": [
              "ACT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.21"
              },
              "items": [
                {
                  "text": "1 Fal 17:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Paulo akashuka, akamwangukia, akamkumbatia, akasema, Msifanye ghasia, maana uzima wake ungalimo ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.10",
            "verseOrgIds": [
              "ACT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapanda juu tena, akamega mkate, akala, akazidi kuongea nao hadi alfajiri, ndipo akaenda zake. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.11",
            "verseOrgIds": [
              "ACT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamleta yule kijana, akiwa mzima, wakafarijika faraja kubwa sana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Safari ya kutoka Troa hadi Mileto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sisi tukatangulia kwenda merikebuni, tukaabiri kwenda Aso, tukikusudia kumpakia Paulo huko; kwa maana ndivyo alivyoagiza, yeye mwenyewe aliazimia kwenda kwa miguu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.13",
            "verseOrgIds": [
              "ACT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alipotufikia huko Aso, tukampakia, kisha tukafika Mitilene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.14",
            "verseOrgIds": [
              "ACT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukatweka kutoka huko, na siku ya pili tukafika mahali panapokabili Kio; siku ya tatu tukawasili Samo, tukakaa Trogilio, siku ya nne tukafika Mileto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.15",
            "verseOrgIds": [
              "ACT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.21"
              },
              "items": [
                {
                  "text": "Mdo 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu Paulo alikusudia kusafiri pasipo kupitia Efeso merikebuni, asije akakawia katika Asia; kwa maana alikuwa na haraka, akitaka kuwahi Yerusalemu siku ya Pentekoste, kama ikiwezekana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo asema na viongozi wa Efeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toka Mileto Paulo akatuma watu kwenda Efeso, akawaita wazee wa kanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.17",
            "verseOrgIds": [
              "ACT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.19"
              },
              "items": [
                {
                  "text": "Mdo 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.10"
              },
              "items": [
                {
                  "text": "19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walipofika kwake, akawaambia, Ninyi wenyewe mnajua tangu siku ya kwanza nilipokanyaga hapa Asia, jinsi nilivyokuwa kwenu wakati wote, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.18",
            "verseOrgIds": [
              "ACT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.3"
              },
              "items": [
                {
                  "text": "Mdo 20:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nikimtumikia Bwana kwa unyenyekevu wote, na kwa machozi, na majaribu yaliyonipata kutokana na njama za Wayahudi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.19",
            "verseOrgIds": [
              "ACT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya kuwa sikujiepusha katika kuwatangazia neno lolote liwezalo kuwafaa bali niliwafundisha waziwazi, na nyumba kwa nyumba, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.20",
            "verseOrgIds": [
              "ACT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikiwashuhudia Wayahudi na Wagiriki wamtubie Mungu, na kumwamini Bwana wetu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.21",
            "verseOrgIds": [
              "ACT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
