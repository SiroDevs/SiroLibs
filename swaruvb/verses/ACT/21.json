              },
              "items": [
                {
                  "text": "1 Kor 9:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Paulo akawatwaa wanaume wale, na kesho yake akajitakasa nafsi yake pamoja nao, akaingia ndani ya hekalu, akitangaza habari ya kutimiza siku za utakaso, hata sadaka itolewe kwa ajili ya kila mmoja wao.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo ashikwa akiwa hekaluni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
