          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, ni nini? Bila shaka watasikia kwamba umekuja. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.22",
            "verseOrgIds": [
              "ACT.21.22"
            ]
          }
        },
