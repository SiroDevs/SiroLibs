              },
              "items": [
                {
                  "text": "Hes 6:13-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi fanya neno hili tunalokuambia. Wako kwetu watu wanne waliofungwa na nadhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.23",
            "verseOrgIds": [
              "ACT.21.23"
            ]
          }
        },
        {
