                  "text": "Ufu 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akanijibu, akasema, Iandike njozi ukaifanye iwe wazi sana katika vibao, ili aisomaye apate kuisoma kama maji. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
