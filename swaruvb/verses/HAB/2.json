              "type": "tag",
              "attrs": {
                "loc": "HEB.10.37"
              },
              "items": [
                {
                  "text": "Ebr 10:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana njozi hii bado ni kwa wakati ulioamriwa, inafanya haraka ili kuufikia mwisho wake, wala haitasema uongo; ijapokawia, ingojee; kwa kuwa haina budi kuja, haitakawia. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        },
        {
