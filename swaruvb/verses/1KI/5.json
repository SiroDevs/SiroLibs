              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, Hiramu aliposikia maneno yake Sulemani, alifurahi sana, akasema, Na ahimidiwe BWANA leo, aliyempa Daudi mwana mwenye akili juu ya watu hawa walio wengi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
