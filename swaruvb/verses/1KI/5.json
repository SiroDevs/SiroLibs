          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu akatuma watu kwa Sulemani, akasema, Nimeusikia ujumbe ulionitumia; nami nitafanya kila ulitakalo kuhusu miti ya mierezi, na miti ya miberoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        },
