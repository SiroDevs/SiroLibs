              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Hiramu akampa Sulemani miti ya mierezi na miti ya miberoshi kadiri alivyotaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
