            }
          ]
        },
        {
          "text": "Mfalme Sulemani akakusanya kutoka kila mahali katika Israeli watu wa shokoa nao walikuwa elfu thelathini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
