          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani alikuwa na wapagazi elfu sabini na wakatao miti milimani elfu themanini; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
