                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.4+ACT.9.5"
              },
              "items": [
                {
                  "text": "9:4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ingawa hapo awali nilikuwa mtukanaji, mwenye kuudhi watu, mwenye ujeuri, lakini nilipata rehema kwa kuwa nilifanya hivyo kwa ujinga, na kwa kutokuwa na imani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na neema ya Bwana wetu ilizidi sana, pamoja na imani na pendo lililo katika Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.2"
              },
              "items": [
                {
                  "text": "Lk 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni neno la kuaminiwa, tena lastahili kukubalika kabisa, ya kwamba Kristo Yesu alikuja ulimwenguni awaokoe wenye dhambi; ambao wa kwanza wao ni mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa ajili hii nilipata rehema, ili katika mimi wa kwanza, Yesu Kristo audhihirishe uvumilivu wake wote; niwe kielelezo kwa wale watakaomwamini baadaye, wapate uzima wa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
