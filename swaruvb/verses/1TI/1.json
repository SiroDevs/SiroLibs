        },
        {
          "text": " Paulo, mtume wa Kristo Yesu, kwa amri ya Mungu Mwokozi wetu na Kristo Yesu, tarajio letu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
