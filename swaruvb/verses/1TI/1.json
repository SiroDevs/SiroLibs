        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.4"
              },
              "items": [
                {
                  "text": "1 Tim 6:4",
                  "type": "text"
                }
              ]
            },
