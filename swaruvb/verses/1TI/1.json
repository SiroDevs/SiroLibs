                  "text": "Gal 1:13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami namshukuru Kristo Yesu Bwana wetu, aliyenitia nguvu kwa sababu aliniona kuwa mwaminifu, akaniweka katika utumishi wake; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
