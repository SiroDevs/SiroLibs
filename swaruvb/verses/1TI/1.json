            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.6"
              },
              "items": [
                {
                  "text": "Gal 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini lengo la agizo hili ni kuleta upendo utokao katika moyo safi na dhamiri njema, na imani isiyo na unafiki. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 1:6"
          },
          "items": [
            {
