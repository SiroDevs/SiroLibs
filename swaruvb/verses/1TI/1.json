              },
              "items": [
                {
                  "text": "Tit 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kwa Timotheo, mwanangu halisi katika imani. Na iwe kwako neema, rehema na amani, zitokazo kwa Mungu Baba na kwa Kristo Yesu Bwana wetu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
