              "items": [
                {
                  "text": "Mdo 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vivyo hivyo mashemasi",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:8",
              "type": "text"
            },
            {
              "text": "Shemasi:",
              "type": "text"
            },
            {
              "text": "maana yake ni, Mtumishi wa kanisa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na wawe wastahivu; si wenye kauli mbili, si watu wa kutumia mvinyo sana, si watu wanaotamani fedha ya aibu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakiishika siri ya imani kwa dhamiri safi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawa pia na wajaribiwe kwanza; baadaye waitende kazi ya shemasi, wakiisha kuonekana kuwa hawana hatia. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.3"
              },
              "items": [
                {
                  "text": "Tit 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vivyo hivyo wake zao na wawe wastahivu; wasiwe wachongezi; ila wawe watu wa kiasi, waaminifu katika mambo yote. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashemasi na wawe waume wa mke mmoja, wakiwasimamia watoto wao vizuri, na nyumba zao. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana watendao vema kazi ya shemasi hujipatia daraja nzuri, na ujasiri mwingi katika imani iliyo katika Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siri ya dini yetu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
