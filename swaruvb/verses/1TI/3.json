              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.19+EPH.2.20+EPH.2.21+EPH.2.22"
              },
              "items": [
                {
                  "text": "Efe 2:19-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini nikikawia, upate kujua jinsi iwapasavyo watu kuenenda katika nyumba ya Mungu, iliyo kanisa la Mungu aliye hai, nguzo na msingi wa kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
