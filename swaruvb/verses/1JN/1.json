              "items": [
                {
                  "text": "Yn 3:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tukisema ya kwamba tunashirikiana naye, huku tukienenda katika giza, tunasema uongo, wala hatuifanyi iliyo kweli; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
