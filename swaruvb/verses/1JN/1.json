              "items": [
                {
                  "text": "16:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na haya tunayaandika, ili furaha yetu itimizwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
