                }
              ]
            }
          ]
        },
        {
          "text": " Lile lililokuwako tangu mwanzo, tulilolisikia, tuliloliona kwa macho yetu, tulilolitazama, na mikono yetu ikalipapasa, kuhusu Neno la uzima; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
