              },
              "items": [
                {
                  "text": "16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na huu ndio ujasiri tulio nao kwake, ya kuwa, tukiomba kitu sawasawa na mapenzi yake, atusikia. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.14",
            "verseOrgIds": [
              "1JN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kama tukijua kwamba atusikia, tunapoomba chochote, tunajua kwamba tumetimiziwa zile haja tulizomwomba. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        },
