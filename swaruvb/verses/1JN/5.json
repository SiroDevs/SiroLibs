                  "text": "Yn 20:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimewaandikia ninyi mambo hayo, ili mjue ya kuwa mna uzima wa milele, ninyi mnaoliamini Jina la Mwana wa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.13",
            "verseOrgIds": [
              "1JN.5.13"
            ]
          }
        },
        {
