              "items": [
                {
                  "text": "Kut 34:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wapenzi, sasa tu wana wa Mungu, wala haijadhihirika bado tutakavyokuwa; lakini tunajua ya kuwa atakapodhihirishwa, tutafanana naye; kwa maana tutamwona kama alivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.2",
            "verseOrgIds": [
              "1JN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kila mwenye matumaini haya katika yeye hujitakasa, kama yeye alivyo mtakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.23"
              },
              "items": [
                {
                  "text": "Mt 7:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila atendaye dhambi, afanya uasi; kwa kuwa dhambi ni uasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.4",
            "verseOrgIds": [
              "1JN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
