            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanyi mnajua ya kuwa yeye alidhihirishwa, ili aziondoe dhambi; na dhambi haimo ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.5",
            "verseOrgIds": [
              "1JN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 3:6"
          },
          "items": [
            {
