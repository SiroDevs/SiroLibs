                }
              ]
            }
          ]
        },
        {
          "text": " Kila amchukiaye ndugu yake ni mwuaji: nanyi mnajua ya kuwa kila mwuaji hana uzima wa milele ukaao ndani yake. ",
          "type": "text",
          "attrs": {
