                  "text": "Yn 8:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " atendaye dhambi ni wa Ibilisi; kwa kuwa Ibilisi hutenda dhambi tangu mwanzo. Kwa kusudi hili Mwana wa Mungu alidhihirishwa, ili azivunje kazi za Ibilisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.8",
            "verseOrgIds": [
              "1JN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
