              "items": [
                {
                  "text": "1 Yoh 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watoto wadogo, mtu na asiwadanganye; atendaye haki ana haki, kama yeye alivyo na haki; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.7",
            "verseOrgIds": [
              "1JN.3.7"
            ]
          }
        },
        {
          "name": "verse",
