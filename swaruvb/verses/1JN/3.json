              "attrs": {
                "loc": "ROM.6.14"
              },
              "items": [
                {
                  "text": "Rum 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila akaaye ndani yake hatendi dhambi; kila atendaye dhambi hakumwona yeye, wala hakumtambua. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.6",
            "verseOrgIds": [
              "1JN.3.6"
            ]
          }
