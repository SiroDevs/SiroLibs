              "items": [
                {
                  "text": "1 Yoh 5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini yeye alishikaye neno lake, katika huyo upendo wa Mungu umekamilika kweli kweli. Katika hili twajua ya kuwa tumo ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.5",
            "verseOrgIds": [
              "1JN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
