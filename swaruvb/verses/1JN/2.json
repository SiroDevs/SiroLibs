                {
                  "text": "1 Yoh 4:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeye asemaye kwamba yumo katika nuru, naye amchukia ndugu yake, yumo gizani hata sasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.9",
            "verseOrgIds": [
              "1JN.2.9"
            ]
