                  "text": "Yak 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Msiipende dunia, wala mambo yaliyomo katika dunia. Mtu akiipenda dunia, kumpenda Baba hakumo ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.15",
            "verseOrgIds": [
