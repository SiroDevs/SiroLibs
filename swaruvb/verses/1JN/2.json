                  "text": "15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila amkanaye Mwana, hanaye Baba; amkiriye Mwana anaye Baba pia. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
