              "items": [
                {
                  "text": "1 Kor 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanyi mmepakwa mafuta na Yeye aliye Mtakatifu nanyi mnajua nyote. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
            "verseOrgIds": [
              "1JN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
