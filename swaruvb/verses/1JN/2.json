          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyi basi, hilo mlilolisikia tangu mwanzo na likae ndani yenu. Ikiwa hilo mlilolisikia tangu mwanzo linakaa ndani yenu, ninyi nanyi mtakaa ndani ya Mwana, na ndani ya Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
