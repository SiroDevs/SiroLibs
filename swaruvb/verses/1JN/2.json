                {
                  "text": "Kol 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.51"
              },
              "items": [
                {
                  "text": "Yn 11:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " naye ndiye kafara ya upatanisho wa dhambi zetu; wala si kwa dhambi zetu tu, bali na kwa dhambi za ulimwengu wote. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
              "1JN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na katika hili tunajua ya kuwa tumemjua yeye, ikiwa tunashika amri zake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.3",
            "verseOrgIds": [
              "1JN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
