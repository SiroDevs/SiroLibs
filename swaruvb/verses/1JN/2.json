            "number": "21",
            "style": "v",
            "sid": "1JN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikuwaandikia ninyi kwa sababu hamwijui iliyo kweli, bali kwa sababu mnaijua, tena kwamba hapana uongo wowote utokao katika hiyo kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
            "verseOrgIds": [
              "1JN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nani aliye mwongo ila yeye akanaye ya kuwa Yesu ni Kristo? Huyo ndiye mpinga Kristo, yeye amkanaye Baba na Mwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.22",
            "verseOrgIds": [
              "1JN.2.22"
            ]
          }
        },
