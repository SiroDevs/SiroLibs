                "loc": "JHN.13.15"
              },
              "items": [
                {
                  "text": "Yn 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeye asemaye ya kuwa anakaa ndani yake, imempasa kuenenda mwenyewe vile vile kama yeye alivyoenenda.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.6",
