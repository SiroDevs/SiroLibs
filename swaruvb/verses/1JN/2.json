              },
              "items": [
                {
                  "text": "1 Yoh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawaandikia ninyi, akina baba, kwa sababu mmemjua yeye aliye tangu mwanzo. Nawaandikia ninyi, vijana, kwa sababu mmemshinda yule mwovu. Nimewaandikia ninyi, watoto, kwa sababu mmemjua Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        },
        {
