          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimewaandikia haya kuhusu habari za watu wale wanaotaka kuwapoteza. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
