                "loc": "1JN.1.8"
              },
              "items": [
                {
                  "text": "1 Yoh 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeye asemaye, Nimemjua, wala hazishiki amri zake, ni mwongo, wala kweli haimo ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.4",
            "verseOrgIds": [
              "1JN.2.4"
            ]
          }
        },
