              "attrs": {
                "loc": "EPH.6.10"
              },
              "items": [
                {
                  "text": "Efe 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nimewaandikia ninyi, akina baba, kwa sababu mmemjua yeye aliye tangu mwanzo. Nimewaandikia ninyi, vijana, kwa sababu mna nguvu, na neno la Mungu linakaa ndani yenu, nanyi mmemshinda yule mwovu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        },
        {
