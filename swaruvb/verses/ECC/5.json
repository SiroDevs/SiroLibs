          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mali hizo zimepotea kwa bahati mbaya; naye akiwa amezaa mwana, hamna kitu mkononi mwake. ",
          "type": "text",
          "attrs": {
