                  "text": "Zab 127:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku zake zote hula gizani, mwenye fadhaa nyingi, mwenye ugonjwa na uchungu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
