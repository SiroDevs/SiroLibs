        },
        {
          "text": " Kuna balaa mbaya sana niliyoiona chini ya jua, nayo ni hii, mali alizoziweka mwenyewe kwa kujinyima; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
