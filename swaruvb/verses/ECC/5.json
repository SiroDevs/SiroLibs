              "items": [
                {
                  "text": "Mit 11:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hiyo ndiyo balaa mbaya sana, ya kwamba kama vile alivyokuja, vivyo hivyo atakwenda zake; naye amefaidiwa nini mwenye kujitaabisha kwa ajili ya upepo? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        },
