              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo hayo yote mimi nimeyahakikisha katika hekima. Nilisema, Mimi nitakuwa na hekima, lakini imefarakana nami. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
