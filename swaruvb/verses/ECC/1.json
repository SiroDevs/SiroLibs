                  "text": "Mhu 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikatia moyo wangu ili kuyatafuta yote yanayotendeka chini ya mbingu, na kuyavumbua kwa hekima; ni taabu kubwa ambayo Mungu amewapa wanadamu, ili kutaabika ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
