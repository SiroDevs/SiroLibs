              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Kuna jambo lolote ambalo watu husema juu yake, Tazama, ni jambo jipya? Limekwisha kuwako, tangu zamani za kale zilizokuwa kabla yetu sisi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
