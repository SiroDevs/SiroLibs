              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sasa, kwa kuwa sina wasaa tena pande hizi, tena kwa miaka mingi nimekuwa nikitamani kuja kwenu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
