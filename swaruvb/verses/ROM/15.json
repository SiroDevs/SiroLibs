              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba niokolewe kutoka kwa wale wasioamini katika Yudea, na tena huduma yangu niliyo nayo huko Yerusalemu ikubalike kwa watakatifu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
