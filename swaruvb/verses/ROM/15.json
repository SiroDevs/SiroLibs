              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikiisha kuimaliza kazi hiyo, na kuwatilia mhuri tunda hilo, nitapitia kwenu, kwenda Spania. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
