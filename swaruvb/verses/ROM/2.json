                "loc": "ROM.1.32"
              },
              "items": [
                {
                  "text": "Rum 1:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hao waionesha kazi ya torati iliyoandikwa mioyoni mwao, dhamiri yao ikiwashuhudia, na mawazo yao, yenyewe kwa yenyewe, yakiwashitaki au kuwatetea; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
            "verseOrgIds": [
              "ROM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 2:16"
          },
          "items": [
            {
              "text": "16",
