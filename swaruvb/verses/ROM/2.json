          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.35"
              },
              "items": [
                {
                  "text": "Mdo 10:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana watu wa Mataifa wasio na sheria wafanyapo kwa tabia zao yaliyo ndani ya torati, hao wasio na sheria wamekuwa sheria kwa nafsi zao wenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
            "verseOrgIds": [
              "ROM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 2:15"
          },
          "items": [
