          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wale ambao kwa subira katika kutenda mema wanatafuta utukufu na heshima na kutoharibika, watapewa uzima wa milele; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.7",
            "verseOrgIds": [
              "ROM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
