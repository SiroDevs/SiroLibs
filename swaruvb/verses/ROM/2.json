              "items": [
                {
                  "text": "Yak 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu sio wale waisikiao sheria walio wenye haki mbele za Mungu, bali ni wale waitendao sheria watakaohesabiwa haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
            "verseOrgIds": [
              "ROM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
