              "attrs": {
                "loc": "ROM.3.9"
              },
              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " dhiki na shida juu ya kila nafsi ya mwanadamu atendaye uovu, Myahudi kwanza na Mgiriki pia; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.9",
            "verseOrgIds": [
              "ROM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
