                "loc": "1PE.1.17"
              },
              "items": [
                {
                  "text": "1 Pet 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kwa maana hakuna upendeleo kwa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.11",
            "verseOrgIds": [
              "ROM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa wote waliokosa pasipo sheria watapotea pasipo sheria, na wote waliokosa, wenye sheria, watahukumiwa kwa sheria. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 2:13"
          },
          "items": [
