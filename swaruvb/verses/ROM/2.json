              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.8"
              },
              "items": [
                {
                  "text": "2 Tim 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " katika siku ile Mungu atakapozihukumu siri za wanadamu, sawasawa na Injili yangu, kwa Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
