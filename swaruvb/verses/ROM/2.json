                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 The 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na wale wenye fitina, wasioitii kweli, bali wakubalio dhuluma, watapata hasira na ghadhabu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.8",
            "verseOrgIds": [
              "ROM.2.8"
            ]
          }
        },
        {
