              "items": [
                {
                  "text": "2 Kor 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " atakayemlipa kila mtu kwa kadiri ya matendo yake; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
