                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu sheria ndiyo ifanyayo hasira; maana pasipokuwapo sheria, hapana kosa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        },
        {
