                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini akiiona ahadi ya Mungu hakusita kwa kutoamini, bali alitiwa nguvu kwa imani, akimtukuza Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
