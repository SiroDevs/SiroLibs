              "type": "tag",
              "attrs": {
                "loc": "JAS.2.23"
              },
              "items": [
                {
                  "text": "Yak 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana Maandiko yasemaje? Abrahamu alimwamini Mungu, ikahesabiwa kwake kuwa haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.6"
              },
              "items": [
                {
                  "text": "Rum 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.7"
              },
              "items": [
                {
                  "text": "Mt 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini kwa mtu afanyaye kazi, ujira wake hauhesabiwi kuwa ni neema, bali kuwa ni deni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kwa mtu asiyefanya kazi, bali anamwamini yeye ambaye amhesabia haki asiyekuwa mtauwa, imani yake mtu huyo imehesabiwa kuwa haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.1"
              },
              "items": [
                {
                  "text": "Zab 32:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.32.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kama vile Daudi ainenavyo heri yake mtu yule ambaye Mungu amhesabia kuwa na haki pasipo matendo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        }
      ]
    },
