                  "text": "Mwa 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeye asiyekuwa dhaifu wa imani, alifikiri hali ya mwili wake uliokuwa umekwisha kufa, (akiwa amekwisha kupata umri wa kama miaka mia moja), na hali ya utasa wa tumbo lake Sara.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:19",
              "type": "text"
            },
            {
              "text": "Katika Kigiriki ni ‘hali ya kufa ya tumbo lake Sara’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
