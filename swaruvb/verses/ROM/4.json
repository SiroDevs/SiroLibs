              "items": [
                {
                  "text": "Isa 48:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (kama ilivyoandikwa, Nimekuweka kuwa baba wa mataifa mengi); mbele zake yeye aliyemwamini, yaani Mungu, mwenye kuwahuisha wafu, ayatajaye yale yasiyokuwako kana kwamba yamekuwako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
