              },
              "items": [
                {
                  "text": "Gal 3:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana ahadi ile ya kwamba atakuwa mrithi wa ulimwengu alipewa Abrahamu na uzao wake, si kwa sheria bali kwa haki aliyohesabiwa kwa imani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
