                  "text": "Mwa 15:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye aliamini kwa kutarajia yasiyoweza kutarajiwa, ili apate kuwa baba wa mataifa mengi, kama ilivyonenwa, Ndivyo utakavyokuwa uzao wako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
