          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gal 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana ikiwa wale wa sheria ndio warithi, imani imekuwa bure, na ahadi imebatilika. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
