          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.7"
              },
              "items": [
                {
                  "text": "Gal 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo ilitoka katika imani, iwe kwa njia ya neema, ili kwamba ile ahadi iwe imara kwa wazawa wote; si kwa wale wa torati tu, ila na kwa wale wa imani ya Abrahamu; aliye baba yetu sisi sote; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
