                "loc": "GEN.15.6"
              },
              "items": [
                {
                  "text": "Mwa 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.6"
              },
              "items": [
                {
                  "text": "Gal 3:6",
                  "type": "text"
                }
