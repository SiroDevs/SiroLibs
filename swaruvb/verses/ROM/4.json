          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "huku akijua hakika ya kuwa Mungu aweza kufanya yale aliyoahidi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
