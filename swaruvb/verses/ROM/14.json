                "loc": "PHP.2.10"
              },
              "items": [
                {
                  "text": "Flp 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
