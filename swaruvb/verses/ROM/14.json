                "loc": "ISA.45.23"
              },
              "items": [
                {
                  "text": "Isa 45:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.18"
              },
              "items": [
                {
                  "text": "49:18",
