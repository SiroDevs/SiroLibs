              "items": [
                {
                  "text": "1 Kor 8:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni vyema kutokula nyama wala kunywa divai wala kutenda neno lolote ambalo kwa hilo ndugu yako hukwazwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.21",
            "verseOrgIds": [
              "ROM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
