                "loc": "PHP.2.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kuwa imeandikwa,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.11",
            "verseOrgIds": [
              "ROM.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usimkwaze mwingine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.12",
            "verseOrgIds": [
              "ROM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi tusiendelee kuhukumiana, bali amueni kuwa mtu asifanye kitu cha kumkwaza ndugu au cha kumwangusha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.13",
            "verseOrgIds": [
              "ROM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.11"
              },
              "items": [
                {
                  "text": "Mt 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.15"
              },
              "items": [
                {
                  "text": "Mdo 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.15"
              },
              "items": [
                {
                  "text": "Tit 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Najua, tena nimehakikishwa sana katika Bwana Yesu, ya kuwa hakuna kitu kilicho najisi kwa asili yake, lakini kwake yeye akionaye kitu kuwa najisi, kwake huyo kitu kile ni najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.14",
            "verseOrgIds": [
              "ROM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.11+1CO.8.12+1CO.8.13"
              },
              "items": [
                {
                  "text": "1 Kor 8:11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na ndugu yako akichukizwa kwa sababu ya chakula, umeacha kwenda katika upendo. Kwa chakula chako usimharibu mtu yule ambaye Kristo alikufa kwa ajili yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.15",
            "verseOrgIds": [
              "ROM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.5"
              },
              "items": [
                {
                  "text": "Tit 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, huo wema wenu usitajwe kwa ubaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.16",
            "verseOrgIds": [
              "ROM.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.20"
              },
              "items": [
                {
                  "text": "Lk 17:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana ufalme wa Mungu si kula wala kunywa, bali ni haki na amani na furaha katika Roho Mtakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.17",
            "verseOrgIds": [
              "ROM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa yeye amtumikiaye Kristo katika mambo hayo humpendeza Mungu, tena hukubaliwa na wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.18",
            "verseOrgIds": [
              "ROM.14.18"
            ]
          }
        },
