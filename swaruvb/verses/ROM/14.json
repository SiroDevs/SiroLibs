              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya chakula usiiharibu kazi ya Mungu. Kweli, vyote ni safi; bali ni vibaya kwa mtu alaye na kujikwaza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.20",
            "verseOrgIds": [
              "ROM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
