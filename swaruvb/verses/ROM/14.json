            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.31"
              },
              "items": [
                {
                  "text": "Mt 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini wewe je! Mbona wamhukumu ndugu yako? Au wewe je! Mbona wamdharau ndugu yako? Kwa maana sisi sote tutasimama mbele ya kiti cha hukumu cha Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.10",
            "verseOrgIds": [
              "ROM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
