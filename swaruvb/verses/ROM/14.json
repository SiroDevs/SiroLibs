                }
              ]
            }
          ]
        },
        {
          "text": " Basi kama ni hivyo, na mfuate mambo ya amani na mambo yafaayo kwa kujengana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.19",
            "verseOrgIds": [
