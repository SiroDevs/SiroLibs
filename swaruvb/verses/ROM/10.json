              },
              "items": [
                {
                  "text": "Mdo 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndugu zangu, nitakayo sana moyoni mwangu, na dua yangu nimwombayo Mungu, ni kwa ajili yao, ili waokolewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.1",
            "verseOrgIds": [
              "ROM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana nawashuhudia kwamba wana juhudi kwa ajili ya Mungu, lakini si katika maarifa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.2",
            "verseOrgIds": [
              "ROM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.31"
              },
              "items": [
                {
                  "text": "Rum 9:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana, wakiwa hawaijui haki ya Mungu, na wakitaka kuithibitisha haki yao wenyewe, hawakujitia chini ya haki ya Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.3",
            "verseOrgIds": [
              "ROM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.17"
              },
              "items": [
                {
                  "text": "Mt 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.18"
              },
              "items": [
                {
                  "text": "Yn 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.8.13"
              },
              "items": [
                {
                  "text": "Ebr 8:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana Kristo ni mwisho wa sheria, ili kila aaminiye ahesabiwe haki.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wokovu ni kwa wote",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
