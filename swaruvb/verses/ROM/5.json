        },
        {
          "text": " na tumaini halitahayarishi; kwa maana pendo la Mungu limekwisha kumiminwa katika mioyo yetu na Roho Mtakatifu tuliyepewa sisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana hapo tulipokuwa hatuna nguvu, wakati ulipotimia, Kristo alikufa kwa ajili ya waovu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.6",
            "verseOrgIds": [
              "ROM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa ni shida mtu kufa kwa ajili ya mtu mwenye haki; lakini yawezekana mtu kuthubutu kufa kwa ajili ya mtu aliye mwema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.7",
            "verseOrgIds": [
              "ROM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
