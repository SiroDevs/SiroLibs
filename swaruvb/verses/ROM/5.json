                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala si hivyo tu, ila na mfurahi katika dhiki pia; mkijua ya kuwa dhiki, kazi yake ni kuleta subira; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.3",
            "verseOrgIds": [
              "ROM.5.3"
            ]
          }
        },
        {
