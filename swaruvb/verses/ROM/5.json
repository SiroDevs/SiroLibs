                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ambaye kwa yeye tumepata kwa njia ya imani kuifikia neema hii ambayo mnasimama ndani yake; na kufurahi katika tumaini la utukufu wa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
