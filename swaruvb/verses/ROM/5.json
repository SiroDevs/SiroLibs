              },
              "items": [
                {
                  "text": "Rum 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " maana kabla ya sheria dhambi ilikuwamo ulimwenguni, lakini dhambi haihesabiwi isipokuwapo sheria; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
