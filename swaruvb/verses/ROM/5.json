                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi zaidi sana tukiisha kuhesabiwa haki katika damu yake, tutaokolewa na ghadhabu kwa yeye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.9",
            "verseOrgIds": [
              "ROM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 5:10"
          },
          "items": [
