                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "Kut 32:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana ningeweza kuomba mimi mwenyewe niharimishwe na kutengwa na Kristo kwa ajili ya ndugu zangu, jamaa zangu kwa jinsi ya mwili; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
