                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ambao ni Waisraeli, wenye kule kufanywa wana, na ule utukufu, na maagano, na kupewa torati, na ibada ya Mungu, na ahadi zake; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
