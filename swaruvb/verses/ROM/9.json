              "type": "text"
            }
          ]
        },
        {
          "text": "Nasema kweli katika Kristo, sisemi uongo, dhamiri yangu ikinishuhudia katika Roho Mtakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya kwamba nina huzuni nyingi na maumivu yasiyoisha moyoni mwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
