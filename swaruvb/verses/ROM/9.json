              "items": [
                {
                  "text": "Mal 1:2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kama ilivyoandikwa, Nimempenda Yakobo, bali Esau nimemchukia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
