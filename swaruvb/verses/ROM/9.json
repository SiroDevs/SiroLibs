              "attrs": {
                "loc": "ISA.45.9"
              },
              "items": [
                {
                  "text": "45:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " La! Sivyo, Ee binadamu; wewe u nani umjibuye Mungu? Je! Kitu kilichoumbwa kimwambie yeye aliyekiumba, Kwa nini umeniumba hivi? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "name": "verse",
