            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tuseme nini basi? Kuna udhalimu kwa Mungu? La hasha! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.14",
            "verseOrgIds": [
              "ROM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
