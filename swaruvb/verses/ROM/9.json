              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, utaniambia, Mbona angali akilaumu? Kwa maana ni nani ashindanaye na kusudi lake? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
            "verseOrgIds": [
              "ROM.9.19"
            ]
          }
        },
        {
