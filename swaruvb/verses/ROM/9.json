              "items": [
                {
                  "text": "Yer 50:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni nini basi, ikiwa Mungu kwa kutaka kuonesha ghadhabu yake, na kuudhihirisha uweza wake, kwa uvumilivu mwingi, alichukuliana na vile vyombo vya ghadhabu vilivyokuwa karibu kuharibiwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
        },
