              "items": [
                {
                  "text": "Yer 18:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Au mfinyanzi je! Hana amri juu ya udongo, kwa fungu moja la udongo kuumba chombo kimoja kiwe cha heshima, na kimoja kiwe hakina heshima? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        },
        {
