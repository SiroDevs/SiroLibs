                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tena, ili audhihirishe wingi wa utukufu wake katika vile vyombo vya rehema, alivyovitengeneza tangu zamani vipate utukufu; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
