            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.5"
              },
              "items": [
                {
                  "text": "Zab 51:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.6"
              },
              "items": [
                {
                  "text": "Yn 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana twajua ya kuwa torati asili yake ni ya rohoni; bali mimi ni mtu wa mwilini, nimeuzwa chini ya dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.14",
            "verseOrgIds": [
              "ROM.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.17"
              },
              "items": [
                {
                  "text": "Gal 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana sijui nifanyalo, kwa sababu lile nilipendalo, silitendi; bali lile nilichukialo ndilo ninalolitenda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.15",
            "verseOrgIds": [
              "ROM.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kama nikilitenda lile nisilolipenda, naikiri ile sheria ya kuwa ni njema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.16",
            "verseOrgIds": [
              "ROM.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa si mimi nafsi yangu ninayetenda hilo, bali ni ile dhambi ikaayo ndani yangu ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.17",
            "verseOrgIds": [
              "ROM.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5"
              },
              "items": [
                {
                  "text": "Mwa 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.21"
              },
              "items": [
                {
                  "text": "8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana najua ya kuwa ndani yangu, yaani, ndani ya mwili wangu, halikai neno jema; kwa kuwa kutaka nataka, bali kutenda lililo jema siwezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.18",
            "verseOrgIds": [
              "ROM.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana lile jema nilipendalo, silitendi; bali lile baya nisilolipenda ndilo nilitendalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.19",
            "verseOrgIds": [
              "ROM.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi kama lile nisilolipenda ndilo nilitendalo, si mimi nafsi yangu nilitendaye, bali ni ile dhambi ikaayo ndani yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nimeona sheria hii, ya kuwa kwangu mimi nitakaye kutenda lililo jema, lipo lililo baya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
            "verseOrgIds": [
              "ROM.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana naifurahia sheria ya Mungu kwa utu wa ndani, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.22",
            "verseOrgIds": [
              "ROM.7.22"
            ]
          }
        },
