                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Kum 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tusemeje, basi? Torati ni dhambi? La hasha! Lakini singalitambua dhambi ila kwa sheria; kwa kuwa singalijua kutamani, kama torati isingalisema, Usitamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.13"
              },
              "items": [
                {
                  "text": "Rum 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini dhambi ilipata nafasi kwa ile amri, ikafanya ndani yangu kila namna ya kutamani. Kwa maana dhambi bila sheria imekufa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nilikuwa hai hapo kwanza bila sheria; ila ilipokuja ile amri, dhambi ilihuika, nami nikafa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
              },
              "items": [
                {
                  "text": "Yak 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Law 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikaona ya kuwa ile amri iletayo uzima kwangu mimi ilileta mauti. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.13"
              },
              "items": [
                {
                  "text": "Mwa 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana dhambi, kwa kupata nafasi kwa ile amri, ilinidanganya, na kwa hiyo ikaniua. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.8"
              },
              "items": [
                {
                  "text": "1 Tim 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi torati ni takatifu, na ile amri ni takatifu, na ya haki, na njema. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.20"
              },
              "items": [
                {
                  "text": "Rum 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi je! Ile iliyo njema ilikuwa mauti kwangu mimi? La hasha! Bali dhambi, ili ionekane kuwa ni dhambi hasa, ilifanya mauti ndani yangu kwa njia ya ile njema, kusudi kwa ile amri dhambi izidi kuwa mbaya mno.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        }
      ]
    },
