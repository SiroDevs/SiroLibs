              "items": [
                {
                  "text": "1 Kor 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ya kwamba Injili yetu haikuwafikia katika maneno tu, bali na katika nguvu, na katika Roho Mtakatifu, na uthibitifu mwingi; kama vile mnavyojua jinsi zilivyokuwa tabia zetu kwenu, kwa ajili yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
