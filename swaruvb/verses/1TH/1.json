              "type": "text"
            }
          ]
        },
        {
          "text": " Twamshukuru Mungu siku zote kwa ajili yenu nyote, tukiwataja katika maombi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
