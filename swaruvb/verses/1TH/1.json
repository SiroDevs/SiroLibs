                }
              ]
            }
          ]
        },
        {
          "text": " Paulo, Silwano na Timotheo, kwa kanisa la Wathesalonike, lililo katika Mungu Baba, na katika Bwana Yesu Kristo. Neema na iwe kwenu na amani.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
