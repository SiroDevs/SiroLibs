                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala hatuachi kuikumbuka kazi yenu ya imani, na taabu yenu ya upendo, na subira yenu ya tumaini lililo katika Bwana wetu Yesu Kristo, mbele za Mungu Baba yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana, ndugu mnaopendwa na Mungu, tunajua uteule wenu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
