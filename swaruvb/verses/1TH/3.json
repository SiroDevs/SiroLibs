                }
              ]
            }
          ]
        },
        {
          "text": " Basi kwa hiyo, tulipokuwa hatuwezi kuvumilia zaidi, tuliona vema kuachwa Athene peke yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
