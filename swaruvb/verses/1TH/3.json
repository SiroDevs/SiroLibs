              "items": [
                {
                  "text": "2 The 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mtu asifadhaishwe na dhiki hizi; maana ninyi wenyewe mnajua ya kuwa ndizo tulizowekewa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
