            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.16"
              },
              "items": [
                {
                  "text": "Flp 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo mimi nami nilipokuwa siwezi kuvumilia tena, nilituma mtu ili niijue imani yenu, asije yule mjaribu akawajaribu, na taabu yetu ikawa haina faida.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
