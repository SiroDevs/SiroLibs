                {
                  "text": "Mdo 16:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tukamtuma Timotheo ndugu yetu, mtumishi wa Mungu katika Injili ya Kristo, ili kuwafanya ninyi imara na kuwafariji katika imani yenu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
