              },
              "items": [
                {
                  "text": "2 The 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "Mdo 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kuwa tulipokuwapo kwenu tulitangulia kuwaambia kwamba tutapata dhiki, kama ilivyotukia, nanyi mnajua. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
