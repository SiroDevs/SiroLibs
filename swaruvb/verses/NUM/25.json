              "items": [
                {
                  "text": "Mdo 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tena kwake yeye, na kizazi chake baada yake, litakuwa agano la ukuhani wa milele; kwa sababu alikuwa na wivu kwa ajili ya Mungu wake, na kuwafanyia upatanisho wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        },
        {
