                {
                  "text": "1 Fal 18:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Musa akawaambia waamuzi wa Israeli, Waueni kila mtu watu wake waliojiungamanisha na Baal-peori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
