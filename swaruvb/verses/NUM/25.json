                  "text": "Zab 106:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa Israeli kujiungamanisha na Baal-peori; hasira za BWANA zikawaka juu ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
