              "items": [
                {
                  "text": "Kum 13:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha BWANA akamwambia Musa, Watwae wakuu wote wa watu hao, uwanyongee juani mbele ya BWANA ili kwamba hizo hasira kali za BWANA ziwaondokee Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
