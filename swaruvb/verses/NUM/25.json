              "items": [
                {
                  "text": "Kut 6:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Finehasi mwana wa Eleazari, mwana wa Haruni kuhani, alipoona jambo hilo, akaondoka hapo katikati ya mkutano, akashika fumo mkononi mwake; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamwandama huyo mtu wa Israeli na kuingia ndani ya hema nyuma yake, naye akawachoma wote wawili kwa fumo lake, yule mume wa Israeli na huyo mwanamke kati ya tumbo lake. Basi pigo likazuiwa kwao wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
