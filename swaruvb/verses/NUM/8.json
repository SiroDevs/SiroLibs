                "loc": "LEV.2.1"
              },
              "items": [
                {
                  "text": "Law 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha na watwae ng'ombe dume mmoja mchanga, na sadaka yake ya unga, unga mwembamba uliochanganywa na mafuta, nawe utatwaa ng'ombe dume mchanga mwingine kuwa sadaka ya dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
            "verseOrgIds": [
              "NUM.8.8"
            ]
          }
        },
        {
