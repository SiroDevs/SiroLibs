              "items": [
                {
                  "text": "Law 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe utawaleta Walawi mbele ya hema ya kukutania; nawe utauitisha mkutano wote wa wana wa Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
