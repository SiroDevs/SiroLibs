                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndivyo utakavyowatenga Walawi na kuwatoa katika wana wa Israeli; na Walawi watakuwa wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
