        {
          "text": " Nena na Haruni, ukamwambie, Utakapoziweka taa, hizo taa saba zitatoa nuru hapo mbele ya kinara cha taa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
