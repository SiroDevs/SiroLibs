                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe utawafanyia mambo haya ili kuwatakasa; nyunyiza juu yao maji yatakasayo dhambi, nao wajinyoe kwa wembe mwili wote, kisha wazifue nguo zao, na kujitakasa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.7",
            "verseOrgIds": [
              "NUM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
