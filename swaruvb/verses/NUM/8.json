          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Haruni atawasongeza Walawi mbele za BWANA wawe sadaka ya kutikiswa, kwa ajili ya wana wa Israeli, ili wawe watumishi wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
