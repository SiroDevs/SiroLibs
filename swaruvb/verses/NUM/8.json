              "items": [
                {
                  "text": "Law 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nawe utawaleta Walawi mbele za BWANA; kisha wana wa Israeli wataweka mikono yao juu ya Walawi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.10",
            "verseOrgIds": [
              "NUM.8.10"
            ]
          }
        },
        {
