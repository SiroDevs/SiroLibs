              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Haruni akafanya; akaziweka taa zake ili zitoe nuru hapo mbele ya kinara, kama BWANA alivyomwagiza Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
