        },
        {
          "text": " Musa akawatuma ili waipeleleze nchi ya Kanaani, akawaambia, Pandeni sasa katika Negebu mkapande milimani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
