              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha BWANA akanena na Musa, akamwambia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
