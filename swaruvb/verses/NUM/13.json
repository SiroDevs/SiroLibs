              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakapanda wakaipeleleza nchi toka jangwa la Sini hadi Rehobu, mpaka kuingia Hamathi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
