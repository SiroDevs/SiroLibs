              "type": "text"
            },
            {
              "text": "Maana yake ni ‘shada’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwa sababu ya hicho kishada walichokata huko wana wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
