            {
              "text": "12:3",
              "type": "text"
            },
            {
              "text": "Au mnyenyekevu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " sana zaidi ya wanadamu wote waliokuwa juu ya uso wa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
