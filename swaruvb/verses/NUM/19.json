          },
          "items": [
            {
              "text": "19:18",
              "type": "text"
            },
            {
              "text": "Mmea mdogo ambao kitawi chake au jani lake huutumiwa kunyunyizia watu au vitu maji kuhusiana na utakaso katika ibada.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na kuitia katika hayo maji naye atayanyunyiza juu ya hema, na juu ya vyombo vyote, na juu ya watu waliokuwapo, na juu yake yeye aliyeugusa mfupa, au mtu aliyeuawa, au mzoga, au kaburi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.18",
            "verseOrgIds": [
              "NUM.19.18"
            ]
          }
        },
        {
