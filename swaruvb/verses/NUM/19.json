                {
                  "text": "Hes 31:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.32"
              },
              "items": [
                {
                  "text": "Law 11:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kila chombo kilicho wazi, kisichofungwa na kifuniko, ni najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mtu yeyote huko nje shambani atakayemgusa mtu aliyeuawa kwa upanga, au mzoga, au mfupa wa mtu, au kaburi, atakuwa najisi muda wa siku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kwa huyo aliye najisi watatwaa katika majivu ya kuchomwa kwake hiyo sadaka ya dhambi, na maji ya mtoni yatachanganywa na majivu katika chombo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
        },
