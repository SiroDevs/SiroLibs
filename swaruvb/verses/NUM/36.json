              "items": [
                {
                  "text": "Hes 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisha wale wakuu wa nyumba za mababa ya jamaa ya wana wa Gileadi, mwana wa Makiri, mwana wa Manase, katika jamaa za wana wa Yusufu, wakakaribia, na kunena mbele ya Musa, na mbele ya wakuu walio juu ya nyumba za mababa ya wana wa Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 36:2"
          },
          "items": [
