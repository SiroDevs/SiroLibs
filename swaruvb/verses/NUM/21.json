              "attrs": {
                "loc": "DEU.2.1"
              },
              "items": [
                {
                  "text": "Kum 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akasikiza sauti ya Israeli, akawatia Wakanaani mikononi mwao; nao wakawaharibu wao na miji yao kabisa; na jina la mahali hapo likaitwa Horma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:3",
              "type": "text"
            },
            {
              "text": "Maana yake ni ‘maangamizi’.",
              "type": "text"
            }
          ]
        }
      ]
    },
