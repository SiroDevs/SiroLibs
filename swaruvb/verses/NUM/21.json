            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:6",
              "type": "text"
            },
            {
              "text": "‘nyoka wenye sumu’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kati ya watu, wakawauma, watu wengi wakafa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
