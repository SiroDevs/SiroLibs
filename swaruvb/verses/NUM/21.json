            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akafanya nyoka ya shaba, akaiweka juu ya mti, hata ikiwa nyoka amemwuma mtu, alipoitazama ile nyoka ya shaba, akaishi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Safari kuelekea Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
