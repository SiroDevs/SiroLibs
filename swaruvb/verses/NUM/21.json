          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wana wa Israeli wakasafiri, wakapiga kambi Obothi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasafiri kutoka Obothi, wakapanga Iye-abarimu, katika jangwa lililoelekea Moabu, upande wa maawio ya jua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoka huko wakasafiri, wakapanga katika bonde la Zeredi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.36"
              },
              "items": [
                {
                  "text": "Hes 22:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.18"
              },
              "items": [
                {
                  "text": "Amu 11:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kutoka huko wakasafiri, wakapanga upande wa pili wa Arnoni, ulio jangwani,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:13",
              "type": "text"
            },
            {
              "text": "Katika makala ya Kiebrania ni ‘ambao uko jangwani’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " utokao katika mpaka wa Waamori; maana, Arnoni ndio mpaka wa Moabu, kati ya Moabu na Waamori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo imesemwa katika Kitabu cha Vita vya BWANA,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
