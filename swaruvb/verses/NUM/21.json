        },
        {
          "text": "Wakasafiri kutoka mlima wa Hori kwa njia ya Bahari ya Shamu; ili kuizunguka nchi ya Edomu, watu wakafa moyo kwa sababu ya ile njia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
