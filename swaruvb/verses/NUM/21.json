                  "text": "Kum 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akatuma nyoka za moto",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
