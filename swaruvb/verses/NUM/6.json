                  "text": "Mt 8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku hizo zote ambazo alijiweka awe wa BWANA asikaribie maiti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
