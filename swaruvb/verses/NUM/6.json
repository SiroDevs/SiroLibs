              },
              "items": [
                {
                  "text": "Lk 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nena na watu wa Israeli, uwaambie, Mwanamume au mwanamke atakapoweka nadhiri maalumu, nadhiri ya Mnadhiri,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:2",
              "type": "text"
            },
            {
              "text": "Au aliyewekwa wakfu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ili ajiweke wakfu kwa BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.15"
              },
              "items": [
                {
                  "text": "Lk 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " atajitenga na divai na vileo; hatakunywa siki ya divai, wala siki ya kileo, wala asinywe maji yoyote ya zabibu, wala asile zabibu, mbichi wala zilizokauka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku zote za kujitenga kwake asile kitu chochote kilichoandaliwa kwa mzabibu, tangu kokwa hata maganda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.5"
              },
              "items": [
                {
                  "text": "Amu 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.11"
              },
              "items": [
                {
                  "text": "1 Sam 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.7"
              },
              "items": [
                {
                  "text": "Omb 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku zote za nadhiri yake ya kujitenga, wembe usimguse kichwani mwake; hata hizo siku zitakapotimia, ambazo alijiweka wakfu kwa BWANA, atakuwa mtakatifu, ataziacha nywele za kichwani mwake zikue ziwe ndefu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
