              "type": "text"
            }
          ]
        },
        {
          "text": "Na jeshi lake, na wale waliohesabiwa kwao, walikuwa elfu sabini na nne na mia sita. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
