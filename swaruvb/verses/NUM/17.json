              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.32"
              },
              "items": [
                {
                  "text": "Kut 16:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.19+NUM.31.20+NUM.31.21+NUM.31.22+NUM.31.23+NUM.31.24+NUM.31.25+NUM.31.26"
              },
              "items": [
                {
                  "text": "Hes 31:19-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha BWANA akamwambia Musa, Irudishe fimbo ya Haruni mbele ya ushahidi, ili itunzwe iwe ishara juu ya hawa wana wa maasi; ili uyakomeshe manung'uniko yao waliyoninung'unikia, ili wasife. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Musa akafanya hivyo; kama BWANA alivyomwagiza, ndivyo alivyofanya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        }
      ]
    },
