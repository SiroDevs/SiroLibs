              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila mtu akaribiaye, aikaribiaye maskani ya BWANA, hufa; je! Tutakufa sote pia?",
          "type": "text",
