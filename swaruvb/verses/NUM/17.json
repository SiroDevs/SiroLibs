              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha wana wa Israeli wakanena na Musa, na kumwambia, Angalia, sisi tunakufa, tunaangamia, sote tunaangamia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
