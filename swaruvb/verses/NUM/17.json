            "number": "1",
            "style": "v",
            "sid": "NUM 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha BWANA akanena na Musa, akamwambia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.1",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nena na wana wa Israeli, kisha upokee kwao fimbo, fimbo moja kwa ajili ya nyumba ya kila baba, katika wakuu wao wote, kama nyumba za baba zao zilivyo, fimbo kumi na mbili; kisha andika jina la kila mtu katika fimbo yake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.2",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na katika fimbo ya Lawi utaliandika jina la Haruni; maana, itakuwa fimbo moja kwa kila kichwa cha nyumba za baba zao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.3",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
