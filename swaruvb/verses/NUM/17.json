              "items": [
                {
                  "text": "Mdo 7:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Musa akaziweka hizo fimbo mbele za BWANA katika hema ya kukutania. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.7",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
