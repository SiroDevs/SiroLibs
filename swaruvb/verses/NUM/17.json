                  "text": "1 Fal 8:10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe utaziweka katika hema ya kukutania mbele ya huo ushahidi, hapo nikutanapo pamoja nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.4",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Hes 16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha itakuwa, mtu huyo nitakayemchagua, fimbo yake itachipuka nami nitayakomesha manung'uniko ya wana wa Israeli, wanung'unikiayo kwangu juu yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.5",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Musa akawaambia wana wa Israeli, ndipo wakuu wao wote wakampa fimbo, fimbo moja kwa kila mkuu, kama nyumba za baba zao zilivyokuwa, fimbo kumi na mbili; na fimbo ya Haruni ilikuwa kati ya fimbo zao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.6",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
