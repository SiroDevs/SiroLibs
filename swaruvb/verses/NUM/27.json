          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.29"
              },
              "items": [
                {
                  "text": "Hes 35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena ikiwa babaye hana ndugu, utampa huyo aliye karibu naye katika jamaa zake huo urithi wake, naye atakuwa nao; na neno hili litakuwa ni amri ya hukumu kwa wana wa Israeli, kama BWANA alivyomwagiza Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        }
      ]
