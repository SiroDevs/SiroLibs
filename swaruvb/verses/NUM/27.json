        },
        {
          "text": " Basi Musa akaleta neno lao mbele ya BWANA ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.5",
            "verseOrgIds": [
              "NUM.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
