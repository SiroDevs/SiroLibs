            "number": "6",
            "style": "v",
            "sid": "NUM 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akanena na Musa, na kumwambia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.6",
            "verseOrgIds": [
              "NUM.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.36.2"
              },
              "items": [
                {
                  "text": "Hes 36:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hao binti za Selofehadi wananena lililo haki; kweli utawapa milki ya urithi pamoja na ndugu za baba yao; nawe utawapa urithi wa baba yao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.7",
            "verseOrgIds": [
              "NUM.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha utanena na wana wa Israeli, na kuwaambia, Mtu akifa, naye hana mwana wa kiume, ndipo binti yake atapewa urithi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.8",
            "verseOrgIds": [
              "NUM.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena ikiwa hana binti, mtawapa nduguze urithi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.9",
            "verseOrgIds": [
              "NUM.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ikiwa hana ndugu, mtawapa ndugu za babaye huo urithi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.10",
            "verseOrgIds": [
              "NUM.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
