              "type": "text"
            }
          ]
        },
        {
          "text": "bali awe mkarimu, mpenda wema, mwenye kiasi, mwenye haki, mtakatifu, mwenye kudhibiti nafsi yake; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
