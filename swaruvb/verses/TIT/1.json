              "type": "text"
            }
          ]
        },
        {
          "text": "Mmoja wao, nabii wao wenyewe, amesema, Wakrete ni waongo siku zote, wanyama wabaya, walafi wavivu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
