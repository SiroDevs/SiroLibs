                  "text": "1 Pet 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hao wanapindua watu wa nyumba nzima, wakifundisha yasiyowapasa kwa ajili ya mapato ya aibu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
