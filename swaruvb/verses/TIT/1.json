        {
          "text": "Paulo, mtumwa wa Mungu, na mtume wa Yesu Kristo; kwa ajili ya imani ya wateule wa Mungu, na ujuzi wa kweli ile iletayo utauwa; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.1",
            "verseOrgIds": [
              "TIT.1.1"
            ]
          }
