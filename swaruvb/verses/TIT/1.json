          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika tumaini la uzima wa milele, ambao Mungu asiyeweza kusema uongo aliuahidi tangu milele; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.2",
            "verseOrgIds": [
              "TIT.1.2"
            ]
          }
