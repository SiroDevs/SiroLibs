              "type": "text"
            },
            {
              "text": "Askofu:",
              "type": "text"
            },
            {
              "text": "maana yake ni, Mwangalizi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " awe mtu asiyeshitakiwa neno, kwa kuwa ni wakili wa Mungu; asiwe mtu wa kujipendeza nafsi yake, asiwe mwepesi wa hasira, asiwe mlevi wala mgomvi, asiwe mpenda mapato ya aibu; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
