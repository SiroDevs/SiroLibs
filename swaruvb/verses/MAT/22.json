                  "text": "Gal 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika amri hizi mbili hutegemea Torati yote na vitabu vya Manabii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
