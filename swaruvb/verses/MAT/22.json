              "items": [
                {
                  "text": "Law 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na ya pili yafanana nayo, nayo ni hii, Mpende jirani yako kama nafsi yako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
