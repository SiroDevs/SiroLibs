                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wakisema, Mwalimu, Musa alisema, Mtu akifa, akiwa hana watoto, ndugu yake na amwoe yule mkewe, ili ampatie nduguye mzao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, kwetu kulikuwa na ndugu saba; wa kwanza akaoa, akafariki, na kwa kuwa hana mzao, akamwachia nduguye mke wake. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo wa pili naye, na wa tatu, hata wote saba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisho wa wote yule mwanamke akafa naye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, katika kiyama, atakuwa mke wa yupi kati ya wale saba? Maana wote walikuwa naye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu, akawaambia, Mnapotea, kwa kuwa hamyajui maandiko wala uweza wa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana katika kiyama hawaoi wala hawaolewi, bali huwa kama malaika mbinguni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena kuhusu kiyama ya wafu, hamjalisoma neno lililonenwa na Mungu, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.6"
              },
              "items": [
                {
                  "text": "Kut 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.11"
              },
              "items": [
                {
                  "text": "Mt 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi ni Mungu wa Abrahamu, na Mungu wa Isaka, na Mungu wa Yakobo? Mungu si Mungu wa wafu, bali wa walio hai. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na makutano waliposikia, walishangaa kwa mafunzo yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amri iliyo kuu zaidi",
          "type": "text"
        }
