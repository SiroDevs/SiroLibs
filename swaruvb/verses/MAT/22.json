                  "text": "Lk 10:25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mmoja wao, mwanasheria, akamwuliza, akimjaribu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
