          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalimu, katika torati ni amri ipi iliyo kuu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
