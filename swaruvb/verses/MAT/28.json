                  "text": "Dan 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu akaja kwao, akasema nao, akawaambia, Nimepewa mamlaka yote mbinguni na duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
