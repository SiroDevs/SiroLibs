                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu akaingia ndani ya hekalu, akawafukuza wote waliokuwa wakiuza na kununua hekaluni, akazipindua meza za wabadili fedha, na viti vyao waliokuwa wakiuza njiwa; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Isa 56:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " akawaambia, Imeandikwa, Nyumba yangu itaitwa nyumba ya sala; bali ninyi mmeifanya kuwa pango la wanyang'anyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vipofu na viwete wakamwendea mle hekaluni, akawaponya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25"
              },
              "items": [
                {
                  "text": "Zab 118:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini wakuu wa makuhani na waandishi walipoyaona maajabu aliyoyafanya, na watoto waliopaza sauti zao hekaluni, wakisema, Hosana, Mwana wa Daudi! Walikasirika, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.3"
              },
              "items": [
                {
                  "text": "Zab 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wakamwambia, Wasikia hawa wasemavyo? Yesu akawaambia, Naam; hamkupata kusoma, Kwa vinywa vya watoto wachanga na wanyonyao umejiandalia sifa? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaacha, akatoka nje ya mji mpaka Bethania, akalala huko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Aulaani Mtini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na asubuhi alipokuwa akienda mjini, aliona njaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6"
              },
              "items": [
                {
                  "text": "Lk 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaona mtini mmoja kando ya njia, akauendea, asione kitu juu yake ila majani tu; akauambia, Yasipatikane matunda kwako tangu leo hata milele. Mtini ukanyauka mara. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanafunzi walipoona, walistaajabu, wakisema, Jinsi gani mtini umenyauka mara? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mt 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.2"
              },
              "items": [
                {
                  "text": "1 Kor 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu akajibu, akawaambia, Amin, nawaambia Mkiwa na imani, msipokuwa na shaka, mtafanya si hilo la mtini tu, lakini hata mkiuambia mlima huu, Ng'oka, ukatupwe baharini, litatendeka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yoyote mtakayoyaomba katika sala mkiamini, mtapokea.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Swali kuhusu Mamlaka ya Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
