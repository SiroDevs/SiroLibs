              "attrs": {
                "loc": "LUK.20.9+LUK.20.10+LUK.20.11+LUK.20.12+LUK.20.13+LUK.20.14+LUK.20.15+LUK.20.16+LUK.20.17+LUK.20.18+LUK.20.19"
              },
              "items": [
                {
                  "text": "Lk 20:9-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sikilizeni mfano mwingine. Kulikuwa na mtu mwenye shamba, naye alipanda shamba la mizabibu, akalizungushia ua, akachimba shimo la shinikizo ndani yake, akajenga mnara, akapangisha wakulima, akasafiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
