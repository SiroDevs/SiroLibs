              "attrs": {
                "loc": "JHN.12.12+JHN.12.13+JHN.12.14+JHN.12.15+JHN.12.16+JHN.12.17+JHN.12.18+JHN.12.19"
              },
              "items": [
                {
                  "text": "Yn 12:12-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walipokaribia Yerusalemu, na kufika Bethfage, katika mlima wa Mizeituni, ndipo Yesu alipotuma wanafunzi wawili akiwaambia, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nendeni katika kijiji kile kinachowakabili, na mara mtaona punda amefungwa, na mwanapunda pamoja naye; wafungueni mniletee. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.18"
              },
              "items": [
                {
                  "text": "Mt 26:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kama mtu akiwaambia neno, semeni, Bwana anawahitaji; naye atawatuma mara moja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya yote yamekuwa, ili litimie neno lililonenwa na nabii, akisema,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atakasa hekalu",
          "type": "text"
        }
      ]
    },
