            }
          ]
        },
        {
          "text": " kwa maana nilikuwa na njaa, mkanipa chakula; nilikuwa na kiu, mkaninywesha; nilikuwa mgeni, mkanikaribisha; ",
          "type": "text",
          "attrs": {
