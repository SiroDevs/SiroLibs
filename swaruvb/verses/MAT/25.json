              },
              "items": [
                {
                  "text": "Mt 25:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwana wake akamwambia, Vema, mtumwa mwema na mwaminifu; ulikuwa mwaminifu kwa machache, nitakuweka juu ya mengi; ingia katika furaha ya bwana wako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaja na yule aliyepokea talanta moja, akasema, Bwana, nilitambua ya kuwa wewe u mtu mgumu, wavuna usipopanda, wakusanya usipotawanya; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi nikaogopa, nikaenda nikaificha talanta yako katika ardhi; tazama, unayo iliyo yako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        },
