              "type": "text"
            }
          ]
        },
        {
          "text": "nilikuwa uchi, mkanivika nilikuwa mgonjwa, mkaja kunitazama; nilikuwa kifungoni, mkanijia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
