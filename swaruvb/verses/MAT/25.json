          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni lini tena tulipokuona ukiwa mgonjwa, au ukiwa kifungoni, tukakujia? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
