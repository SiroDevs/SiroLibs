              "type": "text"
            }
          ]
        },
        {
          "text": "nilikuwa mgeni, msinikaribishe; nilikuwa uchi, msinivike; nilikuwa mgonjwa, na kifungoni, msije kunitazama. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
