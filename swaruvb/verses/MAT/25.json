                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo wenye haki watakapomjibu, wakisema, Bwana, ni lini tulipokuona ukiwa na njaa, tukakulisha, au ukiwa na kiu tukakunywesha? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
