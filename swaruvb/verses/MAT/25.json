              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye atawajibu, akisema, Amin, nawaambia, Kadiri msivyomtendea mmojawapo wa hao walio wadogo, hamkunitendea mimi. ",
          "type": "text",
          "attrs": {
