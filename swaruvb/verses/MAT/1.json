          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu, mumewe, kwa vile alivyokuwa mtu wa haki, asitake kumwaibisha, aliazimu kumwacha kwa siri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        },
