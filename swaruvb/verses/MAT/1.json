                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi alipokuwa akifikiri hayo, tazama, malaika wa Bwana alimtokea katika ndoto, akisema, Yusufu, mwana wa Daudi, usihofu kumchukua Mariamu mkeo, maana mimba yake ni kwa uweza wa Roho Mtakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
