            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwa kuwa ninayo mambo mengi, sitaki kuyaandika kwa karatasi na wino; lakini natarajia kuja kwenu, na kusema nanyi uso kwa uso, ili furaha yetu iwe imetimizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        },
