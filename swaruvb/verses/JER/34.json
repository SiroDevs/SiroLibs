                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA, Mungu wa Israeli, asema hivi, Nenda ukaseme na Sedekia, mfalme wa Yuda, ukamwambie, BWANA asema hivi, Tazama, nitatia mji huu katika mikono ya mfalme wa Babeli, naye atauteketeza kwa moto; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
