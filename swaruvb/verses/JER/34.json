            }
          ]
        },
        {
          "text": " ya kwamba kila mtu amweke huru mtumwa wake, na kila mtu amweke huru mjakazi wake, ikiwa yule mwanamume au yule mwanamke ni Mwebrania; mtu yeyote asiwatumikishe, yaani, asimtumikishe Myahudi, nduguye; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
