              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo lisikie neno la BWANA, Ee Sedekia, mfalme wa Yuda; BWANA asema hivi kukuhusu; hutakufa kwa upanga; ",
          "type": "text",
          "attrs": {
