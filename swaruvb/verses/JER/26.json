        },
        {
          "text": " Nawe utawaambia, BWANA asema hivi, Kama hamtaki kunisikia, kwenda katika sheria yangu, niliyoiweka mbele yenu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
