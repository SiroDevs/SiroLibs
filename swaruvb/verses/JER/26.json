                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuyasikiliza maneno ya watumishi wangu, manabii, ninaowatuma kwenu, naam, nikiondoka mapema na kuwatuma; lakini ninyi hamkuwasikiliza; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
