          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.4"
              },
              "items": [
                {
                  "text": "Yer 38:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.61"
              },
              "items": [
                {
                  "text": "Mt 26:61",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo hapo makuhani, na manabii, wakawaambia wakuu na watu wote, wakisema, Mtu huyu anastahili hukumu ya kifo, kwa sababu ametabiri juu ya mji huu, kama mlivyosikia kwa masikio yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yeremia akawaambia wakuu wote na watu wote, akisema, BWANA ndiye aliyenituma kutabiri juu ya nyumba hii, na juu ya mji huu, maneno hayo yote mliyoyasikia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
