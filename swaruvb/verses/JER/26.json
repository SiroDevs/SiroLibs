            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na wakuu wa Yuda waliposikia habari za mambo haya, wakatoka katika nyumba ya mfalme, wakapanda juu mpaka nyumbani kwa BWANA; wakaketi, hapo watu waingiliapo katika lango jipya la nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
