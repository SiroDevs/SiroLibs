              },
              "items": [
                {
                  "text": "Yer 24:8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA wa majeshi asema hivi, Tazama, nitaleta juu yao upanga, na njaa, na tauni, nami nitawafanya kuwa kama tini mbovu, zisizoweza kuliwa, kwa kuwa ni mbovu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
