              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kautakieni amani mji ule, ambao nimewafanya mchukuliwe mateka, mkauombee kwa BWANA; kwa maana katika amani yake mji huo ninyi mtapata amani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.14"
              },
              "items": [
                {
                  "text": "Yer 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.21"
