                  "text": "30:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitaonekana kwenu, asema BWANA, nami nitawarudisha watu wenu waliofungwa, nami nitawakusanya ninyi, nikiwatoa katika mataifa yote, na katika mahali pote, nilikowafukuza, asema BWANA; nami nitawaleta tena, hadi mahali ambapo kutoka hapo niliwafanya mchukuliwe mateka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana mmesema, BWANA ametuinulia manabii huko Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana BWANA asema hivi, kuhusu mfalme aketiye katika kiti cha enzi cha Daudi, na kuhusu watu wote wakaao ndani ya mji huu, ndugu zenu wasiokwenda pamoja nanyi kufungwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
