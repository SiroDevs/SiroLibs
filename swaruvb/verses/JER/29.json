              },
              "items": [
                {
                  "text": "2 Nya 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maneno haya ndiyo maneno ya barua, ambayo nabii Yeremia alituma toka Yerusalemu, kwa hao waliobaki wa wakuu waliochukuliwa mateka, na kwa makuhani, na kwa manabii, na kwa watu wote, ambao Nebukadneza aliwachukua mateka toka Yerusalemu hadi Babeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "(hapo walipokwisha kutoka Yerusalemu Yekonia mfalme, na mama yake mfalme, na matowashi, na wakuu wa Yuda na Yerusalemu, na mafundi, na wahunzi;) ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwa mkono wa Elasa, mwana wa Shafani, na Gemaria, mwana wa Hilkia, (ambao Sedekia, mfalme wa Yuda, aliwatuma hadi Babeli, kwa Nebukadneza, mfalme wa Babeli), kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi, Mungu wa Israeli, awaambia hivi watu wote waliochukuliwa mateka, niliowafanya wachukuliwe toka Yerusalemu mpaka Babeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jengeni nyumba, mkakae ndani yake, kapandeni bustani, mkale matunda yake; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "oeni wake, mkazae wana na binti; kawaozeni wake wana wenu, mkawaoze waume binti zenu, wazae wana na binti; mkaongezeke huko wala msipungue. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
