              "items": [
                {
                  "text": "Efe 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana BWANA wa majeshi, Mungu wa Israeli, asema hivi, Manabii walio kati yenu, na wabashiri wenu, wasiwadanganye ninyi, wala msisikilize ndoto zenu, mnazootesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana kwa jina langu hutabiri maneno ya uongo kwenu; mimi sikuwatuma, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        },
