        },
        {
          "text": " bali watamtumikia BWANA, Mungu wao, na Daudi, mfalme wao, nitakayemwinua kwa ajili yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
