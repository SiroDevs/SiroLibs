                "loc": "JOB.30.21"
              },
              "items": [
                {
                  "text": "30:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wote wakupendao wamekusahau; hawakutafuti; maana nimekujeruhi kwa jeraha la adui, kwa adhabu ya mtu mkatili; kwa sababu ya ukubwa wa uovu wako, kwa sababu dhambi zako zilikuwa zimeongezeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona unalilia maumivu yako? Maumivu yako hayaponyeki; kwa sababu ya ukubwa wa uovu wako, kwa sababu dhambi zako zimeongezeka, nimekutenda haya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.15",
            "verseOrgIds": [
              "JER.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
