                  "text": "Isa 41:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, watu wote wakulao wataliwa; na adui zako wote watakwenda kufungwa; kila mmoja wao; na hao waliokuteka nyara watatekwa; na wote waliokuwinda nitawafanya kuwa mawindo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.16",
            "verseOrgIds": [
              "JER.30.16"
            ]
          }
        },
