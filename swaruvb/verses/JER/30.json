          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana mtu wa kukutetea; kwa jeraha lako huna dawa ziponyazo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
            "verseOrgIds": [
              "JER.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
