              "items": [
                {
                  "text": "Yer 15:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana BWANA asema hivi, Maumivu yako hayaponyeki, na jeraha lako ni kubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
