                "loc": "ISA.30.8"
              },
              "items": [
                {
                  "text": "Isa 30:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA Mungu wa Israeli, asema hivi, ya kwamba, Uyaandike kitabuni maneno hayo yote niliyokuambia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
