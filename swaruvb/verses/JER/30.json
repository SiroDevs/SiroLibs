                  "text": "Dan 12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ole! Maana siku ile ni kuu, hata hapana inayofanana nayo, maana ni wakati wa taabu yake Yakobo; lakini ataokolewa kutoka kwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na itakuwa katika siku ile, asema BWANA wa majeshi, nitaivunja nira yake itoke shingoni mwako, nami nitavipasua vifungo vyako; wala wageni hawatamtumikisha tena; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
