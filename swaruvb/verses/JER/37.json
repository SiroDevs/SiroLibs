                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sedekia, mfalme, akamtuma Yehukali, mwana wa Shelemia, na Sefania, mwana wa Maaseya, kuhani, kwa Yeremia, nabii, kusema, Utuombee sasa kwa BWANA, Mungu wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yeremia alikuwa akiingia na kutoka kati ya watu; kwa maana walikuwa hawajamfunga gerezani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.7"
              },
              "items": [
                {
                  "text": "2 Fal 24:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.21"
              },
              "items": [
                {
                  "text": "Yer 34:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na jeshi la Farao lilikuwa limetoka nchi ya Misri; na Wakaldayo waliohusuru Yerusalemu, waliposikia habari zao, wakavunja kambi yao mbele ya Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo neno la BWANA likamjia nabii Yeremia, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.2"
              },
              "items": [
                {
                  "text": "Yer 21:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA, Mungu wa Israeli, asema hivi; Mtamwambia hivi mfalme wa Yuda, aliyewatuma kwangu kuniuliza; Angalieni, jeshi la Farao, ambalo linakuja kuwasaidia, litarudi Misri, nchi yao wenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.10"
              },
              "items": [
                {
                  "text": "Zab 33:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.30"
