              "items": [
                {
                  "text": "Mit 29:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini yeye, wala watumishi wake, wala watu wa nchi, hawakuyasikiliza maneno ya BWANA aliyonena kwa kinywa cha nabii Yeremia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
