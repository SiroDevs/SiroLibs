            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.4"
              },
              "items": [
                {
                  "text": "Yer 21:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana mngelipiga jeshi lote la Wakaldayo wanaopigana nanyi, wakabaki kati yao watu waliojeruhiwa tu, hata hivyo wangeondoka kila mtu katika hema yake, na kuuteketeza mji huu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
