                "loc": "REV.2.10"
              },
              "items": [
                {
                  "text": "Ufu 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao wakuu wakamkasirikia Yeremia, wakampiga, wakamtia gerezani katika nyumba ya Yonathani, mwandishi; kwa maana ndiyo waliyoifanya kuwa gereza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.6"
              },
              "items": [
                {
                  "text": "Yer 38:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, Yeremia alipokuwa ameingia katika nyumba ya shimo, na katika vyumba vya ndani; na Yeremia alipokuwa amekaa humo siku nyingi; ",
          "type": "text",
          "attrs": {
