              "items": [
                {
                  "text": "Mit 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.1+ISA.30.2+ISA.30.3+ISA.30.4+ISA.30.5+ISA.30.6+ISA.30.7"
              },
              "items": [
                {
                  "text": "Isa 30:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.22"
              },
              "items": [
                {
                  "text": "Yer 34:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Wakaldayo watakuja tena, na kupigana na mji huu; nao watautwaa, na kuuteketeza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA asema hivi, Msijidanganye mkisema, Bila shaka Wakaldayo watatuacha na kwenda zao; maana hawatawaacha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
