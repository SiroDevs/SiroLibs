                {
                  "text": "Yer 16:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe, naam, wewe nafsi yako, utaachana na urithi wako niliokupa; nami nitakulazimisha kuwatumikia adui zako katika nchi usiyoijua; maana umewasha moto katika hasira yangu, utakaowaka milele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
