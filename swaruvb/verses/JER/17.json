          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na itakuwa, kama mkinisikiliza mimi kwa bidii, asema BWANA, msiingize mzigo wowote katika mlango wa mji huu siku ya sabato, bali muitakase siku ya sabato, bila kufanya kazi yoyote siku hiyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
