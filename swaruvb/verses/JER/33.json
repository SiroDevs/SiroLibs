              },
              "items": [
                {
                  "text": "Yer 30:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, nitauletea afya na kupona, nami nitawaponya; nami nitawafunulia wingi wa amani na kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
