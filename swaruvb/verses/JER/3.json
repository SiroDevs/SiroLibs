                  "text": "Lk 15:18-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ungama uovu wako tu; ya kwamba umemwasi BWANA, Mungu wako, na njia zako zimekuwa nyingi kuwaendea wageni chini ya kila mti wenye majani mabichi, wala hamkuitii sauti yangu, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
