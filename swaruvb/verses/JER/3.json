                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu hiyo manyunyu yamezuiliwa, wala hapakuwa na mvua ya vuli; hata hivyo ulikuwa na kipaji cha uso cha kahaba, ulikataa kutahayarika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        },
