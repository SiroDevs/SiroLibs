                  "text": "Rum 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rudini, enyi watoto wenye kuasi, asema BWANA; maana mimi ni mume wenu; nami nitatwaa mtu mmoja wa mji mmoja, na wawili wa jamaa moja, nami nitawaleta hadi Sayuni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
