                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je, tokea wakati huu hutanililia, Ee Baba yangu, wewe u kiongozi wa ujana wangu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Ataishika hasira yake hata milele? Ataishika hata mwisho? Tazama, umesema hivyo, bali umetenda mambo mabaya, umefuata njia yako mwenyewe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
