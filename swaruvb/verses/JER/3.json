              "type": "text"
            }
          ]
        },
        {
          "text": "Bali, kama vile mke amwachavyo mumewe kwa hiana, ndivyo mlivyonitenda mimi kwa hiana, Ee nyumba ya Israeli, asema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
