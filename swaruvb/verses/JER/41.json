                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena Ishmaeli akawaua Wayahudi wote waliokuwa pamoja naye, yaani, pamoja na Gedalia, huko Mizpa, na hao Wakaldayo walioonekana huko, yaani, watu wa vita. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
