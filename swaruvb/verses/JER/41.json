          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa siku ya pili baada ya kumwua Gedalia, wala hapakuwa na mtu aliyejua habari hii, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
