              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.14"
              },
              "items": [
                {
                  "text": "Gal 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bali wameenda katika ushupavu wa mioyo yao wenyewe, na kuandamana na Mabaali, kama walivyofundishwa na baba zao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
