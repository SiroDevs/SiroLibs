                {
                  "text": "Omb 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, BWANA wa majeshi, Mungu wa Israeli, asema hivi, Tazama, nitawalisha pakanga, naam, watu hawa, nami nitawapa maji yenye sumu wayanywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        },
