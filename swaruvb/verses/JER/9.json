              "attrs": {
                "loc": "1CO.15.34"
              },
              "items": [
                {
                  "text": "1 Kor 15:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Huupinda ulimi wao, kana kwamba ni upinde, ili kusema uongo; nao wamepata nguvu katika nchi, lakini si katika uaminifu; maana huendelea toka ubaya hata ubaya, wala hawanijui mimi, asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.5"
              },
              "items": [
                {
                  "text": "Mik 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jihadharini, kila mtu na jirani yake, wala msimtumaini ndugu awaye yote; maana kila ndugu atachongea, na kila jirani atakwenda huku na huko na kusingizia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watadanganya kila mtu jirani yake, wala hawatasema kweli; wameuzoesha ulimi wao kusema uongo; hujidhoofisha ili kutenda uovu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.24"
              },
              "items": [
                {
                  "text": "Mit 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Makao yako ya katikati ya hadaa; kwa hadaa wanakataa kunijua mimi, asema BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
