                "loc": "HOS.14.9"
              },
              "items": [
                {
                  "text": "Hos 14:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni nani aliye na hekima, apate kuelewa haya? Tena ni nani ambaye kinywa cha BWANA kimesema naye, apate kuyatangaza? Nayo ni nini maana yake nchi hii kuharibika, na kuteketea kama nyika, asipite mtu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        }
