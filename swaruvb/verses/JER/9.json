              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye BWANA asema, Ni kwa sababu wameiacha sheria yangu niliyoweka mbele yao, wala hawakuitii sauti yangu, wala kuenda katika hiyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
