              "items": [
                {
                  "text": "Eze 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitawatawanya kati ya mataifa, ambao wao hawakuwajua; wala baba zao, nami nitatuma upanga nyuma yao, hata nitakapowaangamiza kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
