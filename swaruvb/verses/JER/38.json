                  "text": "Isa 58:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ebedmeleki akatoka nyumbani mwa mfalme, akamwambia mfalme, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.8",
            "verseOrgIds": [
