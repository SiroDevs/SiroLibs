          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wakuu wakamwendea Yeremia, wakamwuliza; naye akawaambia sawasawa na maneno aliyoamriwa na mfalme. Basi wakaacha kunena naye; maana neno lile halikujulikana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
