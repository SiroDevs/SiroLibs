                }
              ]
            }
          ]
        },
        {
          "text": " basi, utawaambia, Nilimwomba mfalme asinirudishe nyumbani kwa Yonathani, nisije nikafa humo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
