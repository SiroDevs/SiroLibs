          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yeremia akamwambia Sedekia, Kama nikikufunulia neno hilo, je! Hutaniua wewe? Tena, mimi nikikupa ushauri wewe hutanisikiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.15",
            "verseOrgIds": [
              "JER.38.15"
            ]
          }
