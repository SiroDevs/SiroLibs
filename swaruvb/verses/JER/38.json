              "items": [
                {
                  "text": "1 Sam 31:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mfalme Sedekia akamwambia Yeremia, Nawaogopa Wayahudi waliowakimbilia Wakaldayo, wasije wakanitia katika mikono yao, nao wakanidhihaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        },
