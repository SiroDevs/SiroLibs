                  "text": "Yer 32:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bali ukikataa kutoka kwenda kwa wakuu wa mfalme wa Babeli, basi, mji huu utatiwa katika mikono ya Wakaldayo nao watauteketeza, hata na wewe hutajiepusha na mikono yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        },
