              },
              "items": [
                {
                  "text": "43:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na habari za tini zile mbovu, zisizoweza kuliwa, kwa kuwa ni mbovu sana; hakika, asema, BWANA, ndivyo nitakavyomtoa Sedekia, mfalme wa Yuda, na wakuu wake, na mabaki ya Yerusalemu, waliosalia katika nchi hii, na hao wanaokaa katika nchi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
