                "loc": "HEB.2.11"
              },
              "items": [
                {
                  "text": "Ebr 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA, Mungu wa Israeli, asema hivi, Kama zilivyo tini hizi nzuri, ndivyo nitakavyowaangalia mateka wa Yuda, niliowatoa katika mahali hapa, waende mpaka nchi ya Wakaldayo, wapate mema. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
