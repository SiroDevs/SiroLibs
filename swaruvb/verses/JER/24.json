            }
          ]
        },
        {
          "text": " Nami nitawapa moyo, wanijue ya kuwa mimi ni BWANA; nao watakuwa watu wangu, nami nitakuwa Mungu wao; kwa maana watanirudia kwa moyo wao wote. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "verse",
