          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha uvipeleke kwa mfalme wa Edomu, na mfalme wa Moabu, na mfalme wa wana wa Amoni, na mfalme wa Tiro, na mfalme wa Sidoni, kwa mikono ya wajumbe watakaofika Yerusalemu kwa Sedekia, mfalme wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwaagize waende kwa bwana zao, na kuwaambia, BWANA wa majeshi, Mungu wa Israeli, asema hivi, Mtawaambia bwana zenu maneno haya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
