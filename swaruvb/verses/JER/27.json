        },
        {
          "text": " Lakini, kuhusu habari zenu, msisikilize manabii wenu, wala wabashiri wenu, wala ndoto zenu, wala watambuzi wenu, wala waganga wenu, wanaowaambia, ya kwamba, Hamtamtumikia mfalme wa Babeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
