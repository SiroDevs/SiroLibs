                  "text": "Eze 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA ameniambia hivi, Jitengenezee vifungo na nira, ukajivike shingoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
