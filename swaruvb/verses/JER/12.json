            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.37"
              },
              "items": [
                {
                  "text": "Yer 32:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA asema hivi juu ya jirani zangu wote walio wabaya, waugusao urithi wangu niliowarithisha watu wangu Israeli, Tazama, nitawang'oa katika nchi yao, nami nitaing'oa nyumba ya Yuda isiwe kati yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
