          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.25"
              },
              "items": [
                {
                  "text": "Eze 28:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.9.14"
              },
              "items": [
                {
                  "text": "Amo 9:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena itakuwa, baada ya kuwang'oa, nitarudi na kuwahurumia; nami nitawaleta tena, kila mtu aingie katika urithi wake, na kila mtu aingie katika nchi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
