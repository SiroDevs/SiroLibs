          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "punda wa mwitu aliyeizoelea nyika, avutaye pumzi za upepo katika tamaa yake; katika wakati wake ni nani awezaye kumgeuza? Wote wamtafutao hawatajichosha nafsi zao; katika mwezi wake watamwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.24",
            "verseOrgIds": [
