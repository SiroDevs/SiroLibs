              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuia mguu wako usikose kiatu, na koo yako isiwe na kiu; lakini wewe ulisema, Hakuna matumaini kabisa; la, maana nimewapenda wageni, nami nitawafuata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.25",
            "verseOrgIds": [
              "JER.2.25"
            ]
          }
        },
