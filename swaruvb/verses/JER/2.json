              "items": [
                {
                  "text": "Hos 8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je! Mwanamwali aweza kusahau mapambo yake, au bibi arusi mavazi yake? Lakini watu wangu wamenisahau mimi kwa muda wa siku zisizo na hesabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.32",
            "verseOrgIds": [
              "JER.2.32"
            ]
          }
        },
        {
