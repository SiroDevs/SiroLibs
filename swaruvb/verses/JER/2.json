          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama mwizi aonavyo haya akamatwapo, ndivyo waonavyo haya nyumba ya Israeli; wao, na wafalme wao, na wakuu wao, na makuhani wao, na manabii wao; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.26",
            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        },
