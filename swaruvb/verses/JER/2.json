              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jinsi ulivyoitengeneza njia yako ili kutafuta mapenzi! Kwa sababu hiyo hata wanawake wabaya umewafundisha njia zako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.33",
            "verseOrgIds": [
              "JER.2.33"
            ]
