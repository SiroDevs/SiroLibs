                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na ngome ya Efraimu itakomeshwa, na ufalme wa Dameski, na mabaki ya Shamu; watakuwa kama utukufu wa wana wa Israeli, asema BWANA wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
