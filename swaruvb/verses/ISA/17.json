                  "text": "Ufu 14:15-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena itakuwa kama hapo mvunaji ashikapo mabua ya ngano, na mkono wake ukatapo masuke; tena itakuwa kama hapo mtu aokotapo masuke katika bonde la Warefai. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini kilichosazwa na mvunaji kitakuwa ndani yake, kama vile wakati wa kupiga mizeituni, matunda mawili matatu yaliyo juu sana; matunda manne matano katika matawi, matawi ya mti wa matunda, asema BWANA, Mungu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "verse",
