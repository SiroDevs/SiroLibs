              "items": [
                {
                  "text": "Yer 7:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Miji ya Aroeri imeachwa; itakuwa mahali pa makundi ya kondoo, nao watajilaza huko wala hapana atakayewatia hofu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
