              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tena itakuwa katika siku hiyo, utukufu wa Yakobo utapungua na kunona kwa mwili wake kutakwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
