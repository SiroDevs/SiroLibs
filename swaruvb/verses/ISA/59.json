                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akajivika haki kama deraya kifuani, na chapeo cha wokovu kichwani pake, akajivika mavazi ya kisasi yawe mavazi yake, naye alivikwa wivu kama joho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
