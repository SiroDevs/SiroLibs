                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, mkono wa BWANA haukupunguka, hata usiweze kuokoa wala sikio lake si zito, hata lisiweze kusikia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini maovu yenu yamewafarikisha ninyi na Mungu wenu, na dhambi zenu zimeuficha uso wake msiuone, hata hataki kusikia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        },
        {
