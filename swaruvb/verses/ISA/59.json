                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.17"
              },
              "items": [
                {
                  "text": "Sef 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Twapapasapapasa kutafuta ukuta kama kipofu, naam, twapapasa kama watu wasio na macho; twajikwaa wakati wa adhuhuri, kana kwamba ni wakati wa ukungu wa alfajiri; kati yao walionenepa tumekuwa kama wafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.10",
            "verseOrgIds": [
              "ISA.59.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisi sote twanguruma kama dubu; twaomboleza kama hua; twatazamia hukumu ya haki, lakini hapana; na wokovu, lakini u mbali nasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.11",
            "verseOrgIds": [
              "ISA.59.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana makosa yetu yamezidi kuwa mengi mbele zako, na dhambi zetu zashuhudia juu yetu; maana makosa yetu tunayo pamoja nasi, na maovu yetu tumeyajua; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.12",
            "verseOrgIds": [
              "ISA.59.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.34"
              },
              "items": [
                {
                  "text": "Mt 12:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " katika kukosa na kumkana BWANA, na katika kugeuka tusimfuate Mungu wetu, tukinena udhalimu na uasi, na kukusudia maneno ya uongo na kuyatoa moyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.13",
            "verseOrgIds": [
              "ISA.59.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 59:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.1"
              },
              "items": [
                {
                  "text": "Neh 8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na hukumu imegeuka ikaenda nyuma, na haki inasimama mbali sana; maana kweli imeanguka katika njia kuu, na unyofu hauwezi kuingia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.14",
            "verseOrgIds": [
              "ISA.59.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 59:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, kweli imepunguka kabisa, na yeye auachaye uovu ajifanya kuwa mateka; naye BWANA akaona hayo, akachukizwa kwa kuwa hapana hukumu ya haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 59:16"
          },
