                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.5"
              },
              "items": [
                {
                  "text": "Isa 63:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaona ya kuwa hapana mtu, akastaajabu kwa kuwa hapana mwombezi; basi, mkono wake mwenyewe ndio uliomletea wokovu; na haki yake ndiyo iliyomsaidia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        },
        {
