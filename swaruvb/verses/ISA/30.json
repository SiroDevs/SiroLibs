          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya, nenda sasa, andika neno hili katika kibao mbele ya macho yao, lichore katika kitabu ili liwe kwa ajili ya majira yatakayokuja, kwa ushuhuda hata milele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.8",
            "verseOrgIds": [
              "ISA.30.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30:8",
              "type": "text"
            },
            {
              "text": "Au, majira yatakayokuja, hata milele na milele.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.8",
            "verseOrgIds": [
              "ISA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.20"
              },
              "items": [
                {
                  "text": "Kum 32:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana watu hawa ni watu waasi, watoto wasemao uongo, watoto wasiotaka kuisikia sheria ya BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.9",
            "verseOrgIds": [
              "ISA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 30:10"
          },
          "items": [
            {
