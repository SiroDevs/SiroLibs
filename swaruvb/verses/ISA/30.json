          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, jina la BWANA linakuja kutoka mbali sana, linawaka kwa hasira yake, kwa moshi mwingi sana unaopaa juu; midomo yake imejaa ghadhabu, na ulimi wake ni moto uangamizao; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.27",
            "verseOrgIds": [
              "ISA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
