                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.13"
              },
              "items": [
                {
                  "text": "1 Fal 22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wawaambiao waonaji, Msione; na manabii, Msitoe unabii wa mambo ya haki, tuambieni maneno laini, hubirini maneno yadanganyayo; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.10",
            "verseOrgIds": [
              "ISA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.8"
              },
              "items": [
                {
                  "text": "Mdo 13:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tokeni katika njia, geukeni mtoke katika mapito; mkomesheni Mtakatifu wa Israeli mbele yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.11",
            "verseOrgIds": [
              "ISA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi kwa ajili ya hayo Mtakatifu wa Israeli asema hivi, Kwa sababu mwalidharau neno hili, na kutumainia jeuri na ukaidi, na kuyategemea hayo; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.12",
            "verseOrgIds": [
              "ISA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi, uovu huu utakuwa kwenu kama mahali palipobomoka, kuanguka patokezapo katika ukuta mrefu, ambapo kuvunjika kwake huja ghafla kwa mara moja. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.13",
            "verseOrgIds": [
              "ISA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 30:14"
          },
          "items": [
            {
