              "items": [
                {
                  "text": "Yos 23:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Elfu moja watakimbia kwa kukemewa na mtu mmoja; kwa kukemewa na watano mtakimbia; hata mtakapoachwa kama mlingoti juu ya kilele cha mlima, na kama bendera juu ya kilima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.17",
            "verseOrgIds": [
              "ISA.30.17"
            ]
          }
        }
      ]
