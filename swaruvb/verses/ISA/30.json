              "items": [
                {
                  "text": "Yer 21:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " waendao kuteremkia Misri wala hawakuuliza kinywani mwangu; ili wajitie nguvu kwa nguvu za Farao, na kutumainia kivuli cha Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.2",
            "verseOrgIds": [
              "ISA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 30:3"
          },
          "items": [
