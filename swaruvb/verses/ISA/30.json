              "items": [
                {
                  "text": "Mit 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.16"
              },
              "items": [
                {
                  "text": "Yer 44:16",
                  "type": "text"
                }
              ]
            },
            {
