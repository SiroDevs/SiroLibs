          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.5"
              },
              "items": [
                {
                  "text": "Yer 37:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, nguvu za Farao zitakuwa aibu yenu, na kutumainia kivuli cha Misri kutakuwa aibu yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.3",
            "verseOrgIds": [
              "ISA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana wakuu wake wako Soani, na wajumbe wake wamefika Hanesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.4",
            "verseOrgIds": [
              "ISA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
