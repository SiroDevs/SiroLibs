                "loc": "JER.2.36"
              },
              "items": [
                {
                  "text": "Yer 2:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wote watawaonea haya watu wasioweza kuwafaidia, wasio na msaada wala faida, bali ni aibu na sababu ya kushutumiwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.5",
            "verseOrgIds": [
              "ISA.30.5"
            ]
          }
        }
