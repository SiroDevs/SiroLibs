                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye atapavunja kama chombo cha mfinyanzi kivunjwavyo, kinavyovunjwavunjwa kikatili, hata hakipatikani katika vipande vyake kigae kitoshacho kutwaa moto jikoni, au kuteka maji kisimani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.14",
            "verseOrgIds": [
              "ISA.30.14"
            ]
          }
        },
        {
