                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Yer 7:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana Tofethi imewekwa tayari tokea zamani, naam, imewekwa tayari kwa mfalme huyo; ameifanya kubwa, inakwenda chini sana; tanuri yake ni moto na kuni nyingi; pumzi ya BWANA, kama mto wa kiberiti, huiwasha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
