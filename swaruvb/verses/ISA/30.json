              "type": "tag",
              "attrs": {
                "loc": "MAT.23.37"
              },
              "items": [
                {
                  "text": "Mt 23:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana Bwana MUNGU, Mtakatifu wa Israeli, asema hivi, Kwa kurudi na kustarehe mtaokolewa; nguvu zenu zitakuwa katika kutulia na kutumaini; lakini hamkukubali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.15",
            "verseOrgIds": [
              "ISA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali ninyi mlisema, La! Maana tutakimbia juu ya farasi; basi, ni kweli, mtakimbia; tena, Sisi tutakimbia juu ya wanyama waendao upesi; basi, wale watakaowafuatia watakuwa wepesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.16",
            "verseOrgIds": [
              "ISA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 30:17"
          },
