                  "text": "Efe 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na haki itakuwa mshipi wa viuno vyake, na uaminifu mshipi wa kujifungia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
