          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na furaha yake itakuwa katika kumcha BWANA; wala hatahukumu kwa kuyafuata ayaonayo kwa macho yake, wala hataonya kwa kuyafuata ayasikiayo kwa masikio yake; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
