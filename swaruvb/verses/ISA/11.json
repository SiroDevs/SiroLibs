                  "text": "Isa 65:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbwamwitu atakaa pamoja na mwana-kondoo, na chui atalala pamoja na mwana-mbuzi; ndama na mwanasimba na ng'ombe wanono watakuwa pamoja, na mtoto mdogo atawaongoza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ombe na dubu watalisha pamoja; watoto wao watalala pamoja; na simba atakula majani kama ng'ombe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mtoto anyonyaye atacheza penye tundu la nyoka, na mtoto aliyeachishwa kunyonya atatia mkono wake katika pango la fira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
