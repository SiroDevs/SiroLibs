            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na itakuwa katika siku hiyo, Bwana atapeleka mkono wake mara ya pili, ili ajipatie watu wake watakaosalia, kutoka Ashuru, na kutoka Misri, na kutoka Pathrosi, na kutoka Kushi, na kutoka Elamu, na kutoka Shinari, na kutoka Hamathi, na kutoka visiwa vya bahari. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
