                {
                  "text": "Isa 17:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana mji ulio na boma umekuwa peke yake, makao yaliyoachwa na ukiwa kama jangwa; huko ndiko atakakolisha ndama, na huko ndiko atakakolala, na kuyala matawi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
