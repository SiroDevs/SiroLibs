              "items": [
                {
                  "text": "1 Kor 10:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umemwadhibu kwa kiasi, ulipomfukuza; ukampepeta kwa upepo mkali katika siku ya upepo wa mashariki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        },
        {
          "name": "verse",
