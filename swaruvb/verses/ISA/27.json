                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika siku hiyo BWANA, kwa upanga wake ulio mkali, ulio mkubwa, ulio na nguvu, atamwadhibu Lewiathani, nyoka yule mwepesi, na Lewiathani, nyoka yule mwenye kuzongazonga; naye atamwua yule joka aliye baharini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
