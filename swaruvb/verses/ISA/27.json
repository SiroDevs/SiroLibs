          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku hiyo; Shamba la mizabibu la mvinyo, liimbieni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        }
