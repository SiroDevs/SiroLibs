          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilo ndilo neno lile alilolisema BWANA juu ya Moabu zamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.18"
              },
              "items": [
                {
                  "text": "Kum 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.5"
              },
              "items": [
                {
                  "text": "Isa 15:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini sasa BWANA asema hivi, Katika muda wa miaka mitatu, kama miaka ya mtu wa mshahara, utukufu wa Moabu utadharauliwa, licha ya wingi wa watu wake; na watakaobaki watakuwa wachache sana na dhaifu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
      ]
    }
