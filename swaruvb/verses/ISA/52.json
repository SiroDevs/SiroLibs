              "items": [
                {
                  "text": "1 Pet 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana BWANA asema hivi, Mliuzwa bure; nanyi mtakombolewa bila fedha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
