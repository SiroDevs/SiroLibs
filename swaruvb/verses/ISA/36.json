                "loc": "2CH.32.1"
              },
              "items": [
                {
                  "text": "2 Nya 32:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikawa, katika mwaka wa kumi na nne wa kutawala kwake mfalme Hezekia, Senakeribu, mfalme wa Ashuru, akapanda ili kupigana na miji yote ya Yuda yenye boma, akaitwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.1",
            "verseOrgIds": [
              "ISA.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.3"
              },
              "items": [
                {
                  "text": "Yos 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.19"
              },
              "items": [
                {
                  "text": "2 Fal 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.13"
              },
              "items": [
                {
                  "text": "Mik 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mfalme wa Ashuru akamtuma amiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.2",
            "verseOrgIds": [
              "ISA.36.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:2",
              "type": "text"
            },
            {
              "text": "Katika Isaya 36 na 37, neno hili kamanda ni Rabshake kwa Kiebrania.",
              "type": "text"
            }
          ]
        },
        {
          "text": " toka Lakishi pamoja na jeshi kubwa kwenda hadi Yerusalemu kwa mfalme Hezekia. Naye akasimama karibu na mfereji wa bwawa la juu, lililo katika njia kuu ya kuuendea Uwanda wa Dobi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.2",
            "verseOrgIds": [
              "ISA.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamtokea Eliakimu, mwana wa Hilkia, aliyekuwa msimamizi wa nyumba ya mfalme, na Shebna, mwandishi, na Yoa, mwana wa Asafu, mwenye kuandika kumbukumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.3",
            "verseOrgIds": [
              "ISA.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule kamanda akawaambia, Haya, mwambieni Hezekia, kwamba mfalme mkuu, mfalme wa Ashuru, asema hivi, Ni tumaini gani hili unalolitumainia? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.4",
            "verseOrgIds": [
              "ISA.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasema, mashauri yako, na nguvu zako kwa vita, ni maneno yasiyo na maana; basi, unamtumaini nani hata ukaniasi mimi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.5",
            "verseOrgIds": [
              "ISA.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.6+EZK.29.7"
              },
              "items": [
                {
                  "text": "Eze 29:6-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, unaitumainia fimbo ya mwanzi huu uliovunjika, yaani, Misri, ambayo, mtu akitegemea juu yake, humwingia mkononi na kumchoma; ndivyo alivyo Farao, mfalme wa Misri, kwa wote wamtumainio. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.6",
            "verseOrgIds": [
              "ISA.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.4"
              },
              "items": [
                {
                  "text": "2 Fal 18:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini ukiniambia, Tunamtumaini BWANA, Mungu wetu, je! Si yeye ambaye Hezekia ameondoa mahali pake mlimoinuka, na madhabahu zake, akawaambia watu wa Yuda na Yerusalemu, Sujuduni mbele ya madhabahu hii? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.7",
            "verseOrgIds": [
              "ISA.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa, tafadhali mpe bwana wangu, mfalme wa Ashuru, dhamana, nami nitakupa farasi elfu mbili, ikiwa wewe kwa upande wako waweza kupandisha watu juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.8",
            "verseOrgIds": [
              "ISA.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawezaje, basi, kurudisha nyuma uso wa afisa mmoja wa watumishi walio wadogo wa bwana wangu, na kuitumainia Misri upewe magari na farasi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.9",
            "verseOrgIds": [
              "ISA.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Nimepanda mimi, ili kupigana na mahali hapa na kupaangamiza, bila shauri la BWANA? BWANA ndiye aliyeniambia, Panda upigane na nchi hii na kuiangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.10",
            "verseOrgIds": [
              "ISA.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Eliakimu, mwana wa Hilkia, na Shebna, na Yoa, wakamwambia yule kamanda, Tafadhali, sema na watumishi wako kwa lugha ya Kiashuri; maana tunaifahamu; wala usiseme nasi kwa lugha ya Kiyahudi, masikioni mwa watu wote walio ukutani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.11",
            "verseOrgIds": [
              "ISA.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini yule kamanda akawaambia, Je! Bwana wangu amenituma niseme, maneno haya kwa bwana wako na kwako wewe? Hakunituma pia kwa watu hawa wanaokaa ukutani, wanaokabiliwa na tisho la kula mavi yao wenyewe na kunywa mkojo wao pamoja nanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.12",
            "verseOrgIds": [
              "ISA.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha yule kamanda akasimama akalia kwa sauti kuu kwa lugha ya Kiyahudi, akisema, Lisikieni neno la mfalme mkuu, mfalme wa Ashuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.13",
            "verseOrgIds": [
              "ISA.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme asema hivi; Hezekia asiwadanganye, kwa maana hataweza kuwaokoa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.14",
            "verseOrgIds": [
              "ISA.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala msimwache Hezekia kuwatia moyo wa kumtumaini BWANA; akisema, BWANA bila shaka atatuokoa, mji huu hautatiwa katika mkono wa mfalme wa Ashuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.15",
            "verseOrgIds": [
              "ISA.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.4"
              },
              "items": [
                {
                  "text": "Mik 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.10"
              },
              "items": [
                {
                  "text": "Zek 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Msimsikilize Hezekia; maana mfalme wa Ashuru asema hivi, Fanyeni suluhu na mimi, mkatoke mnijie, mkale kila mtu matunda ya mzabibu wake na matunda ya mtini wake, mkanywe kila mmoja maji ya kisima chake mwenyewe; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.16",
            "verseOrgIds": [
              "ISA.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata nije nikawachukue mpaka nchi iliyo kama nchi yenu wenyewe, nchi ya nafaka na divai, nchi ya mkate na mashamba ya mizabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.17",
            "verseOrgIds": [
              "ISA.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jihadharini, Hezekia asije akawadanganya, akisema, BWANA atatuokoa. Je! Kati ya miungu ya mataifa, kuna yeyote aliyewahi kuokoa nchi yake kutoka kwa mkono wa mfalme wa Ashuru? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.18",
            "verseOrgIds": [
              "ISA.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.8"
              },
              "items": [
                {
                  "text": "Hes 34:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.5"
              },
              "items": [
                {
                  "text": "Yos 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wako wapi miungu ya Hamathi na ya Arpadi? Wako wapi miungu ya Sefarvaimu? Je! Wameiokoa Samaria kutoka kwa mkono wangu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.19",
            "verseOrgIds": [
              "ISA.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.15"
              },
              "items": [
                {
                  "text": "2 Nya 32:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.50.21"
              },
              "items": [
                {
                  "text": "Zab 50:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.23"
              },
              "items": [
                {
                  "text": "Isa 37:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.15"
              },
              "items": [
                {
                  "text": "Dan 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika miungu yote ya nchi hizi ni nani waliookoa nchi yao kutoka kwa mkono wangu, hata BWANA auokoe Yerusalemu kutoka kwa mkono wangu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.20",
            "verseOrgIds": [
              "ISA.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.38.13"
              },
              "items": [
                {
                  "text": "Zab 38:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.9.7"
              },
              "items": [
                {
                  "text": "Mit 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.13"
              },
              "items": [
                {
                  "text": "Amo 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.6"
              },
              "items": [
                {
                  "text": "Mt 7:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini watu wakanyamaza kimya; wala hawakumjibu hata neno moja; maana ilikuwa amri ya mfalme, kwamba, Msimjibu neno. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.21",
            "verseOrgIds": [
              "ISA.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
