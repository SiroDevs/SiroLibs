              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena itakuwa katika siku hiyo kila mahali palipokuwa na mizabibu elfu moja, iliyopata fedha elfu moja, patakuwa mahali pa mbigili na miiba tu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
