              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku hiyo itakuwa ya kwamba mtu atalisha ng'ombe jike mchanga na kondoo wawili wa kike; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
