                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2 Nya 28:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata ikawa katika siku za Ahazi, mwana wa Yothamu, mwana wa Uzia, mfalme wa Yuda, Resini, mfalme wa Shamu, na Peka, mwana wa Remalia, mfalme wa Israeli, wakapanda wakaenda Yerusalemu ili kupigana nao, lakini hawakuweza kuushinda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha watu wa nyumba ya Daudi wakaambiwa kwamba Shamu wamefanya mapatano na Efraimu. Na moyo wake ukataharuki, na moyo wa watu wake, kama miti ya mwituni itikiswavyo na upepo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
