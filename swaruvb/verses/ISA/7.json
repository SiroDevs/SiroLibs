              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena itakuwa katika siku hiyo BWANA atampigia kelele inzi aliye katika pande za mwisho za mito ya Misri, na nyuki aliye katika nchi ya Ashuru ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watakuja na kutulia katika mabonde yaliyo ukiwa, na katika pango za majabali, na juu ya michongoma yote, na juu ya malisho yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
