          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha itakuwa, kwa sababu wanyama hao watatoa maziwa mengi, atakula siagi; kwa maana kila mtu aliyesalia katika nchi hii atakula siagi na asali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
