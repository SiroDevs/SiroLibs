            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Fal 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA ataleta juu yako, na juu ya watu wako, na juu ya nyumba ya baba yako, siku zisizokuja bado, tangu siku ile aliyoondoka Efraimu kutoka katika Yuda; yaani, mfalme wa Ashuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
