                {
                  "text": "2 Fal 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.1+ISA.31.2+ISA.31.3"
              },
              "items": [
                {
                  "text": "Isa 31:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao watafadhaika, na kuona haya kwa ajili ya Kushi, matumaini yao, na Misri, utukufu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwenyeji wa nchi ya pwani atasema katika siku hiyo, Angalia, haya ndiyo yaliyowapata watu wale tuliowatumainia, ambao tuliwakimbilia watuokoe kutoka kwa mfalme wa Ashuru; na sisi je! Twawezaje kupona?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
