              "text": "20:1",
              "type": "text"
            },
            {
              "text": "Jemadari",
              "type": "text"
            },
            {
              "text": "hapa, kwa Kiebrania ni Tartan.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yule alipofika Ashdodi, alipotumwa na Sargoni mfalme wa Ashuru; naye alipigana na Ashdodi akautwaa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
