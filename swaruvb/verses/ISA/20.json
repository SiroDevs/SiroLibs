                "loc": "1SA.19.24"
              },
              "items": [
                {
                  "text": "1 Sam 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wakati huo BWANA alinena kwa kinywa cha Isaya, mwana wa Amozi, akisema, Haya, uvue nguo ya magunia viunoni mwako, na viatu vyako miguuni mwako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.18"
              },
              "items": [
                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye akafanya hivyo akaenda uchi, miguu yake ikiwa haina viatu. BWANA akasema, Kama vile mtumishi wangu Isaya anavyokwenda uchi, bila viatu, awe ishara na ajabu kwa muda wa miaka mitatu juu ya Misri na juu ya Kushi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
