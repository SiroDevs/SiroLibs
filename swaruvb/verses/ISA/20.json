              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.10.4"
              },
              "items": [
                {
                  "text": "2 Sam 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.11"
              },
              "items": [
                {
                  "text": "Mik 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " vivyo hivyo mfalme wa Ashuru atawachukua uchi, wafungwa wa Misri, na watu wa Kushi waliohamishwa, watoto kwa wazee, bila viatu, matako yao wazi, Misri iaibishwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
