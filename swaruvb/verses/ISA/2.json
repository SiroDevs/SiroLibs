                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Macho ya mwanadamu yaliyoinuka yatashushwa chini, na kiburi cha mwanadamu kitainamishwa, naye BWANA, yeye peke yake, atatukuzwa siku hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana kutakuwa siku ya BWANA wa majeshi juu ya watu wote wenye kiburi na majivuno, na juu ya yote yaliyoinuka; nayo yatashushwa chini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na juu ya mierezi yote ya Lebanoni iliyo mirefu na kuinuka, na juu ya mialoni yote ya Bashani; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
              "ISA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na juu ya milima mirefu yote, na juu ya vilima vyote vilivyoinuka; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.14",
            "verseOrgIds": [
              "ISA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na juu ya kila mnara mrefu, na juu ya kila ukuta ulio na boma; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.15",
            "verseOrgIds": [
              "ISA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na juu ya merikebu zote za Tarshishi, na juu ya kila taswira ipendezayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.16",
            "verseOrgIds": [
              "ISA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na majivuno ya mwanadamu yatainamishwa, na kiburi cha watu kitashushwa; naye BWANA, yeye peke yake, atatukuzwa siku hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.17",
            "verseOrgIds": [
              "ISA.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazo sanamu zitatoweka kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.18",
            "verseOrgIds": [
              "ISA.2.18"
            ]
          }
        },
