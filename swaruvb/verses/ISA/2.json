              "items": [
                {
                  "text": "2 The 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ingia ndani ya jabali; ukajifiche mavumbini mbele za utisho wa BWANA, mbele za utukufu wa enzi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
