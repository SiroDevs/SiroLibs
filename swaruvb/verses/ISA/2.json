        },
        {
          "text": " Na itakuwa katika siku za mwisho, mlima wa nyumba ya BWANA utawekwa imara juu ya milima, nao utainuliwa juu ya vilima; na mataifa yote watauendea makundi makundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        },
        {
          "name": "verse",
