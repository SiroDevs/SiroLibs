              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba nitamvunja huyo Mwashuri vipande vipande katika nchi yangu, na juu ya mlima wangu nitamkanyaga chini ya miguu yangu; ndipo nira yake iliyo juu yao itakapoondoka, na mzigo wake utatoka mabegani mwao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.25",
            "verseOrgIds": [
              "ISA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilo ndilo kusudi lililokusudiwa duniani kote, na huo ndio mkono ulionyoshwa juu ya mataifa yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
        },
