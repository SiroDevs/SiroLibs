        },
        {
          "text": " BWANA wa majeshi ameapa, akisema, Hakika yangu kama vile vilivyoazimia, ndivyo itakavyokuwa; na kama nilivyokusudia, ndivyo itakavyotokea; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
