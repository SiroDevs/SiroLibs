            "sid": "ISA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika na mahali palipo ukiwa patafurahi; jangwa litashangilia na kuchanua maua kama waridi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litachanua maua mengi, na kufurahi, naam, kwa shangwe na kuimba; litapewa uzuri wa Lebanoni, utukufu wa Karmeli na Sharoni; watauona utukufu wa BWANA, ukuu wa Mungu wetu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
