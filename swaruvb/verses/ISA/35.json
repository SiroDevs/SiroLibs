                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Itieni nguvu mikono iliyo dhaifu, yaimarisheni magoti yaliyolegea. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        },
        {
