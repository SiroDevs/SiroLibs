              "items": [
                {
                  "text": "Isa 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hapo hapatakuwa na simba, wala mnyama mkali hatapanda juu yake; hawataonekana hapo; bali waliokombolewa watakwenda katika njia hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
