          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambieni walio na moyo wa hofu, Jipeni moyo, msiogope; tazama, Mungu wenu atakuja na kisasi, na malipo ya Mungu; atakuja na kuwaokoa ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        },
