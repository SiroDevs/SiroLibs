                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Beli anaanguka chini, Nebo anainama; sanamu zao ziko juu ya wanyama, na juu ya ng'ombe; vitu vile mlivyokuwa mkivichukua huku na huku vimekuwa mzigo, mzigo wa kumlemea mnyama aliyechoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanajiinamisha, wanainama pamoja; hawakuweza kuutua mzigo, bali wao wenyewe wamekwenda kufungwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
