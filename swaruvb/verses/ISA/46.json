                "loc": "JER.10.5"
              },
              "items": [
                {
                  "text": "Yer 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Humchukua begani, humchukua, wakamsimamisha mahali pake, akasimama; hataondoka katika mahali pake, naam, mmoja atamwita, lakini hawezi kujibu, wala kumwokoa kutoka kwa taabu yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
