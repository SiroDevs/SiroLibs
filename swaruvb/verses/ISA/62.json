              "items": [
                {
                  "text": "Isa 61:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.20"
              },
              "items": [
                {
                  "text": "Sef 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wala msimwache akae kimya, mpaka atakapouimarisha Yerusalemu, na kuufanya usifike kote duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        },
        {
          "name": "verse",
