                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nimeweka walinzi juu ya kuta zako, Ee Yerusalemu; hawatanyamaza mchana wala usiku; ninyi wenye kumkumbusha BWANA, msiwe na kimya; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.6",
            "verseOrgIds": [
              "ISA.62.6"
            ]
          }
        },
        {
          "name": "verse",
