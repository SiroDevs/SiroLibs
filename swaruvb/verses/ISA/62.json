              "items": [
                {
                  "text": "Yer 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA ameapa kwa mkono wake wa kulia, na kwa mkono wa nguvu zake, Hakika sitawapa adui zako nafaka yako tena kuwa chakula chao; wala wageni hawatakunywa divai yako, uliyoifanyia kazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
