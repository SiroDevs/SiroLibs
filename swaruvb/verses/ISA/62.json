              "attrs": {
                "loc": "DEU.12.12"
              },
              "items": [
                {
                  "text": "Kum 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini walioivuna, ndio watakaoila, na kumhimidi BWANA; na walioichuma, ndio watakaoinywa, ndani ya nyua za patakatifu pangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
