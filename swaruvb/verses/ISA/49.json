                  "text": "Yn 13:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " akaniambia; Wewe u mtumishi wangu, Israeli, ambaye katika wewe nitatukuzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.3",
            "verseOrgIds": [
              "ISA.49.3"
            ]
          }
        },
        {
