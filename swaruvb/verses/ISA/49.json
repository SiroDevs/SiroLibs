                "loc": "EZK.3.19"
              },
              "items": [
                {
                  "text": "Eze 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini nikasema, Nimejitaabisha bure, nimetumia nguvu zangu bure bila faida; lakini hakika hukumu yangu ina BWANA, na thawabu yangu ina Mungu wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.4",
            "verseOrgIds": [
              "ISA.49.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sasa BWANA asema hivi, yeye aliyeniumba tangu tumboni niwe mtumishi wake, ili nimletee Yakobo tena, na Israeli wakusanyike mbele zake tena; (maana mimi nimepata heshima mbele ya macho ya BWANA, na Mungu wangu amekuwa nguvu zangu); ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.5",
            "verseOrgIds": [
              "ISA.49.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
