                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hawataona njaa, wala hawataona kiu; joto halitawapiga, wala jua; kwa maana yeye aliyewarehemu atawatangulia, naam, karibu na chemchemi za maji atawaongoza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.10",
            "verseOrgIds": [
              "ISA.49.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitafanya milima yangu yote kuwa njia, na njia zangu zote kuu zitainuliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.11",
            "verseOrgIds": [
              "ISA.49.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tazama, hawa watakuja kutoka mbali; na tazama, hawa kutoka kaskazini, na kutoka magharibi, na hawa kutoka nchi ya Sinimu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.12",
            "verseOrgIds": [
              "ISA.49.12"
            ]
          }
        }
