        },
        {
          "text": " Je! Aliye hodari aweza kunyang'anywa mateka wake, au mateka wa mtu katili kuokoka? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.24",
            "verseOrgIds": [
