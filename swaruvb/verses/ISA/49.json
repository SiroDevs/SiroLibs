                }
              ]
            }
          ]
        },
        {
          "text": " Je! Mwanamke aweza kumsahau mtoto wake anyonyaye, hata asimhurumie mwana wa tumbo lake? Naam, hawa waweza kusahau, lakini mimi sitakusahau wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.15",
