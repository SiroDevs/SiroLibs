          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA, mkombozi wa Israeli, Mtakatifu wake, amwambia hivi yeye anayedharauliwa na wanadamu; yeye anayechukiwa na taifa hili; yeye aliye mtumishi wao watawalao; Wafalme wataona, watasimama; wakuu nao watasujudu; kwa sababu ya BWANA aliye mwaminifu, Mtakatifu wa Israeli aliyekuchagua.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.7",
            "verseOrgIds": [
              "ISA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wana wa Sayuni watarudishwa nyumbani",
          "type": "text"
