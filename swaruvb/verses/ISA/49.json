                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye anifanya kinywa changu kuwa kama upanga mkali; katika kivuli cha mkono wake amenisitiri; naye amenifanya kuwa mshale uliosuguliwa; katika podo lake amenificha; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.2",
            "verseOrgIds": [
              "ISA.49.2"
            ]
          }
        },
