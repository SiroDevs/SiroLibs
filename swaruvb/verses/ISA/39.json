              },
              "items": [
                {
                  "text": "1 Sam 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Hezekia akamwambia Isaya, Neno la BWANA ulilolinena ni jema. Tena akamwambia, Maana alifikiri, kutakuwapo na amani na usalama katika siku zangu mimi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
