                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na baadhi ya wana wako utakaowazaa, watakaotoka kwako, watawachukulia mbali; nao watakuwa matowashi katika jumba la mfalme wa Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
