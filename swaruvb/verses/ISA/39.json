              "items": [
                {
                  "text": "Amo 5:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, siku zinakuja, ambazo vitu vyote vilivyomo nyumbani mwako, na hivyo vilivyowekwa akiba na baba zako hata leo, vitachukuliwa mpaka Babeli; hapana kitu chochote kitakachosalia; asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
