              "items": [
                {
                  "text": "Ezr 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.24"
              },
              "items": [
                {
                  "text": "Rum 3:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi nimemwinua katika haki, nami nitazinyosha njia zake zote; ataujenga mji wangu, naye atawaacha huru watu wangu waliohamishwa, si kwa kulipwa fedha, wala kwa kupewa zawadi, asema BWANA wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
