          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niangalieni mimi, mkaokolewe, enyi ncha zote za dunia; maana mimi ni Mungu; hapana mwingine. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.22",
