              "items": [
                {
                  "text": "Isa 41:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haya ndiyo BWANA amwambiayo Koreshi, masihi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:1",
              "type": "text"
            },
            {
              "text": "Au, mtiwa mafuta (tazama 1 Sam 2:10).",
              "type": "text"
            }
          ]
        },
        {
          "text": " wake, ambaye nimemshika mkono wake wa kulia, ili kutiisha mataifa mbele yake, nami nitalegeza nguvu za wafalme;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:1",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni: Nitalegeza viuno vya wafalme.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ili kufungua milango mbele yake, hata malango hayatafungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakwenda mbele yako, na kupasawazisha mahali palipoparuza; nitavunja vipande vipande milango ya shaba, na kukatakata mapingo ya chuma; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.12"
              },
              "items": [
                {
                  "text": "Kut 33:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nami nitakupa hazina za gizani, na mali zilizofichwa za mahali pa siri, upate kujua ya kuwa mimi ni BWANA, nikuitaye kwa jina lako, naam, Mungu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 45:4"
          },
