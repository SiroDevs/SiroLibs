              "items": [
                {
                  "text": "Zab 102:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.11"
              },
              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ili wapate kujua toka maawio ya jua, na toka magharibi, ya kuwa hapana mwingine zaidi ya mimi; Mimi ni BWANA, wala hapana mwingine. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Amo 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi naiumba nuru, na kulihuluku giza; mimi nafanya suluhu, na kuhuluku ubaya; Mimi ni BWANA, niyatendaye hayo yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        }
