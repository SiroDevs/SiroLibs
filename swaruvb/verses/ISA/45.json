              "items": [
                {
                  "text": "1 The 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa ajili ya Yakobo, mtumishi wangu, na Israeli, mteule wangu, nimekuita kwa jina lako; nimekupa jina la sifa; ijapokuwa hukunijua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.35"
