              "items": [
                {
                  "text": "Kum 4:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.18.32"
              },
              "items": [
                {
                  "text": "Zab 18:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi ni BWANA, wala hapana mwingine; zaidi yangu mimi hapana Mungu; nitakuimarisha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:5",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni: kufunga mshipi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ijapokuwa hukunijua; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        },
        {
