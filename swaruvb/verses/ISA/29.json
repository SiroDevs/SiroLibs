        },
        {
          "text": "Je! Si muda mdogo uliobaki, na Lebanoni itageuzwa kuwa shamba lizaalo sana, na lile shamba lizaalo sana litahesabiwa kuwa msitu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
        },
