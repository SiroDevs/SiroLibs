        },
        {
          "text": "Ngojeni mstaajabu; fanyeni anasa zenu na kuwa vipofu; wamelewa wala si kwa mvinyo; wamewayawaya wala si kwa sababu ya kileo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
