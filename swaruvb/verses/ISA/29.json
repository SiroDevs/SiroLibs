                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na maono yote yamekuwa kwenu kama maneno ya kitabu kilichotiwa mhuri, ambacho watu humpa mtu aliye na maarifa, wakisema, Tafadhali ukisome hiki; akasema, Siwezi, kwa kuwa kimetiwa mhuri; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha kitabu hiki apewa mtu asiye na maarifa, akaambiwa, Kisome hicho tafadhali, akasema, Sina maarifa mimi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
