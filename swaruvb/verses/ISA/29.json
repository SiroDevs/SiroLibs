          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na katika siku hiyo viziwi watasikia maneno ya hicho kitabu, na macho ya vipofu yataona katika upofu na katika giza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
