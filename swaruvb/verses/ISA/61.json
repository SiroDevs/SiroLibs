              "items": [
                {
                  "text": "Isa 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.12"
              },
              "items": [
                {
                  "text": "Zek 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Badala ya aibu yenu mtapata maradufu, na badala ya fedheha wataifurahia sehemu yao; basi katika nchi yao watamiliki maradufu; furaha yao itakuwa ya milele. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.3"
              },
              "items": [
                {
                  "text": "Isa 55:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana mimi, BWANA, naipenda hukumu ya haki, nauchukia wizi na uovu; nami nitawalipa malipo katika kweli, nitaagana nao agano la milele. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 61:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kizazi chao kitajulikana katika mataifa, na uzao wao katika makabila ya watu; wote wawaonao watakiri ya kuwa wao ni kizazi kilichobarikiwa na BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
