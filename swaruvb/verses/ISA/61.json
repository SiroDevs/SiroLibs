                "loc": "JHN.15.8"
              },
              "items": [
                {
                  "text": "Yn 15:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuwaagizia hao waliao katika Sayuni, wapewe taji la maua badala ya majivu, mafuta ya furaha badala ya maombolezo, vazi la sifa badala ya roho nzito; wapate kuitwa miti ya haki, iliyopandwa na BWANA, ili atukuzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.33"
              },
              "items": [
                {
                  "text": "Eze 36:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao watajenga mahali pa kale palipoharibiwa, watapainua mahali palipokuwa ukiwa zamani, watatengeneza miji iliyoharibiwa, mahali palipoachwa kizazi baada ya kizazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.12"
              },
              "items": [
                {
                  "text": "Efe 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wageni watasimama na kulisha makundi yenu, na watu wa kabila nyingine watakuwa wakulima wenu, na watunzaji wa mizabibu yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "Kut 19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bali ninyi mtaitwa makuhani wa BWANA; watu watawaiteni wahudumu wa Mungu wetu; mtakula utajiri wa mataifa, na kujisifia utukufu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
