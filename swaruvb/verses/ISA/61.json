              "items": [
                {
                  "text": "Isa 60:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana kama nchi itoavyo machipuko yake, na kama bustani ioteshavyo vitu vilivyopandwa ndani yake; ndivyo Bwana MUNGU atakavyootesha haki na sifa mbele ya mataifa yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.11",
            "verseOrgIds": [
