                "loc": "MAL.4.1+MAL.4.2+MAL.4.3"
              },
              "items": [
                {
                  "text": "Mal 4:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kutangaza mwaka wa BWANA uliokubaliwa, na siku ya kisasi cha Mungu wetu; kuwafariji wote waliao; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        },
        {
