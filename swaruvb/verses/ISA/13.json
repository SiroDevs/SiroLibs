                "loc": "JER.51.25"
              },
              "items": [
                {
                  "text": "51:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haya! Juu ya mlima usio na miti inueni bendera, wapazieni sauti zenu, wapungieni mkono, kwamba waingie katika malango ya wakuu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.11"
              },
              "items": [
                {
                  "text": "Yoe 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi mwenyewe nimewaamuru watu wangu waliowekwa wakfu kwangu, naam, nimewaita watu wangu walio hodari kwa ajili ya hasira yangu, watu wangu wenye kiburi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelele milimani kama kelele za watu wengi sana; kelele za falme za mataifa waliokutana pamoja; BWANA wa majeshi anapanga jeshi kwa vita; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "watu waliotoka katika nchi iliyo mbali, tokea upande wa mwisho wa mbingu; naam, BWANA na silaha za ghadhabu yake, ili aiangamize nchi yote. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.18"
              },
              "items": [
                {
                  "text": "Amo 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.7"
              },
              "items": [
                {
                  "text": "Sef 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.17"
              },
              "items": [
                {
                  "text": "Ufu 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.15"
              },
              "items": [
                {
                  "text": "Yoe 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Pigeni kelele za hofu; maana siku ya BWANA i karibu; itanyesha kama maangamizi yatokayo kwa Mwenyezi Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo mikono yote italegea, na moyo wa kila mtu utayeyuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watafadhaika; watashikwa na uchungu na maumivu; watakuwa na uchungu kama mwanamke aliye karibu kuzaa; watakodoleana macho; nyuso zao zitakuwa ni nyuso za moto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.1"
              },
              "items": [
                {
                  "text": "Mal 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, siku ya BWANA inakuja, siku kali, ya hasira na ghadhabu kuu, ili iifanye nchi kuwa ukiwa, na kuwaharibu watu wake, wenye dhambi, wasikae ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.7"
              },
              "items": [
                {
                  "text": "Eze 32:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mt 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.24+MRK.13.25"
              },
              "items": [
                {
                  "text": "Mk 13:24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.15"
              },
              "items": [
                {
                  "text": "Lk 21:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Ufu 6:12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana nyota za mbinguni na matangamano havitatoa nuru yake; jua litatiwa giza wakati wa kucha kwake, na mwezi utaacha nuru yake isiangaze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitaadhibu ulimwengu kwa sababu ya ubaya wake, na wenye dhambi kwa sababu ya hatia yao; nami nitaikomesha fahari yao wenye kiburi; nami nitayashusha chini majivuno yao walio wakali; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nitafanya wanadamu kuadimika kuliko dhahabu safi, na watu kuliko dhahabu ya Ofiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.16"
              },
              "items": [
                {
                  "text": "Yoe 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Hag 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mt 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.12"
              },
              "items": [
                {
                  "text": "Omb 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo nitazitetemesha mbingu, na dunia itatikiswa itoke katika mahali pake, kwa sababu ya ghadhabu ya BWANA wa majeshi, na kwa sababu ya siku ya hasira yake kali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, itakuwa kama vile paa aliyetishwa, na kama kondoo wasio na mtu wa kuwakusanya; kila mtu atageukia watu wake; nao watakimbia, kila mtu aende nchi yake mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.14",
            "verseOrgIds": [
              "ISA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila mtu atakayeonekana atatumbuliwa, na kila mtu atakayepatikana ataanguka kwa upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.15",
            "verseOrgIds": [
              "ISA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.10"
              },
              "items": [
                {
                  "text": "Nah 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na watoto wao wachanga watavunjwavunjwa mbele ya macho yao, nyumba zao zitatekwa nyara, na wake zao watanajisiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.16",
            "verseOrgIds": [
              "ISA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.11"
              },
              "items": [
                {
                  "text": "Yer 51:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, nitawaamsha Wamedi juu yao, ambao hawaoni fedha kuwa kitu, wala hawafurahii dhahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.17",
            "verseOrgIds": [
              "ISA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyuta zao zitawaangusha vijana; wala hawatahurumia mazao ya tumbo; jicho lao halitawahurumia watoto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.18",
            "verseOrgIds": [
              "ISA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Mwa 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Babeli, huo utukufu wa falme, uzuri wa kiburi cha Wakaldayo, utakuwa kama Sodoma na Gomora hapo Mungu alipoiangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.19",
            "verseOrgIds": [
              "ISA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.23"
              },
              "items": [
                {
                  "text": "Isa 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hautakaliwa na watu tena kabisa, wala watu hawatakaa ndani yake tangu kizazi hata kizazi. Mwarabu hatapiga hema yake huko, wala wachungaji hawatalaza makundi yao huko. ",
