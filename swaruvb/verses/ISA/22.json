                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.12"
              },
              "items": [
                {
                  "text": "Isa 56:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Kor 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na kumbe! Furaha, na kuchekelea, na kuchinja ng'ombe, na kuchinja kondoo, na kula nyama, na kunywa mvinyo; tule, tunywe, kwa maana kesho tutakufa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.13",
            "verseOrgIds": [
              "ISA.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.14"
              },
              "items": [
                {
                  "text": "1 Sam 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.13"
              },
              "items": [
                {
                  "text": "Eze 24:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na yeye BWANA wa majeshi akafunua haya masikioni mwangu, Ni kweli, uovu huu hautatakaswa wala kuwatokeni hata mfe; asema Bwana, BWANA wa majeshi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shutuma kwa maofisa wa kujipendekeza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
