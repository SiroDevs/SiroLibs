                }
              ]
            }
          ]
        },
        {
          "text": " Ole wao waamkao asubuhi na mapema, wapate kufuata kileo; wakishinda sana hadi usiku wa manane mpaka mvinyo imewaka kama moto ndani yao! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.11",
            "verseOrgIds": [
              "ISA.5.11"
            ]
