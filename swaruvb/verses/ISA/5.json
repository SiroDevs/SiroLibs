              "items": [
                {
                  "text": "Hos 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kinubi, na zeze, na matari, na filimbi, na mvinyo, zote ziko katika karamu zao; lakini hawaiangalii kazi ya BWANA wala kuyafikiri matendo ya mikono yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.12",
            "verseOrgIds": [
              "ISA.5.12"
            ]
          }
        },
        {
