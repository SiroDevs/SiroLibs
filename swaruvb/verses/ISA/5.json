                  "text": "2 Pet 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu hiyo watu wangu wamechukuliwa mateka, kwa kukosa kuwa na maarifa; na watu wao wenye cheo wana njaa, na wengi wao waona kiu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo kuzimu kumeongeza tamaa yake, kumefunua kinywa chake bila kiasi; na utukufu wao, na wingi wao, na ghasia yao, naye pia afurahiye miongoni mwao, hushuka na kuingia humo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mtu mnyonge ainamishwa, na mtu mkubwa amedhilika, na macho yao walioinuka hunyenyekezwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bali BWANA wa majeshi ametukuzwa katika hukumu, na Mungu aliye Mtakatifu ametakaswa katika haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.16",
            "verseOrgIds": [
              "ISA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wana-kondoo watakapojilisha kama walio katika malisho yao wenyewe, na mahali pao walionenepa, palipoachwa ukiwa, wageni watakula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        }
