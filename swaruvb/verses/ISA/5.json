            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ole wao waongezao nyumba baada ya nyumba, na kuweka shamba karibu na shamba, hadi ikawa hapana nafasi tena, nanyi ikawa hamna budi kukaa peke yenu katikati ya nchi! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.8",
            "verseOrgIds": [
              "ISA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema katika masikio yangu, Hakika majumba mengi yatakuwa ukiwa, naam, majumba makubwa, mazuri, yatakuwa hayana watu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.9",
            "verseOrgIds": [
              "ISA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.16"
              },
              "items": [
                {
                  "text": "Law 27:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana shamba la mizabibu la eka kumi litatoa bathi moja tu, na homeri ya mbegu itatoa efa tu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.10",
            "verseOrgIds": [
              "ISA.5.10"
            ]
          }
        }
      ]
