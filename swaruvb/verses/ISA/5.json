                  "text": "Rum 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na sasa, enyi wenyeji wa Yerusalemu, nanyi watu wa Yuda, amueni, nawasihi, kati ya mimi na shamba langu la mizabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.3",
            "verseOrgIds": [
              "ISA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Ni kazi gani iliyohitajika kutendeka ndani ya shamba langu la mizabibu nisiyoitenda? Basi, nilipotumaini ya kuwa litazaa zabibu, mbona lilizaa zabibumwitu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.4",
            "verseOrgIds": [
              "ISA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya basi, sasa nitawaambieni nitakalolitenda shamba langu la mizabibu; nitaondoa ua wake, nalo litaliwa; nitabomoa ukuta wake, nalo litakanyagwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.5",
            "verseOrgIds": [
              "ISA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitaliharibu; wala halitapogolewa wala kulimwa, bali litamea mbigili na miiba; nami nitayaamuru mawingu yasinyeshe mvua juu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.6",
            "verseOrgIds": [
              "ISA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana shamba la mizabibu la BWANA wa majeshi ndilo nyumba ya Israeli, na watu wa Yuda ni mche wake wa kupendeza; akatumaini kuona hukumu ya haki, na kumbe! Aliona dhuluma; alitumaini kuona haki, na kumbe! Alisikia kilio.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Udhalimu wa kijamii washutumiwa",
          "type": "text"
        }
      ]
    },
    {
