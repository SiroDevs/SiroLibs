              "items": [
                {
                  "text": "1 Pet 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wala mgeni, aambatanaye na BWANA, asiseme hivi, Hakika yake BWANA atanitenga na watu wake; wala towashi asiseme, Mimi ni mti mkavu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        },
        {
