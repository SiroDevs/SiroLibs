              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana BWANA awaambia hivi matowashi, wanaozishika sabato zangu, na kuyachagua mambo yanipendezayo, na kulishika sana agano langu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        },
