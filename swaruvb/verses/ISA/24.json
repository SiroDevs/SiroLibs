            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tena itakuwa katika siku hiyo, BWANA ataliadhibu jeshi la mahali palipo juu katika mahali palipo juu, na wafalme wa dunia katika dunia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.21",
            "verseOrgIds": [
              "ISA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
