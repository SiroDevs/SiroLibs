                "loc": "JER.3.20"
              },
              "items": [
                {
                  "text": "Yer 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Toka pande za mwisho wa dunia tumesikia nyimbo, Atukuzwe mwenye haki. Ndipo niliposema, Kukonda kwangu! Kukonda kwangu! Ole wangu! Watenda hila wametenda hila, naam, watendao hila wametenda hila sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.43"
              },
              "items": [
                {
                  "text": "Yer 48:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.19"
              },
              "items": [
                {
                  "text": "Amo 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hofu, na shimo, na mtego, viko juu yako, Ee mwenye kukaa duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
            "verseOrgIds": [
              "ISA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.11"
              },
              "items": [
                {
                  "text": "Mwa 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.18.7"
              },
              "items": [
                {
                  "text": "Zab 18:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Itakuwa kila akimbiaye sauti ya hofu ataanguka katika shimo; na kila apandaye na kutoka shimoni atanaswa na mtego; kwa maana madirisha yaliyo juu yamewekwa wazi, na misingi ya dunia inatikisika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.23"
              },
              "items": [
                {
                  "text": "Yer 4:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dunia kuvunjika, inavunjika sana; dunia kupasuka, imepasuka sana; dunia kutikisika, imetikisika sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.19",
            "verseOrgIds": [
              "ISA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunia inalewalewa kama mlevi, nayo inawayawaya kama machela; na mzigo wa dhambi zake utailemea; nayo itaanguka, wala haitainuka tena.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.20",
            "verseOrgIds": [
              "ISA.24.20"
            ]
          }
        }
      ]
    },
