            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.36"
              },
              "items": [
                {
                  "text": "Mt 12:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kama ukigeuza mguu wako usiivunje sabato, usifanye anasa yako siku ya utakatifu wangu; ukiita sabato siku ya furaha, na siku takatifu ya BWANA yenye heshima; ukiitukuza, kwa kutokuzifanya njia zako mwenyewe, wala kuyatafuta yakupendezayo, wala kusema maneno yako mwenyewe; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.13",
            "verseOrgIds": [
              "ISA.58.13"
            ]
          }
        },
