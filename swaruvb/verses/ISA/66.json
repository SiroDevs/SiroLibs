              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nanyi mtaona, na mioyo yenu itafurahi, na mifupa yenu itasitawi kama majani mabichi; na mkono wa BWANA utajulikana, uwaelekeao watumishi wake, naye atawaonea adui zake ghadhabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
