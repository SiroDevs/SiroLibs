                  "text": "Tit 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lisikilizeni neno la BWANA, ninyi mtetemekao kwa sababu ya neno lake; Ndugu zenu wawachukiao ninyi, waliowatupa kwa ajili ya jina langu, wamesema, Na atukuzwe BWANA, tupate kuiona furaha yenu; lakini watatahayarika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
