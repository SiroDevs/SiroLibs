                "loc": "ISA.60.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana BWANA asema hivi, Tazama, nitamwelekezea amani kama mto, na utukufu wa mataifa kama kijito kifurikacho, nanyi mtapata kunyonya; mtabebwa; na juu ya magoti mtabembelezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfano wa mtu ambaye mama yake amfariji, ndivyo nitakavyowafariji ninyi; nanyi mtafarijiwa katika Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
