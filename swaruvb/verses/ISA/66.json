              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.5"
              },
              "items": [
                {
                  "text": "Isa 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 The 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana BWANA atakuja na moto, na magari yake ya vita kama upepo wa kisulisuli; ili atoe malipo ya ghadhabu yake kwa moto uwakao, na maonyo yake kwa miali ya moto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.1"
              },
              "items": [
                {
                  "text": "Isa 27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana BWANA atatoa hukumu kwa watu wote kwa moto, na kwa upanga wake, nao watakaouawa na BWANA watakuwa wengi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
