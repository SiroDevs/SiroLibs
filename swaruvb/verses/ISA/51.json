              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana nondo atawala kama vazi, na funza atawala kama sufu; bali haki yangu itakuwa ya milele, na wokovu wangu hata vizazi vyote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
