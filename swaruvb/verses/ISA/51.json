              "items": [
                {
                  "text": "Ebr 11:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwangalieni Abrahamu, baba yenu, na Sara, aliyewazaa; kwa maana alipokuwa mmoja tu nilimwita, nikambariki, nikamfanya kuwa wengi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        },
