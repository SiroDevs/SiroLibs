                  "text": "Zek 9:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeye aliyehamishwa na kufungwa atafunguliwa kwa haraka; wala hatakufa na kushuka shimoni, wala chakula chake hakitapunguka. ",
          "type": "text",
          "attrs": {
