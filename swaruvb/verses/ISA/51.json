                }
              ]
            }
          ]
        },
        {
          "text": " Maana BWANA ameufariji Sayuni; amepafariji mahali pake palipokuwa ukiwa; amefanya nyika yake kuwa kama bustani ya Edeni, na jangwa lake kama bustani ya BWANA; shangwe na furaha zitaonekana ndani yake, kushukuru, na sauti ya kuimba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
