              "items": [
                {
                  "text": "Rum 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haki yangu i karibu, wokovu wangu umekuwa wazi, na mikono yangu itawahukumu makabila ya watu; visiwa vitaningoja, navyo vitautumainia mkono wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        },
        {
