        },
        {
          "text": "Nisikilizeni mimi, enyi watu wangu; nisikieni, taifa langu; maana sheria itatoka kwangu, na kutoa haki yangu iwe nuru ya mataifa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
