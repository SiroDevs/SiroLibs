              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katika siku hiyo itakuwako miji mitano katika nchi ya Misri itumiayo lugha ya Kanaani, na kumwapia BWANA wa majeshi; mji mmoja utaitwa Mji wa jua.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
