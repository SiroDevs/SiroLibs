                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.9"
              },
              "items": [
                {
                  "text": "1 Kor 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana tangu zamani za kale watu hawakusikia, wala kufahamu kwa masikio, wala jicho halikuona Mungu, ila wewe, atendaye mambo kwa ajili yake amngojaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.35"
              },
              "items": [
                {
                  "text": "Mdo 10:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.6"
              },
              "items": [
                {
                  "text": "Mal 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wewe wamlaki yeye afurahiaye yaliyo haki na kuyatenda, watu wale wakukumbukao katika njia zako; tazama, ulikuwa na hasira, nasi tulitenda dhambi; tumekuwa katika dhambi kwa muda mrefu, nasi Je! Tutaokolewa? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.9"
              },
              "items": [
                {
                  "text": "Flp 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana sisi sote tumekuwa kama mtu aliye mchafu, na matendo yetu yote ya haki yamekuwa kama nguo iliyotiwa unajisi; sisi sote twanyauka kama jani, na maovu yetu yatuondoa, kama upepo uondoavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.7.7"
              },
              "items": [
                {
                  "text": "Hos 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena hapana aliitiaye jina lako, ajitahidiye akushike; kwa kuwa umetuficha uso wako, nawe umetukomesha kwa njia ya maovu yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.6"
              },
              "items": [
                {
                  "text": "Yer 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.10"
              },
              "items": [
                {
                  "text": "Efe 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini sasa, Ee BWANA, wewe u baba yetu; sisi tu udongo, nawe u mfinyanzi wetu; sisi sote tu kazi ya mikono yako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee BWANA, usione hasira nyingi, wala usiukumbuke uovu siku zote; tazama, angalia, twakusihi, sisi sote tu watu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miji yako mitakatifu imekuwa jangwa, Sayuni umekuwa jangwa, Yerusalemu umekuwa ukiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.9"
              },
              "items": [
                {
                  "text": "2 Fal 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.7"
              },
              "items": [
                {
                  "text": "Zab 74:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.21"
              },
              "items": [
                {
                  "text": "Eze 24:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyumba yetu takatifu, nzuri, walimokusifu baba zetu, imeteketea moto; vitu vyetu vyote vyenye kupendeza vimeharibika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utajizuia usiyaangalie mambo haya, Ee BWANA? Utanyamaza, na kutuadhibu vikali?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.12"
            ]
          }
        }
      ]
    }
