              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndipo hukumu itakaa katika jangwa, na haki itakaa katika shamba lizaalo sana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.16",
            "verseOrgIds": [
              "ISA.32.16"
            ]
          }
        },
        {
