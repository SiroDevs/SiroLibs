                  "text": "Ufu 19:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, mfalme atamiliki kwa haki, na wakuu watatawala kwa hukumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwanadamu atakuwa kama mahali pa kujificha na upepo, na mahali pa kujisitiri na dhoruba; kama mito ya maji mahali pakavu, kama kivuli cha mwamba mkubwa katika nchi yenye uchovu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.18"
              },
              "items": [
                {
                  "text": "Isa 29:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena macho yao waonao hayatakuwa na kiwi, na masikio yao wasikiao yatasikiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena moyo wa mtu mwenye hamaki utafahamu maarifa, na ndimi zao wenye kigugumizi zitakuwa tayari kunena sawasawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpumbavu hataitwa tena muungwana, wala mlaghai hataitwa kuwa ni mheshimiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana mpumbavu atanena yaliyo upumbavu, na moyo wake utafanya maovu, ili kutenda hila na kusema yasiyo kweli juu ya BWANA, ili kuziacha nafsi za watu wenye njaa bila chakula, na kuwanyima kinywaji wenye kiu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena vyombo vyake mlaghai ni vibaya; hutunga hila mbaya, ili kuwaangamiza wanyonge kwa maneno ya uongo, mtu mhitaji ajaposema maneno yenye haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali muungwana huwaza mambo ya kiungwana, naye hushika sana mambo ya kiungwana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wanawake wasiojali waonywa juu ya maafa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
