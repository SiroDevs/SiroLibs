              "items": [
                {
                  "text": "Kum 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika mateso yao yote yeye aliteswa, na malaika wa uso wake akawaokoa; kwa mapenzi yake, na huruma zake, aliwakomboa mwenyewe; akawainua, akawachukua siku zote za kale. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        },
        {
