              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi nazivika mbingu weusi, nami nafanya nguo ya magunia kuwa kifuniko chao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
