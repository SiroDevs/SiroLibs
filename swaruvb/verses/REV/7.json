              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.16"
              },
              "items": [
                {
                  "text": "11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na malaika wote walikuwa wakisimama pande zote za kile kiti cha enzi, na za hao wazee, na za wale wenye uhai wanne, nao wakaanguka kifudifudi mbele ya kile kiti cha enzi, wakamsujudu Mungu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakisema, Amina; Baraka na utukufu na hekima na shukrani na heshima na uweza na nguvu zina Mungu wetu hata milele na milele. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
