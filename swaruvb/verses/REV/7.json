              },
              "items": [
                {
                  "text": "Ufu 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wakilia kwa sauti kuu wakisema, Wokovu una Mungu wetu aketiye katika kiti cha enzi, na Mwana-kondoo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
