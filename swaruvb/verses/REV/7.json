                {
                  "text": "Isa 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hawataona njaa tena, wala hawataona kiu tena, wala jua halitawapiga, wala joto iliyo yote. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
