                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo wako mbele ya kiti cha enzi cha Mungu, nao wanamtumikia mchana na usiku katika hekalu lake, na yeye aketiye katika kiti cha enzi atatanda hema yake juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
