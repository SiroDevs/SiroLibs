                "loc": "REV.14.1"
              },
              "items": [
                {
                  "text": "Ufu 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikasikia hesabu yao waliotiwa mhuri katika kila kabila la Waisraeli, watu elfu mia moja na arubaini na nne.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umati wa watu kutoka kila taifa",
          "type": "text"
        }
      ]
    },
    {
