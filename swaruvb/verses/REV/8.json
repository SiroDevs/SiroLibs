          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.31"
              },
              "items": [
                {
                  "text": "Mt 24:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nikawaona wale malaika saba wasimamao mbele za Mungu, nao wakapewa baragumu saba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        },
        {
