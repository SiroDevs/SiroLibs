                "loc": "REV.5.8"
              },
              "items": [
                {
                  "text": "Ufu 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na malaika mwingine akaja akasimama mbele ya madhabahu, akiwa na chetezo cha dhahabu, akapewa uvumba mwingi, ili autie pamoja na maombi ya watakatifu wote juu ya madhabahu ya dhahabu, iliyo mbele ya kiti cha enzi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.2"
              },
              "items": [
                {
                  "text": "Zab 141:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na moshi wa ule uvumba ukapanda mbele za Mungu pamoja na maombi ya watakatifu, kutoka mkononi mwa malaika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
