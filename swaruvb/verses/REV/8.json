                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na huyo malaika akakitwaa kile chetezo, akakijaza moto wa madhabahu, akautupa juu ya nchi, kukawa radi na sauti na umeme na tetemeko la nchi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
