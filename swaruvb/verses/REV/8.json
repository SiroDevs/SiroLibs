        },
        {
          "text": " Malaika wa pili akapiga baragumu, na kitu, mfano wa mlima mkubwa uwakao moto, kikatupwa katika bahari; theluthi ya bahari ikawa damu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
