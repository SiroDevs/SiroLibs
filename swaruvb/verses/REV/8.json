              "items": [
                {
                  "text": "Hab 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Mwana-kondoo alipofungua mhuri wa saba, kukawa kimya mbinguni kwa muda wa kama nusu saa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
