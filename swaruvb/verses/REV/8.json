          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakafa theluthi ya viumbe vilivyomo baharini, vyenye uhai; theluthi ya meli zikaharibiwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
