        },
        {
          "text": " Kisha nikaona katika mkono wa kulia wake yeye aliyeketi juu ya kile kiti cha enzi kitabu kilichoandikwa ndani na nyuma, kimetiwa mihuri saba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
