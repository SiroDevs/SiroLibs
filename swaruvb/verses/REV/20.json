                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akalishika lile joka, yule nyoka wa zamani, ambaye ni Ibilisi na Shetani, akamfunga miaka elfu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
