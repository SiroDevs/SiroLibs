                "loc": "2TH.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " akamtupa katika kuzimu, akamfunga, akatia mhuri juu yake, asipate kuwadanganya mataifa tena, hata ile miaka elfu itimie; na baada ya hayo yapasa afunguliwe kwa muda mfupi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
