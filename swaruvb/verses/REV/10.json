              "items": [
                {
                  "text": "Amo 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye akaita kwa sauti kuu, kama simba angurumavyo. Na alipolia, zile ngurumo saba zikatoa sauti zao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
              "REV.10.3"
            ]
          }
        },
