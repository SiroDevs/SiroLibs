            "caller": "#"
          },
          "items": [
            {
              "text": "Eze 2:8—3:3",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na sauti ile niliyoisikia kutoka mbinguni ilinena nami tena, ikisema, Nenda, ukakitwae kile kitabu kilichofunguliwa katika mkono wa yule malaika, aliyesimama juu ya bahari na juu ya nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
