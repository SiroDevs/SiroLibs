                "loc": "JER.25.30"
              },
              "items": [
                {
                  "text": "Yer 25:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.11.10"
