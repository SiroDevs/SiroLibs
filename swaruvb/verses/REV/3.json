        },
        {
          "text": " Uwe mwenye kukesha, ukayaimarishe mambo yaliyobakia, yanayotaka kufa. Maana sikuona matendo yako kuwa yametimilika mbele za Mungu wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.2",
            "verseOrgIds": [
