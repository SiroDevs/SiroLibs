        },
        {
          "text": " Kisha nikaona Mwana-kondoo alipofungua mojawapo ya ile mihuri saba, nikasikia mmoja wa wale wenye uhai wanne akisema, kama kwa sauti ya ngurumo, Njoo! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
