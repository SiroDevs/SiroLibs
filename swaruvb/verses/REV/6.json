              },
              "items": [
                {
                  "text": "6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akatoka farasi mwingine, mwekundu sana, na yeye aliyempanda aliruhusiwa kuiondoa amani katika nchi, ili watu wauane, naye akapewa upanga mkubwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
