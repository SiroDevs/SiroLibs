              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na alipoufungua mhuri wa pili, nikamsikia yule mwenye uhai wa pili akisema, Njoo! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
