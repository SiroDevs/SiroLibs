            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikasikia kama sauti katikati ya hao wenye uhai wanne, ikisema, Kibaba cha ngano kwa nusu rupia, na vibaba vitatu vya shayiri kwa nusu rupia, wala usiyadhuru mafuta wala divai.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
