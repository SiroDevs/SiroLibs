              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikaona, na tazama, farasi mweupe, na yeye aliyempanda ana uta, akapewa taji, naye akatoka, huku akishinda tena apate kushinda.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
