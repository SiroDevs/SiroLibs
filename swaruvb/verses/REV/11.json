        },
        {
          "text": " Na behewa lililo nje ya hekalu uliache nje wala usilipime, kwa maana Mataifa wamepewa hiyo, nao wataukanyaga mji mtakatifu miezi arubaini na miwili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
