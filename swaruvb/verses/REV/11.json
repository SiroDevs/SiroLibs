            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitawaruhusu mashahidi wangu wawili, nao watatoa unabii siku elfu na mia mbili na sitini, wakiwa wamevikwa magunia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        },
        {
          "name": "verse",
