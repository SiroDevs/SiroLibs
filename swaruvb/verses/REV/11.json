                  "text": "Zab 105:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao wakaao juu ya nchi wafurahi juu yao na kushangilia. Nao watapelekeana zawadi wao kwa wao, kwa kuwa manabii hao wawili waliwatesa wao wakaao juu ya nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        },
