        },
        {
          "text": " Hata watakapoumaliza ushuhuda wao, yule mnyama atokaye katika kuzimu atafanya vita nao, naye atawashinda na kuwaua. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
