                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hao ndio ile mizeituni miwili na vile vinara viwili visimamavyo mbele za Bwana wa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
