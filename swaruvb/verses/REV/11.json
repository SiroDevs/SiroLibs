              "items": [
                {
                  "text": "Lk 13:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mizoga yao itakuwa katika njia ya mji ule mkuu, uitwao kwa jinsi ya roho Sodoma, na Misri, tena ni hapo Bwana wao aliposulubiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.8",
            "verseOrgIds": [
              "REV.11.8"
            ]
          }
        },
        {
