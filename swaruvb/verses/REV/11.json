            "number": "9",
            "style": "v",
            "sid": "REV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na watu wa hao jamaa na kabila na lugha na taifa waitazama mizoga yao siku tatu u nusu, wala hawaiachi mizoga yao kuwekwa kaburini. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
