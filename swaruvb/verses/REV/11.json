              "items": [
                {
                  "text": "Mwa 15:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na baada ya siku hizo tatu u nusu, roho ya uhai itokayo kwa Mungu ikawaingia, wakasimama kwa miguu yao; na hofu kuu ikawaangukia watu waliowatazama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
