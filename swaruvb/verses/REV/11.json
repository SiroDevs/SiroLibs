              },
              "items": [
                {
                  "text": "2 Fal 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakasikia sauti kuu kutoka mbinguni ikiwaambia, Pandeni hata huku. Wakapanda mbinguni katika wingu, adui zao wakiwatazama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
