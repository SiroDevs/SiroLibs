              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala si kwa utumwa wa macho tu kama wajipendekazao kwa wanadamu bali kama watumwa wa Kristo, mkitenda yampendezayo Mungu kwa moyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
