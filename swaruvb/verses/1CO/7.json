              "items": [
                {
                  "text": "Flm 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana yeye aliyeitwa katika Bwana hali ya utumwa, ni huru wa Bwana. Vivyo hivyo yeye naye aliyeitwa hali ya uhuru, ni mtumwa wa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlinunuliwa kwa thamani; msiwe watumwa wa wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndugu zangu, kila mtu na akae mbele za Mungu katika hali iyo hiyo aliyoitwa nayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
    {
