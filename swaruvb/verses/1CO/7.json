                "loc": "1TI.1.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuhusu wanawali sina amri ya Bwana, lakini natoa shauri langu, mimi niliyejaliwa kwa rehema za Bwana kuwa mwaminifu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.25",
            "verseOrgIds": [
              "1CO.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, naona hili kuwa jema, kwa ajili ya shida iliyopo, kwamba ni vema mtu akae kama alivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.26",
            "verseOrgIds": [
              "1CO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Umefungwa kwa mke? Usitake kufunguliwa. Umefunguliwa? Usitafute mke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.27",
            "verseOrgIds": [
              "1CO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.23"
              },
              "items": [
                {
                  "text": "Lk 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini, kama ukioa, huna hatia; wala mwanamwali akiolewa, hana hatia; lakini watu kama hao watakuwa na dhiki katika mwili nami nataka kuwazuilia hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.11"
              },
              "items": [
                {
                  "text": "Rum 13:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.26"
              },
              "items": [
                {
                  "text": "Lk 14:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini, ndugu, nasema hivi, muda ubakio si mwingi; basi tokea sasa wale walio na wake na wawe kama hawana; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.29",
            "verseOrgIds": [
              "1CO.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wale waliao kama hawalii; na wale wafurahio kama hawafurahi; na wale wanunuao, kama hawana kitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.30",
            "verseOrgIds": [
              "1CO.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.15+1JN.2.16+1JN.2.17"
              },
              "items": [
                {
                  "text": "1 Yoh 2:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wale wautumiao ulimwengu huu, kama hawautumii sana; kwa maana mambo ya ulimwengu huu yanapita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.31",
            "verseOrgIds": [
              "1CO.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini nataka msiwe na masumbufu. Yeye asiyeoa hujishughulisha na mambo ya Bwana, ampendezeje Bwana; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.32",
            "verseOrgIds": [
              "1CO.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.20"
              },
              "items": [
                {
                  "text": "Lk 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.29"
              },
              "items": [
                {
                  "text": "Efe 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bali yeye aliyeoa hujishughulisha na mambo ya dunia hii, jinsi atakavyompendeza mkewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.33",
            "verseOrgIds": [
              "1CO.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena iko tofauti hii kati ya mke na mwanamwali. Yeye asiyeolewa hujishughulisha na mambo ya Bwana, apate kuwa mtakatifu mwili na roho. Lakini yeye aliyeolewa hujishughulisha na mambo ya dunia hii, jinsi atakavyompendeza mumewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.34",
            "verseOrgIds": [
              "1CO.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasema hayo niwafaidie, si kwamba niwategee tanzi, bali kwa ajili ya vile vipendezavyo, tena mpate kumhudumia Bwana pasipo kuvutwa na mambo mengine. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtu awaye yote akiona ya kuwa hamtendei mwanamwali wake ipendezavyo, na ikiwa huyo amepita uzuri wa ujana wake, na ikiwapo haja, basi, afanye apendavyo, hatendi dhambi, na awaruhusu waoane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini yeye aliyesimama kwa uthabiti wa moyo wake, hana sharti, lakini aweza kuyatawala mapenzi yake, tena amekusudia moyoni mwake kumlinda mwanamwali wake, atatenda vema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, hivyo na amwozaye mwanamwali wake afanya vema; na yeye asiyemwoza atazidi kufanya vema.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
