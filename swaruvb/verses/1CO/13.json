              },
              "items": [
                {
                  "text": "Mk 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena nijapokuwa na unabii, na kujua siri zote na maarifa yote, nijapokuwa na imani timilifu kiasi cha kuweza kuhamisha milima, kama sina upendo, mimi si kitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
