            "number": "4",
            "style": "v",
            "sid": "1CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upendo huvumilia, hufadhili; upendo hauhusudu; upendo hautakabari; haujivuni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
          }
        },
