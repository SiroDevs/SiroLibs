                "loc": "PHP.2.4"
              },
              "items": [
                {
                  "text": "Flp 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " haukosi kuwa na adabu; hautafuti mambo yake; hauoni uchungu; hauhesabu mabaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
