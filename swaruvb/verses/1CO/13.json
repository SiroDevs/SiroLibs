              },
              "items": [
                {
                  "text": "Mt 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena nikitoa mali zangu zote kuwalisha maskini, tena nikijitoa mwili wangu niungue moto, kama sina upendo, hainifaidi kitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
