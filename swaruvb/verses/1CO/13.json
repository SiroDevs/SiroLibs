              "items": [
                {
                  "text": "1 Pet 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Upendo haupungui neno wakati wowote; bali ukiwapo unabii utabatilika; zikiwapo lugha, zitakoma; yakiwapo maarifa, yatabatilika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana tunafahamu kwa sehemu; na tunafanya unabii kwa sehemu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini ijapo ile iliyo kamili, iliyo kwa sehemu itabatilika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilipokuwa mtoto mchanga, nilisema kama mtoto mchanga, nilifahamu kama mtoto mchanga, nilifikiri kama mtoto mchanga; tokea hapo nilipokuwa mtu mzima, nimeyabatilisha mambo ya kitoto. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
