              "items": [
                {
                  "text": "Yak 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana sasa tunaona kwa kioo kwa jinsi ya fumbo; wakati ule tutaona uso kwa uso; sasa nafahamu kwa sehemu; wakati ule nitajua sana kama mimi nami ninavyojuliwa sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
