        },
        {
          "text": "Nijaposema kwa lugha za wanadamu na za malaika, kama sina upendo, nimekuwa shaba iliayo na upatu uvumao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
