              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mtu akijiona kuwa ni nabii au mtu wa rohoni, na ayatambue hayo ninayowaandikia, ya kwamba ni maagizo ya Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
