            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.14"
              },
              "items": [
                {
                  "text": "Efe 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.12"
              },
              "items": [
                {
                  "text": "Flp 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndugu zangu, msiwe watoto katika akili zenu; lakini katika uovu mgeuzwe watoto wachanga, bali katika akili zenu muwe watu wazima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.11+ISA.28.12"
              },
              "items": [
                {
                  "text": "Isa 28:11-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Kum 28:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Imeandikwa katika torati, Nitasema na watu hawa kwa watu wa lugha nyingine, na kwa midomo ya wageni, wala hata hivyo hawatanisikia, asema Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, hizi lugha ni ishara, si kwao waaminio, bali kwao wasioamini lakini kutoa unabii si kwa ajili yao wasioamini, bali kwa ajili yao waaminio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.13"
              },
              "items": [
                {
                  "text": "Mdo 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haya! Ikiwa kanisa lote limekusanyika pamoja, na wote wanene kwa lugha, kisha ikawa wameingia watu wajinga au wasioamini, je! Hawatasema ya kwamba mna wazimu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.13"
              },
              "items": [
                {
                  "text": "Mdo 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini wote wakitoa unabii, kisha akaingia mtu asiyeamini, au mjinga, adhihirishwa na wote, ahukumiwa na wote; ",
          "type": "text",
