              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya hayo, ndugu, jitahidini sana kutoa unabii, wala msizuie kunena kwa lugha. ",
          "type": "text",
          "attrs": {
