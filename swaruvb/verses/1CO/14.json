          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mtu akiwa mjinga, na awe mjinga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
