                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.17"
              },
              "items": [
                {
                  "text": "22:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je! Mimi siko huru? Mimi si mtume? Mimi sikumwona Yesu Bwana wetu? Ninyi si kazi yangu katika Bwana? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.1",
            "verseOrgIds": [
              "1CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.2"
              },
              "items": [
                {
                  "text": "2 Kor 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana ikiwa mimi si mtume kwa wengine, lakini ni mtume kwenu ninyi; kwa maana ninyi ndinyi mhuri wa utume wangu katika Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilo ndilo jawabu langu kwa wale wanaoniuliza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.3",
            "verseOrgIds": [
              "1CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.8"
              },
              "items": [
                {
                  "text": "Lk 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Je! Hatuna uwezo wa kula na kunywa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.4",
            "verseOrgIds": [
              "1CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yn 1:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hatuna uwezo kuchukua pamoja nasi mke aliye ndugu, kama wao mitume wengine, na ndugu wa Bwana, na Kefa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.5",
            "verseOrgIds": [
              "1CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au je! Ni mimi peke yangu na Barnaba tusio na uwezo wa kutofanya kazi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.6",
            "verseOrgIds": [
              "1CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni askari gani aendaye vitani wakati wowote kwa gharama zake mwenyewe? Ni nani apandaye mizabibu asiyekula katika matunda yake? Au ni nani achungaye kundi, asiyekunywa katika maziwa ya kundi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je! Ninanena hayo kwa kibinadamu? Au torati nayo haisemi yayo hayo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.8",
            "verseOrgIds": [
              "1CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Kum 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "1 Tim 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana katika Torati ya Musa imeandikwa, Usimfunge kinywa ng'ombe apurapo nafaka. Je! Hapo Mungu aangalia mambo ya ng'ombe? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.6"
              },
              "items": [
                {
                  "text": "2 Tim 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Au yamkini anena hayo kwa ajili yetu? Naam, yaliandikwa kwa ajili yetu; kwa kuwa alimaye nafaka ni haki yake kulima kwa matumaini, naye apuraye nafaka ni haki yake kutumaini kupata sehemu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.10",
            "verseOrgIds": [
              "1CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.27"
              },
              "items": [
                {
                  "text": "Rum 15:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikiwa sisi tuliwapandia ninyi vitu vya rohoni, je! Ni neno kubwa tukivuna vitu vyenu vya mwilini? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.11",
            "verseOrgIds": [
              "1CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.34"
              },
              "items": [
                {
                  "text": "Mdo 20:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.7"
              },
              "items": [
                {
                  "text": "1 Kor 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.9"
              },
              "items": [
                {
                  "text": "2 Kor 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikiwa wengine wanashiriki uwezo huu juu yenu, sisi si zaidi? Lakini hatukuutumia uwezo huo; bali twayavumilia mambo yote tusije tukaizuia Habari Njema ya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.1+DEU.18.2+DEU.18.3"
              },
              "items": [
                {
                  "text": "Kum 18:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8"
              },
              "items": [
                {
                  "text": "Hes 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hamjui ya kuwa wale wazifanyao kazi za hekaluni hula katika vitu vya hekalu, na wale waihudumiayo madhabahu huwa na fungu lao katika vitu vya madhabahu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.13",
            "verseOrgIds": [
              "1CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.10"
              },
              "items": [
                {
                  "text": "Mt 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Lk 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.6"
              },
              "items": [
                {
                  "text": "Gal 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Bwana vivyo hivyo ameamuru kwamba wale waihubirio Injili wapate riziki kwa hiyo Injili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.14",
            "verseOrgIds": [
              "1CO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.3"
              },
              "items": [
                {
                  "text": "Mdo 18:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini mimi sikutumia mambo hayo hata moja. Wala siyaandiki hayo ili iwe hivyo kwangu mimi; maana ni heri nife kuliko mtu awaye yote abatilishe huku kujisifu kwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.15",
            "verseOrgIds": [
              "1CO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.20.9"
              },
              "items": [
                {
                  "text": "Yer 20:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana, ijapokuwa naihubiri Injili, sina la kujisifia; maana nimewekewa sharti; tena ole wangu nisipoihubiri Injili! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.16",
            "verseOrgIds": [
              "1CO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.1"
              },
              "items": [
                {
                  "text": "1 Kor 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana nikiitenda kazi hii kwa hiari yangu nina thawabu; ila ikiwa si kwa hiari yangu, nimeaminiwa uwakili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.17",
            "verseOrgIds": [
              "1CO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.9"
              },
              "items": [
                {
                  "text": "1 Kor 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi thawabu yangu ni nini? Ni hii, ya kuwa ninapohubiri, nitaitoa Injili bila gharama, bila kutumia kwa utimilifu uwezo wangu nilio nao katika Injili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.18",
            "verseOrgIds": [
              "1CO.9.18"
            ]
          }
        },
