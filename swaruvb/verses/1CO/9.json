          ]
        },
        {
          "text": " Maana, ingawa nimekuwa huru kwa watu wote, nilijifanya mtumwa wa wote, ili nipate watu wengi zaidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.19",
