              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana hekima ya dunia hii ni upuzi mbele za Mungu. Kwa maana imeandikwa, Yeye ndiye awanasaye wenye hekima katika hila yao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.19",
            "verseOrgIds": [
              "1CO.3.19"
            ]
          }
        },
