                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtu asijidanganye mwenyewe; kama mtu akijiona kuwa mwenye hekima miongoni mwenu katika dunia hii, na awe mpumbavu, ili apate kuwa mwenye hekima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.18",
            "verseOrgIds": [
              "1CO.3.18"
            ]
          }
        },
