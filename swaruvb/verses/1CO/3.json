              "items": [
                {
                  "text": "Zab 94:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na tena, Bwana anayafahamu mawazo ya wenye hekima ya kwamba ni ya ubatili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mtu yeyote na asijisifie wanadamu. Kwa maana vyote ni vyenu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
