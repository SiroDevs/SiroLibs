            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwamba ni Paulo, au Apolo, au Kefa; au dunia, au uzima, au mauti; au vile vilivyopo sasa, au vile vitakavyokuwapo; vyote ni vyenu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
