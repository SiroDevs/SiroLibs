              "items": [
                {
                  "text": "2 Kor 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini yeye aliyeungwa na Bwana ni roho moja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.17",
            "verseOrgIds": [
              "1CO.6.17"
            ]
          }
        },
        {
          "name": "verse",
