            "number": "18",
            "style": "v",
            "sid": "1CO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikimbieni zinaa. Kila dhambi aitendayo mwanadamu ni nje ya mwili wake; ila yeye afanyaye zinaa hutenda dhambi juu ya mwili wake mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.18",
            "verseOrgIds": [
              "1CO.6.18"
            ]
          }
        },
