              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Au hamjui ya kuwa mwili wenu ni hekalu la Roho Mtakatifu aliye ndani yenu, mliyepewa na Mungu? Wala ninyi si mali yenu wenyewe; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.19",
            "verseOrgIds": [
              "1CO.6.19"
            ]
          }
