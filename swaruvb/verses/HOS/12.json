              "items": [
                {
                  "text": "Dan 11:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Efraimu amenitia hasira kali sana; kwa sababu hiyo damu yake itaachwa juu yake, na Bwana wake atamrudishia lawama yake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.14",
