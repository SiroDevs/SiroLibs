              "items": [
                {
                  "text": "Isa 30:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Efraimu hujilisha upepo, na kuandamana na upepo wa mashariki; haachi kuongeza uongo na uharibifu; nao wafanya agano na Ashuru, na mafuta huchukuliwa kwenda Misri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uasi wa muda mrefu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 12:1"
          },
          "items": [
