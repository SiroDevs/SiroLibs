            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA naye ana shutuma juu ya Yuda, naye atamwadhibu Yakobo kwa kadiri ya njia zake; kwa kadiri ya matendo yake atamlipa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi, mrudie Mungu wako; shika fadhili na hukumu; ukamngojee Mungu wako daima.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mfanya biashara, aliye na mizani ya udanganyifu mkononi mwake; anapenda kudhulumu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Efraimu alisema, Kweli nimekuwa tajiri, nimejipatia mali nyingi; katika kazi zangu zote hawataona kwangu uovu wowote uliokuwa dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Law 23:42-43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini mimi ni BWANA, Mungu wako tangu ulipotoka katika nchi ya Misri; nitakukalisha tena katika hema, kama siku za sikukuu teule. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena nimenena na hao manabii, nami nimeongeza maono, na kwa utumishi wa manabii nimetumia mifano. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.4"
              },
              "items": [
                {
                  "text": "Amo 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika Gileadi kuna uovu? Nao wamekuwa ubatili tu; huko Gilgali hutoa dhabihu za ng'ombe; naam, madhabahu zao zimekuwa kama chungu katika matuta ya mashamba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
