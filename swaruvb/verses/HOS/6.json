                "loc": "JOB.29.23"
              },
              "items": [
                {
                  "text": "Ayu 29:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nasi na tujue, naam, tukaendelee kumjua BWANA; kutokea kwake ni yakini kama asubuhi; naye atatujia kama mvua, kama mvua ya vuli iinyweshayo nchi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uovu wa Israeli na Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
