            "number": "2",
            "style": "v",
            "sid": "HOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baada ya siku mbili atatufufua; siku ya tatu atatuinua, nasi tutaishi mbele zake. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        },
