            "style": "v",
            "sid": "HOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Efraimu, nikutendee nini? Ee Yuda, nikutendee nini? Kwa maana fadhili zenu ni kama wingu la asubuhi na kama umande utowekao mapema. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.10"
              },
              "items": [
                {
                  "text": "Yer 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.12"
              },
              "items": [
                {
                  "text": "Ebr 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu hiyo nimewakatakata kwa vinywa vya manabii; nimewaua kwa maneno ya kinywa changu; na hukumu yangu itatokea kama mwanga. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
