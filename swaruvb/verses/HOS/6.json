        },
        {
          "text": " Njooni, tumrudie BWANA; maana yeye amerarua, na yeye atatuponya; yeye amepiga, na yeye atatufunga majeraha yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
