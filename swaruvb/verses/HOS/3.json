                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana wana wa Israeli watakaa siku nyingi bila mfalme, wala mtu mkuu, wala sadaka, wala nguzo, wala naivera,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
