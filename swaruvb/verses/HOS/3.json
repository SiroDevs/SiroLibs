        "style": "s1"
      },
      "items": [
        {
          "text": "Hakikisho zaidi la upendo mkuu wa Mungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
