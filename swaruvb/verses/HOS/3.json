            "style": "v",
            "sid": "HOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akaniambia, Nenda tena, mpende mwanamke apendwaye na rafiki yake, naye ni mzinzi; kama vile BWANA awapendavyo wana wa Israeli, ingawa wanaigeukia miungu mingine, na kupenda mikate ya zabibu kavu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi nikajinunulia mwanamke huyo kwa vipande kumi na vitano vya fedha, na homeri moja ya shayiri, na nusu ya homeri ya shayiri; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.13"
              },
              "items": [
                {
                  "text": "Kum 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nami nilimwambia, Utatawa kwa ajili yangu siku nyingi; hutafanya mambo ya ukahaba, wala hutakuwa mke wa mtu awaye yote; nami nitakuwa hali iyo hiyo kwa ajili yako. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
