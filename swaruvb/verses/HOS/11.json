        },
        {
          "text": " Hatarudi tena nchi ya Misri; bali huyo Mwashuri atakuwa mfalme wake; kwa sababu walikataa kurejea. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na upanga utaiangukia miji yake, utayaharibu makomeo yake na kuyala, kwa sababu ya mashauri yao wenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na watu wangu wamejipinda kuniacha; ingawa wawaita kwenda kwake Aliye Juu, hapana hata mmoja atakayemtukuza.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
