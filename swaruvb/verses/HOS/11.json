                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kadiri walivyowaita ndivyo walivyoondoka na kuwaacha; waliwatolea dhabihu Mabaali, na kuzifukizia uvumba sanamu za kuchonga. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
