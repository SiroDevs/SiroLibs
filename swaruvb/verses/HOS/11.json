                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Niliwavuta kwa kamba za kibinadamu, kwa mafungo ya upendo; nami nilikuwa kwao kama hao waondoao kongwa tayani mwao, nikaandaa chakula mbele yao. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
