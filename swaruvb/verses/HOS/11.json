                  "text": "Kut 15:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini nilimfundisha Efraimu kwenda kwa miguu; niliwachukua mikononi mwangu; hawakujua ya kuwa niliwaponya. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
