                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Israeli alipokuwa mtoto, nilikuwa nikimpenda, nikamwita mwanangu atoke Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
