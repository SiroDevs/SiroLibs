        },
        {
          "text": "Waambieni ndugu zenu, Ami",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:1",
              "type": "text"
            },
            {
              "text": "Ami:",
              "type": "text"
            },
            {
              "text": "maana yake ni ‘watu wangu.’",
              "type": "text"
            }
          ]
        },
        {
          "text": " na dada zenu, Ruhama.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:1",
              "type": "text"
            },
            {
              "text": "Ruhama:",
              "type": "text"
            },
            {
              "text": "maana yake ni ‘aliyehurumiwa.’",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uzinzi, adhabu na ukombozi wa Israeli",
          "type": "text"
        }
      ]
    },
