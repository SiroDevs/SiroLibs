            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.35"
              },
              "items": [
                {
                  "text": "Eze 20:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwa hiyo angalia, mimi nitamshawishi, na kumleta nyikani, na kusema naye maneno ya kumtuliza moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        },
        {
