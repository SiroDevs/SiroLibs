                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.55"
              },
              "items": [
                {
                  "text": "1 Kor 15:55",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nitawakomboa kwa nguvu za kaburi; nitawaokoa kutoka kwa mauti; ewe mauti, ya wapi mapigo yako? Ewe kaburi, ku wapi kuharibu kwako? Huruma itafichika machoni mwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
              "HOS.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajapokuwa yeye ni mwenye kuzaa sana kati ya ndugu zake, upepo wa mashariki utakuja, hiyo pumzi ya BWANA itokayo upande wa nyikani, na kijito chake cha maji kitakauka, na chemchemi yake itakaushwa; yeye atateka nyara hazina ya vyombo vyote vipendezavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.15",
            "verseOrgIds": [
              "HOS.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.12"
              },
              "items": [
                {
                  "text": "2 Fal 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Samaria atachukua hatia yake; kwa maana amemwasi Mungu wake; wataanguka kwa upanga; watoto wao wachanga watavunjwa vipande vipande, na wanawake wao wenye mimba watatumbuliwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.16",
            "verseOrgIds": [
              "HOS.13.16"
            ]
          }
        }
