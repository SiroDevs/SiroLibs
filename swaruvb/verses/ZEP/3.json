              "items": [
                {
                  "text": "Ufu 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mabaki ya Israeli hawatatenda uovu, wala kusema uongo; wala ulimi wa hadaa hautakuwa kinywani mwao; kwa maana watakula na kulala, wala hapana mtu atakayewatisha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.13",
            "verseOrgIds": [
              "ZEP.3.13"
            ]
          }
        }
