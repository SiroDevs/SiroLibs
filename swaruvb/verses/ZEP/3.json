              "items": [
                {
                  "text": "Lk 6:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini nitabakiza ndani yako watu walioonewa na maskini, nao watalitumainia jina la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.12",
            "verseOrgIds": [
              "ZEP.3.12"
            ]
          }
        },
