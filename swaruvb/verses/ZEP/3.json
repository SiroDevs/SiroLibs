              "attrs": {
                "loc": "MAT.3.9"
              },
              "items": [
                {
                  "text": "Mt 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siku ile hutaaibishwa kwa matendo yako yote uliyoniasi; maana hapo nitawaondoa watu wako wanaojigamba na kujivuna, wasiwe kati yako, wala hutatakabari tena katika mlima wangu mtakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.11",
            "verseOrgIds": [
              "ZEP.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
