            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.99.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA kati yake ni mwenye haki; hatatenda uovu; kila asubuhi hudhihirisha hukumu yake, wala hakomi; bali mtu asiye haki hajui kuona haya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimekatilia mbali mataifa, minara yao ina ukiwa; nimeziharibu njia kuu zao, hata hapana mmoja apitaye; miji yao imeangamizwa; hamna mtu hata mmoja, wala hapana akaaye huko. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.12"
              },
              "items": [
                {
                  "text": "Mwa 6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nilisema, Hakika utaniogopa, utakubali kurudiwa; ili yasikatiliwe mbali makao yake, sawasawa ya yote niliyoagiza katika habari zake; lakini waliondoka mapema na kuyaharibu matendo yao yote.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adhabu na wokovu wa mataifa",
          "type": "text"
        }
      ]
    },
