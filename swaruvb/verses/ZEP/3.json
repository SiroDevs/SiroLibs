              },
              "items": [
                {
                  "text": "Mdo 8:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana toka nchi iliyo mbali na mito ya Kushi, waniombao dua, yaani, binti za watu wangu waliotawanyika, wataleta matoleo yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
            "verseOrgIds": [
              "ZEP.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
