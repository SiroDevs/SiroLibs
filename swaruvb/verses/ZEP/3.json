              "items": [
                {
                  "text": "Yoe 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi ningojeeni, asema BWANA, hata siku ile nitakapoondoka kuteka mateka; maana nimeazimia kuwakusanya mataifa, ili nizikutanishe falme, nipate kuwamwagia ghadhabu yangu; naam, ukali wote wa hasira yangu; kwa maana dunia yote itateketezwa kwa moto wa wivu wangu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
