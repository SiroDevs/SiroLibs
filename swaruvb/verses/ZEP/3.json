          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana hapo ndipo nitakapowarudishia mataifa lugha iliyo safi, wapate kuliitia jina la BWANA, wamtumikie kwa nia moja. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        },
        {
