              "items": [
                {
                  "text": "Kol 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuna mtu miongoni mwenu anayeteseka? Na aombe. Ana moyo wa kuchangamka? Na aimbe zaburi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
