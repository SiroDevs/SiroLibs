              "attrs": {
                "loc": "JOB.31.38+JOB.31.39+JOB.31.40"
              },
              "items": [
                {
                  "text": "Ayu 31:38-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Angalieni, ujira wa wakulima waliovuna mashamba yenu, ninyi mliokosa kuwalipa kwa hila, unapiga kelele, na vilio vyao waliovuna vimeingia masikioni mwa Bwana wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.4",
            "verseOrgIds": [
              "JAS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 5:5"
