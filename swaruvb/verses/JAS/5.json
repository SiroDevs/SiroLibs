              "items": [
                {
                  "text": "Ebr 10:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo ndugu, vumilieni, hata kuja kwake Bwana. Tazama, mkulima hungoja mazao ya nchi yaliyo ya thamani, huvumilia kwa ajili yake hata yatakapopata mvua ya kwanza na ya mwisho. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.7",
            "verseOrgIds": [
              "JAS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
