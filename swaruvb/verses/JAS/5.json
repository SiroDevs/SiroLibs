                "loc": "JER.12.3"
              },
              "items": [
                {
                  "text": "Yer 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mmefanya anasa katika dunia, na kujifurahisha kwa tamaa; mmejinenepesha mioyo yenu kama kwa siku ya kuchinjwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmehukumu mwenye haki mkamwua; wala hashindani nanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        }
      ]
    },
