              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndugu, msinung'unikiane, msije mkahukumiwa. Angalieni, mwamuzi amesimama mbele ya milango. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
              "JAS.5.9"
