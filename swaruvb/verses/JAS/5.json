              "items": [
                {
                  "text": "Mk 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kule kuomba kwa imani kutamwokoa mgonjwa yule, na Bwana atamwinua; hata ikiwa amefanya dhambi, atasamehewa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
