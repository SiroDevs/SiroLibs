                {
                  "text": "Mt 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndugu, watwaeni manabii walionena kwa jina la Bwana, wawe mfano wa kustahimili mabaya, na wa uvumilivu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.10",
            "verseOrgIds": [
