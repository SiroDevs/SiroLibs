              "items": [
                {
                  "text": "Mk 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtu wa kwenu amekuwa mgonjwa? Na awaite wazee wa kanisa; nao wamwombee, na kumpaka mafuta kwa jina la Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
