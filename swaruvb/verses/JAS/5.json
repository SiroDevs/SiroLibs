              },
              "items": [
                {
                  "text": "3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanyi vumilieni, mthibitishe mioyo yenu, kwa maana kuja kwake Bwana kunakaribia.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
