              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ungameni dhambi zenu ninyi kwa ninyi, na kuombeana, ili mpate kuponywa. Sala yake mwenye haki ina nguvu nyingi, na hutenda mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
