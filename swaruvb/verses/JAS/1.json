              "items": [
                {
                  "text": "1 Pet 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mkifahamu ya kuwa kujaribiwa kwa imani yenu huleta saburi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.3",
            "verseOrgIds": [
              "JAS.1.3"
            ]
          }
        },
        {
