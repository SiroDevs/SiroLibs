          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana hujiangalia, kisha huenda zake, mara akasahau jinsi alivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.24",
            "verseOrgIds": [
              "JAS.1.24"
            ]
          }
        },
