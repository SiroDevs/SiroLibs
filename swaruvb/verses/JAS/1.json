          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana jua huchomoza kwa joto kali, huyakausha majani; ua lake huanguka, uzuri wa umbo lake hupotea; vivyo hivyo naye tajiri atanyauka katika njia zake.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
