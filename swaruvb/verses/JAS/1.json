                  "text": "Rum 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini iweni watendaji wa neno, wala si wasikiaji tu, hali mkijidanganya nafsi zenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.22",
            "verseOrgIds": [
              "JAS.1.22"
            ]
