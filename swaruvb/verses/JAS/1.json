                {
                  "text": "1 Pet 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bali tajiri kwa kuwa ameshushwa; kwa maana atatoweka kama ua la majani. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
        {
