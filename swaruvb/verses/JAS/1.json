          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu mtu akiwa ni msikiaji wa neno tu, wala si mtendaji, mtu huyo ni kama mtu anayejiangalia uso wake katika kioo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
              "JAS.1.23"
            ]
          }
        },
