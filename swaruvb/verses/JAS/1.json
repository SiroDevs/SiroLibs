        },
        {
          "text": " Lakini mmoja wenu akipungukiwa na hekima, na aombe dua kwa Mungu, awapaye wote, kwa ukarimu, wala hakemei; naye atapewa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
