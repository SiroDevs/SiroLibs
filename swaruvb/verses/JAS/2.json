              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.45"
              },
              "items": [
                {
                  "text": "25:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana hukumu haina huruma kwake yeye asiyeona huruma. Huruma hujitukuza juu ya hukumu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.2.13",
            "verseOrgIds": [
              "JAS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imani bila matendo imekufa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
