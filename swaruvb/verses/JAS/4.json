                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haya basi, ninyi msemao, Leo au kesho tutaingia katika mji fulani na kukaa humo mwaka mzima, na kufanya biashara na kupata faida; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
