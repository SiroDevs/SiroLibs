                {
                  "text": "Mit 3:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.22.29"
              },
              "items": [
                {
                  "text": "Ayu 22:29",
                  "type": "text"
