              "items": [
                {
                  "text": "Gal 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Au mwadhani ya kwamba Maandiko yasema bure? Huyo Roho akaaye ndani yetu hututamani kiasi cha kuona wivu? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.5",
            "verseOrgIds": [
              "JAS.4.5"
            ]
          }
        },
        {
