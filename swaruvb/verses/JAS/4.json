            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.10",
            "verseOrgIds": [
              "JAS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndugu, msisingiziane; amsingiziaye ndugu yake, au kumhukumu ndugu yake, huisingizia sheria na kuihukumu sheria. Lakini ukiihukumu sheria, huwi mtenda sheria, bali umekuwa hakimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.11",
            "verseOrgIds": [
              "JAS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.1"
              },
              "items": [
                {
                  "text": "Mk 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.1"
              },
              "items": [
                {
                  "text": "Rum 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.4"
              },
              "items": [
                {
                  "text": "14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtoa sheria na mwenye kuhukumu ni mmoja tu, ndiye awezaye kuokoa na kuangamiza. U nani wewe umhukumuye mtu mwingine?",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.12",
            "verseOrgIds": [
              "JAS.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kujivuna juu ya kesho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
