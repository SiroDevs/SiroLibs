                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.5"
              },
              "items": [
                {
                  "text": "1 Pet 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini hutujalia sisi neema iliyozidi; kwa hiyo husema, Mungu huwapinga wajikuzao, bali huwapa neema wanyenyekevu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.6",
            "verseOrgIds": [
              "JAS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.12"
              },
              "items": [
                {
                  "text": "Efe 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.8"
              },
              "items": [
                {
                  "text": "1 Pet 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi mtiini Mungu. Mpingeni Shetani, naye atawakimbia. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.7",
            "verseOrgIds": [
              "JAS.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.3"
              },
              "items": [
                {
                  "text": "Zek 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.16"
              },
              "items": [
                {
                  "text": "Isa 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mkaribieni Mungu, naye atawakaribia ninyi. Itakaseni mikono yenu, enyi wenye dhambi, na kuisafisha mioyo yenu, enyi wenye nia mbili. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.8",
            "verseOrgIds": [
              "JAS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huzunikeni na kuomboleza na kulia. Kucheka kwenu na kugeuzwe kuwa kuomboleza, na furaha yenu kuwa huzuni kubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.9",
            "verseOrgIds": [
              "JAS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.6"
              },
              "items": [
                {
                  "text": "1 Pet 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jidhilini mbele za Bwana, naye atawakuza.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.10",
            "verseOrgIds": [
              "JAS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyo juu ya kumhukumu mwingine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
