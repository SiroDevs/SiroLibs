            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.20"
              },
              "items": [
                {
                  "text": "Lk 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.5"
              },
              "items": [
                {
                  "text": "Zab 39:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lakini hamjui yatakayokuwako kesho. Uzima wenu ni nini? Maana ninyi ni mvuke uonekanao kwa muda mfupi tu, kisha hutoweka. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.14",
            "verseOrgIds": [
              "JAS.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.21"
              },
              "items": [
                {
                  "text": "Mdo 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Badala ya kusema, Bwana akipenda, tutakuwa hai na kufanya hivi au hivi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.15",
            "verseOrgIds": [
              "JAS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sasa mwajisifu katika majivuno yenu; kujisifu kote kwa namna hii ni kubaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.16",
            "verseOrgIds": [
              "JAS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
