              "items": [
                {
                  "text": "1 Kor 15:53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu sisi tulio katika maskani hii twapumua kwa shida, tukilemewa; si kwamba twataka kuvuliwa, bali kuvikwa, ili kitu kile kipatikanacho na mauti kimezwe na uzima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
