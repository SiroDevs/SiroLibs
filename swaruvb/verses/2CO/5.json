              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata imekuwa, sisi tangu sasa hatumjui mtu awaye yote kwa jinsi ya mwili. Ingawa sisi tumemtambua Kristo kwa jinsi ya mwili, lakini sasa hatumtambui hivi tena. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
