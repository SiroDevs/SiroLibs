                  "text": "Ebr 11:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi siku zote tuna moyo mkuu; tena twajua ya kuwa, wakati tuwapo hapa katika mwili, tunakaa mbali na Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
