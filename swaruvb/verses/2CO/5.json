          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiwa tukiisha kuvikwa hatutaonekana tuko uchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
