              "items": [
                {
                  "text": "Flp 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini tuna moyo mkuu; nasi tunaona ni afadhali kutokuwemo katika mwili na kukaa pamoja na Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
