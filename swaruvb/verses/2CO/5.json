                }
              ]
            }
          ]
        },
        {
          "text": " tena alikufa kwa ajili ya wote, ili walio hai wasiwe hai tena kwa ajili ya nafsi zao wenyewe, bali kwa ajili yake yeye aliyekufa akafufuka kwa ajili yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        },
        {
