              },
              "items": [
                {
                  "text": "Rum 8:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana katika nyumba hii twaugua, tukitamani sana kuvikwa kao letu litokalo mbinguni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
