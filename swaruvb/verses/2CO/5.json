              "items": [
                {
                  "text": "Zab 39:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo, tena, ikiwa tupo hapa, au ikiwa hatupo hapa, twajitahidi kumpendeza yeye. ",
          "type": "text",
          "attrs": {
