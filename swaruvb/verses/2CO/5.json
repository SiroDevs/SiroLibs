        {
          "text": " Basi yeye aliyetufanya kwa ajili ya neno lilo hilo ni Mungu, aliyetupa arabuni ya Roho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
