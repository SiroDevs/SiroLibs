            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:15",
              "type": "text"
            },
            {
              "text": "Beliari:",
              "type": "text"
            },
            {
              "text": "maana yake ni, Ufisadi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Au yeye aaminiye ana sehemu gani pamoja na yeye asiyeamini? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
