        },
        {
          "text": " Msifungiwe nira pamoja na wasioamini, kwa jinsi isivyo sawasawa; kwa maana pana urafiki gani kati ya haki na uasi? Tena pana shirika gani kati ya nuru na giza? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
