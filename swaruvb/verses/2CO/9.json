                }
              ]
            }
          ]
        },
        {
          "text": " Lakini nasema neno hili, Apandaye haba atavuna haba; apandaye kwa ukarimu atavuna kwa ukarimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
