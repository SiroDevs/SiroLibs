                  "text": "Flp 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wao ni Waebrania? Na mimi pia. Wao ni Waisraeli? Na mimi pia. Wao ni uzao wa Abrahamu? Na mimi pia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.22",
            "verseOrgIds": [
              "2CO.11.22"
            ]
          }
