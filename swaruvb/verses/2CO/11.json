        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.6"
              },
              "items": [
                {
                  "text": "2 Kor 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nasema tena, mtu asidhani ya kuwa mimi ni mpumbavu; lakini mjaponidhania hivi, mnikubali kama mpumbavu; ili mimi nami nipate kujisifu angaa kidogo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninenalo silineni agizo la Bwana, bali kama kwa upumbavu, katika ujasiri huu wa kujisifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.17",
            "verseOrgIds": [
              "2CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 11:18"
