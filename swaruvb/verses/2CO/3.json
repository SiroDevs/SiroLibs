                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana hata ile iliyotukuzwa haikuwa na utukufu hivi, kwa sababu ya utukufu uzidio sana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
