            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.8"
              },
              "items": [
                {
                  "text": "1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akamwambia, Mwanangu, ubarikiwe na BWANA; umezidi kuonesha fadhili zako mwisho kuliko mwanzo, kwa vile usivyowafuata vijana, wawe ni maskini au matajiri. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.10",
            "verseOrgIds": [
              "RUT.3.10"
            ]
          }
        },
