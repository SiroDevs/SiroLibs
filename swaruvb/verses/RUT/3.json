              "attrs": {
                "loc": "EZK.16.8"
              },
              "items": [
                {
                  "text": "Eze 16:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema, Ama! Ni nani wewe? Akamjibu, Ni mimi, Ruthu, mjakazi wako; uitande nguo yako juu ya mjakazi wako; kwa kuwa ndiwe wa jamaa aliye karibu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.9",
            "verseOrgIds": [
              "RUT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 3:10"
          },
          "items": [
