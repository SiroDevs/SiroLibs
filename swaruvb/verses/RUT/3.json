        },
        {
          "text": " Kisha Naomi akamwambia mkwewe, Je! Mwanangu, si vizuri nikutafutie raha, ili upate mema? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.1",
            "verseOrgIds": [
              "RUT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
