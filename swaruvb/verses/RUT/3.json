              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akashuka mpaka ugani; akafanya yote kama vile mkwewe alivyomwagiza. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.6",
            "verseOrgIds": [
              "RUT.3.6"
            ]
