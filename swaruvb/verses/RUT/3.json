              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Na vipimo hivi sita vya shayiri amenipa; maana aliniambia, Usiende kwa mkweo mikono mitupu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.17",
