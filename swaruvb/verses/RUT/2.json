              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.23"
              },
              "items": [
                {
                  "text": "1 Sam 25:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo aliposujudia, akainama mpaka nchi, akamwambia, Jinsi gani nimepata kibali machoni pako, hata ukanifahamu, mimi niliye mgeni? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
