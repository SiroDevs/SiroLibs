              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wao wanaostarehe katika Sayuni, na hao wanaokaa salama katika mlima wa Samaria, watu mashuhuri wa taifa lililo la kwanza, ambao nyumba ya Israeli huwaendea. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        },
