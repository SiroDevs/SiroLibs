                  "text": "2 Fal 14:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Piteni hadi Kalne, mkaone; tena tokea huko nendeni hadi Hamathi iliyo kuu; kisha shukeni hadi Gathi ya Wafilisti; je! Ninyi ni bora kuliko falme hizi? Au eneo lao ni kubwa kuliko eneo lenu? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        },
