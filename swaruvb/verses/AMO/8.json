                  "text": "Mik 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Angalia, siku zinakuja, asema Bwana MUNGU, ambazo nitaleta njaa katika nchi; si njaa ya kukosa chakula, wala kiu ya kukosa maji, bali ya kukosa kuyasikia maneno ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watatangatanga toka bahari hata bahari; na toka upande wa kaskazi hata upande wa mashariki; watapiga mbio, wakienda huku na huko, kulitafuta neno la BWANA, wasilione. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku hiyo wanawali wazuri na wavulana watazimia kwa kiu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.13",
            "verseOrgIds": [
              "AMO.8.13"
            ]
          }
