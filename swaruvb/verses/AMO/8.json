              "items": [
                {
                  "text": "Hos 8:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA ameapa kwa fahari ya Yakobo, Hakika sitazisahau kamwe kazi zao hata mojawapo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.7",
            "verseOrgIds": [
              "AMO.8.7"
            ]
          }
        },
