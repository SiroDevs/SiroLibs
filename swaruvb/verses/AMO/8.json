              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo aliyonionesha Bwana MUNGU; tazama, kikapu cha matunda ya wakati wa joto. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
