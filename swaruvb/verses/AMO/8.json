                "loc": "JER.1.12"
              },
              "items": [
                {
                  "text": "Yer 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.18"
              },
              "items": [
                {
                  "text": "Omb 4:18",
