                "loc": "NEH.13.15"
              },
              "items": [
                {
                  "text": "Neh 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.10"
              },
              "items": [
                {
                  "text": "Mik 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mkisema, Mwezi mpya utaondoka lini, tupate kuuza nafaka? Na sabato nayo, tupate kuandaa ngano? Mkiipunguza efa na kuiongeza shekeli, mkidanganya watu kwa mizani ya udanganyifu; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "tupate kuwanunua maskini kwa fedha, na wahitaji kwa jozi ya viatu; na kuziuza takataka za ngano. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        },
        {
