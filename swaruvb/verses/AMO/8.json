              "attrs": {
                "loc": "AMO.9.5"
              },
              "items": [
                {
                  "text": "Amo 9:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa ajili ya hayo, je! Haitatetemeka nchi, na kuomboleza kila mtu akaaye ndani yake? Naam, itainuka yote pia kama huo Mto; nayo itataabika na kupwa tena kama Mto wa Misri.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
