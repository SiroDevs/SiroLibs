                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitazigeuza sikukuu zenu kuwa maombolezo, na nyimbo zenu zote kuwa vilio; nami nitatia nguo za magunia katika viuno vyote, na upara katika kila kichwa; nami nitayafanya haya kuwa kama maombolezo kwa ajili ya mwana wa pekee, na mwisho wake kama siku ya uchungu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
