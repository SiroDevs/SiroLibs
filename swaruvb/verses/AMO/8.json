        },
        {
          "text": " Tena itakuwa siku hiyo, asema Bwana MUNGU, nitalifanya jua litue wakati wa adhuhuri, nami nitaitia nchi giza wakati wa nuru ya mchana. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
