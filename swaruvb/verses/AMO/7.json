              "items": [
                {
                  "text": "Mik 7:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akaniambia, Amosi, unaona nini? Nikasema, Naona timazi. Ndipo Bwana akasema, Tazama, nitaweka timazi kati ya watu wangu Israeli; sitawapita tena kamwe; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        },
