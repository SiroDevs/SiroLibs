              "items": [
                {
                  "text": "2 Fal 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Amazia, kuhani wa Betheli, akapeleka habari kwa Yeroboamu, mfalme wa Israeli, akisema, Amosi amefanya fitina juu yako kati ya nyumba ya Israeli; nchi haiwezi kustahimili maneno yake yote. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa maana Amosi asema hivi, Yeroboamu atakufa kwa upanga, na bila shaka Israeli atapelekwa uhamishoni, mbali na nchi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Amazia akamwambia Amosi, Ewe mwonaji, nenda zako, ikimbilie nchi ya Yuda, ukale mkate huko, ukatabiri huko; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.12"
              },
              "items": [
                {
                  "text": "Amo 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lakini usitabiri tena huku Betheli; kwa maana ni mahali patakatifu pa mfalme, nayo ni nyumba ya kifalme. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        },
        {
