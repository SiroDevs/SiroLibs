              "type": "text"
            }
          ]
        },
        {
          "text": "Haya ndiyo aliyonionesha; na tazama, Bwana alisimama karibu na ukuta uliojengwa kwa timazi, mwenye timazi mkononi mwake. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
