              },
              "items": [
                {
                  "text": "2 Fal 15:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na mahali palipoinuka pa Isaka patakuwa ukiwa, na mahali patakatifu pa Israeli pataharibika; nami nitaondoka nishindane na nyumba ya Yeroboamu kwa upanga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
