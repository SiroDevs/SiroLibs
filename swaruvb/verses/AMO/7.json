                  "text": "Mik 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, sasa lisikie neno la BWANA; Wewe unasema, Usitabiri juu ya Israeli, wala usitoe neno lako juu ya nyumba ya Isaka; ",
          "type": "text",
          "attrs": {
