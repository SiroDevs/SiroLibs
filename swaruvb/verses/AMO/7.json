        },
        {
          "text": "Haya ndiyo aliyonionesha Bwana MUNGU; tazama, Bwana MUNGU aliita ili kushindana kwa moto; nao ukaviteketeza vilindi vikuu, ukataka kuiteketeza nchi kavu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
