          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikasema, Ee Bwana MUNGU, acha, nakusihi; Yakobo atasimamaje? Kwa maana ni mdogo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
