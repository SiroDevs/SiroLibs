                  "text": "Zab 102:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akaghairi katika jambo hili pia. Jambo hili halitakuwa, asema Bwana MUNGU.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
