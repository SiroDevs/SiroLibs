              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilimwona Bwana akisimama karibu na madhabahu; akasema, Vipige vichwa vya nguzo, hata vizingiti vitikisike; vivunje vipande vipande juu ya kichwa cha kila mmoja wao; nami nitamwua mtu wa mwisho wao kwa upanga; hapana hata mmoja wao atakayekimbia, wala hataokoka hata mmoja wao. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
