            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.4"
              },
              "items": [
                {
                  "text": "Mik 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwa maana Bwana, MUNGU wa majeshi, ndiye aigusaye nchi, nayo ikayeyuka, na wote wakaao ndani yake wataomboleza; nayo itainuka yote pia kama Nili,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:5",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni Mto.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nayo itakupwa tena kama Mto wa Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye ndiye avijengaye vyumba vyake mbinguni, na kuweka misingi ya kuba yake juu ya nchi; yeye ndiye ayaitaye maji ya bahari, na kuyamwaga juu ya uso wa nchi; BWANA ndilo jina lake.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
