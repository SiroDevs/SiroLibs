                  "text": "16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Daudi akaja Yerusalemu nyumbani kwake; kisha mfalme akawatwaa wale wanawake kumi, masuria, aliowaacha kuitunza nyumba, akawatia nyumbani mwa kulindwa, akawalisha, ila asiingie kwao. Basi wakafungwa hadi siku ya kufa kwao, huku wakiishi hali ya ujane. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfalme akamwambia Amasa, Uwakusanye pamoja kwangu kwa siku tatu watu wa Yuda, na uwepo wewe hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa akaenda kuwakusanya watu wa Yuda; lakini akakawia zaidi ya huo muda aliowekewa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
