                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Daudi akamwambia Abishai, Sasa Sheba, mwana wa Bikri, atatudhuru, kuliko Absalomu; twaa wewe watumishi wa bwana wako, ukamfuatie, asiingie katika miji yenye boma, na kutuponyoka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
