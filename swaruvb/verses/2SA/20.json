                  "text": "Mit 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi wakapanda watu wote wa Israeli kutoka kumfuata Daudi, wakamfuata Sheba, mwana wa Bikri; lakini watu wa Yuda wakaambatana na mfalme wao, toka Yordani hadi Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
