                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa maana mimi sikukaa ndani ya nyumba, tangu siku ile niliyowatoa wana wa Israeli katika Misri, hata leo, lakini nimekaa katika hema na maskani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
