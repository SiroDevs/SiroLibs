          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa kuwa wewe, BWANA wa majeshi, Mungu wa Israeli umenifunulia mimi, mtumishi wako, ukisema, Nitakujengea nyumba; kwa hiyo mimi, mtumishi wako, nimepata ujasiri nikuombe ombi hili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
