                }
              ]
            }
          ]
        },
        {
          "text": " mfalme akamwambia Nathani, nabii, Angalia sasa, mimi ninakaa katika nyumba ya mierezi, bali sanduku la Mungu linakaa ndani ya mapazia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
