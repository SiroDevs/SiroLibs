                  "text": "Kum 26:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe ulijifanyia imara watu wako wa Israeli, wawe watu wako milele; nawe, BWANA, umekuwa Mungu wao. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
        {
          "name": "verse",
