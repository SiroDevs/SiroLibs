                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na sasa, Ee Bwana MUNGU, wewe ndiwe Mungu, na maneno yako ndiyo kweli, nawe umemwahidia mtumishi wako jambo hili jema ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
