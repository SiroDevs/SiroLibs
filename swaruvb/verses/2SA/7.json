          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "basi, sasa, uwe radhi, ukaibariki nyumba ya mtumishi wako, ipate kudumu milele mbele zako; kwa maana wewe, Ee Bwana MUNGU, umelinena na kwa baraka yako nyumba ya mtumishi wako na ibarikiwe milele.",
          "type": "text",
