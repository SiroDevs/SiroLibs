          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa, Ee BWANA Mungu, neno lile ulilolinena kuhusu mtumishi wako, na kuhusu nyumba yangu, uliimarishe milele, ukatende kama ulivyosema. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
