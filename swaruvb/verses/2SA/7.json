                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nathani akamwambia mfalme, Haya, fanya yote yaliyomo moyoni mwako; maana BWANA yuko pamoja nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa usiku uo huo, neno la BWANA likamfikia Nathani kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenda, ukamwambie mtumishi wangu, Daudi, BWANA asema hivi, Je! Wewe utanijengea nyumba, nikae ndani yake? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
