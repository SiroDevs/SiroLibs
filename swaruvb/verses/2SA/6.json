                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akacheza mbele za BWANA kwa nguvu zake zote; na Daudi alikuwa amevaa naivera ya kitani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
