            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.19"
              },
              "items": [
                {
                  "text": "1 Sam 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo hasira ya BWANA ikawaka juu ya Uza; naye Mungu akampiga huko kwa kosa lake; hata akafa pale pale penye sanduku la Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akaona uchungu kwa kuwa BWANA amemfurikia Uza; akapaita mahali pale Peres-uza",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:8",
              "type": "text"
            },
            {
              "text": "Kwa maana ya adhabu ya Uza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hata leo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
