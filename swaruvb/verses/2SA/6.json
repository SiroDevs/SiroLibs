              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1+1SA.7.2"
              },
              "items": [
                {
                  "text": "1 Sam 7:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.7.9"
              },
              "items": [
                {
                  "text": "Hes 7:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakaliweka sanduku la Mungu juu ya gari jipya, wakalitoa katika nyumba ya Abinadabu, iliyoko kilimani; nao Uza na Ahio wana wa Abinadabu wakaliendesha lile gari jipya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalitoa katika nyumba ya Abinadabu iliyoko kilimani, pamoja na sanduku la BWANA; na huyo Ahio akatangulia mbele ya sanduku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na nyumba yote ya Israeli wakacheza mbele za BWANA kwa nguvu zao zote, kwa nyimbo, na kwa vinubi, na kwa vinanda, na kwa matari, na kwa kayamba, na kwa matoazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.4.15"
              },
              "items": [
                {
                  "text": "Hes 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata walipofika kwenye uga wa Nakoni, Uza akalinyoshea mkono sanduku la Mungu, akalikamata kwa maana wale ng'ombe walijikwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
