        },
        {
          "text": " Naye Daudi akamwogopa BWANA siku ile; akasema, Litanijiaje sanduku la BWANA? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
