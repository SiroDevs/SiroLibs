              },
              "items": [
                {
                  "text": "Zab 80:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaondoka Daudi akaenda pamoja na watu wote waliokuwa naye, mpaka Baala wa Yuda, ili kulipandisha kutoka huko sanduku la Mungu lililoitwa kwa jina, naam, jina la BWANA wa majeshi akaaye juu ya makerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
