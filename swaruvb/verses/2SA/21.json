                "loc": "2SA.9.1+2SA.9.2+2SA.9.3+2SA.9.4+2SA.9.5+2SA.9.6+2SA.9.7"
              },
              "items": [
                {
                  "text": "2 Sam 9:1-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini mfalme akamwachilia Mefiboshethi, mwana wa Yonathani, mwana wa Sauli, kwa ajili ya kiapo cha BWANA kilichokuwa kati yao, yaani, kati ya Daudi na Yonathani, mwana wa Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
