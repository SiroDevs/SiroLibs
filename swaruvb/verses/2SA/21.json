              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye huyo alipowatukana Israeli, ndipo Yonathani, mwana wa Shimei, nduguye Daudi, akamwua.",
          "type": "text",
          "attrs": {
