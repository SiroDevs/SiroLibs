              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi kulikuwa na vita tena kati ya Wafilisti na Israeli; Daudi akashuka mpaka Gobu, na watumishi wake pamoja naye, akapigana na Wafilisti; naye Daudi akaishiwa na nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ishi-benobu, aliyekuwa mmoja wa Warefai,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:16",
              "type": "text"
            },
            {
              "text": "Au, wana wa majitu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ambaye uzito wa mkuki wake ulikuwa shekeli mia tatu za shaba kwa uzani, naye amejifungia upanga mpya, alijaribu kumwua Daudi. ",
          "type": "text",
