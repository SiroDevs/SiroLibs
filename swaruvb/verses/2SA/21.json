                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.7"
              },
              "items": [
                {
                  "text": "2 Sam 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ila mfalme akawatwaa hao wana wawili wa Rispa, binti Aya, aliomzalia Sauli, Armoni na Mefiboshethi; na wana watano wa Merabu binti Sauli, aliomzalia Adrieli, mwana wa Barzilai, Mmeholathi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
