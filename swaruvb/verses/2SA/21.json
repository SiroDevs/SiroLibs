                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.25"
              },
              "items": [
                {
                  "text": "2 Sam 24:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha wakaizika mifupa ya Sauli na ya Yonathani mwanawe katika nchi ya Benyamini, huko Zela, kaburini mwa Kishi babaye; wakafanya yote aliyoyaamuru mfalme. Na baadaye Mungu aliiridhia hiyo nchi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ushujaa wa jeshi la Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
