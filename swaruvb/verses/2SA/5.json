              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wakapanda hao Wafilisti tena mara ya pili, wakajitawanya bondeni mwa Warefai. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
        {
