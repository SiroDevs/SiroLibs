              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Daudi aliiteka ngome ya Sayuni; huu ndio mji wa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
