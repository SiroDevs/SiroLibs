                  "text": "Isa 28:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Daudi akaja Baal-perasimu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:20",
              "type": "text"
            },
            {
              "text": "Bwana apitaye katikati (yaani ashindaye).",
              "type": "text"
            }
          ]
        },
        {
          "text": " naye Daudi akawapiga huko; akasema, BWANA amewafurikia adui zangu mbele yangu, kama mafuriko ya maji. Basi akapaita mahali pale Baal-perasimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
