                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata maombolezo hayo yalipokwisha, Daudi akatuma mtu, akamtwaa, akamtia nyumbani mwake; naye akawa mkewe, akamzalia mtoto wa kiume.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.27",
