                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akamwambia Uria, Haya, shuka nyumbani kwako, ukanawe miguu yako. Basi Uria akatoka katika nyumba ya mfalme, na tunu ya vyakula ikamfuata, iliyotoka kwa mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.12+JOB.5.13+JOB.5.14"
              },
              "items": [
                {
                  "text": "Ayu 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini Uria akalala mlangoni pa nyumba ya mfalme, pamoja na watumishi wote wa bwana wake, wala hakushuka nyumbani kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
            "verseOrgIds": [
              "2SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu walipomwambia Daudi ya kwamba, Uria hakushuka nyumbani kwake, Daudi akamwambia Uria, Je! Hukutoka safarini? Mbona hukushuka nyumbani kwako? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        },
