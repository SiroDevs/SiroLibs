                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata ikawa asubuhi, Daudi akamwandikia Yoabu barua, akaituma kwa mkono wa Uria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.14",
            "verseOrgIds": [
              "2SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.9"
              },
              "items": [
                {
                  "text": "2 Sam 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaandika katika barua hiyo, akasema, Mwekeni Uria mbele ya watu penye vita vikali, kisha ondokeni, mmwache, ili apigwe akafe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, Yoabu alipokuwa akiuhusuru mji, akamweka Uria mahali alipojua ya kuwa pana mashujaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watu wa mji wakatoka, wakapigana na Yoabu; na baadhi ya watu, watumishi wa Daudi, wakaanguka; Uria, Mhiti, naye akafa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoabu akapeleka ujumbe na kumwarifu Daudi habari zote za vita; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamwagiza yule mjumbe, akisema, Ukiisha kumpa mfalme habari zote za vita, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisha, ikiwa hasira ya mfalme itawaka, akakuambia, Kwa nini mliukaribia mji namna ile ili kuupiga? Je! Hamkujua ya kuwa watapiga mishale toka ukutani? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.53"
              },
              "items": [
                {
                  "text": "Amu 9:53",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.21"
              },
              "items": [
                {
                  "text": "2 Sam 20:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.3"
              },
              "items": [
                {
                  "text": "Ayu 31:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni nani aliyempiga Ahimeleki, mwana wa Yeru-beshethi? Je! Si mwanamke aliyemtupia jiwe la kusagia la juu kutoka ukutani? Hata akafa huko Thebesi? Kwa nini mliukaribia ukuta namna ile? Ndipo utakaposema, Mtumishi wako Uria, Mhiti, amekufa naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
      ]
