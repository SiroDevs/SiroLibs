        },
        {
          "text": " Basi Daudi akaja Mahanaimu. Naye Absalomu akauvuka Yordani yeye na watu wote wa Israeli pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
