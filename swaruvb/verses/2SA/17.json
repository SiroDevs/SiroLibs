                "loc": "1KI.1.9"
              },
              "items": [
                {
                  "text": "1 Fal 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Yonathani na Ahimaasi walikuwa wakikaa karibu na Enrogeli; na mjakazi mmoja alikuwa akienda na kuwapa habari; ndipo wakamwambie mfalme Daudi; maana ilikuwa lazima wasionekane wakiingia mjini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.16"
              },
              "items": [
                {
                  "text": "2 Sam 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.5"
              },
              "items": [
                {
                  "text": "16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini kijana mmoja aliwaona, akamwambia Absalomu; basi wakaenda wote wawili kwa haraka, wakafika Bahurimu, nyumbani kwa mtu aliyekuwa na kisima uani mwake; wakashuka ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.6"
              },
              "items": [
                {
                  "text": "Yos 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mwanamke akatwaa kifuniko akakiweka juu ya mdomo wa kile kisima, akaanika ngano iliyotwangwa juu yake; wala halikujulikana neno lolote. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.19",
            "verseOrgIds": [
              "2SA.17.19"
            ]
          }
        },
