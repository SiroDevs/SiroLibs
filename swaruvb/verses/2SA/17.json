                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nami nitamshambulia wakati atakaokuwa amechoka, na mikono yake imekuwa dhaifu, nami nitamtia hofu; na watu wote walio pamoja naye watakimbia; nami nitampiga mfalme peke yake; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.2",
            "verseOrgIds": [
              "2SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
