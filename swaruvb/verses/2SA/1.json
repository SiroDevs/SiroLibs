        {
          "text": " Ndipo Daudi akashika nguo zake akazirarua na kadhalika watu wote waliokuwa pamoja naye; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
