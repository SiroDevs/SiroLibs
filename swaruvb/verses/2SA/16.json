            "number": "6",
            "style": "v",
            "sid": "2SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena akamtupia Daudi mawe, na watumishi wote wa mfalme Daudi; na watu wote na mashujaa wote walikuwako mkono wake wa kulia na mkono wake wa kushoto. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Shimei alipolaani, alisema hivi, Nenda zako! Nenda zako! Ewe mtu wa damu! Ewe mtu usiyefaa! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
