        },
        {
          "text": " Labda BWANA atayaangalia mabaya yaliyonipata, naye BWANA atanilipa mema kwa sababu ya kunilaani kwake leo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakaendelea njiani Daudi na watu wake; Shimei naye akaaendelea juu ya ubavu wa kile kilima, kwa kumkabili, huku akiendelea, akilaani, akimtupia mawe, na kurusha mavumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme na watu wake wote waliokuwa pamoja naye wakafika, wakiwa wamechoka sana; naye akajiburudisha huko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
