                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni ishara kati ya mimi na wana wa Israeli milele; kwani kwa siku sita BWANA alifanya mbingu na nchi, akapumzika kwa siku ya saba na kustarehe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
