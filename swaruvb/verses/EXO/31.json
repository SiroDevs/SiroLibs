              "items": [
                {
                  "text": "1 Nya 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Angalia, nimemwita kwa jina lake Bezaleli mwana wa Uri, mwana wa Huri, wa kabila la Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.2",
            "verseOrgIds": [
              "EXO.31.2"
            ]
          }
        },
