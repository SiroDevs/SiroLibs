                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kazi itafanywa siku sita; lakini siku ya saba ni Sabato ya kustarehe kabisa, takatifu kwa BWANA; kila mtu atakayefanya kazi yoyote katika siku ya Sabato, hana budi atauawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ajili ya hayo wana wa Israeli wataishika Sabato, kuiangalia sana hiyo Sabato katika vizazi vyao vyote, ni agano la milele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
