                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.4+1CO.12.5+1CO.12.6+1CO.12.7+1CO.12.8"
              },
              "items": [
                {
                  "text": "1 Kor 12:4-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nami nimemjaza Roho ya Mungu, katika hekima, na maarifa, na ujuzi, na mambo ya kazi ya kila aina, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili abuni kazi za ustadi, kuwa fundi wa dhahabu, na wa fedha, na wa shaba, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kukata vito kwa kutiwa mahali, na kuchora miti, na kufanya kazi ya ustadi iwayo yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.35.34"
              },
              "items": [
                {
                  "text": "Kut 35:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.3"
              },
              "items": [
                {
                  "text": "28:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.36.1"
              },
              "items": [
                {
                  "text": "36:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena, tazama, nimemchagua, awe pamoja naye, huyo Oholiabu, mwana wa Ahisamaki, wa kabila la Dani; nami nimetia hekima katika mioyo ya wote wenye moyo wa hekima, ili wapate kutengeneza vyote nilivyokuagiza; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.36.8"
              },
              "items": [
                {
                  "text": "Kut 36:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " yaani, hema ya kukutania na sanduku la ushuhuda, na kiti cha rehema kilicho juu yake, na vyombo vyote vya Hema; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na meza, na vyombo vyake, na kinara cha taa safi pamoja na vyombo vyake vyote, na madhabahu ya kufukizia uvumba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na madhabahu ya sadaka ya kuteketezwa na vyombo vyake vyote, na birika na kitako chake; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mavazi yenye kufumwa kwa uzuri, na mavazi matakatifu ya Haruni kuhani, na mavazi ya wanawe, ili kutumika kwa ajili ya huduma yao ya ukuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mafuta ya kutiwa, na uvumba wa manukato mazuri, kwa ajili ya mahali patakatifu; sawasawa na yote niliyokuagiza ndivyo watakavyofanya wao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
      ]
    },
