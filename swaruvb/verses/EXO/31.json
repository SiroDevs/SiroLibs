              },
              "items": [
                {
                  "text": "44:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha, nena na wana wa Israeli, na kuwaambia, Hakika mtazishika Sabato zangu, kwa kuwa ni ishara kati yenu na mimi katika vizazi vyenu vyote; ili mpate kujua ya kuwa mimi ndimi BWANA niwatakasaye ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
