                  "text": "Kut 33:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akaondoka na Yoshua, mtumishi wake, Musa akapanda mlimani kwa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawaambia hao wazee, Tungojeeni hapa, mpaka tutakaporudi kwenu; na tazameni, Haruni na Huri wapo pamoja nanyi; kila mtu aliye na jambo na awaendee. ",
