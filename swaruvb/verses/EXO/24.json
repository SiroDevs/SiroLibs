              "items": [
                {
                  "text": "10:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akaitwaa ile damu, akawanyunyizia watu, akasema, Hii ndiyo damu ya agano alilolifanya BWANA pamoja nanyi katika maneno haya yote.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
