            "number": "7",
            "style": "v",
            "sid": "EXO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akakitwaa Kitabu cha Agano akakisoma masikioni mwa watu; wakasema, Hayo yote aliyoyanena BWANA tutayatenda, nasi tutatii. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.7",
            "verseOrgIds": [
              "EXO.24.7"
            ]
          }
        },
