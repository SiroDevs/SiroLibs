                "loc": "HEB.9.18"
              },
              "items": [
                {
                  "text": "Ebr 9:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akatwaa nusu ya ile damu, akaitia katika mabakuli; na nusu ya ile damu akainyunyiza juu ya madhabahu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.6",
            "verseOrgIds": [
              "EXO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
