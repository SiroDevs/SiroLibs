                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha BWANA akamwambia Musa, Kweeni wewe, na Haruni, na Nadabu, na Abihu, na watu sabini wa wazee wa Israeli, mkamfikie BWANA; mkasujudie kwa mbali; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Musa peke yake ndiye atakayekaribia karibu na BWANA; lakini hao hawatakaribia karibu; wala hao watu hawatakwea pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akaenda akawaambia watu maneno yote ya BWANA, na hukumu zake zote; watu wote wakajibu kwa sauti moja, wakasema, Maneno yote aliyoyanena BWANA tutayatenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.9"
              },
              "items": [
                {
                  "text": "Kum 31:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.18"
              },
              "items": [
                {
                  "text": "Mwa 28:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.45"
              },
              "items": [
                {
                  "text": "31:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Musa akayaandika maneno yote ya BWANA, akaondoka asubuhi na mapema, akajenga madhabahu chini ya mlima, na nguzo kumi na mbili, kwa hesabu ya makabila kumi na mawili ya Israeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akapeleka vijana wa wana wa Israeli, waliotoa sadaka za kuteketezwa, wakamchinjia BWANA sadaka za amani za ng'ombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.5",
            "verseOrgIds": [
              "EXO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
