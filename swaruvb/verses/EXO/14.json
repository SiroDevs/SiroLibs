                  "text": "Isa 41:10-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akawaambia watu, Msiogope, simameni tu, mkauone wokovu wa BWANA atakaowafanyia leo; kwa maana hao Wamisri mliowaona leo hamtawaona tena milele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
