              },
              "items": [
                {
                  "text": "Kut 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe inua fimbo yako, ukanyoshe mkono wako juu ya bahari, na kuigawanya; nao wana wa Israeli watapita kati ya bahari katika nchi kavu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.16",
            "verseOrgIds": [
              "EXO.14.16"
            ]
          }
        },
