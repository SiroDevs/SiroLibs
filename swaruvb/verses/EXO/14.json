                "loc": "JER.44.1"
              },
              "items": [
                {
                  "text": "Yer 44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waambie wana wa Israeli, kwamba warudi na kupiga kambi yao mbele ya Pi-hahirothi, kati ya Migdoli na bahari, kukabili Baal-sefoni; mtapanga mbele yake karibu na bahari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.2",
            "verseOrgIds": [
              "EXO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.21"
              },
              "items": [
                {
                  "text": "Zab 35:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.11"
              },
              "items": [
                {
                  "text": "71:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Farao atasema katika habari za wana wa Israeli, Wametatanishwa katika nchi, lile jangwa limewazuia wasitoke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.3",
            "verseOrgIds": [
              "EXO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.13+JAS.1.14+JAS.1.15+JAS.1.16+JAS.1.17"
              },
              "items": [
                {
                  "text": "Yak 1:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.16"
              },
              "items": [
                {
                  "text": "Kut 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.17+ROM.9.18+ROM.9.19+ROM.9.20+ROM.9.21+ROM.9.22+ROM.9.23"
              },
              "items": [
                {
                  "text": "Rum 9:17-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami nitaufanya uwe mgumu moyo wa Farao, naye atafuata nyuma yao; nami nitajipatia utukufu kwa Farao, na kwa jeshi lake lote; na Wamisri watajua ya kuwa mimi ndimi BWANA. Basi wakafanya hivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Misri aliambiwa ya kuwa wale watu wamekwisha kimbia; na moyo wa Farao, na mioyo ya watumishi wake, iligeuzwa iwe kinyume cha hao watu, nao wakasema, Ni nini jambo hili tulilotenda, kwa kuwaacha Waisraeli waende zao wasitutumikie tena? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.5",
            "verseOrgIds": [
              "EXO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaandaa gari lake, akawachukua watu wake pamoja naye; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.6",
            "verseOrgIds": [
              "EXO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tena akatwaa magari mia sita yaliyochaguliwa, na magari yote ya Wamisri, na maofisa wa kijeshi juu ya magari hayo yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.7",
            "verseOrgIds": [
              "EXO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.1"
              },
              "items": [
                {
                  "text": "Kut 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.9"
              },
              "items": [
                {
                  "text": "13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.3"
              },
              "items": [
                {
                  "text": "Hes 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na BWANA akaufanya moyo wake Farao mfalme wa Misri kuwa mgumu, naye akawafuata wana wa Israeli; kwa sababu wana wa Israeli walitoka kwa jeuri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:8",
              "type": "text"
            },
            {
              "text": "Katika tafsiri nyingine ni ‘ushupavu au ulinzi wa BWANA’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.9"
              },
              "items": [
                {
                  "text": "Kut 15:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.6"
              },
              "items": [
                {
                  "text": "Yos 24:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wamisri wakafuata nyuma yao, farasi wote na magari yote ya Farao, na askari zake wenye kupanda farasi, na jeshi lake, nao wakawapata wakiwa wamepanga pale karibu na bahari, karibu na Pi-hahirothi, kukabili Baal-sefoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.9",
            "verseOrgIds": [
              "EXO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 14:10"
          },
          "items": [
