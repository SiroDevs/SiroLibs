              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akamwambia Musa, Mbona unanililia mimi? Waambie wana wa Israeli waendelee mbele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
