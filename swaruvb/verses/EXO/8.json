              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akatoka kwa Farao, akamwomba BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
