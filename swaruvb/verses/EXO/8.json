        },
        {
          "text": " BWANA akamwambia Musa, Ingia kwa Farao, ukamwambie, BWANA asema hivi, Wape watu wangu ruhusa, ili wapate kunitumikia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
