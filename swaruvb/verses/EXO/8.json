        },
        {
          "text": "BWANA akamwambia Musa, Mwambie Haruni, Nyosha fimbo yako, ukayapige mavumbi ya nchi, ili kwamba yawe chawa katika nchi yote ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
