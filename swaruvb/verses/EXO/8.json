            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.29"
              },
              "items": [
                {
                  "text": "Mit 21:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini Farao alipoona ya kuwa pana nafuu, akaufanya moyo wake kuwa mzito, asiwasikize; kama BWANA alivyonena.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
