              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " BWANA akamwambia Musa, Inuka asubuhi na mapema usimame mbele ya Farao; angalia! Atoka aende majini; kamwambie, BWANA asema, Wape watu wangu ruhusa waende zao, ili wanitumikie mimi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
