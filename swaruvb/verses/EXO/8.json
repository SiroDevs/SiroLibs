        },
        {
          "text": " Akamwambia, Kesho, Akasema, Na yawe kama neno lako; ili upate kujua ya kwamba hapana mwingine mfano wa BWANA, Mungu wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao vyura wataondoka kutoka kwako wewe na nyumba zako, na watumishi wako, na watu wako; watasalia mtoni tu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
