          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao akawaita Musa na Haruni akawaambia, Endeni mkamtolee Mungu wenu dhabihu ndani ya nchi hii. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
