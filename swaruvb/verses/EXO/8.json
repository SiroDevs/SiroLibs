            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:23",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ‘nami nitaweka ukombozi’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kati ya watu wangu na watu wako; ishara hiyo italetwa kesho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
