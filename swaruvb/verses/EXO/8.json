                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Musa na Haruni wakatoka kwa Farao; Musa akamlilia BWANA katika jambo la hao vyura aliokuwa amewaleta juu ya Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akafanya sawasawa na neno la Musa; na hao vyura wakafa kutoka katika zile nyumba, na katika viwanja, na katika mashamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawakusanya marundo marundo; na nchi ikatoa uvundo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
