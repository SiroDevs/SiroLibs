          ]
        },
        {
          "text": " Nami siku hiyo nitatenga nchi ya Gosheni, watu wangu wanayokaa, ili hao inzi wasiwe huko; ili kwamba upate kujua wewe ya kuwa mimi ndimi BWANA kati ya dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
