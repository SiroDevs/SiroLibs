          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitatia mpaka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
