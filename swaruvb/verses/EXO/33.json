                  "text": "Kum 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " waifikie nchi imiminikayo maziwa na asali; kwa maana mimi sitakwenda kati yenu; kwa sababu ninyi ni watu wenye shingo ngumu; nisiwaangamize ninyi katika njia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
