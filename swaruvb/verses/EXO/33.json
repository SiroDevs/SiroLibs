                "loc": "2SA.19.24"
              },
              "items": [
                {
                  "text": "2 Sam 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watu waliposikia habari hizo mbaya wakaomboleza wala hakuna mtu aliyevaa mapambo yake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
