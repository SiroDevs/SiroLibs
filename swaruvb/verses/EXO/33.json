              },
              "items": [
                {
                  "text": "Hes 16:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata Musa alipotoka kuiendea ile hema, watu wote waliondoka wakasimama, kila mtu mlangoni pa hema yake, akamtazama Musa, hata alipokwisha kuingia hemani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
