              "items": [
                {
                  "text": "1 Sam 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakati huo Waamaleki wakatokea, wakapigana na Israeli huko Refidimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 17:9"
          },
          "items": [
