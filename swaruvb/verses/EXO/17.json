              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.45"
              },
              "items": [
                {
                  "text": "Mdo 7:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.8"
              },
              "items": [
                {
                  "text": "Ebr 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akamwambia Yoshua, Tuchagulie watu, uende ukapigane na Waamaleki; kesho nitasimama juu ya kilele kile, na ile fimbo ya Mungu nitakuwa nayo mkononi mwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoshua akafanya kama Musa alivyomwambia, akapigana na Amaleki; na Musa na Haruni na Huri wakapanda juu ya kile kilima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa, Musa alipouinua mkono wake, Israeli walishinda; na alipoushusha mkono wake, Amaleki walishinda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mikono ya Musa ililegea; basi wakatwaa jiwe, wakaliweka chini yake akalikalia. Haruni na Huri wakaitengemaza mikono yake, mmoja upande huu na mmoja upande huu; mikono yake ikathibitika hata jua lilipokuchwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua akawaangamiza Amaleki na watu wake kwa ukali wa upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        },
