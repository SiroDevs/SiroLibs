              },
              "items": [
                {
                  "text": "10:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akamlilia BWANA, akisema, Niwatendee nini watu hawa? Bado kidogo nao watanipiga kwa mawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
