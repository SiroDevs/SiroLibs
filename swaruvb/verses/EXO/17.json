              "items": [
                {
                  "text": "Ebr 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akapaita mahali pale jina lake Masa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:7",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni ‘jaribu’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na Meriba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:7",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni ‘kunung'unika’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwa sababu ya ugomvi wa wana wa Israeli, na kwa sababu walimjaribu BWANA, wakisema, Je! BWANA yu kati yetu au sivyo?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
