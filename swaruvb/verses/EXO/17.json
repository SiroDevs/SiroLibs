              "items": [
                {
                  "text": "Hes 20:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akamwambia Musa, Pita mbele ya watu, ukawachukue baadhi ya wazee wa Israeli pamoja nawe; na ile fimbo yako ambayo uliupiga mto kwayo, uitwae mkononi mwako, ukaende. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
