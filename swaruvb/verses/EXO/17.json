                "loc": "1CO.10.4"
              },
              "items": [
                {
                  "text": "1 Kor 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, nitasimama mbele yako huko, juu ya lile jabali katika Horebu; nawe utalipiga jabali, na maji yatatoka, watu wapate kunywa. Musa akafanya hivyo mbele ya wazee wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
