            }
          ]
        },
        {
          "text": " Malaika wa BWANA akamtokea, katika mwali wa moto uliotoka katikati ya kichaka; akatazama, na kumbe! Kile kichaka kiliwaka moto, nacho kichaka hakikuteketea. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
