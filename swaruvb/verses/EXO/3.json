              "items": [
                {
                  "text": "Zab 111:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa akasema, Nitageuka sasa niende nione kioja hiki, kwa nini kichaka hiki hakiteketei. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
              "EXO.3.3"
            ]
          }
