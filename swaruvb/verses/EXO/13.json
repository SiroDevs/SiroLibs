        },
        {
          "text": " Musa akawaambia hao watu, Kumbukeni siku hii, mliyotoka nchi ya Misri, kutoka nyumba ya utumwa; kwa kuwa BWANA aliwatoa mahali hapa kwa nguvu za mkono wake; na usiliwe mkate uliochachwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
