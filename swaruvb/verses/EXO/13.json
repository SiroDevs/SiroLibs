                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kila mzaliwa wa kwanza wa punda utamkomboa kwa mwana-kondoo; na kama hutaki kumkomboa, utamwua;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
