                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ndipo utamwekea BWANA kila afunguaye tumbo, na kila mzaliwa wa kwanza uliye naye, azaliwaye na mnyama; hao wa kiume watakuwa ni wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
