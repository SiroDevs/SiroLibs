            {
              "text": "13:13",
              "type": "text"
            },
            {
              "text": "Katika Kiebrania ni: kuvunja shingo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na kila mzaliwa wa kwanza wa binadamu katika wanao utamkomboa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
