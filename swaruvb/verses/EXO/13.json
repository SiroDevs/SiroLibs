                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Itakuwa hapo BWANA atakapokuleta katika nchi ya Wakanaani, kama alivyokuapia wewe na baba zako, na kukupa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
