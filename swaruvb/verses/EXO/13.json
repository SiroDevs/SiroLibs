              "items": [
                {
                  "text": "Kum 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ninyi mwatoka leo katika mwezi wa Abibu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itakuwa hapo BWANA atakapowaleta mpaka nchi ya Wakanaani, na Wahiti, na Waamori, na Wahivi, na Wayebusi, nchi hiyo aliyowaapia baba zako kwamba atakupa wewe, ni nchi imiminikayo maziwa na asali, ndipo mtakapoushika utumishi huu katika mwezi huu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.15"
              },
              "items": [
                {
                  "text": "Kut 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtakula mikate isiyochachwa muda wa siku saba, nayo siku ya saba itakuwa ni sikukuu ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikate isiyochachwa italiwa katika hizo siku saba; mkate uliotiwa chachu usionekane kwako, wala chachu isionekane kwako, ndani ya mipaka yako yote. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.7",
            "verseOrgIds": [
              "EXO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.1"
              },
              "items": [
                {
                  "text": "Zab 44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe utamwambia mwanao siku hiyo, ukisema, Ni kwa sababu ya hayo BWANA aliyonifanyia hapo nilipotoka Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
