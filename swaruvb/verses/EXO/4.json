            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.9"
              },
              "items": [
                {
                  "text": "Zab 94:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akamwambia, Ni nani aliyekifanya kinywa cha mwanadamu? Au ni nani afanyaye mtu kuwa bubu au kiziwi, au mwenye kuona, au kuwa kipofu? Si mimi, BWANA? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
