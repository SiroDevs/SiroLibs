              "items": [
                {
                  "text": "2 Fal 5:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akamwambia tena, Sasa tia mkono wako kifuani mwako. Akautia mkono wake kifuani mwake; naye alipoutoa, kumbe! Mkono wake ulikuwa una ukoma, umekuwa mweupe kama theluji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        },
