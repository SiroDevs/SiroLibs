              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Kut 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha itakuwa wasipoamini hata ishara hizo mbili, wala kuisikiliza sauti yako, basi, yatwae maji ya mtoni uyamwage juu ya nchi kavu, na yale maji uyatwaayo mtoni yatakuwa damu juu ya nchi kavu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
