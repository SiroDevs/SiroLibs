                  "text": "Yon 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema, Ee Bwana, nakuomba, tuma kwa mkono wake huyo utakayemtuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
