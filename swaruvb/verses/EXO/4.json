          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe utatwaa fimbo hii mkononi mwako, na kwa hiyo utazifanya zile ishara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
