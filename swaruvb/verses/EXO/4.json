                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi sasa, nenda, nami nitakuwa pamoja na kinywa chako, na kukufundisha utakalolinena. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
