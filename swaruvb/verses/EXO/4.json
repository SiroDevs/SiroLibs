                "loc": "EXO.19.9"
              },
              "items": [
                {
                  "text": "Kut 19:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ili kwamba wapate kusadiki ya kwamba BWANA, Mungu wa Abrahamu, Mungu wa Isaka, Mungu wa Yakobo, amekutokea. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        },
