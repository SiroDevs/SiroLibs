              "items": [
                {
                  "text": "18:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye atakuwa msemaji wako kwa watu, hata yeye atakuwa mfano wa kinywa kwako, nawe utakuwa mfano wa Mungu kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
