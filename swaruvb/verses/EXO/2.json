                "loc": "1CH.23.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtu mmoja wa nyumba ya Lawi akaenda akaoa binti mmoja wa Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.20"
              },
              "items": [
                {
                  "text": "Mdo 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.23"
              },
              "items": [
                {
                  "text": "Ebr 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yule mwanamke akachukua mimba akazaa mwana, na alipoona ya kuwa ni mtoto mzuri akamficha miezi mitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na alipokuwa hawezi kumficha tena, akamtengenezea kikapu cha mafunjo akakitaliza kwa sifa na lami, akamtia mtoto ndani yake, akakiweka kwenye nyasi kando ya mto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kut 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Hes 26:59",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dada yake mtoto akasimama mbali ili ajue yatakayompata. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Mdo 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi binti Farao akashuka, aoge mtoni, na vijakazi wake wakatembea kando ya mto; naye akakiona kile kikapu katika nyasi, akamtuma kijakazi wake kwenda kukileta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.5",
            "verseOrgIds": [
              "EXO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakifungua, akamwona mtoto, na tazama, mtoto yule analia. Basi akamhurumia, akasema, Huyu ni mmojawapo wa watoto wa Waebrania. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.6",
            "verseOrgIds": [
              "EXO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi dada yake mtoto akamwambia binti Farao, Je! Niende nikamwite mlezi katika wanawake wa Kiebrania, aje kwako, akunyonyeshee mtoto huyu? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.7",
            "verseOrgIds": [
              "EXO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binti Farao akamwambia, Haya! Nenda. Yule kijana akaenda akamwita mama yake yule mtoto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.8",
            "verseOrgIds": [
              "EXO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binti Farao akamwambia, Mchukue mtoto huyu, ukaninyonyeshee, nami nitakupa mshahara wako. Yule mwanamke akamtwaa mtoto, akamnyonyesha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.9",
            "verseOrgIds": [
              "EXO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Mdo 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtoto akakua, naye akamleta kwa binti Farao, akawa mwanawe. Akamwita jina lake Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:10",
              "type": "text"
            },
            {
              "text": "Jina hili Musa katika Kiebrania ni ‘Mosheh’. Linatokana na neno ‘mashah’ kwa maana ya ‘kutoa’. Katika lugha ya Kimisri neno Musa ni ‘kupata mtoto’, akasema, Kwa sababu nilimtoa majini.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa akimbilia Midiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.24"
              },
              "items": [
                {
                  "text": "Ebr 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hata siku zile, Musa alipokuwa mtu mzima, akatoka kuwaendea ndugu zake, akatazama mizigo yao. Akamwona Mmisri anampiga Mwebrania, mmojawapo wa ndugu zake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.23+ACT.7.24+ACT.7.25+ACT.7.26+ACT.7.27+ACT.7.28"
              },
              "items": [
                {
                  "text": "Mdo 7:23-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akatazama huku na huko, na alipoona ya kuwa hapakuwapo mtu, akampiga na kumwua Mmisri yule, akamfukia mchangani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatoka siku ya pili, na tazama, watu wawili wa Waebrania walikuwa wakipigana. Akamwambia yule aliyemdhulumu mwenzake, Mbona unampiga mwenzako? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yule akasema, Ni nani aliyekuweka wewe kuwa mkuu wetu, na mwamuzi juu yetu? Je! Wataka kuniua kama ulivyomwua yule Mmisri? Musa akaogopa, akasema, Kumbe! Jambo lile limejulikana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.14",
            "verseOrgIds": [
              "EXO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Mdo 7:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.27"
              },
              "items": [
                {
                  "text": "Ebr 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.11"
              },
              "items": [
                {
                  "text": "Mwa 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.2"
              },
              "items": [
                {
                  "text": "29:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Farao alipopata habari, akataka kumwua Musa; lakini Musa akakimbia kutoka kwa Farao, akakaa katika nchi ya Midiani; akaketi karibu na kisima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.1"
              },
              "items": [
                {
                  "text": "Kut 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.10"
              },
              "items": [
                {
                  "text": "Mwa 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.9.11"
              },
              "items": [
                {
                  "text": "1 Sam 9:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi kuhani wa Midiani alikuwa na binti saba, nao wakaja wakateka maji, wakazijaza birika maji, wapate kunywesha kundi la baba yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.16",
            "verseOrgIds": [
              "EXO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachungaji wakaja wakawafukuza; lakini Musa akasimama, akawasaidia, akalinywesha kundi lao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
              "EXO.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.29"
              },
              "items": [
                {
                  "text": "Hes 10:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walipofika kwa Reueli",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:18",
              "type": "text"
            },
            {
              "text": "Reueli kwa jina jingine aliitwa Yethro, kuhani wa Midiani baba yake Sipora, mkewe Musa. Reueli kwa Kiebrania ni ‘rafiki wa Mungu’ (Kut 2:21; 3:1; 4:18; 18:1-27).",
              "type": "text"
            }
          ]
        },
        {
          "text": " baba yao, akasema, Imekuwaje hata mkarejea mapema leo? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 2:19"
          },
