              },
              "items": [
                {
                  "text": "Kum 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.18"
              },
              "items": [
                {
                  "text": "1 Kor 10:18",
