              },
              "items": [
                {
                  "text": "Lk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sasa najua ya kuwa BWANA ni mkuu kuliko miungu yote; naam, katika jambo hilo walilowatenda kwa ujeuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
