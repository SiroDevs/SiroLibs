              "items": [
                {
                  "text": "Hes 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wakiwa na neno, hunijia; nami naamua kati ya mtu na mwenziwe, nami nawajulisha amri za Mungu, na sheria zake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkwewe Musa akamwambia, Jambo hili ufanyalo si jema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
