                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa kweli utajidhoofisha mwenyewe, na hawa watu walio pamoja nawe pia; maana jambo hili ni zito mno kwako; huwezi wewe kulitenda peke yako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
