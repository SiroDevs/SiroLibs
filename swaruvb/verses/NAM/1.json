            "number": "2",
            "style": "v",
            "sid": "NAM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA ni Mungu mwenye wivu, naye hujilipiza kisasi; BWANA hujilipiza kisasi, naye ni mwingi wa hasira; BWANA hujilipiza kisasi juu ya adui zake, huwawekea adui zake akiba ya hasira. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
