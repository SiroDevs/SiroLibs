                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Isa 52:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tazama, juu ya milima iko miguu yake aletaye habari njema, atangazaye amani. Zishike sikukuu zako, Ee Yuda, uziondoe nadhiri zako; kwa maana yule asiyefaa kitu hatapita kati yako tena kamwe; amekwisha kukatiliwa mbali.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.15",
            "verseOrgIds": [
              "NAM.1.15"
            ]
          }
        }
      ]
