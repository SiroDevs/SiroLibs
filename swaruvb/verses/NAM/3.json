              "items": [
                {
                  "text": "Ufu 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Watu wako waliotiwa taji ni kama nzige, na majemadari wako ni kama makundi ya mapanzi, watuao katika vitalu siku ya baridi, lakini jua lipandapo huruka juu na kwenda zao, wala hapana ajuaye walikokwenda.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        }
      ]
