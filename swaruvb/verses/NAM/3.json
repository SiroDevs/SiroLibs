              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umeongeza wafanya biashara wako kuwa wengi kuliko nyota za mbinguni; tunutu huharibu; kisha huruka juu na kwenda zake. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.16",
            "verseOrgIds": [
              "NAM.3.16"
            ]
          }
        },
        {
