                "loc": "ISA.47.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, mimi ni juu yako, asema BWANA wa majeshi; nami nitayainua marinda yako mbele ya uso wako; nami nitawaonesha mataifa uchi wako, na falme aibu yako. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitatupa uchafu uchukizao juu yako, kukufanya uwe mchafu, nami nitakufanya kuwa kitu cha kutazamwa kwa dharau. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata itakuwa, wote wakutazamao watakukimbia, wakisema, Ninawi umeharibika; ni nani atakayeuhurumia? Nikutafutie wapi wafariji?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
