                {
                  "text": "Isa 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.37"
              },
              "items": [
                {
                  "text": "Yer 50:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tazama, watu wako walio ndani yako ni wanawake; malango ya nchi yako yamekuwa wazi kabisa mbele ya adui zako; moto umeteketeza mapingo yako.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.13",
            "verseOrgIds": [
              "NAM.3.13"
            ]
          }
        }
