              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa sababu ya wingi wa ukahaba wa yule kahaba mzuri, yule bibi wa mambo ya uchawi, auzaye mataifa kwa ukahaba wake, na jamaa za watu kwa uchawi wake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
