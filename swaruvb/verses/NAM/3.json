          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ole wake mji wa damu! Umejaa mambo ya uongo na unyang'anyi; mateka hayaondoki. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelele za mjeledi, kelele za magurudumu yafanyayo kishindo; na farasi wenye kuparapara, na magari ya vita yenye kurukaruka; ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpanda farasi akipanda, na upanga ukimetameta, na mkuki ukimeremeta; na wingi wa waliouawa, na rundo kubwa la mizoga; mizoga isiyo na mwisho; wanajikwaa juu ya mizoga yao. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
