                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Asiwepo mwasherati wala asiyemcha Mungu, kama Esau, aliyeuuza urithi wake wa mzaliwa wa kwanza kwa ajili ya chakula kimoja. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
