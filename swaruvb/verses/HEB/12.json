                "loc": "LUK.2.34"
              },
              "items": [
                {
                  "text": "Lk 2:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana mtafakarini sana yeye aliyeyastahimili upinzani mkuu namna hii ya watendao dhambi juu ya nafsi zao, msije mkachoka, mkizimia mioyoni mwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.3",
            "verseOrgIds": [
              "HEB.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamjafanya vita hata kumwagika damu, mkishindana na dhambi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
            "verseOrgIds": [
              "HEB.12.4"
            ]
          }
        },
