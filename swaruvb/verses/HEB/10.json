              "items": [
                {
                  "text": "Efe 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na tukaribie wenye moyo wa kweli, kwa utimilifu wa imani, hali tumenyunyiziwa mioyo tuache dhamiri mbaya, tumeoshwa miili kwa maji safi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
