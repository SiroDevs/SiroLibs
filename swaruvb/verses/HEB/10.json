              "items": [
                {
                  "text": "7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi torati, kwa kuwa ni kivuli cha mema yatakayokuwa, wala si sura yenyewe ya mambo hayo, kwa dhabihu zile zile wanazozitoa kila mwaka daima, haiwezi wakati wowote kuwakamilisha wakaribiao. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ndivyo, je! Dhabihu hazingekoma kutolewa; kwa maana waabuduo, wakiisha kusafishwa mara moja, wasingejiona tena kuwa na dhambi? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.21"
              },
              "items": [
                {
                  "text": "Law 16:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini katika dhabihu hizo liko kumbukumbu la dhambi kila mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana haiwezekani damu ya mafahali na mbuzi kuondoa dhambi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.40.6+PSA.40.7+PSA.40.8"
              },
              "items": [
                {
                  "text": "Zab 40:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo alipokuja ulimwenguni, alisema,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
