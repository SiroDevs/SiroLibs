                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " awezaye kuwachukulia kwa upole wao wasiojua na wenye kupotea, kwa kuwa yeye mwenyewe ana udhaifu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
