                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa ajili hii Yesu naye, ili awatakase watu kwa damu yake mwenyewe, aliteswa nje ya lango. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
