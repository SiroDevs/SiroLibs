        },
        {
          "text": " Basi, ikiwa ingalipo ahadi ya kuingia katika pumziko lake, na tuogope, mmoja wenu asije akaonekana ameikosa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
