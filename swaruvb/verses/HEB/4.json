            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana ni kweli, sisi nasi tumehubiriwa Habari Njema vile vile kama hao. Lakini neno lile lililosikiwa halikuwafaa hao, kwa sababu halikuchanganyika na imani ndani yao waliosikia. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
