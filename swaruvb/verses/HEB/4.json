                "loc": "PSA.95.11"
              },
              "items": [
                {
                  "text": "Zab 95:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana sisi tulioamini tunaingia katika pumziko lile; kama vile alivyosema,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
