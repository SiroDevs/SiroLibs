                "loc": "EPH.3.1"
              },
              "items": [
                {
                  "text": "Efe 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Paulo, mfungwa wa Kristo Yesu, na Timotheo aliye ndugu yetu, kwa Filemoni mpendwa wetu, mtenda kazi pamoja nasi, ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.17"
              },
              "items": [
                {
                  "text": "Kol 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.3"
              },
              "items": [
                {
                  "text": "2 Tim 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na kwa Afia, dada yetu, na kwa Arkipo askari mwenzetu, na kwa kanisa lililo katika nyumba yako. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.7"
              },
              "items": [
                {
                  "text": "Rum 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neema na iwe kwenu, na amani, zitokazo kwa Mungu, Baba yetu, na kwa Bwana Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Upendo na imani ya Filemoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namshukuru Mungu wangu sikuzote, nikikukumbuka katika maombi yangu; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.4",
            "verseOrgIds": [
              "PHM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikisikia habari za upendo wako na imani uliyo nayo kwa Bwana Yesu na kwa watakatifu wote; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.5",
            "verseOrgIds": [
              "PHM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.9"
              },
              "items": [
                {
                  "text": "Flp 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " naomba ili kwamba ushirika wa imani yako ufanye kazi yake, katika ujuzi wa kila kitu chema kilicho kwetu, katika Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.6",
            "verseOrgIds": [
              "PHM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.4"
              },
              "items": [
                {
                  "text": "2 Kor 7:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maana nilikuwa na furaha nyingi na faraja kwa sababu ya upendo wako, kwa kuwa mioyo ya watakatifu imeburudishwa nawe, ndugu yangu.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ombi la Paulo kwa ajili ya Onesimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo, nijapokuwa nina ujasiri katika Kristo kukuagiza likupasalo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.8",
            "verseOrgIds": [
              "PHM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lakini, kwa ajili ya upendo nakusihi, kwa kuwa ndimi, Paulo mzee, na sasa mfungwa wa Kristo Yesu pia. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.9"
              },
              "items": [
                {
                  "text": "Kol 4:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.19"
              },
              "items": [
                {
                  "text": "Gal 4:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.15"
              },
              "items": [
                {
                  "text": "1 Kor 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakusihi kwa ajili ya mtoto wangu niliyemzaa nikiwa kifungoni mwangu, yaani, Onesimo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.10",
            "verseOrgIds": [
              "PHM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambaye zamani alikuwa hakufai, bali sasa akufaa sana, wewe na mimi pia; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.11",
            "verseOrgIds": [
              "PHM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "niliyemtuma kwako, yeye mwenyewe, maana ni moyo wangu hasa; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.12",
            "verseOrgIds": [
              "PHM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.30"
              },
              "items": [
                {
                  "text": "Flp 2:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ambaye mimi nilitaka akae kwangu, apate kunitumikia badala yako, niwapo katika kifungo kwa ajili ya Injili. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.13",
            "verseOrgIds": [
              "PHM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.7"
              },
              "items": [
                {
                  "text": "2 Kor 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.2"
              },
              "items": [
                {
                  "text": "1 Pet 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini sikutaka kutenda neno lolote isipokuwa kwa ushauri wako, ili kwamba wema wako usiwe kama kwa lazima, bali kwa hiari. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana, labda ndiyo sababu alitengwa nawe kwa muda, ili uwe naye tena milele; ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.15",
            "verseOrgIds": [
              "PHM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.2"
              },
              "items": [
                {
                  "text": "1 Tim 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tokea sasa, si kama mtumwa, bali zaidi ya mtumwa, ndugu mpendwa; kwangu mimi sana, na kwako wewe zaidi sana, katika mwili na katika Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ikiwa waniona mimi kuwa mshirika nawe, mpokee huyu kama ambavyo ungenipokea mimi mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.17",
            "verseOrgIds": [
              "PHM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kama amekudhulumu, au unamdai kitu, ukiandike hicho juu yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.18",
            "verseOrgIds": [
              "PHM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.11"
              },
              "items": [
                {
                  "text": "Gal 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.17"
              },
              "items": [
                {
                  "text": "2 The 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi Paulo nimeandika kwa mkono wangu mwenyewe, mimi nitalipa. Sikuambii kwamba nakudai hata nafsi yako. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.19",
            "verseOrgIds": [
              "PHM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naam, ndugu yangu, nifaidi kwa hili katika Bwana; uniburudishe moyo wangu katika Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        }
      ]
    },
    {
