          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.16"
              },
              "items": [
                {
                  "text": "Mwa 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi Abimeleki akatwaa kondoo, na ng'ombe, na watumwa, na wajakazi, akampa Abrahamu, akamrudishia Sara mkewe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
