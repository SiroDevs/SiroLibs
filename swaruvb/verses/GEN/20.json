            }
          ]
        },
        {
          "text": " Abrahamu akaondoka huko kwenda nchi ya kusini, akakaa kati ya Kadeshi na Shuri, naye akatembea katika Gerari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.1",
