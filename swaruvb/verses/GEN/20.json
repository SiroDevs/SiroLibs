            }
          ]
        },
        {
          "text": " Ikawa hapo Mungu aliponisafirisha kutoka nyumba ya baba yangu, nikamwambia, Hii ndiyo fadhili yako, utakayonifanyia. Kila mahali tuingiapo, useme, Huyu ni kaka yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.13",
            "verseOrgIds": [
              "GEN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
