              "items": [
                {
                  "text": "Mit 16:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abrahamu akasema, Kwa kuwa niliona, hakika hapana hofu ya Mungu mahali hapa, nao wataniua kwa ajili ya mke wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.11",
            "verseOrgIds": [
              "GEN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 20:12"
