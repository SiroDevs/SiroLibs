                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abrahamu akanena juu ya Sara mkewe, “Huyu ni dada yangu”. Basi Abimeleki mfalme wa Gerari akatuma watu wakamtwaa Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        },
