              "items": [
                {
                  "text": "Mwa 11:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata hivyo, kwa kweli yeye ni dada yangu, yaani binti wa baba yangu na wala sio binti wa mama yangu; ndipo akawa mke wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.12",
