            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa mwaka wa mia sita na moja, mwezi wa kwanza, siku ya kwanza ya mwezi, maji yalikauka juu ya nchi. Nuhu akaondoa kifuniko cha safina, naye akaona, na tazama, uso wa nchi umekauka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwezi wa pili, siku ya ishirini na saba ya mwezi, nchi ilikuwa kavu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        }
      ]
    },
