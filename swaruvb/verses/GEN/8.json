                "loc": "1KI.17.4"
              },
              "items": [
                {
                  "text": "1 Fal 17:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " akatoa kunguru, naye akatoka akaenda huku na huko, hata maji yakakauka juu ya nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.7",
            "verseOrgIds": [
              "GEN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akatoa njiwa, aone kwamba maji yamepunguka usoni pa nchi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.8",
            "verseOrgIds": [
              "GEN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.65"
              },
              "items": [
                {
                  "text": "Kum 28:65",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bali yule njiwa hakuona mahali pa kutua kwa wayo wa mguu wake, akamrudia Nuhu safinani, maana maji yalikuwa juu ya uso wa nchi yote; naye akanyosha mkono, akamtwaa, akamwingiza mle safinani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        }
      ]
