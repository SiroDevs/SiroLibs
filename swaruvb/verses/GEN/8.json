            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.13"
              },
              "items": [
                {
                  "text": "Mwa 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.121.8"
              },
              "items": [
                {
                  "text": "Zab 121:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Toka katika safina, wewe, na mkeo, na wanao, na wake za wanao pamoja nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.22"
              },
              "items": [
                {
                  "text": "Mwa 1:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Utoe pamoja nawe kila kilicho hai kilichomo pamoja nawe, chenye mwili, ndege, na mnyama, na kila kitambaacho, chenye kutambaa juu ya nchi; wajae katika nchi, wawe na uzazi, wakaongezeke katika nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Nuhu akatoka, yeye, na wanawe, na mkewe, na wake za wanawe pamoja naye; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.18",
            "verseOrgIds": [
              "GEN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kila mnyama, na kila kitambaacho, na kila ndege, kila kinachokwenda juu ya nchi kwa makabila yao, wakatoka katika safina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        }
      ]
    },
