                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Farao akamwita Abramu, akasema, Ni nini hili ulilonitenda? Mbona hukuniambia ya kuwa huyo ni mkeo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.18",
