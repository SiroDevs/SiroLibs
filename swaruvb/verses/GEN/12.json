        },
        {
          "text": "Basi ikawa Abramu alipofika Misri, Wamisri wakamwona huyo mwanamke ya kwamba yeye ni mzuri sana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
