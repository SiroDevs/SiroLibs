              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona ulisema, Huyo ni dada yangu, hata nikamtwaa kuwa mke wangu? Basi sasa, huyo mke wako umchukue, uende zako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.19",
