                  "text": "Est 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakuu wa Farao wakamwona, nao wakamsifu kwa Farao; basi yule mwanamke akapelekwa nyumbani mwa Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
