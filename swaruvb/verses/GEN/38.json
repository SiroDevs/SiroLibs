              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, wakati wake wa kuzaa walikuwapo mapacha tumboni mwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa alipokuwa akizaa, mtoto mmoja akatoa mkono, mkunga akautwaa uzi mwekundu akaufunga mkononi mwake, huku akisema, Huyu ametoka kwanza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa aliporudisha mkono wake, tazama, ndugu yake akatoka. Akasema, Mbona umepita kwa nguvu wewe? Mambo ya nguvu na yakuandame. Kwa hiyo jina lake likaitwa Peresi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:29",
              "type": "text"
            },
            {
              "text": "Peresi:",
              "type": "text"
            },
            {
              "text": "Peresi: maana yake ni ‘kutoka kwa nguvu’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatoka ndugu yake baadaye, ana uzi mwekundu mkononi mwake; naye akaitwa jina lake Zera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:30",
              "type": "text"
            },
            {
              "text": "Zera:",
              "type": "text"
            },
            {
              "text": "Zera maana yake ni ‘enye kung'aa’.",
              "type": "text"
            }
          ]
        }
      ]
