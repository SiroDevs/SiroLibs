            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.8"
              },
              "items": [
                {
                  "text": "2 Fal 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikawa wakati ule, Yuda akashuka kutoka kwa ndugu zake, akamfikia mtu Mwadulami, jina lake Hira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.2"
              },
              "items": [
                {
                  "text": "Mwa 34:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.3"
              },
              "items": [
                {
                  "text": "1 Nya 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda akaona huko binti wa mtu Mkanaani, jina lake Shua. Akamtwaa, akaingia kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.19"
              },
              "items": [
                {
                  "text": "Hes 26:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye akapata mimba, akazaa mwana, akamwita jina lake Eri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.12"
              },
              "items": [
                {
                  "text": "Mwa 46:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akapata mimba tena, akazaa mwana, akamwita jina lake Onani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.20"
              },
              "items": [
                {
                  "text": "Hes 26:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaendelea, akazaa tena mwana mwingine, akamwita jina lake Shela. Naye Yuda alikuwa huko Kezibu, alipomzaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.4"
              },
              "items": [
                {
                  "text": "Mwa 24:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda akamwoza mke Eri, mzaliwa wake wa kwanza, na jina lake huyo mke ni Tamari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.12"
              },
              "items": [
                {
                  "text": "Mwa 46:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.3"
              },
              "items": [
                {
                  "text": "1 Nya 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Eri, mzaliwa wa kwanza wa Yuda, alikuwa mbaya machoni pa BWANA; na BWANA akamwua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.24"
              },
              "items": [
                {
                  "text": "Mt 22:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda akamwambia Onani, Uingie kwa mke wa nduguyo, ukamwoe, ukamwinulie nduguyo uzao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.6"
              },
              "items": [
                {
                  "text": "Kum 25:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onani alijua ya kwamba huo uzao hautakuwa wake, ikawa, alipoingia kwa mke wa nduguye, alimwaga mbegu chini asimpe nduguye uzao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.19"
              },
              "items": [
                {
                  "text": "Hes 26:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jambo hili alilolifanya likawa baya machoni pa BWANA, basi akamwua yeye pia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        }
      ]
    },
