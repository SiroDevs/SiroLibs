              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.14"
              },
              "items": [
                {
                  "text": "Mwa 38:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaondoka, akaenda zake, akavua utaji wake, na kuvaa mavazi ya ujane wake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akapeleka yule mwana-mbuzi kwa mkono wa rafiki yake Mwadulami, ili aipate rehani mkononi mwa huyo mwanamke lakini hakumkuta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akauliza watu wa mji ule, akisema, Yuko wapi yule kahaba aliyekuwapo Enaimu kando ya njia? Wakasema, Hakuwako hapa kahaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamrudia Yuda akasema, Sikumwona; hata na watu wa mahali hapo walisema, Hakuwako kahaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akasema, Na aichukue yeye, tusije tukatiwa aibu; tazama, nimempelekea mbuzi huyu, wala hukumkuta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.19.2"
              },
              "items": [
                {
                  "text": "Amu 19:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.9"
              },
              "items": [
                {
                  "text": "Law 21:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.21"
              },
              "items": [
                {
                  "text": "Kum 22:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa baada ya miezi mitatu Yuda akapewa habari kwamba, Mke wa mwana wako, Tamari, amefanya uzinifu, naye ana mimba ya haramu. Yuda akasema, Mtoeni ateketezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.32"
              },
              "items": [
                {
                  "text": "Mwa 37:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Alipotolewa, alituma watu kwa mkwewe, akisema, Mimi nimepewa mimba na mtu mwenye vitu hivi. Akasema, Tambua basi, vitu hivi ni vya nani, pete hii, na kamba hii, na fimbo hii. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.24.17"
              },
              "items": [
                {
                  "text": "1 Sam 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.14"
              },
              "items": [
                {
                  "text": "Mwa 38:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.31"
              },
              "items": [
                {
                  "text": "Ayu 34:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda akavikiri, akasema, Yeye ni mwenye haki kuliko mimi, kwa kuwa sikumpa Shela, mwanangu. Wala hakumjua tena baada ya hayo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
