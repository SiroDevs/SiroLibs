              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na ile nchi haikuwatosha, ili wakae pamoja; maana mali zao zilikuwa nyingi, hata wasiweze kukaa pamoja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
