                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abramu akakaa katika nchi ya Kanaani, na Lutu akakaa katika miji ya lile Bonde; akajongeza hema yake mpaka Sodoma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
