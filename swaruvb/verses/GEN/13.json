              "items": [
                {
                  "text": "Mwa 26:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kukawako ugomvi kati ya wachunga wanyama wa Abramu, na wachunga wanyama wa Lutu; na siku zile Wakanaani na Waperizi walikuwa wakikaa katika nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        },
        {
