              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu akapanda kutoka Misri, yeye, na mkewe, na kila alichokuwa nacho, na Lutu pamoja naye, mpaka kusini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.35"
              },
              "items": [
                {
                  "text": "Mwa 24:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.112.3"
              },
              "items": [
                {
                  "text": "Zab 112:3",
                  "type": "text"
