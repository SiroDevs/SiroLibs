                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema, Ee Bwana MUNGU, nipateje kujua ya kwamba nitaimiliki? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia, Unipatie ndama wa miaka mitatu, na mbuzi mke wa miaka mitatu, na kondoo dume wa miaka mitatu, na hua, na mwana njiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akampatia hao wote, akawapasua vipande viwili, akaweka kila kipande kuelekea mwenzake, ila ndege hakuwapasua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tai walipotua juu ya mizoga Abramu akawafukuza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        },
        {
