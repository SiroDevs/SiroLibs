              "items": [
                {
                  "text": "Mwa 2:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na jua lilipokuwa likichwa usingizi mzito ulimshika Abramu, hofu ya giza kuu ikamwangukia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
