                }
              ]
            }
          ]
        },
        {
          "text": " BWANA akamwambia Abramu, Ujue hakika ya kwamba uzao wako utakuwa mgeni katika nchi isiyo yake, watawatumikia watu wale, nao watateswa kwa muda wa miaka mia nne. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
