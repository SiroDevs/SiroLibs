              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.23"
              },
              "items": [
                {
                  "text": "Yer 10:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Esau akaja mbio kumlaki, akamkumbatia, na kumwangukia shingoni, akambusu; nao wakalia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.48.9"
              },
              "items": [
                {
                  "text": "Mwa 48:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.127.3"
              },
              "items": [
                {
                  "text": "Zab 127:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.18"
              },
              "items": [
                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akainua macho yake, akawaona wale wanawake na watoto, akauliza, Ni nani hawa walio pamoja nawe? Akasema, Ni watoto Mungu aliompa mtumwa wako kwa neema yake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wale vijakazi, na wana wao, wakakaribia wakainama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea naye, na wanawe, wakakaribia wakainama. Baadaye Yusufu na Raheli wakakaribia, wakainama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        }
      ]
    },
