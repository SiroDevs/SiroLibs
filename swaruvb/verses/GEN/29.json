          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapata mimba tena, akazaa mwana, akasema, Basi wakati huu mume wangu ataungana nami, kwa sababu nimemzalia wana watatu. Kwa hiyo akamwita jina lake Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
