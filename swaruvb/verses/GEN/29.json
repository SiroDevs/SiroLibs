              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.8"
              },
              "items": [
                {
                  "text": "Mwa 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.28"
              },
              "items": [
                {
                  "text": "24:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yakobo akamwarifu Raheli ya kuwa yeye ni ndugu wa babaye, na ya kuwa ni mwana wa Rebeka. Basi akapiga mbio akampasha babaye habari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.29"
              },
              "items": [
                {
                  "text": "Mwa 24:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa Labani aliposikia habari za Yakobo, mwana wa nduguye, akaenda mbio amlaki, akamkumbatia, akambusu, akamleta nyumbani kwake. Naye akamwambia Labani maneno hayo yote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
