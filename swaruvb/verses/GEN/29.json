                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yakobo akamwambia Labani, Nipe mke wangu, maana siku zangu zimetimia; niingie kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
