                "loc": "1PE.5.14"
              },
              "items": [
                {
                  "text": "1 Pet 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yakobo akambusu Raheli, akalia kwa sauti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
