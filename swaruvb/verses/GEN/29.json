              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa wakati wa jioni akamtwaa Lea, binti yake, akamletea Yakobo, naye akaingia kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
