                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Labani akakusanya watu wote wa mahali pale, akafanya karamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
