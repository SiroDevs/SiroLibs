          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapata mimba tena, akazaa mwana. Akasema, Mara hii nitamsifu BWANA; kwa hiyo akamwita jina lake Yuda; akaacha kuzaa.",
          "type": "text",
