    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo awaoa mabinti wa Labani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani akamwambia Yakobo, Kwa sababu wewe ni jamaa yangu, basi, je! Unitumikie bure? Niambie mshahara wako utakuwa nini? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani alikuwa na binti wawili, jina la mkubwa ni Lea, na jina la mdogo ni Raheli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Lea macho yake yalikuwa malegevu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:17",
              "type": "text"
            },
            {
              "text": "Maana katika Kiebrania si dhahiri.",
              "type": "text"
            }
          ]
        },
        {
          "text": " lakini Raheli alikuwa mzuri wa umbo, na mzuri wa uso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
