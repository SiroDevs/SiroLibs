        },
        {
          "text": " Lea akapata mimba akazaa mwana, akampa jina lake, Reubeni, maana alisema, Kwa kuwa BWANA ameona mateso yangu; sasa mume wangu atanipenda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
