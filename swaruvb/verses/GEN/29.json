          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapata mimba tena akazaa mwana, akasema, Kwa kuwa BWANA amesikia ya kwamba mimi sikupendwa, amenipa na huyu; akamwita jina lake Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
