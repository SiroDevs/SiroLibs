                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yakobo akampenda Raheli akasema, Nitakutumikia miaka saba kwa kumpata Raheli, binti yako mdogo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
