              "items": [
                {
                  "text": "Kut 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na alipokuwa akisema nao, Raheli akaja na kondoo wa baba yake, maana aliwachunga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.17"
              },
              "items": [
                {
                  "text": "Kut 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa Yakobo alipomwona Raheli binti Labani, ndugu wa mamaye, na kondoo wa Labani, ndugu wa mamaye, Yakobo akakaribia, na kulibingirisha lile jiwe litoke katika kinywa cha kisima, akawanywesha kondoo wa Labani, ndugu wa mamaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        }
      ]
