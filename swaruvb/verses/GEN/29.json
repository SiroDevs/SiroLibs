              },
              "items": [
                {
                  "text": "Hos 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kisha Yakobo akashika njia yake, akafika nchi ya wana wa mashariki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.1",
            "verseOrgIds": [
              "GEN.29.1"
            ]
          }
        }
