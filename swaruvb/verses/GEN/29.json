                  "text": "Wim 8:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yakobo akatumika miaka saba kwa kumpata Raheli. Ikawa machoni pake kama siku chache tu kwa vile alivyompenda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
