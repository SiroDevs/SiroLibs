                "loc": "GEN.42.27"
              },
              "items": [
                {
                  "text": "Mwa 42:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
