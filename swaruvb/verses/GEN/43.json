              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamkaribia yule msimamizi wa nyumba ya Yusufu, wakasema naye mlangoni pa nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.19",
            "verseOrgIds": [
              "GEN.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia, Tazama, bwana, kweli tulishuka mara ya kwanza ili tununue chakula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.20",
            "verseOrgIds": [
              "GEN.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 43:21"
          },
          "items": [
