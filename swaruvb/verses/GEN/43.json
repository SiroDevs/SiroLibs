              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi nitakuwa mdhamini wake, umtake mkononi mwangu. Nisipomleta tena kwako, na kumweka mbele yako, nitakuwa mwenye hatia mbele yako daima; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.9",
            "verseOrgIds": [
              "GEN.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "maana kama hatungalikawia, hakika tungaliisha kurudi mara ya pili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.10",
            "verseOrgIds": [
              "GEN.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
