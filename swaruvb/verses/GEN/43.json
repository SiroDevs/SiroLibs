              "items": [
                {
                  "text": "Eze 27:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Israeli, baba yao, akawaambia, Kama ndivyo, fanyeni hivi; twaeni tunu za nchi katika vyombo vyenu, mkamchukulie mtu huyo zawadi, zeri kidogo, na asali kidogo, ubani, na manemane, na jozi, na lozi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.11",
            "verseOrgIds": [
              "GEN.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.25"
              },
              "items": [
                {
                  "text": "Mwa 42:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mkatwae fedha maradufu mikononi mwenu, na fedha zile zilizorudishwa kinywani mwa magunia yenu zirudisheni mikononi mwenu; labda zilisahauliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.12",
            "verseOrgIds": [
              "GEN.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtwaeni na ndugu yenu, mwondoke na kurudi kwa mtu yule. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.13",
            "verseOrgIds": [
              "GEN.43.13"
            ]
          }
        },
