                  "text": "Yer 52:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Njaa ikawa kali katika nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.1",
            "verseOrgIds": [
              "GEN.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa walipokwisha kula nafaka waliyoileta kutoka Misri, baba yao akawaambia, Rudini huko, mkatununulie chakula kidogo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.2",
            "verseOrgIds": [
              "GEN.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.20"
              },
              "items": [
                {
                  "text": "Mwa 42:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.23"
              },
              "items": [
                {
                  "text": "44:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda akamwambia akisema, Yule mtu alituagizia sana akisema, Hamtaniona uso wangu, ndugu yenu asipokuwa pamoja nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.3",
            "verseOrgIds": [
              "GEN.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukimtuma ndugu yetu pamoja nasi, tutashuka na kukununulia chakula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.4",
            "verseOrgIds": [
              "GEN.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ila usipomtuma, hatushuki, maana mtu yule alituambia, Hamtaniona uso wangu, ndugu yenu asipokuwa pamoja nanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.5",
            "verseOrgIds": [
              "GEN.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli akasema, Mbona mmenitendea vibaya hata mkamwarifu mtu yule ya kwamba mna ndugu mwingine? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.6",
            "verseOrgIds": [
              "GEN.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasema, Mtu yule alituhoji sana habari zetu na za jamaa yetu, akisema, Baba yenu angali hai? Mnaye ndugu mwingine? Nasi tukamjibu sawasawa na maswali hayo. Je! Tungaliwezaje kujua ya kwamba atasema, Shukeni pamoja na ndugu yenu?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.7",
            "verseOrgIds": [
              "GEN.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.7",
            "verseOrgIds": [
              "GEN.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akamwambia Israeli baba yake, Mtume kijana pamoja nami, tuondoke, tuende zetu, ili tupate kuishi, wala tusife, sisi na wewe na watoto wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.8",
            "verseOrgIds": [
              "GEN.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.32"
              },
              "items": [
                {
                  "text": "Mwa 44:32",
                  "type": "text"
                }
