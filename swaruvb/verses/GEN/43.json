                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtu yule akawaleta wale watu nyumbani mwa Yusufu, akawapa maji, wakanawa miguu, akawapa punda wao chakula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.24",
