                "loc": "GEN.37.7"
              },
              "items": [
                {
                  "text": "Mwa 37:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaja Yuda na ndugu zake nyumbani kwa Yusufu, naye mwenyewe alikuwamo, nao wakamwangukia kifudifudi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.14",
            "verseOrgIds": [
              "GEN.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu akawaambia, Ni tendo gani hili mlilolitenda? Hamkujua ya kwamba mtu kama mimi naweza kufanya uaguzi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.15",
            "verseOrgIds": [
              "GEN.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.40.4"
              },
              "items": [
                {
                  "text": "Ayu 40:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.9"
              },
              "items": [
                {
                  "text": "Mwa 44:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yuda akasema, Tumwambie nini bwana wangu? Tusemeje! Tujivutieje haki? Mungu ameona uovu wa watumwa wako. Tazama, sisi ni watumwa wa bwana wangu, sisi na yeye ambaye kikombe kilionekana mkononi mwake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.16",
            "verseOrgIds": [
              "GEN.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 44:17"
          },
          "items": [
