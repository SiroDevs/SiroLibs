            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.17"
              },
              "items": [
                {
                  "text": "Gal 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema, Hasha! Nisifanye hivi; mtu ambaye kikombe kilionekana mkononi mwake, ndiye atakayekuwa mtumwa wangu. Nanyi nendeni zenu kwa amani kwa baba yenu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
              "GEN.44.17"
            ]
          }
        }
      ]
