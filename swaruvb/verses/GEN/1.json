        },
        {
          "text": " Mungu akasema, Maji yaliyo chini ya mbingu na yakusanyike mahali pamoja, ili pakavu paonekane; ikawa hivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
              "GEN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akapaita pale pakavu Nchi; na makusanyiko ya maji akayaita Bahari; Mungu akaona ya kuwa ni vyema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
