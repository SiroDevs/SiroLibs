              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akavibarikia, akisema, Zaeni, mkaongezeke, mkayajaze maji ya baharini, ndege na wazidi katika nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
