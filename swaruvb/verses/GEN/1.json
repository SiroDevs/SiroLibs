              "items": [
                {
                  "text": "Isa 40:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo nchi ilikuwa tupu, tena bila umbo, na giza lilikuwa juu ya uso wa vilindi vya maji; Roho ya Mungu ikatulia juu ya uso wa maji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
