                }
              ]
            }
          ]
        },
        {
          "text": " Mungu akasema, Na iwe mianga katika anga la mbingu ili itenge kati ya mchana na usiku; nayo iwe ndiyo dalili ya kuonesha majira, siku na miaka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tena iwe ndiyo mianga katika anga la mbingu itie nuru juu ya nchi; ikawa hivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungu akaumba mianga miwili mikubwa, ule mkubwa utawale mchana, na ule mdogo utawale usiku; akafanya na nyota pia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
