                  "text": "Mdo 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yakobo akaondoka Beer-sheba; wana wa Israeli wakamchukua baba yao na watoto wao wadogo, na wake zao katika magari aliyotuma Farao ili kumchukua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.5",
            "verseOrgIds": [
              "GEN.46.5"
            ]
          }
        },
        {
          "name": "verse",
