        },
        {
          "text": " Yakobo akamtuma Yuda mbele yake kwa Yusufu, ili amwongoze njia mpaka Gosheni. Wakaja mpaka nchi ya Gosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
