          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na watu hao ni wachungaji, maana wamekuwa watu wa kuchunga wanyama, nao wameleta kondoo zao, na ng'ombe zao, na yote waliyo nayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
