                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wana wa Yusufu aliozaliwa katika Misri walikuwa wawili. Watu wote wa nyumba ya Yakobo walioingia Misri walikuwa sabini.",
          "type": "text",
          "attrs": {
