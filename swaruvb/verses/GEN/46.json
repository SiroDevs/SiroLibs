          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu akatandika gari lake, akapanda kwenda kumlaki Israeli, babaye, huko Gosheni; akajionesha kwake, akamwangukia shingoni, akalia shingoni mwake kitambo kirefu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
