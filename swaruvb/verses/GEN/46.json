                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mimi nitashuka pamoja nawe mpaka Misri; nami nitakupandisha tena bila shaka; na Yusufu ataweka mkono wake juu ya macho yako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.4",
            "verseOrgIds": [
              "GEN.46.4"
            ]
          }
        },
        {
          "name": "verse",
