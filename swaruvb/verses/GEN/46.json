              "items": [
                {
                  "text": "Isa 52:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakatwaa na wanyama wao, na mali zao walizokuwa wamepata katika nchi ya Kanaani, wakaja Misri, Yakobo na uzao wake wote pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.6",
            "verseOrgIds": [
              "GEN.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanawe, na wana wa wanawe, pamoja naye, binti zake na binti za wanawe, na uzao wake wote, aliwaleta pamoja naye mpaka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        }
