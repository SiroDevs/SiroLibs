        },
        {
          "text": " Mungu akanena na Israeli katika ndoto ya usiku, akasema, Yakobo, Yakobo. Akasema, Mimi hapa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
