              "items": [
                {
                  "text": "Kut 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasema, Mimi ni Mungu, Mungu wa baba yako, usiogope kushuka mpaka Misri; maana nitakufanya uwe taifa kubwa huko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.3",
            "verseOrgIds": [
              "GEN.46.3"
            ]
          }
        },
        {
