              "items": [
                {
                  "text": "Gal 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mtatahiriwa nyama ya magovi yenu, na jambo hilo litakuwa ishara ya agano kati ya mimi na ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
