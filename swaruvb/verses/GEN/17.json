                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abramu akaanguka kifudifudi. Mungu akamwambia, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
