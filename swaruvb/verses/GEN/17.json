                  "text": "Rum 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wala jina lako hutaitwa tena Abramu, lakini jina lako litakuwa Abrahamu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
