              "items": [
                {
                  "text": "Rum 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hili ndilo agano langu utakalolishika, kati yangu nawe, na uzao wako, Kila mwanamume wa kwenu atatahiriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
