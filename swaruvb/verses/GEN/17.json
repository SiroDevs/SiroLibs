              "items": [
                {
                  "text": "Yn 7:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Katika vizazi vyako vyote, kila mtoto wa kiume miongoni mwenu atatahiriwa akiwa na umri wa siku nane, awe mtumishi aliyezaliwa katika nyumba yako au uliyemnunua kwa fedha zako japo hakuwa wa uzao wako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzaliwa nyumbani mwako, na mnunuliwa kwa fedha yako, lazima atahiriwe; na agano langu litakuwa katika mwili wenu, kuwa agano la milele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
