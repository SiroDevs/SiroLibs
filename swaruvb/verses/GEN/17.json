              "text": "17:5",
              "type": "text"
            },
            {
              "text": "Abrahamu:",
              "type": "text"
            },
            {
              "text": "Abrahamu kwa maana ya ‘baba wa wengi’.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwani nimekuweka uwe baba wa mataifa mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitakufanya uwe na uzao mwingi sana, nami nitakufanya kuwa mataifa, na wafalme watatoka kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
