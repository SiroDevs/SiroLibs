                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.2"
              },
              "items": [
                {
                  "text": "Law 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.13"
              },
              "items": [
                {
                  "text": "2 Sam 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.51.4"
              },
              "items": [
                {
                  "text": "Zab 51:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hakuna mkuu katika nyumba hii kuliko mimi, wala hakunizuilia kitu chochote ila wewe, kwa kuwa wewe u mkewe. Nifanyeje ubaya huu mkubwa nimkosee Mungu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.9",
            "verseOrgIds": [
              "GEN.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawa akizidi kusema na Yusufu siku baada ya siku, lakini hakumsikia alale naye, wala kuwa naye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, siku moja, akaingia nyumbani afanye kazi yake, na hapakuwa na mtu yeyote kati ya wale wa nyumbani karibu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.11",
            "verseOrgIds": [
              "GEN.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.7.13"
              },
              "items": [
                {
                  "text": "Mit 7:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " huyo mwanamke akamshika nguo zake, akisema, Lala nami. Yusufu akaiacha nguo yake mkononi mwake, akakimbia, akatoka nje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa alipoona ya kwamba amemwachilia nguo yake mkononi mwake, naye amekimbia nje, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.13",
            "verseOrgIds": [
              "GEN.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akawaita watu wa nyumbani mwake, akasema nao, akinena, Angalieni, ametuletea mtu Mwebrania atufanyie dhihaka. Ameingia kwangu ili alale nami, nikalia kwa sauti kuu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.14",
            "verseOrgIds": [
              "GEN.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, aliposikia ya kuwa nimepaza sauti yangu na kulia, aliiacha nguo yake kwangu, akakimbia, akatoka nje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi akaiweka ile nguo kwake hata bwana wake aje nyumbani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.16",
            "verseOrgIds": [
              "GEN.39.16"
            ]
          }
        },
        {
