        },
        {
          "text": " BWANA akawa pamoja na Yusufu, naye akasitawi; naye alikuwa katika nyumba ya bwana wake, yule Mmisri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
