          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henoko akamzaa Iradi, Iradi akamzaa Mehuyaeli; Mehuyaeli akamzaa Methushaeli; Methushaeli akamzaa Lameki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.18",
            "verseOrgIds": [
              "GEN.4.18"
            ]
          }
        }
