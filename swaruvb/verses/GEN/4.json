      },
      "items": [
        {
          "text": "Kaini amwua Habili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu akamjua Hawa mkewe; naye akapata mimba, akamzaa Kaini, akasema, Nimepata mtoto wa kiume kwa msaada wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaongeza akamzaa ndugu yake, Habili. Habili alikuwa mchunga kondoo, na Kaini alikuwa mkulima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa hatimaye Kaini akaleta mazao ya ardhi, sadaka kwa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
