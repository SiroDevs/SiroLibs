                "loc": "EXO.13.12"
              },
              "items": [
                {
                  "text": "Kut 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.19"
              },
              "items": [
                {
                  "text": "34:19",
