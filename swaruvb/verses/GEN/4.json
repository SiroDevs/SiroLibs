              "type": "text"
            }
          ]
        },
        {
          "text": " Kaini akamjua mkewe; naye akapata mimba, akamzaa Henoko; akajenga mji akauita Henoko, kwa jina la mwanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.17",
            "verseOrgIds": [
              "GEN.4.17"
            ]
          }
        },
        {
