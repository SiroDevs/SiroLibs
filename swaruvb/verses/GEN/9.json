        },
        {
          "text": "Mungu akamwambia Nuhu, na wanawe pamoja naye, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.8",
            "verseOrgIds": [
              "GEN.9.8"
            ]
          }
        },
        {
          "name": "verse",
