        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
