          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ile gharika ilikuwako juu ya nchi siku arubaini; nayo maji yakazidi, yakaifanya safina ielee, ikaelea juu ya nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.17",
            "verseOrgIds": [
              "GEN.7.17"
            ]
          }
        },
        {
