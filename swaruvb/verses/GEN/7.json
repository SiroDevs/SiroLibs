              "items": [
                {
                  "text": "1 Pet 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na walioingia, waliingia wa kike na wa kiume, wa kila kitu chenye mwili, kama vile alivyomwamuru Mungu; BWANA akamfungia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        }
      ]
    },
    {
