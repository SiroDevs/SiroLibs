              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanamke akamwambia nyoka, Matunda ya miti ya bustanini twaweza kula; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
