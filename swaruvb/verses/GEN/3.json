              "items": [
                {
                  "text": "Yak 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Adamu akasema, Huyo mwanamke uliyenipa awe pamoja nami ndiye aliyenipa matunda ya mti huo, nikala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
