                  "text": "1 Tim 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA Mungu akamwambia mwanamke, Nini hili ulilolifanya? Mwanamke akasema, Nyoka alinidanganya, nikala. ",
          "type": "text",
          "attrs": {
