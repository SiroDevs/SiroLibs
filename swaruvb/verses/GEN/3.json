        },
        {
          "text": " Kisha wakasikia sauti ya BWANA Mungu, akitembea bustanini wakati wa jua kupunga; Adamu na mkewe wakajificha kati ya miti ya bustani, BWANA Mungu asiwaone. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
