        },
        {
          "text": " Basi nyoka alikuwa mwerevu kuliko wanyama wote wa mwitu aliowafanya BWANA Mungu. Akamwambia mwanamke, Ati! Hivi ndivyo alivyosema Mungu, Msile matunda ya miti yote ya bustani? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
