              "items": [
                {
                  "text": "Mwa 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA Mungu akamwita Adamu, akamwambia, Uko wapi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
