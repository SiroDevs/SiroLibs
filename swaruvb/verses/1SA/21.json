              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi akaondoka, akakimbia siku ile, kwa hofu ya Sauli, akamwendea Akishi, mfalme wa Gathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
        {
