                  "text": "29:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao watumishi wa Akishi wakamwambia, Je! Huyu siye yule Daudi, mfalme wa nchi? Je! Hawakuimbiana habari zake katika ngoma zao, kusema,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
