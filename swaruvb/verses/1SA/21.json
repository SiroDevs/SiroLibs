                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yule kuhani akamjibu Daudi, akasema, Hapana mikate ya kawaida chini ya mkono wangu, ila mikate mitakatifu; ikiwa wale vijana wamejitenga na wanawake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.4"
              },
              "items": [
                {
                  "text": "1 The 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.26"
              },
              "items": [
                {
                  "text": "Law 8:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Daudi akamjibu kuhani, akamwambia, Hakika tumejitenga na wanawake siku hizi tatu; napo nilipotoka, vyombo vya vijana hawa vilikuwa vitakatifu, ingawa ilikuwa safari ya kawaida; basi leo je! Vyombo vyetu havitakuwa vitakatifu zaidi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
