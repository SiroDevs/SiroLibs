            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo huyo Akishi akawaambia watumishi wake, Angalieni, mnaona ya kuwa mtu huyu ana wazimu; basi, maana yake nini kumleta kwangu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.14",
            "verseOrgIds": [
              "1SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
