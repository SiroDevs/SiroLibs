                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, hao wana wa Eli walikuwa watu wasiofaa kitu; hawakumjali BWANA, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wala haki ya makuhani ilivyokuwa kwa watu. Wakati huo mtu yeyote alipotoa dhabihu wakati wowote, ndipo huja mtumishi wa kuhani, nyama ilipokuwa katika kutokota, naye akawa na uma wa meno matatu mkononi mwake; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye huutia kwa nguvu humo chunguni, au birikani, au sufuriani, au chomboni; nyama yote iliyoinuliwa kwa huo uma kuhani huichukua mwenyewe. Ndivyo walivyofanya huko Shilo kwa Waisraeli wote waliokuja huko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, kabla ya kuteketeza mafuta, huja mtumishi wa kuhani, akamwambia yule mwenye kuitoa dhabihu, Mtolee kuhani nyama ya kuoka; kwa kuwa hataki kupewa nyama iliyotokoswa, bali nyama mbichi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, ikiwa mtu yule amwambia, Hawakosi wataichoma moto hayo mafuta kwanza, kisha utwae kadiri roho yako itakavyopenda; ndipo husema, Sivyo, lakini sharti unipe sasa hivi; la, hunipi, basi nitaitwaa kwa nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.11"
              },
              "items": [
                {
                  "text": "Mwa 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.8"
              },
              "items": [
                {
                  "text": "Mal 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.24"
              },
              "items": [
                {
                  "text": "Rum 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hivyo dhambi yao wale vijana ilikuwa kubwa sana machoni pa BWANA; kwa maana hao watu walidharau sadaka ya BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
