              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Angalia, siku zinakuja, nitakapoukata mkono wako, na mkono wa watu wa ukoo wa baba yako, hata nyumbani mwako hapatakuwako mzee. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
