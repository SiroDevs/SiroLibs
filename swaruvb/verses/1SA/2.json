              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na yatakayowapata wana wako wawili, Hofni na Finehasi; ndiyo ishara itakayokuwa kwako; wote wawili watakufa siku moja. ",
          "type": "text",
          "attrs": {
