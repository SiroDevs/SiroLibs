                "loc": "JDG.7.10"
              },
              "items": [
                {
                  "text": "Amu 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Daudi akajibu, akamwambia Ahimeleki, Mhiti, na Abishai, mwana wa Seruya, ndugu yake Yoabu, akisema, Ni nani atakayeshuka pamoja nami kwa Sauli kambini? Abishai akasema, Mimi nitashuka pamoja nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Daudi na Abishai wakawaendea watu usiku; na tazama, Sauli alikuwapo kati ya magari amelala usingizi, na fumo lake limechomekwa chini, karibu na kichwa chake; naye Abneri na watu wake wamelala wakimzunguka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.24.18"
              },
              "items": [
                {
                  "text": "1 Sam 24:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Abishai akamwambia Daudi, Mungu amemtia adui yako mikononi mwako leo; basi, niache nimpige kwa hilo fumo hadi chini kwa pigo moja, sitampiga mara ya pili. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Daudi akamwambia Abishai, Usimwangamize; kwani ni nani awezaye kuunyosha mkono wake juu ya masihi",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:9",
              "type": "text"
            },
            {
              "text": "Au, mtiwa mafuta (tazama 1 Sam 2:10).",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa BWANA, naye akawa hana hatia? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
