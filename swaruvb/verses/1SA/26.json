        },
        {
          "text": "Kisha Daudi akaenda ng'ambo ya pili, akasimama juu ya kilima, mbali sana; palipokuwapo nafasi tele katikati yao; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
