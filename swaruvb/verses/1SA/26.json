              },
              "items": [
                {
                  "text": "1 Sam 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Sauli akaitambua sauti ya Daudi, akasema, Hii ndiyo sauti yako, Daudi, mwanangu? Daudi akasema, Ndiyo, ni sauti yangu, bwana wangu, mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        },
