                  "text": "1 Sam 18:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Sauli akasema, Nimekosa; rudi, Daudi, mwanangu; maana sitakudhuru tena, kwa kuwa maisha yangu yalikuwa na thamani machoni pako leo; angalia, nimetenda upumbavu, nimekosa sana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
