                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi akainuka, akafika mahali pale alipotua Sauli; Daudi akapaangalia mahali alipolala Sauli, na Abneri, mwana wa Neri, jemadari wa jeshi lake; naye Sauli alikuwa amelala kati ya magari, na hao watu wamepiga hema zao wakimzunguka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
