          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akajibu, akasema, Litazame fumo hili, Ee mfalme! Kijana mmoja na avukie huku, alitwae. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
