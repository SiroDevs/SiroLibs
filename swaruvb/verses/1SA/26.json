                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " BWANA humlipa kila mtu kulingana na haki na uaminifu wake; maana BWANA amekutia mikononi mwangu leo, nami nilikataa kuunyosha mkono wangu juu ya masihi",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
