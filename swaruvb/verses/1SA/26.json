              },
              "items": [
                {
                  "text": "1 Sam 24:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi sasa, isianguke damu yangu chini mbali na uso wa BWANA; maana mfalme wa Israeli ametoka ili kutafuta uhai wangu, kama vile mtu awindavyo kware mlimani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
