            "caller": "#"
          },
          "items": [
            {
              "text": "26:23",
              "type": "text"
            },
            {
              "text": "Au, mtiwa mafuta (tazama 1 Sam 2:10).",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, angalia, kama vile maisha yako yalivyokuwa na thamani machoni pangu, kadhalika na maisha yangu na yawe na thamani machoni pa BWANA, akaniokoe katika shida zote. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        },
        {
