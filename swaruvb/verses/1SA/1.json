          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, wakati ulipowadia, Hana akachukua mimba na kuzaa mtoto wa kiume; akamwita Samweli, akisema, Kwa kuwa nimemwomba kwa BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
          }
        }
