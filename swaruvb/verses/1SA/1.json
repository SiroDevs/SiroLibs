              },
              "items": [
                {
                  "text": "Zab 62:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hana akajibu, akasema, Hasha! Bwana wangu, mimi ni mwanamke mwenye roho ya huzuni, mimi sikunywa divai wala kileo, ila nimeimimina roho yangu mbele za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
