                  "text": "Kum 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye alipomwachisha kunyonya, akamchukua pamoja naye, na ng'ombe watatu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:24",
              "type": "text"
            },
            {
              "text": "Au, ng'ombe wa miaka mitatu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na efa moja ya unga, na chupa ya divai, akamleta nyumbani kwa BWANA, huko Shilo; na yule mtoto alikuwa mtoto mdogo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wakamchinja huyo ng'ombe, wakamleta mtoto kwa Eli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
              "1SA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Ee bwana wangu, kama iishivyo roho yako, bwana wangu, mimi ndimi yule mwanamke aliyesimama karibu nawe hapa, nikimwomba BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
