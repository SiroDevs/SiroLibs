                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndipo Hana akainuka, walipokula na kunywa huko Shilo. Naye Eli, kuhani, alikuwa akiketi kitini pake penye mwimo wa hekalu la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
