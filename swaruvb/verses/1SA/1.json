                  "text": "Mt 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Niliomba nipewe mtoto huyu; BWANA akanipa dua yangu niliyomwomba; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
