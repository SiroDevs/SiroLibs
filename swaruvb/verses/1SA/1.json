              },
              "items": [
                {
                  "text": "2 Kor 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Usimdhanie mjakazi wako kuwa ni mwanamke asiyefaa kitu; kwa kuwa katika wingi wa kuugua kwangu na kusikitika kwangu ndivyo nilivyonena hata sasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.16",
            "verseOrgIds": [
              "1SA.1.16"
            ]
          }
