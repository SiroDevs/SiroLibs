              "items": [
                {
                  "text": "2 Sam 7:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Elkana, mumewe, akamwambia, Haya, fanya uonavyo vema; ngoja hadi utakapomwachisha kunyonya; BWANA na alithibitishe neno lake tu. Basi yule mwanamke akangoja, akamnyonyesha mtoto wake, hadi akamwachisha kunyonya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 1:24"
          },
          "items": [
