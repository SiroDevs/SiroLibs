                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena mumewe akafanya hivyo mwaka kwa mwaka, hapo yule mwanamke alipokwea kwenda nyumbani kwa BWANA, ndivyo yule alivyomchokoza; basi, kwa hiyo, yeye akalia, asile chakula. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
