              "items": [
                {
                  "text": "Mwa 30:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lakini Hana humpa sehemu mara mbili; maana alimpenda Hana, ingawa BWANA alikuwa amemfunga tumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ila mwenzake humchokoza sana, ili kumwuudhi, kwa sababu BWANA alikuwa amemfunga tumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
