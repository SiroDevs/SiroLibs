              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli akawaambia wale watu waliotaka mfalme maneno yote ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
