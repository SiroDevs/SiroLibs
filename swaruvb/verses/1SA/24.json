                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mfalme wa Israeli ametoka ili kumfuatia nani? Unamwinda nani? Ni kuwinda mbwa mfu, au kiroboto. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
