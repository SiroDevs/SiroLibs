        },
        {
          "text": " Na sasa, angalia, ninajua ya kuwa hakika utakuwa mfalme, na ufalme wa Israeli utafanyika imara mkononi mwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
