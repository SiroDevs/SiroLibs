                {
                  "text": "2 Sam 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakamkata kichwa, wakamvua silaha zake, wakapeleka wajumbe kwenda nchi ya Wafilisti pande zote, ili kutangaza habari nyumbani mwa sanamu zao, na kwa watu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
