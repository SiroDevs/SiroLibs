              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata ikawa, siku ya pili yake, Wafilisti walipokwenda kuwateka nyara waliouawa, walimwona Sauli na wanawe watatu wameanguka juu ya mlima wa Gilboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
