        {
          "text": " Wakaziweka silaha zake nyumbani mwa Maashtorethi; wakakitundika kiwiliwili chake katika ukuta wa Beth-sheani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
