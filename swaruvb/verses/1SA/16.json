                  "text": "1 Fal 12:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikawa walipokuja, alimtazama Eliabu, akasema, Yakini masihi",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:6",
              "type": "text"
            },
            {
              "text": "Au, mtiwa mafuta (tazama 1 Sam 2:10).",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa BWANA yupo hapa mbele zake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
