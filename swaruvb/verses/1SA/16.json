              },
              "items": [
                {
                  "text": "1 Sam 20:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Samweli akasema, Nawezaje kwenda? Sauli akipata habari, ataniua. Basi BWANA akasema, Chukua ndama pamoja nawe, ukaseme, Nimekuja ili kumtolea BWANA dhabihu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
