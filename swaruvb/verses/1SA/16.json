                  "text": "Kut 19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye akasema, Naam, kwa amani; nimekuja kumtolea BWANA dhabihu; jitakaseni; njoni pamoja nami kwenye dhabihu. Akawatakasa Yese na wanawe, akawaita kwenye dhabihu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        },
        {
