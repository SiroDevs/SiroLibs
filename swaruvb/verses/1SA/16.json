              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yese akamwita Abinadabu, akampitisha mbele ya Samweli. Naye akasema, BWANA hakumchagua huyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yese akampitisha Shama. Naye akasema, Wala BWANA hakumchagua huyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yese akawapitisha wanawe saba mbele ya Samweli. Samweli akamwambia Yese, BWANA hakuwachagua hawa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        }
