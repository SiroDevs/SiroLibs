                  "text": "Isa 19:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basi, Roho ya BWANA ilikuwa imemwacha Sauli, na roho mbaya kutoka kwa BWANA ikamsumbua. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao watumishi wa Sauli wakamwambia, Angalia, sasa roho mbaya kutoka kwa Mungu inakusumbua. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi bwana wetu na atuamuru sisi watumishi wake waliopo hapa mbele yako watafute mtu aliye stadi wa kupiga kinubi; basi itakuwa, roho ile mbaya kutoka kwa Mungu itakapokujia, yeye atapiga kinubi kwa mkono wake, nawe utapona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Sauli akawaambia, Vema, nitafutieni mtu aliye stadi wa kupiga kinubi, mniletee. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mmoja wa watumishi wake akasema, Tazama, nimemwona mtoto mmoja wa Yese, Mbethlehemi, aliye stadi wa kupiga kinubi, tena ni mtu shujaa, hodari wa vita, anenaye kwa busara, mtu mzuri, ambaye BWANA yuko pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Sauli akawatuma wajumbe kwa Yese akasema, Mtume Daudi mwanao kwangu, aliye pamoja na kondoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yese akatwaa punda, wa kuchukua mikate, na kiriba cha divai, na mwana-mbuzi, akampelekea Sauli kwa mkono wa Daudi mwanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
