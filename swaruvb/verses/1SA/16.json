        {
          "text": " Samweli akafanya hayo aliyosema BWANA, akaenda Bethlehemu. Wakaja wazee wa mji kumlaki, wakitetemeka, nao wakasema, Je! Umekuja kwa amani? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
