        {
          "text": " Lakini Sauli alipouliza kwa BWANA, BWANA hakumjibu, wala kwa ndoto, wala kwa Urimu, wala kwa manabii. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
