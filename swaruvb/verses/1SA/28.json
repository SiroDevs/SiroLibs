              "type": "tag",
              "attrs": {
                "loc": "REV.14.13"
              },
              "items": [
                {
                  "text": "Ufu 14:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata yule mwanamke alipomwona Samweli alilia kwa sauti kuu; na yule mwanamke akamwambia Sauli, akasema, Mbona umenidanganya? Kwa kuwa wewe ndiwe Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        },
