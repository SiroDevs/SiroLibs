                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye Daudi akamwambia Akishi, Vema, sasa utajua atakayoyatenda mtumishi wako. Naye Akishi akamwambia Daudi, Haya basi! Mimi nitakufanya wewe kuwa mlinzi wangu binafsi daima.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
