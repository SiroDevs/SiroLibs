            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Sauli akawaambia watumishi wake, Nitafutieni mwanamke mwenye pepo wa utambuzi, nipate kumwendea na kuuliza kwake. Watumishi wake wakamwambia, Tazama, yuko mwanamke mwenye pepo wa utambuzi huko Endori. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        },
        {
          "name": "verse",
