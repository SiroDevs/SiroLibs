            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafilisti wakalichukua sanduku la Mungu, wakalitia katika nyumba ya Dagoni, wakaliweka karibu na Dagoni. ",
          "type": "text",
          "attrs": {
