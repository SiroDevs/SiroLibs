              "items": [
                {
                  "text": "Sef 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwa hiyo makuhani wa Dagoni, na mtu yeyote aingiaye nyumbani mwa Dagoni, hawakanyagi kizingiti cha nyumba ya Dagoni huko Ashdodi, hata leo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
