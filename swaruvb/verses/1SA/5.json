        },
        {
          "text": "Basi Wafilisti walikuwa wamelichukua sanduku la Mungu, wakaenda nalo kutoka Ebenezeri hadi Ashdodi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
