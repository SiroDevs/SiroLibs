                "loc": "2SA.2.22"
              },
              "items": [
                {
                  "text": "2 Sam 2:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sauli akamwambia Mikali, Mbona wewe umenidanganya hivi, na kumwacha adui yangu aende, hata ameniponyoka? Naye Mikali akamjibu Sauli, Yeye aliniambia, Niache niende zangu; kwa nini nikuue?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
