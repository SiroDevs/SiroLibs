              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Sauli alipoambiwa, alituma wajumbe wengine, wao nao wakatabiri. Naye Sauli akatuma wajumbe tena mara ya tatu, na wao pia wakatabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
