                }
              ]
            }
          ]
        },
        {
          "text": " Na hao walikuwa maofisa wakuu wa Sulemani, watu mia mbili na hamsini, waliotawala juu ya watu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
