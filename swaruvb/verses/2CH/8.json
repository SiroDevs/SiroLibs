        },
        {
          "text": " Basi kwa habari ya watu wote waliosalia wa Wahiti, na wa Waamori, na wa Waperizi, na wa Wahivi, na wa Wayebusi, wasiokuwa wa Israeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa watoto wao waliosalia baada yao katika nchi, ambao wana wa Israeli hawakuwakomesha, katika hao Sulemani akawatumikisha shokoa hata leo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
