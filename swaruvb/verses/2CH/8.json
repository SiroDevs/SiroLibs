                "loc": "JOS.15.11"
              },
              "items": [
                {
                  "text": "Yos 15:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na Baalathi, na miji yote ya hazina Sulemani aliyokuwa nayo, na miji yote ya magari yake, na miji ya wapanda farasi wake, na ya anasa yote aliyopenda Sulemani kujenga humo Yerusalemu, na katika Lebanoni, na katika nchi yote ya mamlaka yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
