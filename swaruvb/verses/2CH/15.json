              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakakusanyika huko Yerusalemu mwezi wa tatu, katika mwaka wa kumi na tano wa kumiliki kwake Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
