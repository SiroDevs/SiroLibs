              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwapia BWANA kwa sauti kuu, na kwa kelele, na kwa parapanda, na kwa baragumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
