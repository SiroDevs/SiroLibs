                }
              ]
            }
          ]
        },
        {
          "text": " na makomamanga mia nne ya nyavu mbili; safu mbili za makomamanga kwa kila wavu, kuyafunika mabakuli mawili ya mataji yalikuwa juu ya nguzo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
