                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akatengeneza vitako, akatengeneza na mabeseni juu ya vitako; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        },
