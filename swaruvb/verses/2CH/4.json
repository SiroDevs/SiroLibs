            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.41"
              },
              "items": [
                {
                  "text": "1 Fal 7:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " zile nguzo mbili, na mabakuli, na mataji mawili yaliyokuwa juu ya nguzo; nazo nyavu mbili za kuyafunika mabakuli mawili ya mataji yaliyokuwa juu ya nguzo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
