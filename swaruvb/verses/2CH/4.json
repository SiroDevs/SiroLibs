          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Huramu akamaliza kufanya hiyo kazi, aliyomfanyia mfalme Sulemani ya nyumba ya Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
