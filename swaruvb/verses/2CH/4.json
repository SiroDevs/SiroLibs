        {
          "text": " Tena akafanya madhabahu ya shaba, dhiraa ishirini urefu wake, na dhiraa ishirini upana wake, na dhiraa kumi kwenda juu kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
