              },
              "items": [
                {
                  "text": "19:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ukainuliwa moyo wake katika njia za BWANA; na zaidi ya hayo akapaondoa mahali pa juu, na Maashera, katika Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
