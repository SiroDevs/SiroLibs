                {
                  "text": "2 Kor 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na baada yake Amasia mwana wa Zikri, aliyejitoa kwa BWANA kwa moyo, na pamoja naye elfu mia mbili, watu mashujaa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wa Benyamini; Eliada mtu shujaa, na pamoja naye elfu mia mbili wenye nyuta na ngao; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wa pili wake Yehozabadi, na pamoja naye elfu mia moja na themanini waliojiweka tayari kwa vita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
            "verseOrgIds": [
              "2CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hao ndio waliomngojea mfalme, zaidi ya hao mfalme aliowaweka katika miji yenye maboma katika Yuda yote.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
            "verseOrgIds": [
              "2CH.17.19"
            ]
          }
        }
