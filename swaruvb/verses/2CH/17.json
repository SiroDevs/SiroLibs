              "attrs": {
                "loc": "2CH.15.8"
              },
              "items": [
                {
                  "text": "15:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akaweka jeshi katika miji yote yenye maboma ya Yuda, akatia na askari walinzi katika nchi ya Yuda, na katika miji ya Efraimu, aliyoitwaa Asa babaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        },
        {
