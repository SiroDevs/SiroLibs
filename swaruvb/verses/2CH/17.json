        },
        {
          "text": " Kwa hiyo BWANA akauthibitisha ufalme mkononi mwake; Yehoshafati akaletewa zawadi na watu wote wa Yuda; basi akawa na mali na heshima tele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
