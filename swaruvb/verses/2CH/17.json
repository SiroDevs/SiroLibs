              "items": [
                {
                  "text": "Mal 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wakafundisha katika Yuda, wenye kitabu cha Torati ya BWANA; wakazunguka katika miji yote ya Yuda, wakafundisha kati ya watu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
