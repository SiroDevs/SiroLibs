              "attrs": {
                "loc": "2CH.15.3"
              },
              "items": [
                {
                  "text": "2 Nya 15:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena, katika mwaka wa tatu wa kutawala kwake, akawatuma wakuu wake, yaani, Ben-haili, Obadia, Zekaria, Nethaneli, na Mikaya, ili kufundisha mijini mwa Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na pamoja nao Walawi, yaani, Shemaya, Nethania, Zebadia, Asaheli, Shemiramothi, Yehonathani, Adonia, Tobia, na Tob-adonia, Walawi; na pamoja nao Elishama na Yehoramu, makuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
