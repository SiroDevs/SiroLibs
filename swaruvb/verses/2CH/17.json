              "items": [
                {
                  "text": "1 Fal 12:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lakini alimtafuta Mungu wa baba yake, akaenda katika amri zake, wala si katika matendo ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
