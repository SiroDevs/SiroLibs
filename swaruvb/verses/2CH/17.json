              },
              "items": [
                {
                  "text": "Rum 8:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye BWANA alikuwa pamoja na Yehoshafati, kwa kuwa alikwenda katika njia za kwanza za Daudi babaye, asiyatafute Mabaali; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
