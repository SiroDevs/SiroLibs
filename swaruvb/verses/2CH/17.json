        },
        {
          "text": "Na Yehoshafati mwanawe akatawala mahali pake, akajitia nguvu juu ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
