        {
          "text": " Juu yake akakwea Nebukadneza,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
