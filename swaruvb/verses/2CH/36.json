          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:8",
              "type": "text"
            },
            {
              "text": "Au, Yehoyakini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwanawe akatawala mahali pake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
