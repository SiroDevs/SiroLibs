        },
        {
          "text": " Watu wa nchi wakamtwaa Yehoahazi mwana wa Yosia, wakamtawaza awe mfalme katika Yerusalemu mahali pa babaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahazi alikuwa na umri wa miaka ishirini na mitatu alipoanza kutawala; akatawala huko Yerusalemu miezi mitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme wa Misri akamwondoa katika Yerusalemu, akaitoza nchi talanta mia moja za fedha, na talanta moja ya dhahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.19.3"
              },
              "items": [
                {
                  "text": "Eze 19:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mfalme wa Misri akamtawaza Eliakimu nduguye awe mfalme juu ya Yuda na Yerusalemu, akambadilisha jina lake kuwa Yehoyakimu. Neko akamtwaa Yehoahazi nduguye, akamchukua mpaka Misri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
