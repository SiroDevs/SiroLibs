              "items": [
                {
                  "text": "Dan 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nebukadneza akachukua baadhi ya vyombo vya nyumba ya BWANA mpaka Babeli, akavitia katika hekalu lake huko Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
