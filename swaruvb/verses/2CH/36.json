            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:6",
              "type": "text"
            },
            {
              "text": "Au, Nebukadreza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mfalme wa Babeli, akamfunga kwa pingu, amchukue mpaka Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
