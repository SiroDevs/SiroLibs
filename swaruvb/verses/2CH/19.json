                  "text": "2 Sam 23:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akawaagiza, akasema, Ndivyo mtakavyotenda kwa hofu ya BWANA, kwa uaminifu, na kwa moyo wote. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
