                  "text": "Ezr 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Walakini, yameonekana kiasi cha mema ndani yako, kwa kuwa umeyaondoa Maashera katika nchi, na moyo wako umeukaza kumtafuta Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
