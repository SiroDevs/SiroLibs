        },
        {
          "text": " Yehu mwana wa Hanani mwonaji akatoka kwenda kumlaki, akamwambia mfalme Yehoshafati, Je! Imekupasa kuwasaidia waovu, na kuwapenda wamchukiao BWANA? Kwa ajili ya hayo ghadhabu itokayo kwa BWANA i juu yako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
