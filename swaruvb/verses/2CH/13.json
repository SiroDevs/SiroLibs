              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Israeli wakakimbia mbele ya Yuda; naye Mungu akawaua mikononi mwao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
