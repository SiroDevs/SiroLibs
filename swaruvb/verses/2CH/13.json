        },
        {
          "text": " Katika mwaka wa kumi na nane wa mfalme Yeroboamu, Abiya akaanza kutawala juu ya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
