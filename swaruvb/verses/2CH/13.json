              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Yeroboamu aliwazungushia waviziao kwa nyuma; basi wao wakawa mbele ya Yuda, na wale waviziao nyuma yao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yuda walipotazama nyuma, angalia, vita vikawa mbele na nyuma; wakamlilia BWANA, na makuhani wakapiga parapanda. ",
          "type": "text",
