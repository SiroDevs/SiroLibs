                  "text": "2 Nya 10:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini Yeroboamu mwana wa Nebati, mtumishi wa Sulemani mwana wa Daudi, akainuka, akamfanyia fitina bwana wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
