                  "text": "Hos 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hata sasa mwajidhania kuwa mtauzuia ufalme wa BWANA mikononi mwa wana wa Daudi; nanyi mmekuwa jamii kubwa, na kwenu mna ndama za dhahabu alizowafanyia Yeroboamu kuwa miungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
