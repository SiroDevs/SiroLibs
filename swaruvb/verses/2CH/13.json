            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini sisi, BWANA ndiye Mungu wetu, wala sisi hatukumwacha; tena tunao makuhani wanaomtumikia BWANA, wana wa Haruni, na Walawi, kwa kazi yao; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
