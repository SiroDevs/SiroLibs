                "loc": "2CH.17.11"
              },
              "items": [
                {
                  "text": "2 Nya 17:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na Waamoni wakampa Uzia zawadi; likaenea jina lake mpaka Misri; alipata nguvu nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        },
        {
