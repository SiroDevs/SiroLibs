              },
              "items": [
                {
                  "text": "Zek 14:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tena Uzia akaujengea Yerusalemu minara, penye Lango la Pembeni, na penye Lango la Bondeni, na ugeukapo ukuta, akaitia nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.16"
              },
              "items": [
                {
                  "text": "2 Nya 21:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akajenga minara tena nyikani, akachimba mabwawa mengi, maana alikuwa na ng'ombe tele; katika Shefela pia, na katika nchi tambarare; tena alikuwa na wakulima na watunza mizabibu milimani, na katika mashamba ya neema; maana yeye alipenda ukulima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
