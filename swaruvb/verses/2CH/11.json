          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoraimu, Lakishi, Azeka, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.9",
            "verseOrgIds": [
              "2CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sora, Aiyaloni, na Hebroni, iliyoko katika Yuda na Benyamini, miji yenye maboma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazifanya imara hizo ngome, akaweka majemadari humo, na akiba ya vyakula, na mafuta, na mvinyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndani ya miji yote mmoja mmoja aliweka ngao na mikuki, akaifanya kuwa na nguvu nyingi mno. Yuda na Benyamini ikawa milki yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        }
      ]
    },
