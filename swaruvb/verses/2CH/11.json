          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gathi, Maresha, Zifu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.8",
            "verseOrgIds": [
              "2CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
