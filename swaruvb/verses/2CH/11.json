        },
        {
          "text": "Kisha baada yake akamwoa Maaka, binti Absalomu; na yeye akamzalia Abiya, na Atai, na Ziza, na Shelomithi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
