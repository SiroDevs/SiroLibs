                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lakini neno la BWANA likamjia Shemaya mtu wa Mungu, kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambie Rehoboamu mwana wa Sulemani, mfalme wa Yuda, uwaambie na Israeli wote waliomo Yuda na Benyamini, ukisema, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.3",
            "verseOrgIds": [
              "2CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA asema hivi, Hamtapanda wala kupigana na ndugu zenu; rudini kila mtu nyumbani kwake; kwa kuwa jambo hili limetoka kwangu. Basi wakayatii maneno ya BWANA wakarudi wasiende kupigana na Yeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        }
      ]
    },
