                }
              ]
            }
          ]
        },
        {
          "text": " Basi, BWANA akawapiga Wakushi mbele ya Asa, na mbele ya Yuda; na Wakushi wakakimbia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
