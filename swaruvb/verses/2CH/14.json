              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa akatoka kukutana naye, wakapanga vita Maresha bondeni mwa Sefatha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
