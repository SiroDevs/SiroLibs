              "items": [
                {
                  "text": "2 Nya 21:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao wakazi wa Yerusalemu walimfanya Ahazia mwanawe mdogo awe mfalme mahali pake; maana wakubwa wake wote wamekwisha kuuawa na kikosi cha watu waliokuja kambini pamoja na Waarabu. Hivyo Ahazia mwana wa Yehoramu mfalme wa Yuda, akatawala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
