              "attrs": {
                "loc": "PRO.19.27"
              },
              "items": [
                {
                  "text": "19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akafanya yaliyo mabaya machoni pa BWANA kama nyumba ya Ahabu; kwa kuwa hao walikuwa washauri wake, baada ya kifo cha baba yake, hata aangamie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.28"
              },
              "items": [
                {
                  "text": "2 Fal 8:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naye akaenda kwa mashauri yao, akafuatana na Yoramu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:5",
              "type": "text"
            },
            {
              "text": "Au, Yehoramu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwana wa Ahabu mfalme wa Israeli ili kupigana na Hazaeli mfalme wa Shamu huko Ramoth-gileadi; nao Washami wakamjeruhi Yoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.15"
              },
              "items": [
                {
                  "text": "2 Fal 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akarudi Yezreeli ili aponye majeraha waliyomjeruhi huko Rama, alipopigana na Hazaeli mfalme wa Shamu. Naye Ahazia",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:6",
              "type": "text"
            },
            {
              "text": "Au, Azaria.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwana wa Yehoramu mfalme wa Yuda, akashuka amtazame Yoramu mwana wa Ahabu, katika Yezreeli, kwa sababu alikuwa mgonjwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        },
