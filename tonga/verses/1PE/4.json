              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti kuciindi coonse cicimusyaalide ansi ano ­mutaceendi muzisusi zyanyama pele mumakanze aa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
