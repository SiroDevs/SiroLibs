                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa zipego zya-Muuya nzimutambwide, amugwasyanye anzizyo, nkaambo mbubonya obu mbubeelede abo baabilwa luzyalo lwa-Leza lubeleka muziyanza ziyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
