          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "lino sunu balagamba kubona kuti tamuceendi abo mukuya buvuzya butaka, nkabela balamuvwiya ankuko. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
