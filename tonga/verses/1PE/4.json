        },
        {
          "text": "Nkaambo cakomena ciindi ncimwakasowa kale kukucita mbuli mbubacita bamasi. Mwakali kweenda mubumpuwe amuzisusi zibi, mukukolwa amunjalalando, muku senga bukoko amukukomba mizimo iitondwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
