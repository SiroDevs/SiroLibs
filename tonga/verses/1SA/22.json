          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamwaambila kuti, Saulo uliiayide bapaizi ba-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
