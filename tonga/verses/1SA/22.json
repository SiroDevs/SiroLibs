              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakamubuzizya kuli-Jehova akumupa bulilu, alimwi wakamupa ipanga lya-Goliati mu-Filisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        }
      ]
    },
    {
