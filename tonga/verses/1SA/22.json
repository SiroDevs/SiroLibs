          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakaambila Abiyatare kuti, Mubuzuba obo mbwaakaliwo Doegi mu-Edomu, ndakaziba kuti ncobeni ulaambila Saulo. Ndime ndakaletelezya lufu lwabasimukowa babauso boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
