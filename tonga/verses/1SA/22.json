              "items": [
                {
                  "text": "Bab 11:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo kwakayoboloka kulinguwe boonse bantu ibakapengede aboonse ibakajisi zikoloto aboonse ibakabijilidwe mumyoyo, wakaba mwami wabo, nkabela abo ibakaba awe kabali mbuli myaanda yone.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
