        },
        {
          "text": "Elyo Davida wakazwa oko, wakaya kuli-Mizipa waku-Moabu, wakaambila mwami wa-Moabu kuti, Sa inga bata abama baleza okuno kulinduwe, mane nkazibe Leza mbati ndicitile. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.3",
            "verseOrgIds": [
              "1SA.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakabatola kumwami waMoabu, nkabela bakakala awe mazuba oonse Davida ngaakakede mumpangala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        },
