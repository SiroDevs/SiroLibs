                  "text": "Lk 15:23-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mwanakazi wakali amoombe uuneneede muŋanda. Mpawo wakafwambaana kumujaya, alimwi wakabweza busu, wakabukanda akujika zinkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.24",
            "verseOrgIds": [
              "1SA.28.24"
            ]
          }
