              "items": [
                {
                  "text": "Job 13:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanakazi naakasika kuli-Saulo, wakabona kuti ulipenzedwe loko, elyo wakamwaambila kuti, Bona! Ndemulanda wako ndaswiilila ijwi lyako, buumi bwangu ndabubika mujanza lyangu, ndaswiilila majwi aako ngondaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uleelede kundiswiilila ambebo ndemulanda wako. Nkakuletele tusima, uzoolye, elyo uzooba anguzu wazootalika lweendo lwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        },
        {
