              "items": [
                {
                  "text": "1 Sam 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino. Samuele wakaambila Saulo kuti, Ino nkaambonzi nondicubila kundibusya? Saulo wakati, Ndafwaba loko. Ba-Filisti balandilwisya, alakwe Leza wandisia, tacindivwiili limbi pe, nikuba kubasinsimi nikuba kuziloto, Nciceeco ncindakwiitila, kuti undaambile mbwenjelede kucita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samuele wakati, Pele nkaambonzi nobuzya kulindime, na Jehova ulikusiide akuba sinkondonyoko? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
