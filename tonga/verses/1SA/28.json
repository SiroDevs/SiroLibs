        },
        {
          "text": "Elyo Saulo wakabuzya kuli-Jehova, pele Jehova takakamutyaba pe, nikuba kuziloto nikuba muzilengano nikuba kubasinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
