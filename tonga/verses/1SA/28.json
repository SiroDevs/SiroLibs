                "loc": "ISA.8.19"
              },
              "items": [
                {
                  "text": "Is 8:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakalisandula akusama zyakusama zimbi, wakainka abantu bobile, bakasika kuliyooyo mwanakazi masiku. Wakati, Kondisonda kumuzimu, undibonye oyo ngwenti ambe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mwanakazi wakamwaambila kuti, Ulizi Saulo ncacitide, mbwagwiside boonse basangu abasondi munyika. Ino nkaambonzi nomuyandaula buumi bwangu kuti mfwe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Saulo wakakonkezya muzina lya-Jehova, wakati, Ncobeni Jehova mbwali muumi, tokwe noyoojana mulandu nkaambo kamakani aya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        }
      ]
    },
