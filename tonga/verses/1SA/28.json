        },
        {
          "text": "Mbuli mbotakaswiilila ijwi lya-Jehova akutacitila baAmaleki bukali bwakwe bupati, nciceeco Jehova ncakucitila obo sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
