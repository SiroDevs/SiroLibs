              "attrs": {
                "loc": "ROM.12.9"
              },
              "items": [
                {
                  "text": "Rom 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakaambila Akisi kuti, Mbubo, ayebo uyoobona mbenjoocita ndemulanda wako. Alimwi Akisi wakaambila Davida kuti, Ncibotu, uyoeba intobo yangu mazuba oonse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
