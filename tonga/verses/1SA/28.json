              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mwanakazi wakabuzya kuti, Ino nguni ngwenjelede kukubonya? Wakati, Ndibonya Samuele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.2"
              },
              "items": [
                {
                  "text": "Is 57:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.13"
              },
              "items": [
                {
                  "text": "Ciy 14:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanakazi naakabona Samuele, wakoongolola ajwi ipati, alimwi mwanakazi wakaambila Saulo kuti, Nkaambonzi nowandeena? Nduwe Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        },
        {
