                  "text": "Int 138:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mwami wakamwaambila kuti, Utayoowi pe, Ncinzi ncowabona? Mpawo mwanakazi wakaambila Saulo kuti, Ndabona muzimu uuzwa munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        },
