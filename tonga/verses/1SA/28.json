              "attrs": {
                "loc": "1SA.15.28"
              },
              "items": [
                {
                  "text": "1 Sam 15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova wacita mbubonya mbwaakaamba kumulomo wangu. Jehova wakusukula bwami, wabupa mweenzinyoko Davida. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
