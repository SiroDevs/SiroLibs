          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova ulakwaaba, webo aba-Israyeli, mumaanza aaba-Filisti. Junza webo abana bako muzooba okuno kulindime, abalo basinkondo ba-Israyeli ulabaaba mumaanza aaba-Filisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
