                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela nibakasika, wakabona Eliabu, elyo wakati, Ncobeni nguuno munanike waJehova waboneka lino kubusyu bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
