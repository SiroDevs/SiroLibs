              },
              "items": [
                {
                  "text": "1 Sam 20:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Samuele wakati, Ino njiinke buti? Na Saulo wamvwa, ulandijaya. Nkabela Jehova wakaamba kuti, Bweza moombe mupwizi mujanza lyako, elyo ukaambe kuti, Ndeza kuzoopailila Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
