        {
          "text": "Pele Jehova wakamwaambila kuti, Utalangi ciwa cakwe nibuba bulamfu bwacimo cakwe, nkaambo ndamukaka. Nkaambo Jehova talangi mbuli mbwalanga muntu pe. Muntu ulabona busyu buyo, pele Jehova ulabona moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
