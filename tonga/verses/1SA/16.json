          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Jese wakaita Abinadabu akumwiinzya kumeso aa-Samuele. Pele wakati, Alakwe oyu teensi nguwe ngwaasala Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Jese wakainzya Sama, pele wakati, Alakwe oyu teensi nguwe ngwaasala Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi jese wakainzya bana bakwe bali musanu ababili kumeso aa-Samuele, pele Samuele wakaambila Jese kuti, Taakwe naba omwe ngwaasala Jehova akati kabaaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
