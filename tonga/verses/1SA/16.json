        {
          "text": "Lino uleelede kwiita Jese kukupaila, elyo nzookuzibya mboelede kucita, nkabela uzoondinanikila oyo ngunzookwaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
