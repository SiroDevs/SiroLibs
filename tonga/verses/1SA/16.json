                "loc": "GEN.41.46"
              },
              "items": [
                {
                  "text": "Matl 41:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.8"
              },
              "items": [
                {
                  "text": "1 Bam 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.29"
              },
              "items": [
                {
                  "text": "Tus 22:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida wakasika kuli-Saulo, wakaima kumeso aakwe, nkabela wakamuyandisya loko, elyo wakaba sikuyumuna zilwisyo zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Saulo wakatuma kuli-Jese, wakati, Davida akale okuno kulindime, nkaambo wandibotela loko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela kufumbwa ciindi Saulo ncaasikilwa oyo muuya uuzwa kuli-Leza, elyo Davida wabweza kantimbwa kakwe, walizya, mpawo Saulo watontozegwa mumoyo, waba kabotu, muuya mubi wamusia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
        }
