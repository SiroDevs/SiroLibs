                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Muuya wa-Jehova wakazwa kuli-Saulo, nkabela muuya mubi iwakazwa kuli-Jehova wakali kumukataazya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bazike ba-Saulo bakamwaambila kuti, Bona! Muuya mubi uuzwa kwa-Leza uli mukukukataazya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami wesu atwaambile swebo tobazike bakwe notuli waano, kuti tuyandaule umwi muntu uuzi kusobana kantimbwa, elyo kufumbwa ciindi ncoli amuuya oyo mubi uuzwa kwa-Leza ulakusobanina ajanza lyakwe, ulaba kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakaambila bazike bakwe kuti, Mbubo, amundilangwide muntu uuzi kabotu kusobana, mumulete kulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino umwi wabalanda bakwe wakavuwa wati, Bona! Ndibwene umwi mwana wa-Jese waku-Betelehemu uuzi kusobana, alimwi ngumwaalumi sintaze, muyumu wankondo, ulijisi busongo bwakumvwisya makani, alimwi mweebesi, nkabela Jehova uli awe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakatuma batumwa kuli-Jese, wakati, Unditumine mwanaako Davida, oyo uuembela imbelele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jese wakabweza imbongolo yakuyumuna zinkwa ankomo yawaini akana kampongo komwe, wakazituma mujanza lya-Davida mwanaakwe kuliSaulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
