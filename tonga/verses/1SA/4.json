          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mukamwana wakwe Pinehasi kamitide ida, kali kufwaafwi kuzyala, nkabela naakamvwa impuwo yakuti ibbokesi lya-Leza lyanyanzigwa ayakuti bausozyala amulumaako bafwa wakalikotamina akuzyala, nkaambo kakuti lusungo lwakasika kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
