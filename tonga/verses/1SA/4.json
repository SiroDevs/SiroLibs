              ]
            }
          ]
        },
        {
          "text": "Nkabela ibbokesi lya-Leza lyakanyanzigwa, abana bobile ba-Eli, Hofeni a-Pinehasi, bakajayigwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
