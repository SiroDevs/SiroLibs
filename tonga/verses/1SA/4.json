              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ijwi lya-Samuele lyakasika kuba-Israyeli boonse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        }
