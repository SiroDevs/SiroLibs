        },
        {
          "text": "Lino ba-Filisti bakalwana, nkabela ba-Israyeli bakakomwa, bakacija umwi umwi kucilao cakwe, nkabela kwakaba luumo lupati loko, kwakajayigwa akati kaba-Israyeli basimyeendo bali zyuulu zili makumi otatwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.10",
            "verseOrgIds": [
              "1SA.4.10"
            ]
          }
        },
