        },
        {
          "text": "Amuliyumye, mube baalumi, noba-Filisti, kuti mutabi bazike kuba-Hebrayo mbuli mbubakaba bazike kulindinywe. Amube baalumi, mulwane! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        },
