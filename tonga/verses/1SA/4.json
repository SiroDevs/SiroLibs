              "items": [
                {
                  "text": "Matl 35:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino naakaamba kufwa, banakazi abakaimvwi oko nkwaakabede bakaamba bati, Utayoowi pe, nkaambo wazyala mwana mulombe, nekubaboobo teewakamvwa nikuba kubika moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
