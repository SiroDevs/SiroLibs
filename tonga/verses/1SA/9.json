                  "text": "2 Bam 4:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "­Efraimu akucisi ca-Syalisya, pele teewakaziiana. Mpawo bakainda kucisi ca-Salimu pele kazitako, alimwi bakainda kucisi ca-Yemeni akwalo teebakazijana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
