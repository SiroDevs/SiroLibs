              "items": [
                {
                  "text": "1 Sam 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nibakasika kucisi ca-Zufi, Saulo wakaambila mulanda wakwe ngubakali awe, wati, Koza, atupiluke, ikuti bata inga balazileka imbongolo, balakatazigwa nkaambo kesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.5",
            "verseOrgIds": [
              "1SA.9.5"
            ]
          }
        },
