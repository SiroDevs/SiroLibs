                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Junza kuciindi ecino ndakutumina muntu uuzwa kucisi ca-Benjamini, nguwenya oyo ngoelede kunanika mafuta kuti abe musolozi wabantu bangu ba-Israyeli, nkabela ulafutula bantu bangu kuzwa kumaanza aaba-Filisti, nkaambo ndibabwene bantu bangu, kukwiila kwabo kwasika kulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.16",
            "verseOrgIds": [
              "1SA.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.12"
              },
              "items": [
                {
                  "text": "1 Sam 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.11"
              },
              "items": [
                {
                  "text": "Hos 13:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Samuele naakabona Saulo, Jehova wakamwaambila wati, Ngooyu muntu ngundakwaambila, nguwe uuzooendelezya bantu bangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.17",
            "verseOrgIds": [
              "1SA.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakaswena afwiifwi kuli-Samuele mumulyango, wakaamba wati, Undaambile iŋanda yamusondi na ili kuli? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.18",
            "verseOrgIds": [
              "1SA.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samuele wakavwiila Saulo wati, Ndime musondi. Amundisolwede kuyootanta kucilundu, tuyoolya anywebo sunu, nkabela junza ndamutuma kulindinywe, alimwi coonse cili mumoyo wako ndakwaambila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.19",
            "verseOrgIds": [
              "1SA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino imbongolo nzowakasweekelwa mazuba otatwe aakainda, utabiki moyo kulinzizyo, pe, nkaambo kakuti zyajanwa kale. Lino zintu zyoonse ziyandisi zya-Israyeli nzizyani? Tee nzizyako azyamukowa woonse wabauso na? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.20",
            "verseOrgIds": [
              "1SA.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.46"
              },
              "items": [
                {
                  "text": "Bab 20:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.68.27"
              },
              "items": [
                {
                  "text": "Int 68:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.15"
              },
              "items": [
                {
                  "text": "Bab 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakavuwa wati, Sa ime nsili mu-Benjamini, musyobo muniini kwiinda misyobo yoonse yaba-Israyeli? Amukowa wabatata teensi muniini kwiinda mikowa yoonse yaba-Benjamini? Ino nkaambonzi wandaambila ijwi lili boobu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.21",
            "verseOrgIds": [
              "1SA.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samuele wakatola Saulo amulanda wakwe, wabanjizya muŋanda yabeenzu, wababika mubusena butaanzi akati kabatambwi, bakali mbuli makumi otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.22",
            "verseOrgIds": [
              "1SA.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Samuele wakaambila mujiki wati, Leta caabilo eco ncindakakupa, ncindakakwaambila kuti ucibambe kulinduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.23",
            "verseOrgIds": [
              "1SA.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.32"
              },
              "items": [
                {
                  "text": "Lev 7:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.4"
              },
              "items": [
                {
                  "text": "Ezk 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.9"
              },
              "items": [
                {
                  "text": "Inc 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo mujiki wakanyampula mweendo azintu zyawo, wakazibika kunembo lya-Saulo. Nkabela wakaamba wati, Langa, nceeci ciyobolwa. Ucibike kunembo lyako, ulye, nkaambo kakuti cakayobwedwa nduwe kuciindi ceelede kuti nkatambe bantu. Lino Saulo bakalya a-Samuele mubuzuba obo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        }
      ]
    },
