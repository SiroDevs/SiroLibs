            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cibe ciindi bakaseluka kuzwa kucilundu kuya kumunzi, nkabela bakabambila Saulo bulo atala alululi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibwakaca bakafuma, nkabela Samuele wakaita Saulo kulululi, wati, Buka, nkakutume kulinduwe. Mpawo Saulo wakabuka nkabela bakazwa boonse bobile a-Samuele anze. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nibakaseluka kumamanino aamunzi Samuele wakaambila Saulo wati, Ulailile mulanda kuti atusolwede, nkabela wakasolola, Lino wati, Pele uwe uimikile, nkulwiide ijwi lya-Leza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
            "verseOrgIds": [
              "1SA.9.27"
            ]
          }
        }
