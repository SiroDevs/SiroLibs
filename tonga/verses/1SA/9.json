                "loc": "1SA.10.23"
              },
              "items": [
                {
                  "text": "1 Sam 10:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oyo muntu kajisi mwana, izina lyakwe kali Saulo, kali mulombe mubotu, kakutakwe naba omwe akati kaba-Israyeli mubotu mbuli nguwe. Kuzwa kuziwezo zyakwe kali mulamfu kwiinda bantu boonse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        }
      ]
