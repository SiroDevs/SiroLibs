            "number": "8",
            "style": "v",
            "sid": "1SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mulanda wakavwiila Saulo wati, Langa! mujanza lyangu ndijisi cipanzi cane casekeli cansiliva. Njoomupa muntu wa-Leza kuti atwaambile lweendo lwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.8",
            "verseOrgIds": [
              "1SA.9.8"
            ]
          }
