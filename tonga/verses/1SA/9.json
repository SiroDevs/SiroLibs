        },
        {
          "text": "Lino Kisi wisi Saulo wakasweekelwa imbongolo zyakwe, nkabela Kisi wakaambila mwana wakwe Saulo wati, Ubweze umwi mulombe, munyampuke, muye kuyooyandaula imbongolo. Lino wakainda kucilundu ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
