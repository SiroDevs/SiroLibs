              "items": [
                {
                  "text": "1 Sam 24:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bulowa bwangu butatililwi ansi okuno nkwatako Jehova, nkaambo mwami wa-Israyeli weza kuzooyandaula kanjina buyo, uli mbuli muntu uuvwima kwale mumalundu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
