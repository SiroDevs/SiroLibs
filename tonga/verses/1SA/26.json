        },
        {
          "text": "Jehova anditondye kutambika ijanza lyangu kukulwisya munanike wa-Jehova. Pele lino kobweza buyo isumo eli lili kumutwe wakwe ankomo yamaanzi, atweende. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        },
