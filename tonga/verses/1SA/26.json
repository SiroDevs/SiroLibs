            }
          ]
        },
        {
          "text": "Jehova ulabweedezezya muntu umwi aumwi bululami bwakwe abwini bwakwe, Nkaambo Jehova walikwaabide mumaanzanza aangu, pele mebo teendazumina kutambika ijanza lyangu kukulwisya munanike wa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
