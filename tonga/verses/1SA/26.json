          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino buumi bwako mbuli mbubulemekedwe sunu mumeso aangu, buumi bwangu abwalo bulemekwe mbubonya mumeso aaJehova, kuti andivune kumapenzi oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
