          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davida a-Abisai bakasika masiku nkubakabede bantu, nkabela Saulo wakalilede, wakali kuona, akati kanola, asumo lyakwe lyakalisekedwe ansi kumutwe wakwe. Alakwe Abineri abantu boonse bakalilede, bakalimuzingulukide. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
