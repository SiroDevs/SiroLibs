            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eco ncowacita tacili cibotu pe. Ncobeni Jehova mbwali muumi, mwaleelede kufwa, nkaambo kakutalindilila simalelaanu munanike wa-Jehova. Lino bona! Lili kuli isumo lyamwami, ankomo yamaanzi, izyakali kumutwe wakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
