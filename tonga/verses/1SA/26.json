              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakaya mutala, wakaima kulekule atala acilundu, nkabela kakuli busena bupati akati kabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Davida wakoongolola kubantu akuli-Abineri mwana wa-Neri, wakati, Sa tovuwi webo Abineri? Elyo Abineri wakavuwa kuti, Nduweni noita mwami? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        },
        {
