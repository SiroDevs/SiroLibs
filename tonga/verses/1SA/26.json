                  "text": "1 Sam 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakaziba ijwi lya-Davida, wakati, Sa eli ijwi talyeensi lyako, Davida mwanaangu? Davida wakati, Ndijwi lyangu, mwami simalelaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
