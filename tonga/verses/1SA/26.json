                  "text": "1 Sam 23:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Zifi bakasika kuli-Saulo ku-Gibeya, bakati, Sa Davida teensi nguuyubide mumalundu aa-Hakila aali kunembo lyagundu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Saulo wakanyamuka, wakainka kunkanda ya-Zifi, abantu ba-Israyeli basalidwe bali zyuulu zyotatwe, Bakaya kuyooyandaula Davida munkanda ya-Zifi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.2",
            "verseOrgIds": [
              "1SA.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Saulo wakayaka malabba aakwe mumalundu aa-Hakila aali kunembo lyagundu kumbali aanzila, Lino Davida naakakede munkanda, wakabona kuti Saulo wasika nkukonya kunkanda kuzoomuyandaula. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.3",
            "verseOrgIds": [
              "1SA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davida wakatuma basikutwela, nkabela naakazibisya kuti Saulo wasika ncobeni, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.4",
            "verseOrgIds": [
              "1SA.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.50"
              },
              "items": [
                {
                  "text": "1 Sam 14:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.55"
              },
              "items": [
                {
                  "text": "17:55",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.8"
              },
              "items": [
                {
                  "text": "2 Sam 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndilyonya Davida wakanyamuka, wakaya oko Saulo nkwaakayakide malabba aakwe. Nkabela Davida wakabona Saulo nkwaakalede, a-Abineri mwana wa-Neri silutwe wabasinkondo bakwe. Saulo wakalilede akati kanola, abantu boonse bakalilede balimuzingulukide. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.16"
              },
              "items": [
                {
                  "text": "1 Mak 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.10"
              },
              "items": [
                {
                  "text": "Bab 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakaambila Ahimeleki mu-Hiti a-Abisai mwana waZeruya munyina Joabu kuti, Nguni uuti ndisindikile kuli-Saulo kumalabba? Lino Abisai wakati, Mebo ndakusindikila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
