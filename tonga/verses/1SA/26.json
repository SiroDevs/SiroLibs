                "loc": "1SA.24.18"
              },
              "items": [
                {
                  "text": "1 Sam 24:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abisai wakaambila Davida kuti, Sunu Leza wamwaaba sinkondonyoko mumaanza aako. Lino nkoomuyase asumo, likajatikizye anyika lweendo lomwe, entamuyase lwabili pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Davida wakaambila Abisai kuti, Pe, utamunyonyooni, nkaambo taakwe muntu uukonzya kutambika ijanza lyakwe kukumulwisya munanike wa-Jehova akutaba amulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
