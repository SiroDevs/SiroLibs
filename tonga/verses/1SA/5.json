              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakatuma ibbokesi lya-Leza ku-Ekroni. Lino ibbokesi lyaLeza nilyakasika ku-Ekroni, ba-Ekroni bakatalika kulila, bati, Batulonzezya ibbokesi lya-Leza wa-Israyeli kuti batujaye abantu besu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        }
