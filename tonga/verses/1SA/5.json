              "items": [
                {
                  "text": "Zef 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nciceeco bapaizi ba-Dagoni aboonse banjila muŋanda ya-Dagoni ncibatalyati acikunguzyo ca-Dagoni mu-Asidodi kusikila sunu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
