          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ba-Filisti bakatola ibbokesi lya-Leza, bakalinjizya muŋanda ya-Dagoni akuliimika kubbazu lya-Dagoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        }
      ]
