        {
          "text": "Lino ba-Filisti nibakanyanzya ibbokesi lya-Leza bakalileta kuzwa kuEbenezeri kusikila ku-Asidodi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
