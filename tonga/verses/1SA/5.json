                  "text": "Int 78:66",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nibakamana kulilonzya, ijanza lya-Jehova lyakali kumunzi oyo, lyakaleta lupyopyongano lupati loko, nkabela wakauma boonse bantu bamumunzi, nibaba baniini nibaba bapati, nkabela bakakalwa zyuute,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
