        },
        {
          "text": "Lwabili nibwakaca ba-Asidodi bakafuma cifumofumo nkabela bakajana kuti uliwide ansi, abusyu bwakwe bwakalivundeme, kunembo lyabbokesi lyaLeza, alimwi mutwe wa-Dagoni amaanza aakwe obile zyoonse zyakalikosokede acikunguzyo, kwakasyaala citimbitimbi ca-Dagoni luzutu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
