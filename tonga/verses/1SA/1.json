                  "text": "Jer 7:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oyo muntu wakali kutanta kuzwa kumunzi wakwe mazuba oonse kuya kukukomba akupaila Jehova wamakamu makamu ku-Silo, nkukonya nkubakakede bana bobile ba-Eli, Hofeni a-Pinehasi bapaizi ba-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        }
      ]
    },
    {
