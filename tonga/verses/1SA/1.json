                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Hana takaakatanta pe, nkaambo wakaambila mulumi akwe kuti, Ndilindile mane mwana aleke kunyonka, elyo ninzoomutola kuti akabonwe kubusyu bwa-Jehova akukala nkuko lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 1:23"
          },
          "items": [
