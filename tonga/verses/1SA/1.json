              "items": [
                {
                  "text": "2 Sam 7:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Elikana mulumi akwe wakamwaambila wati, Ncibotu, cita mbuli mbuwabotelwa, syaala mane ukamulesye, elyo Jehova nayoolondola ijwi lyakwe. Mbuboobo mwanakazi mbwaakasyaala akunyonsya mwanaakwe kusikila kukumulesya kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
