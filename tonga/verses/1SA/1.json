              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kufumbwa buzuba mbwaakali kuyanda kupaila Elikana wakali kwaabila Penina mukakwe abana bakwe boonse balombe abasimbi zyaabilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.4",
            "verseOrgIds": [
              "1SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.2"
              },
              "items": [
                {
                  "text": "Matl 30:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Hana wakali kumupa caabilo comwe buyo, nkaambo kamuyandisya Hana, nekubaboobo Jehova kasinkide izyalilo lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mubwatwanyina wakali kumupenzya loko kukumugalamukila, nkaambo kakut. Jehova kalisinkide izyalilo lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
