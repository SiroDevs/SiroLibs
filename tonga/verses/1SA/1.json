              "items": [
                {
                  "text": "Lk 2:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo mbwaakali kucita mazuba oonse kuciindi ncaakali kutanta kuya kuŋanda ya-Jehova, wakali kumupenzya, nkabela walo Hana wakali kulila akutalya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
