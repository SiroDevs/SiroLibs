          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mbuli mbwaakakomezya ciindi cakukomba kwakwe, Eti wakali kulangisya mulomo wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.12",
            "verseOrgIds": [
              "1SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Hana wakali kwaamba mumoyo wakwe, milomo yakwe luzutu njiyakali kuputaputa, pele ijwi lyakwe teelyakali kumvwigwa pe, nkikaako Eli wakayeeya kuti wakolwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.13",
            "verseOrgIds": [
              "1SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino EH wakamwaambila kuti, Ino kusikila kuciindinzi ncoti kolwe? Uleke waini lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.14",
            "verseOrgIds": [
              "1SA.1.14"
            ]
          }
        },
