                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ciindi cimwi kakuli muntu umwi uwakazwa ku-Ramatayimu, mu-Zofi uuzwa kucilundu ca-Efraimu, izina lyakwe Elikana mwanaakwe Jerohamu mwanaakwe Elihu mwanaakwe Tohu mwanaakwe Zufi, mu-Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.1",
            "verseOrgIds": [
              "1SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo muntu kakwete banakazi bobile, izina lyaumwi kali Hana, umwi kali Penina. Lino Penina kazyede bana, pele Hana takakazyede bana pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 1:3"
