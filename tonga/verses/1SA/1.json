              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Dt 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amane kumulesya wakamutola kuŋanda ya-Jehova ku-Silo antoomwe abasune botatwe alusuwo lwabusu ankomo yawaini, nkabela mwana kacili munnm. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakajaya musune nkabela bakaswenya mwana kuli-Eli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
              "1SA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakaamba wati, Ncobeni mwami wangu, mbuli muuya wako mbuucili muumi, mwami, ndime oyo mwanakazi uwakiimvwi okuno kulinduwe kukukomba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.7"
              },
              "items": [
                {
                  "text": "Mt 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngomwana oyu ngundakali kukombela, lino Jehova wandipa cikumbilo ncindakamukumbila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
