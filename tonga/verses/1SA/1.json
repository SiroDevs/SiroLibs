              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakamana kulya akunywa Hana wakanyampuka, Nkabela mupaizi Eli wakalikede acuuno kucikunguzyo cantempele ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
