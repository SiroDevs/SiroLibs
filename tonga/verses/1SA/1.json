        },
        {
          "text": "Nkabela wakalumbila cilumbizyo cakwaamba kuti, O Jehova wamakamu makamu, kuti kobona cakubona mafwabi aamwanakazi mulanda wako kukundiibulukwa akutaluba mulanda wako akundipa ndemulanda wako mwana mulombe ambebo noomupa Jehova mazuba oonse aabuumi bwakwe, nkabela mutwe wakwe tuukoozoogelwa lunyoolo lyoonse pe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        }
