                  "text": "52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako ambebo ndamukolotya Jehova. Mazuba oonse ngaacipona ulaba cikoloto ca-Jehova. Lino mpawo wakakomba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
