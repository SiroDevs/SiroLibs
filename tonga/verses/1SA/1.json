        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.15"
              },
              "items": [
                {
                  "text": "Rut 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Elikana mulumaakwe wakamwaambila wati, Ino Hana, nkaambonzi ulalila? Nkaambonzi tolyi? Nkaambonzi moyo wako ulaciswa? Teensi ndime nenkubotela kwiinda bana bali ikumi na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.8",
            "verseOrgIds": [
              "1SA.1.8"
            ]
          }
        }
      ]
