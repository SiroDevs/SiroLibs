          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kumamanino aamwaka Hana wakamita, wakazyala mwana mulombe, wakamuulika izina lya-Samuele, nkaambo wakati, Ndakamukumbila kwa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi oyo muntu Elikana wakatanta antoomwe abamuŋanda yakwe boonse kuya kuyoopaila Jehova cipaizyo camyaaka yoonse akulondola kupinga kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
