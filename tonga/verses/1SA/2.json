        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Eli wakacembaala loko, alimwi wakali kuswiilila zyoonse nzibakali kucita bana bakwe kuba-Israyeli boonse ambubakali kulalika banakazi abakali kumana milimo kumulyango watente lyakuyobolekela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakabaambila wati, Nkaambonzi nomucita obo? Ikuti ndiswiilide milimo yanu mibi kuzwa kubantu boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe, bana bangu, nkaambo teensi imbotu impuwo njinswiilila. Mulapambusya bantu ba-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
