            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.24"
              },
              "items": [
                {
                  "text": "Rom 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuti ukake ndiibweza anguzu. Mbuboobo zibi zyabana abo mbuzyakavulide loko kumeso aa-Jehova, nkaambo bakali kusampaula cipaizyo ca-Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
