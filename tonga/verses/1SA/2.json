              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Swiilila! mazuba azoosika ninzookosokezya bana bako abana baluzubo lwauso, kuti kutabi naba omwe uucembeede muluzubo lwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
