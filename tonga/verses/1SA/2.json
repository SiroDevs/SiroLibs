              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino eci ncecitondezyo cizooba kulinduwe akubana bako bobile Hofeni a-Pinehasi, mubuzuba bomwe bayoofwa boonse bobile. ",
          "type": "text",
          "attrs": {
