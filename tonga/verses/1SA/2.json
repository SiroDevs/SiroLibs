              "items": [
                {
                  "text": "Zek 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela uzoobona mapenzi aaŋanda yangu, nkaambo kuyoobota ku-Israyeli, pele muluzubo lwako takukooyoojanwa uuongola mazuba conse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu omwe nsikoozoomukosokezya kulinduwe kuzwa kucipaililo cangu, ndakuleka kuti anyonyozye meso aako akupenzya moyo wako, nkabela bana bazwa kuluzubo lwako balafwa boonse kabacili bayumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
