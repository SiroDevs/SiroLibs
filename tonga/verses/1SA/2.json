            }
          ]
        },
        {
          "text": "Teendakamusala kuzwa kumikowa yoonse ya-Israyeli kuti andibede mupaizi wakupaila acipaililo cangu akutenta tununkilizyo akusama cikobela cituba kubusyu bwangu? Teendakapa luzubo lwauso zipaizyo zyamulilo zyoonse zyabana ba-Israyeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
