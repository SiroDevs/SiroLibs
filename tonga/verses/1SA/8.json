        {
          "text": "Pele makani akabija mumeso aa-Samuele nibakaamba kuti, Utupe mwami wakutubeteka, nkabela Samuele wakakomba kuli-Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
