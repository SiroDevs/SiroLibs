                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.10+2CH.26.11+2CH.26.12+2CH.26.13+2CH.26.14+2CH.26.15"
              },
              "items": [
                {
                  "text": "2 Mak 26:10-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakaamba wati, Mbuboobu mbuzibede ziimbo zyamwami uuzoomweendelezya. Bana banu baalumi ulababweza kuti bamubede basiŋola abasimbizi akucijaana kunembo aŋola yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ulababika kuba basilutwe babantu bali cuulu abasilutwe babantu bali makumi osanwe, abamwi ulababika kuti balime kulima kwakwe akutebula kutebulakwakwe aku cita zintu zyakwe zyakulwisya azintu zyakwe zyanola. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana banu basimbi ulababweza kuti babe basimuunde abasikujikanyama abasikujikansima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.7"
              },
              "items": [
                {
                  "text": "1 Bam 21:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amyuunda yanu amyuunda yanu yamasaansa amyuunda yama-olifa, ulabweza mibotu akati kayo kuti ape bana bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ulabweza cipanzi eekumi cambuto zyanu acamasaansa aanu kuti ape bazike bakwe abalanda bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazike banu abasimbi abalombe banu babotu ambongolo zyanu ulababweza kuti bamumanine milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
