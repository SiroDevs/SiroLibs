              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samuele wakabaambila majwi oonse aa-Jehova bantu abo ibakamubuzya makani aamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
