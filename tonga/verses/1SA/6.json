        },
        {
          "text": "Mpawo bakaamba bati, Mwatuma ibbokesi lya-Leza wa-Israyeli, mutalitumi buyo, muleelede kulibweedezya antoomwe aluliyo, lino mulaponezegwa, alimwi tulaziba nkaambonzi ijanza lyakwe talizwi kulindinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.3",
            "verseOrgIds": [
              "1SA.6.3"
            ]
          }
        },
