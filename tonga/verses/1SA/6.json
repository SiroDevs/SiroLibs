                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino amubweze akubamba iŋola impya ampwizi zyobile zinyonsya zitana kwaangwa ijoko, Alimwi amubope impwizi kunola pele bana bazyo mubaboozye kucimpati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.7",
            "verseOrgIds": [
              "1SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino muleelede kubweza ibbokesi lya-Jehova akulibika aŋola, azyalo zintu zyangolida nzimubweedezya mbuli luliyo antoomwe andilyo amuzilongele mucibikilo kubbazu lyalyo, lino amulitumye, liinke. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.8",
            "verseOrgIds": [
              "1SA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.10"
              },
              "items": [
                {
                  "text": "Jos 15:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwabona kuti lilaya kunzila iiya kulindilyo ku-Betisemesi, mulaziba kuti nguwe watuletela mapenzi aya mapati, anukuti mwabona kuti taliyi boobu tulaziba kuti teensi ijanza lyakwe lyatuuma pele asika eni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.9",
            "verseOrgIds": [
              "1SA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.9",
            "verseOrgIds": [
              "1SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo baalumi bakacita obo, bakabweza impwizi zyobile zinyonsya, bakazibopa kunola, nkabela bana bazyo bakabajalila muŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.10",
            "verseOrgIds": [
              "1SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakalongela ibbokesi lya-Jehova aŋola antoomwe acibikilo ambeba zyangolida azikozyano zyazyuute. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.11",
            "verseOrgIds": [
              "1SA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela impwizi zyakalulama munzila yakuya ku-Betisemesi, zyakeenda munzila ziya bulila, teezyakalea pe nikuba kululyo nikuba kulumwensi, nkabela bami baba-Filisti bakali kuya bweenda musule lyazyo kusikila kumunyinza wa-Betisemesi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.12",
            "verseOrgIds": [
              "1SA.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.12",
            "verseOrgIds": [
              "1SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu ba-Betisemesi bakali mukutebula bulotwe mumumpata, lino bakapuwama, bakabona ibbokesi, bakakondwa kulibona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.13",
            "verseOrgIds": [
              "1SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino iŋola yakanjila mumuunda wa-Joshua muna-Betisemesi, yakiima nkukonya. Nkabela oko kwakali ibbwe ipati. Mpawo bakakosaula zisamu zyanola, ampwizi bakazituuzya mbuli cituuzyo ca-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.14",
            "verseOrgIds": [
              "1SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Levi bakalongonona ibbokesi lya-Jehova acibikilo cakali antoomwe andilyo, eco mumwakali zintu zyangolida bakali tula abbwe ipati, nkabela bantu baBerisemesi bakatuulila Jehova zituuzyo akumupaizizya zipaizyo obo buzuba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.15",
            "verseOrgIds": [
              "1SA.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 6:16"
          },
