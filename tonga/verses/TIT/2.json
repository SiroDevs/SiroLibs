                  "text": "1 Tim 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baalumi bapati babe basitikide, balilemeke akulibatamika, babe bayumu mukusyoma amukuyandana amukukakatila. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
