                  "text": "1 Tim 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bakaintu bapati mbubonya, babe aziwa zyabulemu, batanootamikizya, nokuba kwiindilizya kunywa imbote, pele babe bafundisi babululami, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
