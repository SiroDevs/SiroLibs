            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.13"
              },
              "items": [
                {
                  "text": "Nah 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basintaze bako, O Temani, bayookanduka, aboobo bantu boonse bakucilundu ca-Esau bayoomana kujayigwa.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
