          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo, mbwaamba Jehova, sa nsikooyoonyonyweda ba-Edomu basongo, akumanina cilundu ca-Esau bupampu na? ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        },
