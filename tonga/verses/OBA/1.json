                  "text": "Nah 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mubuzuba obo niwakaimikila kumbali, bazwakule nibakasaala imbono zyakwe, bamasi nibakanjila munlilyango yakwe akuwaalila Jerusalemu cisolo, ayebo wakali mbubonya mbuli baabo. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "OBA 1:12"
          },
          "items": [
