              "items": [
                {
                  "text": "Ciy 18:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulisumpula kwamoyo wako kwakweena, uwe nokede mukati kaŋanzi zyamandomba, noli acikalilo cakujulu, noamba mumoyo wako kuti, Ngwani uukonzya kundiselusya ansi? ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "OBA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
