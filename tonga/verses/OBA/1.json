            }
          ]
        },
        {
          "text": "Nceeci cilengano ca-Obadiya. Mbuboobu mbwaamba Mwami Jehova aa-Edomu. Twaswiilila impuwo iizwa kuli-Jehova. Kwatumwa mu­ tumwa akati kabamasi. Uti, Amubuke, twiinke kuyoomulwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "OBA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona! Ndimucesezye akati kabamasi. Ulisampukide loko. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        },
        {
