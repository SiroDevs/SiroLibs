                  "text": "Tus 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "We! Utakondelelwi munyoko mubuzuba mbwaba mubuzike. Utasekeleli bana ba-Juda mubuzuba bwalunyonyooko lwabo. Utaambi cakulisumpula mubuzuba bwamapenzi aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "OBA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utanjili mumulyango wabantu bangu mubuzuba bwamafwabi aabo. Utalangi ayebo cakukondwa mbubapenga mubuzuba bwamafwabi aabo, nikuba kutambika maanza kumbono zyabo mubuzuba bwamafwabi aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
