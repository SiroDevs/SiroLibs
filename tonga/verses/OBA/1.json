        },
        {
          "text": "Nkaambo kabuvupi mbowavupula mnyoko Jakobo, bweeme buyookuvumba. Uyookosolwa cakutabuka limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        },
        {
