                "loc": "JHN.10.16"
              },
              "items": [
                {
                  "text": "Joh 10:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.6"
              },
              "items": [
                {
                  "text": "1 Kor 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Mwami ngumwi, alusyomo ndumwi, alubapatizyo ndumwi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.6"
              },
              "items": [
                {
                  "text": "1 Kor 12:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Leza ngumwi, ngonguwe Wisi wabo boonse, uubainda boonse, nguuli akati kaboonse, alimwi nguumukalila nyoonse mukati.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        }
