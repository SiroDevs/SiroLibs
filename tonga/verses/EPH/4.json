            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino eli ijwi lyakuti, Wakatanta, sa takweensi kwaamba kuti wakasaanguna kuseluka kunsi anyika? ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.9",
            "verseOrgIds": [
