          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo iwakaselukide ngonguwe iwakatanta kujulu kule kwiinda majulu oonse, kuti azulile muzintu zyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.10",
