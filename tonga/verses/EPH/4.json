            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mebo, ndemwaange nkaambo kamakani aa-Mwami, ndamukombelezya kuti inzila njimweendelamo ibote cakweelela bwiite mbumwakai­ tilwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
