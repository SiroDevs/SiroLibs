              "attrs": {
                "loc": "COL.1.2"
              },
              "items": [
                {
                  "text": "Kol 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amube aluzyalo aluumuno luzwa kwa-Leza Taateesu aku-Mwami wesu Jesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
