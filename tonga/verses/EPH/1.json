        },
        {
          "text": "Ndime Paulo, nendakasungulwa abukanze bwa-Leza kuba apostolo wa-­Kristo Jesu. Ndamujuzya nobasalali bali ku-Efeso aboonse bazumini bamuli-Kristo Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
