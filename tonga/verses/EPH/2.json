            }
          ]
        },
        {
          "text": "Akati kabaaba mpotwakali kuponena aswebo kalekale, nkaambo twakali mumayabwe aanyama yesu, twakali kucita zisusi zibi zyanyama azyamyoyo yesu, nkabela mubwiime bwesu twakali bana babukali mbubonya mbuli bamwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
