                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nekuba kuti twakalifwide mumilandu, wakatubusya toonse antoomwe a-Kristo (luzyalo ndomufutuzidwe). ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
