          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mumazuba ayo bapati baba-Juda bakalembela Tobiya magwalo manji, amagwalo manji aazwa kuli-Tobiya akasika kulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
