              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.4"
              },
              "items": [
                {
                  "text": "Is 59:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.27"
              },
              "items": [
                {
                  "text": "Dan 11:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo ndakamutumina kuti, Taakwe makani aali boobo mboamba, pe. Ulaamba miyeeyo yamoyo wako buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
