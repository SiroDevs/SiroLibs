            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.10"
              },
              "items": [
                {
                  "text": "Is 41:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.9"
              },
              "items": [
                {
                  "text": "2 Kor 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo boonse bakayanda kutuyoosya, Bakali kuyeeya kuti, Maanza aabo alaleka milimo, itacitwi. Koyumya maanza aangu, O Leza.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
