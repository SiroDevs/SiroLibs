                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sanibalati a-Gesemu bakandiita, bati, Koza, tukaswanaane mumunzi umwi wamukuti lya-Ono. Pele bakali kuyeeya kundibisizya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.15"
              },
              "items": [
                {
                  "text": "Tus 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ndakabatumina batumwa, ndati, Ndili mukubeleka milimo mipati; nsikonzyi kusika. Sa ncibotu kuti milimo ikale buyo? Sa ndakonzya kwiileka kuti nze nkumubede? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.10"
              },
              "items": [
                {
                  "text": "Tus 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ziindi zyone bakandiita mbubonya, lino lyoonse ndakababweedezya ijwi elyo ndilyonya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Sanibalati wakandiita mbubonya ciindi acimwi casanu. Wakatuma mulanda wakwe, ulijisi lugwalo lutasinkidwe mujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.5",
            "verseOrgIds": [
              "NEH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.3"
              },
              "items": [
                {
                  "text": "Jer 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.8"
