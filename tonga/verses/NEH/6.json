                "loc": "LUK.23.2"
              },
              "items": [
                {
                  "text": "Lk 23:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Omo mulugwalo mwakalembwa kuti, Kwamvwigwa akati kabamasi, alakwe Gesemu ulaamba mbubonya, kuti webo aba-Juda nyoko mulayeeya kupapila. Nciceeco ncoyakila bulambo, kuti ube mwami wabo mbubonya mbuli majwi aya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ulibikide basinsimi kuti bakambauke aanduwe mu-Jerusalemu, baambe kuti, Nkwali mwami mucisi ca-Juda, Makani aya ayooambwa mumatwi aamwami. Lino koza, tukabuzyanye makani antoomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.7",
            "verseOrgIds": [
              "NEH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.13.4"
              },
              "items": [
                {
                  "text": "Job 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.36.3"
