          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo bantu banji ba-Juda kabatangene awe cizuminano, nkaambo kakuti kakwete mwana musimbi wa-Sekaniya mwana wa-Ara, alimwi mwanaakwe Jehohanana nguwakakwata mwana musimbi wa-Mesulamu mwana wa-Berekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
