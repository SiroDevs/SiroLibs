              "items": [
                {
                  "text": "Neh 10:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo mbundakagwisya beenzu akati kabo. Alimwi ndakabikila inkamu zyabapaizi azyaba-Levi imwi aimwi milimo yazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amilimo yazipo zyankuni kuziindi zyeelede ayakabalwebalwe, yoonse ndakaibamba, Kondiyeeya O Leza wangu. Kondicitila bubotu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
