            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela umwi wabana ba-Joyada mwana wa-Eliyasibu mupaizi mupati kakwete mwana musimbi wa-Sanibalati mu-Horoni, pele ndakamutanda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
