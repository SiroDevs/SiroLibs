                "loc": "MAL.2.4"
              },
              "items": [
                {
                  "text": "Mal 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utabalubi, O Leza wangu, nkaambo bakasofwaazya bupaizi acizuminano cabupaizi acaba-Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 13:30"
          },
          "items": [
