                  "text": "My 35:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ndakajana kuti ba-Levi kabatana kupegwa zyaabilo zyabo, aboobo ba-Levi abasikwiimba ibakacita milimo bakalicijide, umwi aumwi kumuunda wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.4"
              },
              "items": [
                {
                  "text": "Tus 28:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.17"
              },
              "items": [
                {
                  "text": "1 Sam 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakakazyanya abasilutwe, ndabaambila kuti, Ino nkaambonzi iŋanda ya-Leza ililekedwe? Nkabela ndakababunganya, ndababika mumasena aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.11",
            "verseOrgIds": [
              "NEH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.44"
              },
              "items": [
                {
                  "text": "Neh 12:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Juda boonse bakaleta cipanzi cakumi camaila acawaini acamafuta kuziyobwedo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.2"
              },
              "items": [
                {
                  "text": "1 Kor 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ndakabika basiziyobwedo: Selemiya mupaizi, a-Zadoki mulembi, a-Pedaya umwi waba-Levi; akusule lyabo, Hanani mwana wa-Zakuri mwana wa-Mataniya; nkaambo bakayeeyegwa kuti mbasyomesi, aboobo bakapegwa milimo yakwaabila bakwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.19"
              },
              "items": [
                {
                  "text": "Neh 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utandilubi, O Leza wangu, nkaambo kamakani aya. Utaziminganyi milimo yangu mibotu njindacitila iŋanda ya-Leza wangu aziyanza zyayo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
    },
