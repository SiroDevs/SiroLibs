            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.13"
              },
              "items": [
                {
                  "text": "Joh 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndakausa loko. Lino ndakasowa zibelesyo zyoonse zya-Tobiya anze lyakaanda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.5"
              },
              "items": [
                {
                  "text": "2 Mak 29:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ndakabalailila kusalazya twaanda, elyo ndakanjizya omo zibelesyo zyaŋanda ya-Leza acituuzyo atununkilizyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
