              },
              "items": [
                {
                  "text": "Mik 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo kakuti teebakagwasya bana ba-Israyeli insima amaanzi, alimwi bakatamba Balamu kuti abatukile, nekubaboobo Leza wesu wakasandula lutukilo lube coolwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.2"
              },
              "items": [
                {
                  "text": "Neh 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.27"
              },
              "items": [
                {
                  "text": "Jak 1:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo nibakamvwa mulao, bakapambukanya kuba-Israyeli boonse bantu bavwelene.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
