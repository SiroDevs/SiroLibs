                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Int 69:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.15+MRK.11.16+MRK.11.17"
              },
              "items": [
                {
                  "text": "Mk 11:15-17",
                  "type": "text"
