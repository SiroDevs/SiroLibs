                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa Solomoni mwami wa-Israyeli takwakabisya mumakani aya? Katakwe mwami uuelene awe akati kazisi zinji, nkaambo wakayandwa kuli-Leza wakwe, alimwi Leza wakamubika kuti abe mwami waba-Israyeli boonse, nekubaboobo banakazi beenzu bakamuwisya muzibi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.2"
              },
              "items": [
                {
                  "text": "Ezr 10:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sa tulakonzya kumuswiilila kukucita bubi bupati buli obo? Sa tulakonzya kubisizya Leza wesu kukukwata banakazi beenzu?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
