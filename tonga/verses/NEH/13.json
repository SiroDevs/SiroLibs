              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mumazuba ayo ngaonya ndakabona bamwi ba-Juda ibakakwete banakazi baku-Asidodi, ba-Amoni, aba-Moabu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela bana babo bakali kwaamba majwi amwi aaci-Asidodi; teebakaambisya ci-Juda pe, bakali kuvwelanya myaambo yoonse yobile, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
