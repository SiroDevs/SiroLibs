          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwakasika Hanani, umwi wabakwesu, abamwi bantu ibakazwide mucisi ca-Juda. Nkabela ndakababuzya makani aaba-Juda ibakasyaala, ibakazwide mubuzike, amakani aa-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        },
