                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Koibaluka ijwi ndyokalailila mulanda wako Musa lyakuti, Na mwasotoka mulao, njoomumwaisya akati kabamasi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
