                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Milimo yesu njitwacita kumeso aako njabuyo. Tatuna kubamba milazvo amilao ambeta nzowakalailila mulanda wako Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.7",
