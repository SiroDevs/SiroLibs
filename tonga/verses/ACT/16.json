  "reference": "Incito 16",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ACT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakasika ku-Derbe aku-Lustra, oko kwakali sikwiiya uutegwa Timoteo, mwana amukaintu mu-Juda musyomi, pele wisi wali mu­ Helene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakali empuwo mbotu kulibabunyina bamu-Lustra amuIkoniyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo wakamuyanda oyo kuti bainke awalo, nkabela wakamutola wamupalula nkaambo kaba-Juda abakali kulaayo masena, nkaambo boonse bali kuzi wisi wali mu-Helene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nobakali kuya bwiinda muminzi, bali kubapa milao iyakaambwa baapostolo abapati bamu-Jerusalemu, kuti biicite. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo imbungano zyakayumizigwa kulusyomo, akuvuzigwa mazuba oonse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakainda mucisi ca-Frigiya eca-Galatiya, bakakasigwa Muuya Uusalala kwaamba makani mu-Asiya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobakasika kumbali a-Musiya, bati kasoleke kunjila mu-Bituniya, kwalo Muuya wa-Jesu tuukabazuminide, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela ku-Musiya bakaindilila buyo, baselemuka kuya ku-Trowa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.8",
            "verseOrgIds": [
              "ACT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno masiku Paulo wakasikilwa cilengaano. Mwaalumi waku-Makedoniya wakaliimvwi, ulamukombelela kuti, Zubukila ku-Makedoniya, utugwasye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.9",
            "verseOrgIds": [
              "ACT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakabona cilengaano, ndilyonya twakasoleka kuya ku-Makedoniya, twali kusyoma kuti Leza ngowakatwiita kuti tukabakambaukile Makani Mabotu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notwakazwa ku-Trowa abwaato, twakalulama kuya ku-Samotrake, buce ku-Niapoli, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.11",
            "verseOrgIds": [
              "ACT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuzwa oko twakaya ku-Filipi, kumunzi wamu-Makedoniya, walo ngomunzi mupati wamucisi eco, mobali kukala ba-Roma. Mulooyo munzi twakali kulyokezya mazuba amwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubuzuba bwa-Sabata twakazwa mumunzi, twainka kumbali amulonga, nkotwali kuyeeya kuti nkokukombelwa, nkabela twakakala twakambaukila bakaintu abakali kubungene, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno kwakali mukaintu umwi uwakali kuswiilila uutegwa Ludiya, uwali sikuuzya masila aasia, wakumunzi wa-Tiyatira, uwali kukomba Leza. Mwami wakajula moyo wakwe kuti aswiililisye kukukambauka kwa-Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.14",
            "verseOrgIds": [
              "ACT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakabapatizigwa walo abeŋanda yakwe, wakatukumbilisya kuti, Na mwati ndisyomekede ku-Mwami amunjile muŋanda yangu, mukale. Wakatukombekzya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo notwakali kuya kubusena bukombelwa, twakaswaana musimbi uwali amuuya wakusonda, uwakavubya basimalelaakwe akusonda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakacilila Paulo aswebo, uloompolola kuti, Aba bantu mbazike ba-Leza, Sijulu lyamajulu, abatukambaukila nzila yakufutuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.17",
            "verseOrgIds": [
              "ACT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakacita obo mazuba manjimanji. Kwalo Paulo wakapya moyo, wacebuka wati kumuuya, Muzina lya-Jesu Kristo ndakulailila kuti uzwe mulinguwe. Wakazwa nciconya eco ciindi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno basimalelaakwe nobakabona kuti impindu njobakali kulangilila yamana, bakajata Paulo a-Sila, akubakwelela munkuta kumbele lyabami, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobakabatola kubabetesi bakati, Aba bantu, mbobali ba-Juda, banyonyonganisya munzi wesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.20",
            "verseOrgIds": [
              "ACT.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "balaamba ziyanza nzotuteelede kuzitambula akuzicita, swebo toba-Roma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.21",
            "verseOrgIds": [
              "ACT.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya bantu bakababukila, ababetesi bakabazapawida zyakusama zyabo, balailila kuti baumwe milusu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakabauma mabunda mabunda bakabanjizya muntolongo, balailila uulindila ntolongo kuti abalindilisisye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.23",
            "verseOrgIds": [
              "ACT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo alaililwe obo, wakabanjizya muntolongo iili akati, waanga maulu aabo muziliba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo akati kamasiku ba-Paulo a-Sila bakali kukomba akwiimbila Leza nyimbo, abaange bali kubaswiilide. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.25",
            "verseOrgIds": [
              "ACT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya kwakaba muzunzumo mupati wenyika, kwakazunganyizigwa ntalisyo zyentolongo. Mpoonya milyango yoonse yakajuka, zyakaangunuka nkeetani zyabo boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.26",
            "verseOrgIds": [
              "ACT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uulindila ntolongo naakasinsimuka akubona milyango yentolongo ili bukwazi, wakasomona ceba lyakwe, wati kalijaye, mbwaakali kuyeeya kuti baange baloboka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.27",
            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo Paulo wakoompolola ejwi pati wati, Utalibisyi, mpotuli toonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakaita mimuni, wasotokela mukati ulazyangama, wawida kumatende aaba-Paulo a-Sila, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabagwisya wati, Nobami ino ndicirenzi kuti ndifutulwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakati, Syoma ku-Mwami Jesu, noti futulwe yebo abeŋanda yako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        },
        {
          "name": "verse",
