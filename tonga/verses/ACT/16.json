            "sid": "ACT 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wabatola nciconya ciindi eco camasiku, wabasanzya­ mabunda aabo. Ndilyonya wabapatizigwa antoomwe abana bakwe boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.33",
            "verseOrgIds": [
              "ACT.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabanjizya muŋanda yakwe akubapa cakulya, kaboteledwe kapati, abeŋanda yakwe boonse, mbobasyoma Leza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        }
