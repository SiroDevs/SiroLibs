              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobwakaca babetesi bakatuma bamapolisa bati, Amubaleke abo bantu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
