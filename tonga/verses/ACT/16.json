          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela uulindila ntolongo wakaambila Paulo majwi aya wati, Babetesi batuma kuti mulekwe, eno amuzwe, mwiinke muluumuno, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
