          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo Paulo wakati kulimbabo, Bakatuumina antangalala, katutakwe mulandu pe, swebo toba-Roma, batuniizya muntolongo. Eno bayanda kutugwisizya kumbali na? Ha! pe, ababoole beni, batugwisye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
