          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamapolisa bakatola majwi aya kubabetesi, balo bakayoowa nobakamvwa kuti mba-Roma, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
