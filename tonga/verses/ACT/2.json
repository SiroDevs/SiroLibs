              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonse basyomi bakali antoomwe, basanganya zyoonse nzobali kujisi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
