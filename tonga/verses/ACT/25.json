  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "ACT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Festo naakanjila mubwami bwakwe, munsi lyamazuba otatwe wakazwa mu-Kaisareya, wakaya ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya bapaizi basimu­ twe abapati baba-Juda bakabejelezya Paulo kulinguwe, bamukombelezya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.2",
            "verseOrgIds": [
              "ACT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakumbila cintu anguwe, cakuti amwiite aboole ku-Jerusalemu. Bakakanza kumulindilila kuti bamujaye munzila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.3",
            "verseOrgIds": [
              "ACT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Festo wakavuwa kuti, Paulo ulijiswi ku-Kaisareya, akuti, Amebo ndemwini ndaya nkuko kaba kaindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.4",
            "verseOrgIds": [
              "ACT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati, Aboobo abali abwami akati kanu katuya abalo, anooli kuli mulandu kumuntu ulya, bakamubike kaambo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.5",
            "verseOrgIds": [
              "ACT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.5",
            "verseOrgIds": [
              "ACT.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakakala abo mazuba aatakali kwiinda musanu mwaatatu naaba ikumi, wakainka ku-Kaisareya. Mpoonya nobwakaca wakakala acuuno cakubetekela, walailila kuleta Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.6",
            "verseOrgIds": [
              "ACT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakasika walo, ba-Juda bakazwa ku-Jerusalemu­, bakamwiiminina mumbali, bamubika milandu minjiminji milemu njobatakonzya kusinizya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.7",
            "verseOrgIds": [
              "ACT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anu Paulo kukulyaambilila wakati, Nsikabisizye cintu, nuuba mulao waba-Juda, nemuba muntempele, naba Kaisara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.8",
            "verseOrgIds": [
              "ACT.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Festo mbwaakayanda kulumbwa ba-Juda, wakavuwa Paulo wakati, Sena ulayanda kwiinka ku-Jerusalemu, ukabetekelwe nkuko kumbele lyangu emilandu eyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.9",
            "verseOrgIds": [
              "ACT.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo wakati, Ndiliimvwi kumbele lyacibetekelo ca­-Kaisara, kuleelede kuti ndibetekwe mpoonya. Nsibisizye cintu kuba-Juda, oku ulizi kabotu ayebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.10",
            "verseOrgIds": [
              "ACT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anooli ndakabisya akucita cintu iceelede kufwa, nsikaki kufwa pe. Kwalo na taawo makani aya ngobandibika kaambo, taakwe muntu uukonzya kundyaaba kulimbabo. Ndalisisya kuli-Kaisara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.11",
            "verseOrgIds": [
              "ACT.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya Festo, naakaambaula abasilubeta, wakavuwa kuti, Walisisya kuli-Kaisara, ndazumina ulainka kuli-Kaisara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.12",
            "verseOrgIds": [
              "ACT.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.12",
            "verseOrgIds": [
              "ACT.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakainda mazuba amwi, Mwami Agripa a-Bemike, bakasika kuKaisareya, bazooanzya Festo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.13",
            "verseOrgIds": [
              "ACT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mbobakakala oko mazuba manji, Festo wakaambila mwami makani aa-Paulo wakati, Nkwali muntu ngwaakasia Felike ulaangidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.14",
            "verseOrgIds": [
              "ACT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nendakali ku-Jerusalemu, bapaizi basimutwe abapati baba-Juda bakamubika kaambo, bakakumbila kuti apegwe mulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.15",
            "verseOrgIds": [
              "ACT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabavuwa kuti, Tacili ciyanza caba-Roma kwaaba muntu uubikwa kaambo, katana kulangana abaabo abamubika kaambo, akujana ciindi cakulyaambilila mulandu ngobamupede. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.16",
            "verseOrgIds": [
              "ACT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo nobakabungana okuno nsikamukide, pele nobwakaca ndakakala acibetekelo, ndalailila kuti bamulete oyo mwaalumi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.17",
            "verseOrgIds": [
              "ACT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno nobakanyamuka abo abamubika kaambo tabakaambide mulandu wazibi mbuli nzendakali kweezeezya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.18",
            "verseOrgIds": [
              "ACT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bakamwaamba emibuzyo imwi yenkombelo yabo beni, eyamuntu uutegwa Jesu, mufu ngwasinizya Paulo kuti muumi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.19",
            "verseOrgIds": [
              "ACT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mebo, mbwendakazingwa kubuzisya makani aali boobo, ndakabuzya na ulayanda kuya ku-Jerusalemu kuyoobetekelwa nkuko makani aya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.20",
            "verseOrgIds": [
              "ACT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Paulo naakakumbila kuti asisigwe kulubeta lwamwami mupati, ndakalailila kuti alindilwe, mane nkamutumine kuli-Kaisara, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.21",
            "verseOrgIds": [
              "ACT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agripa wakati kuli-Festo, Amebo ndayanda kumumvwa oyo muntu. Wateeti, Ijunza mulamumvwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobwakaca Agripa a-Bemike bakasika abulemu bupati, bakanjila omo muswiilililwa, antoomwe abasilumamba bapati abaalu bamumunzi, nkabela Festo wakalailila kuti bakamulete Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.23",
            "verseOrgIds": [
              "ACT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya Festo wakateeti, O mwami Agripa, anywebo nyoonse nobaalumi nomuli aswebo ano, mwamubona oyu muntu ngwendakakumbilwa boonse ba-Juda, aku-Jerusalemu akookuno, bakoompolola bakati, Teelede kuti kacipona, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.24",
            "verseOrgIds": [
              "ACT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mebo ndakajana kuti taakwe ncaakacita iceelede lufu, alimwi mwini mbwaakalisisya kumwami mupati ndakakanza kumutuma, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.25",
            "verseOrgIds": [
              "ACT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno nsijisi ijwi ilisinizizye lyakulembela mwami aanguwe. Ncendamuletela kumbele lyanu, akapati kumbele lyako O mwami Agripa, kuti mwamubuzisisya ndijane cakulemba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.26",
            "verseOrgIds": [
              "ACT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndati mbufubafuba kutuma mwaange, kotalungulwide milandu niabikilwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.27",
            "verseOrgIds": [
              "ACT.25.27"
            ]
          }
        }
      ]
    }
  ],
