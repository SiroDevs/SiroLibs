  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ACT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mumbungano yaku-Antiokeya kwakali basinsimi abaiyi: baBarnaba a-Sumeoni uutegwa Nigeri, a-Lukiya mu-Kurene, a-Manayeni uwakakomena antoomwe amwami Heroda, a-Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.1",
            "verseOrgIds": [
              "ACT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakali kucita milimo ya-Mwami akuliimya kulya, Muuya Uusalala wakati, Ndilekele eno ba-Barnaba a-Saulo kumulimo ngwendabaitila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.2",
            "verseOrgIds": [
              "ACT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nobakaliimya kulya akukomba, akubabika maanza, bakabatuma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balo mbobakatumwa Muuya Uusalala, bakaselemuka kuya ku-Selukeya, kuzwa oko bainka abwaato ku-Kupro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.4",
            "verseOrgIds": [
              "ACT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakasika ku-Salami bakaamba makani aa-Leza muzikombelo zyaba-Juda, bakali a-Johane, mugwasyi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.5",
            "verseOrgIds": [
              "ACT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakaandulula mucilwa coonse mane kusikila ku-Pafo, bakajana musonzi, musinsimi mucengi, mu-Juda uutegwa Baŋesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.6",
            "verseOrgIds": [
              "ACT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwakakede kumweendelezi­ wacisi, Sergio Paulo, mwaalumi musongo, Walo wakaliitila ba-Barnaba a-Saulo, wali kuyanda kuswiilila makani aa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.7",
            "verseOrgIds": [
              "ACT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Elima musonzi (nkaambo mbolibede zina lyakwe nolisandulwa) wakabakasya, wali kuyanda kulesya mweendelezi kulusyomo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.8",
            "verseOrgIds": [
              "ACT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo Saulo, ngo-Paulo, mbwaakazywide Muuya Uusalala, wakamulangisisya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.9",
            "verseOrgIds": [
              "ACT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wati, Yebo yoomwana a-Saatani, oozywide luuni loonse amaanu mabi oonse, oolwanya bululami boonse, sena tokooleka kulengawida nzila ziluleme zya-Mwami? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.10",
            "verseOrgIds": [
              "ACT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno bona, ijanza lya-Mwami lili atala lyako, ulaba moofu, tokoobona zuba kaindi. Ndilyonya lwakamuwida luubi amudima, wali kweendeenda ulayandaula uumutembaizya ejanza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.11",
            "verseOrgIds": [
              "ACT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mweendelezi naakabona cakacitwa wakasyoma, wayoowa kukwiisya kwa-Mwami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Paulo ambaakali abo bakazwa ku-Pafo abwaato, bakainka ku-Perge wamu-Pamfiliya, pele Johane wakabasia, wabweeda ku-Jerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.13",
            "verseOrgIds": [
              "ACT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balo bakaindilila kuzwa ku-Perge, beza ku-Antiokeya wamu-Pisidiya. Buzuba bwa-Sabata bakanjila mucikombelo, bakala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.14",
            "verseOrgIds": [
              "ACT.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokwakamana kubalwa kumulao akubasinsimi, bapati bacikombelo bakatuma kulimbabo bati, Nobaalumi bakwesu anooli mujisi majwi aakulaya bantu amwaambe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.15",
            "verseOrgIds": [
              "ACT.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Paulo wakanyamuka, watambika janza wati,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.16",
            "verseOrgIds": [
              "ACT.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobaalumi ba-Israyeli, anywebo nomuyoowa Leza, amuswiilile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.16",
            "verseOrgIds": [
              "ACT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leza wabantu aba ba-Israyeli wakasala matateesu akusumpula bantu nobakacili kukede mucisi ca-Egepita, wakabagwisya mulincico ejanza ijumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.17",
            "verseOrgIds": [
              "ACT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabalela mbuli wisi munkanda myaaka yati kabe makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.18",
            "verseOrgIds": [
              "ACT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakamwaya zisi izyali musanu muzibili munyika ya-Kanana, wakabakonya nyika yabo, kutola kumyaaka yati kabe myaanda yone amakumi osanwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.19",
            "verseOrgIds": [
              "ACT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "munsi lyakooko wakabapa babetesi mane kusikila kuli-Samueli musinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakakumbila mwami, Leza wakabapa Saulo mwana wa-Kisi, mwaalumi wamukowa wa-Benjamini, wakabalela myaaka iili makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.21",
            "verseOrgIds": [
              "ACT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakamugwisya walo, wakabika Davida kuti abe mwami wabo. Ngonguwe ngwaakasinizya kuti, Ndijene Davida, mwana wa-Jese, mwaalumi wakumoyo wangu, uyoocita zyoonse nzenjanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.22",
            "verseOrgIds": [
              "ACT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulunungu lwayooyu muntu Leza, mbubonya mbwaakasyomezya, waleta kuli-Israyeli Mufutuli, ngu-Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.23",
            "verseOrgIds": [
              "ACT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katanasika walo, Johane wakakambaukide kale lubapatizyo lwakusanduka kubantu boonse ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.24",
            "verseOrgIds": [
              "ACT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Johane nati kamanizye lweendo lwakwe wakati, Mweezeezya kuti ndimeni ino? Endime oyo pe. Kwalo uleza munsi lyangu oyo ngwenteelede kwaangununa ndyasyo zyakumatende aakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakwesu, bana baluzubo lwa-Abrahamu, abalo abali akati kanu abayoowa Leza, kulindiswe nkwaakatuminwa makani aalufutuko olu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abakala mu-Jerusalemu, abeendelezi babo, kabatamuzi walo naaba majwi aabasinsimi aabalwa muma-Sabata oonse, bakaacita kukumujanya mulandu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "anobatakajana mulandu wakuti afwe, nokubaboobo bakakumbila Pilato kuti ajayigwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.28",
            "verseOrgIds": [
              "ACT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakazyulizya zyoonse izyakalembwa aanguwe, bakamugwisya acisamu, bamubika mucuumbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo Leza wakamubusya kubafu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mazuba manjimanji wakabonwa kulibaabo mbaakazwa abo ku-Galilaya kuya ku-Jerusalemu, sunu mbabakamboni bakwe kubantu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno swebo twamuletela makani mabotu aacisyomezyo ncobakapegwa bamatateesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "eco Leza wakacizuzya kulindiswe tobana babo mbwaakabusya Jesu, mbubonya mbokulembedwe mulwiimbo lwabili kuti, Yebo uli mwanaangu, sunu ndakuzyala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumakani aakumubusya kwakwe kulufu kuti katacipiluki limbi kukubola wakaamba obo wati, Ndiyoomupa nywebo coolwe cisalala cisinizizye ca-Davida. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.34",
            "verseOrgIds": [
              "ACT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mulwiimbo lumwi wakati, Tokoozumina kuti Uusalala wako abone kubola, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Davida, naakamana lukanzo lwa-Leza mucizukulu cakwe mwini, wakafwa, wazikwa kumawisi, wabola, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.36",
            "verseOrgIds": [
              "ACT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwala oyo ngwaakabusya Leza takabolede pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo nobakwesu, amuzibe kuti nkaambo kayooyo mwaambilwa kujatilwa kwazibi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.38",
            "verseOrgIds": [
              "ACT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "alimwi nkaambo kakwe umwi umwi uusyoma ulalulami-kwa zyoonse nzomwatakali kukonzya kululamikilwa nzizyo kumulao waMusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.39",
            "verseOrgIds": [
              "ACT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaako amucenjele kuti mutasikilwi eco icakaambwa musinsimi kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.40",
            "verseOrgIds": [
              "ACT.13.40"
            ]
          }
        }
      ]
    },
