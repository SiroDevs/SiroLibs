{
  "id": "ACT.19",
  "number": "19",
  "bookId": "ACT",
  "reference": "Incito 19",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "ACT 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Apolo naakacili ku-Korinto, Paulo wakaandulula mucisi icitabambene alwizi, wasika ku-Efese, waakujana basikwiiya bamwi oko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakababuzya kuti, Sena mwakatambula Muuya Uusalala nomwakasyoma? Balo bakamuvuwa bakati, Totwakalina akumvwa kuti a-Muuya Uusalala mpuuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati, Ino ndubapatizyonzi lwanu? Bakavuwa kuti, Ndubapatizyo lwa-Johane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo wakateeti, Ena, Johane wakabapatizya alubapatizyo lwakusanduka, wali kwaambila bantu kuti basyome kulooyo uuza munsi lyakwe, nkokuti nguwenya Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nobakamvwa obo, bakabapatizigwa muzina lya-Mwami Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.5",
            "verseOrgIds": [
              "ACT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Paulo naakabika maanza alimbabo, Muuya Uusalala wakabaselukila bakaamba emilaka, basinsima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.6",
            "verseOrgIds": [
              "ACT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno abo boonse bati kabe baalumi abali kumi mubabili.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakanjila mucikombelo, wakakambauka ecamba myeezi yotatwe, ulasandulana akukombelela makani aa-Bwami bwa-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.8",
            "verseOrgIds": [
              "ACT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bamwi nobakaliyumya-yumya, akukaka, akusampaula nzila eyo kumbele lyabantu, wakabasia, watola basikwiiya, mazuba oonse wali kwaambaula mucikolo ca-Turano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.9",
            "verseOrgIds": [
              "ACT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakacitwa obo myaaka yobile, aboobo boonse abakakede mn-Asiya bakamvwa makani aa-Mwami, ba-Juda aba-Helene, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Leza wakacita malele mapati amaanza aa-Paulo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.11",
            "verseOrgIds": [
              "ACT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwakatolwa kubalwazi tusila utwali kuzwa amubili wakwe, nkabela zilwazi zyabo zyakapona, emyuuya iisofweede yakazwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo bamwi ba-Juda abeendeenda, basikutanda basikazwa, bakalibwezela kwaamba zina lya-Mwami Jesu atala lyabaabo abakali amyuuya mibi bakati, Ndamulailila muli-Jesu ngwakambauka Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.13",
            "verseOrgIds": [
              "ACT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno kwakali baalumi abali musanu mubabili, bana ba-Skeva, mu-Juda, mupaizi mupati, abakali kucita obo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele muuya mubi wakavuwa wakati, Jesu ndilimuzi a-Paulo ndimuzi, pele nywebo ndinywe bani ino? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya mwaalumi oyo uwakanjidwe muuya mubi wakabasotokela, wakaba anguzu kwiinda boonse bobile, wabazunda, batija kuŋanda eyo, bali ezinswe eziliciso. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makani ayo akazibwa kulimbabo boonse abakakede mu-Efese, ba-Juda aba-Helene, Boonse bakayoowa, izina lya-Mwami Jesu lyakalemekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.17",
            "verseOrgIds": [
              "ACT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanjibanji abakasyomede bakaboola, balazumina akutondezya milimo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.18",
            "verseOrgIds": [
              "ACT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi banjibanji abakali basonzi bakabungika mabbuku aabo, bakaatenta kumbele lyabo boonse. Kwakabalwa mali aabukwebo bwao, kwakajanwa kuti mbwamasiliva aali myaanda yosanwe yemyaanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbombubo obo makani aa-Mwami mbwaakakomena akuzunda enguzu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nozyakamana ezi zintu Paulo wakakanza mumoyo wakwe kuti, aakwiinda mu-Makedoniya amu-Akaya, uyooinka ku-Jerusalemu wakati, Ndaakusika oko, ndileelede kuyoobona aku-Roma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakatuma bobile babagwasyi bakwe, Timoteo a-Erasto, kuya ku-Makedoniya, walo wakacili kukede mu-Asiya kaindi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno kuciindi eco kwakaba lupyopyongano lupati nkaambo kenzila ya-Mwami, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.23",
            "verseOrgIds": [
              "ACT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakali muntu uutegwa Demetriyo, mufuzi wensiliva, uwakacita tukombelo twensiliva twa-Diana, akuvubya basimilimo mali manji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.24",
            "verseOrgIds": [
              "ACT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakababunganya balo, antoomwe abaabo abakali kubeleka mulimo uukozyene ayooyo wakati, Nobaalumi, mulizi kuti kumulimo oyu nkotujana buvubi bwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.25",
            "verseOrgIds": [
              "ACT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mwabona akumvwa kuti Paulo ulya ulakombelezya akufutamuna bantu banjibanji, abatali baku-Efeso kulike, pele kuti kukabe amu-Asiya moonse, ulati abacitwa amaanza tabali baleza pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.26",
            "verseOrgIds": [
              "ACT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno tuuli mulimo wesu walo uti zululwe, pele ecalo cikombelo camuzimo mupati Diana cilaba cintu buyo, mane awalo ugwisigwe kubulemu bwakwe, ngobakomba bamu-Asiya boonse abamunyika yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobakamvwa obo, bakazula bukali, bakoompolola bakati, Diana waba-Efeso mupati, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.28",
            "verseOrgIds": [
              "ACT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya munzi woonse wakazyula lupyopyongano, bakazuzaana amoyo omwe kuya kucibunganino, bajata Gayo a-Aristarko, baalumi baku-Makedoniya, abakasindikide Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.29",
            "verseOrgIds": [
              "ACT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Paulo nati kanjile kubantu, basikwiiya tabakamuzuminide. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.30",
            "verseOrgIds": [
              "ACT.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo bamwi bapati bamu-Asiya, beenzinyina Paulo, bakatuma kulinguwe kuyoomukumbila kuti atalibonyi mucibunganino. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.31",
            "verseOrgIds": [
              "ACT.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo bamwi bakoompolola cimwi, abamwi icimbi, nkaambo imbungano yakalipyopyongene, banjibanji tabakalizi ncobakali kubunganine. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.32",
            "verseOrgIds": [
              "ACT.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno bakagwisya Alesandro kubantu, aba-Juda bamutonkela kumbele. Nkabela Alesandro wakatambika janza, wati kalyaambilile kubantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.33",
            "verseOrgIds": [
              "ACT.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nobakaziba kuti mu-Juda, boonse bakaba ciwi lyomwe, baloompolola mane ati kainde maola obile balati, Diana waba-Efeso mupati! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo simagwalo wamumunzi naakabaumuzya bantu wakateeti, Nobaalumi bamu-Efeso, nguni muntu uutezi kuti munzi waba-Efeso ngonguwo uubamba cikombelo ca-Diana mupati, ecikozyano icakawa kuzwa kujulu? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.35",
            "verseOrgIds": [
              "ACT.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mbwaataka-zigwa makani aya, nywebo mweelede kuumuna, mutaciti cakufwanzya-fwanzya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.36",
            "verseOrgIds": [
              "ACT.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo mwaleta baalumi aba, abatabbi muzikombelo, nobaba abasampaula muzimo wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.37",
            "verseOrgIds": [
              "ACT.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaako na ba-Demetriyo abasimilimo mbali abo banoojisi makani aamuntu, mazuba mpaali aakubeteka mulandu, ababetesi mpobali, kabazangana lwabo beni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.38",
            "verseOrgIds": [
              "ACT.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mwanoojisi makani amwi ngomubuzya, ayookosolwa mumbungano iielede, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.39",
            "verseOrgIds": [
              "ACT.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo ncobeni twati bikwe mulandu walupyopyongano lwabuzuba buno nkaambo taakwe ncolweelede pe, alimwi taakwe ncotukonzya kuvuwa akubungana oku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.40",
            "verseOrgIds": [
              "ACT.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakamana kwaamba obo wakamwaisya mbungano.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.41",
            "verseOrgIds": [
              "ACT.19.41"
            ]
          }
        }
      ]
    }
  ],
