                "loc": "ROM.7.2"
              },
              "items": [
                {
                  "text": "Rom 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakazi ulaangidwe kumulumaakwe ciindi ncacipona, pele afwa mulumi, ulilubukide kukwatana kufumbwa ngwayanda, nkukuti na munaKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo cilainda kubota kuti wakala mbuli mbwabede. Mbuboobu mbunjeeya mebo, nkabela ndasyoma kuti ambebo ndijisi Muuya wa-Leza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
