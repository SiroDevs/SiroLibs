                "loc": "MRK.10.11+MRK.10.12"
              },
              "items": [
                {
                  "text": "Mk 10:11-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.18"
              },
              "items": [
                {
                  "text": "Lk 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulibaabo bakwete kale ndalailila boobo, nkabela teensi ndime endailila, ngu-Mwami, Mwanakazi teelede kulekana amulumaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.10",
            "verseOrgIds": [
              "1CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti ulimulekede kale, uleelede kukala katakwetwe, nanka kuyanzana amulumaakwe. Alakwe mwaalumi teelede kuleka mukaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.11",
            "verseOrgIds": [
              "1CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bantu bamwi ndabaambila boobo. (Majwi aya ngaangu ndemwini, teensi aa-Mwami). Akuli umwi sibunyina uujisi mukaakwe uutali muzumini, lino moyo wakwe wanooyanda kukala kulinguwe, atamuleki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.12",
            "verseOrgIds": [
              "1CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi, akuli umwi mwanakazi uujisi mulumaakwe uutali muzumini, lino moyo wakwe wanooyanda kukala kulinguwe atamuleki, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.13",
            "verseOrgIds": [
              "1CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.16"
              },
              "items": [
                {
                  "text": "Rom 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mulumi uutali muzumini ulasalazigwa kumukaakwe, alakwe mukazi uutali muzumini ulasalazigwa kumulumaakwe. Kwatakuli boobo bana banu nibatasalali, anukuti lino balasalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.14",
            "verseOrgIds": [
              "1CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.19"
              },
              "items": [
                {
                  "text": "Rom 14:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti sikutazumina ulayanda kulekana, mbubo, balekane, Kwakuli boobo, sibunyina naba mwaalumi naba mwanakazi taangidwe kulukwato, Nduumuno ndwaakatwiitila Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.15",
            "verseOrgIds": [
              "1CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Pet 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo webo, mwanakazi, sa tozi kuti inga ulafutula mulumaako? Ayebo, mwaalumi, sa tozi kuti inga ulafutula mukaako?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.16",
            "verseOrgIds": [
              "1CO.7.16"
            ]
          }
        }
      ]
