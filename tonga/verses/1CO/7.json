            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.7",
            "verseOrgIds": [
              "1CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele abo batakwete, abalo bamukabafu, ndabaambila kuti ncibotu kulimbabo kuti bakale obo, mbuli ndime ndemwini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.8",
            "verseOrgIds": [
              "1CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.14"
              },
              "items": [
                {
                  "text": "1 Tim 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo kuti tabakonzyi kulyeendelela, bakwate, nkaambo kukwata nkubotu kwiinda kufwa luunyaunya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.9",
            "verseOrgIds": [
              "1CO.7.9"
            ]
          }
        }
      ]
    },
    {
