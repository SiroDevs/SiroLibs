                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi aumwi aende mbubonya mbwaabilwa mulimo wakwe kwa-Leza, akale mbwaakabede kuciindi Leza ncaakamwiita, Mbuboobu mbundailila mumbungano zyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.17",
            "verseOrgIds": [
              "1CO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa kufumbwa muntu wakali mupalule ciindi ncakaitwa? Atabweedezyi lulomo lwakwe, Sa kufumbwa muntu wakali silulomo ciindi ncaakaitwa? Atapalulwi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.18",
            "verseOrgIds": [
              "1CO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
