              "type": "tag",
              "attrs": {
                "loc": "PHM.1.16"
              },
              "items": [
                {
                  "text": "Flm 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo oyo iwakali muzike kuciindi ncaakaitwa mu-Mwami ngumulubusi wa-Mwami. Mbubonya obo alakwe iwakali mulubusi kuciindi ncaakaitwa ngumuzike wa-Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.22",
            "verseOrgIds": [
              "1CO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaakaulwa muulo. Nkaambo kaako mutabi bazike babantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.23",
            "verseOrgIds": [
              "1CO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwi aumwi, bakwesu, uleelede kukala kubusyu bwa-Leza mbubonya mbwaakabede kuciindi ncaakaitwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.24",
            "verseOrgIds": [
              "1CO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
