                "loc": "GAL.5.6"
              },
              "items": [
                {
                  "text": "Gal 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.15"
