              "items": [
                {
                  "text": "6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.25"
              },
              "items": [
                {
                  "text": "Rom 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bupalule tabukwe makani, alwalo lulomo talukwe makani. Kulomya milazyo ya-Leza nkokujisi makani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.19",
            "verseOrgIds": [
              "1CO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muntu akale mbubonya mbwaakabede ciindi ncaakaitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.20",
            "verseOrgIds": [
              "1CO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na koli muzike nowakaitwa, taakwe makani, Pele kuti kokonzya kuba mulubusi, konaba boobo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.21",
            "verseOrgIds": [
              "1CO.7.21"
            ]
          }
        },
