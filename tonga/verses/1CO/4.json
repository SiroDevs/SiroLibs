              },
              "items": [
                {
                  "text": "Tit 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu muntu mbweelede kutweelezya, kuti tuli balanda ba-Kristo, alimwi tuli babanzi bamakani aa-Leza aasisidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.1",
            "verseOrgIds": [
              "1CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.42"
              },
              "items": [
                {
                  "text": "Lk 12:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kumakani aababanzi, cintu ciyandwa nceeci, kuti muntu asyomeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.2",
            "verseOrgIds": [
              "1CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele kulindime makani maniini buyo kulingulwa kulindinywe nikuba kulubeta lwabantu, Ncobeni nsililinguli ndemwini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.3",
            "verseOrgIds": [
              "1CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Int 143:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nsiliboni kaambo, nekubaboobo teensi boobo mbundulamikidwe pe. Mwami nguundilingula. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.4",
            "verseOrgIds": [
              "1CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.8"
              },
              "items": [
                {
                  "text": "1 Kor 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako, mutabeteki cintu niciba cimwi, ciindi nicitana kusika, mane do asike Mwami. Walo uleza kuzoomunika zintu zisisidwe zyamumudima akuyubununa makanze aamyoyo, elyo umwi aumwi uzoojana lutembaulo kuliLeza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.5",
            "verseOrgIds": [
              "1CO.4.5"
            ]
          }
        }
      ]
    },
    {
