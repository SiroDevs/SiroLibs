              },
              "items": [
                {
                  "text": "Gal 4:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nimwaakuli abasimalelo bali zyuulu zyuulu muli-Kristo, bauso banu tabali banji pe, nkaambo ndime ndamuzyazya Makani Mabotu muli-Kristo Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.15",
            "verseOrgIds": [
              "1CO.4.15"
            ]
          }
        },
