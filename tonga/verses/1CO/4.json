              "items": [
                {
                  "text": "22:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkabela ciindi ncitutukilwa tulakombelezya. Lyoonse buyo twacitwa mbuli bukololo bwanyika yoonse ambuli itombe lyazintu zyoonse.",
          "type": "text",
