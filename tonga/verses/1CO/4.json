            }
          ]
        },
        {
          "text": "Teensi kumuusya bweeme nkundembela makani aya pe, pele ndamulaya buyo mbuli bana bangu bayandika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.14",
            "verseOrgIds": [
