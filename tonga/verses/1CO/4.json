                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Rom 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino aya makani, nubakwesu, ndaabikila kulindiswe, mebo a-Apolo, kukugwasya ndinywe kuti mukaiye kulindiswe ijwi lyakuti, Mutaindi ayo makani aalembedwe, alimwi kuti mutalisumpwidi umwi kwiinda mweenzinyina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.6",
            "verseOrgIds": [
              "1CO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6"
              },
              "items": [
                {
                  "text": "Rom 12:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nguni uukunomona? Alimwi sa kuli cintu ncojisi ncotapedwe? Nkabela kuti wakapegwa, lino nkaambonzi ulalisumpula mbuli citali kupegwa buyo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.7",
            "verseOrgIds": [
              "1CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.17"
              },
              "items": [
                {
                  "text": "Ciy 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma! mwakuta kale sa? mwaba bavubi kale sa? mwajana bwami nubeni katutako swebo sa? nimwajana bwami ncobeni, aswebo nitwaba baaminyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.8",
            "verseOrgIds": [
              "1CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.36"
              },
              "items": [
                {
                  "text": "Rom 8:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.33"
              },
              "items": [
                {
                  "text": "Heb 10:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ndayeeya kuti Leza ulitubikide basyaalizi, swebo tubaapostolo, mbuli abo bati fwe. Twaba ceebelo kumeso aabalengwi boonse, nibaba baangelo nibaba bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.9",
            "verseOrgIds": [
              "1CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.18"
              },
              "items": [
                {
                  "text": "1 Kor 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Swebo tuli bafubafuba nkaambo ka-Kristo, anukuti nywebo muli basongo muli-Kristo, Swebo tuli bakompami, nywebo muli basinguzu. Nywebo muli abulemu, swebo tuli basampausi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.10",
            "verseOrgIds": [
              "1CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.23+2CO.11.24+2CO.11.25+2CO.11.26+2CO.11.27"
              },
              "items": [
                {
                  "text": "2 Kor 11:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikuba kusikila kuciindi ecino tulafwa nzala, tulafwa nyota, tulapenga zyakusama, tuladinkaulwa, tuli basimutuntuli buyo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.11",
