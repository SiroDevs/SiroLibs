                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakwesu ndayanda kuti mutalubi aya, Bamawiseesu boonse bakali kunsi lyakumbi, alimwi boonse bakainda akati kalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.1",
            "verseOrgIds": [
              "1CO.10.1"
            ]
          }
        },
        {
