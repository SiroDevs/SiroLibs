                  "text": "1 Tim 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mebo nindalya cakulumba, ino nkaambonzi nintongaukilwa kulya zilyo ezyo nzindumbide?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
