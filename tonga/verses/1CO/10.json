              "items": [
                {
                  "text": "Dt 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Boonse bakalya cilyo comwe camuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.3",
            "verseOrgIds": [
              "1CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
