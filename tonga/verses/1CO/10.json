                }
              ]
            }
          ]
        },
        {
          "text": "Lino aya makani atubeda incenjezyo, kuti tutabi mukususa zintu zibi mbubakasusa balo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
