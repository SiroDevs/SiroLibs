              },
              "items": [
                {
                  "text": "29-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo banji akati kabo, Leza teewakabakondelwa pe, bakagwisigwa munkanda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
            "verseOrgIds": [
              "1CO.10.5"
            ]
          }
        }
