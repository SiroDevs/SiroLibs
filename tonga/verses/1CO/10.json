                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mutatongauki mbuli mbubakatongauka bamwi babaabo, bakanyonyoonwa kuli-Sikunyonyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
