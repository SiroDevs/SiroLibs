            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubo, nobayandwi bangu, amucije kukomba mituni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
