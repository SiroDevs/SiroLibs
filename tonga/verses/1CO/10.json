                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa kanywido kakulumba nkotulumba takeensi kaluswanaano lwabulowa bwa-Kristo Awalo mukamu nguutukomona sa taweensi waluswanaano lwamubili waKristo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.16",
            "verseOrgIds": [
              "1CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
