                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti umwi wamwaambila kuti, Eyi nyama njacipaizyo camituni, elyo mutalyi pe, nkaambo kayooyo wamulwiida akaambo kamanjezeezya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
