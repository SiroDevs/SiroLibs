                "loc": "1PE.4.7"
              },
              "items": [
                {
                  "text": "1 Pet 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aya makani oonse akaba kulimbabo mbuli incenjezyo, akalembwa kuti acenjezye ndiswe nitusikilwa kumamanino aaciindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako oyo uuyeeya kuti ndiimvwi kabotu acenjele kuti atawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taakwe lutepauzyo lumusikila cita mbuli matepauzyo ngibajana bantu lyoonse, alimwi Leza wasyomeka, ikuti takoozoozumina kuti mutepaulwe kwiinda inguzu zyanu, pele antoomwe alutepauzyo ulacita cipolelo, kuti mukabe alukolelo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
