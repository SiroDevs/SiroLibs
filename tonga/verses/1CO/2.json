                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakeza kulindinywe cakukompama acakuyoowa acakuzyangama loko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
