              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela makani aangu ngendakakambauka kaatali amajwi aabusongo akusakamika matwi pe, pele alwiimiko lwa-Muuya alwanguzu, ",
          "type": "text",
          "attrs": {
