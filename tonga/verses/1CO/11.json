                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako, umwi aumwi uulya mukamu oyu, nikuba kunywa mucinywido eci, cakutaelela, ulijisi mulandu kumubili akubulowa bwa-Mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.27",
            "verseOrgIds": [
