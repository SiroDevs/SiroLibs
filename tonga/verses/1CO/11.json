                "loc": "GEN.3.16"
              },
              "items": [
                {
                  "text": "Matl 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndayanda kuti mukazibe aya. Mutwe wamwaalumi umwi aumwi ngu-Kristo, awalo mutwe wamwanakazi ngumwaalumi, awalo mutwe waKristo ngu-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.10"
              },
              "items": [
                {
                  "text": "1 Kor 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.1"
              },
              "items": [
                {
                  "text": "14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwaalumi umwi aumwi uukomba nanka kusinsima ulivumbide kumutwe ulaubausya mutwe wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anukuti mwanakazi uukomba nanka kusinsima atanoovumbidwe kumutwe ulaubausya mutwe wakwe, nkaambo ncintu comwe akubaanga waumpulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti mwanakazi wakaka kuvumbwa kumutwe, elyo agelwe. Pele kuti cilatondwa kumwanakazi kugelwa nanka kuumpulwa, mbubo, avumbwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        }
      ]
    },
    {
