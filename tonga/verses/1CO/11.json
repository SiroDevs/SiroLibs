                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikuti ciindi coonse kufumbwa ncimulya mukamu oyu akunywa cinywido eci munooyootondezya lufu lwa-Mwami mane do akasike, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
