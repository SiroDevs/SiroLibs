                  "text": "2 Kor 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele muntu asaangune kulilingula, elyo nati lye mukamu akunywida mucinywido. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
        {
