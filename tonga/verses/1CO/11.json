          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitwali kulibeteka tubeni, nitwatali kubetekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
