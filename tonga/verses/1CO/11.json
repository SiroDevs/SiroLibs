              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo oyo uulya akunywa, na tatweluki Mubili wa-Mwami, ulalya akunywa cakulibeteka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
