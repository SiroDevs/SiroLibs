                  "text": "1 Tes 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkikaako nkibalengaukila banji akati kanu, abamwi baciswa, nkabela bamwi bafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
