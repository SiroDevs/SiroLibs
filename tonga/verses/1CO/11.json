              "items": [
                {
                  "text": "Flp 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwiiye ndime, mbubonya mbuli ambebo mbundaiya Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamulumbaizya nkaambo kakuti lyoonse mulandiibaluka, alimwi mbuli mbundakamusiila tunsiyansiya, mulajatisya ntuto.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        }
      ]
    },
