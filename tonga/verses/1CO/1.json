              },
              "items": [
                {
                  "text": "3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndamukumbila, nubakwesu, muzina lya-Mwami Jesu Kristo, kuti mwaambe cintu comwe, kutabi mipampo mipampo akati kanu. Amube alukamantano lwamoyo omwe alwamiyeeyo yomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kwandisikila impuwo yandinywe, nubakwesu, iizwa kubantu ba-Kloe, yakuti kuli inkazyanyo akati kanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
