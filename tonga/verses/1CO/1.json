              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mt 28:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo teensi kubapatizya nkwaakanditumina Kristo pe, pele kukambauka Makani Mabotu, Alimwi teensi majwi aabusongo-songo nginjeelede kukambauka, pe, kuti ciingano ca-Kristo citasampuki.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
