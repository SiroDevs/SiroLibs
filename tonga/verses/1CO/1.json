                "loc": "1TH.5.24"
              },
              "items": [
                {
                  "text": "1 Tes 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.3"
              },
              "items": [
                {
                  "text": "1 Joh 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wasyomeka Leza, oyo iwakamwiitila muciinga ca-Mwanaakwe Jesu Kristo Mwami wesu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
