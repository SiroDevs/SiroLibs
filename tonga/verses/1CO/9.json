                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulibaabo bali anze ku-Mulao ndibede mbubabede (nintali anze ku-Mulao wa-Leza, ndi kunsi ku-Mulao wa-Kristo), kuti nkabavube abo bali anze ku-Mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.21",
            "verseOrgIds": [
              "1CO.9.21"
