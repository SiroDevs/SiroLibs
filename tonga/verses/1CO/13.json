          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikuba kuti ndaamba myaambo yabantu niiba yabaangelo, nekubaboobo nsijisi luyandisyo mumoyo wangu, elyo ndaba mbuli mulangu uulila buyo nanka cizyano cicokola-cokola. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mt 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.22"
              },
              "items": [
                {
                  "text": "7:22",
