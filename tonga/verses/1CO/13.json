                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.21"
              },
              "items": [
                {
                  "text": "21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.23"
              },
              "items": [
                {
                  "text": "Mk 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi kuti nindalijisi businsimi akuziba makani oonse aasisidwe aluzibo loonse, nindalijisi lusyomo lunji lwakuzyula malundu, nekubaboobo nsijisi luyandisyo, nsili muntu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.2"
              },
              "items": [
                {
                  "text": "Mt 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nindaabaula imbono zyangu zyoonse, nikuba kwaaba mubili wangu kukutentwa, nekubaboobo nsijisi luyandisyo, tacindigwasyi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luyandisyo lulakazika moyo akufwa luzyalo, Luyandisyo talukwe ibbivwe, talulikankaizyi, talulisumpuli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.17"
              },
              "items": [
                {
                  "text": "Zek 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.4"
              },
              "items": [
                {
                  "text": "Flp 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "talukwe cisapi, talulilangilili cintu, talufwambi kujata bukali, taluyeeyi inkoto yabubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.9"
              },
              "items": [
                {
                  "text": "Rom 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Talukondelwi zitaluleme pe, lulakondelwa lusinizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.6",
            "verseOrgIds": [
              "1CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.12"
              },
              "items": [
                {
                  "text": "Tus 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.12"
              },
              "items": [
                {
                  "text": "1 Kor 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.1"
              },
              "items": [
                {
                  "text": "Rom 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lulakolela makani oonse akuba alusyomo lyoonse, lulijisi bulangilizi lyoonse akuba acamba kumapenzi oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.8"
              },
              "items": [
                {
                  "text": "1 Pet 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Luyandisyo talweeli. Pele masinsimi alaloba, ayalo myaambo ilamana, alwalo luzibo lulaloba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo luzibo ndutujisi nduce-luce, akusinsima kwesu akwalo nkuce-kuce. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele aakusika malondosi elyo aya makani mace-mace alaloba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindakacili mucece, ndakali kwaamba macece akuyeeya macece akubuzyanya macece, pele sunu mbuli mbundaba mwaalumi, ndisowede macece. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.7"
              },
              "items": [
                {
                  "text": "2 Kor 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.23"
              },
              "items": [
                {
                  "text": "Jak 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo makani ngetubona sunu ali mbuli zintu zyamuciboniboni, ali mbuli kalabi, pele kuciindi ciboola tuzoobonana meso kumeso. Luzibo ndunjisi sunu nduce-luce buyo, pele kuciindi eco nzoozibisya mbubonya mbundazibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.1.3"
              },
              "items": [
                {
                  "text": "1 Tes 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.16"
              },
              "items": [
                {
                  "text": "1 Joh 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sunu alabedelela aya otatwe, lusyomo abulangizi aluyandisyo, pele akati kayaaya dpati nduyandisyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.13",
            "verseOrgIds": [
              "1CO.13.13"
            ]
          }
        }
