              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuciindi eco njoosandula mwaambo wabantu akubapa mwaambo uusalala, kuti boonse bakwiilile izina lya-Jehova akumumanina milimo camoyo woonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
