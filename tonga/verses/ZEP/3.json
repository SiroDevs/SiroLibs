                  "text": "Inc 8:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuzwa kule kwiinda milonga ya-Etiopiya, basikundikomba, bana babantu bangu bamwaikide, bazooleta zipaizyo zyangu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
