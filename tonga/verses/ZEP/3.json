            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kuliyooyo uusampaula, uusofweede, munzi uukataazya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.21"
              },
              "items": [
                {
                  "text": "Jer 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.3"
              },
              "items": [
                {
                  "text": "5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Teewakaswiilila ijwi, teewakazuminina lucenjezyo, teewakasyoma Jehova, teewakaswenenena kuli-Leza wawo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
