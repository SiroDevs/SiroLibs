            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.18"
              },
              "items": [
                {
                  "text": "Jer 26:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaaya majwi aa-Jehova aakasikila Mika waku-Morese muciindi caJotamu aca-Ahazi aca-Hezekiya bami ba-Juda, ngaakasinsima aa­ Samariya a-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile numisyobo yoonse. Teelela, O nyika azyoonse zili mumo. Mwami Jehova abe simulandunyoko. Mwami aambe makani kuzwa kuntempele yakwe iisalala. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.21"
              },
              "items": [
                {
                  "text": "Is 26:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.12"
              },
              "items": [
                {
                  "text": "Ezk 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.18"
              },
              "items": [
                {
                  "text": "Heb 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo amubone! Jehova ulapola kuzwa kucikalilo cakwe, ulaseluka kuzoolyataula amasena aasumpukide aanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilundu zilayaaya munsi lyakwe, amimpata ilaanduka, Zilaba mbuli bunzuka buumpwa amulilo, ambuli maanzi aatika ampwampwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.18"
              },
              "items": [
                {
                  "text": "Jer 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.5"
              },
              "items": [
                {
                  "text": "Hos 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ezi zyoonse nkaambo kamilandu ya-Jakobo azibi zyaluzubo lwa-Israyeli. Ncinzi milandu ya-Jakobo? Sa teensi Samariya? Azipaililo zya-Juda nzinzi? Sa tazyeensi Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.25"
              },
              "items": [
                {
                  "text": "2 Bam 19:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino njoocita kuti Samariya ibe mbuli bulimo bwamumuunda mwabyalwa masaansa. Mabwe aawo njooakunkulisya mumumpata, antalisyo zyawo zilaboneka. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela zikozyano zyakwe ziyootyolaulwa, zikombelo zyawo ziyootentwa mumulilo, azituni zyawo zyoonse ziyoosaalwa, nkaambo zipo zyabuvuule nzezyakazyuuzya lino zipo ezyo nzizyonya zyabuvuule zilabweeda kulinzizyo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kamakani aya njoomoka akulila, njooenda acinkuna akutasama insangu, njoomuka mbuli bamwaba akulila mbuzilila impo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.13"
              },
              "items": [
                {
                  "text": "2 Bam 18:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo zilonda zyakwe tazisilikiki, Catana ku-Juda, casika akumulyango wabantu bangu ku-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaambi makani mu-Gati. Kulila utalili pe. Ku-Beti-Afira (Munzi walusuko) kobumbuluka mulusuko, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uinke acinkuna abweeme nokede mu-Safira (Munzi wabweebesi). Utazwi nokede mu-Zanana (Munzi wakuzwa), Kulila kwa-Betezeli kuyoomunyanzya ciimikililo canu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakede mu-Maroti balalindila bubotu, nkaambo mapenzi aazwa kuli-Jehova asika akumulyango wa-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.12",
            "verseOrgIds": [
              "MIC.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.12",
            "verseOrgIds": [
              "MIC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anga imbizi kunkalaki, uwe nokede mu-Lakisi, Nduwe wakataangunina mwana musimbi wa-Zioni kubisya, Mulinduwe mwiijenwe milandu ya-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.13",
            "verseOrgIds": [
              "MIC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako ulapa Moresati Gati cipo cakulazya. Maanda aa-Akizibi (Munzi walweeno) ayooleta lweeno kubami ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.14",
            "verseOrgIds": [
              "MIC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoomuletela sikumusaala, nomukede mu-Maresa. Bulemu bwaIsrayeli bulaletwa aku-Adulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.15",
            "verseOrgIds": [
              "MIC.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.6"
              },
              "items": [
                {
                  "text": "2 Bam 17:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kolikulula akuligela nkaambo kabana bako bayandisi. Kokemezya cinkulu cako mbuli sikube, nkaambo bakusia, banjila mubuzike.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.16",
            "verseOrgIds": [
              "MIC.1.16"
            ]
          }
        }
      ]
    }
