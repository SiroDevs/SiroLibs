                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe kulibaabo bayeeya bubi akucita zibi nibalede amalo aabo. Buce buyo balacicita, nkaambo maanza aabo alacikonzya. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleemuzya myuunda akwiisaala, amaanda balaatola. Balapenzya mwaalumi aciinga cakwe, balakataazya muntu ambono zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.3"
              },
              "items": [
                {
                  "text": "Jer 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobo mbwaamba Jehova. Amubone! Ndayeeya kuletela luzubo olu mapenzi, nkabela tamukooyookonzya kugwisya insingo zyanu kulingao nikuba kweenda cakulisumpula, nkaambo ciindi ecino nceciindi cibi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo kulaba cikozyano caambwa ndinywe, akulila cililo cakupenga. Balati, Kusaalwa ncobeni twasaalwa. Imbono zyabantu bangu zyatolwa, Maawe! Wandinyanga. Myuunda yesu yaabilwa basicinguni. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.8"
              },
              "items": [
                {
                  "text": "Dt 32:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako tokooyooba amuntu naba omwe uuwaala cisolo cakweelesya nyika mumbungano ya-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutasinsimi, mbubaamba. Tabakoosinsima aya. Zisapi tazimani. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe noamba kuti luzubo lwa-Jakobo, sa Muuya wa­-Jehova wafwiinsigwa na? Sa eyi njimilimo yakwe? Sa majwi aangu taaboteli oyu uuenda cakululama? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ndinywe nomwaba basinkondonyina bantu bangu, Mulabalwisya bakede caluumuno, akusaala zikobela zyabaabo bainda cakutontola batayandi inkondo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banakazi babantu bangu mulabatanda kuzwa kumaanda aabo meebesi, abana babo mulabanyanga bulemu bwangu lyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
