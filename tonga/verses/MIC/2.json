                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kubunganya Njoomubunganya nyoonse nubana ba-Jakobo. Kuyobolola njooyobolola ibasyeede baba-Israyeli, Njoobabika antoomwe mbuli imbelele zyaku-Bozira. Mbuli butanga buli akati kamacelelo aabo, bayoopyopyongana nkaambo kakuvula kwabantu, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikuvwinyauna wabazulwida, bavwinyauna mulyango akwiinda mulinguwo akuzwa anze, alakwe mwami wabo wabazulwida, a-Jehova uli kunembo lyabo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
