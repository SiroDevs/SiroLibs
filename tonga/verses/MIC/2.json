            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubuke, mweende, nkaambo okuno nkumubede takweensi cilyokezezyo canu pe, nkaambo kulisofweede, alimwi busofwi bulanyonyoona alunyonyooko lubi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu uuenda cabuyo acakubeja waamba kuti, Njoomusinsimina cakunywa waini acakukolwa, ngonguwe uukonzya kuba musinsimi wabantu aba.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.11",
            "verseOrgIds": [
              "MIC.2.11"
            ]
          }
        }
      ]
