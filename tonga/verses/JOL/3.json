              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egepita uyooba cisaalo, acisi ca-Edomu ciyooba inkanda iitakedwe bantu, nkaambo kabukali mbubacitila bana ba-Juda, nkaambo batila bulowa bwabantu batajisi mulandu munyika yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.19",
            "verseOrgIds": [
              "JOL.3.19"
            ]
          }
