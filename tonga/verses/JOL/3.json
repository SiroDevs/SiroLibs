                  "text": "Ob 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi bantu bangu babawaalila zisolo, Mulombe balamwaabila muulo wasimamambe, amusimbi balamuuzya bukoko bwakunywa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
