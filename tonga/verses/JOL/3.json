                  "text": "Mik 4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amufule maamba aanu abe mapanga, azizibyo zyamisamu zyanu zibe masumo, Mutetete aambe kuti, Ndi singuzu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amufwambaane kuboola, nuzisi zyoonse zyeengelede, akuyoboloka. Leta basilumamba bako nkuko, o Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.26"
              },
              "items": [
                {
                  "text": "2 Mak 20:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.96.13"
              },
              "items": [
                {
                  "text": "Int 96:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zisi zyoonse zibuke, ziinke kumumpata wa-Josafati, nkaambo kakuti nkukonya oko nkunti babeteke bamasi oonse beengelede.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.3.12"
            ]
          }
        }
