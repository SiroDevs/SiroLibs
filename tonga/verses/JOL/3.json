        },
        {
          "text": "njooyobolola bamasi boonse, njoobaleta mumumpata wa-Josafati, kuti tukabetekane nkuko, nkaambo kabantu bangu acisi cangu ca-Israyeli, nkaambo babamwaisya akati kabamasi, anyika yangu baiabana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
          "name": "verse",
