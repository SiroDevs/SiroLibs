              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Juda uyookalilila lyoonse, a-Jerusalemu uyoobako kusikila kumazyalani-zyalani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.20",
            "verseOrgIds": [
