                }
              ]
            }
          ]
        },
        {
          "text": "Amutole cigonsyo, nkaambo maila aakutebula abizwa, Amuboole kuzoolyataula, nkaambo idindi lyakusinina misaansa lyazula, zibikilo zilafusauka, nkaambo bubi bwazyo mbupati. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma lavula makamu makamu mumumpata wakukosweda makani! Nkaambo buzuba bwa-Jehova buli afwaafwi mumumpata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.14",
            "verseOrgIds": [
              "JOL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izuba amwezi zyoonse zyasizigwa, anyenyeezi zyaleka kumweka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.15",
            "verseOrgIds": [
              "JOL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.2"
              },
              "items": [
                {
                  "text": "Am 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova ulavuluma kuzwa ku-Zioni, akulizya ijwi lyakwe ku-Jerusalemu, elyo ijulu anyika zyoonse zilateketa. Pele Jehova ngemacijilo aabantu bakwe, ngumampangala aabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.16",
            "verseOrgIds": [
              "JOL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
