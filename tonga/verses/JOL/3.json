              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulaule aya makani akati kabamasi. Amulibambile inkondo. Amubusye baalumi basintaze, Basilumamba boonse baswene kuyoolwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
