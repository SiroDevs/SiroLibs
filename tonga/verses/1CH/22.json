            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.3"
              },
              "items": [
                {
                  "text": "1 Mak 28:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ijwi lya-Jehova lyakandisikila liti, Watila bulowa bunji, akucita inkondo zinji. Toelede kuyakila izina lyangu iŋanda, nkaambo watila bulowa bunji ansi kumeso aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
