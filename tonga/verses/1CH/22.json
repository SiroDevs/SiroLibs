                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Davida wakaambila Solomoni kuti, Mwanaangu, cintu icakali mumoyo wangu nceeci, Ndakati, ndyeelede kuyaka iŋanda yazina lya-Jehova Leza wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
