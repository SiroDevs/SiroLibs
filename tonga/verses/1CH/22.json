        {
          "text": "Nkabela Davida wakalailila kuti bayobolole bazwamasi ibakakede munyika ya-Israyeli, elyo wakabika basikubeza mabwe kuti babambe mabwe mabotu aakuyasya iŋanda ya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
