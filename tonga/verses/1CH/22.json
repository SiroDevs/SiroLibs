                  "text": "Int 72:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Jehova akupe maanu abusongo, kuti kuciindi eco noti pegwe bwami bwa-Israyeli, ukabambe mulao wa-Jehova Leza wako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
