              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakaita Solomoni mwanaakwe, wamulailila kuti ayakile Jehova Leza wa-Israyeli iŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
