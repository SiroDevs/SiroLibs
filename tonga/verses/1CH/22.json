                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwanaangu, Jehova abe ayebo, kuti ujane inguzu zyakuyaka iŋanda ya-Jehova Leza wako, mbubonya mbwaakaamba aanduwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
