              },
              "items": [
                {
                  "text": "1 Bam 7:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abwalo butale Davida wakabuvuzya, kuti bapange inembe zyamilyango yamanjililo azijatilizyo, amukuba munji loko uuteelekeki, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.6"
              },
              "items": [
                {
                  "text": "1 Bam 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azisamu zyakedari zitabaliki, nkaambo ba-Sidoni abaTuro bakali kuletela Davida zisamu zinji zyakedari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
        {
