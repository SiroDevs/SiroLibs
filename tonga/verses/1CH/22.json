        },
        {
          "text": "Lino uyookala kabotu na wabika moyo wako kuku bamba imbeta amilazyo Jehova njaakalailila Musa kuti ape baIsrayeli. Koyuma akuba mukozu. Utayoowi nikuba kukankama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona! Ndalikataazya loko. Ndabambila iŋanda ya-Jehova matalenta aangolida aali zyuulu zili mwanda, amatalenta aansiliva aali zyuulu zili cuulu, amukuba abutale bunji loko buteelekeki, azisamu amabwe zyoonse ndazibamba. Ayebo uyooyungizizya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ulijisi basimilimo banji loko, basikubeza abasikusya mabwe abasikubeza zisamu, abantu bezi milimo yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "yangolida ayansiliva ayamukuba ayabutale, Tababaliki pe. Buka, ukabeleke milimo, Alakwe Jehova abe ayebo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
