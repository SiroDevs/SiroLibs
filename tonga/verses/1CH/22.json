                }
              ]
            }
          ]
        },
        {
          "text": "Ngonguwe uuti yakile izina lyangu iŋanda. Uyooba mwanaangu, ambebo njooba wisi, nkabela cuuno cabwami bwakwe bwaIsrayeli njoocisimpika mane kukabe kutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
