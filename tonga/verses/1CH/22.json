              "attrs": {
                "loc": "1CH.29.1"
              },
              "items": [
                {
                  "text": "1 Mak 29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Davida wakati, Mwanaangu Solomoni ucili mwana, tana kucenjela, alimwi iŋanda iiti yakilwe Jehova ilyeelede kukomena loko, ibe ampuwo abulemu muzisi zyoonse. Nkaambo kako ndyeelede kulibambila njiyo. Aboobo Davida wakabamba zibelesyo zinji katana kufwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
