                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Amoni nibakabona kuti balinunsya kumeso aa-Davida, Hanuni abana ba-Amoni bakatuma matalenta aansiliva aali cuulu kuti balibelesezye inkalaki abasimbizi ku-Mesopotamiya aku-Aramu Maaka aku-Zeba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.30"
              },
              "items": [
                {
                  "text": "My 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.9"
              },
              "items": [
                {
                  "text": "Jos 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Is 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakalibelesezya zyuulu zili makumi otatwe azibili zyankalaki, amwami wa-Maaka abantu bakwe. Aba bakeza akuliyakila zilao kunembo lyaMedeba, Abalo bana ba-Amoni bakayoboloka kuzwa kuminzi yabo, beza kukulwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida naakamvwa, wakatuma joabu ampi yoonse yabaalumi basintaze. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bana ba-Amoni bakazwa akulibamba mumindando yakulwa kumulyango wamunzi. Abamwi beenzu bakalibamba abalike musokwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        }
      ]
    },
    {
