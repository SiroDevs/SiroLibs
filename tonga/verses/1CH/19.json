              "items": [
                {
                  "text": "1 Sam 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kusule lyayaaya Nahasi mwami wabana ba-Amoni wakafwa, nkabela mwanaakwe wakalya izina lyakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.1",
            "verseOrgIds": [
              "1CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Davida wakati, Nkamufwide luzyalo Hanuni mwana wa-Nahasi, nkaambo wisi wakandifwida luzyalo mebo. Aboobo Davida wakatuma batumwa kuti bamuumbulizye kumakani aawisi. Pele balanda ba-Davida nibakasika kucisi cabana baAmoni kuli-Hanuni kuti bamuumbulizye, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bapati babana ba-Amoni bakaambila Hanuni kuti, Uyeeyanzi? Sa ncobeni nkaambo kakulemeka uso Davida ncatumina basikukuumbulizva? Sa balanda bakwe tabazide kuzoolangaula akupilinganya akuvwiya nyika? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.3",
            "verseOrgIds": [
              "1CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo Hanuni wakabweza balanda ba-Davida, wabanyoola, wakafwinsizya zikobela kumatako, akubatanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.4",
            "verseOrgIds": [
              "1CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.24"
              },
              "items": [
                {
                  "text": "Jos 6:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.16.22"
              },
              "items": [
                {
                  "text": "Bab 16:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.34"
              },
              "items": [
                {
                  "text": "1 Bam 16:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakainka. Nkabela Davida naakalwiidwa makani aabantu abo, wakatuma basikubacinga, nkaambo bantu bakafwa bweeme loko, Lino mwami wakabaambila kuti, Amulindile ku-Jeriko, mane indezu zyanu zitaangune kumena, elyo nimutaboole,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
