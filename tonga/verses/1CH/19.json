                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amube abukozu akulwa canguzu nkaambo kabantu besu aminzi ya-Leza wesu. Lino Jehova acite kufumbwa cimubotela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
