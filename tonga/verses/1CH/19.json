                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Joabu abantu mbaakali abo bakaswenenena ba-Aramu kuti babalwisye, nkabela bakacija. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Amoni nibakabona kuti baAramu bacija, bakacija abalo kubusyu bwa-Abisai munyina, banjila mumunzi, Elyo Joabu wakapiluka ku-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
