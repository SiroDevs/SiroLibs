          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Joabu naakabona kuti balilangene abasilumamba koonse koonse, kunembo akusule, wakasala bantu basinguzu baba-Israyeli akubabamba kuti balwisye ba-Aramu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu bamwi basyeede wakababika mumaanza aa-Abisai munyina, nkabela bakalibamba kuti balwisye ba-Amoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati, Na ba-Aramu bandikacila, uleelede kundigwasya, pele na ba-Amoni bakukacila, mebo ndakugwasya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
