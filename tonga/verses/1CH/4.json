              },
              "items": [
                {
                  "text": "Int 78:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oko bakajana macezezyo manono mabotu, alimwi nyika yakalikwazeme, yakalyuumwide akutontola, nkaambo bantu ibakataanguna kukala nkuko bakali bana ba-Hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.8"
              },
              "items": [
                {
                  "text": "2 Bam 18:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino aba balembedwe mazina aabo bakeza mumazuba aa-Hezekiya mwami wa-Juda, banyonyoona zilao zyabo, aba-Meuni ibakakede nkuko, babafwidilizya mane kusikila sunu, akukala mumweenya wabo, nkaambo bakajana macelelo aambelele zyabo nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwi babo, bana ba-Simeoni bali myanda yosanwe, bakaya kucilundu ca-Seiri. Basololi babo bakali Pelatiya, a-Neariya, a-Refaya, a-Uzieli, bana ba-Isi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
