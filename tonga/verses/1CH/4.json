          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Kelubu munyina Sua nguwakazyala Mehiri, iwakazyala Esitoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Esitoni wakazyala Betirafa, a-Paseya, a-Tehini wisi Irinahasi. Mbaabo bantu ba-Reka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.17"
              },
              "items": [
                {
                  "text": "Jos 15:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abana ba-Kenazi mbaaba: Otiniyeli, a-Seraya. Abana ba-Otiniyeli mbaaba: Hatati a-Meonotai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.11.35"
              },
              "items": [
                {
                  "text": "Neh 11:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meonotai nguwakazyala Ofira, alakwe Seraya nguwakazyala Joabu wisi Geharasimu. Bakategwa obo nkaambo kakuti bakali basikubeza, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi bana ba-Kalebe mwana waJefune mbaaba: Iru, Ela, a-Naama. Amwana wa-Ela: Kenazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Jehaleleli bakali Zifi, a-Zifa, Tiriya, a-Asareli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Ezara bakali Jeteri, a-Meredi, a-Eferi, a-Jaloni. Mbaaba bana ba-Bitiya, mwana musimbi wa-Farao, Meredi ngwaakakwata, Wakaminta, wakazyala Miriamu, a-Samai, a-Isba wisi Esitemowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukaakwe mu-Juda wakazyala jeredi wisi Gedoro, a-Heberi wisi Soko, a-Jekutiyeli wisi Zanowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana bamuka-Hodiya, mucizi wa-Nahamu, bakali bawisi Kula mu-Garimi aEsitemowa mu-Maaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Simoni bakali Amnoni, a-Rina, Benehanana, a-Tiloni. Abana ba-Isi bakali Zoheti a-Benzoheti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
