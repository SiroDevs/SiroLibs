        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.2"
              },
              "items": [
                {
                  "text": "2 Sam 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a-Jokimu, abantu ba-Kozeba, a-Joasi, a-Sarafa iwakeendelezya kuMoabu, a-Jasubilehemu. Makani aya ngaciindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bantu bakali babumbi, ibakakede ku-Netaimu aku-Gedara, Bakaakukala nkuko amwami mumilimo yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
    {
