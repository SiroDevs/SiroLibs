        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Asuri WISI Tekowa kakwete banakazi bobile, Hela a-Naara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.5",
            "verseOrgIds": [
              "1CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naara nguwakamuzyalila Ahuzamu, a-Heferi, a-Temeni, a-Hahastari. Mbaabo bana ba-Naara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.6",
            "verseOrgIds": [
              "1CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Hela bakali Zereti, Izara, a-Etinani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Kozi nguwakazyala Anubu, a-Zobeba, anzubo zya-Ahareli mwana wa-Harumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        }
      ]
    },
