            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.4"
              },
              "items": [
                {
                  "text": "My 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.61"
              },
              "items": [
                {
                  "text": "26:61",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Nadabu a-Abihu bakataangu­ nina wisaabo kufwa, nkabela teebakazyede bana, aboobo Eleazara a-Itamara mbobakacita milimo yabupaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida a-Zadoki umwi wabana ba-Eleazara a-Ahimeleki umwi wabana ba-Itamara bakabaabila milimo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela akati kabana ba-Eleazara kwakajanwa bantu bacenjede banji kwiinda bana ba-Itamara, aboobo bakaandaanya bana ba-Eleazara munkamu zili ikumi amusanu aimwi mbubonya mbuli inzubo zyabamawisaabo, abana ba-Itamara bakabaandaanya munkamu zili musanu azitatu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
