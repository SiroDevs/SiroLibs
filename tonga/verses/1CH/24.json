        {
          "text": "cakumi azitatu cakawida Hupa, cakumi azine cakawida Jesebeabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.13",
            "verseOrgIds": [
              "1CH.24.13"
            ]
