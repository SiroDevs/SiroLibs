                  "text": "Ezr 10:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "catatu cakawida Harimu, cane cakawida Seorimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.8",
            "verseOrgIds": [
              "1CH.24.8"
