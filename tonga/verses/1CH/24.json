              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakumi amusanu cakawida Biliga,-cakumi amusanu acimwi cakawida Imeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.14",
            "verseOrgIds": [
              "1CH.24.14"
