              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakumi acimwi cakawida Eliyasibu, acakumi azibili cakawida Jakimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.12",
            "verseOrgIds": [
              "1CH.24.12"
            ]
          }
