              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakumi amusanu azibili cakawida Heziri, cakumi amusanu azitatu cakawida Hapizezi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.15",
            "verseOrgIds": [
              "1CH.24.15"
