              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "camakumi obile acimwi cakawida jakini, camakumi obile azibili cakawida Gamuli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.17",
            "verseOrgIds": [
