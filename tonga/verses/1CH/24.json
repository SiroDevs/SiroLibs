        },
        {
          "text": "Nzeezi inkamu zyabana ba-Aroni. Bana ba-Aroni mbaaba: Nadabu, a-Abihu, Eleazara, a-Itamara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
