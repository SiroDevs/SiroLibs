        },
        {
          "text": "Bakabaandaanya kukuwaala cisolo; boonse kabeelene. Kakuli baalu bacikombelo abaalu ba-Leza akati kabana ba-Eleazara abana ba-Itamara boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        },
        {
