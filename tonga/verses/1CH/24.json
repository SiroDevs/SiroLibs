              "items": [
                {
                  "text": "Neh 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Semaya mwana wa-Netaneli mulembi, umwi waba-Levi, nguwakabalemba kubusyu bwamwami abwabapati abwa-Zadoki mupaizi abwa-Ahimeleki mwana wa-Abyatare abasilutwe banzubo zyabapaizi azyaba-Levi. Umwi silutwe wakasalwa akati kanzubo zya-Eleazara, aumwi wakasalwa akati kanzubo zya-Itamara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        }
