          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "casanu cakawida Malikiya, camusanu acimwi cakawida Mijamini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.9",
            "verseOrgIds": [
              "1CH.24.9"
            ]
