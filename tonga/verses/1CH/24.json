              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakumi amusanu azine cakawida Petahiya, camakumi obile cakawida Jehezikeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.16",
            "verseOrgIds": [
              "1CH.24.16"
