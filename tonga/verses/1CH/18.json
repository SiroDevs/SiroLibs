                "loc": "1KI.7.15"
              },
              "items": [
                {
                  "text": "1 Bam 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Mak 4:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akwalo ku-Tibati aku-Kuni, minzi ya-Hadadezeri, Davida wakasaala mukuba munji loko. Ngonguwo Solomoni ngwaakafuzya iziba lyamukuba aziimikilo azibelesyo zimwi zyamukuba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
