                  "text": "Tus 21:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Davida wakabika impi akati kabaAramu baku-Damasko, nkabela ba-Aramu bakaba bazike ba-Davida akumuletela mutelo. Aboobo Jehova wakazundya Davida koonse nkwaakaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakanyanzya intobo zyangolida nzibakayumwide balanda ba-Hadadezeri, akuzileta ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
