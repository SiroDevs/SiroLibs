              "items": [
                {
                  "text": "2 Sam 8:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakatuma mwanaakwe Hadoramu kumwami Davida kuti amujuzye akumusekelezya, nkaambo kakulwisya Hadadezeri akumuzunda, nkaambo Tou a-Hadadezeri kanji-kanji bakali kulwana. Nkabela wakaletelezya zibelesyo zyamisyobo misyobo zyangolida azyansiliva azyamukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi azyalo mwami Davida wakazisalazizya Jehova, antoomwe ansiliva angolida nzyaakasaala kuzisi zyoonse, kuba-Edomu aba-Moabu aba-Amoni aba-Filisti aba-Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
