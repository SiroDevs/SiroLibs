        },
        {
          "text": "Nkabela Davida wakazunda Hadadezeri mwami wa-Zoba, Wakamulwisya ku-Hamati naakali kuya kuyooboozya nyika yakwe kulwizi lwa-Firate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
