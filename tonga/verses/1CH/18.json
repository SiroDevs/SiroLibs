          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.4"
              },
              "items": [
                {
                  "text": "2 Sam 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Davida wakamunyanzya inkalaki zili cuulu, abasimbizi bali zyuulu zili musanu azibili, abasilumamba basimaulu bali zyuulu zili makumi obile. Elyo Davida wakatyola mazwi aambizi. Wasyaazya imbizi zyankalaki zili mwaanda buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Aramu baku-Damasko nibakeza kuzoogwasya Hadadezeri mwami wa-Zoba, Davida wakajaya ba-Aramu bali zyuulu zili makumi obile azibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
