        },
        {
          "text": "Lino cisolo citaanzi cakawida Asafu, nkukuti Josefa; cabili cakawida Gedaliya, walo ababunyina abana bakwe kabali ikumi ababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "catatu cakawida Zakuri, walo ababunyina abana bakwe kabali ikumi ababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.10",
            "verseOrgIds": [
              "1CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "cane cakawida Izri, walo ababunyina abana bakwe kabali ikumi ababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "casanu cakawida Netaniya, walo ababunyina abana bakwe kabali ikumi ababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
            "verseOrgIds": [
              "1CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "camusanu acimwi cakawida Bukiya, walo ababunyina abana bakwe kabali ikumi ababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
