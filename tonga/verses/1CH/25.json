                  "text": "2 Mak 23:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakawaala cisolo cakubaabanya milimo, baniini abapati, baiyi abasikwiiya, boonse kabeelene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
