          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "camusanu azitatu cakawida Jesaya, walo ababunyina abana bakwe kabali ikumi ababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
            "verseOrgIds": [
              "1CH.25.15"
            ]
