                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mweelwe wabo, antoomwe ababunyina ibakaiyide nyimbo zya-Jehova, boonse bacenjede, kaili myanda yobile amakumi aali musanu aatatu amusanu abatatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
