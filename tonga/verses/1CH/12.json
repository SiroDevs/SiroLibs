              "items": [
                {
                  "text": "1 Sam 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino njeeyi myeelwe yampi zyabasilumamba ibakeza kuli-Davida ku-­Hebroni kuti bamusandwide bwami bwa-Saulo, mbubonya mbuli Jehova mbwaakaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba-Juda basilumamba ibakasamine intobo amyuumba, bakali zyuulu zili musanu acimwi amyanda iili musanu aitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Simeoni, basilumamba basinguzu kukulwa, bakali zyuulu zili musanu azibili amwanda omwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Levi, bantu bali zyuulu zyone amyanda iili musanu aumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A-Jehoyada silutwe waluzubo lwa-Aroni, abantu mbaakali abo, zyuulu zyotatwe amyanda iili musanu aibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
