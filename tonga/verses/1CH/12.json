              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.25"
              },
              "items": [
                {
                  "text": "2 Sam 17:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.17"
              },
              "items": [
                {
                  "text": "1 Mak 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Muuya wakanjila muli-Amasai silutwe wamakumi otatwe, wakati, Tuli bako, O Davida; tuli kulubazu lwako, O mwana wa-Jese; kube luumuno, kube luumuno kulinduwe akulibasikukugwasya, nkaambo Leza wako ngguukugwasya, Mpawo Davida wakabatambula, wababika kuti babe basilutwe bampi zyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
