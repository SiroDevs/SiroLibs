              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwi bana ba-Benjamini abana ba-Juda bakeza kuli-Davida kuma-mpangala nkwaakabede. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
