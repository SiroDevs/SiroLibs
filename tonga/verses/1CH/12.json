            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Eluzai, a-Jerimoti, a-Bealiya, a-Semariya, a-Sefatiya waku-Harupi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elikana, a-Isiya, a-Azareli, a-Joezeri, a-Jasobeamu, baKora; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "a-Joela a-Zebadiya bana ba-Jerohamu waku-Gedoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
