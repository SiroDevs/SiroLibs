        {
          "text": "aIsmaya waku-Gibeoni umwi wabaalumi basintaze bali makumi otatwe, umwi wabasolozi babo, a-Jeremiya, a-Jahazieli, a-Johanani, a-Jozabadi waku-Gedera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
