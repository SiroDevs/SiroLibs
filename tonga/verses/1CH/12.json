              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Jud 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Davida wakazwa kuyoobacinga, wabaambila kuti, Na mweza kulindime caluumuno kuzoondigwasya, moyo wangu uyookala anywebo, pele na mweza kuzoondaaba mumaanza aabasinkondoma, nekuba kuti nsikwe ncindabisya, Leza wabamatatesu abone akumutapatila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
