        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boonse mbotwaamba, basilumamba bakalibambilide kulwa, bakeza camoyo woonse ku-Hebroni kuti bape Davida bwami bwacisi coonse caIsrayeli, Abalo bantu bamwi ba-Israyeli kabajisi moyo womwe buyo kukupa Davida bwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakasyaala nkuko kuli-Davida mazuba otatwe, balalya akunywa, nkaambo bakwabo bakababambila malilu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo beenzinyina bazisi zyeengelede, akusikila ku-Isakara a-Zebuloni a-Nafitali, bakali kuleta zilyo ambongolo ankamele amabbiza abasune, Bakaleta zilyo zinji-busu, azikoto zyankuyu, azikungo zyamisaansa, awami, amafuta, abasune, ambelele-nkaambo kakuli lusekelelo lupati mucisi ca-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    }
