                  "text": "49:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbombabo ibakazubuka Jordano mumwezi mutaanzi, mulonga niwakali kupaya kunkomwe koonse, akutanda bantu boonse ibakakede mumimpata, nikuba kujwe nikuba kumbo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
