                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alimwi bakali basimata ibakabwene kufu sa mabwe nanka mivwi kumaanza oonse obile niliba lyalulyo niliba lyacimwensi. Bakali ba-Benjamini, basimukowanyina Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
