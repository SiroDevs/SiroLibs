                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abamwi ba-Gadi bakalipambula akunjila munkamu ya-Davida kumampangala nkwaakabede munkanda. Bakali baalumi basintaze, basilumamba basinguzu ibakabwene kulwisya intobo amyuumba. Masyu aabo akali abukali mbuli masyu aabalavu, alimwi bakali aluno mbuli insya zyakumalundu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaanzi wabo kali Ezeri, awabili Obadiya, awatatu Eliabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "awane Misimana, awasanu Jeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "awamusanu aumwi Atai, awamusanu ababili Elieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "awamusanu abatatu Johanani, awamusanu abane Elzabadi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "awakumi Jeremiya, awakumi aumwi Makibanai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ba-Gadi bakali basolozi bampi; baniini kabajisi bantu bali mwaanda, abapati kabajisi bantu bali cuulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
