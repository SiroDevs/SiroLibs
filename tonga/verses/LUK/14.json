                "loc": "LUK.6.6+LUK.6.7+LUK.6.8+LUK.6.9+LUK.6.10+LUK.6.11"
              },
              "items": [
                {
                  "text": "Lk 6:6-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.37"
              },
              "items": [
                {
                  "text": "11:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo naakanjila muŋanda yaumwi mupati waba-Farisi ku-Sabata kuti alye nsima, bakamulangisya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakalimo omo mwaalumi umwi simulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu wakavuwa, wakabuzya balembi aba-Farisi kuti, Sena kuliluzi kuponya ku-Sabata, na pe? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bakaumuna buyo. Nkabela wakamujata wamuponya, ndilyonya wakamuleka wainka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.11"
              },
              "items": [
                {
                  "text": "Mt 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.15"
              },
              "items": [
                {
                  "text": "Lk 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakabaambila wakati, Nguuli akati kanu uunga imbongolo niiba ngombe yawida mucikala, sena takooigwisya cakufwambaana kubuzuba bwa-Sabata? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela tabakwe nobakacili kukonzya kuzumanana kumakani ayo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.6"
              },
              "items": [
                {
                  "text": "Mt 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakabaambila cikozyano abakali kutambidwe, naakabona mbobakasala zyuuno zyabulemu, wakati kulimbabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.6+PRO.25.7"
              },
              "items": [
                {
                  "text": "Tus 25:6-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anooli watambwa muntu kuya kupobwe lyakukwata, utakali acuuno cabulemu, nkaambo ambweni watambwa aumwi uukwiinda bulemu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo simeenzaanu aboola kulinduwe akwaambila kuti, Muswene oyo muntu abusena awa, ndilyonya yebo watalika kuzwa abuusu kuyookala acuuno icili munsi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo kuti watambwa, koya ukale kucuuno icili munsi omwini, kuti uwakutamba asika akakwaambile kuti, Mweenzuma, nyamuka uboole kumbele, ndoti jane bulemu kumbele lyabaabo boonse mbokede abo akulya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.12"
              },
              "items": [
                {
                  "text": "Mt 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.14"
              },
              "items": [
                {
                  "text": "Lk 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo umwi umwi uulisumpula uyoofwiinsigwa, ayooyo uulifwiinsya uyoosumpulwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.11",
            "verseOrgIds": [
              "LUK.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.11",
            "verseOrgIds": [
              "LUK.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakaambila simeenzaakwe wakati, Kuti wacita cisusulo na cilalilo, utaambi beenzinyoko, nebaba banabakwanu, nebaba basazinyoko, nebaba mboomuyakide abo bavubi, nkaambo ambweni abalo balakutamba, ujane kubweedwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.29"
              },
              "items": [
                {
                  "text": "Dt 14:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti wacita pobwe, kotamba abacete, ezilema, abatyokede, aboofu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Joh 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nozooba acoolwe nkaambo tabakwe cakukubweedezezya, uyoobweedezezegwa kukubuka kwabaluleme,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.29"
              },
              "items": [
                {
                  "text": "Lk 13:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya umwi ngwaakakede awe akulya, naakamvwa obo, wakamwaambila kuti, Uli acoolwe uuti kalye mikamu mu-Bwami bwa-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.2+MAT.22.3+MAT.22.4+MAT.22.5+MAT.22.6+MAT.22.7+MAT.22.8+MAT.22.9+MAT.22.10"
              },
              "items": [
                {
                  "text": "Mt 22:2-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Jesu wakamwaambila kuti, Umwi muntu wakacita pobwe ipati, wakatamba banjibanji, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela wakatuma muzike wakwe kuciindi cakulya kuyooambila abakatambidwe kuti, Kamuboola nkaambo zyoonse zililulamikidwe kale. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.17",
            "verseOrgIds": [
              "LUK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela boonse abo bakatalika kulikazizya ejwi lyomwe. Mutaanzi wakamwaambila kuti, Ndakaula muunda, ndileelede kuyooubona, ndakukumbila ukandikazizizye kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.18",
            "verseOrgIds": [
              "LUK.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwi wakati, Ndakaula basune abali kumi, lino ndaya kuyoobasola, ndakukumbila ukandikazizizye kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.19",
            "verseOrgIds": [
              "LUK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.33"
              },
              "items": [
                {
                  "text": "1 Kor 7:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi wakati, Ndakakwata musimbi ncentakonzya kuboola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.20",
            "verseOrgIds": [
              "LUK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo muzike oyo wakaboola, waambila mwami wakwe makani aya, Ndilyonya mwiniŋanda wakaba mukali, waambila muzike wakwe wati, Kofwamba uinke mumigwagwa amutuzila twamumunzi, ukabalete okuno abacete, ezilema, aboofu, abatyokede, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.21",
            "verseOrgIds": [
              "LUK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limwi muzike wakaamba kuti, O mwami, kwacitwa mbuli kulailila kwako, nokubaboobo mpobucili busena. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.22",
            "verseOrgIds": [
              "LUK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mwami wakaambila muzike kuti, Koya kumigwagwa akumikusi ukabagubizye banjile, kuti ŋanda yangu izyule. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.23",
            "verseOrgIds": [
              "LUK.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndamwaambila kuti kubaalumi abo abakatambidwe taakwe aomwe uuti kasole cilalilo cangu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.24",
            "verseOrgIds": [
              "LUK.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
