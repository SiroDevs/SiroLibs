                {
                  "text": "Mt 8:5-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakamana kwaamba makani aakwe oonse mumatwi aabantu, wakanjila mu-Kapenaumu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.1",
            "verseOrgIds": [
              "LUK.7.1"
            ]
          }
        }
