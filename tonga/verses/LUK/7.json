              "LUK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
