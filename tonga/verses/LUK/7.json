              "LUK.7.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.37"
              },
              "items": [
                {
                  "text": "Lk 11:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwi waba-Farisi wakamukumbila kuti bazoolye awe. Nkabela wakanjila muŋanda yamu-Farisi oyo, wakala kuti alye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.36",
            "verseOrgIds": [
              "LUK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.7+MAT.26.8+MAT.26.9+MAT.26.10+MAT.26.11+MAT.26.12+MAT.26.13"
              },
              "items": [
                {
                  "text": "Mt 26:7-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.3"
              },
              "items": [
                {
                  "text": "Mk 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.3+JHN.12.4+JHN.12.5+JHN.12.6+JHN.12.7+JHN.12.8"
              },
              "items": [
                {
                  "text": "Joh 12:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno mumunzi omo mwakali mukaintu mucitazibi, naakamvwa kuti ulikede ulalya muŋanda yamu-Farisi, wakaleta nsazi yamafuta aanunka kabotu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.37",
            "verseOrgIds": [
              "LUK.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.7+MAT.26.8+MAT.26.9+MAT.26.10+MAT.26.11+MAT.26.12+MAT.26.13"
              },
              "items": [
                {
                  "text": "Mt 26:7-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.3+JHN.12.4+JHN.12.5+JHN.12.6+JHN.12.7+JHN.12.8"
              },
              "items": [
                {
                  "text": "Joh 12:3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "waima kumatende aakwe ulalila, imisozi yakwe yakatalika kulopya matende aakwe, waasyuuzya susu lyakwe, wamumyontesya matende aakwe, waananika mafuta, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.38",
            "verseOrgIds": [
              "LUK.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mu-Farisi uwakamwiita, naakabona obo, wakayeeya mumoyo wakwe wati, Oyu naali musinsimi, naamuziba mukaintu oyu uumujata kuti nguni, na uli buti, nkaambo mucitazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.39",
            "verseOrgIds": [
              "LUK.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu wakamuvuwa kuti, Simoni, ndiyanda kwaamba kulinduwe, (Wakati, Koamba, Mufundisi.) ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.40",
            "verseOrgIds": [
              "LUK.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakali bantu bobile abakali amulandu kumuntu umwi. Umulandu waumwi ngwamasheleni aali myaanda yosanwe, uwaumwi ngwamakumi osanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.41",
            "verseOrgIds": [
              "LUK.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mbobakabula cintu cakulunga, wakabajatila boonse bobile. Ino kulibaabo nguuli uuti muyandisisye? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.42",
            "verseOrgIds": [
              "LUK.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni wakamuvuwa wati, Ndiyeeya kuti nguyooyo ngwaakajatilisya. Wakamwaambila kuti, Wayeeya kabotu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.43",
            "verseOrgIds": [
              "LUK.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.4"
              },
              "items": [
                {
                  "text": "Matl 18:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya wasandukila kumukaintu, wati kuliSimoni, Sena wamubona mukaintu oyu? Ndanjila muŋanda yako, tondipede maanzi aakusanzwa matende aangu, pele walo walopya matende aangu emisozi yakwe, waasyuuzya esusu lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.44",
            "verseOrgIds": [
              "LUK.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.16"
              },
              "items": [
                {
                  "text": "Rom 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tondimyontede yebo, pele walo, kuzwida ciindi ncaanjila, talekede kumyontesya matende aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.45",
            "verseOrgIds": [
              "LUK.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutwe wangu tounanikide mafuta, anu oyu wananika matende aangu mafuta mabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.46",
            "verseOrgIds": [
              "LUK.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncendakwaambila kuti, Wajatilwa zibi zyakwe zinjizinji, nkaambo wayandisisya. Pele uujatilwa kaniini, uyanda kaniini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.47",
            "verseOrgIds": [
              "LUK.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
