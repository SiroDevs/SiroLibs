                  "text": "Mk 2:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munsi lyakooko wakazwa, wabona simutelo uutegwa Levi, wamwaambila kuti, Ndicilila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya wasia zyoonse, wanyamuka wamucilila.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        }
