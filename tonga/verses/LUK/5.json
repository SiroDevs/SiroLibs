            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno makamu aabantu naakamubunganina kuswillila makani aa-Leza, wakaliimvwi kumbali eziba lya-Genesarete, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela wakabona maato obile, aliimvwi mumbali lyeziba, pele basikuzuba bakalizwide mulingao, bali kusanzya nsabwe zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanjila mubwaato bumwi ubwakali bwaSimoni, wamukumbila kuti buzwe kunkomwe bweende kaniini. Elyo wakakala, waiisya makamu makamu, walo wali kukede mubwaato. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.6"
              },
              "items": [
                {
                  "text": "Joh 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakamana kukambauka, wakati kuli-Simoni, Katuya akati kamulungu, munike nsabwe zyanu, mukajaye nswi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.3"
              },
              "items": [
                {
                  "text": "Joh 21:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Simoni wakamuvuwa kuti, O mwami, twali kuzuba masiku oonse, tatujene cintu, nokubaboobo kujwi lyako ndiyoonika nsabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.6"
              },
              "items": [
                {
                  "text": "Joh 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nobakacita obo, bakajaya nswi zinjizinji, mane zyati kazapuke nsabwe zyabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.6",
            "verseOrgIds": [
              "LUK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpoonya bakoobola bazubinyina abakali mubwaato bumwi kuti bazoobagwasye. Bakaboola, bazuzya oonse maato obile, mane ati kabbile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.7",
            "verseOrgIds": [
              "LUK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Simoni Petro naakabona boobo, wakavundama kumatende aa-Jesu wati, Kozwa kulindime nkaambo ndi mwaalumi mucitazibi, O mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo wakaankamana walo, aboonse mbaakali abo, kunswi zinjizinji nzobakajaya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.9",
            "verseOrgIds": [
              "LUK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.47"
              },
              "items": [
                {
                  "text": "Mt 13:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abalo mbubonya ba-Jakobo a-Johane, bana ba-Zebedayo, balongwe bakwe Simoni. Jesu wakamwaambila Simoni kuti, Utayoowi, kuzwa sunu unoozuba bantu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.27"
              },
              "items": [
                {
                  "text": "Mt 19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nobakazubusya maato kunkomwe, bakasia zyoonse, bamucilila.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        }
      ]
    },
