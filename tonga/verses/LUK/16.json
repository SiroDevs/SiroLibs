                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Abrahamu wakamwaambila kuti, Balijisi Musa abasinsimi, abaswiilile mbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakati, Pe, pe, Taata Abrahamu, kwalo anooli nokwabuka umwi kubafu, wainka kulimbabo, nobati kasanduke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
