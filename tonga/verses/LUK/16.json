                  "text": "Joh 12:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi kwabikwa dindi ipati akati kesu anywebo, kuti abakokuno abayanda kuzubukila oko tabakonzya, abalo abakooko kulindinywe tabakonzya kusika okuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.26",
            "verseOrgIds": [
              "LUK.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakateeti, Taata, ncendakukumbila nkuti ukamutume kuŋanda yataata, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
