                }
              ]
            }
          ]
        },
        {
          "text": "wakali kubwezelela bufwefwelenga ubwakali kuwida kunsi atafule lyamuvubi oyo, ii, abalo babwa bakaboola bamyankuta zicisa zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
