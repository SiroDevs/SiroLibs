          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mukumbizi oyo wakafwa, abaangelo bakamutola kucamba ca-Abrahamu. Awalo muvubi wakazikwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        }
