          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo ndijisi banabakwesu bosanwe, akabaambilisye kuti batabooli kulibobuno busena bwamapenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
