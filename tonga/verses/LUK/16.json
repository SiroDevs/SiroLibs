              },
              "items": [
                {
                  "text": "1 Kor 7:10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu umwi umwi uuleka mukaintu wakwe, akwata umbi, waba simamambi, awalo uukwata uwalekwa mwaalumi, waba simamambi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        }
      ]
    },
    {
