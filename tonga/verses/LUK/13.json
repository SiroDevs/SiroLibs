              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakateeti, Bwami bwa-Leza ndiyoobukozyanya anzi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
