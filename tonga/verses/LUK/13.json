            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno kuliceeco ciindi kwakasika bamwi abakamwaambila makani aabaGalilaya, abulowa bwabo Pilato mbwaakabuvwelanya azipaizyo zyabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.2"
              },
              "items": [
                {
                  "text": "Joh 9:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wakabavuwa wati, Sena muyeeya kuti ba-Galilaya abo bakali babi kwiinda ba-Galilaya boonse, mbobakafwa obo? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.7.12"
              },
              "items": [
                {
                  "text": "Int 7:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe, ndamwaambila kuti mwatasanduka muyoofwidilila anywebo nyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.3",
            "verseOrgIds": [
              "LUK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaabo abakali kumi amusanu mubatatu abakawidwa ŋanda ndamfu yaku-Siloamu, iyakabajaya, sena muyeeya kuti abo bakali basimilandu kwiinda bantu boonse abakayakide ku-Jerusalemu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe, ndamwaambila kuti mwatasanduka muyoofwidilila anywebo nyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.5",
            "verseOrgIds": [
              "LUK.13.5"
            ]
          }
        }
      ]
    },
    {
