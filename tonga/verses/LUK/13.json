          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu wakabavuwa kuti, Kamuya mukaambile mwaaba oyo kuti, Bona, sunu ejunza ndicigwisya badaimona akuponya bantu, ezyona ndiyoozyulizya mulimo wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
