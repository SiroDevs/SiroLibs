              "attrs": {
                "loc": "MRK.4.30+MRK.4.31+MRK.4.32"
              },
              "items": [
                {
                  "text": "Mk 4:30-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaako wakateeti, Bwami bwa-Leza bulikozyene enzi? Ndiyoobukozyanya anzi ino? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
