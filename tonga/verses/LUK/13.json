          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokubaboobo ndileelede kuya mulweendo lwangu sunu ejunza ezyona, nkaambo takuzuminiki kuti musinsimi afwide kumbi, pele ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
