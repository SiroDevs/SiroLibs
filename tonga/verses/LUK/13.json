          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulikozyene amimena njaakabweza mukaintu, wiivwela muzyeelelo zyotatwe zyabusu, mane bwafufumuka boonse.",
          "type": "text",
          "attrs": {
