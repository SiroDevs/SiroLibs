                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakababuzya wati, Ino baamba buti kuti Kristo ngomwana aDavida? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
