              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakabaambila kuti, Mbubo, amupe Kaisara zintu zya-Kaisara, akuli-Leza zintu zya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
