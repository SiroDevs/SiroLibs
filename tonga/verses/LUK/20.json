          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakakakilwa kujata nkani eyo kumbele lyabantu, bakayoowa kukuvuwa kwakwe, baumuna buyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
