            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakasika bamwi ba-Saduki, abo abakazya kuti takuwo kubuka kwabafu, bamubuzya bati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.27",
            "verseOrgIds": [
              "LUK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Dt 25:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mufundisi, Musa wakatulembela kuti, Na muntu wafwa, uujisi mukaintu, pele tajisi bana, mwanaakwabo uleelede kumukwata oyo mukamufu, akazyalile mupati wakwe bana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.28",
            "verseOrgIds": [
              "LUK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbombubo obo kwakali baalumi bosanwe mubabili, mutaanzi wakakwata mukaintu, wafwa tajisi mwana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.29",
            "verseOrgIds": [
              "LUK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwabili wakamukwata oyo mukamufu, awalo wafwa tasii mwana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.30",
            "verseOrgIds": [
              "LUK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "awalo watatu wakamukwata, mane boonse bosanwe mubabili, mbubonya bakafwa, tabasii bana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.31",
            "verseOrgIds": [
              "LUK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munsi lyabo boonse awalo mukaintu wakafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.32",
            "verseOrgIds": [
              "LUK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino kukubuka uyooba mukani? Nkaambo boonse bosanwe mubabili bakali kumukwete. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.33",
            "verseOrgIds": [
              "LUK.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu wakabavuwa wati kulimbabo, Bana bacisi ecino balakwata, balakwasigwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele abo abaambwa kuti baliceelede cisi eco, akukubuka kulufu, tabakwati, tabakwasigwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.35",
            "verseOrgIds": [
              "LUK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.1"
              },
              "items": [
                {
                  "text": "1 Joh 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo tabacikafwi limbi, bayooba mbuli baangelo, mbobakali bana babubuke bayooba bana ba-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.36",
            "verseOrgIds": [
              "LUK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.2"
              },
              "items": [
                {
                  "text": "Kul 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti bafu balabusigwa, awalo Musa wakaakutondezya mwaakalembela makani aacivuna, awo naakali kwaamba Jehova kuti, ngu-Leza wa-Abrahamu, Leza wa-Izaka, Leza wa-lakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.8"
              },
              "items": [
                {
                  "text": "Rom 14:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leza tali Leza wabafu, pele ngwabaumi, nkaambo boonse balapona kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo balembi bamwi bakamwaambila kuti, Mufu-ndi si, waamba kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo tabakacili kukonzya kumubuzya nkani niiba yomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        }
      ]
