        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.1"
              },
              "items": [
                {
                  "text": "Is 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakatalika kubaambila cikozyano eci cakuti, Umwi muntu wakacita muunda wamusaansa, wuusia mumaanza aabalimi, wakainka kucisi cimwi ciindi cilamfu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15"
              },
              "items": [
                {
                  "text": "2 Mak 36:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nocakasika ciindi camicelo wakatuma muzike wakwe kubalimi kuti bakamupe micelo yamumuunda, kwalo balimi bakamuuma, bamupilusya buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.10",
            "verseOrgIds": [
              "LUK.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakatuma muzike umbi, awalo bakamuuma, bamunyansya, bamupilusya aminwe buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.11",
            "verseOrgIds": [
              "LUK.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakatuma watatu, walo bamuyasa, bamugwisizya anze. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.12",
            "verseOrgIds": [
              "LUK.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mukamwini muunda wakati, Ino nkacite buti? Ndiyootuma mwanaangu uuyandwa, ambweni bayoomulemeka baakumubona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.13",
            "verseOrgIds": [
              "LUK.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwalo balimi nobakamubona, bakavwiya bati, Ngooyu mulyezina, atumujaye, lukono lube lwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.14",
            "verseOrgIds": [
              "LUK.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya bakamugwisizya anze amuunda, bamujaya. Ino mukamwini muunda uzoobacita buti? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.15",
            "verseOrgIds": [
              "LUK.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzooboola abajaye balimi abo, ape bambi muunda wakwe, Nkabela nobakamvwa obo, bakaamba kuti, Pe, kutabi boobo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.16",
            "verseOrgIds": [
              "LUK.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Int 118:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wakabalanga wati, Ino kutinzi oku ukwakalembwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        }
      ]
    },
    {
