              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.20"
              },
              "items": [
                {
                  "text": "2 Tim 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.19+EPH.2.20+EPH.2.21+EPH.2.22"
              },
              "items": [
                {
                  "text": "Ef 2:19-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ndilamuka kuboola, ngoonya aya makani alakutondezya mbobeelede kukala bantu muŋanda ya-Leza, eyo iŋanda njembungano ya-Leza muumi, ngomusemu, alimwi ncecisiko calusinizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
