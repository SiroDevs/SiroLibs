              },
              "items": [
                {
                  "text": "Inc 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo badaikona baleelede kuloma, batabi basindimizyobile, batabi basikukolwa waini nokuba kuunya kulubono lwaansi ano, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele kabajatisya makani aasisidwe aaluzumino camoyo uusalala ngwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno aba abasaangune kulangililwa mbobacita, elyo banjile mumulimo wabudaikona na takukwe butongo kulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.3"
              },
              "items": [
                {
                  "text": "Tit 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bakaintu abalome, batanoonga kabatamizya bamwi twaambo, kabagamine kulibatamika akusyomeka muzintu zyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badaikona kabagamine kukwata mukaintu omwe luzutu, kababalela kabotu bana babo akubamba maanda aabo kabotu kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo abo abakamana mulimo wabudaikona kabotu balalijanina bwaalu bubotu, elyo kulabula ancobayoowa mukusyoma kwabo kuli muli-Kristo Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
    {
