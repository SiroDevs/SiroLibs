              "items": [
                {
                  "text": "Mk 16:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni takukwe uukonzya kukazya kuti makani aasisidwe aabukombi mapati loko.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
