              "items": [
                {
                  "text": "1 Kor 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno obo njanda kuti abo bacili bana kabakwatwa buyo akuzyala bana akubamba maanda aabo, kuti sinkondonyina wesu abule ampabainda, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.14",
            "verseOrgIds": [
              "1TI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo mpobali kale abakasandukila kuli-Saatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.15",
            "verseOrgIds": [
              "1TI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti kakuli mukaintu muzumini uuli amukowa wabamukabafu, kanga kabagwasya, kuti imbungano italemenwi kukugwasya bantu bali boobo, igwasye bamukabafu benibeni.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        }
      ]
