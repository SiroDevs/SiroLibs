                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utanoofwambaana kubika muntu maanza, alimwi utanoolivwela kuzibi zyabamwi. Kolibamba akubula butongo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
