                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti bataswiilili zyamankwangwaalizya nituba tunsiyansiya twamazyalani-zyalani, nkaambo aya makani alaleta inkazyanyo buyo, taakonzyi kuyaka lusyomo lwesu lwakusyoma Leza, Lino asunu ndakulailila mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
