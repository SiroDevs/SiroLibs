                "loc": "GAL.1.13+GAL.1.14+GAL.1.15+GAL.1.16"
              },
              "items": [
                {
                  "text": "Gal 1:13-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndamulumba Kristo Jesu Mwami wesu, uwakandipa inguzu, nkaambo wakandisyoma kuti ndilasyomeka, ncaakandibikila munulimo wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
