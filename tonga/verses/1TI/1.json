                "loc": "1TI.6.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nokuboobo bamwi bazileka zintu ezi zinizini, bagama zimbi zyabuyo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
          }
