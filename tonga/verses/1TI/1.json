              },
              "items": [
                {
                  "text": "Rom 7:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno swebo tulizi kuti Mulao mubotu kumuntu uubamba kabotu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufumbwa anooyeeya kuti mulao tuucitilwi muntu uuluzi, ulacitilwa basigama abantu bapilingene, basikasampusampu abasizibi, basofweede abantu bataluzi, basikujaya bamawisi abamanyina, abajaya bantu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.3"
              },
              "items": [
                {
                  "text": "1 Tim 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "basibwaamu abasikoona baaluminyina, basimuvupu ababeji abasikukonka cakubeja, abaabo bacita zintu zimwi zili boobo zitayanzene alwiisyo lubotu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.15"
              },
              "items": [
                {
                  "text": "1 Tim 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mbubonya mbuli Makani Mabotu aabulemu bwa-Leza uuli acoolwe, ngendakasyomezezegwa mebo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
