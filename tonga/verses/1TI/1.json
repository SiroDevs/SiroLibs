              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.27"
              },
              "items": [
                {
                  "text": "Rom 16:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno ku-Mwami mupati uutamani walyoonse, uutabonwa, Leza uuiide alike, akube bulemu akwaalaala lyoonse alyoonse kukabe kutamani. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
