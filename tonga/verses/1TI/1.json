            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Inc 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.4+ACT.9.5"
              },
              "items": [
                {
                  "text": "9:4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuciindi cakamana ndakali sikasankusanku asikakomokomo asikazundozundo, nekuboobo ndakafwidwa luzyalo nkaambo teendakazi ncendakali kucita cakutazumina. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno luzyalo lwa-Mwami wesu lwakavula nkavulila, antoomwe alusyomo aluyandano lwamuli-Kristo Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.2"
              },
              "items": [
                {
                  "text": "Lk 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.10"
              },
              "items": [
                {
                  "text": "19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ijwi linilini litambulika loko ndeeli lyakuti, Kristo Jesu wakaboola ansi ano kuzoofutula bacitazibi. Lino mebo ndi sizibi kwiinda boonse, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nekuboobo ndakafwidwa luzyalo kuti Jesu Kristo abonye busicamba bwakwe boonse mulindime, kuti cibe cileezyo kulibaabo boonse baciza kukuzoomusyoma akujana buumi butamani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
