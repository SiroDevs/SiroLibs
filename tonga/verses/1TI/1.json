              },
              "items": [
                {
                  "text": "Gal 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anu calo cintu ciyandwa nduyandano luzwa mumoyo uusalala amukweezeezya kubotu amulusyomo lwinilwini. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
