              "items": [
                {
                  "text": "Tit 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akulwana kwabantu bali amiyeeyo mibi akutaba alusinizyo. Aba bayeeya kuti kukomba ncecintu cijanya lubono.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
