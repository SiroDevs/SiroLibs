              },
              "items": [
                {
                  "text": "28:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele abo bayandisya kuvuba balawida mukutepaulwa amukuteegwa amuzisusi zibi zinji zyabufubafuba zibisizya buumi akubbizya bantu mukunyonyauka amukusweeka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
