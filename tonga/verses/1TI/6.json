              "items": [
                {
                  "text": "Job 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nkaambo takukwe ncotwakaleta ansi ano nociba ncotukonzya kutolelela nkuko, ",
          "type": "text",
