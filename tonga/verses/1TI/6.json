                  "text": "Tus 30:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aboobo kufumbwa twanoojisi cakulya acakulivumba, nciconya eco mbubo ncinji, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
