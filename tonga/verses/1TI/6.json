                  "text": "2 Tim 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yasana lumamba lubotu lwalusyomo, jatisya buumi butagoli, mbowakaitilwa, niwakalilungulula lulilungululo lubotu kubusyu bwabantu boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
