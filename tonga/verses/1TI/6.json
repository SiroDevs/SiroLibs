        },
        {
          "text": "Boonse abo abali mujoko lyabuzike kabapa bulemu boonse kulibasimalelo aabo, kuti kubule butongo bwaambwa bulwanya izina lya-Leza alwiisyo lwakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
