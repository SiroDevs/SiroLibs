                  "text": "Ef 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kuyandisya lubono ngomuyanda wabubi boonse, eno nkaambo kakuluyandisya bamwi ncobaleela kulusyomo, elyo zyabajaya insoni zinjizinji.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
