              "attrs": {
                "loc": "PHM.1.16"
              },
              "items": [
                {
                  "text": "Flm 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi abo bali abasimalelo aabo basyoma, batanoobasampauli nkaambo mbanabakwabo, pele kabaindilizya kubamanina milimo, nkaambo abo mbobabelekela milimo mbasyomi, alimwi mbayandwa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
