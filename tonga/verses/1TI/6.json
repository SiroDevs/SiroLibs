              "type": "tag",
              "attrs": {
                "loc": "2TI.1.13"
              },
              "items": [
                {
                  "text": "2 Tim 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwanooli muntu uufundisya bumbi, kufundisya kutajanene amakani aaelede ngaakaamba Mwami wesu Jesu Kristo alwiisyo lwabukombi bwinibwini, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo walisumpula taakwe ncazi. Moyo wakwe uli abulwazi bwakuyandisya ibuzyanyo ankondo zyamajwi, nkokuzwida ibbivwe, alukazyanyo, amajwi aakusampaula, akweezeezya kubi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
