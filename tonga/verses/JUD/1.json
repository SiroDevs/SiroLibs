                  "text": "2 Pet 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nokubaboobo aba basikulota-lota bacibisya mbubonya, balalisofwaazya kumibili, balaubaansya bwami akusampaula malemu.",
          "type": "text",
