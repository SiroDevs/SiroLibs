            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndime Johane, nendakabona zintu ezi akuziswiilila, Lino nindakaziswiilila akuzibona ndakaliwaala ansi kumaulu aangelo oyo iwakanditondezya zintu ezi, ndakati mukombe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele wakandikasya, wakati, Pe, utaciti obo, nkaambo ndi muzikenyoko buyo, ndi umwi wabanabakwanu basinsimi, ndi umwi wabaabo bajatisya makani aabbuku elino. Komba Leza.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        }
