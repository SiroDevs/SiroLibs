              "attrs": {
                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Ciy 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayoobona busyu bwakwe, alimwi izina lyakwe linooyoolembedwe kunkumu zyabo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
