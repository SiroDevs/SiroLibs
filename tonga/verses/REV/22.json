              "items": [
                {
                  "text": "Ciy 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.3"
              },
              "items": [
                {
                  "text": "1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubone, ndafwambaana kuboola, Uli acoolwe uupangika moyo wakwe kumajwi aabusinsimi bwamubbuku dino.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
