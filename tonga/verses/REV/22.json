            }
          ]
        },
        {
          "text": "Alimwi wandaambila kuti, Utanamatiki majwi aabusinsimi bwakubbuku elino, nkaambo ciindi cili afwaafwi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
