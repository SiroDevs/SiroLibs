                  "text": "1 Kor 14:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, Majwi aya ngalusyomo, alisinizye. Mwami Leza wamyuuya yabasinsimi watuma angelo wakwe kubatondezya bazike bakwe zintu zeelede kuba lino lino. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        },
        {
