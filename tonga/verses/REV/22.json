              "items": [
                {
                  "text": "Ciy 21:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takukooyooba limbi masiku, aboobo tabayandi kumunikilwa ilampi nuuba mumuni wazuba, nkaambo Mwami Leza nguuyoobamunikila, nkabela bayooendelezya lyoonse alyoonse kukabe kutamani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
