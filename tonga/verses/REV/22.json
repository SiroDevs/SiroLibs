                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakanditondezya mulonga wamaanzi aabuumi aabalangala mbuli krustalo, uleenda kuzwa kucuuno ca-Leza aca-Mwanambelele. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
