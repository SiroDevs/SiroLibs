                  "text": "Int 141:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino busi bwatununkilizyo ankombyo zyabasalali zyakasuka kuli-Leza kuzwa mujanza lyaangelo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
