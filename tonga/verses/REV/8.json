        },
        {
          "text": "Lino kwakeza angelo umbi, wakaima kucipaililo, wakalijisi katentelo kangolida, nkabela wakapegwa tununkilizyo tunjitunji, kuti atupaizye antoomwe ankombyo zyabasalali boonse acipaililo cangolida cili kunembo lyacuuno cabwami, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
