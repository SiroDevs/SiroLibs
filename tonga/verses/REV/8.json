          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo baangelo bali musanu ababili ibakajisi myeembo iili musanu aibili bakalibambila kwiilizya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
