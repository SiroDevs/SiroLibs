              "items": [
                {
                  "text": "Matl 49:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.14"
              },
              "items": [
                {
                  "text": "Heb 9:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mebo ndakamuvwiila kuti, Mwami, nduwe ozi. Nkabela wakandaambila kuti, Mbaaba bakazwa kumapenzi ayo mapati, alimwi bakasanzya zikobela zyabo akuzitubya mubulowa bwa-Mwanambelele. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.3"
              },
              "items": [
                {
                  "text": "Ciy 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako bali kunembo lyacuuno ca-Leza, balamumanina milimo isikati amasiku muntempele yakwe, nkabela oyo uukede acuuno cabwami uyookala akati kabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Is 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabakooyoofwa limbi inzala, tabakooyoofwa limbi nyota. Alyalo izuba talikooyoobabala, niiba inkasaalo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        },
