              "REV.7.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.11"
              },
              "items": [
                {
                  "text": "Ciy 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musule lyayaaya ndakalanga, ndakabona inkamu impati yabantu batabaliki kumuntu naba omwe, bazwa kuzisi zyoonse akumisyobo yoonse akumikowa yoonse akumyaambo yoonse, baliimvwi kunembo lyacuuno cabwami akunembo lya-Mwanambelele, balisamide zikobela zituba, alimwi mumaanza aabo balijisi malala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Ciy 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakoongolola ajwi ipati, bati, Lufutuko lulazwa kuli-Leza wesu uukede acuuno cabwami aku-Mwanambelele. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.11"
              },
              "items": [
                {
                  "text": "Ciy 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.16"
              },
              "items": [
                {
                  "text": "11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela baangelo boonse bakaliimvwi kuzyunguluka cuuno cabwami akuzyunguluka bapati abanyama bone, elyo bakaliwaala ansi cakuvundama kunembo lyacuuno cabwami, bamukomba Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakati, Ameni! Zilongezyo abulemu abusongo amilumbo alulemeko anguzu abukozu azibe kuli-Leza wesu lyoonse alyoonse. Ameni! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakandaambila umwi wabapati kuti, Ino aba basamide zikobela zituba mbaani? Bakazwa kuli? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
