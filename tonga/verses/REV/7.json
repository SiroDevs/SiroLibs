                  "text": "Mt 24:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musule lyayaaya ndakabona baangelo bone baliimvwi azyooko zyone zyanyika, baajata myuuwo yone yanyika, kuti luuwo lwaungi ansi nikuba kulwizi nikuba kumusamu uuli buti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndakabona angelo umbi uuya butanta kujulu kuzwa kujwe, wakalijisi cigwazyo ca-Leza muumi, nkabela wakoongolola ajwi ipati, wakaambila abo baangelo bone ibakapegwa bwami bwakucisya nyika alwizi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezk 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wati, Mutacisyi nyika niluba lwizi naaba masamu, mane tubagwale bazike ba-Leza wesu kunkumuzabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.1"
              },
              "items": [
                {
                  "text": "Ciy 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ndakaswiilila mweelwe wabaabo ibakagwalwa. Kwalagwalwa zyuulu zili mwaanda amakumi one azine akati kamisyobo yoonse yabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusyobo wa-Juda kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Rubeni kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Gadi kwakagwalwa zyuulu zili ikumi azibili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusyobo wa-Aseri kwakagwala zyuulu zili ikumi azibili. Kumusyobo wa-Nafitali kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Manase kwakagwalwa zyuulu zili ikumi azibili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusyobo wa-Simeoni kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Levi kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Isakara kwakagwalwa zyuulu zili ikumi azibili. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusyobo wa-Zabulo kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Josefa kwakagwalwa zyuulu zili ikumi azibili. Kumusyobo wa-Benjamini kwakagwalwa zyuulu zili ikumi azibili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
