                  "text": "Ciy 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino angelo wamusanu aumwi wakalizya mweembo, nkabela ndakamvwa ijwi lizwa kumeja one aacipaililo cangolida cili kunembo lya-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
            "verseOrgIds": [
              "REV.9.13"
            ]
          }
        },
