                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino angelo wasanu naakalizya mweembo, ndakabona inyenyeezi iiwide ansi kuzwa kujulu, nkabela wakapegwa cijaluzyo camulindi uutagoli, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
