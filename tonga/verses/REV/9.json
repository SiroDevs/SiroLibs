                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Ciy 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "lyamwaambila oyo angelo wamusanu aumwi iwakajisi mweembo kuti, Amwaangulule baangelo bone baangidwe mumulonga mupati Ufrate, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.7+REV.8.8+REV.8.9+REV.8.10+REV.8.11+REV.8.12"
              },
              "items": [
                {
                  "text": "Ciy 8:7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bakaangululwa baangelo bone ibakabambilidwe kukaindi komwe akubuzuba bomwe akumweezi omwe akumwaaka omwe kuti bajaye cipanzi catatu cabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mweelwe wabasinkondo basimbizi bakali myaanda yobile yazyuulu zyazyuulu. Lino ndakaswiilila mweelwe wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mucilengano cangu mboobu mbundakabona imbizi abaabo ibakakede alinzizyo. Basimbizi bakalijisi zivunyo zyacamba, zimwi zyakasalala mbuli mulilo, zimwi zyakasia mbuli iakinte, azimwi zyakali mbuli sulufa. Alimwi mitwe yambizi yakali mbuli mitwe yabalavu, nkabela kumilomo yazyo kwakazwa mulilo abusi asulufa. ",
          "type": "text",
          "attrs": {
