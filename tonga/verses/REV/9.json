                {
                  "text": "Matl 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.18"
              },
              "items": [
                {
                  "text": "Kul 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.2"
              },
              "items": [
                {
                  "text": "Joel 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakajula mulindi uutagoli, mpawo kwakazwa busi kumulindi mbuli busi bwabbila lyamulilo, nkabela lyakasizigwa izuba, awalo muuwo, nkaambo kabusi bwamumulindi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.12+EXO.10.13+EXO.10.14+EXO.10.15"
              },
              "items": [
                {
                  "text": "Kul 10:12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo kubusi kwakazwa cikwikwi, cakeenda ansi, cakapegwa inguzu mbubonya mbuli inguzu zyatubanze nzitujisi ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezk 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Ciy 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino eco cikwikwi cakalaililwa kuti citanoobisizyi bwizu bwaansi, niciba cintu cimwi citete, nuuba musamu uuli buti, pele abo bantu balike batajisi citondezyo ca-Leza cigwalidwe kunkumu zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.4",
            "verseOrgIds": [
              "REV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teecakazumizigwa kubajaya, pele kubapenzya-penzya buyo myeezi yosanwe, nkabela kupenzyapenzya kwaco kwakali mbuli kupenzya-penzya kwakabanze nokaluma muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.5",
            "verseOrgIds": [
              "REV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.21"
              },
              "items": [
                {
                  "text": "Job 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.3"
              },
              "items": [
                {
                  "text": "Jer 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.30"
              },
              "items": [
                {
                  "text": "Lk 23:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mumazuba ayo bantu bayooyandaula lufu pele tabakalwani, bayooyandisya kufwa pele lufu luyoobacija. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.4"
              },
              "items": [
                {
                  "text": "Joel 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ciimo cacikwikwi cakalikozyenye ambizi zibambilwa inkondo, alimwi amitwe yaco akali misini iili mbuli ingolida, aalo masyu aaco akalikozyenye amasyu aabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.6"
              },
              "items": [
                {
                  "text": "Joel 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Masusu aaco akali mbuli masusu aabanakazi, ameno aaco akalikozyenye ameno aabalavu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.5"
              },
              "items": [
                {
                  "text": "Joel 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela cakalijisi zivunyo zyacamba zili mbuli zivunyo zyalubulo, alimwi muzumo wamababa aaco wakali mbuli muzumo wanola zinji ambizi zizuzaanina kunkondo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakalijisi micila mbuli tubanze, yakali alumoola, nkabela mumonya mumicila yaco muzibede inguzu zyaco zyakupenzya-penzya bantu myeezi yosanwe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi cilijisi mwami waco, ngu-angelo wamulindi uutagoli, izina lyakwe muci-Hebrayo ngu-Abadoni, pele muci-Helene nguApoliyoni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
