                "loc": "REV.16.19"
              },
              "items": [
                {
                  "text": "16:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ankumu yakwe akalilembedwe izina, ndeeli, MAKANI AASISIDWE. BABULONI MUPATI UUZYALA BASIBWAAMU AZISESEMYO ZYAANSI. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
