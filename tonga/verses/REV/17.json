              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino angelo wakandaambila kuti, Ino nkaambonzi nowagamba? Mebo ndakwaambila makani aamwanakazi oyu amakani aacinyama ncatantide cijisi mitwe iili musanu aibili ameja aali ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
