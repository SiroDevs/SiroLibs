                "loc": "REV.18.24"
              },
              "items": [
                {
                  "text": "Ciy 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakabona kuti mwanakazi oyo ulikoledwe abulowa bwabasalali abulowa bwabaabo ibakajayigwa nkaambo ka-Jesu, elyo nindakamubona ndakagamba lugambo lupati.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
