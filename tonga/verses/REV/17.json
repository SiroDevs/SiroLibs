              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi bayoolwana a-Mwanambelele, pele Mwanambelele uyoobazunda, nkaambo ngonguwe mwami wabami, ngumweendelezi wabeendelezi. Abalo balazunda mbali abo, baitidwe, basale, basyomi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        }
      ]
