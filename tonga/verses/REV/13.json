        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan 7:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.3"
              },
              "items": [
                {
                  "text": "Ciy 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eco cinyama ncindakabona­ cakalikozyenye asiluwe, azituta zyakwe zyakali mbuli zituta zyanengo, amulomo wakwe wakali mbuli mulomo wamulavu. Nkabela Simwaaba wakamupa inguzu zyakwe acuuno cakwe abwami bunji. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.8"
              },
              "items": [
                {
                  "text": "Ciy 17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakabona kuti umwi mutwe wakwe wakaliyasidwe calufu, pele ciyaso cakwe calufu cakaponesegwa, nkabela nyika yoonse yakagamba kucinyama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakakomba Simwaaba iwakapa cinyama inguzu, acalo cinyama bakacikomba, bakati, Nguni uukozyenye acinyama? Nguni uukonzya kulwana aco? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        },
        {
