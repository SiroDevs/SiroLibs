            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.2+DEU.13.3+DEU.13.4"
              },
              "items": [
                {
                  "text": "Dt 13:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Ciy 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo cabeena boonse bakala ansi nkaambo kazeezyo zigambyo nzicakazumizigwa kucita kumeso aacinyama citaanzi. Cakabaambila abo bakala ansi kuti baleelede kucita cikozyano cacinyama eco icakayasidwe apanga pele alimwi capona. ",
