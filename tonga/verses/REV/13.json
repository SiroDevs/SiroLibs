                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela boonse bakala ansi bayoomukomba, nkukuti abo batajisi mazina aalembedwe mubbuku lyabuumi lya-Mwanambelele iwakajayidwe kuzwa kumatalikilo aanyika, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo uujisi matwi aswiilile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
