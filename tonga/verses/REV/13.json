        },
        {
          "text": "Lino wakapegwa mulomo uuamba makani mapati abusanke, alimwi wakapegwa inguzu zyakucikala myeezi iili makumi one amyeezi yobile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakaasamuna mulomo wakwe akusanka Leza, Wakasanka izina lyakwe aŋanda yakwe abaabo bakala mujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
