                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi cilacita zigambyo zipati, cilakwela ansi mulilo kuzwa kujulu kumeso aabantu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
