              "attrs": {
                "loc": "1KI.18.24+1KI.18.25+1KI.18.26+1KI.18.27+1KI.18.28+1KI.18.29+1KI.18.30+1KI.18.31+1KI.18.32+1KI.18.33+1KI.18.34+1KI.18.35+1KI.18.36+1KI.18.37+1KI.18.38+1KI.18.39"
