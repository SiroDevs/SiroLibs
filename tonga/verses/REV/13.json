        },
        {
          "text": "Lino ndakabona cinyama cizwa mulwizi, cakalijisi mitwe iili musanu aibili ameja aali ikumi. Atala ameja aakwe akali misini iili ikumi, nkabela amitwe yakwe akali mazina aabusanke. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
