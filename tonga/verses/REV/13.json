            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Ciy 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakapegwa inguzu zyakulwanya basalali akubazunda, alimwi wakapegwa bwami bwakweendelezya misyobo yoonse amikowa yoonse amyaambo yoonse amasi oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
