        },
        {
          "text": "Elyo wakoongolola ajwi ipati mbuli kukuluma kwamulavu, nkabela naakamana kulila, mizumo iili musanu aibili yakandindima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
