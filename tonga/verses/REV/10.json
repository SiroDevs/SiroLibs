                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ndakaswenenena angelo, ndakamwaambila kuti, Ndipa kabuku aka, Wakati, Bweza, ukalye koonse, lino kayookuluzya mwida, pele mukanwa lyako kalalwela mbuli buci. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndakabweza kabuku mujanza lyaangelo, ndakalya koonse, nkabela mukanwa lyangu kakalwela mbuli buci, pele nindakamana kukalya, mwida lyangu mwakalula. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
