        },
        {
          "text": "Lino ndakabona angelo umbi singuzu uuza buseluka kuzwa kujulu. Wakalisamide ikumbi, kwakali fulicoongo kumutwe wakwe, busyu bwakwe bwakali mbuli izuba, amaulu aakwe akali mbuli misemu yamulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.1",
            "verseOrgIds": [
              "REV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mujanza lyakwe wakalijisi kabuku kajulidwe. Lino wakabika cituta cakwe calulyo alwizi, acituta cakwe calumwensi anyika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.2",
            "verseOrgIds": [
              "REV.10.2"
            ]
          }
        },
