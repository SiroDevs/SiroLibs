            "caller": "#"
          },
          "items": [
            {
              "text": "Ezk 2:8–3:3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino elyo ijwi ndilyonya ndindakamvwa lizwa kujulu lyakandaambila lwabili kuti, Koya, ukabweze kabuku kajulidwe mujanza lyaangelo uuimvwi alwizi anyika. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
