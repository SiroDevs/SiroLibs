              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone, njoomuwaala kubulo, abaaba basimamambenyina njoobanjizya mumapenzi mapati, cita beempwe kumilimo yabo. ",
          "type": "text",
          "attrs": {
