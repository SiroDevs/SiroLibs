                "loc": "PSA.139.21"
              },
              "items": [
                {
                  "text": "Int 139:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ciyanza comwe cibotu ncojisi nceeci, cakuti ulasulaika milimo yabaNikolai, njensulaika ambebo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.6",
