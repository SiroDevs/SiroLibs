              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ndakamupa ciindi cakweempwa, pele tayandi kweempwa kubumambe bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
