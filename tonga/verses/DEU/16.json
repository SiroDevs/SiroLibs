              },
              "items": [
                {
                  "text": "Lk 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino amusekelele kubusyu bwa-Jehova Leza wanu, nywebo, abana banu balombe abasimbi, abalanda banu baalumi abanakazi, aba-Levi bakede mumaanda aanu, abeenzu abamucaala abamukabafu bakede akati kanu, kubusena obo Jehova Leza wanu mbwasala kuti abike izina lyakwe nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
