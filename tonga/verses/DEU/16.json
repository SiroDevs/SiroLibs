        },
        {
          "text": "Zyamana, amulye ipobwe lya-Pentekoste lya-Jehova Leza wanu. Amuletelele cipo camoyo mumaanza aanu, mupe mbubonya mbuli Jehova Leza wanu mbwamupa coolwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
