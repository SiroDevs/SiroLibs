                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambweni mwalya cakukuta akuyaka maanda mabotu akukala mulingao, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
