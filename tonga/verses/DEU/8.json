                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino muyoolya akukuta, akulongezya Jehova Leza wanu nkaambo kanyika imbotu njamupa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
