              "items": [
                {
                  "text": "Neh 9:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zyakusama zyanu teezyakazakaala, amaulu aanu taakwakazimba, myaka eyi yoonse iili makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
