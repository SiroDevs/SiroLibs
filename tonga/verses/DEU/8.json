        {
          "text": "Lino amuzibe mumyoyo yanu kuti, mbubonya mbuli muntu mbwatambisya mwanaakwe, Jehova Leza wanu ulamutambisya anywebo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubambe milazyo ya-Jehova Leza wanu, amweende munzila zyakwe akumuyoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Jehova Leza wanu ulamusisya kunyika imbotu, nyika yatulonga twamaanzi, nyika yatusensa amatoolo, maanzi mwaazwa akati kamakuti aazilundu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyika yabulotwe abbaale, yamasaansa amakuyu amapomegranite, nyika yamaolifa aali amafuta, abuci, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyika nkomukonzya kulya cakukuta, nkomutakonzyi kubula cintu, nyika iili amabwe aabutale, azilundu nkomukonzya kusya mukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        },
        {
