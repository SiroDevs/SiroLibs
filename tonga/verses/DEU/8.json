        },
        {
          "text": "Wakamubombya, wamujazya inzala, wamusanizya mana, cilyo ncimwatakezi nywebo nibaba bamauso, kuti amuzibye kuti teensi insimi ilike iiponya muntu; muntu ulapona kumajwi oonse aazwa mumulomo wa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
