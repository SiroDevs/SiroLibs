              "items": [
                {
                  "text": "Bab 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wabula kukubotezya, ulakonzya kumuleka kuti aye kufumbwa nkwayanda, pele kuulisya toelede kumuulisya pe; toelede kumucitila mbuli muzike, nkaambo wamusofwaazya kale.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        }
