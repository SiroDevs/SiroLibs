                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ciindi cakuya kuyoolwisya basinkondonyokwe, Jehova Leza wanu na wabaaba mumaanza aanu, alimwi mwaanga baange, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akati kabaange wabona mwanakazi uuebeka, alimwi moyo wako ulayandisya kumukwata, abe mukaako, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.11",
            "verseOrgIds": [
              "DEU.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "umutole kuŋanda yako, alinyoole kumutwe akugonka maala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
