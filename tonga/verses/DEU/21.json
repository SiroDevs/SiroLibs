                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kolekelela bantu bako ba-Israyeli mbowakanununa, O Jehova; utabapi bantu bako ba-Israyeli mulandu wabulowa bwabatakwe kaambo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.13"
              },
              "items": [
                {
                  "text": "Dt 19:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo mbomweelede kumanya mulandu wabulowa butakwe kaambo akati kanu, nemucita ciluleme mumeso aa-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
