              "items": [
                {
                  "text": "Int 45:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino asamunune zyakusama zyakwe zyabwaange, akale muŋanda yako, alile wisi abanyina mwezi uuzulide. Amane kucita obo, ulakonzya kuswanaana awe akumukwata, abe mukaako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
