                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munyika eyo Jehova Leza wanu njayoomuvubya, na kwajanwa muntu uujayidwe ulidumene musokwe, nkabela takuzibwi na ngwani waka­ mujaya, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bapati banu ababetesi banu baye, bakapime musinzo mbuubede kuzwa kuminzi iizyungulukide mutunta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bapati bamunzi oyo uuli kufwaafwi babweze citole citana kubopwa na kubelesegwa milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bapati bamunzi batole eco citole kukalonga katayuminini, nyika nkwiitana kulimwa nanka kubyalwa, bakosole mutwe waco nkukonya oko kukalonga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
          },
          "items": [
