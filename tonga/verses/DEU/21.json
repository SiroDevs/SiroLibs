              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamana kucita obo, baswene bapaizi, bana ba-Levi, nkaambo mbembabo Jehova Leza wanu mbaakasala kuti bacite milimo yabupaizi akulongezya bantu muzina lya-Jehova, alimwi kumulotno wabo makani oonse ankazyano zyoonse nkoziyookoswedwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
