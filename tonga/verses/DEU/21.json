              "items": [
                {
                  "text": "2 Sam 3:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakonkezye kuti, Teensi maanza esu aakatila obu bulowa, ameso esu taakwe naakabona sikujaya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
