                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mwaya kuyoolwisya basinkondonyoko, akubona imbizi ankalaki abantu banji kwiinda ndinywe, mutabayoowi pe, nkaambo Jehova Leza wanu iwakamugwisya munyika ya-Egepita uli anywebo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.1",
            "verseOrgIds": [
              "DEU.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela kuciindi cakuyanda kutalika kulwa, mupaizi aboole kuzooambila bantu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.2",
            "verseOrgIds": [
              "DEU.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaambile kuti, Amuswiilile noba-Israyeli, Sunu mwaamba kulwisya basinkondonyoko; myoyo yanu itatuntaani; mutayoowi nekuba kukankama kubusyu bwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.3",
            "verseOrgIds": [
              "DEU.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.30"
              },
              "items": [
                {
                  "text": "Dt 1:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.22"
              },
              "items": [
                {
                  "text": "3:22",
