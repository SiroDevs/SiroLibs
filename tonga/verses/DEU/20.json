                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwaswena buyo kumunzi kuulwisya, amutaangune kwaamba aluumuno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.10",
            "verseOrgIds": [
              "DEU.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.21"
              },
              "items": [
                {
                  "text": "1 Bam 9:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino na bavwiila caluumuno akumujalwida milyango, bantu boonse bamumunzi oyo balaba basicibbalo, bamumanine milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.11",
            "verseOrgIds": [
              "DEU.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na bakaka kutambula luumuno, na babusya inkondo, amubasinkinizye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.12",
            "verseOrgIds": [
              "DEU.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.7"
              },
              "items": [
                {
                  "text": "My 31:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova Leza wanu na waaba oyo munzi mumaanza aanu, amujaye baalumi boonse apanga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.13",
            "verseOrgIds": [
              "DEU.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.2"
              },
              "items": [
                {
                  "text": "Jos 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.8"
              },
              "items": [
                {
                  "text": "22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele banakazi, abana, aŋombe, ambono zimwi zyoonse zyamumunzi, amuzisaale, zibe zyanu; amuzilye zisaalo zyabasinkondonyokwe Jehova Leza wanu nzyamupa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.14",
            "verseOrgIds": [
              "DEU.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbumweelede kucitila minzi yoonse iili kule loko, nkokuti minzi iitali yabamasi bali okuno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.15",
            "verseOrgIds": [
              "DEU.20.15"
            ]
          }
        },
