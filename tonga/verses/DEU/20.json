                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele muminzi yabantu abana Jehova Leza wanu njamupa kuti mwiivube, mutasii naba omwe uucipona; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.16",
            "verseOrgIds": [
              "DEU.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
