          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "amubanyonyoone boonse buyo, ba-Hiti aba-Amori, ba-Kanana aba-Perizi, ba-Hivi aba-Jebusi, mbubonya mbuli Jehova Leza wanu mbwaakalailila; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.17",
            "verseOrgIds": [
              "DEU.20.17"
            ]
          }
        },
