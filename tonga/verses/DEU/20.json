            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.23.10"
              },
              "items": [
                {
                  "text": "Jos 23:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo Jehova Leza wanu nguumuzulwida kuti amulwide kulibasinkondonyokwe akumuzundya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.27"
              },
              "items": [
                {
                  "text": "Neh 12:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo basilutwe baambile bantu kuti, Kufumbwa muntu uuyakide iŋanda impya, pele tanaisalazya, apiluke kuŋanda yakwe; atene ulafwa munkondo, lino muntu umbi ulaisalazya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.5",
            "verseOrgIds": [
              "DEU.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muntu uulimide muunda wamasaansa, pele tana kulya micelo yawo, alakwe apiluke kuŋanda; atene ulafwa munkondo, lino muntu umbi ulalya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.6",
            "verseOrgIds": [
              "DEU.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.5"
              },
              "items": [
                {
                  "text": "Dt 24:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa muntu uukalide mwanakazi, pele tana kumutola kuŋanda, alakwe apiluke kumunzi; atene ulafwa munkondo, lino muntu umbi ulamukwata. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.7",
            "verseOrgIds": [
              "DEU.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.3"
              },
              "items": [
                {
                  "text": "Bab 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi basilutwe baambile bantu kuti, Kufumbwa muntu uuli amoyo uutunteene akuyoowa apiluke kumunzi, kuti myoyo yabeenzinyina itatyompezegwi mbuli moyo wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.8",
            "verseOrgIds": [
              "DEU.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino basilutwe bamana buyo kwaambila bantu, babike basilutwe bakuzulwida bantu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        }
      ]
