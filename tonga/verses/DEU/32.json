              "items": [
                {
                  "text": "Dt 3:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo mbubonya Jehova wakaambila Musa kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanta eci cilundu ca-Abarimu, cilundu ca-Nebo munyika ya-Moabu, cilangene a-Jeriko, uebele nyika ya-Kanana njendapa bana ba-Israyeli kuti baivube. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ulafwa oko kucilundu nkosi tante, utolwe kulibamauso, mbubonya mbuli Aroni munyoko mbwaakafwa kucilundu ca-Hori akutolwa kulibasikale bakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.11"
              },
              "items": [
                {
                  "text": "My 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo mwakandipapila akati kabana ba-Israyeli kumaanzi aa-Meriba-Kadesi munkanda ya-Zini, nkaambo mwakabula kundilemeka akati kabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubona ulabona nyika ameso aako kule, pele kusika tokooyoosika oko kunyika njendapa bana ba-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
