            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.5"
              },
              "items": [
                {
                  "text": "Rom 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo tacili cintu ciniini buyo pe, mbobuumi bwanu. Mumakani aya momukonzya koongweda munyika eyo njemuyoovuba mutala lya-Jordano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
