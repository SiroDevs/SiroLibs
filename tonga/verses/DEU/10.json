                "loc": "EXO.37.1"
              },
              "items": [
                {
                  "text": "37:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ndakabeza ibbokesi lyamuunga, alimwi ndakabeza mabwe obile mbubonya mbuli mataanzi, nkabela ndakatanta acilundu nkejisi mabwe ayo obile mujanza lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.3",
            "verseOrgIds": [
              "DEU.10.3"
            ]
          }
        },
