            }
          ]
        },
        {
          "text": "Lino kuciindi eco Jehova wakandaambila kuti, Beza mabwe obile mbubonya mbuli mataanzi, utante ano acilundu mpombede, alimwi kolipangila ibbokesi lyazisamu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela njoolemba amabwe ayo majwi aakalembedwe amabwe mataanzi ngowakapwaya, lino uleelede kwa abika mukati kabbokesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
