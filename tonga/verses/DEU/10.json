              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Nyampuka, uzulwide bantu, kuti banjile akuvuba nyika njendakakonkezya bamawisi kubapa.",
          "type": "text",
          "attrs": {
