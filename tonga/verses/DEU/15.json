          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalubi kuti anywebo mwakali bazike munyika ya-Egepita, nkabela Jehova Leza wanu wakamunununa. Nciceeco ncindamulailila obo sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
