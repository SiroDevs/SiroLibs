        },
        {
          "text": "Pele na oyo muntu waamba kuti, Nsikooyookusia, nkaambo ulayandisya basiŋanda bako, alimwi ulikede kabotu kulinduwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.16",
