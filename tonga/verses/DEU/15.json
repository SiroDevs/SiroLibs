              },
              "items": [
                {
                  "text": "Jer 34:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kumamanino aamyaka iili musanu aibili muleelede kucita lwaangunuko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndoolu lwaangunuko. Kufumbwa muntu sikukolotelwa alekelele mweenzinyina ncaakamukolotya, Atasesi mweenzinyina na sikamukowanyina, pe, nkaambo lwaangunuko lwa-Jehova lwasika. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20"
              },
              "items": [
                {
                  "text": "Dt 23:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kumuzwakule ulakonzya kusesa, pele kufumbwa cintu cako cili mumaanza aamunyoko, ucileke buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.8"
              },
              "items": [
                {
                  "text": "Dt 28:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele takukooyooba batengwana akati kanu, (nkaambo Jehova ulamupa coolwe munyika eyo Jehova Leza wanu njamupa kuti mwiikone), ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwaswiililisya ijwi lya-Jehova Leza wanu kukucenjela kubamba malailile aya oonse ngendamulailila buzuba obuno, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.7"
              },
              "items": [
                {
                  "text": "Tus 22:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Jehova Leza wanu uyoomupa coolwe, mbubonya mbwaakamusyomezya, aboobo muyookolotya bamasi banji, pele nywebo tamukooyookolota; muyooendelezya zisi zinji, pele tabakooyoomweendelezya pe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
