                  "text": "Mik 6:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utabi amabwe aabulemu aapambukene munkomo yako, ibbwe ipati abbwe diini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuŋanda yako utabi azyeelesyo zipambukene, cipati aciniini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.12"
              },
              "items": [
                {
                  "text": "Kul 20:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uleelede kuba abbwe lyabulemu lizwide liluleme, aceelesyo cizwide ciluleme, kuti uongole anyika eyo Jehova Leza wako njakupa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
