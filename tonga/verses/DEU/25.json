                "loc": "DEU.19.13"
              },
              "items": [
                {
                  "text": "Dt 19:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "muleelede kumukosola ijanza, mutamufwidi insoni pe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
