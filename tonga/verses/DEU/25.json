                  "text": "Rut 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na babunyina balikede antoomwe, alimwi umwi wabo wafwa katajisi mwana, mukamufu teelede kukwatwa kumuntu buyo; muzyalwanyina mulumaakwe uleelede kumukwata, abe mwanakazi wakwe, amucitile bweelede muzyalwanyina mulumaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.9"
              },
              "items": [
                {
                  "text": "Matl 38:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwana mutaanzi ngwazyala uyoolya izina lyamukwabo mufu, kuti izina lyakwe litafwidilili mucisi ca-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7+RUT.4.8"
              },
              "items": [
                {
                  "text": "Rut 4:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na oyo muntu tayandi kukwata mukamuzyalwanyina, mwanakazi aye kubapati kumulyango wamunzi, abaambile kuti, Muzyalwanyina mulumaangu wakaka kubusizya mwanaakwabo izina mucisi ca-Israyeli, tayandi kundicitila bweelede. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bapati bamunzi wakwe baleelede kumwiita, baambaule awe. Lino na wakakilila cakwaamba kuti, Nsiyandi kumukwata, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7"
              },
              "items": [
                {
                  "text": "Rut 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.20.2"
              },
              "items": [
                {
                  "text": "Is 20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mukamuzyalwanyina uleelede kumuswenenena kumeso aabapati, amugwisizye insangu kucituta cakwe akumuswida mate kubusyu, avuwe kuti, Mbuboobo mbweelede kucitilwa muntu uukaka kuyakila mwanaakwabo luzubo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
