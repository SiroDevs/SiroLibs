              "items": [
                {
                  "text": "Job 18:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulakonzya kuumwa azyuumo zili makumi one, pele teelede kwiindilizya; na waindilizya kumuuma, nkokuti munyoko ulasampukilwa buntu bwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
