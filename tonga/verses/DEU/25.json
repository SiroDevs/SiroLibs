            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.7"
              },
              "items": [
                {
                  "text": "1 Tim 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino izina lyaluzubo lwakwe lilaambwa akati kaba-Israyeli kuti nduzubo lwayooyo iwakagwisigwa insangu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
