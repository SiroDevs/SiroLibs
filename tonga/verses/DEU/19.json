                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.13"
              },
              "items": [
                {
                  "text": "1 Bam 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kwabuka sikulengelela kaambo uuyanda kupa mweenzinyina mulandu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
