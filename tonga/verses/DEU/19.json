            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.10"
              },
              "items": [
                {
                  "text": "Hos 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulukono lwanu lwamunyika eyo Jehova Leza wanu njayoomuvubya, mutasunzululi minyinza yabeenzinyoko njebakabika basikale.",
          "type": "text",
