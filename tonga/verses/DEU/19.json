              },
              "items": [
                {
                  "text": "1 Joh 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele na muntu ulisulide mweenzinyina, lino ulamuyubilila akusokomoka akumujaya, nkabela wacijila kuluumwi waminzi eyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bapati bamunzi wakwe batume, bamugwisye nkuko, bamwaabe mumaanza aasikuliya inkoto yabulowa, kuti afwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.31"
              },
              "items": [
                {
                  "text": "1 Bam 2:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Meso aanu atamufwidi luzyalo pe; amumanisye milandu yabulowa bwabaluleme mucisi ca-Israyeli, kuti mukale kabotu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
