                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kamboni omwe alike takonzyi kupesya muntu mulandu mumakani ngaakabisya na mucintu mwaakasotoka mulao. Kumilomo yabakamboni bobile na botatwe makani alakonzya kusima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
