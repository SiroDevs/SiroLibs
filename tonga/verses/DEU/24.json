              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ciindi cakukoonza maolifa aako, utaindululi; micelo iisyeede ibe yamweenzu ayamucaala ayamukamufu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
