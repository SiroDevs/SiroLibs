                  "text": "Mk 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mwaalumi weeba mwanakazi akumukwata, lino musule wamubijila, nkaambo wajana cintu cuusya insoni mulinguwe, aboobo wamulembela lugwalo lwakulekana, walubika mumaanza aakwe, wamutanda kuzwa kuŋanda yakwe, elyo amana kuzwa kuŋanda yakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waakukwatwa kumwaalumi umbi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela oyo mwaalumi wabili wamusula, wamulembela lugwalo lwakulekana, walubika mumaanza aakwe, wamutanda kuzwa kuŋanda yakwe, alimwi na wafwa mwaalumi wabili iwakamukwata, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.1"
              },
              "items": [
                {
                  "text": "Jer 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mulumaakwe mutaanzi iwakamukwete, iwakamutanda, takonzyi kumubweedela alimwi kuti amukwate, naamana kusofwaazigwa. Kucita obo ncisesemyo kumeso aa-Jehova, cilaleta mulandu kunyika Jehova Leza wanu njamuvubya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
