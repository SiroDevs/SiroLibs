        },
        {
          "text": "Na wakolotya mweenzinyoko cikoloto niciba comwe, utainki muŋanda yakwe kuyoogwisya cisyomezyo cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
