              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ciindi cakucela masaansa aako, utavululi; micelo iisyeede ibe yamweenzu ayamucaala ayamukamufu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
