        {
          "text": "muleelede kubweza kabalwebalwe kazilyo zyoonse zyanyika nzimulima munyika Jehova Leza wanu njamupa, mubweze muntumba, muye azyo kubusena obo Jehova Leza wanu mbwasala kuti akazike izina lyakwe nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleelede kuya kumupaizi uubeleka kuciindi eco, mumwaambile kuti, Ndaamba buzuba obuno kubusyu bwaJehova Leza wako kuti ndasika ncobeni kunyika Jehova njaakakonkezya bamatateesu kutupa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamana kwaamba obo, mupaizi atambule intumba kumaanza aako, aitule kunembo lyacipaililo ca-Jehova Leza wako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        }
      ]
