        {
          "text": "Lino uleelede kwaamba kubusyu bwa-Jehova Leza wako kuti, Taata kali mu-Aramu simutuntuli, elyo wakainka ku-Egepita akukala-kala nkuko naakajisi bantu bace buyo, pele oko wakaba ciinga cipati ciyumu akuvula loko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
