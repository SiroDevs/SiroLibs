              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndibwene ndemwini busungu bwakwe mbwasungwaalila ndinywe abaku-Laodikeya abaku-Herapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
