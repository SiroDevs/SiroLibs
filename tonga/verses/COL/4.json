                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulamujuzya Luka, musiliki uuyandika, alakwe Dema. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
