          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Jesu uutegwa Justo. Aba botatwe mbombabo balike akati kabasibupalule mbutubeleka abo milimo ya-Bwami bwa-Leza. Mbibanduumbulizizya moyo, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
