                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nciconya eco ncindamutumina kuzoomuswaya, kuti amuzibye mbutubede akutontozya myoyo yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
