                  "text": "Flm 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulamujuzya Epafra, nguumwi wakulindinywe, ngumuzike wa-Kristo Jesu. Ulazumba lyoonse munkombyo zyakwe nkaambo kanu, cakukomba kuti mwiime nji mbuli balondokede akulamwa mbuzibede zintu zyoonse nzyayanda Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
