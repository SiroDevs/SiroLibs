          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lugwalo olu nolwamana buyo kubalwa kulindinywe, amucite kuti lubalwe akwalo kumbungano yabaku-Laodikeya, nkabela anywebo mukabale lugwalo ndundakatuma ku-Laodikeya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
            "verseOrgIds": [
              "COL.4.16"
