        {
          "text": "Barnaba, (Mulitambwide kale mulazyo wakuti, asika oyo, mumususunkanine), ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
