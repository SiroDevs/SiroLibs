          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakaboola kulinguwe ku-Jeriko nkwaakakede, Nkabela wakabaambila kuti, Sa teendakamwaambila kuti mutainki na?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
