          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu bali makumi osanwe babana babusinsimi bakaakwiimikana kulekule bulangene abo, boonse bobile nibakaimvwi ku-Jordano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
