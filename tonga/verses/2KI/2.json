              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakajata zyakusama zyakwe, wazizapaula muzipanzi zyobile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        },
