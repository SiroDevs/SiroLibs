        },
        {
          "text": "Mpawo bakanyampuka, bacija kuciindi eco calundindiwana, basia zilao zyabo amabbiza aabo ambongolo zyabo zyoonse mbuli mbuzibede, akucijisya maumi aabo kulufu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.7",
            "verseOrgIds": [
              "2KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino abo basicinsenda nibakasika kumatalikilo aazilao, bakanjila mucilao cimwi, balya, banywa, bagwisya insiliva angolida azyakusama, baakuzisisa, elyo bakaboola alimwi kucilao cimbi, bagwisya zintu mumonya, baakuzisisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.8",
            "verseOrgIds": [
              "2KI.7.8"
            ]
          }
        }
