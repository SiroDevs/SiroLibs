                }
              ]
            }
          ]
        },
        {
          "text": "Cakaba mbubonya mbuli ijwi lyamuntu wa-Leza ndyaakaambila mwami, lyakuti, Zisuwo zyobile zyabbaale ziyooulwa isyekeli lyomwe, acisuwo cabusu butuba ciyooulwa isyekeli, mumulyango wa-Samariya junza mbuli eno. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.18",
            "verseOrgIds": [
              "2KI.7.18"
            ]
          }
        },
        {
