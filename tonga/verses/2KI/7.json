            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.17+LUK.15.18+LUK.15.19"
              },
              "items": [
                {
                  "text": "Lk 15:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na twaamba kuti, Atunjile mumunzi, lino inzala nkwiili, tulafwa. Alimwi na katukede mpoonya ano, tulafwa. Katuya kuzilao zyaba-Aramu, Na batubamba, tuyoopona. Na batujaya, tuyoofwa buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.4",
            "verseOrgIds": [
              "2KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakanyamuka ciindi calundindiwana, basika kumatalikilo aazilao zyaba-Aramu, pele bajana kuti taakwe muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
