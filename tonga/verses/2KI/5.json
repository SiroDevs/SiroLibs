            }
          ]
        },
        {
          "text": "Pele mucintu eci cilike Jehova andilekelele ndemulanda wako. Kufumbwa ciindi simalelo wangu naanjila muŋanda ya-Rimoni kuyookomba, alimwi ulayaamina alindime, aboobo ndakotama muŋanda ya-Rimoni, Jehova andilekelele aya makani aakukotama muŋanda ya-Rimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
