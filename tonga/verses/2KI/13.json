        },
        {
          "text": "Elyo Jehova wakabusizya Israyeli muyuni wakubavuna mumaanza aabaAramu, aboobo ba-Israyeli bakakala mumaanda aabo mbubonya mbuli lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
