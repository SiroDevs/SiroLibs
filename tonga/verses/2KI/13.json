                  "text": "Job 22:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Elisha wakaciswa bulwazi bwakwe bwankwelelela, nkabela Joasi mwami wa-Israyeli wakeza kumuswaya, walila kubusyu bwakwe, wati, Taata! Taata! Inkalaki ya-Israyeli abasimabbiza bayo! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
