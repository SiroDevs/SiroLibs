        {
          "text": "Mumwaka wamakumi obile aitatu wabwami bwa-Joasi mwana waAhaziya mwami wa-Juda, Jehoazi mwana wa-Jehu wakaba mwami wa-Israyeli mu-Samariya, nkabela wakeendelezya myaka iili ikumi amusanu aibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
