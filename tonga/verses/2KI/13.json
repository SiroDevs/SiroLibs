              "items": [
                {
                  "text": "Am 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Jehoazi taakwe naakasyaalilwa bantu, cita basimabbiza bali makumi osanwe ankalaki zili ikumi abasimyeendo bali zyuulu zili ikumi, nkaambo mwami wa-Aramu wakabanyonyoona akubacita mbuli lusuko lwacipolelo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
