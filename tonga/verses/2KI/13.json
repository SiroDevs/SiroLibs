          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakacita bubi mumeso aa-Jehova, Taakwe naakaleka abuniini zibi zya-Jeroboamu mwana wa-Nebati nzyaakacitya ba-Israyeli, Wakeenda mulinzizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
