          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Elisha wakamwaambila kuti, Bweza buta amivwi. Wakabweza buta amivwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
