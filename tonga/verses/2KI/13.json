              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamakumi otatwe amusanu aibili wabwami bwa-Joasi mwami wa-Juda, Joasi mwana wa-Jehoazi wakaba mwami wa-Israyeli muSamariya, nkabela wakeendelezya myaka iili ikumi amusanu aumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
