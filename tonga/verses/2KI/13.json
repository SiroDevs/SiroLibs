            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakacita bubi mumeso aa-Jehova, watobela zibi zyaJeroboamu mwana wa-Nebati nzyaakacitya ba-Israyeli. Taakwe naakazileka pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
