              "items": [
                {
                  "text": "1 Bam 16:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo teebakaleka zibi zyaluzubo lwa-Jeroboamu nzyaakacitya ba-Israyeli, bakacili kweenda mulinzizyo, azyalo zifwanikisyo zyamituni zyakacili wo mu-Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
