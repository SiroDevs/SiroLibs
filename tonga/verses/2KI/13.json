        },
        {
          "text": "Lino makani amwi aa-Jehoazi, ancito zyakwe zyoonse, anguzu zyakwe, sa taalembedwe mubbuku lyamakani aaciindi aabami ba-Israyeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jehoazi naakafwa, wakazikwa mu-Samariya, nkabela mwanaakwe Joasi nguwakalya izina lyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
