        {
          "text": "Mulazyo wa-Jehova ngowakasisya aya makani kuba-Juda, kuti abatande kwa kumeso aakwe, nkaambo kazibi zya-Manase azyoonse nzyaakacita, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
