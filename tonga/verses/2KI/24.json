                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akaambo kabulowa bwabantu batakwe mulandu mbwaakatila, nkaambo wakazuzya Jerusalemu bulowa bwabantu batakwe mulandu, nkabela Jehova wakukaka kulekelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
