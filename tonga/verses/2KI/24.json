                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuciindi eco balanda ba-Nebukadinezara mwami wa-Babuloni bakasika ku-Jerusalemu, nkabela munzi wakasinkinizigwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
