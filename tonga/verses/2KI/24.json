              },
              "items": [
                {
                  "text": "2 Mak 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Joyakimu naakafwa, mwanaakwe Joyakini nguwakalya izina lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
