            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi kajisi myaka iili makumi obile naakaba mwami, nkabela wakeendelezya muJerusalemu myaka iili ikumi amusanu aumwi. Pele taakwe naakacita ziluleme mumeso aa-Jehova Leza wakwe mbuli mbwaakacita Davida wisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
