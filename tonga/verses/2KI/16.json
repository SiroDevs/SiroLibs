              },
              "items": [
                {
                  "text": "2 Bam 12:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Ahazi wakabweza insiliva angolida yoonse izyakajanwa muŋanda ya-Jehova amuziyobwedo zyaŋanda yamwami, watuma cipo kumwami wa-Asuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
