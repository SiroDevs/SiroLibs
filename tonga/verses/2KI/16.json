              },
              "items": [
                {
                  "text": "2 Bam 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuciindi eco nciconya mwami wa-Edomu wakaboozezya Edomu Elati, watanda ba-Juda kuzwa ku-Elati, elyo baEdomu bakaakukala ku-Elati, nkubacibede asunu.",
          "type": "text",
          "attrs": {
