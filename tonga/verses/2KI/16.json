        },
        {
          "text": "Elyo mwami naakaboola kuzwa ku-Damasko, wakabona cipaililo, nkabela mwami wakaswenenena kucipaililo, watanta alincico, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
