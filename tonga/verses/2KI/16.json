              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "watenta cipaizyo cakwe acituuzyo cakwe, watila cipaizyo cakwe cakunywa, akusansaila bulowa bwazipaizyo zyakwe zyakutontozya mpoonya acipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
