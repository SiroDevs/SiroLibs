        },
        {
          "text": "Njooyungizizya buumi bwako myaka iili ikumi amusanu, alimwi njookuvuna, webo amunzi uno, kumaanza aamwami waAsuri, Njootabilila munzi uno nkaambo kangu ndemwini akaambo kamulanda wangu Davida. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Isaya wakaamba kuti, Amulete cikoto cankuyu, bacibweze akucibika acuute, kuti apone.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.7",
            "verseOrgIds": [
              "2KI.20.7"
            ]
          }
        }
