        },
        {
          "text": "Kuciindi eco Berodaki Baladani mwana wa-Baladani mwami waBabuloni wakatumina Hezekiya magwalo acipo, nkaambo wakamvwa makani aa-Hezekiya mbwaakacisidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
