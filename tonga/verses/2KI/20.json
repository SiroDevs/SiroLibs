                  "text": "Is 38:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Isaya musinsimi wakakwiilila Jehova, nkabela wakapilusya cenzule intaamu zili ikumi nzicakaindide kale mucipimyo ca-Abazi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
