                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mupaizi wakaaba mumaanza aabasilutwe masumo azilwisyo izyakali zyamwami Davida, izyakali muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela balindizi bakaliimvwi, umwi aumwi azilwisyo zyakwe mujanza lyakwe, kuzwa kulubbazu lwalulyo lwaŋanda mane kusikila kulubbazu lwalumwensi lwaŋanda, cakuzyunguluka cipaililo aŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
