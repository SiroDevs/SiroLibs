                }
              ]
            }
          ]
        },
        {
          "text": "Lino Ataliya banyina Ahaziya, naakabona kuti mwanaakwe wafwa, wakabuka, wanyonyoona inyungu zyoonse zyamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Jeho­ seba mwana musimbi wamwami Joramu, mucizi wa-Ahaziya, wakabweza Joasi mwana wa-Ahaziya, wamulobosya akati kabana bamwami ibakati jayigwe, wamubika amuleli wakwe muŋanda yakoona, wamusisa kumeso aa-Ataliya, aboobo takwakajayigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.12"
              },
              "items": [
                {
                  "text": "2 Mak 22:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.12.8"
              },
              "items": [
                {
                  "text": "Int 12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakali awe muŋanda yaJehova, uliyubide, myaka iili musanu aumwi, Ataliya naakali kweendelezya cisi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
