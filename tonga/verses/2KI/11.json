            }
          ]
        },
        {
          "text": "Lino basilutwe bakacita mbubonya mbuli Jehoyada mupaizi mbwaakabalailila. Bakaletelela umwi aumwi bantu bankamu yakwe ibakali kunjila buzuba bwa-Sabata abakali kuzwa buzuba bwa-Sabata, beza kuli-Jehoyada mupaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
