              "items": [
                {
                  "text": "Is 8:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo mwami wa-Israyeli wakati, Maawe! Jehova waita bami aba botatwe kuti abaabe mumaanza aaba-Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
