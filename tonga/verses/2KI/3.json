                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Mesa mwami wa-Moabu kali muvubi wambelele, nkabela myaka yoonse wakali kubbadela mwami wa-Israyeli tubelele tuli zyuulu zili mwaanda aboya bwabagutu bali zyuulu zili mwaanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.1"
              },
              "items": [
                {
                  "text": "2 Bam 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Ahabu naakafwa, mwami wa-Moabu wakapapila mwami wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo mwami Joramu wakazwa mu-Samariya, wayobolola ba-Israyeli boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.6",
            "verseOrgIds": [
              "2KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.4"
              },
              "items": [
                {
                  "text": "1 Bam 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakatumina Josafati mwami wa-Juda mulazyo wakuti, Mwami wa-Moabu wandipapila. Sa inga ulatusindikila kuyoolwisya ba-Moabu? Wakavuwa kuti, Mbubo, ndainka. Tuleelene mebo ayebo, bantu bangu abantu bako, mabbiza aangu amabbiza aako. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakabuzya kuti, Ino tutole ili inzila? Wakati, Tutole inzila yankanda ya-Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.11.8"
              },
              "items": [
                {
                  "text": "Kul 11:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakainka, mwami wa-Israyeli amwami wa-Juda amwami wa-Edomu, akweenda cakuzyunguluka mazuba aali musanu aabili, mane lumwi maanzi akabamanina, basilumamba abanyama mbobakali abo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
