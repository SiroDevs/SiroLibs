                "loc": "2KI.2.25"
              },
              "items": [
                {
                  "text": "2 Bam 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Josafati wakati, Ijwi lya-Jehova lili mulinguwe. Aboobo bakainka kwakwe, mwami wa-Israyeli a-Josafati amwami wa-Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        }
