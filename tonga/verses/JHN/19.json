          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno Jesu naakatambula waini oyo uupapa wakati, Kulimanide, Nkabela wakakotamika mutwe wakwe, wakosoka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
