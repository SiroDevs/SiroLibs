                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo zintu ezi zyakacitwa kuti Magwalo azyulile aamba kuti, Cifuwa cakwe neciba comwe tacikooyootyolwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
