            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno basinkondo, nobakamubambula Jesu aciingano, bakabweza zyakusama zyakwe, bakazicita zibeela zyone kuti baabane, umwi umwi abe acibeela comwe, acalo cibaki mbubonya, eno cibaki teecakali amuluko, cakaliswaangene coonse, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
