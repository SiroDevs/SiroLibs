                "loc": "JHN.3.1+JHN.3.2"
              },
              "items": [
                {
                  "text": "Joh 3:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.2.11"
              },
              "items": [
                {
                  "text": "Mt 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awalo Nikodemo wakasika, nguwenya uwakazide kuliJesu masiku kusaanguna, wakaleta tununkilizyo utuvwelene, ututegwa mura aalo, mweelwe wamwaanda wampondo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya bakabweza mutunta wa-Jesu, bakuuzambaila zisani zituba, antoomwe amicelo iinunka kabotu, mbubonya mbuli ciyanza ncobazika ba-Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno mpoonya awo mpaakabambwidwa akali cuumbwe cipya icitanazikidwe muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno nkaambo kabuzuba bwakulibamba bwaba-Juda, bakamuzika Jesu mumonya omo, nkaambo cuumbwe cakali afwaafwi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
