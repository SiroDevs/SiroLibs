          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Int 69:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwakali kabia akazywide waini uupapa. Nkaako bakanika nsinsa muwaini oyo uupapa, biisomeka kusumo akwiitola kumulomo wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
