              "type": "tag",
              "attrs": {
                "loc": "PSA.22.18"
              },
              "items": [
                {
                  "text": "Int 22:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako bakalyaambya beni kuti, Tutacizapauli, pele atuwaale cisolo, na cilaba cani, Kwakaba obo kuti Lugwalo luzyulile lwakuti,",
          "type": "text",
