              "attrs": {
                "loc": "MRK.15.20+MRK.15.21+MRK.15.22+MRK.15.23+MRK.15.24+MRK.15.25+MRK.15.26+MRK.15.27+MRK.15.28+MRK.15.29+MRK.15.30+MRK.15.31+MRK.15.32+MRK.15.33+MRK.15.34+MRK.15.35+MRK.15.36+MRK.15.37"
              },
              "items": [
                {
                  "text": "Mk 15:20-37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.26+LUK.23.27+LUK.23.28+LUK.23.29+LUK.23.30+LUK.23.31+LUK.23.32+LUK.23.33+LUK.23.34+LUK.23.35+LUK.23.36+LUK.23.37+LUK.23.38+LUK.23.39+LUK.23.40+LUK.23.41+LUK.23.42+LUK.23.43+LUK.23.44+LUK.23.45+LUK.23.46"
              },
              "items": [
                {
                  "text": "Lk 23:26-46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya wakabapa nguwe kuti abambulwe aciingano.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
