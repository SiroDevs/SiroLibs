      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya Pilato wakajata Jesu, wakamukwabbaula. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.1",
            "verseOrgIds": [
              "JHN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo basinkondo bakaluka musini wamamvwa, bakamusamika nguwo kumutwe wakwe, alimwi bakamusamika cisani cabwami, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.2",
            "verseOrgIds": [
              "JHN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.22"
              },
              "items": [
                {
                  "text": "Joh 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakaswena kulinguwe bakati, Wabonwa, O mwami waba-Juda. Bakamuumauma amaanza aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.3",
            "verseOrgIds": [
              "JHN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi Pilato wakazwa, wabaambila kuti, Amubone, ndamuleta kulindinywe, kuti mukazibe kuti nsijene kaambo kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.4",
            "verseOrgIds": [
              "JHN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya Jesu wakazwa, ulisamide musini wamamvwa ecisani cabwami. Pilato wakabaambila kuti, Amubone, ngooyu muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.5",
            "verseOrgIds": [
              "JHN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya bapaizi bapati abasilumamba babo nobakamubona, bakoompolola bakati, Abambulwe, abambulwe aciingano. Pilato wakabaambila kuti, Amumutole nobeni mumubambule aciingano, nkaambo nsijene mulandu kulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.18"
              },
              "items": [
                {
                  "text": "Joh 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.33"
              },
              "items": [
                {
                  "text": "10:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.16"
              },
              "items": [
                {
                  "text": "Lev 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Juda bakamuvuwa kuti, Tulijisi mulao, kumulao oyu ulyeelede kufwa nkaambo walicita Mwana a-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilyonya Pilato naakamvwa ijwi elyo, wakayoowesya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.8",
            "verseOrgIds": [
              "JHN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanjila alimwi mucibetekelo, wakabuzya Jesu kuti, Ino uzwa kuli yebo? Pele Jesu takamuvuwide. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.9",
            "verseOrgIds": [
              "JHN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako Pilato wakamubuzya kuti, Sena toambi kulindime, tozi kuti ndili abwami bwakuti ukabambulwe aciingano, abwalo bwami bwakukwaangulula? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.10",
            "verseOrgIds": [
              "JHN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.18"
              },
              "items": [
                {
                  "text": "Joh 10:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.23"
              },
              "items": [
                {
                  "text": "Inc 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wakamuvuwa kuti, Nowatakapegwa bwami kuzwa kujulu, nowatalijisi nguzu kulindime, nkaambo kaako oyo uwakandyaaba kulinduwe nguujisi cibi iciinda cako. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.7"
              },
              "items": [
                {
                  "text": "Inc 17:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno kuzwa ciindi eco Pilato wali kuyanda kumwaangulula, pele ba-Juda bakoompololesya bakati, Kuti wamwaangulula muntu oyu, toli mweenzinyina Kaisara. Woonse muntu uulipa kami-kami ngusinkondonyina Kaisara. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako Pilato naakamvwa majwi aya, wakaleta Jesu anze, wakakala acuuno cabwami abusena ubutegwa Ibbuwa lyamabwe, muci-Hebrayo kutegwa Gabata, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bwali buzuba bwakulibamba, ciindi caamutwe esikati, Wakabaambila ba-Juda kuti, Amubone, ngooyu Mwami wanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.6"
              },
              "items": [
                {
                  "text": "Joh 19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele bakoompololesya kuti, Azwe, azwe, mumubambule aciingano. Pilato wakabaambila kuti, Sena nkabambule Mwami wanu? Bapaizi bapati bukavuwa kuti, Tatujisi Mwami pele Kaisara walo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.31+MAT.27.32+MAT.27.33+MAT.27.34+MAT.27.35+MAT.27.36+MAT.27.37+MAT.27.38+MAT.27.39+MAT.27.40+MAT.27.41+MAT.27.42+MAT.27.43+MAT.27.44+MAT.27.45+MAT.27.46+MAT.27.47+MAT.27.48+MAT.27.49+MAT.27.50"
              },
              "items": [
                {
                  "text": "Mt 27:31-50",
