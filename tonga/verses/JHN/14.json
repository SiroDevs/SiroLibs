              "items": [
                {
                  "text": "Mk 11:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Myoyo yanu itapengi, kamusyoma Leza, kamundisyoma amebo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muŋanda ya-Taata mwaali makalilo manji, nekwatali boobo nenda­ mwaambila nkaambo ndiya kukumubambila busena, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.26"
              },
              "items": [
                {
                  "text": "Joh 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.24"
              },
              "items": [
                {
                  "text": "17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuti na ndainka kuyoomubambila busena ndiyooboola alimwi, nzoomutolelele, kuti oko nkwembede anywebo mukabe nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi oko nkwenja mulikuzi, ayalo nzila iiya nkuko muliizi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.4",
            "verseOrgIds": [
              "JHN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomaso wakamwaambila kuti, O mwami, tatuzi nkoya, ino twiizibe buti nzila? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.20"
              },
              "items": [
                {
                  "text": "Heb 10:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mt 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.25"
              },
              "items": [
                {
                  "text": "Joh 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.1"
              },
              "items": [
                {
                  "text": "Rom 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wakamwaambila kuti, Ndime nzila, ndime bwini, ndime buumi. Takukwe uuza kuli-Taata, pele mulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti nomwali kundizi, nomumuzi awalo Taata, pele kutalika sunu mulimuzi, mulimubwene, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.7",
            "verseOrgIds": [
              "JHN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo wakamwaambila kuti, O mwami, tubonye Uso, kwalo nkotuyandisya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.8",
            "verseOrgIds": [
              "JHN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.45"
              },
              "items": [
                {
                  "text": "Joh 12:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.1.3"
              },
              "items": [
                {
                  "text": "Heb 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.17"
              },
              "items": [
                {
                  "text": "Mt 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wakamwaambila kuti, Cakomenesya buti ciindi ncotwakali ayebo, Filipo, tonandiziba asunu na? Oyo uwandibona, wamubona awalo Taata, eno uambilanzi kuti, Tubonye Uso? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.49"
              },
              "items": [
                {
                  "text": "Joh 12:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sena tosyomi kuti mebo ndili muli-Taata, awalo Taata uli mulindime? Majwi ngendamwaambila nsilyaambili ndemwini, pele Taata uukede mulindime nguucita milimo yakwe mwini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.10",
            "verseOrgIds": [
              "JHN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.20"
              },
              "items": [
                {
                  "text": "Joh 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.25"
              },
              "items": [
                {
                  "text": "Joh 10:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amundisyome kuti ndili muli-Taata, awalo Taata uli mulindime, nokutabi boobo amundisyome nkaambo kamilimo yalo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.11",
            "verseOrgIds": [
              "JHN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.19"
              },
              "items": [
                {
                  "text": "Mk 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni ndamwaambila kasimpe, Oyo uundisyoma, uyoocita milimo iili mbuli njencita, mane do akiicite mipati iinda eyi, nkaambo ndiya kuli-Taata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.12",
            "verseOrgIds": [
              "JHN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.7"
              },
              "items": [
                {
                  "text": "Joh 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mk 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.14"
              },
              "items": [
                {
                  "text": "1 Joh 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno coonse icili buti ncomuti kakumbile muzina lyangu ndiyoocicita, kuti Taata akalumbaizigwe mu-Mwanaakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.13",
            "verseOrgIds": [
              "JHN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.23"
              },
              "items": [
                {
                  "text": "Joh 16:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa ncomuyookumbila muzina lyangu, ndiyoomucitila ncico. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.14",
            "verseOrgIds": [
              "JHN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.10"
              },
              "items": [
                {
                  "text": "Joh 15:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.3"
              },
              "items": [
                {
                  "text": "1 Joh 5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanoondiyanda, kamubamba milao yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.15",
            "verseOrgIds": [
              "JHN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.26"
              },
              "items": [
                {
                  "text": "Joh 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.26"
              },
              "items": [
                {
                  "text": "15:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.7"
              },
              "items": [
                {
                  "text": "16:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.1"
              },
              "items": [
                {
                  "text": "1 Joh 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amebo ndiyookumbila Taata, uyoomupa Mugwasyi umbi kuti akale anywebo lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.16",
            "verseOrgIds": [
              "JHN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.39"
              },
              "items": [
                {
                  "text": "Joh 7:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.13"
              },
              "items": [
                {
                  "text": "16:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.20"
              },
              "items": [
                {
                  "text": "Mt 10:20",
