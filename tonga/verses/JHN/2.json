            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasika waba-Juda wakali afwaafwi, eno Jesu wakainka ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
