                "loc": "JHN.3.2"
              },
              "items": [
                {
                  "text": "Joh 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako ba-Juda bakamuvuwa bakati, Ncili citondezyo ncoti tutondezye, oocita izili bobuya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
