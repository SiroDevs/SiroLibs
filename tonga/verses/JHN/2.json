                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wali kwaamba ntempele yamubili wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
