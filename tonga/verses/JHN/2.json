            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.3"
              },
              "items": [
                {
                  "text": "Joh 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musule azeezi wakaselemuka ku-Kapemauma, walo abanyina abanabakwabo abasikwiiya bakwe, Oko tabakakalide mazuba manjimanji.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
