                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya wakaakujana muntempele muli abauzya basune embelele enziba, abalo abasintana mali balikede. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakalicitila mitatula yaloozi, wakabatandila anze lyentempele boonse, azyalo mbelele abasune, wakamwaya mali aabasikusintana, akusowaila matafule aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.49"
              },
              "items": [
                {
                  "text": "Lk 2:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakati kulibaabo abauzya nziba, Amuzigwisye ezi zintu, mutiiciti ŋanda ya-Taata kuti ibe ŋanda yamakwebo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Int 69:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basikwiiya bakwe bakayeeya eco icakalembwa cakuti, Busungu bwakuŋanda yako bwandilya kundimaninina. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        },
        {
