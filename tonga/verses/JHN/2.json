                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wakabavuwa wakati, Amumwaye ntempele ino, ndiyooiyakulula kumazuba otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.19",
