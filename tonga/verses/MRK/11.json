                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.45+LUK.19.46+LUK.19.47+LUK.19.48"
              },
              "items": [
                {
                  "text": "Lk 19:45-48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakasika mu-Jerusalemu, waakunjila muntempele. Amane buyo kulanga-langa, nikwakasia, wamuzwa, wainka ku-Betaniya antoomwe abali ikumi ababili.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buce buyo, nibakazwa ku-Betaniya, wakafwa inzala. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.12",
            "verseOrgIds": [
              "MRK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.9"
              },
              "items": [
                {
                  "text": "Lk 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6+LUK.13.7+LUK.13.8+LUK.13.9"
              },
              "items": [
                {
                  "text": "13:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino naakalanga alaale wakabona bukuyu busia matu, elyo wakasika kulimbubo, kuti antela kuli inkuyu, alye. Pele naakasika kulimbubo, wajana kuti taakwe pe, pele matu luzutu, nkaambo ciindi cankuyu kacitana kusika. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.13",
            "verseOrgIds": [
              "MRK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.20"
              },
              "items": [
                {
                  "text": "Mk 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya wakaambila obo bukuyu kuti, Kuzwa sunu kutabi uulya micelo kulinduwe lyoonse. Abalo basikwiiya bakwe bakamvwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        }
      ]
    },
