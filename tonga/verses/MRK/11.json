          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.27",
            "verseOrgIds": [
              "MRK.11.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
