          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
