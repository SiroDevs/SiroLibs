                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.27"
              },
              "items": [
                {
                  "text": "Lk 14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakaliitila makamu aabantu antoomwe abasikwiiya bakwe, wabaambila kuti, Kwanooli muntu uuyanda kundicilila, asaangune kulyuubaula, abweze ciingano cakwe, elyo anditobele. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.39"
              },
              "items": [
                {
                  "text": "Mt 10:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "Lk 17:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Joh 12:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo umwi aumwi uuyanda kuyobola buumi bwakwe uzoobusweekelwa, pele umwi aumwi uusweekelwa buumi bwakwe nkaambo kandime aka-Makani Mabotu uzoobuyobola. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo nimpindunzi njajana muntu anooli wavuba nyika yoonse nekuboobo wasweekelwa buumi bwakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanka ncinzi muntu ncati nunuzye buumi bwakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.33"
              },
              "items": [
                {
                  "text": "Mt 10:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo umwi aumwi uundyuusila bweeme, mebo amajwi aangu, akati kabasyaasunu basibumambi basizibi, alakwe Mwana a-Muntu uyoomuusya bweeme oyo muntu ciindi ncati boole mubulemu bwawisi antoomwe abaangelo basalala.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.38",
            "verseOrgIds": [
              "MRK.8.38"
            ]
          }
        }
      ]
