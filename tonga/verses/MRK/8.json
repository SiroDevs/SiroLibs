                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakasika ku-Betsaida. Mpoonya awo bakamuletela moofu bakamukombelezya kuti amwaampe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
        },
