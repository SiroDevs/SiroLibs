            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.16+JHN.19.17+JHN.19.18+JHN.19.19+JHN.19.20+JHN.19.21+JHN.19.22+JHN.19.23+JHN.19.24+JHN.19.25+JHN.19.26+JHN.19.27+JHN.19.28+JHN.19.29+JHN.19.30"
              },
              "items": [
                {
                  "text": "Joh 19:16-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamane buyo kumusabwida boobo, bakamusamununa cibaki cisalala-salala, bakamusamika zyakusama zyakwe mwini, bamunyamusya kuya kukumubambula aciingano.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        }
      ]
