            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.38+JHN.19.39+JHN.19.40+JHN.19.41+JHN.19.42"
              },
              "items": [
                {
                  "text": "Joh 19:38-42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kube buyo kumazuba, mbobwakali buzuba bwakulibambila Sabata, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwakasika Josefa waku-Aramateya, silubeta mulemu, walo mwini wakali sikulindila Bwami bwa-Leza. Oyu muntu wakalitakata kuya kuli-Pilato, waakukumbila mutunta wa-Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
