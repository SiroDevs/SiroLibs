          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amvwe buyo kulisilutwe, wakazumizya Josefa kutola mutunta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.45",
            "verseOrgIds": [
              "MRK.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino walo wakaula mulembo uutuba, wamwaangula, wamuvumba nguwo, elyo wamulazika mucuumbwe icakasidwe mumwala, mpoonya wakakunkulisya ibbwe lyakujazya amulyango wacuumbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
          }
        },
