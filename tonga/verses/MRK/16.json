                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Munsi alimwi wakapompa kulibaabo bali ikumi aumwi nibakali kulya. Elyo wakabatapatila nkaambo kakutasyoma akabuyumu bwamyoyo yabo, nkaambo teebakali kubazumina abo ibakamubona naakabuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
