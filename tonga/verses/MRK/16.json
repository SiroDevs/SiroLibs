          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.8"
              },
              "items": [
                {
                  "text": "Inc 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.18+MAT.28.19+MAT.28.20"
              },
              "items": [
                {
                  "text": "Mt 28:18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakabaambila kuti, Kamuya munyika yoonse, mukakambaukile bantu boonse Makani Mabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 16:16"
          },
          "items": [
            {
              "text": "16",
