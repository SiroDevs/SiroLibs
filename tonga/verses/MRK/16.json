                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kulibaabo basyoma ayoocitwa malele aya. Bayootanda badaimona muzina lyangu, bayooamba myaambo mipya, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
