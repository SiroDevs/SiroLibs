              "type": "tag",
              "attrs": {
                "loc": "JHN.20.11+JHN.20.12+JHN.20.13+JHN.20.14+JHN.20.15+JHN.20.16+JHN.20.17+JHN.20.18"
              },
              "items": [
                {
                  "text": "Joh 20:11-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino naakabuka cifumofumo kubuzuba butaanzi ilimana Sabata, wakataanguna kupompa kuli-Mariya mu-Magadala, nguwenya ngwaakatandila badaimona bali musanu ababili. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakaakwaambila baabo bakali a-Jesu ibakali kuungumana akulila. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele balo, bamvwe buyo kuti muumi akuti wakabonwa kulinguwe, bakakazya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.13+LUK.24.14+LUK.24.15+LUK.24.16+LUK.24.17+LUK.24.18+LUK.24.19+LUK.24.20+LUK.24.21+LUK.24.22+LUK.24.23+LUK.24.24+LUK.24.25+LUK.24.26+LUK.24.27+LUK.24.28+LUK.24.29+LUK.24.30+LUK.24.31+LUK.24.32+LUK.24.33+LUK.24.34+LUK.24.35"
              },
              "items": [
                {
                  "text": "Lk 24:13-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakadunuka aciwa cimbi kubantu bobile bankamu yabo ibakali kuya bweendeenda kuya kuminzi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo abo bakaakulwiida banamunji, pele alimwi bakakazya buyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        }
      ]
    },
