                "loc": "ACT.2.38"
              },
              "items": [
                {
                  "text": "Inc 2:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo uuti kasyome akubapatizigwa uyoofutuka, pele oyo uutazumini uyoozulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
