                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bumane buyo buzuba bwa-Sabata, ba-Mariya mu-Magadala a-Mariya banyina Jakobo a-Salome bakaula misamu yakunanika. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino baka­ fuma loko kuya kucuumbwe mubuzuba bwakutaanguna ilimana Sabata, ciindi ncilyakapasula izuba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.2",
            "verseOrgIds": [
              "MRK.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakali kuya bubuzyanya kuti, Ino nguni uti katukunkulusizye ibbwe ilili amulyango wacuumbwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.3",
            "verseOrgIds": [
              "MRK.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo balange buyo bakabona kuti ibbwe elyo lilikunkulusidwe kale. Nkaambo lyakali ipati loko. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.4",
            "verseOrgIds": [
              "MRK.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakanjila mucuumbwe bajana mukubusi uusamide zituba, ulikede kululyo, elyo bakayoowesya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.5",
            "verseOrgIds": [
              "MRK.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo wakabaambila kuti, Mutayoowi, ngu-Jesu muna-Nazareta, oyo iwakabambulwa aciingano, ngumuyandaula. Ulibukide, Tamo omuno pe, kamulanga mpaawa mpobakamubikide. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.6",
            "verseOrgIds": [
              "MRK.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.32"
              },
              "items": [
                {
                  "text": "Mt 26:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.28"
              },
              "items": [
                {
                  "text": "Mk 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kamuya, mukalwiide basikwiiya bakwe a-Petro kuti walibeelezya kuya ku-Galilaya, nkukonya nkumuyoomubonena, mbuli mbwaakamwaambilide. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazwe buyo mucuumbwe, bakacijana, nkaambo bakaliyoowede cakuzyangama. Nkabela teebakaambila muntu naba omwe, ikuti bakali kuyoowa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.8",
            "verseOrgIds": [
              "MRK.16.8"
            ]
          }
        }
      ]
    },
