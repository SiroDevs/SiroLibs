        {
          "text": "bayoojata inzoka, alimwi nibayoonywa cijaya cili buti, tacikooyoobakola pe, nkabela nibayoobika maanza aabo abalwazi, bayoopona.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.18",
