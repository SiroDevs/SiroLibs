                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mwami wabwaato wakeza nkwaakabede, wakamwaambila kuti, Uwe nuona, ucitanzi? Buka, ukombe Leza wako. Ambweni Leza ulatuyeeya kuti tutafwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
