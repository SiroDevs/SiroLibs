              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Jehova wakatuma iguwo ipati loko mulwizi, elyo kwakaba mayuwe mapati mumaanzi, nkabela bwaato bwakaba anga bulakwamuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino basibwaato bakayoowa, bakatalika kukomba umwi aumwi kumuzimu wakwe, nkabela zintu zyoonse izyakali mubwaato bakazisowela mumaanzi, kuti bwaato bulemununwe. Pele Jona kaselukide kubbazu lyabwaato kuyoolala, nkabela kali muŋonzi impati loko.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        }
      ]
    },
