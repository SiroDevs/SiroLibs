              "items": [
                {
                  "text": "Inc 1:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakaamba umwi aumwi kumweenzinyina kuti, Kamuza, tusonde, tuzibe na nguni watuletela mapenzi aali boobo. Mpawo bakasonda, nkabela inkakata yakawida Jona.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
