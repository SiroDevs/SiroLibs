            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.30"
              },
              "items": [
                {
                  "text": "Tus 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo abo bantu bakayambisya bwaato kuti babulete kunkomwe, pele kabatakonzyi pe, nkaambo maanzi akali amayuwe, aguwo kalyuunga loko kulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.8"
              },
              "items": [
                {
                  "text": "Dt 21:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo bakakomba kuli-Jebova, bakati, Twakukomba, O Jehova, utatulekeleli kuti tunyonyooke nkaambo kabuumi bwayooyu muntu, utatupi mulandu wabulowa bwamuntu uululeme, nkaambo uwe, O Jehova, wacita mbuli mboyanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakabweza Jona akumusowela mulwizi, nkabela ndilyonya lwakatontola kuunga. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
