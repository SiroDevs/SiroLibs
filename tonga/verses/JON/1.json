                "loc": "JOS.7.19"
              },
              "items": [
                {
                  "text": "Jos 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakamwaambila kuti, Twaambile, nkaambo kani nitwasikilwa malweza aali boobu? Ino ucita milimonzi? Ino uzwa kuli? Inyika yako njiili? Uli musyobonzi? ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakabaambila kuti, Ndi muHebrayo. Ndayoowa Jehova Leza wejulu iwakalenga lwizi anyika injumu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela abo bantu bakayoowa akuyoowa kupati loko, bakamwaambila kuti, Ncinzi eci ncowacita? Nkaambo bantu bakalizi kuti wacija kuzwa kubusyu bwa-Jehova, nkaambo kakuti wakabaambilide obo. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakamubuzya kuti, Lino tukucite buti kuti maanzi atuumunine? Nkaambo maanzi akali kucita mayuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.9.18"
              },
              "items": [
                {
                  "text": "Muk 9:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakabaambila kuti, Amundibweze, mundisowele mumaanzi, kuti lwizi lubatame, nkaambo ndizi kuti mulandu wangu ncimwasikilwa eli iguwo ipati.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        }
      ]
    },
