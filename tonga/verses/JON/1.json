        },
        {
          "text": "Mpawo Jona wakanyamuka, wakati, Ndobokele ku-Tarisi kuzwa kubusyu bwa-Jehova. Elyo wakaya ku-Jopa, wakajana bwaato buya ku-Tarisi, aboobo wakabbadela mali aakunjizya mulimbubo, wakanjila akwiinka ambabo ku-Tarisi kuzwa kubusyu bwa-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
