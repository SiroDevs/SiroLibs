              "attrs": {
                "loc": "EZK.33.11"
              },
              "items": [
                {
                  "text": "Ezk 33:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.39"
