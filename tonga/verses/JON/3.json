              "items": [
                {
                  "text": "Mik 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ijwi lyakasika kumwami waku-Nineve, nkabela wakanyamuka kuzwa kucuuno cabwami bwakwe, wakasamununa cikobela cakwe, wakalivumba zisani zyasaka, akukala mudyota. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
