                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bantu ba-Nineve bakazumina Leza, bakaliimya kulya, bakasama zisani zyasaka, boonse buyo kuzwa kubapati akusikila kubaniini. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        },
        {
