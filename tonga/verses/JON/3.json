                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.15"
              },
              "items": [
                {
                  "text": "Joel 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakaucita kuti uambwe akumwaisigwa koonse ku-Nineve kuti, Ngooyu mulazyo wamwami abapati bakwe. Kutabi muntu, naba munyama, niiba iŋombe, niiba imbelele, uulabila niciba cintu. Boonse batalyi, nikuba kunywa maanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
