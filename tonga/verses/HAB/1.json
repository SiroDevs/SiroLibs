              "type": "text"
            }
          ]
        },
        {
          "text": "Nceeci cilengano ncaakabona Habakuku musinsimi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.1",
            "verseOrgIds": [
              "HAB.1.1"
            ]
