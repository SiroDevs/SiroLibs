            }
          ]
        },
        {
          "text": "Mpawo Muuya wakandibweza, nkabela kusule lyangu ndakamvwa ijwi lyamuzuzumina mupati, liti, Butembaulwe bulemu bwa-Jehova kubusena bwakwe! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakamvwa ijwi lyamababa aabanyama, limwi alimwi lyakali kuguma lyeenzinyina, acikwala camavili kumbali lyabo; acikwala camuzuzumina mupati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
