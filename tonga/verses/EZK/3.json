                "loc": "2KI.3.15"
              },
              "items": [
                {
                  "text": "2 Bam 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muuya wakandisumpula, wanditola, aboobo ndakaya abuusu bulula mumoyo wangu, ajanza lya-Jehova lyakali alindime canguzu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
