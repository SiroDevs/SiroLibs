                "loc": "ISA.13.6"
              },
              "items": [
                {
                  "text": "Is 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, sinsima. Amba kuti, Mbuboobu mbwaamba Jehova. Amulile! Maawe! Bwaboneka buzuba! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        },
