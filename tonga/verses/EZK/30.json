            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.15"
              },
              "items": [
                {
                  "text": "Jer 50:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Egepita uyoosikilwa ipanga, amucisi ca-Kusi muyooba mapenzi, bantu nebayoojayigwa mucisi ca-Egepita, ambono zyaco neziyootolwa, antalisyo zyaco neziyootyolaulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.20"
              },
              "items": [
                {
                  "text": "Jer 25:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Kusi, aba-Puti, aba-Ludi, abaArabu boonse, aba-Kubi, abantu banyika njebatangene ayo cizuminano, boonse buyo bayoojazigwa ipanga antoomwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
      ]
    },
