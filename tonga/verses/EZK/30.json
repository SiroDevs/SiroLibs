                  "text": "Ezk 29:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoomwaisya ba-Egepita akati kabamasi akubapalanganya munyika zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
