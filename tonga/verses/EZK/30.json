                "loc": "EZK.29.14"
              },
              "items": [
                {
                  "text": "Ezk 29:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoocita kuti Patro ube matongo. Njootenta Zoani akubeteka No. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njootila bukali bwangu ku-Sini, munzi muyumu waku-Egepita, akunyonyoona makamu aabantu baku-No. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.15",
            "verseOrgIds": [
              "EZK.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoobika mulilo mu-Egepita, elyo Sini ulalyelolaolola cakupenga. No uyoomwayigwa, a-Nofi uyoopenzegwa abasinkondonyina buzuba boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.16",
            "verseOrgIds": [
              "EZK.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balombe ba-Aveni aba-Pibeseti bayoojazigwa ipanga, abanakazi bayootolwa mubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.17",
            "verseOrgIds": [
              "EZK.30.17"
            ]
          }
        },
