        },
        {
          "text": "Ku-Tahapanesi buzuba buyoosia. Nenjootyola zikeyi zyajokwe lya-Egepita nkuko, anguzu zyakwe nzyalikankaizizya neziyoolesegwa, uyoovumbizigwa ijoba, abana bakwe basimbi bayootolwa mubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.18",
            "verseOrgIds": [
              "EZK.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbunjoobeteka Egepita, elyo bayooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.19",
            "verseOrgIds": [
              "EZK.30.19"
            ]
          }
        }
      ]
    },
