            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Buvubi bwa-Egepita njoobumanya kujanza lya-Nebukadinezara mwami wa-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
