                "loc": "EZK.28.7"
              },
              "items": [
                {
                  "text": "Ezk 28:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uleza abantu bakwe, bantu babamasi bayoosya, nkabela bayoonjizigwa kukunyonyoona nyika. Bayoosomona mapanga aabo kukulwisya ba-Egepita, anyika yoonse bayooizuzya bajayidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.4"
              },
              "items": [
                {
                  "text": "Is 19:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njooyuminizya lwizi akwaaba nyika mumaanza aabantu babi. Nyika azintu zyoonse zili mulinjiyo njoozisaazya maanza aabazwakule. Ndime nde-Jehova ndacaamba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
