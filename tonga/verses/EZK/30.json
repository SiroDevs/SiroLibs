                "loc": "EZK.7.7"
              },
              "items": [
                {
                  "text": "Ezk 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.1"
              },
              "items": [
                {
                  "text": "Joel 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buzuba buli afwaafwi! Buzuba bwa-Jehova buli afwaafwi! Mbobuzuba bwamayoba aasia mbi, ciindi cakubetekwa kwabamasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
