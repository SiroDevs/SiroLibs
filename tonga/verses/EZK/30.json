            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Njoonyonyoona zikozyano akumanya zimpangaliko mu-Nofi. Takukooyooba limbi mwami munyika ya-Egepita. Njoobika buyoofu munyika ya-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
