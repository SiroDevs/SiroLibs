              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Boonse bagwasya ba-Egepita bayoowa, anguzu zyabo nzibalikankaizya ziyoofwinsigwa. Kuzwa ku-Migidoli kusikila ku-Sevene koonse koonse bayoolebwa ipanga, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.12"
              },
              "items": [
                {
                  "text": "Ezk 29:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyika yabo iyooba cisi citakalwi akati kazisinyina zitakalwi, aminzi yayo ilabula bantu akati kaminzinyina iitakalwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bayooziba kuti ndime Jehova nenoozootentede Egepita, abagwasyi bayo nebanoozootyokede. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        },
