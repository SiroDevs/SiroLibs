              "items": [
                {
                  "text": "Is 29:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakandaambila kuti, Milandu yaluzubo lwa-Israyeli alwa-Juda yakomena loko malaa. Nyika ilizwide bulowa, amunzi ulizwide lupilingano, nkaambo balaamba kuti, Jehova walekelezya nyika, Jehova taboni pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
