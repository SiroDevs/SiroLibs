          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.41"
              },
              "items": [
                {
                  "text": "Dt 32:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako ambebo nsikooyoobafwida luse, ameso aangu taakooyoobafwida luzyalo pe, njoobweedezya inzila zyabo amitwe yabo beni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        }
