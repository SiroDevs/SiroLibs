              },
              "items": [
                {
                  "text": "14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova wakamwaambila kuti, Inda akati kamunzi, akati ka-Jerusalemu, ukalembe citondezyo ankumu zyabantu boonse balila akutongela nkaambo kazisesemyo zyoonse zicitwa mukati kawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwi wakabaambila mumatwi aangu, wati, Amumutobele, mukainde mukati kamunzi, mukaume bantu. Meso aanu atabafwidi luse. Mutabafwidi luzyalo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.5",
            "verseOrgIds": [
              "EZK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.4"
              },
              "items": [
                {
                  "text": "Ciy 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.29"
              },
              "items": [
                {
                  "text": "Jer 25:29",
