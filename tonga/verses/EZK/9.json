            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakoongolola mumatwi aangu ajwi ipati, wati, Amuswene afwaafwi inywe nubasikuuma munzi, muze umwi aumwi acinyonyoozyo cakwe mujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.1",
            "verseOrgIds": [
              "EZK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.4"
              },
              "items": [
                {
                  "text": "Lev 16:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo kwakasika bantu bali musanu aumwi bazwa kulubazu lwamulyango wakujulu uulangide kunyika, Bakeza umwi aumwi acilwisyo cakwe cakujazya mujanza lyakwe, alimwi akati kabo kali muntu umwi iwakasamide masani aatuba iwakajisi zyakulembya mucikungu cakwe, Nkabela bakanjila, baakwiima kumbali lyacipaililo camukuba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.2",
            "verseOrgIds": [
              "EZK.9.2"
            ]
          }
        }
      ]
    },
    {
