              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbonjoolemezegwa akusalazigwa akuzibwa mumeso aabamasi, nkabela bayooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.23",
