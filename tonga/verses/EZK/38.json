        {
          "text": "Njoomuletela ziyoosyo zyamisyobo misyobo, mbwaamba Mwami Jehova, nkabela ipanga lyamuntu umwi aumwi liyoolwisya mweenzinyina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.21",
