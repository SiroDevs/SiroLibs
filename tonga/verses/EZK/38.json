              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Mubuzuba obo makani ayoobuka mumoyo wako, nkabela uyooyeeya miyeeyo mibi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.10",
