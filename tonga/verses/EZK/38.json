              "items": [
                {
                  "text": "Matl 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.14"
              },
              "items": [
                {
                  "text": "Ezk 27:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Gomeri amakamu aabo oonse, luzubo lwa-Togarima luzwa kumagolelo aakunyika amakamu aabo oonse, bantu banji bali ayebo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        }
