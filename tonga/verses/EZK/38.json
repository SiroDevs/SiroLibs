              "items": [
                {
                  "text": "Ciy 20:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, langa Gogo wakunyika ya-Magogo, silutwe mupati wa-Meseki a-Tubali, Komulanga cankayikayi akusinsima aanguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.2",
            "verseOrgIds": [
              "EZK.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amba kuti, Mbuboobu mbwaamba Mwami Jehova. Bona! Ndi sinkondonyoko, O Gogo, silutwe mupati wa-Meseki a-Tubali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.3",
            "verseOrgIds": [
              "EZK.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.4"
              },
              "items": [
                {
                  "text": "Ezk 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.12"
              },
              "items": [
                {
                  "text": "23:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njookupilusya, njoobika tulobyo mumalakwila aako akukugwisya, webo ampi yako yoonse, imbizi abasimabbiza, boonse balisamide zilwisyo zyoonse, makamu mapati aali azikwabilizyo antobo, boonse bajisi mapanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.4",
            "verseOrgIds": [
              "EZK.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo ba-Persia aba-Kusi aba-Puti bali abo, boonse bali antobo angowani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.5",
            "verseOrgIds": [
              "EZK.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 38:6"
          },
          "items": [
