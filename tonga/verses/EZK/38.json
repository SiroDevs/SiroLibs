                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Seba a-Dedani abasambazi baku-Tarisi, atunzuunzi toonse, boonse bayookubuzya kuti, Sa weza kusaala imbono? Sa wayobolola makamu makamu aako kukunyanzya buvubi, kukutola insilva angolida, kukutola iŋombe ambono, akukusaala zintu zinji?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.13",
            "verseOrgIds": [
              "EZK.38.13"
            ]
          }
        }
