                  "text": "Bab 18:7-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akwaamba kuti, Njiinke kunyika yaminzi iitajisi mabaya, nkalwisye bantu batontwede bakede caluumuno, batakwe malambo naaba mankolo neziba zitendele; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.11",
            "verseOrgIds": [
