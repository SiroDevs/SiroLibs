              },
              "items": [
                {
                  "text": "Ezk 39:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akuboola kuzwa kucisi cako cakumagolelo aakunyika, yebo abantu banji mboli abo, boonse balitantide ambizi, makamu makamu aabantu, impi impati loko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.15",
            "verseOrgIds": [
              "EZK.38.15"
            ]
          }
        },
        {
