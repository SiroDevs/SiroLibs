              "items": [
                {
                  "text": "Jer 23:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amane mazuba manji, muyooyobololwa, Kumamanino aamyaka uyoosika kukulwisya nyika iyakabukulusigwa munkondo, bantu nkobakabungene kuzwa kuzisi zinji atala azilundu zyaIsrayeli izyakali matongo lyoonse, Bantu bayo bakayobololwa kuzwa kulibamasi, lino sunu balikede caluumuno boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.8",
            "verseOrgIds": [
              "EZK.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
