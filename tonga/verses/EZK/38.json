                  "text": "Kul 14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoosika kukulwisya bantu bangu ba-Israyeli mbuli ijoba livumba nyika. Kumamanino aaciindi njookuleta kukulwisya nyika yangu, kuti bamasi bandizibe nenzoolemekwa mumeso aabo mumakani aako, O Gogo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.16",
            "verseOrgIds": [
              "EZK.38.16"
            ]
          }
        }
