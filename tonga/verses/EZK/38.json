              "attrs": {
                "loc": "JER.4.13"
              },
              "items": [
                {
                  "text": "Jer 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoosika mbuli iguwo, uyooza mbuli ijoba livumba nyika, yebo amakamu aako oonse abantu banji mboli abo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
