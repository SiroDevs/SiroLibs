              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mubuzuba obo, Gogo naazoosika kukulwisya nyika ya-Israyeli, mbwaamba Mwami Jehova, bukali bwangu buyoobuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.18",
