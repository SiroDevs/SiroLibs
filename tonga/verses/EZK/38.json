          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkasaale imbono akunyanzya buvubi; nkalwisye matongo aayakulwidwe, bantu nkobayobolwedwe kuzwa kulibamasi, nkobajene iŋombe ambono, bakede muntinti yanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.12",
            "verseOrgIds": [
              "EZK.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
