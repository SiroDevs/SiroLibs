                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.1",
            "verseOrgIds": [
              "EZK.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.11"
              },
              "items": [
                {
                  "text": "Am 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "OBA.1.10"
              },
              "items": [
                {
                  "text": "Ob 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, langa cilundu ca-Seiri cankayikayi, ukasinsime aancico. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.2",
            "verseOrgIds": [
              "EZK.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kocaambila kuti, Mbuboobu mbwaamba Mwami Jehova. Ncobeni ndi sinkondonyoko, O cilundu ca-Seiri, Njootandabika ijanza lyangu alinduwe akukulobya kuti ube matongo buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoosaala minzi yako mane yaba matongo, lino uyooziba kuti ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.7"
              },
              "items": [
                {
                  "text": "Int 137:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tokwe nowakaleka bukali bwako abuniini, pe, wakaaba bana ba-Israyeli munguzu zyapanga kuciindi camafwabi aabo, nkukuti kuciindi nibakapegwa mulandu wakumaninizya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.5",
            "verseOrgIds": [
              "EZK.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.17"
              },
              "items": [
                {
                  "text": "Int 109:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako, mbuli mbundi muumi, mbwaamba Mwami Jehova, ncobeni njookubambila bulowa, abulowa buyookutobela, Ulijisi mulandu wabulowa, aboobo bulowa buyookutobela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.6",
            "verseOrgIds": [
              "EZK.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoosaala cilundu ca-Seiri cibe matongo buyo. Njoomaninizya kulincico boonse beendeenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.7",
            "verseOrgIds": [
              "EZK.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoozuzya zilundu zyakwe bantu bajayidwe. Atala amalundu aako amumakuti aako amumagombela aako, koonse buyo kuyoowa bajayidwe apanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.8",
            "verseOrgIds": [
              "EZK.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.49.17"
              },
              "items": [
                {
                  "text": "Jer 49:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.3"
              },
              "items": [
                {
                  "text": "Mal 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoocita kuti ube ibbubu litamani, aminzi yako tiikooyookalwa limbi. Lino muyooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        }
      ]
    },
