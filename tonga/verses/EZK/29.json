                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bantu boonse baku-Egepita bayooziba kuti ndime Jehova, nkaambo mwabeda luzubo lwa-Israyeli cilifunkizyo camatete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.5"
              },
              "items": [
                {
                  "text": "Jer 37:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakujata buyo amaanza, watyoka, wakompoka akusikila mukuko lyabo. Balifunkizya buyo, wafuyuka, wabateketya mucikungu coonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.7",
            "verseOrgIds": [
              "EZK.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Ncobeni njookuletela ipanga, nkabela liyookunyonyweeda bantu abanyama boonse buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.18"
              },
              "items": [
                {
                  "text": "Tus 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyika ya-Egepita iyooba ciyoosyo amatongo. Lino bayooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        }
