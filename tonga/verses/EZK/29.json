                  "text": "Ezk 30:10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takukooyooinda zituta zyabantu mulinjiyo, azyalo zituta zyabanyama tazikooyooinda mulinjiyo. Tiikooyookalwa pe, myaka iili makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
