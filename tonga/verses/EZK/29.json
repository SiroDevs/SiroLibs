                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.33"
              },
              "items": [
                {
                  "text": "7:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njookusowa kunkanda, webo answi zyoonse zyamilonga yako. Uyoowa musokwe antangalala. Tokooyoobwezwa nikuba kuzikwa. Njookwaaba mumeno aabanyama baansi abayuni bakujulu, ube zilyo zyabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
