              "items": [
                {
                  "text": "Jer 25:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndamupa nyika ya-Egepita, ibe bulumbu bwakwe mbwaakabelekela, nkaambo bakandibelekela milimo, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
