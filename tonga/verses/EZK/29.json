            }
          ]
        },
        {
          "text": "Nkaambo kako ndaba sinkondonyoko, webo atulonga twako. Njoocita kuti nyika ya-Egepita ibe matongo aciyoosyo koonse koonse kuzwa kuŋanda indamfu yaku-Sevene kusikila kumugaano wa-Kusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
              "EZK.29.10"
            ]
          }
        },
