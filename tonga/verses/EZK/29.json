                "loc": "EZK.38.4"
              },
              "items": [
                {
                  "text": "Ezk 38:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobika tulobyo mumalakwila aako, answi zyamumilonga yako njoozikakatizya kumaamba aako. Lino njookununa kuzwa kumilonga yako answi zyoonse zyamilonga yako zikakatide kumaamba aako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 29:5"
