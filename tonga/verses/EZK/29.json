                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Mwami Jehova. Imane buyo myaka iili makumi one, njooyobolola ba-Egepita kuzwa kulibamasi nkubamwaikilide. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoolobya buzike bwaba-Egepita akubapilusya kunyika ya-Patro, nyika yalukombokombo lwabo, nkabela bayooba musyobo muniini buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cisi cabo ciyooba ciniini buyo kwiinda zisi zimwi, tacikooyoolisumpula limbi kulibamasi pe. Njoocita kuti babe musyobo muniini buyo, aboobo tabakooyooendelezya limbi zisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
