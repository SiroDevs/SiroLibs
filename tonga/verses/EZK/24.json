                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.16"
              },
              "items": [
                {
                  "text": "Dt 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bulowa mbuwakatila bwaboneka mukati kawo, Wakabubika agale buyo antangalala, taakwe naakabutila ansi nikuba kubuvwikila abulongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.16.17"
