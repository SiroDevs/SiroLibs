              "items": [
                {
                  "text": "Nah 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Mwami Jehova. Maawe kumunzi wabulowa, cilongo cicijisi sinkalwe, citana kusanzigwa sinkalwe waco! Gwisya zituli cimwi cimwi. Utasalauli pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.13"
              },
              "items": [
                {
                  "text": "Lev 17:13",
