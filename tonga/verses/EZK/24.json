              "items": [
                {
                  "text": "8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sinkalwe waco nkukuti zisapi zyako zisofweede, Mbuli mbundakali kuyanda kukusalazya pele wakakaka kusalazigwa busofwi bwako, tokooyoosalazigwa limbi mane nkakutye bukali bwangu kulinduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
