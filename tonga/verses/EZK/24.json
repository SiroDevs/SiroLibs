                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ambila luzubo lukataazya cikozyano, Kobaambila kuti, Mbuboobu mbwaamba Mwami Jehova, Simpika cilongo! Simpika! Bika maanzi mulincico! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi bika zituli mumo, zituli zibo tu zyoonse, zituli zyazibelo azyamabekete, akucizuzya zifuwa zibotu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala imbelele imbotu. Sika inkuni zinji kunsi lyaco. Abile maanzi aakujisya zituli zyaco. Jika zifuwa mukati kaco.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
