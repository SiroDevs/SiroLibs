              "items": [
                {
                  "text": "Jer 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.2"
              },
              "items": [
                {
                  "text": "Mt 7:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kubusya bukali bwangu kuti nkaliye inkoto yabubi, nciceeco ncindabikila bulowa bwawo agale buyo antangalala, kuti butasisigwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.1"
              },
              "items": [
                {
                  "text": "Nah 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.12"
              },
              "items": [
                {
                  "text": "Hab 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova, Maawe kumunzi wabulowa! Ambebo njoovuzya inkuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sika inkuni zinji, mulilo uvule, Jikisya nyama, musinza uleme, azifuwa zyoonse zibe bulekete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
