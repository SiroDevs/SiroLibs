        },
        {
          "text": "Lino ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
