                "loc": "EZK.22.15"
              },
              "items": [
                {
                  "text": "Ezk 22:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wamana obo, simpika cilongo buyo amakala, kuti cipye, mukuba waco upye, kuti bubi bwaco bweenzunuke mukati kaco asinkalwe waco amanisigwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma! Ndalikataazya buyo! Sinkalwe waco munji, tazwi mumulilo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
