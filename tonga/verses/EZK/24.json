            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mwana amuntu, swiilila, Ndakongomokela kukunyanzya muyandwi wameso aako, nekubaboobo toelede kulila nikuba koomoka nikuba kumbulumusya misozi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
