              "items": [
                {
                  "text": "Ezk 26:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu boonse bakede munyika zyakunkomwe yalwizi baligambide aanduwe, abalo bami babo bayoowa loko, amasyu aabo ausana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.35",
            "verseOrgIds": [
              "EZK.27.35"
            ]
          }
        },
