          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limvwigwe buyo ijwi lyakulila kwabasikusika bako, tunzuunzi tweengelede tulazungaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
