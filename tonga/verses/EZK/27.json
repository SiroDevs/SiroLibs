            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.5"
              },
              "items": [
                {
                  "text": "Ezk 30:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Persia aba-Ludi aba-Puti bakali mumpi yako, bakali basilumamba bako. Mulinduwe mobakali kwaanzika intobo angowani. Bakali kukubotya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba-Arivadi aba-Heleki bakaliimvwi amalambo aako buzyungulukide, abalo ba-Gamadi bakali amaanda aako malamfu. Bakali kwaanzika intobo zyabo amalambo aako buzyungulukide, Bakakubotya loko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
