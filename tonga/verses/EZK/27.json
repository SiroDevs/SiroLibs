                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buvubi bwako, makwebo aako, zyakusambala zyako, basibwaato bako, basikusika bako, basikumamika bako, bantu mbosambazyanya abo, basilumamba bako boonse bali mukati kako, ankamu yoonse iili mukati kako, boonse buyo bayooinkila mubbonze lyalwizi mubuzuba bwabuwe bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
