              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaligela cinkulu cakukulila akusama zisani zyamasaka. Balakulila cabuusu bwamumoyo akweema kupati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        },
        {
          "name": "verse",
