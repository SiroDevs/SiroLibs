                }
              ]
            }
          ]
        },
        {
          "text": "Basikukwasula bako bakusisya ampwampwa, lino muuwo wakujwe wakupwaya akati kamaanzi aalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
