              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
