          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakwiimbila cilizyo cakwamba kuti, Maawe! Nguni uuli mbuli Turo uunyonyooka mukati kalwizi? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makwebo aako naakali kuzwa mulwizi, wakali kulamya bantu banji, Imbono zyako zinji azyakusambala zyako zinji zyakali kuvubya bami banyika, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.33",
            "verseOrgIds": [
              "EZK.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ciindi ecino wanyonyooka mukati kalwizi, mukati kabbonze, Makwebo aako ankamu yabantu bako, zyoonse buyo zyainkila mumaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.34",
            "verseOrgIds": [
              "EZK.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
