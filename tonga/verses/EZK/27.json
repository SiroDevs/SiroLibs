            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.36"
              },
              "items": [
                {
                  "text": "2 Mak 20:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba-Tarisi bakali kusambazyanya ayebo nkaambo kabuvubi bwako bunji bwamisyobo misyobo: insiliva abutale amundalila amukuba, zyoonse buyo bakali kuzisambazya imbono zyako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.5"
              },
              "items": [
                {
                  "text": "1 Mak 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.6"
              },
              "items": [
                {
                  "text": "Joel 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Javani aba-Tubali aba-Meseki bakali kusambazyanya ayebo. Imbono zyako bakali kuzyuuzya bantu azibelesyo zyamukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.3"
              },
              "items": [
                {
                  "text": "Matl 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.6"
              },
              "items": [
                {
                  "text": "1 Mak 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu baluzubo lwa-Togarima bakali kuuzya imbono zyako imbizi amabbiza aankondo ambongolo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.7"
              },
              "items": [
                {
                  "text": "Matl 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.9"
              },
              "items": [
                {
                  "text": "1 Mak 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana ba-Dedani abalo bakali kusambazyanya ayebo. Nyika zyankomwe zinji zyakali mumaanza aako, zyakali kusambazyanya ameja aanzovu azisamu zyamucenje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba-Aramu bakali kusambazyanya ayebo nkaambo kambono zyako zinji. Bakali kuuzya mabwe aayandika aanofeki, amasani aasalala salala, amasani amanyengwe-manyengwe, amasani aatuba, amabwe aabekema amabwe aasalala pyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.9"
              },
              "items": [
                {
                  "text": "1 Bam 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.20"
              },
              "items": [
                {
                  "text": "Inc 12:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Juda anyika ya-Israyeli bakali kusambazyanya ayebo. Bakali kuuzya imbono zyako bulotwe bwaku-Miniti azinkwa abuci amafuta amabbona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu baku-Damasko bakali kusambazyanya ayebo nkaambo kabunji bwambono zyako zyamisyobo misyobo. Imbono zyako bakali kuzyuuzya waini waku-Heliboni, aboya butuba bwambelele, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "awaini waku-Uzali. Abutale bufulidwe atununkilizyo amisale, zyoonse zyakauzigwa makwebo aako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
