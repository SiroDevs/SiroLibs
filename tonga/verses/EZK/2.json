                }
              ]
            }
          ]
        },
        {
          "text": "Ambweni bayooswiilila, ambweni bayookaka (nkaambo mbana baluzubo lukataazya), nekubaboobo bayooziba kuti kwaba musinsimi akati kabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
