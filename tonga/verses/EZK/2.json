              "items": [
                {
                  "text": "Jer 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakandaambila kuti, O mwana a-muntu, ndakutuma kubana ba-Israyeli, kuluzubo lwabasicinguni bandipapila. Bandibisizya, balo abamawisaabo boonse, mane kusikila kubuzuba obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.3",
            "verseOrgIds": [
              "EZK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
