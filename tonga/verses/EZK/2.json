                "loc": "EZK.3.7"
              },
              "items": [
                {
                  "text": "Ezk 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana mbasicinguni, mbayumu mumyoyo. Lino ndakutuma kulimbabo, nkabela uleelede kubaambila kuti, Mbuboobu mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
