        },
        {
          "text": "Mpoonya awo, naakandaambila, muuya wakanjila mulindime, wandiimikizya, lino ndakamvwa mbwaakali kwaambaula ambebo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
