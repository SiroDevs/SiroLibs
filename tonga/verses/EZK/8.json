            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, O mwana amuntu, sa wabona bapati baluzubo lwa-Israyeli mbubacita mumudima, umwi aumwi muŋanda yakwe yazifwanikisyo? Balaamba kuti, Jehova tatuboni pe, Jehova walekelezya nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakandaambila kuti, Ulabona zintu azimwi zigambya nzibacita, zintu zisesemya akwiinda ezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        }
      ]
