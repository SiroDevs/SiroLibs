                "loc": "EZK.1.27"
              },
              "items": [
                {
                  "text": "Ezk 1:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakalanga, ndabona cili mbuli muntu. Kuzwa mbuli kucikungu cakwe kuya ansi koli mulilo, alimwi kuzwa kucikungu cakwe kuya kujulu kabekabeka mbuli mundalila wamunsaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
        {
