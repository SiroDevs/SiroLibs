              "items": [
                {
                  "text": "My 16:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kunembo lyazyo kwakaimvwi bantu bali makumi aali musanu aabili, bapati baluzubo lwa-Israyeli, alakwe Jazaniya mwana wa-Safani kaimvwi akati kabo. Umwi aumwi kajisi katentelo mujanza lyakwe, nkabela kwakali kulundumuka busi bwatununkilizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.11",
            "verseOrgIds": [
              "EZK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
