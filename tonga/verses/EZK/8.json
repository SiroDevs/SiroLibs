            "number": "5",
            "style": "v",
            "sid": "EZK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, O mwana amuntu, tambya meso aako kulubazu lwakunyika. Nkabela nindakatambya meso aangu kulubazu lwakunyika, ndakabona kuti oko kulubazu lwakunyika lwamulyango wacipaililo nkucakabede eco cikozyano cabbivwe kumanjililo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.5",
            "verseOrgIds": [
              "EZK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.16"
              },
              "items": [
                {
                  "text": "Dt 31:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.14"
              },
              "items": [
                {
                  "text": "2 Mak 36:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, o mwana amuntu, sa wabona mbubacita? Sa wabona milimo iigambya iisesemya luzubo lwa-Israyeli njilucita okuno, kuti banditandile kule kuzwa kucikombelo cangu? Pele ulabona zintu zisesemya akwiinda ezi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
