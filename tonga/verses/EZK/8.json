              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakandisisya kumanjililo aamulyango waŋanda ya-Jehova uulangide kunyika, nkabela oko kwakabonwa banakazi balikede balalila Tamuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakandaambila kuti, Sa wabona, O mwana amuntu? Ulabona zisesemyo azimwi zibi akwiinda ezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
