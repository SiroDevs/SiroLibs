              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wandisisya kumulyango walubanza, nkabela nindakalanga ndakabona cipulo mubulambo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.7",
            "verseOrgIds": [
              "EZK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, O mwana amuntu, kwankwamuna omo mubulambo. Elyo ndakakwankwamuna mubulambo nkabela kwakaboneka mulyango. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.8",
            "verseOrgIds": [
              "EZK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakandaambila kuti, Njila, ukabone milimo mibi iisesemya njibacita okuno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.9",
            "verseOrgIds": [
              "EZK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ndakanjila, ndabona misyobo yoonse yabauka ayabanyama bayavula, azikozyano zyamizimu zyoonse zyaluzubo lwa-Israyeli, zilibezedwe abulambo koonse koonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.10",
            "verseOrgIds": [
              "EZK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
