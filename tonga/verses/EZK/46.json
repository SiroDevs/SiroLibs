        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.3"
              },
              "items": [
                {
                  "text": "Ezk 44:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.10"
              },
              "items": [
                {
                  "text": "Mt 25:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino silutwe wacisi uyoonjila mulukonkono lwamulyango kuzwa anze, uyooima kumbali amunsende wamulyango, nkabela bapaizi bayoobamba zituuzyo azipaizyo zyakutontozya, elyo uyookomba kumbali lyacikunguzyo camulyango. Amane kukomba, unooya anze, pele mulyango tuukooyoojalwa mane kusikila igoko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
