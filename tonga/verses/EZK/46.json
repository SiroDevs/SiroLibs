        {
          "text": "Acalo cipaizyo cabusu, uleelede kucibamba cifumo acifumo, cipanzi camusanu acimwi cacisuwo, acipanzi catatu cakanongo kamafuta kukukandya busu, Mbucibede cipaizyo cabusu ca-Jehova. Ngooyo mulao waco walyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
