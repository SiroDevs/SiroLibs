          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzyooko zyoonse zyone zyalubuwa kamuli tubuwa; kamwi akamwi kakajisi bulamfu bwatukokola tuli makumi one abwaamba bwatukokola tuli makumi otatwe; toonse tone twakaleelene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
