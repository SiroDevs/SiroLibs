              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbubeelede kubamba kabelele acipaizyo cabusu amafuta cifumo acifumo, kube cipaizyo calyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
