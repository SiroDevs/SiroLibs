              "items": [
                {
                  "text": "Lk 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bantu banyika bayookomba kumanjililo aamulyango oyo kubusyu bwa-Jehova mubuzuba bwa-Sabata amubuzuba bwamwezi mupya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
