              "items": [
                {
                  "text": "My 28:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.24"
              },
              "items": [
                {
                  "text": "Ezk 45:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acipaizyo cabusu cileelede kuba cisuwo comwe kumugutu umwi aumwi, acipaizyo cabusu catubelele cileelede kuba kufumbwa ncakonzya kupa, acipanzi camusanu acimwi canongo yamafuta kucisuwo cimwi acimwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mubuzuba bwamwezi mupya uleelede kutuula kapoho katajisi kampenda, atubelele tuli musanu akamwi amugutu, zyoonse zitajisi kampenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela uleelede kubamba cipaizyo cabusu, cisuwo comwe kukapoho, acisuwo comwe kumugutu, akutubelele kufumbwa ncakonzya kupa, acipanzi camusanu acimwi canongo yamafuta kucisuwo cimwi acimwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasika silutwe wacisi, uleelede kunjila kunzila yakulukonkono lwamulyango akuzwa munzila eyo njiyonya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
