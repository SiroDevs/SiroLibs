          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banjila, silutwe wacisi alakwe uleelede kunjila akati kabo; bazwa, uleelede kuzwa alakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
