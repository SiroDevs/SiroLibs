        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Mulyango walubuwa lwamukati uulangide kujwe unoojalwa mazuba aali musanu abumwi aakubeleka, pele unoojalulwa mubuzuba bwa-Sabata amubuzuba bwamwezi mupya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
