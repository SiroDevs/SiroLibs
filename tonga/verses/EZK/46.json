              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi mukati kato toonse tone kamuli mindando yamabwe, akusule lyamindando kakuli zijikilo koonse koonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
