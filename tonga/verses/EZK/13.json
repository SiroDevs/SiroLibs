          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.11"
              },
              "items": [
                {
                  "text": "Jer 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkukuti basinsimi ba-Israyeli ibakali kusinsima aa-Jerusalemu akuubonena cilengano caluumuno, anukuti luumuno kalutawo, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        }
      ]
