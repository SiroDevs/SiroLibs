        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova, Mwaamba zyabuyo, mwabona zilengano zyakubeja, aboobo ncobeni ndaba sinkondonyoko, mbwaamba Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
