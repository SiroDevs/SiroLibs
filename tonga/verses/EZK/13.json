          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayalo mifuko yanu yoonse njooidelaula, aboobo njoovuna bantu bangu kuzwa kumaanza aanu, Tabakooyooba zyakutezya mumaanza aanu pe, Lino muyooziba kuti ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
              "EZK.13.21"
            ]
          }
        },
