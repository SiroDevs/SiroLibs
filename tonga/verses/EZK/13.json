            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.9.16"
              },
              "items": [
                {
                  "text": "Int 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ijanza lyangu liyoolwanya basinsimi babona zilengano zyabuyo, basonda zyakubeja, Tabakooyooba mumbungano yabantu bangu, tabakooyoolembwa mubbuku lyaluzubo lwa-Israyeli, alimwi tabakooyoosika kunyika ya-Israyeli, aboobo muyooziba kuti ndime Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.9",
            "verseOrgIds": [
              "EZK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.3.13"
