              "type": "tag",
              "attrs": {
                "loc": "EZK.22.30"
              },
              "items": [
                {
                  "text": "Ezk 22:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tamuna kumamika munzi mpuumwayidwe, tamuna kuyakila luzubo lwa-Israyeli bulambo kuti lwiime nji munkondo mubuzuba bwa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.5",
            "verseOrgIds": [
              "EZK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.24"
              },
              "items": [
                {
                  "text": "Ezk 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.15"
              },
              "items": [
                {
                  "text": "Tus 14:15",
                  "type": "text"
                }
              ]
