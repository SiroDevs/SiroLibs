              "attrs": {
                "loc": "JER.14.14"
              },
              "items": [
                {
                  "text": "Jer 14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mwana amuntu, sinsima akutapatila abo basinsimi ba-Israyeli basinsima, Ambila basinsimi basinsima miyeeyo yamyoyo yabo beni kuti, Amuswiilile ijwi lya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Mwami Jehova. Maawe kubasinsimi bafubafuba batobela miyeeyo yamyoyo yabo beni anukuti taakwe ncibabwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.3",
            "verseOrgIds": [
              "EZK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.5"
              },
              "items": [
                {
                  "text": "Mik 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
