          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Ndisulide impindo zyanu nzimutezya bantu kuti bacije, njoozidelaula kuzwa kumaboko aanu, aboobo njoobaangununa bantu abo mbemuyanda kutezya kuti bacije. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
