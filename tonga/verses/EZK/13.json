        {
          "text": "Lino uwe, O mwana amuntu, kobalanga inkayikayi bana basimbi babantu bako basinsima miyeeyo yamyoyo yabo beni. Sinsima akubatapatila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
