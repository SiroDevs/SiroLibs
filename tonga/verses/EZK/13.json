            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.13"
              },
              "items": [
                {
                  "text": "2 Kor 11:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basinsimi bako baba mbuli bamwaaba akati kamatongo, O Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.4",
            "verseOrgIds": [
              "EZK.13.4"
            ]
          }
        },
        {
