                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni uli musongo kwiinda Daniele. Taakwe cintu cisisidwe kulinduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.3",
            "verseOrgIds": [
              "EZK.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busongo bwako amaanu aako, nzenzizyo zyakuletela buvubi, aboobo walivuzizya ingolida ansiliva muziyobwedo zyako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.12+DEU.8.13+DEU.8.14"
              },
              "items": [
                {
                  "text": "Dt 8:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maanu aako aakusambazya, ngengao aakuyungizizya buvubi, aboobo moyo wako walisumpula nkaambo kabuvubi bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
