                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakali mu-Edeni, muunda waLeza. Kosakatide mabwe mayandisi oonse, mabwe aasalala pyu, mabwe aatopazi, mabwe aajaspi, mabwe aa-berulo, mabwe aaonukisi, mabwe aakrusalito, mabwe aasafiro, mabwe aanofeki amabwe aasmaragido; alimwi tuntimbwa twako anyeele zyako, zyoonse zyakaleengedwe angolida. Mubuzuba bwakulengwa kwako zyakabambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.13",
            "verseOrgIds": [
              "EZK.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 28:14"
          },
          "items": [
