                "loc": "EZK.20.40"
              },
              "items": [
                {
                  "text": "Ezk 20:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakakubika antoomwe aangelo kerubu uunanikidwe uuvumba. Wakali mucilundu cisalala ca-Leza, wakali kweendeenda akati kamabwe aamulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.14",
            "verseOrgIds": [
              "EZK.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalilondokede munzila zyako kuzwa kubuzuba bwakulengwa kwako mane kusikila kuciindi eco zibi nezyakajanwa mulinduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.15",
            "verseOrgIds": [
              "EZK.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukusambala kwako kunji wakazuzigwa lunya, nkabela wakabisya, Nkaambo kaako ndakakutanda kuzwa kucilundu ca-Leza, alakwe kerubu sikuvumba wakakunyonyoona kuzwa kumabwe aamulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.16",
            "verseOrgIds": [
              "EZK.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
