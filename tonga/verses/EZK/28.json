                  "text": "Jud 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wako wakalisumpula nkaambo kakweebeka kwako, Wajaya busongo bwako nkaambo kakweebeka kwako. Ndakakuwaala ansi kumeso aabami kuti bakweebele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.17",
            "verseOrgIds": [
