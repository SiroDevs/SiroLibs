        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova. Mumoyo wako wayeeya kuba mbubonya mbuli Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
