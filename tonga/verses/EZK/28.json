                "loc": "EZK.30.11"
              },
              "items": [
                {
                  "text": "Ezk 30:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako ncobeni ndakuletela bazwakule, bantu bayoosya akati kabamasi. Bayoosomona mapanga aabo kuti balwisye busongo bwako bubotu, basofwaazye bweebesi bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayookuselemwida mudindi, nkabela uyoofwa mbubonya mbuli bayasidwe mbubafwa mubbonze lyalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma! Sa unoocaamba kuti, Ndime Leza? Sa unoocaamba obo kumeso aabasikujaya? Mumaanza aabaabo bakuyasa uli muntu buyo, toli Leza pe! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.18"
              },
              "items": [
                {
                  "text": "Ezk 31:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoofwa lufu lwabatapalwidwe mumaanza aabazwakule, nkaambo ndime ndaamba obo, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
