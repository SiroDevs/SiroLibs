              "items": [
                {
                  "text": "Heb 3:12-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti njate kumyoyo yabantu baluzubo lwa-Israyeli, mbetwaandeene abo boonse nkaambo kazikozyano zyabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.5",
            "verseOrgIds": [
              "EZK.14.5"
            ]
