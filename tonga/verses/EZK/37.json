          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo ndakasinsima mbubonya mbondakalaililwa, nkabela nendakacili kusinsima, kwakamvwigwa ijwi akuzungaana, azifuwa zyakaswena cimwi acimwi kucifuwanyina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.7",
            "verseOrgIds": [
              "EZK.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi nendakali kulanga, kwakaboneka milambi anyama, acalo cikanda cakazivumbilila, pele muuya wabuumi kuutamo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.8",
            "verseOrgIds": [
              "EZK.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakandaambila kuti, Sinsimina muuwo. Sinsima, O mwana amuntu, ukwaambile muuwo kuti, Mbuboobu mbwaamba Mwami Jehova. Boola kuzwa kumabazu oonse one, O muuwo, ukaungile aba bantu bajayidwe, kuti bapone. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.11"
              },
              "items": [
                {
                  "text": "Ciy 11:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ndakasinsima, mbubonya mbondakalaililwa, nkabela muuwo wakabanjila, elyo bakaimikila amyeendo yabo, impi impati loko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.10",
            "verseOrgIds": [
              "EZK.37.10"
            ]
          }
        }
      ]
