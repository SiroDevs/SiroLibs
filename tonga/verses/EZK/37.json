              "items": [
                {
                  "text": "Lk 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ijanza lya-Jehova lyakali alindime, nkabela wakanditola munguzu zya-muuya wa-Jehova, wanditula akati kagundu. Nkabela moonse mugundu mwakalizwide zifuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakandizyungulusya kulinzizyo koonse koonse. Ndakabona kuti mpozili zinji loko mpoonya awo agundu, alimwi zyakali ziyumu loko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 37:3"
          },
          "items": [
