              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.6"
              },
              "items": [
                {
                  "text": "1 Sam 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.17"
              },
              "items": [
                {
                  "text": "Rom 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.9"
              },
              "items": [
                {
                  "text": "2 Kor 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakandibuzya kuti, O mwana amuntu, sa ezi zifuwa zilakonzya kupona? Ndakavuwa kuti, Nduwe oozi, O Mwami Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.11"
              },
              "items": [
                {
                  "text": "Is 55:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.17"
              },
              "items": [
                {
                  "text": "Rom 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakandaambila kuti, Sinsimina zifuwa ezi akuzyaambila kuti, O zifuwa ziyumu, amuswiilile ijwi lya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.30"
              },
              "items": [
                {
                  "text": "Int 104:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu Mwami Jehova mbwaambila zifuwa ezi. Ncobeni ndaleta muuya wabuumi, unjile mulindinywe, mupone. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "Ezk 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.27"
              },
              "items": [
                {
                  "text": "Joel 2:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ndamubikila milambi akumusyuusizya nyama akumusamika cikanda. Lino njoomubikila muuya, kuti mupone, nkabela muyooziba kuti ndime Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        }
      ]
    },
