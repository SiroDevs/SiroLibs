                  "text": "Am 9:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako sinsima, ukabaambile kuti, Mbuboobu mbwaamba Mwami Jehova. Ncobeni njoojalula tubanda twanu, njoomubusya kuzwa mutubanda twanu, nobantu bangu, alimwi njomusisya kunyika ya-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino muyooziba kuti ndime Jehova nenzoojalula tubanda twanu akumubusya kuzwa mutubanda twanu, nobantu bangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.27"
              },
              "items": [
                {
                  "text": "Ezk 36:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi njoobika muuya wangu mulindinywe, aboobo muyoopona, nkabela njoomukazika anyika yanu. Lino muyooziba kuti ndime Jehova, ancindaamba ndacicita, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
      ]
