                  "text": "2 Mak 11:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Webo, O mwana amuntu, bweza kasako kamwi akulemba alinkako kuti ngu-Juda abana ba-Israyeli mbaaswanene abo. Lino bweza kasako akamwi akulemba alinkako kuti ngu-Josefa, kabe kasako ka-Efraimu abasiluzubo boonse ba-Israyeli mbaaswanene abo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamana kucita obo, kotuswanaanya antoomwe kuti toonse tobile tube kasako komwe mujanza lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.17",
            "verseOrgIds": [
              "EZK.37.17"
            ]
          }
        },
