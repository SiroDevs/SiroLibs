              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbuboobu mbwaamba Mwami Jehova. Mbuli mbumwacita kuti milandu yanu iibalukwe, nkukuti insotoko zyanu zyayubunuka, azyalo zibi zyanu zyaboneka mumilimo yanu yoonse-mbuli mbumwaibalukwa, muyoozundwa mulinzizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
