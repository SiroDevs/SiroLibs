              "items": [
                {
                  "text": "Lk 1:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mbuboobu mbwaamba Mwami Jehova. Samununa citambala, gwisya musini. Zintu zyoonse zyasanduka. Sumpula cifwiifwi, fwiinsya cisumpukide. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
