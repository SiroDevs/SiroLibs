              "items": [
                {
                  "text": "Jer 49:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bika inzila ipanga njelikonzya kutola kuya ku-Raba wabana ba-Amoni, aimwi yakuya kucisi ca-Juda aku-Jerusalemu munzi walubaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mwami wa-Babuloni uliimvwi kumapambukilo aanzila, inzila zyobile nkuziswanaanina, kuti asonde. Ulazungaanya mivwi, ulabuzya makani kutukozyano, ulalingula muni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
