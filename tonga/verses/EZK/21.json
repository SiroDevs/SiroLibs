              "items": [
                {
                  "text": "Ezk 17:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mumeso aabo makani alaboneka mbuli kusonda kwabuyo. Balikonkezezye zikonke zipati. Pele ulaibalusya milandu yabo, kuti bazundwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
