                "loc": "1PE.4.17"
              },
              "items": [
                {
                  "text": "1 Pet 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O mwana amuntu, lanzya busyu bwako ku-Jerusalemu cankayikayi akutuntumwida zikombelo majwi aako. Sinsima aanyika ya-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.2",
            "verseOrgIds": [
              "EZK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.9.22"
              },
              "items": [
                {
                  "text": "Job 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambila nyika ya-Israyeli kuti, Mbuboobu mbwaamba Jehova. Bona! Ndime sinkondonyoko! Njoosomona ipanga lyangu mumukutu walyo, njookunyonyweeda bantu boonse, nibaba baluleme nibaba basizibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.3",
            "verseOrgIds": [
              "EZK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.47"
              },
              "items": [
                {
                  "text": "Ezk 20:47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuli mbunjanda kukunyonyweeda bantu boonse, nibaba baluleme nibaba basizibi, ipanga lyangu liyoozwa mumukutu walyo cakulwisya bantu boonse kuzwa kumusanza mane kusikila kunyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.4",
            "verseOrgIds": [
              "EZK.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.23"
              },
              "items": [
                {
                  "text": "Is 45:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bantu boonse bayooziba kuti ndime nde-Jehova ndagwisya ipanga lyangu mumukutu walyo. Talikooyoosomenwa alimwi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.4"
              },
              "items": [
                {
                  "text": "Is 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino webo, o mwana amuntu, sintimuka, Sintimuka mumeso aabo camoyo uutyokede acakuusa loko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibazookubuzya kuti, Waba aanzi nosintimuka? uleelede kuvuwa kuti, Nkaambo kamakani ngendamvwa. Makani asike buyo, myoyo yoonse ileenzemuka amaanza oonse alakompama, myuuya yoonse ilawizuka amazwi oonse alateta mbuli maanzi, Ncobeni aleza, alazuzikizigwa, mbwaamba Mwami Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        }
      ]
    },
