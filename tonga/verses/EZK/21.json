              "items": [
                {
                  "text": "Matl 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoocita kuti musini ube cisaalo, cisaalo, cisaalo luzutu, nkabela tuukooyooba limbi mane akasike oyo uuelede, lino njooupa nguwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
