              "items": [
                {
                  "text": "Ezk 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mujanza lyakwe lyalulyo mwaboneka cisolo ca-Jerusalemu, cisolo cakubika mincini yakupwayauzya, cakwaasamuna mulomo kukujaya akulizya ijwi lyacikwala, cakubika mincini yakupwayauzya zitendele, cakulundika citantaala cakusinkinizya akuyaka cilwido. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
