                "loc": "ZEP.2.8+ZEP.2.9+ZEP.2.10+ZEP.2.11"
              },
              "items": [
                {
                  "text": "Zef 2:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uwe, O mwana amuntu, sinsima cakwaamba kuti, Mbuboobu Mwami Jehova mbwaamba aabana ba-Amoni akusampaula kwabo. Amba kuti, Ipanga! Ipanga lilisomwedwe kukujaya, lilisyobedwe, lilamweka mbuli lulabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "—bantu nibakubonena zilengano zyabuyo akukusondela zyakubeja —kuti balilazike ansingo zyabasimasampu basizibi basikilwa buzuba bwabo, ciindi camamanino aabo aakupegwa mulandu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lipilusye mumukutu walyo. Nkukonya oko nkowakalengelwa, munyika yabuzyalwe bwako, njookubeteka nkukonya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.30",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njookutilila bukali bwangu, njookuvukutila amulilo walunyemo lwangu, njookwaaba mumaanza aabantu basicongo bezi kunyonyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyooba cilyo camulilo. Bulowa bwako buyooba mukati kanyika, Tokooyooyeeyegwa limbi, nkaambo ndime nde-Jehova ndaamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.32",
            "verseOrgIds": [
              "EZK.21.32"
            ]
          }
