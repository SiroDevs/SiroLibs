                "loc": "EZK.8.12"
              },
              "items": [
                {
                  "text": "Ezk 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino webo, O mwana amuntu, sinsima akukamba amaanza aako, Ipanga liinduuluke ziindi zyotatwe, ipanga lyabayasidwe, ipanga lyamupati uuyasidwe. Ndendilyo libazyungulukide, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti myoyo yabo ienzemuke, bantu banji balebwe kumilyango yabo. Ndibambide indomo yapanga! Aha! Lyaba mbuli lulabo, lilisyobwedwe kukujazya! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
