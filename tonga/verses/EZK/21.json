                "loc": "EZK.14.17"
              },
              "items": [
                {
                  "text": "Ezk 14:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Timbaula kululyo akulumwesi, koonse koonse busyu bwako nkobulangide. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        },
