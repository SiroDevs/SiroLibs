              "items": [
                {
                  "text": "Is 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambebo njookamba amaanza aangu, njookutya bukali bwangu. Ndime nde-Jehova ndaamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
