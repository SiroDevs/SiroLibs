              },
              "items": [
                {
                  "text": "Matl 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino webo, O simasampu sizibi, silutwe waIsrayeli, oosikilwa buzuba bwako, ciindi camamanino aako aakupegwa mulandu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
        {
