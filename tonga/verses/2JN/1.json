          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabotelwa loko kujana bana bako bamwi baleenda mulusinizyo, mbubonya mbuli mulazyo ngotwakatambula kuzwa kuli-Taata. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.4",
            "verseOrgIds": [
              "2JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
