              },
              "items": [
                {
                  "text": "3 Joh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mupati ulajuzya namalelo uusalidwe abana bakwe, abo mbenjanda mulusinizyo, alimwi teensi ndime endike pele abalo boonse baluzi lusinizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.1",
            "verseOrgIds": [
              "2JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aceeci nkaambo kalusinizyo lukala mulindiswe, alimwi luyooba aswe akutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luzyalo luyooba kulindiswe, alweetelelo, aluumuno, kuzwa kuli-Leza Taateesu akuli-Jesu Kristo, Mwanaakwe Taateesu, mulusinizyo amuluyandano.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
