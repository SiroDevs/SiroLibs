                "loc": "1JN.2.7"
              },
              "items": [
                {
                  "text": "1 Joh 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aneeno ndakukomba, namalelo, teensi mbuli kuti ndali kulemba mulazyo mupya, pele oyo ngotwakajisi kuzwa kumatalikilo, kuti tuyandane. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.5",
            "verseOrgIds": [
              "2JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino olu ndoluyando, kuti tweende akutobela milazyo yakwe. Oyu ngomulazyo, mbuli mbomwakamvwa kuzwa kumatalikilo, kuti muleelede kweenda mumonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.18"
              },
              "items": [
                {
                  "text": "1 Joh 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.1+1JN.4.2+1JN.4.3"
              },
              "items": [
                {
                  "text": "4:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo basilweeno banji mobali munyika, abo batazumini kuti Jesu Kristo ulisikide munyama. Oyu ngusilweeno, ngo-SikulwanyaKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.7",
            "verseOrgIds": [
              "2JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.11"
              },
              "items": [
                {
                  "text": "Gal 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulilange, kuti mutasweekelwi zintu nzitwakabelekela, pele kuti mutambule bulumbu buzulide. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.23"
              },
              "items": [
                {
                  "text": "1 Joh 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi aumwi uusololela kumakani ambi akutakala mulwiiyo lwa-Kristo, tajisi Leza. Oyu uukala mulwiiyo ngonguwe uujisi Taata a-Mwana alakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.6"
              },
              "items": [
                {
                  "text": "2 Tes 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.17"
              },
              "items": [
                {
                  "text": "1 Bam 13:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "3JN.1.8"
              },
              "items": [
                {
                  "text": "3 Joh 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuti umwi wasika kulindinywe akutaleta olu lwiiyo, mutamutambuli muŋanda yanu, mutamujuzyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.10",
            "verseOrgIds": [
              "2JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo oyu uumujuzya ulaabilwa milimo yakwe mibi.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        }
      ]
