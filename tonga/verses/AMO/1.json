          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele njootuma mulilo muŋanda ya-Hazaeli, ulye maanda aabwami aa-Benihadadi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
