                  "text": "Is 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi njootyola munkulu wamulyango wa-Damasko, nkabela njoomanya mweendelezi wakumumpata wa-Aveni asikujata mumfunko waku-Bete-Edeni, nkabela bantu ba-Aramu bayootolwa mubuzike ku-Kiri, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
