          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo nsikooyoofwidilizya mukowa wa-Jakobo cakutabuka, mbwaamba Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo amubone mbundalaililal Njooseba mukowa wa-Israyeli akati kamasi oonse mbubonya mbuli maila mbwaasebwa mucisebyo, nkabela takuyoowida ansi inseke niiba yomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoojazigwa ipanga boonse basizibi akati kabantu bangu, baamba kuti, Mapenzi taakooyootusikila nanka kutujana.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
