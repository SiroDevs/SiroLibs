              },
              "items": [
                {
                  "text": "Mik 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Mwami Jehova wamakamu nguuampa nyika, elyo ileenzunuka. Boonse bakede mulinjiyo bayoolila. Iyoofuta yoonse mbubonya mbuli lwizi, akuyosa alimwi mbuli mulonga waku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguuyaka maanda aakwe kujulu, azyalo intalisyo zyalululi lwakwe wazijatya ansi. Nguuita maanzi aamulwizi akwaatila ansi. Izina lyakwe ngu-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
