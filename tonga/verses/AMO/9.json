              },
              "items": [
                {
                  "text": "Am 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa tamuli mbubonya mbuli bana ba-Etiopiya mumeso aangu, nubana ba-Israyeli? mbwaamba Jehova. Sa teensi ndime ndakagwisya ba-Israyeli kuzwa mucisi ca-Egepita, aboonse ba-Filisti kuzwa ku-Kafitori, aboonse ba-Aramu kuzwa ku-Kiri? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.11.4"
              },
              "items": [
                {
                  "text": "Int 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.30.11"
              },
              "items": [
                {
                  "text": "Jer 30:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubone! Meso aa-Mwami Jehova alalanga cisi cabasizibi. Njoociziminganya kuzwa kubusyu bwanyika.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
