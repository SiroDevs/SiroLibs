              },
              "items": [
                {
                  "text": "My 24:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti bavube abo basyeede akati kabaEdomu azisi zyoonse izina lyangu mpolyaambwa, mbwaamba Jehova uucita aya makani.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
