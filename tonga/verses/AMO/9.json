            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo njoobusya itente lyambungano lya-Davida limwaikide, akuyakulula mazwazwa aalyo. Njoobusya matongo aakwe akwaayakulula, abe mbuli kuciindi cakalekale, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
