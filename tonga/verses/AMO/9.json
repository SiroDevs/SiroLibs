              "items": [
                {
                  "text": "Lev 26:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Mazuba aleza, mbwaamba Jehova, sikupanda muunda nazooenzya sikutebula, alakwe sikulyataula misaansa uyooenzya sikubyala imbuto. Nkabela zilundu zilawisya imbote iilweela, amituntatunta yoonse ilayaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.4"
              },
              "items": [
                {
                  "text": "Is 61:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoolesya buzike bwabantu bangu ba-Israyeli, elyo bayooyaka minzi iisaalidwe akukala mulinjiyo, alimwi bayoobyala myuunda yamasaansa akunywa waini wanjiyo, bayoolima myuunda akulya micelo yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.21"
              },
              "items": [
                {
                  "text": "Is 60:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nicobakalika nji munyika yabo, batakaluluki limbi anyika yabo njindabapa, mbwaamba Jehova Leza wako.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        }
