              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amundisakanisizye lupyopyongano lwanyimbo zyanu, nkaambo kwiimba kwamantimbwa aanu nsikooyookuswiilila pe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.23",
            "verseOrgIds": [
