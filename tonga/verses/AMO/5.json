              "items": [
                {
                  "text": "Kul 32:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amusule bubi akuyandisya bubotu, akubamba kabotu imbeta mumulyango, elyo Jehova Leza wamakamu ambweni uyoobafwida luzyalo basyeede bamukowa wa-Josefa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        }
