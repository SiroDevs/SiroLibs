              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasesemwa, ndasampaula makubi aanu, azyalo imbungano zyanu nsizibotelwi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.21",
            "verseOrgIds": [
              "AMO.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "AMO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba kuti mwandipailila zipaizyo azituuzyo, nsiziyandi pe, azyalo zitontozyo zyabanyama banu baneneede nsizilangili pe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.22",
            "verseOrgIds": [
              "AMO.5.22"
            ]
          }
        },
        {
