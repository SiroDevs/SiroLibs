            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Mwami Jehova Leza wamakamu. Mumasambalilo oonse kuyooba kulila, amumigwagwa yoonse bayooamba kuti, Maawe! Maawe! Nkabela bayooita simuunda kukoomoka, ayooyo uuzi nyimbo zyakulizya bayoomwiita kulilwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.12"
              },
              "items": [
                {
                  "text": "Kul 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela moonse mumyuunda yamasaansa muyooba kulila, nkaambo njenti inde akati kanu, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.17",
            "verseOrgIds": [
              "AMO.5.17"
            ]
          }
        }
      ]
