              "type": "text"
            }
          ]
        },
        {
          "text": "Sa mwakandiletela zipaizyo azituuzyo myaka iili makumi one munkanda, nomukowa wa-Israyeli? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
