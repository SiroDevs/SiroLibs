                "loc": "2PE.3.4"
              },
              "items": [
                {
                  "text": "2 Pet 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe kulimbabo balangila buzuba bwa-Jehova! Ino muyandilanzi buzuba bwa-Jehova? Mbuzuba bwamudima, tabuli bwamumuni pe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.18",
            "verseOrgIds": [
              "AMO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "AMO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mbubonya mbuli muntu uucija mulavu, elyo ulaswanaana asuntwe, nanka naanjila muŋanda akuyaamika ijanza lyakwe kubulambo, kulamuluma inzoka. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.19",
            "verseOrgIds": [
              "AMO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "AMO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa buzuba bwa-Jehova tabweensi mudima na? Tabweensi mumuni pe. Bulasia mbi, tabujisi kubekabeka pe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.20",
            "verseOrgIds": [
              "AMO.5.20"
            ]
          }
        }
      ]
    },
