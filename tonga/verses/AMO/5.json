        },
        {
          "text": "Amuyandaule bubotu, mutayandauli bubi pe, kuti mube abuumi, aboobo Jehova Leza wamakamu uyooba anywe mbubonya mbumwaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        },
        {
