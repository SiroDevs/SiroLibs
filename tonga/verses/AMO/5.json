              "items": [
                {
                  "text": "Mik 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.13"
              },
              "items": [
                {
                  "text": "Zef 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuli mbumulyatila mucete, akumubbadezya cipo cabulotwe, muliyakide maanda aamabwe aabezedwe, pele tamukooyookala mulingawo, alimwi mulibyalide myuunda yamasaansa, pele tamukooyoonywa waini kulinjiya pe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.21"
              },
              "items": [
                {
                  "text": "Is 29:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ndizi kuti milandu yanu yavula, azyalo zibi zyanu zili anguzu, inywe nomupenzya baluleme, akutambula makulo akuleesya imbeta zyabacete mumulyango. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nciceeco muntu uucenjede ncaumwide ciindi ecino, nkaambo nciindi cabubi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.13",
            "verseOrgIds": [
              "AMO.5.13"
            ]
          }
        }
      ]
    },
