              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele imbeta kaziya bupoomoka mbuli maanzi, abululami mbuli mulonga uutayuminini.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.24",
