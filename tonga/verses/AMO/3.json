              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa bantu bobile balakonzya kweenda antoomwe, na kabatazuminene? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa mulavu ulavuluma musokwe, na katajisi zilyo? Sa Syaanza ulalila mubulyango bwakwe, na katana kujata cintu? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa kayuni kalawida ansi mukakole, na katakwe sikukateya? Sa kakole kalafwisuka kuzwa ansi, na katakwe cintu ncikajisi? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.3"
              },
              "items": [
                {
                  "text": "Ezk 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mweembo ulalila mumunzi, sa bantu tabayoowi na? Na munzi wasikilwa bubi, sa teensi Jehova wabuleta na? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 3:7"
