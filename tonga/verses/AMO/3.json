              "items": [
                {
                  "text": "Ciy 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni Mwami Jehova taciti cintu, atana kuyubunwida balanda bakwe basinsimi maseseke aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.16"
              },
              "items": [
                {
                  "text": "1 Kor 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulavu naalila, nguni uutayoowi? Mwami Jehova naamba, nguni uukonzya kutasinsima?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
