                "loc": "1PE.4.17"
              },
              "items": [
                {
                  "text": "1 Pet 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndinywe mbenzi luzutu akati kamikowa yoonse yanyika. Nkaambo kako njoomuboozezya milandu yanu yoonse.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
