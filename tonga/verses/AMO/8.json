                }
              ]
            }
          ]
        },
        {
          "text": "Amubone! Mazuba aleza, mbwaamba Mwami Jehova, ngensi tumine nyika inzala, Teensi kwaamba kuti ninzala yansima nanka nyota yamaanzi pe. Ninzala yakuswiilila majwi aa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bayooya butuntulika kuzwa kulwizi akusikila kulwizi, akuzwa kunyika akusikila kujwe. Bayooya buzelengana cakuyandaula ijwi lya-Jehova, pele tabakooyoolijana pe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo basimbi beebesi abakubusi boonse bayoowizuka nkaambo kanyota. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.13",
            "verseOrgIds": [
              "AMO.8.13"
            ]
          }
        },
