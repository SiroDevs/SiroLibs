                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo, mbwaamba Mwami Jehova, njoobbizya izuba ciindi casikati, akusizya nyika buzuba nibucili bupati. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
