              "items": [
                {
                  "text": "Lk 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njoosandula mapobwe aanu abe koomoka, azyalo nyimbo zyanu zyoonse ziyooba zyakulizya. Zibuno zyoonse njoozisamika zisani zyamasaka, amitwe yoonse iyoonyoolwa. Njoocita kuti kube mbuli kulila mwana uuzyedwe alike, amamanino ayooba mbuli buzuba bulula,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
