                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "elyo nayooyubununwa sikusotoka milao, ngwayoonyonyoona Mwami Jesu a-Muuya wamulomo wakwe, akumulobya akulibonya kwakuboola kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
