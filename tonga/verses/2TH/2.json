              },
              "items": [
                {
                  "text": "5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nciconya eco ncaakamwiitila kunguzu zya-Makani Mabotu esu, kuti muvube bulemu buzwa ku-Mwami wesu Jesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
