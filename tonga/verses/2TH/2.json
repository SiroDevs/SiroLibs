                "loc": "2CO.4.3"
              },
              "items": [
                {
                  "text": "4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyooza alweeno loonse lwabubi lwakweena baabo abali mukunyonyooka, nkaambo teebakayanda kutambula lusinizyo lwakubafutula, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
            "verseOrgIds": [
              "2TH.2.10"
            ]
          }
