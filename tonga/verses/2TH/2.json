        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Ezk 28:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyu ngusinkondonyina Leza, uulisumpula ajulu lyazyoonse zyaambwa Leza na zikombwa, waba uukala muntempele ya-Leza, walyaamba kuti, Ndime Leza.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        }
