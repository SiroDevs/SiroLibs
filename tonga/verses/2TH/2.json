                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyu sikusotoka milao uyooza akubeleka kwa-Saatani, anguzu zyamisyobo misyobo azitondezyo aziyoosyo zyakubeja. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
