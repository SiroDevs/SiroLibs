            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakwesu, tulaamba makani aakuboola kwa-Mwami wesu Jesu Kristo akuyoboloka kwesu kwakuyoomucinga. Tulamukumbila ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti mutafwambi kuzungaana kumyoyo yanu, alimwi mutayoosegwi, nokuba kumuuya nokuba kujwi nokuba kulugwalo lubaanga luzwa kulindiswe, cakuyeeya kuti buzuba bwa-Mwami buliswenede kale. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
