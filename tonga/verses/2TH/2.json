              "attrs": {
                "loc": "1JN.4.3"
              },
              "items": [
                {
                  "text": "4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kutabi muntu uumweena kufumbwa muciyanza cili buti, nkaambo tabukooyoosika cita lukasaangune kuba luleyo, alimwi uyooyubunuka muntu mubi, mwana walunyonyooko. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
