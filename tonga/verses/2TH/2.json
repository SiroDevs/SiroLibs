              "items": [
                {
                  "text": "2 Tim 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aboobo Leza wabatumina kucita-cita kwalweeno, kuti basyome kububeji. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.11",
            "verseOrgIds": [
              "2TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbubazoobetekwa boonse abakaka kusyoma lusinizyo, abalibotezya kumakani aataluleme.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        }
      ]
