              "items": [
                {
                  "text": "My 15:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anooli masomwa asalala, aalo maila oonse alasalala. Anooli muyanda wasalala, ayalo mitabi ilasalala. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.16",
            "verseOrgIds": [
              "ROM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.11+EPH.2.12+EPH.2.13+EPH.2.14+EPH.2.15+EPH.2.16+EPH.2.17+EPH.2.18+EPH.2.19"
              },
              "items": [
                {
                  "text": "Ef 2:11-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mitabi imwi niyakagonkwa, elyo yebo noli kasonsela kamusokwe wakasimpikilwa akati kayo, kuti ukamantane ayo antoomwe kucisiko cini camusamu wa-olifa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.17",
            "verseOrgIds": [
              "ROM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.22"
              },
              "items": [
                {
                  "text": "Joh 4:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "utalitembauli kumitabi eyo. Nolitembaula, uleelede kwiibaluka kuti teensi nduwe onyampula cisiko pe, cisiko ncecikunyampula webo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.18",
            "verseOrgIds": [
              "ROM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulaamba kuti, Mitabi yakagonkwa, kuti nkasimpikilwe mebe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.19",
            "verseOrgIds": [
              "ROM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.16"
              },
              "items": [
                {
                  "text": "Rom 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbukubede. Kutasyoma kwayo nkuyakagonkelwa, alimwi webo, kulusyomo lwako nkoimvwi. Nekubaboobo utalisumpuli pe, ulitole ansi buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.20",
            "verseOrgIds": [
              "ROM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Leza mbwaatakafwida mitabi ini-ini insoni, takooyookufwida insoni awebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.21",
            "verseOrgIds": [
              "ROM.11.21"
            ]
          }
        },
