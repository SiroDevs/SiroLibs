                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leza tatakatide cisi cakwe pe, cisi cakwe ncaakazibide kale! Sa tamuzi mbwaamba malembe aa-Eliya? Ulabikila Israyeli kaambo kubusyu bwa-Leza, kakuti, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.2",
            "verseOrgIds": [
              "ROM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 11:3"
          },
          "items": [
