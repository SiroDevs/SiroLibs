                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti inga ndakonzya kuzubaazya basinyamama, cita nkafutule bamwi akati kabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.14",
            "verseOrgIds": [
              "ROM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo anooli busowe bwabo mbubwabeda bantu baansi boonse luyanzano, ino bulaba buti butambulwi bwabo? Inga bulaba mbuli buumi buzwa kulufu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.15",
            "verseOrgIds": [
              "ROM.11.15"
            ]
          }
        }
