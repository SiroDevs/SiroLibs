          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Rom 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya boobo, akwalo kuciindi casunu kuli cisyaalizyo cisalwa kuluzyalo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.5",
            "verseOrgIds": [
              "ROM.11.5"
            ]
          }
        },
        {
