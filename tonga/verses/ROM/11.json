                {
                  "text": "2 Kor 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo, kuti batakakatili kukutasyoma kwabo, balasimpikilwa. Leza ulakonzya kubweedela kubasimpikila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.23",
            "verseOrgIds": [
              "ROM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikuti webo, niwakagonkwa kumusamu uulimezya wamusokwe akusimpikilwa mumusamu mubotu cakutalimezya sa tiikooyooinda­ eyi mitabi iniini kusimpikilwa mumusamu wayo ini.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.24",
            "verseOrgIds": [
              "ROM.11.24"
            ]
          }
        }
