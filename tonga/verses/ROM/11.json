              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamwaambila nywebo nubamasi mbuli mbwendi apostolo wabamasi, ndalemeka eyi milimo yangu njiyonya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.13",
