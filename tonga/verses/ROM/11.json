          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku-Makani Mabotu mbobasinkondonyina Leza, nkaambo kandinywe, pele kubusale mbayandiki nkaambo kabawisaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.28",
            "verseOrgIds": [
              "ROM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo zyaabilo zya-Leza abwiite bwakwe zyoonse tazilekeki pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.29",
            "verseOrgIds": [
              "ROM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nywebo kalekale mwakali basicinguni kuli-Leza, pele sunu mulijene lweetelelo nkaambo kacinguni cabaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.30",
            "verseOrgIds": [
              "ROM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya obo sunu balo mbasicinguni, pele kukweetelelwa kwandinywe nkubazooetelelwa abalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.31",
            "verseOrgIds": [
              "ROM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 11:32"
          },
          "items": [
