                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkukwaamba kuti, nikakazikwe anywe mumyoyo yesu kulusyomo lwesu toonse, nywebo ambebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
