              "type": "text"
            }
          ]
        },
        {
          "text": "bazule kutalulama, abwaamu, abubi, abutavu; akuzula ibbivwe, abujayi, alukazyanyo, alweeno, alusulo; akuba bajubi, ",
          "type": "text",
