              "items": [
                {
                  "text": "Flp 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuyandane aluyandisyo lwabunyina. Amusungwaale kukulemekana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
