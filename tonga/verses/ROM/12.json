              "items": [
                {
                  "text": "Inc 18:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutabi batolo kubusungu, pele myoyo yanu ipye kukumanina Mwami milimo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
