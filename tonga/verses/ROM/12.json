            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayooyo uukutaukila abike moyo kukutaukila kwakwe, alakwe mwiiyi kukwiisya kwakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.7",
            "verseOrgIds": [
              "ROM.12.7"
            ]
