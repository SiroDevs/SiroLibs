          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.4+1CO.12.5+1CO.12.6+1CO.12.7+1CO.12.8+1CO.12.9+1CO.12.10+1CO.12.11"
              },
              "items": [
                {
                  "text": "1 Kor 12:4-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tulijisi zyaabilo zyamisyobo misyobo mbuli luzyalo ndutwapegwa. Lino oyo uujisi bulunguluzi alungulule mbuli mweelwe walusyomo lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 12:7"
          },
          "items": [
