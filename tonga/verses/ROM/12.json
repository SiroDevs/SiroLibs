              },
              "items": [
                {
                  "text": "Ef 4:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mbubonya obo swebo, notuli banji, tuli mubili omwe muli-Kristo, toonse tuli zizonyina umwi aumwi mukwesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
          }
        },
        {
          "name": "verse",
