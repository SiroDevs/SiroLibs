                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikuti kuluzyalo ndundapegwa, ndaambila boonse buyo bali kulindinywe, kuti muntu ataliyeeyi cakulisumpula kwiinda mbukweelede, pele aliyeeye cakuumuna, mbubonya mbuli mweelwe walusyomo ngwaabilwa muntu umwi aumwi kwa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.3",
            "verseOrgIds": [
              "ROM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
