              "items": [
                {
                  "text": "9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alakwe sikukombelezya kukukombelezya kwakwe. Oyu uupa ape cabuuya, alakwe musololi abe abusungu, ayooyo uuetelela abe alumwemwe.",
          "type": "text",
