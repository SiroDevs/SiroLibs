              "items": [
                {
                  "text": "1 Tes 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amube abulangizi cakukondwa, alimwi amukakatile nikuba kuciindi camapenzi, akujatisya kukomba. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
