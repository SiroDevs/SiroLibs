                "loc": "1CO.12.12"
              },
              "items": [
                {
                  "text": "1 Kor 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuli mbutujisi zizo zinji mumubili omwe, alimwi zizo zyoonse tazijisi mulimo omwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.4",
            "verseOrgIds": [
              "ROM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
