              },
              "items": [
                {
                  "text": "45:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "We! Nduweni uwe omuntu okazyanya a-Leza? Sa cibumbwa cilakonzya kwaambila mubumbi kuti, Wandicitilanzi boobo? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
