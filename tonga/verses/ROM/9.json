                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balo bali ba-Israyeli, bwana mbubwabo, abwalo abulemu, ayalo milongo, ayalo milao, abwalo bukombi, azyalo zisyomezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
