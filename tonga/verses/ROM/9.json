                "loc": "NUM.23.19"
              },
              "items": [
                {
                  "text": "My 23:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele teensi kwaamba kuti ijwi lya-Leza lyasampuka, pe, Nkaambo abo bazwa ku-Israyeli teensi boonse mbiba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.6",
            "verseOrgIds": [
              "ROM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.12"
              },
              "items": [
                {
                  "text": "Matl 21:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi abo bazwa kumbuto zya-Abrahamu teensi boonse mbibana bakwe. Pe, kulaambwa kuti, Muli-Izaka muziyooambwa imbuto zyako, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.23"
              },
              "items": [
                {
                  "text": "Gal 4:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkukwaamba kuti, bana bakunyama teensi mbabo mbibana ba-Leza, pele bana balusyomezyo mbibaaba baambwa mbuli inyungu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.8",
            "verseOrgIds": [
              "ROM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.10"
              },
              "items": [
                {
                  "text": "Matl 18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ijwi lyalusyomezyo ndeeli lyakuti, Kuciindi cili boobo ndeza, elyo Sara uyooba amwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.21"
              },
              "items": [
                {
                  "text": "Matl 25:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi teensi boobo luzutu, pele alakwe Rebeka naakaba ada kuli-Izaka taateesu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.10",
            "verseOrgIds": [
              "ROM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ciindi ncibatakaina kuzyalwa bana, alimwi kabatana kucita cintu niciba cibotu niciba cibi, kuti bwiime bukanze bwa-Leza bwakusala, butali bwamilimo pele bwayooyo uuita, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.11",
            "verseOrgIds": [
              "ROM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.23"
              },
              "items": [
                {
                  "text": "Matl 25:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakaambilwa kuti, Mupati ulaba muzike wamuniini. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.2+MAL.1.3"
              },
              "items": [
                {
                  "text": "Mal 1:2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya obo mbukulembedwe kuti, Jakobo ndakamuyanda, pele Esau ndakamusula.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        }
