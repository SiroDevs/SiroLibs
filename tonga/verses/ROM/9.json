                  "text": "Kul 9:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikuti malembe alaambila Farao kuti, Nciceeco nciconya ncindakakubusizya, kuti mulinduwe mukabe citondezyo canguzu zyangu, kuti izina lyangu likabe ampuwo munyika yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
