              "attrs": {
                "loc": "JHN.1.1"
              },
              "items": [
                {
                  "text": "Joh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bamataata abalo mbibabo, alimwi kulimbabo nkwaakazwa Kristo mbuli nyama, nguwe Leza uuli abwami bwazintu zyoonse uutembaulika lyoonse. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        }
      ]
