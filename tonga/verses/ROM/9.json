              "type": "text"
            }
          ]
        },
        {
          "text": "Lino inga uwe ulandaambila kuti, Pele nkaambonzi ucitongauka? Nguni uukonzya kukaka bukanze bwakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
