              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaamba cakusinizya muli-Kristo, nsibeji pe, awalo moyo wangu ulandizuminina mu-Muuya Uusalala, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ndili abuusu bupati, alimwi ndaciswa lyoonse cakutaleka mumoyo wangu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "Kul 32:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nindakakonzya kukomba kuti nkabe mutakate ndemwini nkaambo kabakwesu abasiluzubo bangu bakunyama. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
