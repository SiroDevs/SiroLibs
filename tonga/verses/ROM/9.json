                  "text": "Jer 18:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa mubumbi tajisi bwami bwakubulongo? Kumulwi omwe sa takonzyi kucita cilongo cimwi cibotu acimwi cibi?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
