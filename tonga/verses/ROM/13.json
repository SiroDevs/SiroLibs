        },
        {
          "text": "Bantu boonse abalibombye kumaami aacisi. Nkaambo taakwe bwami cita buzwa kwa-Leza, nkabela maami aaliwo alibikidwe kwa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.1",
            "verseOrgIds": [
              "ROM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako oyo uulwisya bwami ulakazya cintu cibikwa kwa-Leza, nkabela basikukazya balalijanina kubetekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.2",
            "verseOrgIds": [
              "ROM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
