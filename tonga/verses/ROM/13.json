              "items": [
                {
                  "text": "Ef 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atweende muciyanza ceelede, mbuli kuciindi casikati. Tuteendi anjalalando ankolwi, abuvuule azisusi zibi, abulwani abbivwe. ",
          "type": "text",
          "attrs": {
