                  "text": "Mt 22:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Luyandisyo talucitili mweenzinyoko cibi. Mbuboobo luyandisyo mbululondola Mulao.",
          "type": "text",
