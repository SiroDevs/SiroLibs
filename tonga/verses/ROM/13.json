              "items": [
                {
                  "text": "Rom 12:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo mweendelezi ngumulanda wa-Leza wakukucitila cibotu, Anukuti wacita bubi, yoowa, nkaambo teensi cabuyo ncasaminide ipanga, nkaambo ngumulanda wa-Leza, mubetesi wakukoma abo bacitaula bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.4",
            "verseOrgIds": [
              "ROM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako kuleelede kulibombya, teensi nkaambo kabukali bulike, pele nkaambo kamanjezeezya aalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.5",
            "verseOrgIds": [
              "ROM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
