                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo beendelezi, teensi abo bacita bubotu mbibayoosya, pele abo bacita bubi, Kuti koyanda kutaba abuyoofu bwabwami, mbubo, cita bubotu, elyo ulatembaulilwa nciconya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.3",
            "verseOrgIds": [
              "ROM.13.3"
            ]
          }
        },
        {
          "name": "verse",
