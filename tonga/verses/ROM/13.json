                "loc": "MAT.22.21"
              },
              "items": [
                {
                  "text": "Mt 22:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako amupe bantu boonse mbubeelede, Oyo uueledwe mutelo, amumupe mutelo; oyo uueledwe bulumbu, amumupe bulumbu; oyo uuelede kuyoowegwa, amumuyoowe; ayooyo uuelede kulemekwa, amumulemeke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
