                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nciconya eco ncimutelela mutelo, nkaambo mbibasimilimo ba-Leza, bajatisya mulimo oyo nguwenya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
