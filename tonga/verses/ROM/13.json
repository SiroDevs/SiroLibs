              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo majwi aamba kuti, Utaciti bumambi, Utajayi, Utabbi, Utabi abbivwe, amilazyo imwi iili boobo, mitwi yamakani aya oonse ilaambwa mujwi lyomwe lyakuti, Yanda mweenzinyoko mbubonya mboliyanda omwini. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
