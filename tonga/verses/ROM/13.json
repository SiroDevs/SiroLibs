                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Masiku aumbuluka, bwaamba kuca, Nkaambo kaako atusowe incito zyamudima, tutomene zyakulwisya zyamumuni, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
