              },
              "items": [
                {
                  "text": "1 Kor 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo uukompeme kulusyomo amumusamausye, pele kutabi kukubeteka miyeeyo yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
