                  "text": "2 Joh 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakalijisi zintu zinji zyakukulembela, pele nsiyandi kuzilemba ainki acilembyo. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.13",
            "verseOrgIds": [
              "3JN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasyoma kuti nzoofwambaana kukubona, lino tuzooambaula kubusyu abusyu. Kuumuna kube kulinduwe. Beenzinyoko bakujuzya. Juzya beenzuma aumwi aumwi.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
