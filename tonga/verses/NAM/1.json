              },
              "items": [
                {
                  "text": "2 Tim 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova mubotu, ngumacijilo mubuzuba bwamafwabi, ulibezi abo bamusyoma, ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.8"
              },
              "items": [
                {
                  "text": "Am 8:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ulamanizya basinkondonyina alupayo lwazambangulwe, ulabatandila mumudima. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.8",
            "verseOrgIds": [
              "NAM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino nkaambonzi mulayeeya bubi kuli-Jehova? Ulamanizya makani lweendo lomwe. Mapenzi taakooyoobuka lwabili. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba kuti bali mbuli mamvwa aasyankene, alimwi balikoledwe bukoko, bayootentwa mbuli zisikosiko ziyuminide. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkwali iwakazwa mulinduwe uuyeeya bubi kuli-Jehova, uubula zyabuyo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
