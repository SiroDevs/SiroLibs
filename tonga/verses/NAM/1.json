              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova ngu-Leza sibbivwe sikutema milandu. Jehova ulatema milandu, alimwi ulizwide bukali. Jehova ulatema milandu yabaabo bamukazya, akutaleka bukali kuli basinkondonyina. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        },
        {
