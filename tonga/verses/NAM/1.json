              "items": [
                {
                  "text": "Mik 7:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova tafwambi kunyema, alimwi inguzu zyakwe nzipati. Takooyoolulamika abuniini babisya. Jehova ulijisi inzila yakwe mukambizi amuguwo, amayoba ndolusuko lwamaulu aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.3",
            "verseOrgIds": [
              "NAM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.15"
              },
              "items": [
                {
                  "text": "Jos 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulatapatila lwizi akuluyuminizya, amilonga yoonse uliianzanya. Basani a-Karimeli alapusama, aalo malubaluba aa-Lebano alapusama. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
              "NAM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.22.8"
              },
              "items": [
                {
                  "text": "2 Sam 22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zilundu zilateketa kubusyu bwakwe, atulundulundu tuleenzunuka. Nyika ilapyopyongana naalibonya, aluwa abantu boonse bakede mulindulo. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
            "verseOrgIds": [
              "NAM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguni uukonzya kwiima kubukali bwakwe. Nguni uukonzya kulibusya kulunyemo lwakwe luyoosya. Bukali bwakwe bulakolomoka mbuli mulilo, amandomba alapwayika nkaambo kakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.6",
            "verseOrgIds": [
              "NAM.1.6"
            ]
          }
        }
      ]
    },
