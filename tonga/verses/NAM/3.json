              "items": [
                {
                  "text": "1 Bam 22:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Beembeli bako bali muŋonzi, O mwami wa-Asuri. Baalu bako baloonede. Bantu bako balimwaikide azilundu, taakwe uubabunganya pe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.18",
            "verseOrgIds": [
              "NAM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NAM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.8"
              },
              "items": [
                {
                  "text": "Is 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.2.15"
              },
              "items": [
                {
                  "text": "Malo 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.15"
              },
              "items": [
                {
                  "text": "Zef 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuciswa kwako takusilikiki pe, bulwazi bwako mbwalufu. Boonse baswiilila impuwo bayookukambilila maanza, nkaambo taakwe naba omwe bubi bwako ngubutana kukataazya lyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.19",
            "verseOrgIds": [
              "NAM.3.19"
            ]
          }
