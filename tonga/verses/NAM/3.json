              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkekaambo kamamambe manji aasimamambe uuli aciwa cibotu, sibulozi, uuaba masi amamambe aakwe aziinga amalozi aakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
