              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bona! Ndakulwisya, mbwaamba Jehova wamakamu. Njoosamununa malogwe aako kubusyu bwako. Bantu bamasi njoobabonya cintanda cako, amami oonse ayoobona kusampauka kwako. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njookufusa zisesemyo, njookusofwaazya, njookubika ukabe ceebelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo boonse bakubona bayoocija, bayooti, Ma! Nineve wasaalwa! Ino nguni uuti mulilile? Njandaule kuli basikumuumuzya?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
