                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.7.17"
              },
              "items": [
                {
                  "text": "Am 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.28"
              },
              "items": [
                {
                  "text": "Rom 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balapaila zipaizyo mala lyamalundu, alimwi kuzilundu nkobatentela tununkilizyo kunsi lyamikamba alyamizimbwa alyamibanga, nkaambo cenzule cayo ncibotu, Nkaambo kako bana banu basimbi balavuula, abalo banabwinga banu balacita bumambe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.13",
            "verseOrgIds": [
              "HOS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsikooyookoma bana banu basimbi ciindi cakuvuula, abanabwinga banu nsikooyoobakoma ciindi cakucita bumambe, pe, nkaambo bapati beni balabweza basimamambe kumbali, akupaizya abasibuvuule. Aba bantu batakwe maanu bayoonyonyooka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.14",
            "verseOrgIds": [
              "HOS.4.14"
            ]
          }
        }
      ]
    },
