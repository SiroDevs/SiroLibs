              "items": [
                {
                  "text": "Job 31:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.10"
              },
              "items": [
                {
