              "items": [
                {
                  "text": "Dt 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele kutabi muntu uuzumanana, kutabi muntu uukazyanya, pe, nkaambo bantu bako balikozyene abaabo bazumanana amupaizi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.4"
              },
              "items": [
                {
                  "text": "Jer 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni uyoolifumpula isikati, alakwe musinsimi ngoli awe uyoolifumpula masiku, alimwi banyoko njoobanyonyoona. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bangu bali mukufwa nkaambo kakubula luzibo. Mbuli mbosowede luzibo, ambebo njoosowa nduwe, Utandibedi limbi mupaizi. Mbuli mbolubide mulao wa-Leza wako, ambebo njooluba bana bako. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakatalika kuvula, kababisya kulindime. Bulemu bwabo njoobulobya, bube bweeme. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubisya kwabantu bangu nkulya kwabo; balabika myoyo yabo kumilandu yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bapaizi mbubabede, bantu abalo bayooba mbubonya. Nkabela njoobauma nkaambo kaziyanza zyabo akubaboozezya ncito zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.14"
              },
              "items": [
                {
                  "text": "Mik 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.6"
              },
              "items": [
                {
                  "text": "Hag 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayoolya, nekubaboobo tabakooyookuta. Bayoocita bumambe, nekubaboobo tabakooyoozyala bana. Nkaambo baleka kupangika myoyo yabo kuli-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.7"
              },
              "items": [
                {
                  "text": "Is 28:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bumambe abukoko akukolwa nzezibuzya maanu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.27"
              },
              "items": [
                {
                  "text": "Jer 2:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.20"
              },
              "items": [
                {
                  "text": "Is 44:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.2"
              },
              "items": [
                {
                  "text": "Ciy 17:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu bangu balasonda kucisamu, awalo musako wabo nguubatondezya makani. Nkaambo moyo wabumambe wabaleesya, aboobo baya buvuula cakutalemeka Leza wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.12",
            "verseOrgIds": [
              "HOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.9"
