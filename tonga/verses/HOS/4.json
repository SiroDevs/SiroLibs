                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.14"
              },
              "items": [
                {
                  "text": "8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uwe, O Israyeli, uli sibuvuule. Pele Juda atabisyi. Utasiki kuGiligala, nikuba kwiinka ku-Betaveni, nikuba kukonkezya cakuti, Jehova mbwali muumi, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.15",
            "verseOrgIds": [
              "HOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo Israyeli wazanga mbuli iŋombe sicinguni, Lino sa Jehova ulakonzya kubasanina mbuli kabelele mbukasaninwa mani mpaavula. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.16",
            "verseOrgIds": [
              "HOS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.15.14"
              },
              "items": [
                {
                  "text": "Tus 15:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Efraimu uliswaneene amituni. Amumuleke buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.17",
            "verseOrgIds": [
              "HOS.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamane buyo kukolwa, balaya buvuula. Beendelezi bacisi balayandisya zintu zyabweeme. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.18",
            "verseOrgIds": [
              "HOS.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino muuwo uyoocitola canguzu, nkabela zipaizyo zyabo ziyoobausya bweeme.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.19",
            "verseOrgIds": [
              "HOS.4.19"
            ]
          }
        }
      ]
    }
