            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.21"
              },
              "items": [
                {
                  "text": "Mt 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balalilila ndime, balati, Leza wesu, tulikuzi, iswe tuba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Israyeli wakaka cintu cibotu, nkaambo kako sinkondonyina ulamutanda.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
