                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekuba kuti ndamulembela myaanda yamilao yangu, iliyeeyedwe mbuli cintu ceenzu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.12",
            "verseOrgIds": [
              "HOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupaila balapaila azipaizyo, pele balapaizya nyama akwiilya. Jehova takonzyi kubotelwa kulinzizyo. Lino ulayeeya kubisya kwabo akubabweedezezya bubi bwabo. Bayoopiluka ku-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.13",
            "verseOrgIds": [
              "HOS.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.31"
              },
              "items": [
                {
                  "text": "1 Bam 12:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Israyeli baluba Mulengi wabo, baliyakide maanda aabwami, abalo ba-Juda balivuzizye minzi iizyungulukidwe imbaya. Pele njootuma mulilo kuminzi yabo, elyo maanda aabo aabwami ulaatenta.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.14",
            "verseOrgIds": [
              "HOS.8.14"
            ]
          }
        }
