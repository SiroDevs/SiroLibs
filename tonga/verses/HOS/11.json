        },
        {
          "text": "Takooyoopiluka mucisi ca-Egepita, pe, Asuri uyooba mwami wakwe, nkaambo kakuti bakakaka kuboola. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipanga liyoouma minzi yabo, liyoomanisya kulya mankolo aamilyango yayo, nkaambo kamiyeeyo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
