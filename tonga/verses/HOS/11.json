              },
              "items": [
                {
                  "text": "2 Bam 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele nindakali kuya bubaita, kabaya bwiinka buyo. Kabapaila ba-Baala akutentela zikozyano zibezedwe tununkilizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        },
