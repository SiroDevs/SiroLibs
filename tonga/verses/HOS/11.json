              "attrs": {
                "loc": "ROM.11.19"
              },
              "items": [
                {
                  "text": "Rom 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nsikooyoocita lunyemo lwangu lukali, nsikooyooboola limbi kunyonyoona Efraimu, pe, nkaambo ndime Leza, nsili muntu buyo, ndime Uusalala akati kanu, nsili muntu waansi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova ulalila mbuli syuumbwa, ulavuuluma mbuli mulavu. Lino alila buyo, bana bazooboola bukankama kuzwa kumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazooboola bukankama mbuli tuyuni kuzwa ku-Egepita, bazooboola mbuli inziba kuzwa kucisi ca-Asuri, Njoobakazika mumaanda aabo beni, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
