              "items": [
                {
                  "text": "Int 78:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zyaanzyo nzindakabaanzya zyakali zyabuuya, intambo zyangu zyakali zyaluyando. Ndakali mbuli basikugwisya ijoko kunsingo zyabo, ndakali kubalisya zilyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        },
        {
