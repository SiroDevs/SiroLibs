                "loc": "EXO.15.26"
              },
              "items": [
                {
                  "text": "Kul 15:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo ndime ndakaiisya Efraimu kweenda. Ndakali kubeenzyaenzya mumaanza aangu, pele kabatezi kuti ndime ndakabaponya. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 11:4"
          },
          "items": [
