                  "text": "Mt 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Israyeli naakacili mwana, ndakamuyandisya, ndakaita mwanaangu kuzwa ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
