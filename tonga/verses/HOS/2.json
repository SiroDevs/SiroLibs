              "items": [
                {
                  "text": "Am 8:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi njoolesya kusekelela kwakwe koonse ama pobwe aakwe, mapobwe aamwezi mupya amapobwe aasabata ambungano zyakwe zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.5"
              },
              "items": [
                {
                  "text": "Is 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njoosaala masaansa aakwe amikuyu yakwe, nzenzizyo nzyaamba kuti ncipego cangu ncibandipa basimamambe bangu, Njoocita kuti zibe mbuli lusaka, banyama bamusokwe bazilye. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
