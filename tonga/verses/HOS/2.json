              },
              "items": [
                {
                  "text": "Am 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inga njoomusamununa cacintanda akumubika mbubonya mbwaakabede mubuzuba obo mbwaakazyalwa. Njoomucita mbuli inkanda, akumubika mbuli ibbuwa, akumujazya nyota. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo bana bakwe nsikooyoobafwida luzyalo pe, nkaambo mbana babuvuule. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.17"
              },
              "items": [
                {
                  "text": "Jer 44:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo banyina bakavuula, ayooyo iwakabazyala wakacita cakuusya bweeme. Wakati, Nkayandaule basimamambe bangu bandaabila insima amaanzi aboya bwambelele azisani zituba amafuta azintu zyakunywa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
