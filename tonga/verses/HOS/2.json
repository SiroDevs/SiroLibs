          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.7"
              },
              "items": [
                {
                  "text": "Bab 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.40"
              },
              "items": [
                {
                  "text": "Ezk 23:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoomuboozezya milandu yakwe yamazuba ayo aababaala, naakali kubatentela zinunkilizyo. Wakali kusama bukume abulungu, akuya buyandaula basimamambe bakwe, anukuti mebo wakandiluba, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
