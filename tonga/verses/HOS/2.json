                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oko njoomupa myuunda yakwe yamasaansa, awalo mumpata wa-Akori uyoomubeda mulyango wabulangizi. Uyooimba oko mbubonya mbwaakali kucita kuciindi cabwanike bwakwe amubuzuba obo mbwaakazwa mucisi ca-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
