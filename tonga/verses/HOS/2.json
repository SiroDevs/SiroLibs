              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amubone! Njoomuongelezya akumutola musokwe, nkaambile moyo wakwe majwi mabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
