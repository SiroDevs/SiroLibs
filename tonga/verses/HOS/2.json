            "number": "16",
            "style": "v",
            "sid": "HOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba obo, mbwaamba Jehova, uyoondaamba Mulumaangu, tokooyoondaamba limbi Mwami wangu, pe, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
