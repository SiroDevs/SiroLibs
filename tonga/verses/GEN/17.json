            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.2+JOS.5.3+JOS.5.4+JOS.5.5+JOS.5.6+JOS.5.7"
              },
              "items": [
                {
                  "text": "Jos 5:2-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwaalumi silulomo uutapalwidwe mulukanda lwalulomo lwakwe, oyo muntu uyooandanizigwa abantu bakwe, nkaambo wa mwaya cizuminano cangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
