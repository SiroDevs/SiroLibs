              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Leza wakaambila Abrahamu kuti, Kobamba cizuminano cangu, webo alunyungu lwako luciza mumazyalani aalo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
