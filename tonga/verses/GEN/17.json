              "items": [
                {
                  "text": "Gal 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muleelede kupalulwa mulukanda lwandomo zyanu, Eci ciyooba citondezyo cacizuminano cili akati kesu, mebo anywebo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
