                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino njootanga cizuminano ayebo, nkabela njookuvuzya loko malaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
