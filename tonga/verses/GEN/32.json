              },
              "items": [
                {
                  "text": "Is 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jakobo wakaulika oko kuntu izina lya-Penueli, nkaambo wakati, Ndabona Leza busyu kubusyu, nekubaboobo buumi bwangu mpobucili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino izuba lyakapasula naakazubuka ku-Penueli, nkabela wakali kuya busunkuta nkaambo kacibelo cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nciceeco bana ba-Israyeli ncibatalidi mulambi wakasolo uubambene antelebelo yacibelo mane kusikila sunu, nkaambo kakuti wakaampa intelebelo yacibelo ca-Jakobo kumulambi wakasolo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
