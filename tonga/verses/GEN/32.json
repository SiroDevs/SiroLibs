                "loc": "PRO.15.1"
              },
              "items": [
                {
                  "text": "Tus 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabalailila kuti, Mbuboobu mbumweelede kwaambila Esau simalelaangu. Mbuboobu mbwaamba mulanda wako Jakobo. Ndakakala-kala kuliLabani. Nkondakabede akusikila sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.4",
            "verseOrgIds": [
              "GEN.32.4"
            ]
          }
        },
        {
