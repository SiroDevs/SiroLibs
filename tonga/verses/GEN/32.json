                  "text": "33:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndijisi iŋombe, imbongolo, imbelele, balanda abalanda basimbi. Lino ndatuma kukulwiida mupati wangu kuti nkafwidwe luzyalo kulinguwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
