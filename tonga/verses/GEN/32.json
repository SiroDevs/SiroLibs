                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.34"
              },
              "items": [
                {
                  "text": "2 Bam 17:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakati, Undileke njiinke, nkaambo bwaamba kuca. Pele wakavuwa kuti, Nsikookuleka pe, cita utaangune kundilongezya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamubuzya kuti, Nduweni izina lyako? Wakati, Ndime Jakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        },
        {
