          "text": "Pele webo wakaamba kuti, Ncobeni njookubamba kabotu akuvuzya lunyungu lwako lube mbuli musenga wakunkomwe yalwizi uutabaliki nkaambo kakuvula kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        }
      ]
    },
