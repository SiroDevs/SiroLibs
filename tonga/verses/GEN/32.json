                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jakobo wakayoowa loko akupenga. Nkabela bantu mbaakali abo, ambelele aŋombe ankamele zyoonse, wakababamba mumakoka obile, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        },
        {
