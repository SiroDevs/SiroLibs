                "loc": "MRK.15.37"
              },
              "items": [
                {
                  "text": "Mk 15:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ngooyu mweelwe wamyaka yabuumi bwa-Ismayeli: myaka iili mwanda amakumi otatwe amusanu aibili, Elyo lumwi wakafwa, waya kulibasinsiku bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
