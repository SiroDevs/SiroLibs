              "items": [
                {
                  "text": "50:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Izaka a-Ismayeli bana bakwe bakamuzika musempo lya-Makipela kumuunda wa-Efroni mwana wa-Zohari mu-Hiti uuli kunembo lya-Mamre, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.3+GEN.23.4+GEN.23.5+GEN.23.6+GEN.23.7+GEN.23.8+GEN.23.9+GEN.23.10+GEN.23.11+GEN.23.12+GEN.23.13+GEN.23.14+GEN.23.15+GEN.23.16"
              },
              "items": [
                {
                  "text": "Matl 23:3-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ngonguwo muunda Abrahamu ngwaakaulide kubana ba-Heti, Nkuko Abrahamu nkwaakazikwa a-Sara mukaakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.14"
              },
              "items": [
                {
                  "text": "Matl 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.62"
              },
              "items": [
                {
                  "text": "24:62",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Abrahamu naakamana kufwa, Leza wakalongezya Izaka mwanaakwe, Nkabela Izaka kakede ku-Cikala ca-Lahai-roi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
