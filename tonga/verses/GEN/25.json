              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimwi ciindi Jakobo naakali kujika musinza, Esau wakazwa musokwe, ulikateede. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
