                  "text": "Inc 13:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kumamanino, Abrahamu naakafwa, kali abucekulu bubotu, kacembeede loko, Elyo wakaya kulibasinsiku bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
