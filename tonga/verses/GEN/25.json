                "loc": "GEN.17.20"
              },
              "items": [
                {
                  "text": "Matl 17:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaabo bana ba-Ismayeli. Ngaayo mazina aabo mutunzuunzi twabo amumakalilo aabo, bami bali ikumi ababili muzisi zyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.16",
            "verseOrgIds": [
              "GEN.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.8"
              },
              "items": [
                {
                  "text": "Matl 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.33"
              },
              "items": [
                {
                  "text": "49:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
