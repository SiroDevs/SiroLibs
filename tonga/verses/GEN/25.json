              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mazuba aabuumi bwa-Abrahamu ngaakapona akasika kumyaka iili mwanda amakumi aali musanu aabili amusanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
