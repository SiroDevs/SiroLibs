                  "text": "Heb 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jakobo wakati, Taanguna kukonka. Wakakonka, wauzizya Jakobo bupati bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
