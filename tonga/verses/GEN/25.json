              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Abrahamu wakakwata aumwi mwanakazi, izina lyakwe kali Ketura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.1",
            "verseOrgIds": [
              "GEN.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.32"
              },
              "items": [
                {
                  "text": "1 Mak 1:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakamuzyalila Zimirani, a-Jokisani, a-Medani, a-Midyani, a-Isibaki, a-Sua, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.2",
            "verseOrgIds": [
              "GEN.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Jokisani wakazyala Seba a-Dedani. Abana ba-Dedani mbaaba: ba-Asuri aba-Letusi aba-Leumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.3",
            "verseOrgIds": [
              "GEN.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Midyani mbaaba: Efa a-Eferi a-Hanoki a-Abida a-Elidaa, Aba boonse kabali bana ba-Ketura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.36"
              },
              "items": [
                {
                  "text": "Matl 24:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela zintu zyoonse nzyaakajisi, Abrahamu wakazipa Izaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.14"
              },
              "items": [
                {
                  "text": "Matl 21:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.3"
              },
              "items": [
                {
                  "text": "Bab 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana babasimamambe Abrahamu mbaakajisi, Abrahamu wakabapa zipo akubamwaisya kuzwa kuli-Izaka mwanaakwe naakacili muumi, nkabela bakaya kujwe kunyika yakujwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
