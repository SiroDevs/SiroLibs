              "items": [
                {
                  "text": "1 Sam 15:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.12"
              },
              "items": [
                {
                  "text": "Matl 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakali kukala koonse koonse kuzwa ku-Havila kusikila ku-Suri, kunembo lya-Egepita kulubazu lwakuya ku-Asuri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
