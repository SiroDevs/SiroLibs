            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamuvwiila kuti, Undiletele impwizi iili amyaka yotatwe, impongo iili amyaka yotatwe, mugutu uuli amyaka yotatwe, inziba ankwilimba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakamuletela ezi zyoonse, wazyaandula akati, wabika cipanzi cimwi acimwi kucipanzinyina, pele bayuni takwakabaandula pe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino makubi naakaseluka kuzoolya nyama, Abramu wakaatanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
