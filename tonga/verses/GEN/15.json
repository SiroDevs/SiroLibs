                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wakati, O Mwami Jehova, ndaziba buti kuti njooivuba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
