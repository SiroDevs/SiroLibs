            }
          ]
        },
        {
          "text": "Mpawo ijwi lya-Jehova lyakamusikila, liti, Oyu muntu takooyoolya izina lyako pe, mwanaako uuzyalwa mumaala aako nguuyoolya izina lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
