        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.13"
              },
              "items": [
                {
                  "text": "Inc 7:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakasala bantu hosanwe akati kabakulana bakwe, wabaimikizya kubusyu bwa-Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
