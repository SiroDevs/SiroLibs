          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.33"
              },
              "items": [
                {
                  "text": "Matl 46:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Farao wakabuzya bakulana bakwe kuti, Muli basimilimonzi? Bakavwiila Farao kuti, Swebo tobalanda bako tuli basikweembela imbelele, swebo abamatateesu boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        },
        {
