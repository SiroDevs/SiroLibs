        },
        {
          "text": "Elyo Josefa wakasika kuli-Farao, wamwaambila kuti, Taata abakulana bangu ambelele zyabo aŋombe zyabo ambono zyabo zyoonse basika kuzwa kunyika ya-Kanana. Nkobali kunyika ya-Goseni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
