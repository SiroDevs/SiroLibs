              "items": [
                {
                  "text": "Matl 33:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakati, Watuponya. Atujane buuya mumeso aamwami wesu, lino tuyooba bazike ba-Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
