              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Josefa wakaulila Farao nyika yoonse ya-Egepita, nkaambo baEgepita bakaulisya umwi aumwi muunda wakwe, nkaambo ipamba lyakabakataazya loko, Nyika yakaba ya-Farao, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.20",
            "verseOrgIds": [
              "GEN.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
