                  "text": "Matl 41:56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Josefa wakabungika mali oonse aakajanwa munyika ya-Egepita amunyika ya-Kanana nkaambo kazilyo nzibakali kuula; mali ayo Josefa wakaaleta muŋanda ya-Farao, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.14",
            "verseOrgIds": [
              "GEN.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 47:15"
          },
          "items": [
