          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "abalo bantu wakabanjizya mubuzike kuzwa kumagolelo amwi aa-Egepita kusikila kumagolelo amwi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.21",
            "verseOrgIds": [
              "GEN.47.21"
            ]
