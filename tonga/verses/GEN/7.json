        },
        {
          "text": "Lino Jehova wakaambila Nowa kuti, Njila mubwaato, webo abeŋanda bako boonse, nkaambo nduwe olike ngombwene kuti uliluleme mumeso aangu akati kabasyasunu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.11.1+LEV.11.2+LEV.11.3+LEV.11.4+LEV.11.5+LEV.11.6+LEV.11.7+LEV.11.8+LEV.11.9+LEV.11.10+LEV.11.11+LEV.11.12+LEV.11.13+LEV.11.14+LEV.11.15+LEV.11.16+LEV.11.17+LEV.11.18+LEV.11.19+LEV.11.20+LEV.11.21+LEV.11.22+LEV.11.23+LEV.11.24+LEV.11.25+LEV.11.26+LEV.11.27+LEV.11.28+LEV.11.29+LEV.11.30+LEV.11.31"
              },
              "items": [
                {
                  "text": "Lev 11:1-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tolelela banyama bamisyobo yoonse iisalala, musanu ababili mumusyobo umwi aumwi, beenze abazyazi, Abalo banyama batasalali, tola bobile bobile, beenze abazyazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo bayuni bakujulu, tola musanu ababili mumusyobo umwi aumwi, beenze anseke, kuti ulondole inyungu zyabo ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.22.16"
              },
              "items": [
                {
                  "text": "Job 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "2 Pet 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kwasyaala mazuba aali musanu aabili buyo, lino njoowisya imvula ansi mazuba aali makumi one, isikati amasiku, nkabela njoozizaanya baumi boonse mbendakalenga ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.22"
              },
              "items": [
                {
                  "text": "Matl 6:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.119.6"
              },
              "items": [
                {
                  "text": "Int 119:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Nowa wakacita zyoonse Jehova nzyaakamulailila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        }
