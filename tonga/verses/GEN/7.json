          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa kajisi myaka iili myanda iili musanu aumwi, izambangulwe nilyakasika ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
