        },
        {
          "text": "Mumwaka wamyanda iili musanu aumwi wabuumi bwa-Nowa, mumwezi wabili, mubuzuba bwakumi amusanu aabili bwamumwezi, tusensa toonse twamatoolo twakasinkuka, azyalo zipulo zyakujulu zyakajalulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mucobocobo wakali kuwa ansi mazuba aali makumi one, isikati amasiku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba obo mbubonya Nowa wakanjila mubwaato, walo, a-Semu a-Hamu a-Jafeti bana ba-Nowa, amuka-Nowa, abanakazi botatwe babana bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatolelela banyama bamisyobo yoonse, iŋombe zyamisyobo yoonse amisyobo yoonse yabauka bayavula ansi, amisyobo yoonse yabayuni, atuyuni toonse twamisyobo misyobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonse bakanjila mubwaato kuli-Nowa, bobile bobile bamisyobo yoonse iili abuumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
