                  "text": "Hos 12:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jakobo wakaleta Rakele alakwe muŋanda, nkabela wakali kuyandisya Rakele kwiinda Leya, Elyo wakacili kumubelekela milimo myaka aimwi iili musanu aibili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
