                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jakobo wakaambila Labani kuti, Mazuba aangu amana. Kondipa banangu, mulete muŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.10"
              },
              "items": [
                {
                  "text": "Bab 14:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.1"
              },
              "items": [
                {
                  "text": "Joh 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Labani wakabunganya bantu boonse bakooko, wacita ipobwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi cagoko wakatola mwanaakwe Leya, wamusisya kulinguwe, nkabela wakamunjizya muŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
              "GEN.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nkabela Labani wakapa mwanaakwe Leya mulanda wakwe musimbi Zilipa kuti abe mulanda wakwe.) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.24",
            "verseOrgIds": [
              "GEN.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibwakaca, wakabona kuti ngu-Leya. Mpawo wakaambila Labani kuti, Ninzi eci ncowandicitila? Sa teensi Rakele ngundakabelekela kulinduwe? Ino wandeenenanzi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wakati, Okuno kulindiswe tacicitwi obo. Mwanike teelede kukwatwa na mupati katana kukwatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.26",
            "verseOrgIds": [
              "GEN.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.12"
              },
              "items": [
                {
                  "text": "Bab 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Manisya imviki yamweenzinyina alakwe. Tuyookupa alakwe na wandimanina milimo myaka aimwi iili musanu aibili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jakobo wakacita obo, Wakamanisya imviki yamweenzinyina, nkabela Labani wakamupa mwanaakwe Rakele kuti amukwate alakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nkabela Labani wakapa mwanaakwe Rakele mulanda wakwe musimbi Biliha kuti abe mulanda wakwe.) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
            "verseOrgIds": [
              "GEN.29.29"
            ]
          }
        },
