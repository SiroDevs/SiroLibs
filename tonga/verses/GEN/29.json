              "items": [
                {
                  "text": "Matl 30:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova naakabona kuti Leya ulisulidwe, wakajula izyalilo lyakwe, pele Rakele kali musundi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
