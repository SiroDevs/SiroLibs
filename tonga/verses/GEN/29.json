                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Leya wakaminta, wazyala mwana mulombe, wamuulika izina lya-Rubeni, nkaambo wakati, Jehova ulibwene mapenzi aangu; ncobeni mulumaangu ulandiyanda lino. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakaminta alimwi, wazyala mwana mulombe, wati, Jehova ulimvwide kuti ndisulidwe, aboobo wandipa mwana oyu alakwe, Wakamuulika izina lyaSimeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakaminta alimwi, wazyala mwana mulombe, wati, Lino ncobeni mulumaangu ulandinamatila, nkaambo ndamuzyalila bana balombe botatwe. Aboobo wakamuulika izina lya-Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakaminta alimwi, wazyala mwana mulombe, wati, Lino ndatembaula Jehova. Aboobo wakamuulika izina lya-Juda. Elyo wakaleka kuzyala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
