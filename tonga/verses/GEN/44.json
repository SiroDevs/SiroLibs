              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.15"
              },
              "items": [
                {
                  "text": "1 Kor 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.17"
              },
              "items": [
                {
                  "text": "Gal 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wakati, Nee! Kulindime cilatondwa kucita obo, Muntu wajanwa kuti uli ankomeki mujanza lyakwe, ngonguwe alike uuelede kuba muzike wangu. Pele inywe nobamwi kamuya aluumuno kuli usowanu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
              "GEN.44.17"
            ]
          }
        }
      ]
    },
