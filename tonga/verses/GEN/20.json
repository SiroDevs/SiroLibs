              "items": [
                {
                  "text": "Tus 16:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Abrahamu wakamuvwiila kuti, Ndakacita obo nkaambo kakuti ndakali kuyeeya kuti, Ncobeni banti bakookuno tabayoowi Leza, balandijaya nkaambo kamukaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.11",
            "verseOrgIds": [
              "GEN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 20:12"
          },
          "items": [
