              "attrs": {
                "loc": "1SA.25.26"
              },
              "items": [
                {
                  "text": "1 Sam 25:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leza wakamwaambila muciloto kuti, Ambebo ndakaziba kuti wacicita amoyo uululeme. Nkaambo kako ndakakukasya kubisya kulindime, teendakakuzumizya kumuguma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.6",
            "verseOrgIds": [
              "GEN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
