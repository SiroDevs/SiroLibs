                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Abrahamu wakaamba aa-Sara mukaakwe kuti, Ngumucizi wangu, Mpawo Abimeleki mwami wa-Gerari wakatuma batumwa, watola Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        },
        {
