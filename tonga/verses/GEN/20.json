              "items": [
                {
                  "text": "Matl 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abimeleki wakabweza imbelele aŋombe abalanda balombe abasimbi, wapa Abrahamu, alimwi wakamubweedezya Sara mwanakazi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
            "verseOrgIds": [
              "GEN.20.14"
            ]
          }
        },
        {
