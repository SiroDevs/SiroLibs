              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibwakaca, Abimeleki wakafuma, waita balanda bakwe boonse, wabalwiida makani aya oonse. Nkabela bantu bakayoowa loko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.8",
            "verseOrgIds": [
              "GEN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
