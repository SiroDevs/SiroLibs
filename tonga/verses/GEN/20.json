                  "text": "47:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Abimeleki wakati, Bona! Nyika yangu ili kubusyu bwako, Kala kufumbwa kukubotela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
