            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.29"
              },
              "items": [
                {
                  "text": "Matl 11:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ngumucizi wangu ncobeni, nkaambo ngumwana wataata nekuba kuti tali mwana wabama, nkabela ndakamukwata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.12",
            "verseOrgIds": [
              "GEN.20.12"
            ]
          }
        },
