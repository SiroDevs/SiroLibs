                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Joh 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bweedezezya muntu mwanakazi wakwe, nkaambo mulunguzi, Uyookukombela, aboobo uyoopona. Pele na wakaka kumubweedezya, zibisya kuti ncobeni ulafwa, webo aboonse mboli abo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.7",
            "verseOrgIds": [
              "GEN.20.7"
            ]
