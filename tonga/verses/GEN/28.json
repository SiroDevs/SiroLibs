        {
          "text": "Akupe lulongezyo lwa-Abrahamu, webo alunyungu lwako, ukavube nyika yabusimutuntuli bwako, Leza njaakapa Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo Izaka mbwaakatuma Jakobo, nkabela wakainka ku-Padanaramu, kuli-Labani mwana wa-Betueli mu-Aramu, mukulana wa-Rebeka banyina Jakobo a-Esau,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
