        {
          "text": "Mpoonya awo Izaka wakaita Jakobo, wamulongezya, wamulailila kuti, Toelede kukwata mwanakazi wabana ba-Kanana pe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
