              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Esau wakabona Izaka mbwaakalongezya Jakobo akumutuma kuPadanaramu kuti akwate mwanakazi wakooko, ambwaakamulailila mukulongezya kwakwe kuti, Toelede kukwata mwanakazi wabana basimbi ba-Kanana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakwe Jakobo mbwaakaswiilila wisi abanyina akwiinka ku-Padanaramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
