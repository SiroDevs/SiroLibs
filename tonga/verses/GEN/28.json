              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asike kubusena bumwi, wakalala nkuko, nkaambo izuba lyakamubbilila. Nkabela wakabweza limwi lyamabwe aakooko, walisegezya kumutwe wakwe, woona nkukonya oko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
