              "items": [
                {
                  "text": "Matl 24:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Esau naakabona kuti bana basimbi ba-Kanana mbabi mumeso aa-Izaka wisi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
