                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabe kaindi, sikukutaukila mwami wa-Egepita amujiki wakwe bakabisizya simalelaabo mwami wa-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.14"
              },
              "items": [
                {
                  "text": "Tus 16:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Farao wakakalalila abo balanda bakwe bobile, simutwe wabakutausi asimutwe wabajisi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.2",
            "verseOrgIds": [
              "GEN.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.20"
              },
              "items": [
                {
                  "text": "Matl 39:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wabaanga muŋanda yamulangi wabatabilizi, muntolongo Josefa mwaakaangilidwe­. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.3",
            "verseOrgIds": [
              "GEN.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mulangi wabatabilizi wakababika mumaanza aa-Josefa, kuti abakutaukile, nkabela bakakala mazuba manji muntolongo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo oyo sikukutaukila mwami wa-Egepita amujisi wakwe bakaleta ziloto. Boonse bobile bakalota, umwi aumwi ciloto cakwe, mubusiku bomwe. Ciloto cimwi acimwi kacijisi kupandulula kwaco. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.5",
            "verseOrgIds": [
              "GEN.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nebwakaca Josefa wakeza kulimbabo, wajana kuti baluusene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.6",
            "verseOrgIds": [
              "GEN.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakabuzya abo basilutwe ba-Farao mbaakali abo balaangidwe muŋanda yasimalelaakwe kuti, Nkaambonzi masyu aanu abija sunu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.7",
            "verseOrgIds": [
              "GEN.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.15"
              },
              "items": [
                {
                  "text": "Matl 41:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.11"
              },
              "items": [
                {
                  "text": "Dan 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakamuvwiila kuti, Twalota ziloto, alimwi taakwe uukonzya kuzipandulula. Josefa wakabaambila kuti, Sa teensi Leza uukonzya kupandulula! Amundilwiide.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo silutwe wabakutausi wakalwiida Josefa ciloto cakwe. Wakati, Muciloto cangu ndakabona musaansa kunembo lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.9",
            "verseOrgIds": [
              "GEN.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumusaansa kamuli mitabi yotatwe, Usyuuke biyo, wafulula malubaluba, elyo masankinya aamasaansa akabizwa ndilyonya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.10",
            "verseOrgIds": [
              "GEN.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi inkomeki ya-Farao yakali mujanza lyangu, nkabela ndakacela masaansa, ndakasinina munkomeki ya-Farao, ndapa mujanza lya-Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.11",
            "verseOrgIds": [
              "GEN.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.14"
              },
              "items": [
                {
                  "text": "Bab 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.36"
              },
              "items": [
                {
                  "text": "Dan 2:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.19"
              },
              "items": [
                {
                  "text": "4:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Josefa wakamwaambila kuti, Mbuboobo mbocipandululwa. Mitabi yotatwe nkokuti mazuba otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.3.3"
              },
              "items": [
                {
                  "text": "Int 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.31"
              },
              "items": [
                {
                  "text": "Jer 52:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amana mazuba otatwe Farao uyoobusya mutwe wako akukuboozya kumilimo yako, nkabela uyoopa inkomeki mujanza lyakwe mbubonya mbowakali kucita lyoonse nowakacili mukutausi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.42"
              },
              "items": [
                {
                  "text": "Lk 23:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.12"
              },
              "items": [
                {
                  "text": "Jos 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.20.14"
              },
              "items": [
                {
                  "text": "1 Sam 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.7"
              },
              "items": [
                {
                  "text": "1 Bam 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kwabota kulinguwe, wence kondiyeeya mebo akundifwida luzyalo, ukaambe makani aangu mumatwi aa-Farao akundigwisya omuno muŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.20"
              },
              "items": [
                {
                  "text": "Matl 39:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ncobeni ndakabbigwa munyika yaba-Hebrayo, alimwi okuno taakwe ncendakabisya kuti bandi bike muntolongo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
