                  "text": "Jak 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Banyama boonse baansi abayuni boonse bakujulu bamuyoowe akukankama kubusyu bwanu. Boonse biyo, abauka bayavula ansi answi zyamulwizi, baabwa mumaanza aanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
