              "items": [
                {
                  "text": "14:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baumi boonse bayavula ansi bayoomubeda zilyo, mbubonya mbuli zisyu zisia-sia. Zyoonse biyo ndamupa nzizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
