                "loc": "2PE.3.5"
              },
              "items": [
                {
                  "text": "2 Pet 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njootangana anywe cizuminano, nkabela bantu boonse tabakooyoonyonyoonwa limbi mumaanzi aazambangulwe. Takukooyooba limbi izambangulwe lyakuvwinyauna nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.26+MAT.26.27+MAT.26.28"
              },
              "items": [
                {
                  "text": "Mt 26:26-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Leza wakaamba kuti, Nceeci citondezyo cacizuminano cangu ncitutangene anywe, inywe abaumi boonse mbomuli abo mumazyalani oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabika fulicoongo wangu mujoba, abe citondezyo cacizuminano cangu ncitutangene anyika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyooba kuti, na ndabusya ijoba ajulu lyanyika, fulicoongo wangu uyooboneka mujoba, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
