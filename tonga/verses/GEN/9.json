        },
        {
          "text": "Lino Leza wakalongezya Nowa abana bakwe, wabaambila kuti, Amuzyalisye, muvule, muzuzye nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
