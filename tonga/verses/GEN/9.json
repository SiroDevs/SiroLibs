              },
              "items": [
                {
                  "text": "Matl 8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abanyama boonse mbomuli abo, bayuni bakujulu abanyama baansi aboonse mbomuli abo mubwaato, banyama boonse biyo baansi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
