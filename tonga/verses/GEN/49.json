              },
              "items": [
                {
                  "text": "35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkukonya oko nkobakavwikila Abrahamu a-Sara mukaakwe; nkukonya oko nkubakavwikila Izaka a-Rebeka mwanakazi wakwe; alimwi nkukonya oko nkondakavwikila Leya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muunda asempo lili mulinguwo, zyoonse zyakaulwa kuba-Hiti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jakobo, naakamana kulaya bana bakwe, wakaboozya zituta zyakwe abulo, wazanga, wainka kulibasinsiku bakwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
