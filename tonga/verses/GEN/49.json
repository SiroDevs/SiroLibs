                  "text": "Matl 23:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "musempo lyamumuunda waku-Makipela kunembo lya-Mamre munyika ya-Kanana. Ndendilyo Abrahamu ndyaakaula antoomwe amuunda kuli-Efroni mu-Hiti, kuti alivube, libe mavwikilo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
