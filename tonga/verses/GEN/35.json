                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jakobo wakasika ku-Luzi (ngonguwo Beteli) munyika ya-Kanana, walo abantu boonse mbaakali abo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
