          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba-Rakele mbaaba: Josefa a-Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        },
