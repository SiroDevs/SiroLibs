              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba-Zilipa mulanda musimbi wa-Leya mbaaba: Gadi a-Aseri, Mbaabo bana ba-Jakobo mbaakazyala ku-Padanaramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
