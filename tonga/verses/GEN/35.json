              "items": [
                {
                  "text": "Kul 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana ba-Leya mbaaba: Rubeni (mwana mutaanzi wa-Jakobo), a-Simeoni, a-Levi, a-Juda, a-Isakara a-Zebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
