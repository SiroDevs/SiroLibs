                }
              ]
            }
          ]
        },
        {
          "text": "Lino Debora muleli wa-Rebeka wakafwa, nkabela wakazikwa kunsi lyamubanga oko ku-Beteli, aboobo oyo musamu wakaulikwa izina lya-Aloni-Bakuti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
