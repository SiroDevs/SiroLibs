                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jakobo wakaimika malende, nkokuti malende aamabwe, nkukonya oko nkwaakaambaula awe, Nkabela wakatila cipaizyo cakunywa alingawo, alimwi wakatila insazi yamafuta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
