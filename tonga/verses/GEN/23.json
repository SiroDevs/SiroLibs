        {
          "text": "Lino Sara wakapona myaka iili mwanda amakumi obile amusanu aibili. Mbuyakabede myaka yabuumi bwa-Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
            "verseOrgIds": [
