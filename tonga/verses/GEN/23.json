                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobo muunda wa-Efroni waku-Makipela kunembo lya-Mamre, nkukuti muunda nkulibede isempo, azisamu zyoonse zyamumuunda anyika yoonse iiengelede, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbuwakaba civubo ca-Abrahamu mumeso aabana boonse ba-Heti aboonse ibakali kunjila mumulyango wamunzi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
