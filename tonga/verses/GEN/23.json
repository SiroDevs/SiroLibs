                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndi mweenzu asikukalakala buyo akati kanu. Amundipe mavwikilo akati kanu, nkaavube, nkazike mufu wangu kuzwa kumeso aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bana ba-heti bakavwiila Abrahamu kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.5",
            "verseOrgIds": [
              "GEN.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.2"
              },
              "items": [
                {
                  "text": "Matl 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.14"
              },
              "items": [
                {
                  "text": "14:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utuswiilile, mwami. Uli silutwe mupati akati kesu. Kozika mufu wako kufumbwa nkosala mumavwikilo esu mabotu. Taakwe muntu naba omwe akati kesu uukonzya kukukasya mavwikilo aakwe kuti uzike mufu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.6",
            "verseOrgIds": [
              "GEN.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.7"
              },
              "items": [
                {
                  "text": "Rom 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abrahamu wakabuka, wakotamina bantu banyika, bana ba-Heti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.7",
            "verseOrgIds": [
              "GEN.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakabaambila kuti, Na ncobeni mwazumina kuti nzike mufu wangu, amundiswiilile. Amundikumbilile kuli-Efroni mwana wa-Zohari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.8",
            "verseOrgIds": [
              "GEN.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti andipe isempo lya-Makipela ndyajisi, lili kumagolelo aamuunda wakwe. Anduuzizye muulo uuzwide kumeso aanu, kuti nkalivube, libe mavwikilo aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.9",
            "verseOrgIds": [
              "GEN.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.20"
              },
              "items": [
                {
                  "text": "Matl 34:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.4"
              },
              "items": [
                {
                  "text": "Rut 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Efroni kakede akati kabana ba-Heti. Nkabela Efroni mu-Hiti wakavwiila Abrahamu mumatwi aabana ba-Heti, mumatwi aaboonse ibakanjila mumulyango wamunzi, wati, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.10",
            "verseOrgIds": [
              "GEN.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.20+2SA.24.21+2SA.24.22+2SA.24.23+2SA.24.24"
              },
              "items": [
                {
                  "text": "2 Sam 24:20-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pe, mwami. Amundiswiilile. Ndakupa muunda, alyalo isempo lili mulinguwo. Zyoonse buyo ndakupa okuno kumeso aabantu bangu, kuti uzike mufu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Abrahamu wakakotamina bantu banyika, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.12",
            "verseOrgIds": [
              "GEN.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.5+PHP.4.6+PHP.4.7+PHP.4.8"
              },
              "items": [
                {
                  "text": "Flp 4:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkabela wakaambila Efroni mumatwi aabantu banyika kuti, Wence undiswiilile, Ndakupa mali aamuunda. Tambula kuzwa kumaanza aangu, kuti nzike mufu wangu nkukonya oko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Efroni wakavwiila Abrahamu kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.14",
            "verseOrgIds": [
              "GEN.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.13"
              },
              "items": [
                {
                  "text": "Kul 30:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.12"
              },
              "items": [
                {
                  "text": "Ezk 45:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Swiilila, mwami, nyika yamasyekeli aansiliva aali myanda yone, ncecinzi akati kangu ayebo? Kozika mufu wako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.15",
            "verseOrgIds": [
              "GEN.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.9+JER.32.10+JER.32.11+JER.32.12"
              },
              "items": [
                {
                  "text": "Jer 32:9-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Abrahamu wakaswiilila Efroni, nkabela Abrahamu wakapimina Efroni bulemu bwamali aansiliva mbubonya mbwaakaamba mumatwi aabana ba-Heti, nkukuti masyekeli aansiliva aali myanda yone, mbubakali kupima basambazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        }
      ]
    },
