                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Sara waka­ fwa mu-Kiriyati-ariba (ngonguwo Hebroni) munyika ya-Kanana, nkabela Abrahamu wakanjila kukulila Sara akoomoka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        },
        {
