          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amane kuzyala Sela, Arifakisadi wakapona myaka iili myanda yone aitatu, alimwi wakazyala bana balombe abasimbi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
