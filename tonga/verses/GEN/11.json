                "loc": "DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bantu nebakali kuya kujwe bakajana ibanda munyika ya-Sinara, baakukala nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.2",
            "verseOrgIds": [
              "GEN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakaamba umwi aumwi kumweenzinyina kuti, Amuboole, tubumbe zitina, tuzitente kabotu. Aboobo zitina zyakababeda mabwe, amulambo wakababeda ciyosyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.3",
            "verseOrgIds": [
              "GEN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 11:4"
          },
          "items": [
