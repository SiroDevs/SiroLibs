                  "text": "Lk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jehova wakabamwaisya nkukonya oko, koonse koonse ansi, aboobo bakaleka kuyaka munzi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
