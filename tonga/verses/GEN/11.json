              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Arifakisadi naakajisi myaka iili makumi otatwe amusanu, wakazyala Sela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
