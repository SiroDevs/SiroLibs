              "items": [
                {
                  "text": "Lk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi bakati, Amuboole, tuliyakile munzi aŋanda indamfu jisika akujulu, Atulicitile impuwo, kuti tutapalanganisigwi koonse koonse ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.4",
            "verseOrgIds": [
              "GEN.11.4"
            ]
          }
        },
        {
