          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela naakamana kuzyala Arifakisadi, Semu kacipona myaka iili myanda yosanwe, alimwi wakazyala bana balombe abasimbi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
