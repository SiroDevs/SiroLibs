            }
          ]
        },
        {
          "text": "Atweende, tuseluke, tupilinganye mwaambo wabo, kuti batateelezyanyi nekuba kumvwa mwaambo umwi aumwi wamweenzinyina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.7",
