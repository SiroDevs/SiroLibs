                  "text": "53:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakaseluka kuzoobona munzi aŋanda indamfu bana ba-Adamu njibakali kuyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
