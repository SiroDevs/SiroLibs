        },
        {
          "text": "Ngaaya mazyalani aa-Semu. Semu naakajisi myaka iili mwanda, wakazyala Arifakisadi, myaka yobile kusule lyazambangulwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
