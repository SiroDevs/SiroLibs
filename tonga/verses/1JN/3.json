        },
        {
          "text": "Nobayandwa, lino tuli bana ba-Leza, alimwi takuna kuyubununwa mbutuzooba, pele tulizi kuti nazoolibonya tuzooba mbuli nguwe, nkaambo tuzoomubona mbuli mbwabede. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.2",
            "verseOrgIds": [
              "1JN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela muntu woonse uujisi lusyomo olu mumoyo wakwe ulalisalazya mbubonya mbuli mbwasalala alakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.23"
              },
              "items": [
                {
                  "text": "Mt 7:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi aumwi uucita zibi ulasotoka mulao, nkaambo zibi nkokusotoka mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.4",
            "verseOrgIds": [
              "1JN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.29"
              },
              "items": [
                {
                  "text": "Joh 1:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.4"
              },
              "items": [
                {
                  "text": "Is 53:4",
                  "type": "text"
                }
              ]
