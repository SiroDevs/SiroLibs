                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nobana bangu, luyando lwesu lutabi lwamajwi buyo niluba lwalulumi, lube lwamulimo alwalusinizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
