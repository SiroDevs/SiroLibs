              "items": [
                {
                  "text": "1 Joh 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tulizi kuti twakainda kuzwa kulufu akunjila mubuumi, nkaambo tulayanda beenzuma. Umwi aumwi uutayandi mweenzinyina ulakalilila mulufu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
