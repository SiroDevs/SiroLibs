                }
              ]
            }
          ]
        },
        {
          "text": "Mutagambi, nobakwesu, kuti nyika yamusulaika. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
