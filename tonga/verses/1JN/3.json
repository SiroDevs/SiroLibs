          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbutuzi kuti tuli basilusinizyo, alimwi tuzoorontozya myoyo yesu kunembo lyakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.19",
