              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufumbwa kumakani ngiitupa mulandu myoyo yesu. Nkaambo Leza mupati kwiinda myoyo yesu, alimwi ulizi zintu zyoonse. ",
          "type": "text",
          "attrs": {
