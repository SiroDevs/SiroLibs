                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa muntu uusula mweenzinyina, mujayi, alimwi mulizi kuti taakwe mujayi uujisi buumi butamani mulinguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.15",
