                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Heb 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno kumakani aya ngotwali kukanana, mutwe wamakani ngooyu. Tulijisi mupaizi mupati uuli bobuya, uukede kululyo lwacuuno ca­-Bupati bwa-Leza kujulu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngonguwe uubeleka mulimo uusalala wakucikombelo cinicini. Eco cikombelo cakayakwa a-Jehova, teecakayakwa kumaanza aabantu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eno bapaizi bapati boonse mbobasalwa kuti batuule budumbu azipaizyo, awalo Mupaizi Mupati oyu uleelede kuba acintu cakutuula. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti naali kucili ansi, natacili mupaizi pe, nkaambo mpobali abo batuula budumbu bulaililwa mu-Mulao. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.40"
              },
              "items": [
                {
                  "text": "Kul 25:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.17"
              },
              "items": [
                {
                  "text": "Kol 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Milimo njibamana ncecikozyano citondezya mbuzibede zintu zyakujulu, mbubonya mbwaakalaililwa Musa kuli-Leza, naakaamba kuyaka cikombelo, nkaambo wakaambilwa kuti, Konga kocita zintu zyoonse kuti zibe mbubonya mbuli eeciya ncowakatondezegwa adundu). ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.22"
              },
              "items": [
                {
                  "text": "Heb 7:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.24"
              },
              "items": [
                {
                  "text": "12:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.6"
              },
              "items": [
                {
                  "text": "2 Kor 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele eno ncobeni mulimo ngwaajana Kristo ngomulimo mupati winiwini, nkaambo ngowaba sikwiimaakati wa-Mulongo uuinda kubota, uwakalengwa azisyomezyo ziinda kubota. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kuti oyo Mulongo wakusaanguna nowatali kujisi kampenda nokutakwe kaambo kakulenga yooyu uwabili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
