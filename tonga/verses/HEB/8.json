              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eno mbwaakabeena kampenda wakabaambila kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
