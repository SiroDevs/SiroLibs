        {
          "text": "Eno obo Leza mbwaakamubonzezya zintu zyoonse, takukwe ancaakaleka kuti citamubombeli pe, Nokuboobo tatuna kubona kuti zintu zyoonse zya mu bombela mane ambuli sunu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.8",
            "verseOrgIds": [
              "HEB.2.8"
            ]
