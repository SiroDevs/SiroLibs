                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anu oyo uwakacesegwa-cesegwa kwiinda baangelo nkaambo kakupenga lufu, ngu-Jesu, twamubona ulisamide musini wabulemu awabwami, kuti kuluzyalo lwa-Leza akamvwide bantu boonse lufu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.9",
            "verseOrgIds": [
              "HEB.2.9"
            ]
          }
        },
        {
