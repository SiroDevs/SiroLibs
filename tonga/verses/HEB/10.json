                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobeenzuma, eno buya mbotujisi kulitakata kwakunjila mu-Busena Busalala Bwini nkaambo kabulowa bwa-Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.8"
              },
              "items": [
                {
                  "text": "Heb 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kunzila impya iili abuumi njaakatusaangunina mucisitilizyo (nkokuti munyama yamubili wakwe), ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
