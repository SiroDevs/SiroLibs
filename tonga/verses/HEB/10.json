              },
              "items": [
                {
                  "text": "Heb 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tutanoonga katuleka kulibunga-bunga, mbuli bamwi mbubaleka, anu kamucenjezyanya twaambo, kamucita obuya lyoonse mbomukubwene kuti buzuba bwa-Kristo buli afwaafwi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
