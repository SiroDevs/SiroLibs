                "loc": "EPH.5.26"
              },
              "items": [
                {
                  "text": "Ef 5:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "atuswene afwaafwi amoyo winiwini mukusyoma kutakwe kampenda, ayalo myoyo yesu kiisansailidwe kusalala kwakuziba zibi, ayalo mibili yesu kiisambide amaanzi aanjoloma, sa ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Heb 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi atujatisye buzumino bwa bulangizi bwesu, kuti kutabi notuzungaana, nkaambo walo oyo uwakasyomezya ulisyomekede. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.1"
              },
              "items": [
                {
                  "text": "Heb 13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Katunga katuyeeyana, kutubusyanya-busyanya mukuyandana akucita milimo mibotu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
