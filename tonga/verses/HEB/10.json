              "items": [
                {
                  "text": "My 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alimwi obuya mbotujisi Mupaizi Mupati uujisi bwami bwaŋanda ya-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
