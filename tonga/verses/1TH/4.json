              "items": [
                {
                  "text": "1 Pet 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cintu ncayanda Leza nceeci, ncakuti musalale, mulilesye kubwaamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
