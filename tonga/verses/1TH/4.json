                "loc": "1CO.6.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi aumwi akati kanu uleelede kuziba kuba amwanakazi wakwe mwini cakusalala acakulemeka, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
