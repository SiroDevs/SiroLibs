                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Teensi busofwaazi mbwaakatwiitila Leza, pe, nkukusalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
