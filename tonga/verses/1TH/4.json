              "attrs": {
                "loc": "PSA.79.6"
              },
              "items": [
                {
                  "text": "Int 79:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Teelede kumvwa zisusi zibi mbuli mbobacita bamasi abatamuzi Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
