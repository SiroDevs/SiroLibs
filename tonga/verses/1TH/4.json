          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.2"
              },
              "items": [
                {
                  "text": "Int 94:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Teelede kusotoka nanka kweemuzya kumweenzinyina kumakani aya, nkaambo Leza nguubweedezya kumakani aya oonse, mbubonya mbotwakamwaambila kale akumulungulwida. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
