        },
        {
          "text": "Lino bakwesu, mwakamvwa kale kulindiswe mbumweelede kweenda kukubotezya Leza, nkabela muleenda obo ncobeni, aboobo sunu tulamukumbila akumukombelezya mu-Mwami Jesu kuti kamuciya bweendesya munzila eyo njiyonya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulizi milazyo njotwakamupa iizwa kuMwami Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
