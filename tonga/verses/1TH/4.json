                  "text": "37:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako oyo uunenya kumakani aya tanenyi muntu buyo, ulanenya Leza uumupa Muuya wakwe Uusalala.",
          "type": "text",
          "attrs": {
