          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino tuyoolumba buti kuli-Leza aandinywe acoolwe coonse ncotubotelwa nkaambo kanu kubusyu bwa-Leza wesu? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulakombesya lyoonse, isikati amasiku, kuti tukabonane ameso, nkalulamike cibula kulusyomo lwanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.16"
              },
              "items": [
                {
                  "text": "2 Tes 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leza Taateesu mwini a-Mwami wesu Jesu batululamike munzila yakuza kulindinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.11",
            "verseOrgIds": [
              "1TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami amuvuzizye akumufwasusya luyando lwakuyandana alwakuyanda bantu boonse, mbubonya mbuli luyando lwesu ndotuyandisya ndinywe, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.12",
            "verseOrgIds": [
              "1TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 3:13"
          },
          "items": [
