              ]
            }
          ]
        },
        {
          "text": "Lino nitwakakacilwa kucilemenwa obo, twakati ncibotu notusiigwa tulike ku-Atene, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
