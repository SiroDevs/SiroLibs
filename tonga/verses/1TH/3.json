                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "twakatuma Timoteo mukwesu, similimo wa-Leza wamu­ Makani Mabotu aa-Kristo, kuti azoomuyumye akumukombelezya mumakani aalusyomo lwanu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
