              "items": [
                {
                  "text": "2 Tes 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti kutabi uuzungaanizigwa kumapenzi aya. Nkaambo mulizi nobeni kuti twakabikilwa nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
