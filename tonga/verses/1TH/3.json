        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.4"
              },
              "items": [
                {
                  "text": "2 Tes 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sunu, bakwesu, tuliyumizidwe anguzu mubuusu bwesu amukupenga kwesu nkaambo kalusyomo lwanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulapona ncobeni mbotwamvwa kuti muliimvwi nji mu-Mwami.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        }
      ]
    },
