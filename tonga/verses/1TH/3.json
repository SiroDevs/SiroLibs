              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Timoteo naakapiluka kulindiswe, wakatuletela makani mabotu aalusyomo lwanu aluyando lwanu, wakatwaambila kuti mulatuyeeya lyoonse, alimwi mulayandisya kutubona mbuli mbotuyandisya kumubona aswebo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
