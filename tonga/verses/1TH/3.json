            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "Inc 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni notwakali anywe twakamwaambila kuti tuleelede kuba amapenzi, nkabela kwaba boobo, mbomuziba. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
