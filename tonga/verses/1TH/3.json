              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.16"
              },
              "items": [
                {
                  "text": "Flp 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako mebo nendakakacilwa kucilemenwa obo, ndakatumina kuziba lusyomo lwanu, antela sikutepaula ulimutepawide, aboobo milimo yesu yaba yabuyo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
