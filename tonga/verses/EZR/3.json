        },
        {
          "text": "Bakaimika cipaililo aziimikilo zyaco, nkaambo bakali kuyoowa bantu bamasi, elyo bakatuulila Jehova zipaizyo alincico, zipaizyo zyacifumo azyamangolezya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
