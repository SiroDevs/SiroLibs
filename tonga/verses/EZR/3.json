          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "aboobo bantu teebakakonzya kupambukanya ijwi lyakoompolola kwakukondwa ajwi lyakulila kwabantu, nkaambo bantu bakoompolola aloompololo lupati, mane ijwi lyakamvwigwa kule loko.",
          "type": "text",
