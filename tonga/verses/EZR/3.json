                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo kusule lyayaaya bakali kutuula zipaizyo lyoonse, zipaizyo zyamwezi mupya azyamapobwe aasalazidwe aa-Jehova, azipaizyo zyamoyo bantu boonse nizibakaletela Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
