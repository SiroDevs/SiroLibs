          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba butaanzi bwamwezi wamusanu aibili bakatalika kutuulila Jehova zipaizyo, pele intalisyo yantempele ya-Jehova teeyakayakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
