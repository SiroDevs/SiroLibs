                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo bapati banzubo zya-Juda azya-Benjamini abapaizi abaLevi bakabuka, boonse Leza mbaakabusya myoyo yabo, kuti baye kukuyaka iŋanda ya-Jehova mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboonse ibakeengelede bakayumya maanza aabo, babapa zibelesyo zyansiliva azyangolida, ambono aŋombe azintu ziyandisi, kutaamba zipo zyamoyo izyakaletwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
