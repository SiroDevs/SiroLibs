        },
        {
          "text": "Alakwe mwami Koresi wakagwisya zibelesyo zyaŋanda ya-Jehova, nzyaakagwisya Nebukadinezara kuzwa ku-Jerusalemu nzyaakabika muŋanda yamuzimu wakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
