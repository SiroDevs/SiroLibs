                  "text": "Is 44:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Koresi mwami wa-Persia. Zisi zyoonse zyaansi, Jehova Leza wakujulu wazyaaba mumaanza aangu. Alimwi wandilailila kumuyakila iŋanda mu-Jerusalemu mucisi ca-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
