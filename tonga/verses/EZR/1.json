                {
                  "text": "Ezr 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Hag 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Koresi mwami wa-Persia wakazigwisya kujanza lyaMiteridati siziyobwedo, wazibala, wapa Sezibazara silutwe waba-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngooyu mweelwe wazyo: mitiba yangolida iili makumi otatwe, mitiba yansiliva iili cuulu, intibba zili makumi obile amusanu azine, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "inkomeki zyangolida zili makumi otatwe, inkomeki zyansiliva zyamusyobo umbi zili myanda yone akumi, azibelesyo zimwi zili cuulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zibelesyo zyoonse, zyangolida azyansiliva, zyakali zyuulu zyosanwe amyanda yone. Ezi zyoonse Sezibazara wakeza azyo naakeza abazike baangulwidwe ibakazwa ku-Babuloni kuya ku-Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
