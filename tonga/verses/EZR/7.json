        },
        {
          "text": "Alimwi kwakainka bamwi bana ba-Israyeli abapaizi aba-Levi abasikwiimba abasimilyango aba-Netinimu, baya ku-Jerusalemu mumwaka wamusanu aibili wabwami bwa-Aritasasta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakasika ku-Jerusalemu mumwezi wasanu wamumwaka wamusanu aibili wamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
