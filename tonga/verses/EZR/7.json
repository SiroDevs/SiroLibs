          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalailila kuti boonse bantu ba-Israyeli, abapaizi bakwe, aba-Levi bakwe, bajanwa mubwami bwangu, bayanda mumyoyo yabo kuya ku-Jerusalemu, bakusindikile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
