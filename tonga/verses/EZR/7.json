                  "text": "Neh 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo wakanyamuka kuzwa ku-Babuloni mubuzuba butaanzi bwamwezi mutaanzi, elyo mubuzuba butaanzi bwamwezi wasanu wakasika ku-Jerusalemu, mbwaakagwasigwa kujanza ibotu lya-Leza wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
