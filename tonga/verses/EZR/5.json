              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi eco kwakabasikila Tatinai, mweendelezi wakokuno kutala lyamulonga, a-Setarabozenai, abeenzinyina, babaambila kuti, Ino nguni wamulailila kuyaka iŋanda eyi akwiimika bulambo obu? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakabavwiila kuti, Ino mbobani mazina aabo, bantu bayaka iŋanda eyi? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
