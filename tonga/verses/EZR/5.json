                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Zerubabeli mwana wa-Sealitiyeli a-Jeshua mwana wa-Jozadaki bakanyampuka, batalika kuyaka iŋanda ya-Leza mu-Jerusalemu, abalo basinsimi ba-Leza bakali abo akubagwasya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
