                "loc": "EZR.1.1"
              },
              "items": [
                {
                  "text": "Ezr 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mumwaka mutaanzi wabwami bwa-Koresi mwami wa-Babuloni, oyo mwami Koresi wakalailila kuti iŋanda eyi ya-Leza iyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
