        },
        {
          "text": "Pele bamataata besu nibakakalazya Leza wakujulu, wakabaaba mumaanza aa-Nebukadinezara muKasidi mwami wa-Babuloni, Ngonguwe iwakamwaya iŋanda eyi akutola bantu mubuzike ku-Babuloni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
