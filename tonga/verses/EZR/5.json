              "items": [
                {
                  "text": "1 Pet 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele liso lya-Leza wabo lyakali kulanga bapati ba-Juda, aboobo teebakakonzya kubalesya, mane lumwi makani akasika kuli-Dariyo. Elyo bakatuma lugwalo lwakwaamba makani aya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
