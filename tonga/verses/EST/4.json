                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moodekai wakamwaambila zyoonse zyakacitidwe, alimwi aamali Hamani ngaakasyomezya kubika muciyobwedo camwami, kabbadalila lufwidilizyo lwaba-Juda; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
