          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "alimwi Esita wakapa Hataki majwi aya kuti aatole kuli-Moodekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
