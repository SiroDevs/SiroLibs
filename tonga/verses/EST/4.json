        },
        {
          "text": "Lino Moodekai naakamvwa zyoonse zyakacitidwe, wakazapaula zyakusama zyakwe, kalila cakulitakata; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakaya kunembo mu-Mulyango wamwami (nkaambo teecakazumizigwa kuti muntu uusamide masaka ainde mukati ka-Mulyango wamwami). ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni, nekuba kuti ijwi acilaililo camwami cakamvwigwa nokuba lili, kwakali kulila kupati akati kaba-Juda, alimwi akuliimya akoomoka, bunji bwabo kabalede mumasaka atwe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        }
      ]
