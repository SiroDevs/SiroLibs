              "items": [
                {
                  "text": "Int 83:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakacitabuluzya kumujaya walo alike. Bakamwaambila mukowa wakwe, elyo wakalibambila kufwidilizya boonse ba-Juda bakali mubulelo boonse bwa-Ahasuera, mukowa woonse wa-Moodekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
