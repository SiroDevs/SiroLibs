                "loc": "EST.8.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mwami wagwisya nsale kumunwe wakwe akumupa Hamani mwana a-Hamedata, sikulwanya ba-Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mwami kuliHamani, Mali aako nsiayandi; kocita mboyanda kumukowa oyo, bali mujanza lyako.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
