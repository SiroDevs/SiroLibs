                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zilaililo zyakatumwa abasimposo kuzisi zyoonse, kuti banyonyoonwe, akujayigwa, akufwidilizigwa ba-Juda boonse, basankwa abanene, bana abakaintu, mubuzuba bomwe buyo, buzuba bwakumi mwatatu bwamwezi wakumi aibili, mwezi uutegwa Ada, lukono lwabo kalusaalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
