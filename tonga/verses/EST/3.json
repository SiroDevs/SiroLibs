        },
        {
          "text": "Mumwezi wakutaanguna, mwezi uutegwa Nisani, mumwaka wakumi mwiibili wamwami Ahasuera, bakawaala nkakata iitegwa “puri” buzuba abuzuba amwezi amwezi kusikila yakawa mubuzuba bwakumi mwaatatu bwamumwezi wakumi mwiibili, mwezi uutegwa Ada. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
