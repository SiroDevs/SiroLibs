              "items": [
                {
                  "text": "Ezr 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.20"
              },
              "items": [
                {
                  "text": "Inc 16:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Hamani wakati kumwami Ahasuera, Nkuuli mukowa uumwayikidwe akwaandaanisigwa akati kamikowa yamuzisi zyoonse zyabulelo bwako; milao yabo ilyaandeene ayeeyo yamikowa yoonse imwi; tabateeleli milao yamwami; aboobo takweelede kuti mwami alikataazye ambabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti kazumina mwami, cilaililo kacilembwa caamba kufwidilizigwa kwabo, elyo ime ndilapa mpondo zyansiliva zili zyuulu zyone zyazyuulu kulibasimali bamwami bazibike muciyobwedo camali cabwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
