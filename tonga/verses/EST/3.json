              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Majwi aamucilaililo aeelede kuya kuzisi zyoonse, akutuminwa maleya mumikowa yoonse: bantu bakeelede kulibambila kubuzuba obo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
