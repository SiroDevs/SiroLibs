                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Hamani nekuba kuti wakakalala na wabona kuti Moodekai takwakamukotamina na kumuvundamina, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
