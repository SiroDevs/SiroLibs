              "attrs": {
                "loc": "MRK.6.21"
              },
              "items": [
                {
                  "text": "Mk 6:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mumwaka watatu wabulelo bwakwe, wakabacitila pobwe beendelezi abakamboni bakwe; alimwi basimutwe bankondo zya-Persia a-Media, abaleli abapati bazisi bakaliko. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabayubunwida lubono lwabwami bwakwe lukankamanisya azyakusama zya bwami zigambya, mazuba manji, mazuba aali mwaanda amakumi aali musanu mwaatatu, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamana mazuba aya mwami wakabacitila pobwe boonse bakali mu-Susa munzi wamwami, bapati abaniini, mazuba aali musanu mwaabili, mulukwakwa lwaŋanda yamwami; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.7.8"
              },
              "items": [
                {
                  "text": "Es 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.8"
              },
              "items": [
                {
                  "text": "Am 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akali masani aanzikidwe aatuba aasiyasiya aangidwe amakole aazisani zituba azisalala kutusale twansiliva akumisemo yabbwe bbotu; zikalilo zyangolida azyansiliva zyakalikede acibuye camabwe aasalala, aatuba, aasiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabanywisya muzinywido zyangolida (kazyaandeene) alimwi akaambo kabwaabi bwamwami waini wakaba ceyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele, amulao, taakwe wakasungilizigwa kuti anywe, nkaambo mwami wakalaambide kubazike boonse baŋanda yakwe kuti acite mbuli mbwayanda mweenzu woonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awalo Vasiti namalelo wakabacitila pobwe bakaintu baŋanda yamwami Ahasuera.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
