                "loc": "MAT.16.3"
              },
              "items": [
                {
                  "text": "Mt 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "elyo wakabuzya kubasongo bakezi zilengwa (nkaambo kukosola koonse kwamwami kwakali koombololwa abasimulao abasilubeta). ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.14"
              },
              "items": [
                {
                  "text": "Ezr 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bali afwaafwi anguwe bakali Kaasena, Seta, Adamata, Taasisi, Meresi, Maasena, a-Memukani beendelezi musanu ababili ba-Persia a-Media, bakazumininwa kuti banjile kumwami akukala munsi lyacuuno cabwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabuzya akaambo ka-Vasiti namalelo kuti ncinzi ncaakeelede kucitilwa akaambo kakutaswiilila kwakwe ijwi lyamwami kulibasiŋanda bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memukani wakavuwa kunembo lyamwami abeendelezi wati, Vasiti takwabisizya mwami alike pele beendelezi boonse abantu bamuzisi zyamwami Ahasuera. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo eci ncacita namalelo ciyakumvwigwa abakaintu boonse, elyo bayakunyansya baalumi babona kuti kwaambwa kuti mwami Ahasuera wakalailila Vasiti namalelo kuti aletwe kumbele lyakwe pele wakaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzuba buno, bakaintu babeendelezi ba-Persia a-Media bamvwa amilimo yanamalelo, balaamba cakunyansya atubuko kulibasimutwe boonse bamwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti kazumina mwami, kacituminwa maleya cilaililo cakwe, alimwi kacilembwa mumilao yaba-Persia aba-Media, citakasandulwi, kuti Vasiti atakabooli limbi kunembo lyamwami Ahasuera; mwami kapa cilao cakwe cabwami kuluumbi uumwiinda kubota. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
