          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kubuzuba bwamusanu mwaabili moyo wamwami kaukondwa akaambo kawaini, wakalailila Mehumani, Bizita, Habona, Bigita, Abagata, Zeta a-Kaaka basiŋanda bali musanu mubabili bakalindilila mwami Ahasuera, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.9"
              },
              "items": [
                {
                  "text": "Tus 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti balete Vasiti namalelo kumbele lyakwe kasamide munsini wabwami kuti bantu abasimutwe babone kweebeka kwakwe. Nkaambo wakali kweebeka kukulanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Vasiti wakakaka kuboola basiŋanda nebakaleta ijwi lyamwami. Lino mwami wakakalala kapati, wakapya lunyemo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
