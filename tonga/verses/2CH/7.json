        },
        {
          "text": "Lino bana ba-Israyeli boonse, nibakabona mulilo mbuwakazwa kujulu abulemu bwa-Jehova mbubwakaboneka aŋanda, bakavundama ansi abbuwa, bakomba, balumba Jehova, bati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
