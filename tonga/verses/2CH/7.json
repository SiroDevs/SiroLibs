        },
        {
          "text": "Kuciindi eco nciconya Solomoni wakacita ipobwe lyamazuba aali musanu aabili, aba-Israyeli boonse bakaiya awe, imbungano impati yabantu banji loko, kuzwa kumanjililo aaku-Hamati kusikila kukalonga kaku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba bwamusanu aatatu bakacita imbungano iisalalisya, nkaambo bakamana mazuba aali musanu aabili kukusalazya cipaililo akukulya ipobwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.66"
              },
              "items": [
                {
                  "text": "1 Bam 8:66",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba bwamakumi obile aatatu mumwezi wamusanu aibili wakamwaisya bantu kuti baye kumaanda aabo. Bakaya abusekelezi alukondo mumyoyo yabo nkaambo kabubotu Jehova mbwaakacitila Davida a-Solomoni aba-Israyeli bantu bakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
