        },
        {
          "text": "Mbuboobo Solomoni mbwaakamanisya iŋanda ya-Jehova aŋanda yamwami. Milimo yoonse moyo wa-Solomoni nji wakayeeya kucita muŋanda ya-Jehova amuŋanda yakwe, wakaimana kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
