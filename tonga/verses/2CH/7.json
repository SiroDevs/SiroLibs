        },
        {
          "text": "Alimwi Solomoni wakasalazya lubanza lwamukati ilwakali kunembo lyaŋanda ya-Jehova, nkaambo nkukonya oko nkwaakatuula cipaizyo amafuta azituuzyo zyakutontozya, nkaambo cipaililo camukuba Solomoni ncaakapangide cakaata, cakakacilwa kutambula zyoonse, acipaizyo acituuzyo cabusu amafuta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
