            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.5.14"
              },
              "items": [
                {
                  "text": "2 Mak 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bapaizi bakakacilwa kunjila muŋanda ya-Jehova, nkaambo bulemu bwa-Jehova bwakazuzya iŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
