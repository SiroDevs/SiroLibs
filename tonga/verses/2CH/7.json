        },
        {
          "text": "Lino Solomoni naakamana kukomba, mulilo wakaseluka kuzwa kujulu, wakatenta cituuzyo azipaizyo. Nkabela bulemu bwa-Jehova bwakazuzyazya iŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
