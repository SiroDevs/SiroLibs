        },
        {
          "text": "Jotamu kajisi myaka iili makumi obile amusanu naakaba mwami, nkabela wakeendelezya mu-Jerusalemu myaka iili ikumi amusanu aumwi. Izina lyabanyina bakali Jerusa mwana wa-Zadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
