        },
        {
          "text": "Jotamu wakaba singuzu nkaambo kakuti wakabamba kabotu inzila zyakwe kubusyu bwa-Jehova Leza wakwe,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
