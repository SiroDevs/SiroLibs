            }
          ]
        },
        {
          "text": "Nkabela wakacita ziluleme mumeso aa-Jehova, mbubonya mbwaakacita Uziya wisi, pele takwakanjila muntempele ya-Jehova, Nekubaboobo bantu bakacili kubisya-bisya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
