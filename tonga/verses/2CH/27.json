                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngonguwe wakayaka mulyango waajulu waŋanda yaJehova, abulambo bwa-Ofeli wakacita milimo minji kulimbubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayaka minzi mucisi catulundulundu ca-Juda, amumisanza wakayaka maanda mayumu azisanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
