          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Ataliya, banyina Ahaziya, naakabona kuti mwanaakwe wafwa, wakabuka akujaya bana boonse bamwami wamusyobo wa-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.2"
              },
              "items": [
                {
                  "text": "2 Bam 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Jehosabati mwana musimbi wamwami wakabweza Joasi mwana wa-Ahaziya, wamugwisya kumbali akati kabana bamwami ibakati jayigwe, wamubika amuleli wakwe muŋanda yakoona yamukati. Jehosabati mwana musimbi wamwami Joramu, muka-Jehoyada mupaizi, mbwaakali mucizi wa-Ahaziya, wakamuvuna kumaanza aa-Ataliya, aboobo takwakamujaya pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakakala abo uliyubide muŋanda ya-Leza myaka iili musanu aumwi, Ataliya naakali kweendelezya nyika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
