            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.6"
              },
              "items": [
                {
                  "text": "2 Mak 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ahaziya kajisi myaka iili makumi one aibili naakaba mwami, nkabela wakeendelezya mu-Jerusalemu mwaka omwe, Izina lyabanyina bakali Ataliya mwana wa-Omri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakeenda alakwe munzila zyaluzubo lwa-Ahabu, nkaambo banyina mbobakamukombelezya kucita bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.17"
              },
              "items": [
                {
                  "text": "2 Mak 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.18"
