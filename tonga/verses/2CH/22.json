                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele aya makani akazwa kuli-Leza, Ahaziya wakajana lunyonyooko mukuswaya kuli-Joramu, nkaambo naakali kuswaya oko wakainka a-Joramu kukulwisya Jehu mwana wa-Nimsi, ngonguwe Jehova ngwaakananika kuti anyonyoone luzubo lwa-Ahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.10"
              },
              "items": [
                {
                  "text": "2 Bam 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino jehu naakali kubeteka luzubo lwaAhabu, wakajana basilutwe ba-Juda abana babakwabo Ahaziya ibakali kukutaukila Ahaziya, elyo wakabajaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.27"
              },
              "items": [
                {
                  "text": "2 Bam 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakayandaula Ahaziya, nkabela wakajatwa ku-Samariya, nkwaakayubide, wakaletwa kuli-Jehu akujayigwa. Bakamuzika nkaambo bakati, Ngumwana wa-Josafati, iwakayandaula Jehova camoyo woonse. Lino teekwakasyaala muntu naba omwe waluzubo lwa-Ahaziya iwakajisi inguzu zyakweendelezya cisi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
