              "items": [
                {
                  "text": "2 Mak 21:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bantu baku-Jerusalemu bakasala Ahaziya mwanaakwe muniini kuti alye bwami bwakwe, nkaambo bana bapati boonse yakabajaya impi iyakeza aba-Arabu kumunzi. Mbuboobu Ahaziya mwana wa-Joramu mbwaakaba mwami wa-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.26"
              },
              "items": [
                {
                  "text": "2 Bam 8:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.28"
              },
              "items": [
                {
                  "text": "1 Bam 16:28",
