              "attrs": {
                "loc": "PRO.19.27"
              },
              "items": [
                {
                  "text": "19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakacita bubi mumeso aa-Jehova mbubonya mbubakacita basiluzubo ba-Ahabu, nkaambo mbombabo ibakali kumulaya kusule lyalufu lwawisi, mbombabo bakamubisizya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.28"
              },
              "items": [
                {
                  "text": "2 Bam 8:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbwaakatobela lulayo lwabo, wakaya a-Joramu mwana wa-Ahabu mwami wa-Israyeli kuyoolwisya Hazaeli mwami wa-Aramu ku-Ramoti-Gileadi. Nkabela baAramu bakayasa joramu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.15"
              },
              "items": [
                {
                  "text": "2 Bam 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "elyo wakapiluka ku-Jezreeli kuti asilikwe kuzyuumo nzyaakaumigwa ku-Rama naakali kulwisya Hazaeli mwami waAramu. Nkabela Ahaziya mwana wa-Joramu mwami wa-Juda wakeza kuswaya Joramu mwana wa-Ahabu mu-Jezreeli, nkaambo wakaciswa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
