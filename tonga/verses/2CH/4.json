              "items": [
                {
                  "text": "1 Bam 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.9"
              },
              "items": [
                {
                  "text": "Heb 9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakapanga zisambilo zili ikumi zyakusambila. Wakabika zyosanwe kululyo azyosanwe kulumwensi. Mulinzizyo mobakali kusanzyasanzya zipaizyo, pele iziba lyakali lyabapaizi kuti basambe mulindilyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        }
