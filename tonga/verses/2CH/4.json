            }
          ]
        },
        {
          "text": "Alimwi wakacita lubanza lwabapaizi, alubanza lupati, azitendele zyalubanza. Zitendele zyalo wakaziziluluzya mukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
