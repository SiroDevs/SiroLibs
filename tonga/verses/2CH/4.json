                "loc": "1KI.7.24"
              },
              "items": [
                {
                  "text": "1 Bam 7:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kunsi lyaco kakuli zikozyano zyaŋombe kumabazu oonse; zyakali mumindando yobile, zyakafulwa ciindi eco nciconya nilyakafulwa iziba lini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakalitabilidwe aŋombe zili ikumi azibili. Zyotatwe zyakali kulanga kunyika, zyotatwe zyakali kulanga kumbo, zyotatwe zyakali kulanga kumusanza, azyotatwe zyakali kulanga kujwe, Iziba lyakalikede alinzizyo, amatako aazyo akalifutatilene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Bam 7:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Indiya yalyo yakali mbuli ijanza, ankomwe yalyo yakalipangidwe mbubonya mbuli mulomo wankomeki, yakali amalubaluba aampana, nkabela lyakakonzya kujata nongo zili zyuulu zyotatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.38"
