        },
        {
          "text": "Alimwi wakafula cikozyano caziba lyamaanzi; cakali zyuungulukide, cakali tukokola tuli ikumi kuzwa kunkomwe imwi kusikila kunkomwe imwi, acipimyo cakucizyungulusya cakali tukokola tuli makumi otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
