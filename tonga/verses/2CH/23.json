        },
        {
          "text": "Lino mumwaka wamusanu aibili, Jehoyada wakaliyumya, watanga cizuminano abasilutwe bamyanda, Azariya mwana wa-Joroamu, a-Ismayeli mwana wa-Jehohanana, a-Azariya mwana wa-Obedi, a-Maaseya mwana wa-Adaya, a-Elisafati mwana wa-Zikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
