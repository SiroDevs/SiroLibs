                  "text": "Inc 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "inkamu imwi ibe muŋanda yamwami, ankamu imwi ibe kuMulyango wamatalikilo. Abantu boonse babe mulubanza lwaŋanda ya-­Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
