                "loc": "PSA.112.5"
              },
              "items": [
                {
                  "text": "Int 112:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakatuma koonse koonse mucisi ca-Juda, babunganya ba-Levi kuzwa kuminzi yoonse ya-Juda, abapati banzubo zya-Israyeli, nkabela bakeza ku-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
