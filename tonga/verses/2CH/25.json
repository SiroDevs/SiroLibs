            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kusule lyalufu lwa-Joasi mwana wa-Jehoazi mwami wa-Israyeli, Amaziya mwana wa-Joasi mwami wa-Juda kacipona myaka iili ikumi amusanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakani amwi aa-Amaziya, mataanzi amasyaalizi oonse, sa taalembedwe mubbuku lyabami ba-Juda aba-Israyeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuzwa kuciindi eco Amaziya naakaleya kuzwa kuli-Jehova, bakatalika kumuvwiya mu-Jerusalemu, aboobo wakacijila ku-Lakisi, pele akwalo ku-Lakisi bakatuma basikumutobela, bamujaya nkukonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.20"
              },
              "items": [
                {
                  "text": "2 Bam 14:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakamuleta amabbiza akumuzika mumunzi wa-Davida mubakazikwa bamawisi.",
          "type": "text",
          "attrs": {
