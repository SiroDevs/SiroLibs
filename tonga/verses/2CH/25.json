        },
        {
          "text": "Pele bana babo, takwakabajaya pe, nkaambo mbuboobu mbukulembedwe mumulao wamubbuku lya-Musa; Jehova wakalailila kuti, Bantu tabeelede kufwa nkaambo kamilandu yabana babo, abalo bana tabeelede kufwa nkaambo kamilandu yabamawisi. Umwi aumwi afwe nkaambo kamulandu wakwe mwini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
