            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Joasi mwami wa-Israyeli wakatumina Amaziya mwami wa-Juda mulazyo wakuti, Kakoka ikakali ku-Lebano kakatumina musamu wakedari waku-Lebano, kati, Utupe inwana wako musimbi, kuti mwanaangu mulombe amukwate. Mpawo kwakainda cinyama camusokwe caku-Lebano, calyataula kakoka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
