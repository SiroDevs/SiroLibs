              "items": [
                {
                  "text": "2 Mak 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.1"
              },
              "items": [
                {
                  "text": "22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
