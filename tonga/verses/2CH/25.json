              "items": [
                {
                  "text": "Hos 10:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakacita ziluleme mumeso aa-Jehova, nekubaboobo takwakalulama camoyo woonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
