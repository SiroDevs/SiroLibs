              },
              "items": [
                {
                  "text": "2 Bam 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bwami nibwakajisi kabotu mumaanza aakwe, wakajaya abo balanda bakwe ibakajayide mwami wisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
