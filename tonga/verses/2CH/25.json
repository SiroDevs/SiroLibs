            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakabelesya bantu ba-Israyeli, baalumi basintaze bali zyuulu zili mwanda, wabapa matalenta aansiliva aali mwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
