            }
          ]
        },
        {
          "text": "Nekubaboobo Amaziya takwakamvwa pe, nkaambo makani akazwa kuli-Leza, kuti abaabe mumaanza aabasinkondonyina nkaambo kakuti bakabika myoyo yabo kumizimu ya-Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Joasi mwami waIsrayeli wakeza kuzoobonana bwaalumi a-Amaziya mwami wa-Juda kuBeti-semesi mucisi ca-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ba-Juda bakazundwa kubusyu bwaba-Israyeli akucija umwi aumwi kumunzi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
