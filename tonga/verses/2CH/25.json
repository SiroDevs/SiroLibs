              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Joasi mwami wa-Israyeli wakajata Amaziya mwana wa-Joasi mwana wa-Ahaziya mwami wa-Juda nkukonya ku-Beti-semesi, wamusisya ku-Jerusalemu, wamwaya bulambo bwa-Jerusalemu kuzwa ku-Mulyango wa-Efraimu akusikila kumulyango wacooko, tukokola tuli myanda yone. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakatola ingolida yoonse, ansiliva, azibelesyo zyoonse izyakajanwa muŋanda ya-Leza kuli-Obedi-Edomu, aziyobwedo zyaŋanda yamwami, abasimubuzike, elyo wakapiluka ku-Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
