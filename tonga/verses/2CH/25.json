              "items": [
                {
                  "text": "2 Bam 14:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Amaziya wakaliyumya, wasololela bantu bakwe, waya kukuti lya-Munyo, wajaya bantu ba-Seiri bali zyuulu zili ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwi bali zyuulu zili ikumi, bana ba-Juda bakabajata bacili baumi, babasisya kumutwe wandomba, babawaala ansi kuzwa oko kumutwe wandomba, aboobo boonse bakapwayika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele basilumamba bampi eyo Amaziya njaakamwaisya, njaakakaka kuya ayo kunkondo, bakasaala minzi ya-Juda kuzwa ku-Samariya kusikila ku-Beti-horoni, bajaya bantu bali zyuulu zyotatwe bamulinjiyo akusaala imbono zinji.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
