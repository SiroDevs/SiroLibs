              "attrs": {
                "loc": "ROM.8.31"
              },
              "items": [
                {
                  "text": "Rom 8:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakali a-Josafati, nkaambo wakeenda munzila intaanzi zya-Davida wisi. Takwakabika moyo wakwe kumituni pe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
