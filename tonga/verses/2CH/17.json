                "loc": "MAL.2.7"
              },
              "items": [
                {
                  "text": "Mal 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakaiisya mucisi ca-Juda, bakali abbuku lyamulao wa-Jehova, Kabaya bweendeenda muminzi yoonse ya-Juda akwiisya bantu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
