              "items": [
                {
                  "text": "1 Bam 12:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakabika moyo wakwe kuli-Leza wabamawisi akucita imbeta zyakwe. Takwakacita mbuli mbubakali kucita ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
