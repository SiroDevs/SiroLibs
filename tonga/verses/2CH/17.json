              "items": [
                {
                  "text": "19:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakayumya moyo wakwe munzila zya-Jehova, alimwi wakagwisya zipaililo zyakuzilundu azikozyano zyamizimu mucisi ca-Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
