                  "text": "2 Mak 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako Jehova wakakazika bwami bwakwe mumaanza aakwe, Nkabela ba-Juda boonse bakaletela Josafati zipo, aboobo kajisi buvubi bunji abulemu bunji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
