            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka watatu wabwami bwakwe wakatumina basilutwe bakwe, Benihaili a-Obadiya a-Zekariya a-Netaneli a-Mikaya, kuti baiisye muminzi ya-Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakali aba-Levi, Semaya, a-Netaniya, a-Zebadiya, a-Asaheli, a-Semiramoti, a-jonatani, a-Adonija, a-Tobiya a-Tobadoniya. Abaaba baLevi bakali abapaizi Elisama a-Joramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
