          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.11"
              },
              "items": [
                {
                  "text": "2 Mak 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.8"
              },
              "items": [
                {
                  "text": "15:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakabika impi muminzi yoonse ya-Juda iyakali amabaya, akubika basilumamba munyika ya-Juda amuminzi ya-Efraimu njaakazunda Asa wisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        },
        {
