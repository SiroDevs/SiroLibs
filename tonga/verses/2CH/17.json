        },
        {
          "text": "Elyo Josafati mwanaakwe nguwakalya izina lyakwe, Nkabela wakaliyumya kukulwisya ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
        {
