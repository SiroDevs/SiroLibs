                  "text": "Dan 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azyalo zimwi zibelesyo zyaŋanda ya-Jehova, Nebukadinezara wakazileta ku-Babuloni, wazibika muntempele yakwe mu-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
