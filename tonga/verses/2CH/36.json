        },
        {
          "text": "Lino kwakeza kuzoomulwisya Nebukadinezara mwami wa-Babuloni, wamwaanzya inkeetani akumutola ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
