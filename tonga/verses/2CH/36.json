        },
        {
          "text": "Lino bantu bacisi bakabweza Jehoahazi mwana wa-Josiya, bamupa bwami mucibaka cawisi mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahazi kajisi myaka iili makumi obile aitatu naakaba mwami, nkabela wakeendelezya mu-Jerusalemu myezi yotatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele mwami wa-Egepita wakamugwisya mu-Jerusalemu akutezya cisi mutelo wamatalenta aansiliva aali mwanda atalenta lyangolida. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.19.3"
              },
              "items": [
                {
                  "text": "Ezk 19:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mwami wa-Egepita wakabika munyina Eliyakimu kuti abe mwami wa-Juda awa-Jerusalemu, wasandula izina lyakwe, wamuulika izina lyaJehoyakimu. Lino Jehoahazi mupati wakwe, Neko wakamutola, wamusisya ku-Egepita.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
