            }
          ]
        },
        {
          "text": "Alimwi wakabamba caabilo cambono zyamwami ncaakabikila zipaizyo, nkukuti zipaizyo zyacifumo azyamangolezya, azipaizyo zyabuzuba bwa-Sabata azyamwezi mupya azyamapobwe, mbubonya mbukulembedwe mumulao wa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
