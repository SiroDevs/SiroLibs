              "items": [
                {
                  "text": "Dt 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abana ba-Israyeli aba-Juda ibakakede muminzi ya-Juda, abalo bakaleta cipanzi cakumi caŋombe acambelele, acipanzi cakumi cazintu zisalala izyakasalazigwa kuli-Jehova Leza wabo. Bakazileta akuzitula milwi milwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatalika kucita milwi mumwezi watatu, elyo bakamana mumwezi wamusanu aibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
