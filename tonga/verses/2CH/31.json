              "type": "text"
            }
          ]
        },
        {
          "text": "kutaamba mweelwe wabaalumi, boonse ibakajisi myaka yotatwe nanka kwiinda, nkukuti boonse ibakali kunjila muŋanda ya-Jehova buzuba bumwi abumwi kukumana milimo kunkamu zyabo mbubakaabilwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
