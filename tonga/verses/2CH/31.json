        {
          "text": "Lino Hezekiya abapati bacisi nibakasika akubona milwi, bakatembaula Jehova abantu bakwe baIsrayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
