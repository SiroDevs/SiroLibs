              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo Hezekiya wakabuzya bapaizi aba-Levi makani aamilwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
