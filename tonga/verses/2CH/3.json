                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Solomoni wakatalika kuyaka iŋanda ya-Jehova mu-Jerusalemu kucilundu citegwa Moriya, Jehova nkwaakalibonya kuli-Davida wisi, nkukonya oko kuntu Davida nkwaakabambide, mucipolelo ca-Orinani mujebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatalika kuyaka mumwezi wabili mumwaka wane wabwami bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.2"
              },
              "items": [
                {
                  "text": "1 Bam 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu Solomoni mbwaakayaka iŋanda ya-Leza: bulamfu bwayo nibwakapimwa muziyanza zyaciindi bwakali tukokola tuli makumi aali musanu alimwi, abwaamba bwayo tukokola tuli makumi obile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.3"
              },
              "items": [
                {
                  "text": "1 Bam 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alukonkono lwakunembo lyantempele, bulamfu bwalo bwakeelene abwaamba bwaŋanda ini, nkukuti tukokola tuli makumi obile, abwiime bwalo bwakali tukokola tuli mwaanda. Nkabela mukati wakaluziluluzya ingolida, ingolida loko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.17"
              },
              "items": [
                {
                  "text": "1 Bam 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi iŋanda impati wakaivumbya zisamu zyamulombe akwiiziluluzya ingolida loko, nkabela alinjiyo wakacita mikunka ankeetani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakasakatizya iŋanda mabwe mayandisi, Ingolida kiili ingolida yaku-Parivaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaziluluzya iŋanda yoonse ingolida, maseketi aayo azikunguzyo zyayo abwaanda bwayo amakoma aayo, alimwi abwaanda wakabeza bakerebimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
