                "loc": "JER.52.21"
              },
              "items": [
                {
                  "text": "Jer 52:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kunembo lyaŋanda wakacita minsende yobile. Bwiime bwayo bwakali tukokola tuli makumi otatwe amusanu. Alimwi atala lyamunsende umwi aumwi, wakabika ciimikilo icakali abulamfu bwatukokola tosanwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakapanga inkeetani mucikombelo camukati, wazibika atala lyaminsende, alimwi wakafula zikozyano zyamapomegranite zili mwanda akuzibika ankeetani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakaimika minsende kunembo lyantempele, umwi kululyo aumwi kucimwensi. Munsende wakululyo wakaupa izina lyaJakini, ayooyo wakucimwensi wakaupa izina lya-Boazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
