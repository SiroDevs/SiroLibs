            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3"
              },
              "items": [
                {
                  "text": "Heb 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi cisitilizyo wakacicitya masani aamabala mabala aasalala akusia amasani aatuba. Alincico acalo wakeengaenga bakerebimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
