        },
        {
          "text": "Nkaambo kako Solomoni wakasala bantu bali zyuulu zili makumi aali musanu aabili bakuyumuna, abantu bali zyuulu zili makumi aali musanu aatatu bakusya mabwe mumalundu, abantu bali zyuulu zyotatwe amyanda iili musanu aumwi bakubabelesya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
