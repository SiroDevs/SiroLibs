        {
          "text": "Kuciindi eco katakwe luumuno nikuba kuliyooyo iwakainka nikuba kuliyooyo iwakaboola, nkaambo kakuli lupyopyongano lupati akati kabantu boonse ibakakede mumasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
