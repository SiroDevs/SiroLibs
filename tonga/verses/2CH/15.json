        {
          "text": "Elyo Asa naakaswiilila aya majwi ngaakasinsima Azariya mwana waOdedi, wakaliyumya, wagwisya mizimu yoonse iisesemya munyika ya-Juda amunyika ya-Benjamini amuminzi njibakanyanzya cisi catulundulundu twaEfraimu. Nkabela wakayakulula cipaililo ca-Jehova icakali kunembo lyacikombelo ca-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
