            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba-Juda boonse bakasekelela nkaambo kacikonkyo, nkaambo bakakonka camoyo woonse akumuyandaula caluyando loonse, alimwi wakajanwa kulimbabo, nkabela Jehova wakabapa luumuno koonse koonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
