                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakazumina kuti kufumbwa uutayandaula Jehova Leza wa-Israyeli uleelede kufwa, naba mwanike naba mupati, naba mwaalumi naba mwanakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
