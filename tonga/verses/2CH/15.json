                  "text": "2 Mak 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakabunganya ba-Juda aba-Benjamini boonse, abeenzu baku-Efraimu abaku-Manase abaku-Simeoni ibakakede akati kabo, nkaambo bantu banji ba-Israyeli bakeza kulinguwe nibakabona kuti Jehova Leza wakwe uli awe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabungana ku-Jerusalemu mumwezi watatu mumwaka wakumi amusanu wabwami bwa-Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
