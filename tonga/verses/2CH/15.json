                {
                  "text": "Dt 4:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ciindi camapenzi, nibakaboola kuli-Jehova Leza wa-Israyeli akumuyandaula, wakajanwa kulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
