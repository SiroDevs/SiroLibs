        },
        {
          "text": "Ciindi cilamfu ba-Israyeli bakabula Leza mwinimwini, amupaizi wakubaiyisya, amulao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
