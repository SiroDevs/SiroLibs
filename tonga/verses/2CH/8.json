                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakayaka Tadimori munkanda, aminzi yoonse yaziyobwedo njaakayaka kuHamati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
