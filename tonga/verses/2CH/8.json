          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "bana babo ibakasyeede munyika, bana baIsrayeli mbubakabula kunyonyoona, aba Solomoni wakabapa cibbalo. Mbubacibede asunu. ",
          "type": "text",
