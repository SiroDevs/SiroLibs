              },
              "items": [
                {
                  "text": "Jos 15:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a-Baalati, aminzi yoonse yaziyobwedo Solomoni nzyaakajisi, aminzi yoonse yankalaki zyakwe, aminzi yamabbiza, akufumbwa cintu moyo wa-Solomoni ncowakayanda kuyaka mu-Jerusalemu amu-Lebano amunyika yoonse yabwami bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
