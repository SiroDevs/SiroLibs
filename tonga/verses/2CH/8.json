          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wakayaku­ lula minzi Huramu njaakamupa akukazika bana ba-Israyeli mulinjiyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
