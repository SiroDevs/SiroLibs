        },
        {
          "text": "Bantu boonse ibakasyeede baba-Hiti aba-Amori aba-Perizi aba-Hivi abaJebusi, ibatali ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
