        },
        {
          "text": "Lino kumamanino aamyaka iili makumi obile, Solomoni naakamana kuyaka iŋanda ya-Jehova aŋanda yakwe mwini, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
