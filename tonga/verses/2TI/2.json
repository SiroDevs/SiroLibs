                "loc": "1CO.9.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muntu uulima mumuunda nguuelede kusaanguna kooloka. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koayeeya aya ngendakwaambila, nkaambo Mwami ulakupa maanu kumakani oonse.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        }
