            }
          ]
        },
        {
          "text": "Eno ncenzumbaanina bobuya nkaambo kabaabo basalidwe, kuti bakajane lufutuko muli-Kristo Jesu abulemu butamani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
