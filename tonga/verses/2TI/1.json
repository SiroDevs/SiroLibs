            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utafwi bweeme kubumboni bwa-Mwami wesu, nokuba kulindime ndemwaange wakwe, pele kogamine kuba mupenzima wamu-Makani Mabotu kunguzu zya-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
