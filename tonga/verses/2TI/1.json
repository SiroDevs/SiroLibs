                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Inc 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakujuzya Timoteo, mwanaangu ngwenjanda. Ube aluzyalo alweetelelo aluumuno kuzwa kuli-Leza Taateesu a-Kristo Jesu Mwami wesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
