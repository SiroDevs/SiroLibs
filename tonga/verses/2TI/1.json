          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.20"
              },
              "items": [
                {
                  "text": "1 Tim 6:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cintu eco cibotu ncowakapegwa, kocibamba kabotu kunguzu zya-Muuya Uusalala uutukalilide mukati.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        }
      ]
