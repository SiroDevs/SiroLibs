            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa nindayeeya misozi yako, moyo wangu ulasukama kukubona, kuti nkazule lukondo, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Inc 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nkaambo nsikonzyi kuluba lusyomo lwako lwinilwini. Olo lusyomo lwakasaanguna kukala muli-Loidi banyookulu bako amuliEunike banyoko, nkabela moyo wangu ulisinizizye kuti moluli amulinduwe mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
