                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndalumba Leza wabamatata, ngwenkomba amoyo uusalala, kuti nsileki kukwaambilizya lyoonse muzikombyo zyangu isikati amasiku, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.3",
