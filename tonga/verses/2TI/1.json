            "number": "16",
            "style": "v",
            "sid": "2TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami abafwide luzyalo bana-Onesiforo, nkaambo kanjikanji wandibukulusizya moyo, nkabela taakwe anaakali kuusa insoni kunsimbi zyangu nzendakaangidwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele naakali mu-Roma, wakasungwaala kundiyandaula, limwi mane wandijana. ",
