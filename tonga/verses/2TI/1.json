                "loc": "1TI.2.7"
              },
              "items": [
                {
                  "text": "1 Tim 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaonya makani ngendakabikilwa bukambausi abuapostolo abwiiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncencico eco neempengela bobuya, nekubaboobo nsyuusi insoni, pe, nkaambo ndilimuzi oyo ngwensyoma, nkabela moyo wangu ulisinizizye kuti walo ulakonzya kuyobola ncendabika mumaanza aakwe mane kusikila kubuzuba obo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        }
      ]
