                  "text": "2 Tim 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulimvwide kale kuti boonse bamu-Asiya bakandisia, bakainka. Bamwi babaabo bakandisia mba-Fugelo a-Hermogene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
