              "items": [
                {
                  "text": "Tit 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kojatisya majwi menimeni oonse ngowakamvwa kulindime, alusyomo akuyandana kuli muli-Kristo Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
