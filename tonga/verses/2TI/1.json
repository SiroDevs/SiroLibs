              "items": [
                {
                  "text": "57",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele sunu lwalibonya mukupompa kwa-Mufutuli wesu Krisro Jesu, nguwenya wakazoolobya lufu akuyubulula buumi butafwiki kunguzu zya-Makani Mabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
