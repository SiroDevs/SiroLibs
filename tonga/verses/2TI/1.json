              },
              "items": [
                {
                  "text": "Tit 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "uwakatufutula akutwiita akwiitwa kusalala. Takweensi kwaamba kuti twakaitwa nkaambo kamilimo njotwakacita, pe, twakaitwa nkaambo kabukanze bwakwe mwini akaambo kaluzyalo lwakwe. Olo luzyalo twakalupegwa kalekale muli-Kristo Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
