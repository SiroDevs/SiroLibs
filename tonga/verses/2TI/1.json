        },
        {
          "text": "Ndime Paulo, nendakasungulwa kubukanze bwa-Leza kuba apostolo wa-Kristo Jesu wakukambauka makani aabuumi mbotusyomezegwa buli muli-Kristo Jesu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
