                "loc": "1TI.4.14"
              },
              "items": [
                {
                  "text": "1 Tim 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkakaambo ako ncendakuyeezya kuti uleelede kubukulusya eco caabilo caluzyalo lwa-Leza lukukalide mukati, ncowakatambula kuciindi ncendakakubika maanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.15"
              },
              "items": [
                {
                  "text": "Rom 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Leza takatupede muuya wabukandu, pe, wakatupa muuya wanguzu awakuyandana awakulibamba.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
