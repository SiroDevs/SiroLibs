            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.8"
              },
              "items": [
                {
                  "text": "Rom 12:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.17"
              },
              "items": [
                {
                  "text": "1 Mak 29:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi aumwi uleelede kupa mbuli mbwayanda mumoyo wakwe, kutabi cakunyonosya moyo nanka cakusinikizigwa, nkaambo oyu uupa calumwemwe nguuyandwa kwa-Leza, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leza ulakonzya kumulongezya kukumupa buvubi bunji, kuti lyoonse mukabe azintu zyoonse zyeelede zyakuligwasya nubeni, alimwi kuti mukabe azintu zyakucitila bamwi milimo mibotu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.112.9"
              },
              "items": [
                {
                  "text": "Int 112:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubonya mbukulembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
