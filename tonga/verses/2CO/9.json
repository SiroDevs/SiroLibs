                  "text": "19:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuswiilile ijwi eli! Oyo uubyala cakucesya ulatebula cakucesya, pele oyo uubyala cakuvuzya ulatebula cakuvuzya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
            "verseOrgIds": [
              "2CO.9.6"
            ]
          }
        },
        {
