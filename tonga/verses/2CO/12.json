              "2CO.12.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Kor 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone, olu ndwatatu ndundalibambila kuza kumuswaya, nkabela nsikooyoomulemena pe, nkaambo teensi imbono zyanu nzinjanda, ndinywe nubeni. Nkaambo bana tabeelede kuyobweda bazyali babo, pe, bazyali mbibeelede kuyobweda bana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.14",
            "verseOrgIds": [
              "2CO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.17"
              },
              "items": [
                {
                  "text": "Flp 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbubo mebo cilandibotezya kusowa zintu zyangu zyoonse akulisowa ndemwini nkaambo kamyuuya yanu. Lino na luyando ndunjanda ndinywe ndupati cakwiinda, sa luyando lulakonzya kuceya",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.15",
            "verseOrgIds": [
              "2CO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.15",
            "verseOrgIds": [
              "2CO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubo, teendakamulemena pe. Pele kulaambwa kuti ndakali mupyungi, aboobo ndakamunyanga calweeno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.16",
            "verseOrgIds": [
              "2CO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa mbukubede? Sa ndakamunyanzya cintu kumaanza aabantu abo mbundakamutumina? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.17",
            "verseOrgIds": [
              "2CO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.6"
              },
              "items": [
                {
                  "text": "2 Kor 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.16+2CO.8.17+2CO.8.18"
              },
              "items": [
                {
                  "text": "16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakakumbila Tito kuti amuswaye, alimwi antoomwe anguwe ndakatuma oyo mukwesu umwi, Sa Tito wakamunyanzya cintu? Aswebo sa teetwakeenda awe mu-Muuya omwe nguwenya? Sa teetwakeenda antaamo zyomwe?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.18",
            "verseOrgIds": [
              "2CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mulayeeya kuti kumajwi aya manji ndalikankaizya buyo sa? Pe, tulaamba muli-Kristo kubusyu bwa-Leza, nkabela makani oonse ngotwaamba, nubayandwi, ngaakumuyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.19",
            "verseOrgIds": [
              "2CO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
