              "items": [
                {
                  "text": "14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kanjikanji ndili mumisinzo, ndajana matambo aakumilonga, matambo aabacamukwapa, matambo aakuba-Judama, matambo aakubamasi, matambo aamumunzi, matambo aamusokwe, matambo aamulwizi, amatambo aakubabunyina babeji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
