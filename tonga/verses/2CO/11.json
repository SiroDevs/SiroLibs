                "loc": "PHP.3.5"
              },
              "items": [
                {
                  "text": "Flp 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa mba-Hebrayo? Ambebo ndi mu-Hebrayo. Sa mba-Israyeli? Ambebo ndi mu-Israyeli. Sa mbalunyungu lwa-Abrahamu? Ambebo ndi walunyungu lwa-Abrahamu­, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.22",
            "verseOrgIds": [
              "2CO.11.22"
            ]
          }
        },
        {
