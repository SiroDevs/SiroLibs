              "items": [
                {
                  "text": "Dt 25:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuba-Juda ndakakwipaulwa kosanwe zyuumo, kwabula cimwi buyo kuti zibe makumi one, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.24",
            "verseOrgIds": [
              "2CO.11.24"
            ]
          }
        },
