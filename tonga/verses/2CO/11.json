                "loc": "1CO.15.10"
              },
              "items": [
                {
                  "text": "1 Kor 15:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa mbasimilimo ba-Kristo? Ndaamba cabusondosi, Mebo ndainda, Ndabainda kumapakasyo, ndabainda kumaange, ndakwipaulwa zyuumo cakwiinda, kanjikanji ndili mulufu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.23",
            "verseOrgIds": [
              "2CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 11:24"
          },
          "items": [
