                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lyoonse ndili mumilimo amumakataazyo, kanjikanji ndafubwa ŋonzi, ndafwa nzala anyota, kanjikanji ndaliimya kulya, ndafwa rmpeyo akubula zyakusama. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
