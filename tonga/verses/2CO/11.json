          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndafwa bweeme kwaamba kuti swebo tuli bakompeme kumakani aali boobu, Pele kumakani aali buti ngibafumba-fumba, ambebo ndafumbafumba ngaonya, Ndaamba mbuli cabufubafuba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
