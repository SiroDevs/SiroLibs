              "2CO.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.12"
              },
              "items": [
                {
                  "text": "1 Kor 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ambweni ndakabisya kukulibombya kuti inywe mukasumpuzigwe, nkaambo ndakamukambaukila makani aa-Leza cakutapegwa cintu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.7",
            "verseOrgIds": [
              "2CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.10"
              },
              "items": [
                {
                  "text": "Flp 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakanyanzya imbungano zimwi, ndakavola kulinzizyo, kuti nkagwasye ndinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.8",
            "verseOrgIds": [
              "2CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.15+PHP.4.16+PHP.4.17+PHP.4.18"
              },
              "items": [
                {
                  "text": "Flp 4:15-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.13"
              },
              "items": [
                {
                  "text": "2 Kor 12:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ciindi ncindakacili kulindinywe ndaka bula bulilu, nekubaboobo teendakakataazya muntu naba omwe, nkaambo babunyina bazwa ku-Makedoniya bakandiiata kabotu akundipa zintu nzindakali kubula. Aboobo ndakalikasya muziyanza zyoonse kumulemena, nkabela nzoolikasya obo lyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.9",
            "verseOrgIds": [
              "2CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.15"
              },
              "items": [
                {
                  "text": "1 Kor 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli lusinizyo lwa-Kristo mbululi mulindime, taakwe muntu uuyoondisinkila olu lulikankaizyo mumasi oonse aa-Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.10",
            "verseOrgIds": [
              "2CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino nkaambonzi? Sa nkukuti nsimuyandi? Leza nguuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pe, nzooya kuya bucita mbubonya mbuncita lino, kuti nkabatesule aziimino zyabo abo bantu bayanda kulikankaizya cakwaamba kuti balyeelene aswebo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.12",
            "verseOrgIds": [
              "2CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.17"
              },
              "items": [
                {
                  "text": "2 Kor 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.2"
              },
              "items": [
                {
                  "text": "Flp 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo aba bantu mbaapostolo babeji, mbasimilimo basilweeno, mbibalisandula mbuli baapostolo baKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.13",
            "verseOrgIds": [
              "2CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela aya makani taagambyi pe, nkaambo Saatani mwini alakwe ulalisandula mbuli angelo wamumuni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.14",
            "verseOrgIds": [
              "2CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo tacili cintu cipati na balanda bakwe abalo balalisandula mbuli balanda babululami. Mamanino aabaaba azooba mbuli milimo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
