                "loc": "1CO.5.1"
              },
              "items": [
                {
                  "text": "1 Kor 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakuli ndaba wakafwisya buusu, teensi ndime endike ngwakausya pe, wakamuusya anywebo (nkukuti bamwi akati kanu, nkaambo nsikonzyi kuyungizizya kukwaamba nyoonse). ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.5",
            "verseOrgIds": [
              "2CO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Citapatizyo cabanamaleya banu cilazulila muntu oyo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.6",
            "verseOrgIds": [
              "2CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "aboobo kuciindi ecino muleelede kulekelela muntu oyo caluzyalo akumuumbulizya, kuti ataindi kulemenwa abuusu bunji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.7",
            "verseOrgIds": [
              "2CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamukumbila kuti mumuboozye muluyando lwanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.8",
            "verseOrgIds": [
              "2CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.15"
              },
              "items": [
                {
                  "text": "2 Kor 7:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo cintu ncindakamulembela nceeci, kuti nkazibe ziyanza zyanu mbuzibede, na mulacita zyoonse nzimulaililwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.9",
            "verseOrgIds": [
              "2CO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.16"
              },
              "items": [
                {
                  "text": "Lk 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mwalekelela muntu cintu, ndamulekelela ambebo. Nkaambo mebo, na ndamulekelela cintu, nkaambo kandinywe nkindakamulekelela kumeso aa-Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.10",
            "verseOrgIds": [
              "2CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.31"
              },
              "items": [
                {
                  "text": "Lk 22:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti tutapubbulwi kuli-Saatani, nkaambo tatuli bafubafuba batezi makanze aakwe mbwaabede.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
            "verseOrgIds": [
              "2CO.2.11"
            ]
          }
        }
      ]
