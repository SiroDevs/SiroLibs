                "loc": "1CO.16.9"
              },
              "items": [
                {
                  "text": "1 Kor 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nindakasika ku-Trowa kukukambauka Makani Mabotu aa-Kristo, ndakajalwidwa mulyango mu-Mwami, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele moyo wangu teewakakede kabotu nkaambo kakutajana Tito mukwesu, mpawo ndakabalaya, ndakainka ku-Makedoniya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Leza alumbwe! Ikuti lyoonse buyo ulatweenzya buzunda muli-Kristo, nkabela bweema bwakuzibwa kwakwe ulabumwaisya koonse koonse kumaanza esu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.18"
              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kumeso aa-Leza tuli bweema bubotu bwa-Kristo akati kabantu boonse, nibaba abo bali mukufutuka nibaba abo bali mukusweeka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.5"
              },
              "items": [
                {
                  "text": "2 Kor 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.34"
              },
              "items": [
                {
                  "text": "Lk 2:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulibaabo tuli bweema bwakujaya buleta lufu, pele kulibaaba tuli bweema bwakuponya buleta buumi. Ino nguni uuzulila milimo eyi sa? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.12"
              },
              "items": [
                {
                  "text": "2 Kor 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.11"
              },
              "items": [
                {
                  "text": "1 Pet 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa teensi ndiswe? Nkaambo tatuli mbuli banjibanji babisizya makani aa-Leza, pe, tuli bantu benibeni, tuli bantu ba-Leza, tulaamba cakusinizya makani aa-Kristo mbuli kumeso aa-Leza.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
