              "attrs": {
                "loc": "1CO.4.21"
              },
              "items": [
                {
                  "text": "1 Kor 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mumoyo wangu ndakalibeteka kuti nsikonzyi kuza kuzoomuswaya lwabili cabuusu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.1",
            "verseOrgIds": [
              "2CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo na ndamufwisya buusu, lino nguni uunoondikondezya sa? Teensi oyo nguwenya ngundafwisya buusu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakonya nkindakamulembela, kuti kuciindi cakuza kwangu intafwisigwi buusu kulimbabo beelede kundikondezya, nkaambo ndakalilipamikizizye kuti kukondwa kwangu nkukukondwa kwanu anywebo nyoonse: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.31"
              },
              "items": [
                {
                  "text": "Inc 20:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakamulembela cakupenga loko acakuciswa mumoyo amisozi minji, nkabela oku teekwakeensi kwakumufwisya buusu, pe, kwakali kwakumuzibya luyando lupati ndunjisi kulindinywe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
