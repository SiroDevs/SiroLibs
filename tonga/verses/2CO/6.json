              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulomo wesu wamulakamina, nuba-Korinto, moyo wesu ulijulidwe kumeso aanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teensi kulindiswe nkumusyaankene pe, mulisyaankene mumyoyo yanu nubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.14"
              },
              "items": [
                {
                  "text": "1 Kor 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndamwaambila mbuli bana, Atupane maanza aasokwe. Anywebo amujule myoyo yanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
