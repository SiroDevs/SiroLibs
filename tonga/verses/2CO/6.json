              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo wati,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
