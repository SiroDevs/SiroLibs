                "loc": "1CO.2.4"
              },
              "items": [
                {
                  "text": "1 Kor 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mumajwi aalusinizyo, munguzu zya-Leza. Tulabelesya zintu zyakulwisya zyabululami kumaanza oonse obile niliba lyalulyo niliba lyalumwensi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikuba kuciindi cakulemekwa nikuba kuciindi cakuubaansigwa, nikuba kuciindi campuwo imbi nikuba kuciindi campuwo imbotu, Tulaambwa kuti mbabeji, anukuti tuli bantu benibeni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.10"
              },
              "items": [
                {
                  "text": "2 Kor 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.18"
              },
              "items": [
                {
                  "text": "Int 118:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tulaambwa kuti batazibidwe, anukuti tulizibidwe kabotu. Tulaambwa mbuli bafu, anukuti tuli baumi. Tuliumidwe, nekubaboobo tatufwide. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.12"
              },
              "items": [
                {
                  "text": "Flp 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tuliuside, nekubaboobo tuli mukukondwa lyoonse, Tuli bacete nekubaboobo tulaletela bantu banji buvubi. Tuli basikasokomwena, nekubaboobo tulivubide zintu zyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        }
      ]
