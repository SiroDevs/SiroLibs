                "loc": "1TI.4.12"
              },
              "items": [
                {
                  "text": "1 Tim 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mubusalazi, muluzibo, mukukazika moyo, mubuuya, mu-Muuya Uusalala, muluyandisyo lwinilwini, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
