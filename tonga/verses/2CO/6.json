                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuli mbutuli basimulimonyina Leza, tulamukumbila, kuti luzyalo lwa-Leza ndumutambwide lutabi lwabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
