                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Intempele ya-Leza ilijisi makaninzi amituni? Nkaambo swebo tuli intempele ya-Leza muumi, mbuli mbwaamba Leza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
