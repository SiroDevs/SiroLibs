                  "text": "2 Kor 11:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "muzyuumwa, mumaange, mumapyopyongano, mumapakasyo, mukufubwa lonzi, mumazala, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
