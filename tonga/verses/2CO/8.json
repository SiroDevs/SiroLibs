      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.26"
              },
              "items": [
                {
                  "text": "Rom 15:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakwesu, tulamulwiida makani aaluzyalo lwa-Leza nduzipedwe imbungano zyaku-Makedoniya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikuti nikuba kuciindi ncibakali mukati kalusunko lwamapenzi mapati, alimwi bakali mubucete bunji, kukondwa kwabo kwakapaya akucita kuti buuya bwabo buvule. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.2",
            "verseOrgIds": [
              "2CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni bakapa mbuli inguzu zyabo, ee, kwiinda inguzu zyabo, nkabela makani aya akazwa mumyoyo yabo beni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.3",
            "verseOrgIds": [
              "2CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.1"
              },
              "items": [
                {
                  "text": "2 Kor 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.29"
              },
              "items": [
                {
                  "text": "Inc 11:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakatukumbila camoyo woonse kuti bazumizigwe kuba acaabilo camilimo eyi yakugwasya basalali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.4",
            "verseOrgIds": [
              "2CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela teebakacita ayo luzutu ngitwakali kusyoma, pele kukusaanguna bakalipa beni mumaanza aa-Mwami, aboobo bakalipa kulindiswe, mbubonya mbwaakayanda Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.5",
            "verseOrgIds": [
              "2CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nciceeco ncindakakumbila kuli-Tito kuti ailondole kulindinywe eyi milimo njiyonya njaakatalikide kale. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.6",
            "verseOrgIds": [
              "2CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.5"
              },
              "items": [
                {
                  "text": "1 Kor 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.1"
              },
              "items": [
                {
                  "text": "16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuli mbumwiinda kucita kabotu muzintu zyoonse, mulusyomo amukwaamba amuluzibo amubusungu boonse amuluyando ndumujisi kulindiswe, amukainde kucita kabotu mumilimo eyo ayalo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsili mukwaamba cakulailila pe, pele ndayanda kubelesya busungu bwabantu bamwi kukusunka luyando lwanu nubeni na ndwinilwini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.8",
            "verseOrgIds": [
              "2CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.20"
              },
              "items": [
                {
                  "text": "Mt 8:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulizi mbulubede luzyalo lwa-Mwami wesu Jesu Kristo, nkaambo walo wakali muvubi, nekubaboobo wakaba mucete nkaambo kandinywe, kuti bucete bwakwe bumuletele buvubi nywebo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino njanda kumulwiida mbunjeeya kumakani aya. Muleelede kucita milimo eyi, nkaambo mwakali ndinywe mwakaba bataanzi mulinjiyo, nikuba kukucita nikuba kukukanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.10",
            "verseOrgIds": [
              "2CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubo, lino amulondole kukwiicita, Mbuli mbumwakasungwaala kukanza, amulondole kucita mbubonya obo, nkukuti mbuli buvubi bwanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.27"
              },
              "items": [
                {
                  "text": "Tus 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.43"
              },
              "items": [
                {
                  "text": "Mk 12:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ncibotu kuti muntu asungwaale kupa mbuli buvubi bwakwe mbwajisi, takonzyi kupa ncatajisi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takweensi kwaamba kuti bamwi balalemununwa anukuti nywebo mulalemenwa, pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.13",
            "verseOrgIds": [
              "2CO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.12"
              },
              "items": [
                {
                  "text": "2 Kor 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngemakani akweelanya buyo. Kuciindi ecino lwiindano lwanu lulazulila kubula kwabo, kuti lwiindano lwabaabo lukazulile kubula kwanu anywebo, kube lweelano, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.18"
              },
              "items": [
                {
                  "text": "Kul 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mbuli mbukulembedwe kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalumba Leza nkaambo kakuti mumoyo wa-Tito ulibikide obo busungu mbubonya bwakulindinywe mbutujisi swebo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.16",
            "verseOrgIds": [
              "2CO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo wakazumina ciindi ncitwakali kumukombelezya, pele walo mwini wakainda kusungwaala kuza kumuswaya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.17",
            "verseOrgIds": [
              "2CO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela antoomwe anguwe twatuma oyo mukwesu uulumbwa kumbungano zyoonse nkaambo kamilimo yakwe njacitila Makani Mabotu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.18",
            "verseOrgIds": [
              "2CO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.10"
              },
              "items": [
                {
                  "text": "Gal 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi nguwenya wakasalwa kumbungano kuti tweende awe mukumana milimo eyi yaluzyalo niitwapegwa kukuletela Mwami bulemu, Ambebo ndakazumina, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo nkucili cintu ncincenjela, Nsiyandi kuti muntu naba omwe atupe mulandu kumakani aazilumbo ezi zipati zili mumaanza esu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.20",
            "verseOrgIds": [
              "2CO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.4"
              },
              "items": [
                {
                  "text": "Tus 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo tulalabilila ziimbo zibotu koonse koonse, nikuba kumeso aa-Mwami nikuba kumeso aabantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi antoomwe ambabo ndatuma mukwesu. Oyo ndimubwene kanjikanji kuti ulisungweede mumakani manji, nkabela kuciindi ecino ulainda kusungwaala nkaambo kalusyomo lupati ndwajisi mulindinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.22",
            "verseOrgIds": [
              "2CO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.13"
              },
              "items": [
                {
                  "text": "2 Kor 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
