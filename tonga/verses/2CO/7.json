              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nikuba nitwakasika ku-Makedoniya teetwakakatalukwa mumubili wesu, pe, twakalipengede muzintu zyoonse. Anze kaali makondo, mukati kamuli mayoofu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.5",
            "verseOrgIds": [
              "2CO.7.5"
            ]
          }
        },
        {
