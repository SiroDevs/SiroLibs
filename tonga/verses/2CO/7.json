                  "text": "Inc 20:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amutujulile myoyo yanu. Tatucitilide muntu cakutalulama, tatubisisizye muntu, tatuondonganide muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
            "verseOrgIds": [
