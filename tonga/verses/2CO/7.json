            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.2"
              },
              "items": [
                {
                  "text": "Is 66:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Leza sikuumbulizya abo bakatede mumyoyo yabo wakatuumbulizya swebo kukusika kwa-Tito. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela kakuteensi kusika kwakwe kulike kwakatuumbulizya, pele alwalo olo luumbulizyo ndwaakaumbulizigwa kulindinywe, nkaambo wakatulwiida mbumutusukamina akutulilila akutusungwaalila, aboobo mebo ndakabotelwa loko,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
