          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.11+2CO.6.12+2CO.6.13"
              },
              "items": [
                {
                  "text": "2 Kor 6:11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Teensi kumupa mulandu nkundaambila obo, pe, nkaambo mbuli mbundaamba kale, muli mumyoyo yesu, tuli anywe lyoonse nimuba mukufwa nimuba mukupona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.3",
            "verseOrgIds": [
              "2CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkapati kaanzambwene nkenjisi kulindinywe, nkupati kulikankaizya kwangu nkwendikankaizizya ndinywe. Ndizwide luumbulizyo, moyo wangu wafwasuka busekelezi akati kamapenzi esu oonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        }
      ]
    },
