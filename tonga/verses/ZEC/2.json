              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.9"
              },
              "items": [
                {
                  "text": "Dt 32:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova ulakona Juda, cibe caabilo cakwe munyika iisalala, nkabela uyoosala lubbo Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
