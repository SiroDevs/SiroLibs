              "items": [
                {
                  "text": "Kul 12:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.33"
              },
              "items": [
                {
                  "text": "Ezk 33:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba obo bantu bamisyobo minji bayooliswananya a-Jehova, bayooba bantu bangu, alimwi njookala akati kanu. Mpawo muyooziba kuti Jehova wamakamu nguwakandituma kulindinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
