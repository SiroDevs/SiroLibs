              "items": [
                {
                  "text": "Zek 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ndakatambya meso aangu, ndakabona muntu uujisi intambo yakweelesya mujanza lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.1",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
