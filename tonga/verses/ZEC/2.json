            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.23"
              },
              "items": [
                {
                  "text": "Ciy 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mebo njoomubeda mbuli bulambo bwamulilo bwakumuzyunguluka mbwaamba Jehova, alimwi njooba bulemu mulinguwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        }
      ]
