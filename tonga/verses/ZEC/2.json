            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.1"
              },
              "items": [
                {
                  "text": "Ciy 11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakamubuzya kuti, Ino uya kuli? Wakati, Ndaya kukweeleka Jerusalemu, tubone bwaamba bwawo mbububede abulamfu bwawo mbububede. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo angelo ngundakali kwaambaula awe wakanyamuka, aumwi angelo wakeza kuzoomucinga, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.3",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.10"
              },
              "items": [
                {
                  "text": "Ezk 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakamwaambila kuti, Cijaana, ukaambile mukubusi oyo kuti, Jerusalemu uyookalwa mbubonya mbuli minzi iitazyungulukidwe malambo, nkaambo kabunji bwabantu abwaŋombe mulinguwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.4",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
