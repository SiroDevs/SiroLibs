                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.5"
              },
              "items": [
                {
                  "text": "Mt 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo ndakaba mweembeli wambelele izyakaamba kujayigwa basikusambala imbelele. Mpawo ndakalibwezela misako yobile. Umwi ndakauulika izina lya-Buuya, aumwi ndakauulika izina lya-Luswanaano. Nkabela ndakeembela imbelele. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.7"
              },
              "items": [
                {
                  "text": "Hos 5:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mumwezi omwe ndakalobya beembeli botatwe, Moyo wangu wakabakalalila, amyoyo yabo ayalo yakandisampaula. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Jer 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ndaka ti, Nsikooba mweembeli wanu pe. Kufumbwa iifwa, ifwe, Kufumbwa iinyonyooka, inyonyooke. Azyalo zisyaala zilyane, imwi aimwi nyama yanyeenzinyina, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ndakabweza musako wangu Buuya, ndautyola, kutondezya kuti ndatyola cizuminano cangu ncitutangene azisi zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakatyoka mubuzuba obo mbubonya, nkabela basikusambala imbelele ibakali kundilangilizya bakaziba kuti ndijwi lya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.32"
              },
              "items": [
                {
                  "text": "Kul 21:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.15"
              },
              "items": [
                {
                  "text": "Mt 26:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.9+MAT.27.10"
              },
              "items": [
                {
                  "text": "Mt 27:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ndakabaambila kuti, Na ncibotu mumeso aanu, amundipe cakuvola cangu, pele na taciboti, amuleke buyo. Lino bakandeelekela zyakuvola zyangu, mali aansiliva aali makumi otatwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakandaambila kuti, Koasowela muciyobwedo camali. Mbuboobo mbundakalaililwa kubelesya oyo muulo mulemu ngubakandibikila. Aboobo ndakabweza ayo mali aansiliva aali makumi otatwe, akwaasowela muciyobwedo camali muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo ndakatyola musako wangu wabili, Luswanaano, kuti ndobye bunyina bwa-Juda a-Israyeli,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        }
      ]
    },
