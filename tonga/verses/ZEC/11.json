              "items": [
                {
                  "text": "Joh 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.6"
              },
              "items": [
                {
                  "text": "Mik 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe kuliyooyo mweembeli wangu mutolo uuleka imbelelel Ipanga limuume akuboko kwakwe akuliso lyakwe lyalulyo! Kuboko kwakwe kuyuminine, aliso lyakwe lyalulyo libe acimbolyo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
