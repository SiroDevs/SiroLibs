                "loc": "EZK.34.2"
              },
              "items": [
                {
                  "text": "Ezk 34:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Kobweza alimwi zibelesyo zyamweembeli mutolo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndaamba kubika mweembeli omu munyika uuli boobo. Taakwe makani aambelele zifwa, nikuba kuyandaula zisoweka, nikuba kusilika zityokede, nikuba kusanina zipona. Ulalya buyo nyama yazineneede akukwamauna insumba zyazyo zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
