                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basikuzyuula balazijaya cakutapegwa milandu. Basikuzyuuzya balati, Jehova alumbwe, ndaba muvubil Basikuzyeembela tabazifwidi insoni pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo bantu banyika ino nsikooyoobafwida limbi luzyalo, mbwaamba Tehova. Amubone! Njooaba bantu, umwi aumwi mumaanza aasikumweembelela, amumaanza aamwami wakwe. Bayoosaala nyika yoonse, nkabela nsikooyoobavuna mumaanza aabo pe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        }
      ]
    },
