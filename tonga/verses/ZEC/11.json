              "type": "tag",
              "attrs": {
                "loc": "JER.23.1"
              },
              "items": [
                {
                  "text": "Jer 23:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.12"
