              "attrs": {
                "loc": "1CO.1.27+1CO.1.28+1CO.1.29+1CO.1.30+1CO.1.31"
              },
              "items": [
                {
                  "text": "1 Kor 1:27-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jehova uyootaanguna kufutula zilao zya-Juda, kuti bulemu bwaluzubo lwa-Davida abulemu bwabantu bakede mu-Jerusalemu butakomeni kwiinda ibwa-Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.10"
              },
              "items": [
                {
                  "text": "Joel 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubuzuba obo Jehova uyoobikila bantu bakede mu-Jerusalemu intobo, aboobo amuntu muniini akati kabo boonse uyooba mbuli Davida, aluzubo lwa-Davida luyooba mbuli Leza, mbuli angelo waJehova, kubusyu bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mubuzuba obo njooyandaula kunyonyoona bantu bamasi oonse beza kuzoolwisya Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        }
      ]
    },
