              "items": [
                {
                  "text": "Mt 24:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi njootilila luzubo lwa-Davida abantu bamu-Jerusalemu muuya waluzyalo alwakukumbila, kuti nibayoomulanga oyo ngubayaside bakamulile mbubonya muntu mbalila mwanaakwe simuzyalwaalike, akoomoka mbubonya muntu mboomokela mwanaakwe mutaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.37"
              },
              "items": [
                {
                  "text": "Inc 2:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.24"
              },
              "items": [
                {
                  "text": "2 Mak 35:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulila kwamubuzuba obo mu-Jerusalemu kuyooba kupati mbuli kulila kwa-Hadadirimoni mumumpata wa-Megidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika iyoolila, ciinga cimwi acimwi nsininsini, luzubo lwa-Davida alulike, abanakazi babo abalike, aciinga caluzubo lwaNatani acilike, abanakazi babo abalike, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "luzubo lwa-Levi alulike, abanakazi babo abalike, luzubo lwa-Simeyi alulike, abanakazi babo abalike, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "anzubo zyoonse zisyeede azilike, abanakazi bazyo abalike.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
