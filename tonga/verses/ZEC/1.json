                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mumwezi wamusanu aitatu, mumwaka wabili wa-Dariyo, ijwi lyaJehova lyakasika kuli-Zekariya mwana wa-Berekiya mwana wa-Ido, musinsimi, lyakati, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
