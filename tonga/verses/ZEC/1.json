            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wakabakalalila loko bamauso. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
