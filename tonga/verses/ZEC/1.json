          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.5"
              },
              "items": [
                {
                  "text": "Jer 25:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.19"
              },
              "items": [
                {
                  "text": "Mik 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.7"
              },
              "items": [
                {
                  "text": "Mal 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.20"
              },
              "items": [
                {
                  "text": "Lk 15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako kobaambila kuti, Mbuboobu mbwaamba Jehova wamakamu. Amuboole kulindime, mbwaamba Jehova wamakamu, lino ambebo njooboola kulindinywe, mbwaamba Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
