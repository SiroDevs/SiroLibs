                "loc": "ISA.40.1"
              },
              "items": [
                {
                  "text": "Is 40:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
