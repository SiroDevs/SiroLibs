              "items": [
                {
                  "text": "Inc 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutakozyani abamauso pe, nkaambo basinsimi baciindi bakaboongolweda kuti, Mbuboobu mbwaamba Jehova wamakamu, Amupiluke kuzwa kunzila zyanu zyabubi akuleka milimo yanu mibi. Nekubaboobo teebakamvwa, teebakandibikila myoyo yabo, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino bamauso banu bali kuli? Abalo basinsimi sa balakalilila akutamani? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Is 55:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.18"
              },
              "items": [
                {
                  "text": "Malo 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele majwi aangu amilazyo yangu njindakalailila balanda bangu basinsimi, sa teeyakeenzya bamauso banu na? Elyo bakeempwa akwaamba kuti, Jehova wamakamu mbuli mbwaakakanza kutucitila nkaambo kanzila zyesu ancito zyesu, watucitila mbubonya obo ncobeni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
