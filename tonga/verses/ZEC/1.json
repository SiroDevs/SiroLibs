            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "Jer 29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jehova wakatyaba angelo ngundakaambaula awe majwi aaluzyalo aakuumbulizya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.18"
              },
              "items": [
                {
                  "text": "Joel 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.2"
              },
              "items": [
                {
                  "text": "Zek 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino angelo ogundakaambaula awe wakandaambila kuti, Ongolola kuti, Mbuboobu mbwaamba Jehova wamakamu. Ndasungwaalila loko Jerusalemu a-Zioni, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.6"
              },
              "items": [
                {
                  "text": "Is 47:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abantu bamasi bakede cakuliiba ndabakalalila loko, nkaambo mebo ndakanyema buniini buyo pele balo bakavuzya mapenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        },
