                "loc": "ZEC.7.5"
              },
              "items": [
                {
                  "text": "Zek 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo angelo wa-Jehova wakati, O Jehova wamakamu, ulaleka lili kukaka kubafwida luzyalo, ba-Jerusalemu aminzi ya-Juda, mbokalalila myaka eyi yoonse iili makumi aali musanu aabili? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
