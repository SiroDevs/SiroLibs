            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mumwaka wane wamwami Dariyo, ijwi lya-Jehova lyakasikila Zekariya, mubuzuba bwane bwamwezi wamusanu aine, nkukuti mwezi wa-Kisilevi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu ba-Beteli bakalitumide Syarezeri a-Regemeleki abantu bakwe kuti bakatontozye busyu bwa-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.9"
              },
              "items": [
                {
                  "text": "Dt 17:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.7"
              },
              "items": [
                {
                  "text": "Mal 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akubuzya bapaizi bamuŋanda ya-Jehova wamakamu abasinsimi kuti, Sa tuleelede kulila akuliimya kulya mumwezi wasanu, mbubonya mbutwakali kucita myaka minji yakamana? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo ijwi lya-Jehova wamakamu lyakandisikila, lyakati, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.12"
              },
              "items": [
                {
                  "text": "Zek 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.4"
              },
              "items": [
                {
                  "text": "Is 58:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.16"
              },
              "items": [
                {
                  "text": "Mt 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.6"
              },
              "items": [
                {
                  "text": "Rom 14:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambila bantu boonse banyika abapaizi kuti, Ciindi eco nimwakali kuliimya kulya akulila mumwezi wasanu amumwezi wamusanu aibili, eyi myaka yoonse iili makumi aali musanu aabili, sa ncobeni nkaambo kangu ncimwakali­ kuliimya kulya? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.5",
            "verseOrgIds": [
              "ZEC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi nimulya akunywa, teensi ndinywe nubeni nimulilida animulinywida? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.6",
            "verseOrgIds": [
              "ZEC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.26"
              },
              "items": [
                {
                  "text": "Jer 17:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa aya teensi majwi Jehova ngaakaamba kumulomo wabasinsimi baciindi, Jerusalemu nuukacikedwe bantu akukala caluumuno, aminzi yawo iizyungulukide, anyika yakumusanza acisi catulundulundu zyoonse zyakalikedwe bantu?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ijwi lya-Jehova lyakasikila Zekariya, lyakati, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova wamakamu. Amubeteke imbeta zyabuswini. Amucitile umwi aumwi mweenzinyina luse aluzyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutapenzyi banabutema abamusyaala amweenzu abatengwana. Kutabi uukanza mumoyo wakwe kucitila mweenzinyina bubi, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.10",
            "verseOrgIds": [
              "ZEC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bakakaka kuswiilila, bakamufutatila cakukataazya, akuyumya matwi aabo kuti bataswiilili. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.11",
            "verseOrgIds": [
              "ZEC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo yabo bakaiyumya mbuli ibbwe liyuma nta, kuti bataswiilili mulao amajwi Jehova wamakamu ngaakatuma kunguzu zyamuuya wakwe kumilomo yabasinsimi baciindi. Nkaambo kako kwakabuka bukali bupati kuzwa kuli-Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbubonya mbundakaita mebo pele teebakamvwa, bayooita abalo pele nsikooyoobamvwa, mbwaamba Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ndakabamwaisya akambizi akati kamisyobo yoonse yabantu njibatezi. Aboobo nyika yakaba matongo buyo, katakwe muntu iwakali kweendeenda nanka kukala mulinjiyo. Nyika imbotu bakainyonyoona buyo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.14",
            "verseOrgIds": [
              "ZEC.7.14"
            ]
          }
        }
      ]
    }
