                  "text": "Is 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubuzuba obo Jehova Leza wabo uyoobavuna nkaambo nimbelele zyabantu bakwe. Bayoomweka anyika yakwe mbubonya mbuli mabwe amusini mweebesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
