                  "text": "Kul 24:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayebo, nkaambo kabulowa bwacizuminano cesu, njoolobolola baange bako bamucilindi citakwe maanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.11",
