          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuboole kumacijilo aanu, inywe nubaange balangila lufutuko, Sunu ncobeni ndamwaambila kuti njoomuboozezya kobile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.12",
