          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo musyobo wa-Juda ndaupeta ube buta bwangu, aba-Efraimu baba mivwi yangu yakufusya buta. Njoovukauzya bana bako, O Zioni, cakulwisya bana bako, O cisi caba-Helene, Muyooba mbuli ipanga lyasilumamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Jehova uyoolibonya akati kabo. Mivwi yakwe iyoozwa mbuli lulabi. Mwami Jehova uyoolizya mweembo ukuya bweenda mutumbizi twakumusanza. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
