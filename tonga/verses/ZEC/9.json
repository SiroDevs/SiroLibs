                }
              ]
            }
          ]
        },
        {
          "text": "Awalo munzi wa-Hamati uubambene anjiyo, a-Turo a-Sidoni, nekuba kuti iili abusongo bunji. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Turo waliyakila cicijilo ciyumu, alimwi walundika insiliva mbuli bulongo angolida mbuli matombe aamumigwagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
