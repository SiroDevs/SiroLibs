              "attrs": {
                "loc": "LEV.4.25"
              },
              "items": [
                {
                  "text": "Lev 4:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova wamakamu uyuoba intobo yabo. Bayoolya akulyataula basizifusyo, nkabela bulowa bwabo bayoobunywa mbuli waini. Bayoozula mbuli mutiba na mbuli zyooko zyacipaililo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        },
