              },
              "items": [
                {
                  "text": "Ezk 26:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Mwami uyoomunyanga akuwaala imbono zyakwe zyoonse mubbonze lyamaanzi, nkabela uyootentwa amulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        },
