        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooyumya luzubo lwa-Juda akufutula luzubo lwa-Josefa. Njoobaboozya, nkaambo ndabafwida luzyalo, elyo bayooba mbuli kuti teendakabasowede, nkaambo ndime Jehova Leza wabo, njoobavwiila. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu uyooba mbuli silumamba sintaze. Myoyo yabo iyookondwa mbubakondwa basikunywa waini. Bana babo bayoobona akusekelela. Myoyo yabo iyookonwa muli-Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
