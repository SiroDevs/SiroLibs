              },
              "items": [
                {
                  "text": "1 Pet 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bukali bwangu bwabukila beembeli, abalo basolozi njoobapa mulandu, nkaambo Jehova wamakamu uyoogwasya butanga bwakwe, luzubo lwaJuda, ulababika mbuli imbizi yakwe yabulemu mukati kankondo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.23"
              },
              "items": [
                {
                  "text": "Is 22:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulimbabo momuti zwe eooko, mulimbabo momuti zwe inembe yatente, mulimbabo momuti zwe buta bwankondo, mulimbabo momuti zwe beendelezi boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayooba mbuli basilumamba bakozu balyataula basinkondonyina muntipa yamumigwagwa. Bayoolwisya, nkaambo Jehova uli abo, nkabela bayoozunda basikutanta imbizi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
