            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoobaita akubabunganya, nkaambo ndime ndabanununa, elyo bayoovula mbubonya mbubakavula kalekale. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.8",
            "verseOrgIds": [
              "ZEC.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabamwaisya akati kazisi, nekubaboobo mumasena aasakene bayoondiibaluka, aboobo bayoopona abana babo akuboola. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.9",
            "verseOrgIds": [
              "ZEC.10.9"
            ]
          }
        },
