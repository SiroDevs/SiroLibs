                  "text": "Is 49:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoobaboozya kuzwa kucisi ca-Egepita akubayobolola kuzwa ku-Asuri. Njoobasisya kucisi ca-Gileadi aku-Lebano, mane bakaate, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.10",
            "verseOrgIds": [
              "ZEC.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.13"
              },
              "items": [
                {
                  "text": "Ezk 30:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayooinda mukati kalwizi lwaku-Egepita, pele mayuwe aalwizi ayoozundwa, amabonze aamu-Nile ayooyuminina. Kulisumpula kwaAsuri kuyoobombezegwa, ankoli yabwami yaku-Egepita iyoomana. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.11",
            "verseOrgIds": [
              "ZEC.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoobayumya munguzu zya-Jehova, azina lyakwe ndiliyoobeenzya, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.12",
