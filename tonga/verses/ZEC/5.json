              },
              "items": [
                {
                  "text": "Heb 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakandaambila kuti, Olu ndutuko lumwaikide atala anyika yoonse. Nkaambo umwi aumwi uubba kuzwa sunu uyoonyonyoonwa mbubonya mbuluamba, nkabela umwi aumwi uukonka cakubeja kuzwa sunu uyoonyonyooka mbubonya mbuluamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
