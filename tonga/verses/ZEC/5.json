              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nindakaboola kutambya meso aangu, ndakabona ibbuku liya buuluka, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakandibuzya kuti, Ncinzi nciwabona? Ndakati, Ndabona ibbuku liya buuluka. Bulamfu bwalya buleelene atukokola tuli makumi obile, abwaamba bwalye buleelene atukokola tuli ikumi, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
