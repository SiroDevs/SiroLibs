            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.2"
              },
              "items": [
                {
                  "text": "Lev 15:2",
                  "type": "text"
                }
              ]
            },
            {
