          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.20"
              },
              "items": [
                {
                  "text": "Lev 7:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kobaambila kuti, Kufumbwa muntu walunyungu lwanu mumazyalani aanu oonse uuswena kufwaafwi kuzintu zisalala zyabana ba-Israyeli nzibasalazizya Jehova, nacisofweede, oyo muntu ulatandwa kubusyu bwangu. Ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
