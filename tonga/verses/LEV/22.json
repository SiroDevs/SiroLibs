            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.11"
              },
              "items": [
                {
                  "text": "My 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
