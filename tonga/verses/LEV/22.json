        },
        {
          "text": "Ambila Aroni abana bakwe kuti balipambule azintu zisalala zyabana ba-Israyeli nzibandisalazizya, kuti batasofwaazyi izina lyangu lisalalisya, Ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
