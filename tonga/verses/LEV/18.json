        },
        {
          "text": "Nyika yakasofwaazigwa, aboobo ndakaiboozezya bulumbu bweelede zibi zyayo, nkabela nyika yakaluka bantu bakede mulinjiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "name": "verse",
