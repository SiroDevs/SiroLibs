                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acalo cinswe camucizi wako, mwana wauso na mwana wabanyoko, naba muzyalwemuŋanda naba muzyalwekule utabavumbwidi cinswe pe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
