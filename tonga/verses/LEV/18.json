          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalo cinswe camunyina uso tnwaalumi, utamuvumbwidi cinswe pe; utayi kubanakwe, nkaambo mbanyoko. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
