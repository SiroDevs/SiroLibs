                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Toelede kuvumbula cinswe camucizi wauso, nkaambo ndoluzubo lwauso. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
