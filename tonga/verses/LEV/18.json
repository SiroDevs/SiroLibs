              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amucite milao yangu akubamba imbeta zyangu, mweende mulinzizyo. Ndime Jehova Leza wanu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
