              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toelede kuvumbula cinswe camucizi wabanyoko, nkaambo ndoluzubo lwabanyoko, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
