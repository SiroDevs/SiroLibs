              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutabi muntu akati kanu uuswena kulisiluzubonyina kuti amuvumbwide cinswe. Ndime Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toelede kuvumbula cinswe causo, nkokuti cinswe cabanyoko; mbubali banyoko, utabavumbwidi cinswe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
