        },
        {
          "text": "Muleelede kumusalazya, nkaambo ngonguwe uutuula zilyo zya-Leza wako; uleelede kusalala kumeso aako, nkaambo ndasalala mebo nde-Jehova uumusalazya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
