                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba bwamusanu aatatu, ulapalulwa kunyama yalulomo lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwanakazi unoocibede mubulowa bwakulisalazya kwakwe mazuba aali makumi otatwe aatatu, Atagumi cintu cisalala nanka kunjila mucikombelo mane mazuba aakulisalazya kwakwe azulile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na wazyala mwana musimbi ulasofwaala insondo zyobile, mbubonya mbuli kuciindi cakutondwa kwakwe, alimwi unoocibede mubulowa bwakulisalazya kwakwe mazuba aali makumi aali musanu alimwi amusanu abumwi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
