        },
        {
          "text": "Na cituuzyo cakwe cakutenta nimbelele nanka impongo, asale mucende uutakwe kampenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
