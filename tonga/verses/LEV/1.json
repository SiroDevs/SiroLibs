            }
          ]
        },
        {
          "text": "Lino bapaizi, bana ba-Aroni, babambe zipanzi, mutwe amafuta atala ankuni zili amulilo uuli acipaililo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
