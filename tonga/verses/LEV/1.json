              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino afunde cituuzyo akucitendaula muzipanzi zyaco, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
