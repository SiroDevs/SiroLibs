                  "text": "Matl 22:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abalo bana ba-Aroni mupaizi babike mulilo acipaililo akubamba inkuni amulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
