              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muntu waluzubo lwa-Israyeli uujaya ŋombe nanka kabelele nanka impongo mumalabba naaba anze lyamalabba, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
