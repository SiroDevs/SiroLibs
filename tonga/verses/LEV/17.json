          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambila Aroni abana bakwe abana boonse ba-Israyeli, kuti, Mbuboobu Jehova mbwaakalailila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
