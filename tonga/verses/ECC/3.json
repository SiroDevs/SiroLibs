                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.6"
              },
              "items": [
                {
                  "text": "2 Tes 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakaamba mumoyo wangu kuti, Leza uyoobeteka baluleme abasizibi boonse, nkaambo zintu zyoonse zili aciindi cazyo, makani oonse alibikilidwe ciindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mumoyo wangu ndakaamba aabana ba-Adamu kuti Leza ulabatondezya mbubabede, bazibe kuti bali mbuli banyama buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.49.12"
              },
              "items": [
                {
                  "text": "Int 49:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo cintu cisikila bantu, abanyama cilabasikila. Balo balafwa, abalo balafwa mbubonya, Boonse balijisi muuya omwe, nkabela muntu tali mubotu kwiinda banyama, nkaambo boonse mbabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.19",
            "verseOrgIds": [
              "ECC.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.19"
              },
              "items": [
                {
                  "text": "Matl 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Boonse balaya kubusena bomwe. Bakazwa kubulongo, alimwi balapiluka kubulongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
            "verseOrgIds": [
              "ECC.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taakwe muntu uuzi na muuya wamuntu ulaya kujulu, amuuya wabanyama na ulaya ansi kubulongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.21",
            "verseOrgIds": [
              "ECC.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
