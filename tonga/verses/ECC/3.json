              "items": [
                {
                  "text": "Jak 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndizi kuti zintu zyoonse nzyacita Leza tazimani; taakwe muntu uukonzya kuziyungizizya nanka kugwisya cintu kulinzizyo; Leza wakacita obo kuti bantu bamuyoowe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
