              "items": [
                {
                  "text": "Muk 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zintu ziliwo zyakaba kale, azeezyo ziyooba azyalo zyaba kale, azintu zitandidwe kale Leza ulaziyandaula.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
