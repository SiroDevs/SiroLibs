                  "text": "Rom 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wacita kuti zintu zyoonse zibote kuziindi zyazyo zyeelede. Wabika bulangizi bwabuumi buteeli mumyoyo yabo, nekubaboobo muntu takonzyi kumvwisya milimo yoonse Leza njaakacita kuzwa kumatalikilo kusikila kumamanino. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizi kuti taakwe cintu cibotela bantu kwiinda eci: kukondwa akulibotezya mubuumi bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
