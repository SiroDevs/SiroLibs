                  "text": "Muk 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi cipo ca-Leza nceeci: kuti muntu alye akunywa akukondwa mumilimo yakwe yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
