              "items": [
                {
                  "text": "1 Tim 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takuzibwi na oyo muntu ulaba musongo na mufubafuba, nekubaboobo uyookona zintu zyoonse nzindakajana kumilimo yangu akubusongo bwangu ansi ano. Eci acalo ncabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
