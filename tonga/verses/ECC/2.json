        {
          "text": "Kusekaseka, ndakaamba kuti, Nkusondoka buyo; akukondwa, ndakaamba kuti, Kulagwasya nzi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
