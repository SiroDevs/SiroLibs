                  "text": "Inc 5:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncibo tu kutakonka kwiinda kutazuzikizya cikonke cako. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
