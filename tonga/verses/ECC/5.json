              "items": [
                {
                  "text": "Mt 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utafwanzyi milomo yako, amoyo wako utagubili kukwaamba makani kubusyu bwa-Leza, nkaambo Leza uli kujulu, anukuti yebo uli ansi; nkaambo kako majwi aako aceye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbubonya mbuli makataazyo manji mbwaaletela ziloto, ijwi lyamufubafuba lilaamba majwi manji. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        },
        {
