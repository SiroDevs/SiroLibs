              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu uuyandisya mali takonzyi kukuta mali, ayooyo uuyandisya imbono takonzyi kukuta impindu. Eci acalo ncabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbono na zyavula, basikuzilya abalo balavula; lino mukamwini ulajana impindunzi, cita kubona ameso aakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iŋonzi zyasimilimo zilalweela nekuba kuti ulalya cinji na ciniini, pele kukutisya kwamuvubi takumuzumizyi koona.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
