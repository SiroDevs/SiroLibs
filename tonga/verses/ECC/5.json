        {
          "text": "Na wakonkezya Leza cikonke, utamuki kucizuzikizya, nkaambo tabotelwi bafubafuba; zuzikizya ncowakakonkezya, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.4",
            "verseOrgIds": [
