        },
        {
          "text": "Na mucisi cimwi wabona kuti batengwana bapenzegwa abaluleme tababetekwi kabotu, utagambi kumakani aya, nkaambo silutwe ulalangwa kulisilutwenyina, alimwi silutwe mupati nkwali kwiinda boonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo mwami ulagwasya nyika iili abulimi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
