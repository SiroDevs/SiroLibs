        },
        {
          "text": "Bamba kabotu kweenda kwako ciindi cakuya kuŋanda ya-Leza, Kuza kukuswiilila nkubotu kwiinda kupa zipaizyo zyabafubafuba, nkaambo kucita cibi luzutu neebezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        },
