              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kucili cintu cibi loko ncimbwene ansi ano, nkokuti buvubi ulibujisi mukamwini nekubaboobo bulaleta mapenzi luzutu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
