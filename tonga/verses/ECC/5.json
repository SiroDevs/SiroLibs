          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obo buvubi bwasweka mukubula coolwe, aboobo ulabula cintu cakusiila mwanaakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
