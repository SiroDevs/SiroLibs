                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na zyavula ziloto, majwi aabuyo alavula, pele yebo koyoowa Leza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
