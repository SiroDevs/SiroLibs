    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi zifwide zilanunsya mafuta aasimuunde; mbubonya obo bufubafuba buniini bulabisya busongo abulemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.33"
              },
              "items": [
                {
                  "text": "Mt 6:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.1"
              },
              "items": [
                {
                  "text": "Kol 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moyo wamusongo ula­ mutola kululyo, pele moyo wamufubafuba ulamutola kulumwensi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.16"
              },
              "items": [
                {
                  "text": "Tus 13:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mufubafuba, nekuba kuciindi cakweendeenda munzila, ulabula maanu, nkabela ulazibya bantu boonse kuti mufubafuba. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.3"
              },
              "items": [
                {
                  "text": "Muk 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.24"
              },
              "items": [
                {
                  "text": "1 Sam 25:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.15"
              },
              "items": [
                {
                  "text": "Tus 25:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekuba kuti bukali bwasilutwe bwakubukila, utasii busena bwako, nkaambo kukazika moyo kulamanya milandu mipati,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkucili cintu cibi ncimbwene ansi ano, bubi buzwa kumweendelezi: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bufubafuba bulaimikwa mumasena manji malemu, anukuti bavubi balikede mumasena aasampukide. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.19.10"
              },
              "items": [
                {
                  "text": "Tus 19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndibwene bazike batantide ambizi, abasilutwe beenda ansi mbuli bazike.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
