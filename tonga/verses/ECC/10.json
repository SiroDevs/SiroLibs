              "ECC.10.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.3.4"
              },
              "items": [
                {
                  "text": "Is 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maawe kulinduwe, O nyika, mwami wako naacili mulombe, abasilutwe bako nibacili mukulya cifumofumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.31.4"
              },
              "items": [
                {
                  "text": "Tus 31:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uli acoolwe, O nyika, mwami wako na ngumwana wacisi, abasilutwe bako nibalya kuciindi ceelede, nkokuti cakukuta, citali cakukolwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kabutole, maseketi alabola, akaambo kabutete bwamaanza iŋanda inooloka. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilyo cilacitwa kukusekelela, awaini ulabotya buumi, nkabeia mali ngaacita zyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.28"
              },
              "items": [
                {
                  "text": "Kul 22:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utatukili mwami, nimuba mumiyeeyo yako; utatukili bavubi, nimuba muŋanda yako yakoona; nkaambo muyuni wakujulu ulatola majwi aako, asimababa ulaamba makani.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.20",
            "verseOrgIds": [
              "ECC.10.20"
            ]
          }
        }
      ]
    }
