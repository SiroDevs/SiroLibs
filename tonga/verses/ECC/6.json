              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambweni Leza wapa muntu buvubi ambono abulemu, nkabela taakwe cintu ncabula akati kazintu zyoonse nzyuuyanda moyo wakwe, nekubaboobo Leza tamuzumizyi kulya, pele muntu umbi nguuzilya. Eci ncabuyo, ndipenzi ibbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
