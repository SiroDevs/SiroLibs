            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.58.8"
              },
              "items": [
                {
                  "text": "Int 58:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na muntu wazyala bana bali mwanda, alimwi woongola myaka minji loko, nekubaboobo moyo wakwe tuukuti zintu zibotu, alimwi tazikwi kabotu, ncobeni mwana wakusowa ulijisi coolwe kwiinda nguwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaambo walo ulasika kuzintu zyabuyo, alimwi ulapiluka mumudima, azina lyakwe lilavumbwa mumudima; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tana kubona izuba nikuba kuziba cintu, nekubaboobo wajana cilyokezezyo kwiinda nguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wapona myaka iili cuulu na kwiinda kobile, nekubaboobo takuti bubotu-ma! Sa tabayi boonse kubusena bomwe buyo?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
