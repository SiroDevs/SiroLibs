                "loc": "ROM.9.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa cintu caba cakaulikwa kalekale, Kulizizilwe muntu mbwabede, Takonzyi kukazyanya a-Singuzu kwiinda nguwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majwi manji alavuzya zintu zyabuyo? Alagwasya buti muntu? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.14"
              },
              "items": [
                {
                  "text": "Jak 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.6"
              },
              "items": [
                {
                  "text": "Int 39:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngwani uuzi cintu cibotela muntu mumazuba mace nga pona ansi, mazuba aabuyo aafwambaana kumana mbuli cinzinzimwa? Ngwani uubwene makani aaboola musule lyakwe ansi ano?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
