            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.6+1TI.6.7+1TI.6.8"
              },
              "items": [
                {
                  "text": "1 Tim 6:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Milimo yoonse njabeleka muntu njamulomo buyo, pele takuti pe, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musongo ulijisi coolwe cili buti kwiinda mufubafuba? Alakwe mucete uucenjede uupona kabotu ulijisi coolwe cili buti? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulya imbono meso nzyaabwene kale ncibotu kwiinda kuyandaula zintu zitaboneki, Eci acalo ncabuyo, tacikutyi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
