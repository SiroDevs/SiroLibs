                  "text": "2 Kor 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aba zilyo zyako atala lyamaanzi, nkaambo uyoozijana kwamana mazuba manji, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
