                  "text": "Rom 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sekelela, O mulombe, mubwanike bwako, amoyo wako ukondwe mumazuba aabwanike bwako. Enda munsila zyamoyo wako amukubona kwameso aako. Pele koziba kuti nkaambo kazintu ezi zyoonse Leza ulakubeteka. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.1"
              },
              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gwisya buusu mumoyo wako, akutanda makataazyo kumubili wako, nkaambo bwanike abucedo bwabuumi zyoonse nzyabuyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
