                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.16"
              },
              "items": [
                {
                  "text": "Ef 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abila bantu bali musanu ababili nanka musanu abatatu, nkaambo tozi mapenzi aaciboola ansi ano. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mayoba alizwide imvula, alatesya nyika, Na musamu wawida kumusanza na kunyika, nkuuwida musamu nkukonya oko nkuubede. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uuyeeya muuwo takonzyi kubyala, ayooyo uulanga mayoba takonzyi kutebula. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.8"
              },
              "items": [
                {
                  "text": "Joh 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli mbotezi muuwo mbuuinda, nanka zifuwa mbuzikula mwida lyauuminsi, mbubonya obo tozi mbwiibede milimo ya-Leza uucita zyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cifumofumo byala imbuto zyako, aciindi cagoko utalesyi maanza aako, nkaambo tozi na nzizili zisi kule akati kazyo, na zyoonse zyobile zilaba kabotu, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuni ulalwelela buumi, alimwi ncibotu kuti meso abone izuba, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu woongola, asekelele mumyaka yakwe yoonse, nekubaboobo atalubi kuti myaka yamudima iyooba minji. Zyoonse ziboola nzyabuyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
