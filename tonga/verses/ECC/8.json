              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Milimo mibi tiifwambaani kubetekwa, aboobo myoyo yabantu ilakakatila kucita zibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.11",
            "verseOrgIds": [
              "ECC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
