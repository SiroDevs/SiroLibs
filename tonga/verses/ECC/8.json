                "loc": "ECC.2.14"
              },
              "items": [
                {
                  "text": "Muk 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cintu cabuyo nkocili ciboneka ansi. Nkobali baluleme basikilwa bulumbu bweelede milimo yabasizibi, alimwi nkobali basizibi basikilwa bulumbu bweelede milimo yabaluleme. Ndakati, Eci acalo ncabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.14",
            "verseOrgIds": [
              "ECC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.12"
              },
              "items": [
                {
                  "text": "Muk 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.5"
              },
              "items": [
                {
                  "text": "Lev 26:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako ndatembaula kukondwa. Taakwe cintu cibotu ansi ano kwiinda eci: muntu alye akunywa akusekelela, nkaambo eci cilakalilila kulinguwe mumilimo yakwe mazuba oonse aabuumi bwakwe ngaamupede Leza ansi ano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        }
      ]
    },
    {
