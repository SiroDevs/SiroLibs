              "type": "tag",
              "attrs": {
                "loc": "MAT.25.34"
              },
              "items": [
                {
                  "text": "Mt 25:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekuba kuti sizibi ulabisya ziindi zili mwa nda akoongola, ndizi kuti bayoowa Leza bayooba kabotu, nkaambo balamulemeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele sizibi takooyooba kabotu, takooyoongola pe; mazuba aakwe ayooba mbuli eenzule, nkaambo tayoowi Leza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
    },
