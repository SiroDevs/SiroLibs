          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nendakabika moyo wangu kukuziba busongo, akubonesya makani aacitika ansi ano mbwaabede, (nkaambo bamwi nkobali bataoni neliba isikati naaba masiku), ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.16",
            "verseOrgIds": [
              "ECC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 8:17"
          },
