              },
              "items": [
                {
                  "text": "Is 65:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.5"
              },
              "items": [
                {
