              "items": [
                {
                  "text": "Jer 9:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acintu cimwi ncimbwene ansi ano nceeci. Teensi basiluno bazunda mukusiyana, teensi basintaze bazunda munkondo, teensi basongo bajana zyakulya, teensi bacenjede bavuba imbono, teensi basimaanu bafwidwa luzyalo, pe. Bantu boonse buyo balasikilwa ziindi zyalufu azyamapenzi, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
