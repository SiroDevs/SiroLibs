                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubo. Kolya cilyo cako cakukondwa akunywa waini amoyo mubotu, nkaambo Leza watambula kale milimo yako. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zyakusama zyako kazituba ciindi coonse, amutwe wako utabuli mafuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.10"
              },
              "items": [
                {
                  "text": "Muk 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kobotelwa amwanakazi ngoyandisya mazuba oonse aabuumi bwako bwabuyo mbwakupede ansi ano, mazuba aako oonse aabuyo, nkaambo ncencico caabilo cako mubuumi amumilimo yako njobeleka ansi ano. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa milimo njaajana maanza aako, kocita canguzu, nkaambo taakwe milimo niiba miyeeyo neluba luzibo nebuba busongo mukabanda moyoonjila.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        }
      ]
