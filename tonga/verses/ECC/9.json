                  "text": "Mal 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo cintu comwe buyo cilabasikila boonse, nibaba baluleme nibaba basizibi, nibaba babotu nibaba babi, nibaba basalala nibaba basofweede, nibaba bapaila nibaba batapaili, Mbuli muntu mubotu mbwabede, alakwe sizibi mbwabede. Mbuli uukonka mbwabede, alakwe uuyoowa kukonka mbwabede ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cintu cibi nkucili mumakani oonse aacitika ansi ano, nkokuti, cintu comwe buyo cilasikila bantu boonse. Alimwi myoyo yabantu ilizwide bubi, nkabela busondosi mobuli mumyoyo yabo ciindi cakupona, lino musule balainka kubafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.3",
            "verseOrgIds": [
              "ECC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo uucipona akati kabaumi ucijisi bulangizi, nkaambo mubwa uucipona mubotu kwiinda mulavu uufwide. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.4",
            "verseOrgIds": [
              "ECC.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
