              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakani amwi aabusongo ngembwene ansi ano ngaaya. Akayoosya mumeso aangu, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
            "verseOrgIds": [
              "ECC.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.16+2SA.20.17+2SA.20.18+2SA.20.19+2SA.20.20+2SA.20.21+2SA.20.22"
              },
              "items": [
                {
                  "text": "2 Sam 20:16-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kakuli umwi munzi muniini iwakali abantu bace. Lino kwakasika mwami mupati kuzooulwisya, nkabela wakayaka mayake mapati aakuusinkinizya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.14",
            "verseOrgIds": [
              "ECC.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele omo mumunzi mwakajanwa umwi mucete musongo, nkabela mubusongo bwakwe wakavuna munzi. Nekubaboobo katakwe muntu iwakaingasila oyo mucete. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.15",
            "verseOrgIds": [
              "ECC.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
