        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utabiki moyo wako kumajwi oonse ngebaamba bantu. Na wacita obo, inga wamvwa muzike wako ulakutukila. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.21",
            "verseOrgIds": [
              "ECC.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo moyo wako ulizi kuti ziindi zinji wakatukila bamwi ayebo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        }
      ]
