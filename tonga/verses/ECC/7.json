                {
                  "text": "1 Tim 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makani aaba ali kule, ali kunsi loko, Taajaniki pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        },
        {
          "name": "verse",
