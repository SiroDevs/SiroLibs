              "attrs": {
                "loc": "REV.14.13"
              },
              "items": [
                {
                  "text": "Ciy 14:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Izina ibotu ndibotu kwiinda muunde, abuzuba bwakufwa mbubotu kwiinda buzuba bwakuzyalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.4"
              },
              "items": [
                {
                  "text": "Mt 5:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuya kuŋanda yadilwe nkubotu kwiinda kuya kuŋanda yakusekelela, nkaambo kufwa ngemamanino aabantu boonse, nkabela baumi baleelede kubika moyo kuliceeci. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.10"
              },
              "items": [
                {
                  "text": "2 Kor 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buusu mbubotu kwiinda kuseka, nkaambo kuusa nkokubotya moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo yabasongo ili kuŋanda yakulila, pele myoyo yabafubafuba ili kuŋanda yakusekelela ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu wamvwa kutapatila kwamusongo, ncibotu kwiinda kumvwa lwiimbo lwabafubafuba. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbuli insasi zyamulilo kunsi acilongo, mbukubede kuseka kwabafubafuba. Eci acalo ncabuyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.8"
              },
              "items": [
                {
                  "text": "Kul 23:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni kunyanzya kulasondosya musongo, acipo cilabisizya moyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.29"
              },
              "items": [
                {
                  "text": "Tus 14:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mamanino aamakani mabotu kwiinda matalikilo, akukazika moyo nkubotu kwiinda kulisumpula. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.19"
              },
              "items": [
                {
                  "text": "Jak 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.32"
              },
              "items": [
                {
                  "text": "Tus 16:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utafwambi kukalala ciindi cakubijilwa, nkaambo mumyoyo yabafubafuba mobukede bukali. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utaambi kuti, Mazuba aakamana akali mabotu kwiinda aasunu, nkaambo kwaamba obo takuli kwabusongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busongo mbubotu mbuli lukono, bulagwasya bantu baansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busongo bulatabilila mbubonya mbuli mali mbwaatabilila, aluzibo lulagwasya nkaambo busongo bulavuna buumi bwabaabo babujisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.27"
              },
              "items": [
                {
                  "text": "Is 14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bona milimo ya-Leza mbwiibede! Ngwani uukonzya koolola ncaakapilingenye?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
