          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya makani oonse ndaalingula mubusongo, Ndakaamba kuti, Nkonsongwaale. Pele busongo bwakandicija. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
