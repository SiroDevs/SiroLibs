              "items": [
                {
                  "text": "Lk 23:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele uuli acoolwe kwiinda boonse ngooyo uutana kuzyalwa, uutabwene milimo mibi iicitika ansi ano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
