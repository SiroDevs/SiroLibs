                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndakayeeya kuti bafu bafwa kale mbabotu kwiinda baumi bacipona, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
