        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.6.10"
              },
              "items": [
                {
                  "text": "Tus 6:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mufubafuba ulalikumbata, aboobo ulalekelela buumi bwakwe kuti bunyonyooke. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkankamanza yomwe iili aluumuno nimbotu kwiinda maanza obile aazwide milimo iikataazya iitakutyi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
