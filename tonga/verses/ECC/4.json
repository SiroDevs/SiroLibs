              "items": [
                {
                  "text": "Lk 12:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "muntu uli alike, uutajisi munyina naba mwanaakwe, taleki kulikataazya kucita milimo, ameso aakwe taakonzyi kukuta buvubi. Talibuzyi kuti, Ino ngwani ngundalikataazizya kumilimo akuliimya bubotu? Eci acalo ncabuyo, ncintu cibi loko.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
