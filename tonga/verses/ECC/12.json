                "loc": "GEN.27.1"
              },
              "items": [
                {
                  "text": "Matl 27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mubuzuba basikubamba iŋanda nebazoobila abaluumi basintaze nebazoongomana, abasikuziya nebazooleka nkaambo kakuceya abaabo basondela kuzipulo nebazoosiilwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 12:4"
          },
          "items": [
