              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Mukambausi, mbwaakali musongo, wakacili kwiiyisya bantu luzibo. Wakayeeya akulingula akubamba tusimpi tunji. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukambausi wakali kuyandaula majwi aabotezya, alimwi wakaliluleme kukulemba majwi aalusinizyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majwi aabasongo ali mbuli zibinzyo, atusimpi tuyobolwedwe twamwiyi omwe tuli mbuli manembe aakankamidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanaangu, cenjela kuzintu azimwi kutali ezi. Kulemba mabuku manji takumani, akwiiya kunji kulakataazya mubili.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya mamanino aamakani, Oonse amvwigwa. Lemeka Leza akubamba milazyo yakwe, nkaambo kucita obo nceelelo coonse camuntu, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.36"
              },
              "items": [
                {
                  "text": "Mt 12:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Leza uyoobeteka milimo yoonse, amakani oonse aasisidwe, naaba mabotu naaba mabi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
            "verseOrgIds": [
              "ECC.12.14"
            ]
          }
        }
      ]
    }
