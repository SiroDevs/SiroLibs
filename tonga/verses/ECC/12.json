            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyeeya Mulengi wako mumazuba aabulombe bwako, mazuba aamapenzi naatana kusika, amyaka niitana kuboneka noyooamba kuti, Nsicibotelwi zintu ezi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "izuba amumuni amwezi anyenyeezi nezitana kusia, amayoba naatana kuboola alimwi yamana imvula; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
