            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.22"
              },
              "items": [
                {
                  "text": "My 16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bulongo nibuyoopiluka kunyika mbubwakabede, amuuya nuuyoopiluka kuli-Leza nkowakazwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzyabuyobuyo! mbwaamba Mukambausi, Zyoonse nzyabuyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
