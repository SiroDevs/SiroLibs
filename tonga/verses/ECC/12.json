              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.1"
              },
              "items": [
                {
                  "text": "Mik 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.35"
              },
              "items": [
                {
                  "text": "2 Sam 19:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "milyango yakumugwagwa ninoozoojalidwe, ajwi lyakuziya nelizooceya; muntu naazoobuka kuciindi cakwiimba kwa tuyuni, abanakazi basikwiimba nebazoofwinsigwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.32"
              },
              "items": [
                {
                  "text": "Lev 19:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "muntu naazooyoowa cilundu cilamfu, akweenda kulamuyoosya; musamu waalmondi nuuzoosyuuka; idingo nilizookokoba, amusamu wakubusya tuucibeleki; nkaambo muntu ulaya kucikalilo cakwe citamani, abasikulila baleendeenda mumigwagwa; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "intambo yansiliva niitana kudunsuka, amutiba wangolida nuutana kupwayika, citesyo nicitana kufwa kukasensa, avili nilitana kupwayika kucikala; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
