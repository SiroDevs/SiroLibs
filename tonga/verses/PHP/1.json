                  "text": "Rom 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Luzyalo alube anywe, aluumuno kuzwa kuli-Leza Taateesu aku-Mwami wesu Jesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
