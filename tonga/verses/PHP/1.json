                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bwaange bwangu mbwengangidwe nkaambo ka-Kristo bwaboneka moonse mnganda yabasimpi akumeso aabantu bamwi boonse, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela banji akati kabakwesu bamu-Mwami, nibakabona bwaange bwangu, bakainda kuyumya myoyo yabo akuba akaanzambwene kakwaamba makani aa-Leza cakutayoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwi nconzyo balakambauka Kristo nkaambo kabbivwe ankondo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele bamwi balamukambauka camyoyo mibotu. Aba bacita caluyando, mbubezi kuti ndi mulomo wakwaambilila Makani Mabotu, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele abo balakambauka Kristo cabbivwe cakutasinizya, mbubayeeya kuti bazoondikataazye kubwaange bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
