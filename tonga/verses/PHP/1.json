              "items": [
                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leza ngukamboni wangu uuzi mbwemusukeme caluyandisyo lwamumoyo wa-Jesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
