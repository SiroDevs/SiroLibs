                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndalumba Leza wangu lyoonse nendi mukumuyeeya, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
