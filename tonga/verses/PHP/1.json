          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino cintu ncenkomba nceeci cakuti luyando lwanu kaluciya buvula, antoomwe aluzibo alumvwisyo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
