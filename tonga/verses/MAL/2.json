                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.14"
              },
              "items": [
                {
                  "text": "Gal 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo milomo yamupaizi ileelede kujatisya luzibo, akumilomo yakwe bantu nkubeelede kuyandaula mulao, nkaambo ngonguwe mutumwa wa-Jehova wamakamu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.7",
            "verseOrgIds": [
              "MAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.17"
              },
              "items": [
                {
                  "text": "1 Sam 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele inywe mwapambuka kuzwa munzila, mwalebya bantu banji kumilao yanu, mwatyola cizuminano ca-Levi, mbwaamba Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.8",
            "verseOrgIds": [
              "MAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako njoomwaaba kuti musampaulwe akubombesegwa kubantu boonse, nkaambo tamuna kubamba imbeta zyangu, alimwi mulalanga ziwa mukubeteka kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        }
      ]
