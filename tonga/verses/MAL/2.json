              "items": [
                {
                  "text": "Heb 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.100.3"
              },
              "items": [
                {
                  "text": "Int 100:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa toonse tatuli bana bamuzyali omwe na? Sa teensi Leza omwe wakatulenga toonse na? Lino nkaambonzi muntu ulacitila mweenzinyina lweeno, akutyola cizuminano cabamatata? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.23"
              },
              "items": [
                {
                  "text": "Neh 13:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Juda wabula kusyomeka, ancito zisesemya zilacitwa mu-Israyeli amu-Jerusalemu, nkaambo Juda ulisofwaazizye cikombelo ca-Jehova ncayandisya, ulikwete mwana musimbi wamuzimu mweenzu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.11",
            "verseOrgIds": [
              "MAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muntu uucita obo, Jehova amunyanzye kumakalilo aa-Jakobo kamboni nanka sikumuvwiila nanka sikuletela Jehova wamakamu cipaizyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.12",
            "verseOrgIds": [
              "MAL.2.12"
            ]
          }
        }
      ]
    },
