            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.20"
              },
              "items": [
                {
                  "text": "Jak 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mulao wabwini koli mukanwa lyakwe, nkabela teemwakajanwa bubi abuniini mumilomo yakwe. Wakeenda ambe caluumuno acakululama, akusandula banji kuzwa kububi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.6",
            "verseOrgIds": [
              "MAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 2:7"
          },
          "items": [
