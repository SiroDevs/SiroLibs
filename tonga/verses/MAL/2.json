        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakataazya Jehova amajwi aanu. Pele mulabuzya kuti, Twamukataazya buti? Mwamukataazya kukwaamba kwanu kwakuti, Kufumbwa muntu uucita cibi mubotu mumeso aa-Jehova, alimwi bamubotela. Akwalo kubuzya kwakuti, Ino Leza walubeta uli kuli?",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
    }
