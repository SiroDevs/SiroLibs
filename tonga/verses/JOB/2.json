                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele nebakamubona kulaale akutamuziba, bakalila kapati; boonse bakazapaula zikobela zyabo akulilundumwida kasuko mitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
