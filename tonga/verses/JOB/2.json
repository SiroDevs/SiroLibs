            }
          ]
        },
        {
          "text": "Lino bazwalani botatwe ba-Jobu nebakamvwa mapenzi aakamuwidide, bakeza umwi aumwi kuzwa kumunzi wakwe, Elifazi waku-Temani, Bilidadi waku-Suwa alimwi a-Zofari waku-Naama; bakalibambila kuti bainke kuyoomulizya akumuumbulizya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
