        },
        {
          "text": "Alimwi, buzuba bumwi, baangelo bakaboola kunembo lya-Leza kulitondezya, alakwe Saatani wakeza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wakati kuli-Saatani, Wazwa kuli? Saatani wakavuwa wati, Ndakali kweendeenda munyika nkenzelengana koonse koonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "name": "verse",
