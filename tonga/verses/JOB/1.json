        },
        {
          "text": "Kaindi kwakali muntu munyika iitegwa Uzi, izina lyakwe wakali Jobu; wakali muntu uutakwe mulandu, uululeme; wakali kulemeka Leza akweeleba bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.1",
            "verseOrgIds": [
              "JOB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalijisi bana balombe bali musanu ababili abana basimbi botatwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
              "JOB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "alimwi wakali ambelele zyakali zyuulu zili musanu azibili, ankamele zyakali zyuulu zyotatwe, acuulu cabasune, anzyazi mbongolo zyakali myaanda yosanwe antoomwe ababeleki abazike banji; nkaambo oyo muntu wakali mupati kwiinda boonse bakali mumanyika aakujwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana basankwa bakwe bakali kupobola antoomwe umwi aumwi kababamba bamwi mumalizi; alimwi bakali kutamba bacizi babo botatwe kuti bakalye akunywa ambabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.4",
            "verseOrgIds": [
              "JOB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
