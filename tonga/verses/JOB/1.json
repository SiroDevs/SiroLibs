              "attrs": {
                "loc": "LUK.12.19"
              },
              "items": [
                {
                  "text": "Lk 12:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buzuba bumwi bana balombe abasimbi bakali kukulya akunywa waini muŋanda yamupati wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "sikutumwa wakaboola akumwaambila Jobu kuti, Basune bakali kulima, ambongolo zyakali kucela afwiifwi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.7"
              },
              "items": [
                {
                  "text": "Matl 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Seba nibakavuumukila akuzitola; bakajaya basimilimo, ndime endike ndayokoka kuti nkwaambile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakacili kwaamba naakasika umwi wati, Lulabo lwakawa kujulu akuumpilila limwi mbelele abeembeli; ndime endike ndafutuka kuti nkwaambile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kacaamba, umwi wakaboola wakati, Ba-Kasidi bakalicita nkamu zyotatwe kuti bafumpe nkamele; bakazitola, akujaya babeleki; ndime endike ndasyaala nkwaambile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
