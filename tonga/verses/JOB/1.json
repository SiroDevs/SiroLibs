                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo nocakamana ciindi cakupobola cimwi acimwi, Jobu waka: tuma kuti baboole akusalazigwa, kafuma, kabacitila umwi aumwi cipaizyo cuumpe; nkaambo Jobu wakati, Atene bana bangu balibijide akusowelezya Leza mumyoyo yabo. Lyoonse Jobu wakali kucita boobo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.5",
            "verseOrgIds": [
              "JOB.1.5"
            ]
          }
        }
      ]
    },
