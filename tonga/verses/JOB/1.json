              "items": [
                {
                  "text": "Ciy 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bumwi buzuba baangelo bakeza kulimanala kunembo lya-Jehova, awalo Saatani wakaboola ambabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.43"
              },
              "items": [
                {
                  "text": "Mt 12:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.8"
              },
              "items": [
                {
                  "text": "1 Pet 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jehova wakaamba kuli-Saatani kuti, Wali kuli? Saatani wakavuwa wati, Ndali kuzungazunga koonse koonse, nkenjendeenda munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jehova wakati kuli-Saatani, Sena wakabona kuti taakwe muntu munyika uuli mbuli muntu wangu Jobu, muntu uutakwe mulandu, uululeme, uulemeka Leza akuyoowa cibi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Ciy 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Saatani wakavuwa Jehova wati, Taakwe kaambo sena Jobu nkalemekela Leza? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.1"
              },
              "items": [
                {
                  "text": "Matl 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.7"
              },
              "items": [
                {
                  "text": "Int 34:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.2"
              },
              "items": [
                {
                  "text": "Is 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.128.1"
              },
              "items": [
                {
                  "text": "Int 128:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Teewakamuyakilide kabotu, walo abaŋanda bakwe azyoonse nzyajisi? Wakamukupusya mumulimo wakwe, alimwi matanga aakwe avula munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele, kuti kotambika janza lyako akuguma ncajisi uzookusinga kubusyu bwako! ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jehova wakamwaambila Saatani wati, Mbubo ndabika zyoonse nzyajisi munguzu zyako; pele utabiki janza kulinguwe mwini. Aboobo Saatani wakazwa kubusyu bwa-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
