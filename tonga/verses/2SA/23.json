            }
          ]
        },
        {
          "text": "Ngaaya mazina aabaalumi basintaze mbaakajisi Davida: Josebubasebete mu-Tekemoni, silutwe wabapati botatwe, ngonguwe Adino mu-Ezni, nguwakajaya bantu bali myaanda iili musanu aitatu ciindi comwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
