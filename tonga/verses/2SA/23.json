                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Abisai munyina joabu mwana wa-Zeruya kali silutwe wabaalumi bali makumi otatwe, Wakasumpula isumo lyakwe kubantu bali myaanda yotatwe akubajaya, aboobo kali simpuwo mbubonya mbuli abo botatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali mulemu kwiinda boonse bali makumi otatwe, nekubaboobo teewakeelanisigwa abaabo botatwe bataanzi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
