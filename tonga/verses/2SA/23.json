              "items": [
                {
                  "text": "1 Sam 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.12.16"
              },
              "items": [
                {
                  "text": "1 Mak 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ciindi eco Davida kali mumampangala, alimwi kakuli inkamu yabasinkondo baba-Filisti mu-Betelehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakali kusukama, wakati, Nguni uuyanda kundinywisya maanzi aamumukalo waku-Betelehemu kumulyango? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo baalumi basintaze botatwe bakapola akati kabasinkondo baba-Filisti, baakuteka maanzi kumukalo waku-Betelehemu kumulyango, bakaabweza akwaaleta kuli-Davida. Pele wakakaka kunywa, wakaatila ansi buyo kuli-Jehova, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.10"
              },
              "items": [
                {
                  "text": "Lev 17:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakati, Cinditonde, O Jehova, kucita obo. Sa ndakonzya kunywa bulowa bwabantu aba ibakeenda cakutayoowa kufwa? Lino wakakaka kunywa, Mbuboobo mbubakacita abo baalumi botatwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
