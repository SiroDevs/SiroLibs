                "loc": "1CH.27.4"
              },
              "items": [
                {
                  "text": "27:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musule lyayooyu kali Eleazeri mwana wa-Dodai mwana wamu-Ahohi, umwi wabaa-lumi botatwe Davida mbaakali abo ciindi ncibakasampaula ba-Filisti nibakabungene kunkondo. Lino bantu ba-Israyeli nibakainka kuyoolwana, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyu muntu wakabuka, kaya bujaya ba-Filisti mane ijanza lyakwe lyakakataala akukakatila kupanga. Jehova wakaleta lufutuko lupati obo buzuba, nkabela bantu bakali kumutobela kuya busaala buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.12"
              },
              "items": [
                {
                  "text": "1 Mak 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musule lyayooyu kali Sama mwana wa-Age mu-Harari, Lino ba-Filisti nibakabungana ku-Lehi, kakuliko muunda uuzwide nyangu. Nkabela bantu bakali kucija kubusyu bwaba-Filisti, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "pele oyu muntu wakaima akati kamuunda oyo, wakauvuna, wakajaya ba-Filisti, aboobo Jehova wakaleta lufutuko lupati.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
