              "items": [
                {
                  "text": "Kul 15:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Benaya mwana wa-Jehoyada, mwana wamwaalumi sintaze wakuKabzeli, alakwe kacita malweza. Ngonguwe wakajaya bana bobile baArieli waku-Moabu, alimwi wakajaya mulavu mukati kakalambwa ciindi maanzi ncaakagagaminwa impeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.23"
              },
              "items": [
                {
                  "text": "1 Mak 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakajaya mu-Egepita, muntu mweebesi, Oyu mu-Egepita kajisi isumo mujanza lyakwe, pele wakainka nkwaakabede ankoli luzutu, wakanyanzya isumo mujanza lyamu-Egepita akumujazya ndilyonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.21",
            "verseOrgIds": [
              "2SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya malweza ngaakacita Benaya mwana wa-Jehoyada, aboobo kali simpuwo mbuli abo baalumi botatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
            "verseOrgIds": [
              "2SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
