        },
        {
          "text": "Lino bamwi botatwe babapati bali makumi otatwe bakainka ciindi cakutebula kuyoosika kuli-Davida kumampangala yaku-Adulamu. Nkabela umwi mukowa waba-Filisti kabakede musokwe mumumpata wa-Refaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
