              },
              "items": [
                {
                  "text": "2 Sam 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wakabaaba mumaanza aaba-Gibeoni, nkabela bakabasina kucilundu kumeso aa-Jehova, aboobo bakawa antoomwe boonse bali musanu ababili. Bakajayigwa kumatalikilo aaciindi cakutebula, nkukuti bantu nibakasaanguna kutebula bbaale,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
