                "loc": "2SA.20.19"
              },
              "items": [
                {
                  "text": "2 Sam 20:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Davida wakababuzya ba-Gibeoni kuti, Nkamucitilenzi? Nkamulungilenzi, kuti muletele lukono lwa-Jehova coolwe? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Gibeoni bakamwaambila kuti, Aya makani ngotujisi a-Saulo aluzubo lwakwe teensi makani aansiliva nanka ingolida, pe, alimwi taciboti kuti ujaye muntu naba omwe wamu-Israyeli nkaambo kandiswe. Lino wakati, Kufumbwa cintu ncimwaamba, njoomucitila ncico.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
