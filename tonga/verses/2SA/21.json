        },
        {
          "text": "Mpawo Rizipa mwana wa-Aya wakabweza zisani zyamasaka, wakaziyanika atala andomba nikwakatalika kutebulwa mane zyakawidwa imvula yakujulu, nkabela teewakazumizya bayuni bakujulu kukala alinzizyo ciindi cesikati nibaba banyama bamusokwe ciindi camasiku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davida naakaambilwa ncaakacita Rizipa mwana wa-Aya simamambe wa-Saulo, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
