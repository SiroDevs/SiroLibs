              "items": [
                {
                  "text": "1 Sam 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.7"
              },
              "items": [
                {
                  "text": "2 Sam 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami wakabweza bana bobile ba-Rizipa, mwana musimbi wa-Aya, mbaakazyalila Saulo, Arimoni a-Mefibosete, alimwi wakabweza bana bosanwe ba-Mikala, mwana musimbi wa-Saulo, mbaakazyalila Adriyeli mwana wa-Barizilai mu-Meholati, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
