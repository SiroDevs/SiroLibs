        },
        {
          "text": "Pele mwami wakafwida insoni Mefibosete mwana wajonatani mwana wa-Saulo, nkaambo kacikonkezyo ca-Jehova ncibakakonkezyanya aba bobile, Davida a-Jonatani mwana wa-Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
