        },
        {
          "text": "Lino ba-Filisti aba-Israyeli bakacita inkondo alimwi, nkabela Davida wakainka abalanda bakwe kuyoolwana aba-Filisti, Elyo Davida wakaamba kuwizuka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Isibenobi, umwi wabana ba-Rafa, kaliko. Bulemu bwasumo lyakwe kabuli masyekeli aali myaanda yotatwe aamukuba, Kasamide zilwisyo zipya, nkabela wakali kuyeeya kujaya Davida, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Bam 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.17"
              },
              "items": [
                {
                  "text": "Int 132:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele Abisai mwana wa-Zeruya wakamugwasya, wakayasa mu-Filisti akumujaya. Lino bantu ba-Davida bakamukonkezya kuti, Toelede kutusindikila limbi kunkondo, kuti utazimyi mumuni wa-Israyeli,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
