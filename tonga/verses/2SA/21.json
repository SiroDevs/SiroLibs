              "attrs": {
                "loc": "1SA.31.8+1SA.31.9+1SA.31.10+1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:8-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Davida wakaakuleta zifuwa zya-Saulo azifuwa zya-Jonatani mwanaakwe kuzwa kubantu baku-Jabezi-Gileadi, nkaambo mbabo bakazibba kumugwagwa waku-Betisani, nkubakabaanzika ba-Filisti obo buzuba ba-Filisti mbubakajaya Saulo ku-Giliboa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakagwisya nkukonya zifuwa zya-Saulo azifuwa zya-Jonatani mwanaakwe, alimwi bakaleta zifuwa zyabaanzikidwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        },
