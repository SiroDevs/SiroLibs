        },
        {
          "text": "elyo mwami wakaambila Natani musinsimi kuti, Bona! Mebo ndikede muŋanda yaziyako zyakedari, pele ibbokesi lya-Leza lilikede muŋanda yamasani buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
            "verseOrgIds": [
              "2SA.7.2"
            ]
          }
        },
