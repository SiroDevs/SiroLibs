                "loc": "DEU.26.18"
              },
              "items": [
                {
                  "text": "Dt 26:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni wakalisalila bantu bako ba-Israyeli kuti babe musyobo wako lyoonse, nkabela webo, O Jehova, wakaba Leza wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino, O Leza Jehova, eli ijwi ndyoamba aamulanda wako abasiŋanda bangu kolimikizya lyoonse, kuti ucite mbubonya mbuwaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
