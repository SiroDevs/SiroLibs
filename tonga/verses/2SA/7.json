                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngonguwe uusi yakile izina lyangu iŋanda, nkabela cuuno cabwami bwakwe njoociimikizya akutamani. ",
          "type": "text",
          "attrs": {
