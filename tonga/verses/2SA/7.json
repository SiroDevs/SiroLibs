              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino majwi ngoelede kwaambila mulanda wangu Davida ngaaya, Amba kuti, Mbuboobu mbwaamba Jehova wamakamu makamu, Ndakakugwisya kucimpati nkowakali kweembela imbelele kuti ube mweendelezi wabantu bangu ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
