            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.9"
              },
              "items": [
                {
                  "text": "Mt 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Izina lyako libe abulemu lyoonse akutamani, kukaambwe kuti, Jehova wamakamu makamu ngu-Leza uuendelezya ba-Israyeli, ayalo iŋanda yamulanda wako Davida iime nji kubusyu bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo nduwe Jehova wamakamu makamu Leza wa-Israyeli. Wandiyubunwida ndemulanda wako kuti, Njookuyakila iŋanda. Nciceeco moyo wangu ndemulanda wako ncuuyandila kukukombela eci cikombyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
