        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.16"
              },
              "items": [
                {
                  "text": "1 Bam 8:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni nsina kuba aŋanda yakukala ciindi coonse kuzwa kubuzuba obo mbundakapozya bana ba-Israyeli kuzwa kucisi ca-Egepita akusikila kuciindi ecino. Ndali kweendeenda muŋanda yamasani na mucilao. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
