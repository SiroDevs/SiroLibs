        {
          "text": "Alimwi mazuba aako aakukala ansi naazoomana nosi kaone abauso baciindi, elyo njoobusya mwana wako iwakazyalwa kumaala aako, kuti alye izina lyako, nkabela njooimikizya bwami bwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.12",
            "verseOrgIds": [
              "2SA.7.12"
            ]
          }
        },
