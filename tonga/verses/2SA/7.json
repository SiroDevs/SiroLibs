              "type": "text"
            }
          ]
        },
        {
          "text": "Pele ayo masiku ngaonya ijwi lya-Leza lyakasika kuli-Natani, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
