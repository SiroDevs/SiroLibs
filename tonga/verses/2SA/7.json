          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koya ukaambile mulanda wangu Davida kuti, Mbuboobu mbwaamba Jehova. Ulayanda kundiyakila iŋanda yakukala na? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
