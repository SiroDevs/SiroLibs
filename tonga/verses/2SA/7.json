                "loc": "JHN.17.17"
              },
              "items": [
                {
                  "text": "Joh 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino O Mwami Jehova, nduwe Leza, amajwi aako ngalusinizyo. Wandisyomezya ndemulanda wako eci cintu cibotu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kotalika kulongezya ciinga cangu ndemulanda wako, kuti cikalilile kubusyu bwako lyoonse, nkaambo mbuboobo mbuwaamba, o Mwami Jehova. Ciinga cangu ndemulanda wako cilongezegwe alulongezyo lwako mazuba oonse akutamani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
