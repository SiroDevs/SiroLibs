        {
          "text": "Alimwi ndakali ayebo koonse nkuwakali kuya, ndakanyonyoona basinkondonyoko boonse kubusyu bwako, nkabela ndakakucitila impuwo impati mbuli impuwo yabantu bapati baansi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.9",
            "verseOrgIds": [
              "2SA.7.9"
            ]
          }
        },
