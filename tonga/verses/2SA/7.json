                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Natani wakaambila mwami kuti, Mbubo, kocita coonse cili mumoyo wako, nkaambo Jehova uli ayebo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
