              "attrs": {
                "loc": "1KI.1.9"
              },
              "items": [
                {
                  "text": "1 Bam 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jonatani a-Ahimaazi bakali kukala ku-Enirogeli, nkabela musimbi wakali kubatolela makani, aboobo bakali kuya kuyooambila mwami Davida, nkaambo bakayoowa kubonwa kumunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.17",
            "verseOrgIds": [
              "2SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.16"
              },
              "items": [
                {
                  "text": "2 Sam 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.5"
              },
              "items": [
                {
                  "text": "16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele umwi mulombe wakababona, wakaakulwiida Abisalomu. Lino bakeenda lubilo boonse bobile, bakasika kuŋanda yamuntu umwi waku-Bahurimu. Oyo muntu kali acikala mulubuwa lwakwe, elyo bakaseluka omo mucikala. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.18",
            "verseOrgIds": [
              "2SA.17.18"
            ]
          }
        },
        {
