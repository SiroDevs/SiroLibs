              },
              "items": [
                {
                  "text": "Neh 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bana ba-Beeroti bakalongela ku-Gitaimu, nkukonya oko nkubacibede asunu mbuli bazwakule).",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.3",
            "verseOrgIds": [
              "2SA.4.3"
            ]
          }
        }
