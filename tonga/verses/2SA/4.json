                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakavwiila Rekabu a-Baana munyina, bana ba-Rimoni waku-Beeroti, wakati, Mbubonya mbwali muumi Jehova, ngonguwe iwakavuna buumi bwangu kumapenzi oonse, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.9",
            "verseOrgIds": [
              "2SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 4:10"
          },
          "items": [
