                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.29"
              },
              "items": [
                {
                  "text": "25:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bakaleta mutwe waIsibosete kuli-Davida ku-Hebroni. Lino bakaambila mwami kuti, Langa! Ngooyu mutwe wa-Isibosete mwana wa-Saulo sinkondonyoko, nguwenya iwakali kuyandaula buumi bwako. Jehova sunu wabeteka mwami simalelo wesu makani aakwe kuli-Saulo akubana bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.8",
            "verseOrgIds": [
              "2SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
