              },
              "items": [
                {
                  "text": "Matl 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa taciindi kubija cintu eci cakuti bantu basizibi balijayide muntu uululeme kuŋanda yakwe abulo bwakwe mwini? Sa nsyeelede kumupa mulandu wabulowa bwakwe akumugwisya anyika? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.11",
            "verseOrgIds": [
              "2SA.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
