                "loc": "JOS.18.25"
              },
              "items": [
                {
                  "text": "18:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Isiboseti mwana wa-Saulo wakali abantu bobile basilutwe, izina lya umwi kali Baana, amweenzinyina kali Rekabu. Bakali bana ba-Rimoni waku-Bceroti, bana ba-Benjamini, (nkaambo Beeroti ulaambwa mbuli munzi wamucisi ca-Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.2",
            "verseOrgIds": [
              "2SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
