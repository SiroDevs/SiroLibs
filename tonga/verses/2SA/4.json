                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mulindizi waŋanda wakali kubeeta bulotwe, elyo wakalala, wakoona, nkabela mpawo Rekabu a-Baana munyina bakanjila cakuumuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.6",
            "verseOrgIds": [
              "2SA.4.6"
            ]
          }
        },
        {
