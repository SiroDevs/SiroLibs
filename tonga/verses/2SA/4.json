              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.32"
              },
              "items": [
                {
                  "text": "2 Sam 3:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakalailila balombe bakwe kuti babajaye, nkabela bakabakosola maanza azituta, bakabaanzika kumbali aziba lyamuHebroni. Elyo mutwe wa-Isibosete bakauzika kumavwiko aa-Abineri mu-Hebroni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.12",
            "verseOrgIds": [
