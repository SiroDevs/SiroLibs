              "items": [
                {
                  "text": "1 Mak 8:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jonatani mwana wa-Saulo wakali amwana uulemene maulu. Oyu mwana kajisi myaaka yosanwe yakuzyalwa naakasika makani aalufu lwa-­Saulo a-Jonatani ku-Jezreeli. Elyo muleli wakwe wakamubweza, wakacija, nkabela mbwaakabindeene kucija, mwana wakawida ansi, aboobo wakalemana. Izina lyakwe kali Mefiboseti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.4",
            "verseOrgIds": [
              "2SA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bana ba-Rimoni waku-Beroti, Rekabu a-Baana, bakaya izuba nilyakali amutwe, bakasika kuŋanda yaIsibosete ciindi ncaakalede abulo naakali mukulyokezya kulyokezya kwasikati. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.5",
            "verseOrgIds": [
              "2SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
