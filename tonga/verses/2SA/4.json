              },
              "items": [
                {
                  "text": "Mt 14:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo nibakanjila muŋanda, wakalilede abulo muŋanda yakoona, nkabela bakamuyasa, bakamujaya akumukosola mutwe. Mpawo bakabweza mutwe wakwe, bakeenda munzila ya-Araba masiku oonse, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.7",
            "verseOrgIds": [
              "2SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
