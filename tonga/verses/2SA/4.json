              },
              "items": [
                {
                  "text": "2 Sam 1:1-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ciindi eco ncindakaambilwa kuti, Saulo wafwa, elyo oyo iwakandilwiida wakali kuyeeya kuti wandetela makani mabotu, pele mebo ndakamujata, ndakamujaya nkukonya oko ku-Zikilaga. Mbuboobo mbundakamulumbwida makani aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.10",
            "verseOrgIds": [
              "2SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
