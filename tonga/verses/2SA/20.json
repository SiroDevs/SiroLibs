              },
              "items": [
                {
                  "text": "1 Bam 1:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Davida wakaambila Abisai kuti. Lino ncobeni Seba mwana wa-Bikri ulatubisizya kwiinda Abisalomu. Koya uwe, ukatole balanda basimalelaako akumutobela, kuti atalijanini minzi iili alubaya akutuloboka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.18"
              },
              "items": [
                {
                  "text": "2 Sam 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.38"
              },
              "items": [
                {
                  "text": "1 Bam 1:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bantu ba-Joabu bakainka kuyoomutobela, aba-Kereti aba-Peleti aboonse baalumi basintaze. Bakainka kuzwa ku-Jerusalemu kuyootobela Seba mwana wa-Bikri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
