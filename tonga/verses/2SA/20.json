          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibakasika kubbwe ipati lyaku-Gibeeni, Amasa wakeza kuzoobacinga. Nkabela Joabu kasamide zikobela zyakwe zyakulwisya nzyaakasama, alimwi kajisi ipanga mucibunu cakwe lyaangidwe munkomo yalyo, nkabela naakanyampuka, yakawida ansi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
