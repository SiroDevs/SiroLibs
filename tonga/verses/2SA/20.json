                "loc": "1KI.2.5"
              },
              "items": [
                {
                  "text": "1 Bam 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Joabu wakabuzya Amasa kuti, Sa ula pona kabotu, mukwesu? Nkabela Joabu wakajata Amasa kucilezu ajanza lyakwe lyalulyo, kuti amumyonte. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Amasa teewakabika moyo wakwe kupanga ilyakali mujanza lya-Joabu, aboobo wakamuyasya andilyo abumbu, wakatila mala aakwe ansi, nkabela takakamuyasa lwabili pe, nkaambo wakafwa mpoonya awo. Lino joabu a-Abisai mukulana wakwe bakaya butobela Seba mwana wa-Bikri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela kwakaima umwi mulombe wa-Joabu nkukonya nkwaakabede Amasa, wakati, Kufumbwa muntu uuli abuzolwani kwa-Joabu akuyanda Davida, ainke buyo kutobela Joabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Amasa wakali kulikanda mubulowa akati kanzila. Lino oyo muntu naakabona kuti bantu boonse baliimvwi, wakagwisya Amasa munzila, wakamutola musokwe akumuvumbya isani, nkaambo wakabona kuti kufumbwa bantu basika balaima buyo mpoonya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakamana kumugwisya munzila, bantu boonse bakainda kunembo kutobela Joabu kuya butanda Seba mwana wa-Bikri,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        }
      ]
    },
