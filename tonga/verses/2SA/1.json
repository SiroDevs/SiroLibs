        },
        {
          "text": "Nkabela mulombe iwakamulwiida wakati, Nkendiwo ambebo acilundu ca-Giliboa, elyo Saulo wakalilimbilila asumo lyakwe, abalo basiŋola abasimbizi bakali kuya bumutobelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.6",
            "verseOrgIds": [
              "2SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo naakaceba, wakandibona, wakandiita, lino ndakati Mpendi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.7",
            "verseOrgIds": [
              "2SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakandibuzya kuti, Nduweni? Ndakati, Ndi mu-Amaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakandaambila kuti, Zoondiimikile akundijaya, nkaambo ndaba acizyungubweebwe, pele buumi bwangu mpobucili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.9",
            "verseOrgIds": [
              "2SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.54"
              },
              "items": [
                {
                  "text": "Bab 9:54",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ndakamwiimikila akumujaya, nkaambo ndakalizi kuti takoobuka alimwi mbawide. Nkabela ndakabweza munsini iwakali amutwe wakwe, ankaya iyakali kukuboko kwakwe, ndazileta okuno kulinduwe, O mwami wangu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        }
