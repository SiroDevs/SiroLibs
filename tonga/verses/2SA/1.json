              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakamwaambila oyo mulombe iwakamulwiida kuti, Uzi buti kuti Saulo wafwa, a-Jonatani mwanaakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.5",
            "verseOrgIds": [
              "2SA.1.5"
            ]
          }
        },
