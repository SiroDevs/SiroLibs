                {
                  "text": "Kul 25:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.5"
              },
              "items": [
                {
                  "text": "1 Mak 13:5",
