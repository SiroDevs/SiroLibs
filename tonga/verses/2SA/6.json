                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.80.1"
              },
              "items": [
                {
                  "text": "Int 80:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakanyamuka abantu boonse mbaakali abo kuya ku-Baale-Juda kuyooleta kuzwa oko ibbokesi lya-Leza, ndilyonya liambwa mbuli izina lya-Jehova wamakamu makamu uukala akati kabakerabimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1+1SA.7.2"
              },
              "items": [
                {
                  "text": "1 Sam 7:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.7.9"
              },
              "items": [
                {
                  "text": "My 7:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bakabika ibbokesi lya-Leza aŋola impya akuligwisya muŋanda ya-Abinadabu yakucilundu, abalo Uza a-Ahio bana ba-Abinadabu bakali kweenzya iŋola impya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mbubakaligwisya muŋanda ya-Abinadabu yakucilundu, abbokesi lya-Leza, nkabela Ahio wakali kusololela ibbokesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida abasiluzubo boonse ba-Israyeli bakali kusekelela kubusyu bwa-Jehova azilizyo zyazisamu zyamulombe, abanamalwa atuntimbwa atugoma ansaka azigweele. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.4.15"
              },
              "items": [
                {
                  "text": "My 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nibakasika kucipolelo caNakoni, Uza wakatandabika ijanza lyakwe akujata ibbokesi lya-Leza nkaambo basune bakati lilosye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.19"
              },
              "items": [
                {
                  "text": "1 Sam 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo bukali bwa-Jehova bwakabukila Uza, nkabela Leza wakamuuma nkaambo kakuluba kwakwe, wakafwa nkukonya oko kubbokesi lya-Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Davida wakabijilwa nkaambo kakusotoka kwa-Jehova nkwaakasotokela Uza, aboobo oku kuntu wakakuulika izina lya-Luumo-lwa-Uza, mbukucaambwa asunu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
