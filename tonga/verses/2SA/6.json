            }
          ]
        },
        {
          "text": "Mbuboobo Davida aluzubo loonse lwa-Israyeli mbubakalonzya ibbokesi lya-Jehova cakuyowela acakulizya mweembo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
