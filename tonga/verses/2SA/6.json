            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo Davida teewakayanda kulonzya ibbokesi lya-Jehova kulinguwe kumunzi wa-Davida, pele wakalitola kuŋanda ya-Obedi-Edomu mu-Giti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
