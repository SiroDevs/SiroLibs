        },
        {
          "text": "Nkabela Davida wakayoowa Jehova kubuzuba obo, wakati, Ibbokesi lya-Jehova lisike buti kulindime? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
