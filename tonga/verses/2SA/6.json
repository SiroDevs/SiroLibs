        },
        {
          "text": "Lino Davida wakayobolola boonse basintaze baba-Israyeli, kabali zyuulu zyotatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
