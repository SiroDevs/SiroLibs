        {
          "text": "Elyo Davida wakaakukala mumonya mumampangala, nkabela wakaamba kuti ngumunzi wa-Davida. Lino Davida wakayaka koonse koonse kuzwa ku-Milo kusikila mukati. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
              "2SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
