          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya mazina aabana mbaakazyala mu-Jerusalemu: Samua, a-Sobabu, a-Natana, a-Solomoni, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
            "verseOrgIds": [
