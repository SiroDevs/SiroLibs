                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino baFilisti bakasika kuzoolimwaisya mumumpata wa-Refaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.18",
            "verseOrgIds": [
