              "items": [
                {
                  "text": "1 Sam 23:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino boonse bapati baba-Israyeli bakasika kumwami ku-Hebroni, nkabela mwami Davida wakatangana abo cizuminano nkukonya oko ku-Hebroni kubusyu bwa-Jehova, aboobo bakananika Davida kuti abe mwami wa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        }
