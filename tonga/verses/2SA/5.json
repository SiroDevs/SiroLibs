                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwami abantu bakwe bakaya ku-Jerusalemu kuyoolwana abaJebusi ibakali acisi. Mpawo bakaambila Davida kuti, Tokonzyi kunjila omuno pe, Ncobeni boofu abalema bazookonzya kukutanda. Nkaambo bakali kuyeeya kuti Davida takonzyi kunjila omuno. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.6",
            "verseOrgIds": [
              "2SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo Davida wakazunda mampangala aa-Ziyoni, ngaonya ngumunzi wa-Davida. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
              "2SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
