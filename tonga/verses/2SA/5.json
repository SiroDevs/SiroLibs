          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.6"
              },
              "items": [
                {
                  "text": "1 Mak 11:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela obo buzuba Davida wakati, Kufumbwa muntu uuma ba-Jebusi, asowele mumulinga abo balema aboofu mbasula Davida mumoyo wakwe. Nkaambo bakaamba bati, Boofu abalema mpobali. Davida takonzyi kunjila muŋanda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        },
