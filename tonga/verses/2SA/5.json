                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Davida wakali amyaaka iili makumi otatwe naakapegwa bwami, nkabela kali mwami myaaka iili makumi one. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumunzi wa-Hebroni wakali abwami bwamusyobo wa-Juda myaaka iili musanu aibili amyezi iili musanu aumwi, alimwi mu-Jerusalemu wakali abwami bwaba-Juda abwaba-Israyeli boonse myaaka iili makumi otatwe amyaaka yotatwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
