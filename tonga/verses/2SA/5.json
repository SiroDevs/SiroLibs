          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Davida wakali kuya bukomena lyoonse, alimwi Jehova Leza wamakamu makamu wakali awe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
