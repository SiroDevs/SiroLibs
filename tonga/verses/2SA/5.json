                  "text": "2 Sam 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Davida wakabuzya kuli-Jehova kuti, Sa nje kuyoolwana aba-Filisti? Sa uyoobaaba mumaanza aangu? Nkabela Jehova wakaambila Davida kuti, Ee, koya, nkaambo ncobeni ndaaba ba-Filisti mumaanza aako. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.21"
              },
              "items": [
                {
                  "text": "Is 28:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Davida wakasika ku-Baalaperazimu, wakabakoma nkukonya oko, nkabela wakati, Jehova wasotokela basinkondoma kumeso aangu mbubonya mbwasotoka maanzi. Nciceeco oko kuntu ncikwakaulikwa izina lya-Baalaperazimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela zikozyano zyabo bakazisia nkukonya oko, elyo Davida abantu bakwe bakeza kuzoozitola.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
      ]
