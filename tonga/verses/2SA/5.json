          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Filisti bakaboola lwabili kuzoolimwaisya mumumpata waRefaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Davida naakabuzya kuli-Jehova, wakaambilwa kuti, Utainki kuyoolwana pe, Kosaanguna kuzyunguluka musule lyabo akusika nkubabede kufwaafwi kumakunka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wamvwa buyo musoso wakweenda kumpela amakunka, ndilyonya noelede kunyamuka, nkaambo kuciindi eco Jehova waya kunembo lyako kuyookoma basinkondo baba-Filisti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Davida wakacita mbubonya obo mbwaakamulailila Jehova, nkabela wakabazunda ba-Filisti kuzwa ku-Geba akusikila ku-Gezeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.25",
            "verseOrgIds": [
              "2SA.5.25"
            ]
          }
        }
