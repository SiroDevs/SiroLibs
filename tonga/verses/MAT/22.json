              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awabili ulikozyene awalo, ngooyu, Yanda mweenzinyoko mbuli mboliyanda omwini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
