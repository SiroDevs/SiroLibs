              "attrs": {
                "loc": "DEU.6.5"
              },
              "items": [
                {
                  "text": "Dt 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamwaambila kuti, Yanda Leza Jehova wako amoyo wako woonse, amoya wako woonse, amumiyeeyo yako yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngooyu mulazyo mutaanzi mupati. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
