                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela umwi simulao akati kabo wakamubuzya cakusunka, wakati, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
