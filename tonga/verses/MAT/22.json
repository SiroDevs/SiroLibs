        },
        {
          "text": "Mubuzuba obo mbubonya kwakamusikila ba-Saduki, mbombabo bakali kwaamba kuti taakwe bubuke bwabafu, nkabela bakamubuzya kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
