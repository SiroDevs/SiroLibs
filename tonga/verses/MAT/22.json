              "items": [
                {
                  "text": "Kul 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.11"
              },
              "items": [
                {
                  "text": "Mt 8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime Leza wa-Abrahamu, a-Leza wa-Izaka, a-Leza wa-Jakobo? Teensi Leza wabafu pe, ngwabaumi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu boonse nibakamvwa obo bakagambisya kukwiisya kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
