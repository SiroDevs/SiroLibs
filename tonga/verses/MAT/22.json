                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Farisi nibakamvwa mbwaakabakona ba-Saduki, bakabungana antoomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
