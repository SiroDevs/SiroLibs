                "loc": "MRK.7.31"
              },
              "items": [
                {
                  "text": "Mk 7:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jesu wakazwa oko, wakainda kumbali alwizi lwaku-Galilaya. Nkabela wakatanta cilundu, wakakala nkukonya oko. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.29",
            "verseOrgIds": [
              "MAT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kwakamusikila makamu mapati aabantu, bakajisi zilema, boofu, basyataambi, batyokede, abamwi banji, bakafwambaana kubatula kumaulu aa-Jesu, nkabela wakabaponya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.30",
            "verseOrgIds": [
              "MAT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.37"
              },
              "items": [
                {
                  "text": "Mk 7:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo makamu akagamba, nkaambo bakabona kuti basyataambi baamba, azilema zyapona, abatyokede beenda, aboofu babona. Nkabela bakalemeka Leza wa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        }
      ]
    },
