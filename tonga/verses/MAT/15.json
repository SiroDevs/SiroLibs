            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.24+MRK.7.25+MRK.7.26+MRK.7.27+MRK.7.28+MRK.7.29+MRK.7.30"
              },
              "items": [
                {
                  "text": "Mk 7:24-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jesu wakazwa oko, wakatozya kuzisi zyaku-Turo aku-Sidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.21",
            "verseOrgIds": [
              "MAT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela umwi mwanakazi mu-Kanana wakucisi eco wakoongolola, wamwaambila kuti, Ndifwida luzyalo, Mwami, Mwana a-Davida, mwana wangu musimbi ulijisi loko daimona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.22",
            "verseOrgIds": [
              "MAT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele walo teewakamuvwiila niliba ijwi lyomwe. Lino basikwiiya bakwe bakeza, bakamubuzya kuti, Mutande, nkaambo uza buongolola musule lyesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.23",
            "verseOrgIds": [
              "MAT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.6"
              },
              "items": [
                {
                  "text": "Mt 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakavuwa kuti, Nsitumidwe pele kumbelele zisweekede zyamukowa wa-Israyeli luzutu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakaswena, wamukomba, wati, Mwami, ndigwasya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walo wakavuwa kuti, Tacili cibotu kubweza insima yabana akwiisowela tubwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati, Mbukubede, Mwami! nkaambo tubwa tulalya tufwefwelenga tuwa kuzwa kumatafule aabasimalelo bato, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.10"
              },
              "items": [
                {
                  "text": "Mt 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakamuvwiila wati, Webo mwanakazi, lusyomo lwako ndupati! Akucitwe kulinduwe mbuli mboyanda. Nkabela mwana wakwe musimbi wakaponezegwa kuzwa kuciindi eco nciconya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        }
      ]
    },
