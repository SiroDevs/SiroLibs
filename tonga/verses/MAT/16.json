            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mt 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.29"
              },
              "items": [
                {
                  "text": "Lk 11:29",
                  "type": "text"
