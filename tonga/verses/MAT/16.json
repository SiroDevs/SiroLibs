              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.2.1"
              },
              "items": [
                {
                  "text": "Jon 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu basunu basizibi abasibwaamu balayandaula citondezyo, pele tabakoopegwa citondezyo pe, kutaamba kuti citondezyo ca-Jona, Lino wakabasia, wakatozya kumbi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
