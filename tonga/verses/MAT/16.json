              "type": "tag",
              "attrs": {
                "loc": "MAT.17.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jesu wakavuwa, wamwaambila wati, Uli acoolwe, Simoni mwana a-Jona, nkaambo teensi bantu balya maila bakakuyubulwida boobu, ngu-Taata uuli kujulu. ",
          "type": "text",
          "attrs": {
