              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.54+LUK.12.55+LUK.12.56"
              },
              "items": [
                {
                  "text": "Lk 12:54-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakavuwa, wabaambila kuti, Nikwakaba kumazuba mulaamba kuti, Bulaca kabotu, nkaambo kujulu kulasalala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.4"
              },
              "items": [
                {
                  "text": "Mt 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi cifumofumo mulaamba kuti, Sunu bwaca bubi, nkaambo kujulu kulasalala cakusia. Mulizi kupandulula busyu bwakujulu, pele tamukonzyi kupandulula zitondezyo zyaziindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
