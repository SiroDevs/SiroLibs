              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Petro wakamutola kumbali, wasaanguna kumukazya, wati, Leza akufwide luzyalo, mwami. Cintu eci tacizoobi kulinduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Jesu wakafutatuka, waambila Petro wati, Swena oko kusule lyangu, Saatani. Uli cilebyo kulindime, nkaambo kakuti tozi makani aa-Leza, ulizi makani aabantu alike.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
