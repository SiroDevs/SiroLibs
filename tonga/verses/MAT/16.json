                  "text": "Lk 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Farisi aba-Saduki bakeza, bamusunka, bamukumbila kuti abatondezye citondezyo cizwa kujulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
