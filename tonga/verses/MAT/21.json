            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.6+1PE.2.7+1PE.2.8"
              },
              "items": [
                {
                  "text": "1 Pet 2:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jesu wabaambila wati, Sa tamubalide mumagwalo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
