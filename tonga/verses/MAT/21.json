        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino cifumofumo naakali kubweeda kumunzi wakafwa inzala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6"
              },
              "items": [
                {
                  "text": "Lk 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakabona mukuyu omwe munzila, wakeza kulinguwo, nekubaboobo teewakajana cintu niciba cimwi kulinguwo pele matu luzutu, Lino wakauambila kuti, Kutabi micelo kulinduwe kuzwa sunu akuya myaaka. Nkabela mpawo mukuyu wakayuma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino basikwiiya nibakabona obo bakagamba, bakati, Ma! mukuyu wakafwambaana buti kuyuma? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mt 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.2"
              },
              "items": [
                {
                  "text": "1 Kor 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jesu wakabavwiila, wakati, Ncobeni ndamwaambila kuti, mwaba alusyomo lwakutadoneeka, teensi eci camukuyu luzutu ncimuyookonzya, pele nikuba kuti mwaambila cilundu eci kuti, Zyuka awa akuwaalwa mulwizi, ciyoocitwa mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi zintu zyoonse nzimukumbila mukukomba kwanu, nimwasyoma muyoozipegwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
