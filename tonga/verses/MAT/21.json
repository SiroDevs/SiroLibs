              "attrs": {
                "loc": "MAT.25.14"
              },
              "items": [
                {
                  "text": "Mt 25:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuswiilile cikozyano acimwi, Kakuli muntu umwi mwiniŋanda iwakazikila muunda, wakauzyuungulusya lubaya, wakasya idindi ipati lyakusinina mulinguwo, wakayaka cisanza, wakuubika mumaanza aabalimi, lino wakaya kucisi cimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ciindi camicelo nicakaba afwiifwi wakatuma bazike bakwe kubalimi kuti batambule micelo yakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.34",
            "verseOrgIds": [
              "MAT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela balimi bakabajata bazike bakwe, bamwi bakabauma, bamwi bakabajaya, abamwi bakabafusa mabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.35",
            "verseOrgIds": [
              "MAT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakatuma bazike bambi banji kwiinda bataanzi, nkabela abalo bakabacitila mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.36",
            "verseOrgIds": [
              "MAT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino musule wakabatumina mwanaakwe, wakati, Mbali mwanaangu balamulemeka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.37",
            "verseOrgIds": [
              "MAT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.18"
              },
              "items": [
                {
                  "text": "Mt 27:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo abo balimi nibakabona mwana bakabuzyanya kuti, Ngooyu simulya izina wasika! Amuboole, tumujaye, kuti tumunyanzye lubono lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.38",
            "verseOrgIds": [
              "MAT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bakamujata, bamutanda kuzwa mumuunda, bamujaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino mwinimuunda naazoosika, uzoobacitilanzi abo balimi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwaambila kuti, Kuvwinyauna uzoovwinyauna babi abo, nkabela uzoobika muunda mumaanza aabalimi bambi, bazoomupa micelo muziindi zyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
