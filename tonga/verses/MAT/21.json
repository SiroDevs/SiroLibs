              },
              "items": [
                {
                  "text": "Joh 12:12-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nibakaswena kufwaafwi ku-Jerusalemu akusika ku-Betefage akucilundu ca-Elaioni, Jesu wakatuma basikwiiya bobile, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waka­ baambila wati, Kamuya kumunzi uuli kunembo, nkabela mpawo mulajana imbongolo iisungidwe amwana wayo. Amuzisungunune, muzilete kulindime. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.18"
              },
              "items": [
                {
                  "text": "Mt 26:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela kuti muntu akamubuzye ijwi, mukaambe kuti, Mwami uli amulimo wazyo. Ndilyonya ulazituma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela aya akaba boobo kuti akacitwe aakaambwa kumusinsimi wati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
      ]
    },
