              },
              "items": [
                {
                  "text": "45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino oyo uuwida abbwe elyo uzootyokooka, pele umwi aumwi uzoowidwa ndilyo, lizoomupwasaula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bapaizi basimutwe aba-Farisi nibakamvwa zikozyano zyakwe bakaziba kuti waamba ndiswe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakayanda kumujata, nekubaboobo bakayoowa bantu, nkaambo kakuti bakayeeya kuti musinsimi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
