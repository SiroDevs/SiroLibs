              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.12"
              },
              "items": [
                {
                  "text": "Lk 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.29+LUK.7.30"
              },
              "items": [
                {
                  "text": "7:29-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Johane wakeza kulindinywe munzila yabululami, pele inywe teemwakamuzuminina anukuti basimutelo abasibwaamu bakamuzuminina, nkabela inywe nimwakabona obo, musule teemwakeempwa akumuzuminina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
