                  "text": "Joh 2:14-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jesu wakanjila muntempele ya-Leza, wakatanda boonse ibakali kuula akuulisya muntempele, wakatapaula matafule aabo basikusintana mali, azyuuno zyabo bakali kuulisya inkwilimba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Is 56:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Jer 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wabaambila wati, Kulilembedwe kuti, Iŋanda yangu ilategwa niŋanda yakukombela, anukuti inywe mwaisandula, yaba ikoba lyababbi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mumonya muntempele kwakamuswenenena boofu abatyokede, nkabela wakabaponya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25"
              },
              "items": [
                {
                  "text": "Int 118:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bapaizi basimutwe abalembi nibakabona malele ngaakacita, abana boongolola muntempele bati, Hosana ku-Mwana a-Davida, bakakalala, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.3"
              },
              "items": [
                {
                  "text": "Int 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bamwaambila bati, Sa teewamvwa aba ncibaamba? Lino Jesu wakabaambila kuti, Ii. Sa tamubalide kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        }
