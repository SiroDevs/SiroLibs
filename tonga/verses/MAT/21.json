          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako ndamwaambila kuti Bwami bwa-Leza buzoonyanzigwa kulindinywe, buzoopegwa musyobo umbi uuzyala micelo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
            ]
          }
