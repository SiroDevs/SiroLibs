        },
        {
          "text": "Alimwi ciindi ncomukomba mutabi mbuli basikuupaupa ameso, nkaambo balayanda kukomba bwiimvwi muzikombelo amuzyooko zyamigwagwa mipati, kuti babonwe kubantu. Ncobeni ndamwaambila kuti balijene kale bulumbu bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
