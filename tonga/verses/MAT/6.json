        },
        {
          "text": "Amucenjele kuti mutaciti milimo yanu iiluleme kumeso aabantu kuti mweebelwe ambabo. Mwacita boobo, tamukwe bulumbu kuli Usowanu uuli kujulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        }
