        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.37+MAT.25.38+MAT.25.39+MAT.25.40"
              },
              "items": [
                {
                  "text": "Mt 25:37-40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.8"
              },
              "items": [
                {
                  "text": "Rom 12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele webo, ciindi ncoabila bantu zipo, ijanza lyako lyacimwensi litazibi mbulicita lyalulyo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti zipo zyako zibe kumbali, lino Uso uubonena kumbali uzookulumbula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.4",
            "verseOrgIds": [
              "MAT.6.4"
            ]
          }
        }
      ]
    },
