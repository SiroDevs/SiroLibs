          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti kuliimya kwako kutaboneki kubantu pele kuli-Uso uuli kumbali, lino Uso uubonena kumbali uzookulumbula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
