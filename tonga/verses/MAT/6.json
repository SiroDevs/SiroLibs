                "loc": "MAT.6.32"
              },
              "items": [
                {
                  "text": "Mt 6:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutakozyani abo, nkaambo Usowanu ulizi zintu nzimubula kamutana kumubuzya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.8",
            "verseOrgIds": [
              "MAT.6.8"
            ]
