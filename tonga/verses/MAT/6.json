            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.33"
              },
              "items": [
                {
                  "text": "2 Bam 4:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Webo ciindi ncokomba, njila mucimpetu cako, ulijalile kumulyango, ukombe kuli-Uso uuli kumbali, lino Uso uubonena kumbali uzookulumbula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
