          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kaako ciindi ncoabila bantu zipo utasibi impeta kubusyu bwako mbuli mbubacita basikuupaupa ameso muzikombelo amumigwagwa, kuti batembaulwe kubantu. Ncobeni ndamwaambila kuti balijene kale bulumbu bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
