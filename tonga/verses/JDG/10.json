        },
        {
          "text": "Lino Abimeleki naakamana kufwa, kwakabuka aumwi iwakavuna ba-Israyeli, nkukuti Tola mwana wa-Puwa mwana wa-Dodo, muntu waluzubo lwa-Isakara, iwakakede ku-Samiri mutulundulundu twa-Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabeteka ba-Israyeli myaka iili makumi obile aitatu, elyo wakafwa, wakazikwa ku-Samiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
