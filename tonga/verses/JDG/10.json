        },
        {
          "text": "Nkabela bantu ba-Israyeli bakaboola alimwi kubisya kumeso aa-Jehova, bakali kukomba ba-Baala aba-Asitaroti, mizimu yaba-Aramu, mizimu yabaSidoni, mizimu yaba-Moabu, mizimu yaba-Amoni, amizimu yaba-Filisti. Bakaleka Jehova, teebakali kumumanina milimo pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.9"
              },
              "items": [
                {
                  "text": "1 Sam 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bukali bwaJehova bwakabukila ba-Israyeli, nkabela wakabaaba mumaanza aaba-Filisti amumaanza aaba-Amoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo bakapwaya bana ba-Israyeli akubapenzya mwaka oyo. Myaka iili ikumi amusanu aitatu bakali kupenzya bantu boonse ba-Israyeli ibakakede mutala lya-Jordano munyika yaba-Amori, nkukuti mucisi ca-Gileadi, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ba-Amoni bakazubuka Jordano kuzoolwisya bana ba-Juda abana ba-Benjamini amukowa wa-Efraimu, aboobo ba-Israyeli bakafwaba loko.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        }
      ]
    },
