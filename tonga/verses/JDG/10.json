          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusule lyayooyo kwakabuka Jairi mu-Gileadi, wakabeteka ba-Israyeli myaka iili makumi obile aibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.3",
            "verseOrgIds": [
              "JDG.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.10"
              },
              "items": [
                {
                  "text": "Bab 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.14"
              },
              "items": [
                {
                  "text": "Dt 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kazyede bana bali makumi otatwe, ibakali kuya bweenda balitantide ambongolo zili makumi otatwe, alimwi kabajisi minzi iili makumi otatwe iyakaambwa kuti Havoti-Jairi, mbubonya mbiicaambwa asunu. Ili mucisi ca-Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Jairi naakafwa wakazikwa mu-Kamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
      ]
    },
