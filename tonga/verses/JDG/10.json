        },
        {
          "text": "Mpawo bana ba-Israyeli bakaambila Jehova kuti, Twabisya. Kotucitila kufumbwa cibota mumeso aako, pele kotuvuna buzuba obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
