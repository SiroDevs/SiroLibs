              "items": [
                {
                  "text": "Jer 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nekubaboobo mwandileka, mwakomba mizimu imbi. Nkaambo kako nsikoomuvuna limbi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
