                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo ba-Sidoni aba-Amaleki aba-Maoni bakamupenzya, elyo nimwakandikwiilila, ndakamuvuna kumaanza aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
