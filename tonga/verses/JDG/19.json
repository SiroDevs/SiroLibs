            }
          ]
        },
        {
          "text": "Lino nibakasika afwiifwi a-Jebusi, izuba lyakaamba kubbila, nkabela mulanda wakaambila mwami wakwe kuti, Boola, tunjile mumunzi oyu waba-Jebusi, tuone mumonya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
          },
          "items": [
