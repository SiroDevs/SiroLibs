              "items": [
                {
                  "text": "Is 10:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.8"
              },
              "items": [
                {
                  "text": "Hos 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mwami wakavuwa kuti, Tatweelede kunjila mumunzi wabazwamasi batali ba-Israyeli. Atwiinde kunembo, tukasike ku-Gibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaambila mulanda wakwe kuti, Boola, tukasike kuluumwi wamyeenya eyi yobile, tukoone ku-Gibeya nanka ku-Rama. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo bakaya kunembo mulweendo lwabo, nkabela izuba lyakababbilila kufwaafwi ku-Gibeya mucisi ca-Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.43"
              },
              "items": [
                {
                  "text": "Mt 25:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Heb 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo bakanyona nkuko, kuti bakaone ku-Gibeya. Nkabela wakanjila mumunzi, waakukala akati kamundando wamunzi, nkaambo katakwe muntu iwakabanjizya muŋanda yakoona.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        }
      ]
