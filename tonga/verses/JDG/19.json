          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela nibwakaca, mwanakazi wakasika kumulyango waŋanda mwakaakubede mulumaakwe, wakawida mpawo, mane izuba lyakamana kupasula.",
          "type": "text",
