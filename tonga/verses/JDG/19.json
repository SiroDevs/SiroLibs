              },
              "items": [
                {
                  "text": "2 Sam 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mulumi wakakaka koona nkuko, wakanyamuka, wakeenda, mane wakasika kufwaafwi ku-Jebusi (nkukuti Jerusalemu), Keenda ambongolo zyobile zyamikuli, alimwi kali asimamambe wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        },
