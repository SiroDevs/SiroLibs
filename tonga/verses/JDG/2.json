        {
          "text": "Lino mebo ndaamba kuti, Nsikooyoobatanda limbi kubusyu bwanu. Bayoomubeda mbuli mamvwa mumabambo aanu, amizimu yabo iyoomubeda cilebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino angelo wa-Jehova naakaambila boonse bana ba-Israyeli majwi aya, bantu bakakwiizya majwi aabo akulila, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo oko kuntu kwakaulikwa izina lya-Bokimu (nkukuti Kulila), Mpawo bakapaila Jehova nkukonya,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
