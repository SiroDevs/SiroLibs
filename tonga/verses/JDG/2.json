                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo bakamuzika munyika yacaabilo cakwe, mu-Timinatiheresi muzilundulundu zya-Efraimu kunyika lyacilundu ca-Gaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
