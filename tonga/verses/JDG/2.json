                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele inywe tamweelede kutangana cizuminano abantu bamomuno mucisi, Zipaililo zyabo muleelede kuzimwaya. Nekubaboobo tamuna kuswiilila ijwi lyangu. Mwacitila nzi obo? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
