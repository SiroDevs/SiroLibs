            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joshua naakamana kumwaisya bantu, bana ba-Israyeli boonse bakainka umwi aumwi kucaabilo cakwe kuyoovuba nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu bakamanina Jehova milimo mazuba oonse ngaakapona Joshua, amazuba oonse aabapatinyina ibakacili kupona Joshua naakamana kufwa, ibakabwene incito zigambya zya-Jehova ngaakacitila ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joshua mwana waNuni mulanda wa-Jehova wakafwa, kali amyaka iili mwaanda akumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
