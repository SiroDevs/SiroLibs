            "number": "3",
            "style": "v",
            "sid": "JDG 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakati, O Jehova Leza wa-Israyeli, nkaambonzi makani aali boobu acitwa ku-Israyeli Nkaambonzi sunu kwabula musyobo omwe waba-Israyeli? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.3",
            "verseOrgIds": [
              "JDG.21.3"
            ]
          }
        },
