                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbumweelede kucita. Baalumi boonse abanakazi boonse ibaswanene abaalumi, boonse amubanyonyoone. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.11",
