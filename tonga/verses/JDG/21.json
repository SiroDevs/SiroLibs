        {
          "text": "Mpawo imbungano yakatuma nkuko zyuulu zili ikumi azibili zya bantu babo bakozu. Bakabalailila kuti Kamuya mukajazye ipanga bantu boonse bakede ku-Jabezi-Gileadi, abanakazi boonse abana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.10",
            "verseOrgIds": [
              "JDG.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
