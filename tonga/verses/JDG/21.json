        {
          "text": "Nkabela bantu bakasika ku-Beteli, bakakala nkuko kubusyu bwa-Leza mane kumabbililo aazuba, alimwi bakoomoka amajwi aabo cakulila loko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.2",
            "verseOrgIds": [
              "JDG.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
