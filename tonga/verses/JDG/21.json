              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu nibakabalwa katakwe muntu naba omwe wabantu ba-Jabezi-Gileadi iwakajanika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.9",
            "verseOrgIds": [
              "JDG.21.9"
            ]
          }
        },
