                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo naakabweedezezya banyina mali, banyina bakabweza mali aansiliva aali myanda yobile, bakapa mufuzi, nkabela wakapanga cikozyano cibezedwe acikozyano cifulidwe. Zyakabikwa muŋanda ya-Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
