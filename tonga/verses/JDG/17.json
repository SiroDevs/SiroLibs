                  "text": "Matl 45:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Mika wakamwaambila kuti, Kala kulindime, undibede taata amupaizi wangu, nkabela njookupa mali aansiliva aali ikumi amwaka, azyakusama, amalilu aako, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mu-Levi wakazumina kukala anguwe, nkabela oyo mukubusi wakaba mbubonya mbuli umwi wabana bakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.11",
            "verseOrgIds": [
              "JDG.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo Mika mbwaakabika mu-Levi, Mukubusi wakaba mupaizi wakwe, alimwi wakali kukala munanda ya-Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.12",
            "verseOrgIds": [
              "JDG.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Mika wakati, Lino ncobeni ndizi kuti Jehova ulandipa coolwe, nkaambo ndijisi mu-Levi mupaizi wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        }
