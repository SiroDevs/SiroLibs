                  "text": "2 Bam 5:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Samsoni wakabaambila kuti, Ndabike kalabi. Na mwakonzya kulabulula, mazuba aali musanu aabili aapobwe naatana kumana, akundaambila mbukaamba, elyo njoomwaabila masani aali makumi otatwe azyakusama zimwi zili makumi otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na mwakacilwa kundipandulwida, elyo inywe muleelede kundipa masani aali makumi otatwe azyakusama zimwi zili makumi otatwe. Bakavuwa kuti, Kalabi kako kakeza, tuswiilile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakabaambila kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
