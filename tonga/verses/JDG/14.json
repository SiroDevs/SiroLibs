              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samsoni wakainka awisi abanyina kuya ku-Timinati, nkabela naakasika kumyuunda yamasaansa yaku-Timinati, kwakeza mwana wamulavu uleza buvuluma kuzoomucinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.10"
              },
              "items": [
                {
                  "text": "Bab 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.25"
              },
              "items": [
                {
                  "text": "13:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.6"
              },
              "items": [
                {
                  "text": "1 Sam 11:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpoonya awo Muuya wa-Jehova wakamuselukila canguzu, aboobo wakadeluula mulavu mbubonya mbuli muntu mbwadeluula kapongo buyo. Katajisi cintu niciba cimwi mujanza lyakwe. Pele takwakaambila wisi na banyina ncaakacita pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo wakainka kuyooambaula amwanakazi, nkabela wakabotezya Samsoni loko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.7",
            "verseOrgIds": [
              "JDG.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nicakaba ciindi wakaboola kuti amulete muŋanda, elyo wakaya musokwe kuyoobona mutumba wamulavu, nkabela omo mumutumba wamulavu kamuli inzuki abuci. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.8",
            "verseOrgIds": [
              "JDG.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakagwisya amaanza aakwe, wakali kuya bulya, alimwi naakasika kuliwisi akulibanyina, wakabaabila, elyo bakalya abalo, pele takwakabaambila kuti obo buci wakabugwisya mumutumba wamulavu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
