        },
        {
          "text": "Wisi abanyina teebakaziba kuti makani akazwa kuli-Jehova, nkaambo wakali kuyanda kubusya inkondo aba-Filisti, nkaambo kakuti kuciindi eco ba-Filisti mbobakajisi bwami bwaba-Israyeli,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        }
