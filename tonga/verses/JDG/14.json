        },
        {
          "text": "Lino Samsoni wakaya ku-Timinati, nkabela nkukonya ku-Timinati wakabona umwi musimbi waba-Filisti. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
