              "attrs": {
                "loc": "DEU.7.3"
              },
              "items": [
                {
                  "text": "Dt 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wisi abanyina bakamubuzya kuti, Sa taakwe mwanakazi akati kabana bamukowa wesu na akati kabantu besu boonse? Nkaambonzi noyanda kukwata mwanakazi waba-Filisti batapalwidwe? Pele Samsoni wakaambila wisi kuti, Amundikwatye oyo musimbi, nkaambo wandibotela loko.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
