                {
                  "text": "Bab 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo muka-Samsoni wakalila kulinguwe, wakati, Wandisula buyo, tondiyandi pe. Walabikila bana babantu bangu kalabi, pele tona kundaambila mebo pe. Wakamuvwiila kuti, Ataata abama nsina kubaambila pe. Nkwaambile buti webo? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakali kulila kumeso aakwe mazuba aali musanu aabili ipobwe nilyakali kuligwa, Nkabela mubuzuba bwamusanu aabili wakamwaambila makani, nkaambo wakali kumukataazya. Mpawo wakapandulwida basimukowanyina kalabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.17",
            "verseOrgIds": [
              "JDG.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mubuzuba bwamusanu aabili, izuba nilyakatalina kubbila, bantu bamunzi bakamwaambila kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
