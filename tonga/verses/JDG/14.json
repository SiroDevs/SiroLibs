                "loc": "GEN.21.21"
              },
              "items": [
                {
                  "text": "Matl 21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.4"
              },
              "items": [
                {
                  "text": "34:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo naakapiluka kulimba­ bo, wakaambila wisi abanyina kuti, Ndibwene mwanakazi ku-Timinati, umwi wabana baba-Filisti. Lino amundigwasye kuti nkamukwate, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
