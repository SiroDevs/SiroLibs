                "loc": "LUK.15.29"
              },
              "items": [
                {
                  "text": "Lk 15:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nicakaba ciindi, bulotwe nibwakali kutebulwa, Samsoni wakainka akapongo kuyooswaya mukaakwe. Wakati, Njile muŋanda mukaangu mwaabede, Pele wisi takwakamuzumizya kunjila, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.1",
            "verseOrgIds": [
              "JDG.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.20"
              },
              "items": [
                {
                  "text": "Bab 14:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wisi wakati, Ndakali kuyeeya kuti ncobeni wamusula, Nciceeco ncindamupeda mweenzinyoko. Sa mucizi wakwe muniini taboti kwiinda nguwe na? Kwata nguwe mucibaka cakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.2",
            "verseOrgIds": [
              "JDG.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samsoni wakabaambila kuti, Ciindi ecino ndiye inkoto kuba-Filisti, nkaambo njoobabisizya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.3",
            "verseOrgIds": [
              "JDG.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.2.15"
              },
              "items": [
                {
                  "text": "Lwi 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.4"
              },
              "items": [
                {
                  "text": "Ezk 13:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Samsoni wakainka, wakajata bamwaaba bali myanda yotatwe, nkabela wakabweza misunge, wakabaanga kumicila yabo akubikila bobile bobile musunge akati kamicila yabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.4",
            "verseOrgIds": [
              "JDG.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naakamana kutomeka misunge, wakabatuma akati kamaila aabaFilisti, aboobo wakatenta misunta yamaila amaila aacili mukumena amyuunda yamicelo yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.5",
            "verseOrgIds": [
              "JDG.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.15"
              },
              "items": [
                {
                  "text": "Bab 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ba-Filisti bakabuzya kuti, Ino nguni wakacita obo? Nkabela bakati, Ngu-Samsoni iwakakwata mwana musimbi wamu­-Timinati, nkaambo bakamunyanzya mukaakwe, bakamupa mweenzinyina. Mpawo ba-Filisti bakainka, baakutenta musimbi awisi mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Samsoni wakabaambila kuti, Na mwacita obo, ncobeni njooliya inkoto alimwi, lino ndaleka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.7",
            "verseOrgIds": [
              "JDG.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.4.3"
              },
              "items": [
                {
                  "text": "1 Mak 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.6"
              },
              "items": [
                {
                  "text": "2 Mak 11:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo wakabauma canguzu loko abujayi bupati. Lino wakaseluka, waakukala mulwaanzi lwandomba Etamu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        }
      ]
    },
