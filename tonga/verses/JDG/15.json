          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ba-Filisti bakainka, bakaakuliyakila zilao mucisi ca-Juda, alimwi bakaakusaala Lehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu ba-Juda bakabuzya kuti, Ino mwazidanzi okuno kulindiswe? Bakavuwa kuti, Tweza kuzooanga Samsoni, tumucitile mbubonya mbwaakacitila ndiswe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        },
