                  "text": "Jos 4:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele walo mwini wakapiluka kuzwa kumigodi yaku-Giligala, wakati, Ndijisi ijwi lyakwaamba kumbali, O mwami, Lino wakaamba kuti, Amutuleke, Mpawo bantu boonse mbaakali abo bakazwa anze, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Ehudi naakaswena nkwakabede, wakalikede muŋanda yakulitontozya yamujulu njakajisi. Mpawo Ehudi wakati, Ndijisi ijwi lya-Leza lyakwaambila nduwe, O mwami, Elyo naakanyampuka acuuno cakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehudi wakatandabula ijanza lyakwe lyalumwensi, wakasomona ipanga lyakali kulubbazu lwakwe lwalulyo, akumuyasa mwida. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluti alwalo lwakanjila musule lyamemba, amafuta akasinka kumemba, nkaambo takakalisomona ipanga mubula bwakwe pe, elyo kwakazwa cifusi, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Ehudi wakazwa akuya mulukonkono, wakajala milyango yaŋanda musule lyakwe, akwiikwiida. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakamana kwiinka, balanda bakwe bakasika, bakabona kuti milyango yaŋanda ilikwiididwe, elyo bakaamba kuti, Ncobeni ulavumba maulu aakwe muŋanda yakulitontozya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakalindila mane bakafwa insoni, pele teewakajalula milyango yaŋanda pe, lino bakabweza inkwiidizyo, bajula mulyango, bakajana mwami wabo uliwide ansi, ulifwide. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Ehudi wakalilobokede nibakacili kulindila, wakainda mutala lyamigodi, wakasika ku-Scira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.26",
            "verseOrgIds": [
              "JDG.3.26"
            ]
          }
