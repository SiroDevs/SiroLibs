          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakajaya akati kaba-Moabu kuciindi eco bantu bali zyuulu zili ikumi, boonse kabali basintaze, Teekwakaloboka muntu naba omwe akati kabo, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
