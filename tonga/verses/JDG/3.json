          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo ba-Moabu bakazundwa mubuzuba obo akweendelezegwa kubana ba-Israyeli, Elyo nyika yakalitontwede myaka iili makumi aali musanu aatatu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
