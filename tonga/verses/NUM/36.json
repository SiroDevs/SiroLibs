              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kwakasika basilutwe banzubo zyabana ba-Gileadi mwana waMakiri mwana wa-Manase, inzubo zyabana ba-Josefa, nkabela bakaamba mumatwi aa-Musa amumatwi aabapati basilutwe banzubo zyabana ba-Israyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
