            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.3"
              },
              "items": [
                {
                  "text": "Jos 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bati, Jehova wakalailila simalelo wesu kwaabila bana baIsrayeli nyika kucisolo, alimwi simalelo wesu wakalaililwa kuli-Jehova kuti lukono lwamukwesu Zelofehadi lupegwe bana bakwe basimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na bakwatwa kumusyobo umbi wabana ba-Israyeli, lino lukono lwabo luyootolwa kuzwa kumusyobo wabamatata, luyooba lwamusyobo umbi; luyootolwa kumusyobo nkubakwatwa, aboobo lulaloba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.3",
            "verseOrgIds": [
              "NUM.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.10"
              },
              "items": [
                {
                  "text": "Lev 25:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waakusika mwaka wakulizya myeembo akati kabana ba-Israyeli, lukono lwabo luyooyungizizigwa kulukono lwamusyobo oyo nkubayookwatwa, luyoolobelela kumusyobo wabamatata.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        }
      ]
    },
