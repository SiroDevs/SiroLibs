            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Musa wakalailila bana ba-Israyeli kumulomo wa-Jehova, wati, Musyobo wabana ba-Josefa waamba ciluleme. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbuboobu Jehova mbwaalailila aabana basimbi ba-Zelofehadi. Bakwatwe kufumbwa muntu ngubayanda, pele bakwatwe mumonya mumusyobo wabamawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.3"
              },
              "items": [
                {
                  "text": "1 Bam 21:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lukono lwabana ba-Israyeli talweelede kutolwa kumusyobo umbi; bana ba-Israyeli bakakatile umwi aumwi kulukono lwamusyobo wawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.7",
            "verseOrgIds": [
              "NUM.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.22"
              },
              "items": [
                {
                  "text": "1 Mak 23:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kufumbwa mwanakazi uukona lukono mumusyobo nuuba umwi wabana ba-Israyeli, akwatwe kumwaalumi wamusyobo wabamawisi, kuti bana ba-Israyeli bakone umwi aumwi lukono lwabamawisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.8",
            "verseOrgIds": [
              "NUM.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutabi lukono lutolwa kumusyobo umbi pe. Misyobo yabana ba-Israyeli ikakatile umwi aumwi kulukono lwawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        }
      ]
