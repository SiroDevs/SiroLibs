        },
        {
          "text": "Lino umwi muntu uusalala akukule musizi wampwizi, ausowele mubusena busalala anze lyamalabba. Lino ulabambilwa imbungano yabana baIsrayeli, ube wamaanzi aabusofwi aakusalazya zibi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
