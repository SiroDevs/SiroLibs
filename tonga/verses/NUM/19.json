        {
          "text": "Alimwi mupaizi abweze tusamu twakedari amusamu wahisopo atusani tusalala pyu, aziwaale mukati kamulilo nkwiipya impwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
