          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumbwa muntu uuli musokwe uuguma muntu uujayidwe apanga, nanka mutunta, nanka cifuwa camuntu, nanka kabanda, oyo muntu ulasofwaala mazuba aali musanu aabili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        },
        {
