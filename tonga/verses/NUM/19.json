            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe sikwiitenta uleelede kusanzya zyakusama zyakwe akusamba amubili, elyo ulasofwaala mane kusikila kumabbililo aazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        },
        {
