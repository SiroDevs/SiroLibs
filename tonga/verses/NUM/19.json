          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kumuntu uusofweede babweze itwe lyacipaizyo cazibi, batile maanzi aaenda mpoonya awo munongo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
