            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela oyo muntu uukukula musizi wampwizi, alakwe uleelede kusanzya zyakusama zyakwe akusofwaala mane kusikila kumabbililo aazuba. Ngumulao walyoonse kubana ba-Israyeli akumweenzu uukalakala akati kabo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
