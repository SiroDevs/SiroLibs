                  "text": "Lev 11:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acibelesyo cimwi acimwi cijalukide, citakwe civunisyo, cilasofwaala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
