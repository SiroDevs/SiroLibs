              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo Musa wakaambila bana ba-Israyeli kuti balye Pasika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
