          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubuzuba bwakumi aane bwamwezi uno, kuciindi cagoko, amulye ipobwe kuciindi calyo ceelede, mbubonya mbuli milao yalyo yoonse ambeta zyalyo zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        },
        {
          "name": "verse",
