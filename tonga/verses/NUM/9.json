                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana ba-Israyeli balye ipobwe lya-Pasika kuciindi calyo ceelede. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
