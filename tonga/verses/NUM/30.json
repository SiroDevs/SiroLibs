          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njeeyo milumbe Jehova njaakalailila Musa, mumakani aamwaalumi amukakwe, amumakani aawisi amwana wakwe musimbi nacili muniini muŋanda yawisi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
