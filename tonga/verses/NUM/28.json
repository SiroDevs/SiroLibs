        },
        {
          "text": "antoomwe acipaizyo cabusu, zipanzi zyotatwe zyakumi zyabusu bunante bukandidwe amafuta kukapoho kamwi akamwi, azipanzi zyobile zyakumi zyabusu bunante bukandidwe amafuta kumugutu umwi aumwi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "acipanzi comwe cakumi cabusu bunante bukandidwe amafuta kukabelele kamwi akamwi, Ezi zyoonse zibe cipaizyo cili abweema bubotu citentelwa Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azipaizyo zyakunywa zilaba cisela cansazi yawaini kukapoho kamwi akamwi, acipaizyo catatu cansazi kumugutu umwi aumwi, acipaizyo cane cansazi kukabelele kamwi akamwi. Mbuubede mulao wacipaizyo camwezi mupya mumyezi yoonse yamumwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kupaizigwe sijembwe omwe, abe cipaizyo cazibi kuli-Jehova, atala lyazeezyo zipaizyo zituulwa lyoonse, acipaizyo cakwe cakunywa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        }
