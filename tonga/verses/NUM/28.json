              "type": "text"
            }
          ]
        },
        {
          "text": "Amubuzuba bwa-Sabata amutuule tubelele tobile tuli amwaka omwe tutakwe kampenda, acipaizyo cabusu, zipanzi zyobile zyakumi zyacisuwo cabusu bunante bukandidwe amafuta, acipaizyo caco cakunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
