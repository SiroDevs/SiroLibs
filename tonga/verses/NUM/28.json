                  "text": "Ezk 46:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbucibede cituuzyo cabuzuba bwa-Sabata imwi aimwi, atala lyazituuzyo zya lyoonse, acipaizyo caco cakunywa.",
          "type": "text",
          "attrs": {
