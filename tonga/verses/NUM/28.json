              "items": [
                {
                  "text": "Kul 12:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kabelele kamwi amukatuule cifumofumo, akabelele kabili amukatuule igoko, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.4",
            "verseOrgIds": [
              "NUM.28.4"
            ]
