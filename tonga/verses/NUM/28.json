                  "text": "Kul 29:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi ubaambile kuti, Nceeci cipaizyo ncimweelede kutentela Jehova: tubelele tobile tuli amwaka omwe tutakwe kampenda buzuba abuzuba ciindi coonse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
