        {
          "text": "Acipaizyo caco cakunywa cilaba cipanzi cane cansazi kukabelele kamwi akamwi, Mubusena busalalisya amutile cipaizyo cawaini uusaside kuli-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabelele kabili amukatuule ciindi cagoko, antoomwe acipaizyo cabusu acipaizyo cakunywa mbubonya mbuli cifumofumo; kube cipaizyo citentwa cili abweema bubotu bwakubotezya Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        }
