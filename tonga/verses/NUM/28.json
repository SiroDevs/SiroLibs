                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "antoomwe acipaizyo cabusu, cipanzi calusuwo lwabusu bunante bukandidwe acipanzi cane cansazi yamafuta aatwidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbucibede cipaizyo calyoonse icakalaililwa kucilundu ca-Sinai, cili abweema bubotu, cakutentela Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "verse",
