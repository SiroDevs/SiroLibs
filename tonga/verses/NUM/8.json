        {
          "text": "Ambila Aroni kuti, Nobamba malampi, malampi aali musanu aabili aleelede kumunika kunembo lya­ ciimikilo camalampi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
