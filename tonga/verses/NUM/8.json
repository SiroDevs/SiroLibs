          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "Kul 25:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mbuboobu ciimikilo camalampi mbucakacitwa: cakali cifulamubisi; kuzwa kutako lyaco kusikila kumalubaluba aaco, coonse cakali cifula mubisi; mbuli cinkozya Jehoya ncaakatondezya Musa, wakacita ciimikilo camalampi mbubonya obo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
