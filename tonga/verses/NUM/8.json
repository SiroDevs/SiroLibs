              "items": [
                {
                  "text": "Lev 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino waswenya ba-Levi afwaafwi kubusyu bwaJehova, bana ba-Israyeli babike maanza aabo amitwe yaba-Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.10",
            "verseOrgIds": [
              "NUM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Aroni uleelede kuyumba ba-Levi mbuli cipaizyo cabana ba-Israyeli cakuyumba kubusyu bwa-Jehova, kuti bacite milimo ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
