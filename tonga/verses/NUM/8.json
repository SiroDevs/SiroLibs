            }
          ]
        },
        {
          "text": "Lino ba-Levi babike maanza aabo amitwe yatupoho, nkabela kamwi kapaizigwe mbuli cipaizyo cazibi, akamwi kabe cipaizyo cakutentela Jehova, kuti umanye milandu yaba-Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
