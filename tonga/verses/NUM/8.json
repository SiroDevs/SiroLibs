          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobo mboelede kwiimika ba-Levi kunembo lya-Aroni akunembo lyabana bakwe, akubayumba mbuli cipaizyo cakuyumba kubusyu bwa-Jehova,",
          "type": "text",
