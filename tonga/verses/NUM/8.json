        {
          "text": "Bamane obo babweze kapoho acipaizyo cako cabusu bunante buvwelene amafuta. Akamwi kapoho kabili ukabweze kabe cipaizyo cazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
