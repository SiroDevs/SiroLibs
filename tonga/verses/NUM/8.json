        },
        {
          "text": "Lino ba-Levi, uleelede kubaswenya afwaafwi kunembo lyatente lyambunganino akubunganya imbungano yoonse yabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
