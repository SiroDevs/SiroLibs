        },
        {
          "text": "kumusyobo wa-Juda, Kalebe mwana wa-Jefune, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.6",
            "verseOrgIds": [
              "NUM.13.6"
            ]
          }
