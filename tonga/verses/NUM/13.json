        },
        {
          "text": "Bakaya kuNegebi akusika ku-Hebroni. Nkabela Ahimani a Sesai a-Talimai, bana ba-Anaki, mpobakakede. (Hebroni wakayakwa myaka iili musanu aibili kuutana kuyakwa Zoani waku-Egepita.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.22",
            "verseOrgIds": [
              "NUM.13.22"
            ]
          }
        },
        {
          "name": "verse",
