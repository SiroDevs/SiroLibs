        },
        {
          "text": "Lino Musa wakabatuma kuyootwela nyika ya-Kanana, nkabela wakabaambila kuti, Kamuya kucisi caku-Negebi akuzilundulundu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
