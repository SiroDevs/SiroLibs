                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tuma bantu kuyootwela nyika ya-Kanana njindapa bana ba-Israyeli. Tuma muntu omwe omwe kumusyobo umwi aumwi. Boonse babe bazuluzi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo Musa wakabatuma kuzwa kunkanda ya-Parana, mbubonya mbwaakalailila Jehova, Bantu boonse bakali bazuluzi akati kabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya mazina aabo: kumusyobo wa-Rubeni, Samua mwana wa-Zakuri; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumusyobo wa-Simeoni, Safati mwana wa-Hori; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        },
        {
