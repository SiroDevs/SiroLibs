          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumusyobo wa-Isakara, Igali mwana wa-Josefa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        },
