          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumusyobo wa-Dani, Amiyeli mwana wa-Gemali; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.12",
            "verseOrgIds": [
              "NUM.13.12"
            ]
          }
