              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amane mazuba aali makumi one, bakaboola kuzwa kukutwela nyika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
