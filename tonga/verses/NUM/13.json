          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumusyobo wa-Efraimu, Hosea mwana wa-Nuni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.8",
            "verseOrgIds": [
              "NUM.13.8"
            ]
          }
        },
        {
