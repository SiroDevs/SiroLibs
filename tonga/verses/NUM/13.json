          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakasika kuli-Musa a-Aroni ambungano yoonse yaba-Israyeli kuKedesi mu nkanda ya-Parana, nkabela bakabaletela impuwo, balo ambungano yoonse yabantu, akuba tondezya micelo yanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.26",
            "verseOrgIds": [
              "NUM.13.26"
            ]
          }
        },
        {
