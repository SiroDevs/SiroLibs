              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi ambila bana ba-Israyeli kuti, Na muntu wafwa uutazyede mwana mulombe, lukono lwakwe lulaba lwamwana wakwe musimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.8",
            "verseOrgIds": [
              "NUM.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tazyede basimbi, mulapa bazyalwanyina lukono lwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.9",
            "verseOrgIds": [
              "NUM.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tajisi muzyalwanyina, amupe lukono lwakwe kubazyalwanyina wisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.10",
            "verseOrgIds": [
              "NUM.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
