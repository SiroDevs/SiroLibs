                  "text": "My 36:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bana basimbi ba-Zelofehadi baamba kabotu. Ncobeni uleelede kubaabila lukono akati kababunyina bawisi. Lukono lwawisaabo lulaba mumaanza aabo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.7",
            "verseOrgIds": [
              "NUM.27.7"
            ]
          }
        }
