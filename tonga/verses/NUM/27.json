        {
          "text": "Nkabela bakaima kubusyu bwa-Musa a-Eleazara mupaizi abasilutwe boonse abantu boonse kumulyango watente Jyambunganino, bati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.2",
            "verseOrgIds": [
