              "items": [
                {
                  "text": "My 35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wisi tajisi muzyalwanyina, amupe lukono lwakwe kufumbwa silufulunyina, aluvube. Oyu ulaba mulao ambeta kubana ba-Israyeli, mbubonya mbuli Jehova mbwaakalailila Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
