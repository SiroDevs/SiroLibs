            "number": "3",
            "style": "v",
            "sid": "NUM 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tateesu wakafwa munkanda. Takwakali umwi wabaabo ibakapapila Jehova munkamu ya-Kora pe, pele wakafwa nkaambo kazibi zyakwe mwini. Nkabela katajisi bana baalumi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.3",
            "verseOrgIds": [
              "NUM.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa ncibotu kuti izina lyatateesu lifwidilile muciinga cakwe nkaambo kakubula bana baalumi? Utupe lukono aswebo akati kababunyina batateesu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.4",
            "verseOrgIds": [
              "NUM.27.4"
            ]
          }
        }
