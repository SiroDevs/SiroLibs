          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakaambila Musa kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.6",
            "verseOrgIds": [
              "NUM.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 27:7"
          },
          "items": [
