            "number": "8",
            "style": "v",
            "sid": "NUM 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Kolicitila inzoka akwiianzika akasamu mbuli ndembela; lino kufumbwa muntu uulumidwe aibona buyo ulapona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.8",
            "verseOrgIds": [
              "NUM.21.8"
            ]
          }
        },
