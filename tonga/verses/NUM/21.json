        },
        {
          "text": "Lino bantu bakeza kuli-Musa, bati, Twabisya, nkaambo twanyontauka Jehova ayebo. Utukombele kuliJehova atugwisizye inzoka, Mpawo Musa wakakombela bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "verse",
