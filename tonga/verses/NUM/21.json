            }
          ]
        },
        {
          "text": "Elyo Musa wakapanga inzoka yamukuba, waianzika akasamu mbuli ndembela, nkabela kufumbwa muntu iwakalumwa inzoka, alanga buyo kunzoka yamukuba, wakapona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
