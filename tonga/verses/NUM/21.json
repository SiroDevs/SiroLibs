              "items": [
                {
                  "text": "Bab 11:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuzwa oko bakalongela mutala lya-Arinoni uuli munkanda uubambene aba-Amori, nkaambo Arinoni ngumugaano waba-Moabu, nkokuti mugaano akatikati kaba-Moabu aba-Amori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako kulaambwa mubbuku lyankondo zya-Jehova kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
