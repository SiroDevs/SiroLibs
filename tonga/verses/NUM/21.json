              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bana ba-Israyeli bakanyamuka, baakuyaka zilao zyabo ku-Oboti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa ku-Oboti bakaakuyaka ku-Iyebarimu munkanda iilangene acisi ca-Moabu kulubazu lwakubuzwezuba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa oko bakaakuyaka mukuti lya-Zeredi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
