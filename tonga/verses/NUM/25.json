          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.8"
              },
              "items": [
                {
                  "text": "1 Kor 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele abo ibakafwa mulunyonyooko olo bakali zyuulu zili makumi obile azine.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
