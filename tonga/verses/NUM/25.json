        {
          "text": "Nkabela abo bakatamba bantu kuzipai­ zyo zyabaleza babo, elyo bantu bakali kulya akukotamina baleza babo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
