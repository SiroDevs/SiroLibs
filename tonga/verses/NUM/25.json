                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo ba-Israyeli bakaliswanaanya a-Baala-Peori, mane bukali bwaJehova bwakabukila ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
