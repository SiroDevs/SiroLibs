              "items": [
                {
                  "text": "1 Bam 18:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Musa wakaambila babetesi ba-Israyeli kuti, Amujaye umwi aumwi bantu bakwe, nkokuti boonse baliswanaanya a-Baala-Peori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
