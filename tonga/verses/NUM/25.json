              "items": [
                {
                  "text": "Kul 6:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Pinehasi mwana wa-Eleazara mwana wa-Aroni mupaizi, abone obo, wakanyampuka, wazwa mumbungano, wabweza isumo lyakwe mujanza lyakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "watobela oyo mu-Israyeli mane wanjila mucinkutikwa, nkabela wakabayasa intungabulumba, boonse, bobile, mwaalumi mu-Israyeli amwanakazi, Aboobo lunyonyooko lwakalesegwa akati kabana ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 25:9"
          },
          "items": [
