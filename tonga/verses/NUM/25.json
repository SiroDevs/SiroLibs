        },
        {
          "text": "Lino umwi wabana ba-Israyeli wakaleta mwanakazi waku-Midyani kumukowa wakwe mumeso aa-Musa amumeso aambungano yoonse yabana ba-Israyeli, nibakacili kulila kumulyango watente lyambunganino, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.6",
            "verseOrgIds": [
              "NUM.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
