        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.17"
              },
              "items": [
                {
                  "text": "Jos 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.17"
              },
              "items": [
                {
                  "text": "Dt 13:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jehova wakaambila Musa kuti, Jata basilutwe boonse babantu akubasina antangalala kumeso aa-Jehova, kuti Jehova aleke bukali bwakwe buyoosya mbwakalalila ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
