                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele ulapa aluzyalo luya buvula. Nkaambo kaako kulaambwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.6",
            "verseOrgIds": [
              "JAS.4.6"
            ]
