        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakwesu, mutavwiyani, nkaambo uuvwiya mweenzinyina, naba uubeteka mweenzinyina, wabisya mulao, wabeleka mulao, eno mbowabeteka mulao toli sikubamba mulao, pe, uli silubeta buyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.11",
            "verseOrgIds": [
              "JAS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
