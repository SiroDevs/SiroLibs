            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikaka nywebo nomwaamba kuti, Sunu na junza ndaya kuli banyomfwi, tukakale oko mwaka woonse, tukasambale, tujane impindu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.20"
              },
              "items": [
                {
                  "text": "Lk 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.5"
              },
              "items": [
                {
                  "text": "Int 39:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.39.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anukuti tamucizi ciyooba junza. Ino buumi bwanu ninzi? Ningubi buyo iibonwa kaindi kaniini, ndilyonya yamana, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.14",
            "verseOrgIds": [
              "JAS.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.21"
              },
              "items": [
                {
                  "text": "Inc 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cintu ncimweelede kwaamba nceeci cakuti, Na Mwami wayanda, tulapona, tulacita bobuya abobuya. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.15",
            "verseOrgIds": [
              "JAS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eno mulalikankaizizya kulisumpula kwanu. Kulikankaizya kuli bobuya koonse nkubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.16",
            "verseOrgIds": [
              "JAS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.47"
              },
              "items": [
                {
                  "text": "Lk 12:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.23"
              },
              "items": [
                {
                  "text": "Rom 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino oyo uuzi kucita kabotu, nekubaboobo taciti, wabisya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.17",
            "verseOrgIds": [
              "JAS.4.17"
            ]
          }
        }
