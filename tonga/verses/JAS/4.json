                  "text": "Gal 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa muyeeya kuti magwalo aamba buyo aamba kuti, Muuya ngwaakakalika mukati kesu ulizwide ibbivwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.5",
