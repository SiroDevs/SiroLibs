          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.1"
              },
              "items": [
                {
                  "text": "Mk 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.1"
              },
              "items": [
                {
                  "text": "Rom 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.4"
              },
              "items": [
                {
                  "text": "14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuli umwi uulenga milao, uubeteka, ngonguwe uukonzya kufutula akufwidilizya. Ino nduweni yebo obeteka mweenzinyoko?",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.12",
            "verseOrgIds": [
              "JAS.4.12"
            ]
          }
        }
      ]
