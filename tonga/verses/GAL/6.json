                "loc": "JAS.5.19"
              },
              "items": [
                {
                  "text": "Jak 5:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakwesu, kuti muntu wajanwa uli mukubisya, nywebo nomuli basimuuya muleelede kumuboozya, nkabela nimucita obo muleelede kuba amyoyo iibombede, ikuti umwi aumwi akati kanu uleelede kulilanga mwini, nkaambo inga ulatepaulwa alakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amunyampuzyanye mikuli, aboobo mulalondola mulao wa-Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na muntu ulayeeya kuti, Ndi mulemu, anukuti tajisi bulemu abuniini, oyo muntu ulalyeena, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.5"
              },
              "items": [
                {
                  "text": "2 Kor 13:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele muntu umwi aumwi alingule milimo yakwe mwini, aboobo ulajana cintu cakulikankaizizya mwini, citali camweenzinyina. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.12"
              },
              "items": [
                {
                  "text": "Rom 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo umwi aumwi uleelede kunyampula mukuli wakwe mwini. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.14"
              },
              "items": [
                {
                  "text": "1 Kor 9:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo uuiya uleelede kwaabilana zintu zibotu zyoonse ayooyo uumwiisya,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
