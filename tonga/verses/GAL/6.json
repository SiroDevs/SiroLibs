          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino luzyalo lwa-Mwami wesu Jesu Kristo alube amyoyo yanu, bakwesu. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
