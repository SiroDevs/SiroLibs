              "items": [
                {
                  "text": "Flp 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bantu boonse batobela cipimo eci babe aluumuno alweetelelo, abalo bana ba-Israyeli ba-Leza.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
