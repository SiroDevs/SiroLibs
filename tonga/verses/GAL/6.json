              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa sunu kutabi muntu naba omwe uundipenzya, nkaambo amubili wangu ndaandwa azyaando zya-Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
