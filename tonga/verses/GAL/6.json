          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalubi, Leza tacapwi. Kufumbwa ncabyala muntu, ulatebula eco nciconya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.7",
            "verseOrgIds": [
              "GAL.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.13"
              },
              "items": [
                {
                  "text": "Rom 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.63"
              },
              "items": [
                {
                  "text": "Joh 6:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.6"
              },
              "items": [
                {
                  "text": "3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oyo uubyala zintu zyanyama ulatebula bubozi buzwa kunyama, pele oyo uubyala zintu zyamuuya ulatebula buumi butamani buzwa kuMuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.8",
            "verseOrgIds": [
              "GAL.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.3.13"
              },
              "items": [
                {
                  "text": "2 Tes 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino tutalengaani mukucita kabotu, nkaambo kuciindi ceelede tulatebula, twatafunuka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.9",
            "verseOrgIds": [
              "GAL.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.1.7"
              },
              "items": [
                {
                  "text": "2 Pet 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kaako, nitujisi ciindi cibotu, atucitile bantu boonse milimo mibotu, pele kwaambisya kulibaabo baciinga calusyomo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        }
      ]
