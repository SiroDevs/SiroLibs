                "loc": "1PE.2.11"
              },
              "items": [
                {
                  "text": "1 Pet 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nyama ilijisi zisusi zilwisya Muuya, awalo Muuya ulalwisya nyama, Ezi zyobile zilasundana, aboobo mulakacilwa kucita mbuli mbwiiyanda myoyo yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
