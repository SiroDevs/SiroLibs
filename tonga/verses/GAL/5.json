              "type": "text"
            }
          ]
        },
        {
          "text": "Nciŋamba nceeci, Inzila niimweendela ibe yamu-Muuya, aboobo mutakaciti zisusi zyanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
