            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.14"
              },
              "items": [
                {
                  "text": "Rom 8:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele kuti mulasungulwa a-Muuya, elyo tamuli kunsi a-Mulao.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
