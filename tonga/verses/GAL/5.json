              },
              "items": [
                {
                  "text": "2 Kor 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Mebo nde-Paulo, ndamwaambila kuti na mwaakupalulwa, elyo Kristo takooyoomugwasya abuniini. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.2",
            "verseOrgIds": [
              "GAL.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamulwiida lwabili kuti umwi aumwi uupalulwa ulijisi ceelelo cakumanizya Mulao woonse. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.3",
            "verseOrgIds": [
              "GAL.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mulayanda kululamikwa ku-Mulao, elyo Kristo tacijisi milimo yakumugwasya, mwaleya kuzwa kuluzyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.4",
            "verseOrgIds": [
              "GAL.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele swebo nkukulusyomo nkutulindilila muli-Muuya obo bululami mbutulangila. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.5",
            "verseOrgIds": [
              "GAL.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.15"
              },
              "items": [
                {
                  "text": "Gal 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.19"
              },
              "items": [
                {
                  "text": "1 Kor 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo muli-Kristo Jesu bupalule tabukwe milimo, alwalo lulomo talukwe milimo, pele lusyomo lubeleka kujanza lyaluyandano ndolujisi milimo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.6",
            "verseOrgIds": [
              "GAL.5.6"
            ]
          }
        }
      ]
    },
    {
