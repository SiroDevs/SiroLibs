              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikuti mwakaswiilila kale mbuzyakabede ziyanza zyangu zyakale nindakacili mubu-Juda, mbundakali kupenzesya loko imbungano ya-Leza akwiindinganya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Inc 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela mubu-Juda basama banji bamusyobo wangu ndakabainda loko kukusungwaalila tunsiyansiya twamawisi esu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
