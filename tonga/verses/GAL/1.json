        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo ndamuzibya, bakwesu, kuti ayo Makani Mabotu nginkambauka mebo teensi makani aazwa kubantu pe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo teendakaatambula kubantu, alimwi teendakaaiya, pele ndakaayubunwidwa a-Jesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
        },
        {
