          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamvwide buyo kuti oyo iwakali kutupenzesya ulakambauka ayo makani ngaonya ngaakali kwiindinganya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
