              "items": [
                {
                  "text": "Inc 9:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino nicakaba ciindi ndakaya kuzisi zyaku-Suriya acaku-Kilikiya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkentana kuzibwa kubusyu kumbungano zyabanakristo zyamu-Judaya, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
