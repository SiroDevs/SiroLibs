              ]
            }
          ]
        },
        {
          "text": "Pele nkwali iwakandisalila eyi milimo kuzwa mwida lyabama akundiita kuluzyalo lwakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
