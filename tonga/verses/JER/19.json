                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "alimwi baliyakide zipaililo zya-Baala kuzilundu, kuti batente bana babo mumulilo, babe zipaizyo zya-Baala, cintu ncindatakabalailila nikuba kucaamba nikuba kuciyeeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
