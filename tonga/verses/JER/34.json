              },
              "items": [
                {
                  "text": "32:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova Leza wa-Israyeli. Koya ukaambaule a-Zedekiya mwami wa-Juda, ukamwaambile kuti, Mbuboobu mbwaamba Jehova. Ncobeni ndaaba munzi uno mumaanza aamwami wa-Babuloni, nkabela uyooutenta mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.4"
              },
              "items": [
                {
                  "text": "Jer 32:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayebo tokooyooloboka kuzwa kumaanza aakwe. Ncobeni uyoojatwa akwaabwa mumaanza aakwe, elyo uyoobonana amwami waBabuloni meso kumeso, uyooambaula awe mulomo kumulomo, nkabela uyoosika ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo swiilila ijwi lya-Jehova, O Zedekiya mwami wa-Juda. Mbuboobu Jehova mbwaamba aanduwe, Tokooyoojazigwa ipanga pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
