            "sid": "JER 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ijwi lya-Jehova lyakasika kuli-Jeremiya kuzwa kuli-Jehova, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova Leza wa-Israyeli. Ndakatangana cizuminano abamausowanu mubuzuba obuya nindakabapozya kuzwa kunyika ya-Egepita muŋanda yabuzike, Ndakati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        },
