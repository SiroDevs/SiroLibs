        {
          "text": "Ngaaya makani aakasika kuli-Jeremiya kuzwa kuli-Jehova kuciindi eco Nebukadinezara mwami wa-Babuloni, abasilumamba bakwe boonse, azisi zyoonse zyanyika izyakali mubwami bwakwe, amisyobo yoonse yabantu, nibakali kulwisya Jerusalemu aminzi yawo yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
