                  "text": "Lev 25:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti baleke umwi aumwi muzike wakwe, naba mwaalumi naba mwanakazi, kufumbwa ba-Juda, kuti boonse baangunuke, kutabi mu-Juda naba omwe iwakanjizya mu-Judanyina mubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bakazumina, nkokuti basilutwe boonse abantu boonse ibakanjila mucizuminano eci cakuleka umwi aumwi muzike wakwe, naba mwaalumi naba mwanakazi, kuti baangunuke, kutabi limbi bazike akati kabo. Bakazumina, babaangununa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
