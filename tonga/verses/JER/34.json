                  "text": "Hos 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele kabe kaindi bakatamauka, bapilusya bazike boonse, nibaba baalumi nibaba banakazi, mbebakaangunwide, bababoozya alimwi mubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        },
        {
