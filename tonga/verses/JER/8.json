              "items": [
                {
                  "text": "Lk 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakayanda kubacela, mbwaamba Jehova, pele taakwe masaansa kumusamu, taakwe inkuyu kumukuyu, aalo matu aabo alapusaama, aceeco ncindakabapa caindilila.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.13",
            "verseOrgIds": [
              "JER.8.13"
            ]
          }
        }
      ]
