          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.14"
              },
              "items": [
                {
                  "text": "Jer 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.10"
              },
              "items": [
                {
                  "text": "Ezk 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balasilikasilika mibunda yamwana musimbi wabantu bangu amajwi aabo aakuti. Muli aluumuno! Muli aluumuno! anukuti taakwe luumuno pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
