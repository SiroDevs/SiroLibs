                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako njoopa bambi banakazi babo, amyuunda yabo iyoovubwa beenzinyina, nkaambo boonse buyo, nibaba baniini nibaba bapati, balayandisya kunyanzya-nyanzya, abasinsimi abapaizi boonse balacita cakubeja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 8:11"
          },
          "items": [
