            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.17",
            "verseOrgIds": [
              "JER.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buusu bwangu tabusilikiki, Moyo wangu ulacisa mucamba cangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.18",
            "verseOrgIds": [
              "JER.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swiilila! Lyamvwigwa ijwi lyakulila kwamwana musimbi wabantu bangu, balalila moonse moonse munyika. Sa Jehova tali mu-Zioni? Sa mwami wakwe tali mukati kakwe? Ino nkaambonzi bandikalazya azikozyano zyabo zifulidwe azintu zyeenzu zyabuyo? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.19",
            "verseOrgIds": [
              "JER.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutebula kwamana, micelo yamainza yacelwa kale, pele iswe tatuna kufutulwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.20",
            "verseOrgIds": [
              "JER.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.2.10"
              },
              "items": [
                {
                  "text": "Nah 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mubunda wamwana musimbi wabantu bangu ngonguwo ngundauminwa mibunda ambebo. Ndaya bulila, akuyoowa kwandijata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.21",
            "verseOrgIds": [
              "JER.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.25"
              },
              "items": [
                {
                  "text": "Matl 37:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa taakwe mabbona ku-Gileadi? Sa taakwe musiliki nkuko? Ino nkaambonzi zilonda zyamwana musimbi wabantu bangu tazina kuponesegwa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.22",
            "verseOrgIds": [
              "JER.8.22"
            ]
          }
        }
