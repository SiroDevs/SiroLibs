                  "text": "Int 83:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayooziyanika mumumuni wazuba awamwezi awamakamu oonse aakujulu, nzenzizyo nzibakali kuyandisya akukomba, nzenzizyo nzibakali kuya butobela akuziyandaula akuzipailila. Tazikooyoobungikwa nikuba kuzikwa, pele ziyooba imbolezi buyo atala lyavu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
