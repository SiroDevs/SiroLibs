        },
        {
          "text": "Kuciindi eco, mbwaamba Jehova, bayoogwisya zifuwa zyabami ba-Juda, azifuwa zyabasilutwe babo, azifuwa zyabapaizi, azifuwa zyabasinsimi, azifuwa zyabantu ba-Jerusalemu; bayoozigwisya zyoonse mutubanda twazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
