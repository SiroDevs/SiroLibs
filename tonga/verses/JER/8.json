              },
              "items": [
                {
                  "text": "Jer 14:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twakali kulangila luumuno, pele katakwe coolwe ncitwakajana pe. Twakali kulangila ciindi cakuponesegwa, pele kwasika makani aayoosya buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.15",
            "verseOrgIds": [
              "JER.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbululuzya kwambizi zyakwe kwamvwigwa aku-Dani, Nyika yoonse ilakankama nkaambo kajwi lyakulila kwamabbiza aakwe. Balaza kuzoolidilila nyika azyoonse zili mumonya, munzi abantu bakede mulinguwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.16",
            "verseOrgIds": [
              "JER.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ncobeni ndatuma akati kanu inzoka, bacipele batakonzyi kuzyondolwa, nkabela bayoomuluma, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.17",
            "verseOrgIds": [
              "JER.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
