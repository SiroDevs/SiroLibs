              "items": [
                {
                  "text": "Is 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.3"
              },
              "items": [
                {
                  "text": "Jer 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa bakausa insoni nibakacita zisesemyo? Ne! Teebakafwa insoni. Kufwa bweeme tabakuzi pe. Nkaambo kako bayooba akati kabaabo bawide mulufu. Kuciindi cakukomwa kwabo bayoonyonyooka, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.12",
            "verseOrgIds": [
              "JER.8.12"
            ]
          }
        },
        {
