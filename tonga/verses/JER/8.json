              },
              "items": [
                {
                  "text": "Hos 8:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma! Mulaamba buti, Tuli basongo, amulao wa-Jehova tuli awo? Cilembyo cakubeja cabalembi capilinganya makani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basongo bafwa insoni, bayoowa, bacegwa. Ncobeni ijwi lya-Jehova balilikakide, lino mbusongonzi mbubajisi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        },
