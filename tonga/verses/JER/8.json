                "loc": "REV.9.6"
              },
              "items": [
                {
                  "text": "Ciy 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela lufu luyoosalwa kwiinda buumi kubantu boonse bacisyeede baluzubo olu lwabubi kumasena oonse nkundabatanda, mbwaamba Jehova wamakamu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
