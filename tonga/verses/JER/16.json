            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.14"
              },
              "items": [
                {
                  "text": "Matl 19:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utakwati mwanakazi, nikuba kuzyala bana balombe abasimbi, mubusena obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaa­ mbo mbuboobu Jehova mbwaamba aabana balombe abasimbi bazyalwa mubusena obuno abamanyina babazyala abamawisi babazyazya omuno munyika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoofwa amalwazi mabi. Tabakooyoolilwa nikuba kuzikwa, pele bayooba imbolezi buyo atala lyavu. Ipanga anzala nzeziyoobamanisya, nkabela mitunta yabo iyooba zilyo zyabayuni bakujulu azyabanyama baansi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
