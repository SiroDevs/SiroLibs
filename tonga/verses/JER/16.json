              "attrs": {
                "loc": "PRO.3.6"
              },
              "items": [
                {
                  "text": "Tus 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takukooyooba muntu uukomweda sikulila zinkwa zyakumuumuzya nkaambo kayooyo ngwafwidwa, ayooyo uufwidwa wisi na banyina takukooyooba muntu uumunywisya inkomeki yakumuumuzya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utanjili muŋanda ya po bwe, utakali abo kukulya akunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
