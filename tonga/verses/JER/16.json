        },
        {
          "text": "Bantu boonse bamunyika eyi bayoofwa, nibaba bapati nibaba baniini. Tabakooyoozikwa pe; takukooyooba muntu naba omwe uubalila nanka kulitenda nanka kuligela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
