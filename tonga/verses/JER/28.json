                  "text": "Jer 27:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova wamakamu Leza wa-Israyeli. Ndatyola ijoko lyamwami waBabuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
