        },
        {
          "text": "Myaka yobile niitana kuzula, njooboozezya okuno zibelesyo zyoonse zyaŋanda ya-Jehova, Nebukadinezara mwami wa-Babuloni nzyaakagwisya kubusena obuno akuzitola ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakwe Jekoniya mwana wa-Jehoyakimu mwami wa-Juda aboonse ba-Juda ibakatolwa mubuzike ku-Babuloni, njoobapilusya okuno, mbwaamba Jehova, nkaambo njootyola ijoko lyamwami wa-Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
