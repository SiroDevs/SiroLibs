            "number": "20",
            "style": "v",
            "sid": "JER 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolungulwida luzubo lwa-Jakobo aya makani, akwaakambauka mucisi ca-Juda. Amba kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.20",
            "verseOrgIds": [
              "JER.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
