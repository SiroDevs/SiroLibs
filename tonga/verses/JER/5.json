                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.26"
              },
              "items": [
                {
                  "text": "Inc 28:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuswiilile nubantu bafubafuba babula bongo, inywe nomujisi meso aataboni amatwi aataswiilili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.21",
            "verseOrgIds": [
              "JER.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
