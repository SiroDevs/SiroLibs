                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tabana kwaamba mumyoyo yabo kuti, Atuyoowe Jehova Leza wesu uutuwisizya imvula, imvula yakutanga amvula yamiyoba yoonse kuciindi cayo, akutubambila insondo zyeelede zyakutebula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.24",
            "verseOrgIds": [
              "JER.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Milandu yanu njeyakasya zintu ezi, azibi zyanu zyamusinkinizizya zintu zibotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.25",
            "verseOrgIds": [
              "JER.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kwajanwa basizibi akati kabantu bangu. Balalindila mbuli bavwimi mbubalindila, balateya inkole, balaca bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.26",
            "verseOrgIds": [
              "JER.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuli cizangala mbucizwide bayuni, maanda aabo alizwide lweeno mbubonya, Nciceeco ncibabeda bapati abavubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.27",
            "verseOrgIds": [
              "JER.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 5:28"
          },
          "items": [
