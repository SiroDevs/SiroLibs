              },
              "items": [
                {
                  "text": "Int 73:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balineneede akubungusana, Balainda kucita milimo mibi. Kubeteka tababeteki kabotu makani aabamucaala kuti bajane coolwe, aalo makani aabatengwana tabaakosoli kabotu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.28",
            "verseOrgIds": [
              "JER.5.28"
            ]
          }
