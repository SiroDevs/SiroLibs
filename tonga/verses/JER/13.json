        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.19"
              },
              "items": [
                {
                  "text": "Lev 26:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Mbubonya obo mbunjoobisizya kulisumpula kwabantu ba-Juda akulisumpula kupati kwa-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
