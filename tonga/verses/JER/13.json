              "attrs": {
                "loc": "REV.14.10"
              },
              "items": [
                {
                  "text": "Ciy 14:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela uyoobaambila kuti, Mbuboobu mbwaamba Jehova. Amubone! Bantu boonse banyika ino, bami bakede acuuno cabwami ca-Davida, abapaizi, abasinsimi, aboonse bakede mu-Jerusalemu, boonse buyo njoobazuzya bukolwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela njoobaumputanya, umwi aumwi amweenzinyina, bamawisi abana babo boonse antoomwe, mbwaamba Jehova, Nsikooyoobafwida buuya niluba luzyalo niluba luse. Njoobanyonyoona buyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        }
      ]
