            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile akucenjeka matwi. Mutalisumpuli pe, nkaambo Jehova waamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
