          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uleelede kubaambila majwi aya. Mbuboobu mbwaamba Jehova Leza wa-Israyeli. Inongo zyoonse zilazuzigwa waini. Lino bayoovuwa kuti, We! Sa tatuzi kuti nongo zyoonse zilazuzigwa waini? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
