          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa mu-Etiopiya uusia ulakonzya kusandula cikanda cakwe? Sa siluwe ulakonzya kusandula mabala aakwe? Na kwaba obo, lino anywebo mulakonzya kucita kabotu nomuzibide kucita bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
