                  "text": "Nah 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa ulabuzya kuti, Nkaambonzi aya makani andisikila? Nkekaambo kazibi zyako zinji, malogwe aako ncaayubunwidwa, amaulu aako ncaasofwaazisigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        },
        {
