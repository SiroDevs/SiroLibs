            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.14"
              },
              "items": [
                {
                  "text": "Jer 9:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.11.8"
              },
              "items": [
                {
                  "text": "11:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aba bantu babi, bakaka kuswiilila majwi aangu, beenda aruzinguni zyamyoyo yabo, baya butobela baleza bambi kuti babamanine milimo akubakomba, bayooba mbubonya mbuli mulembo oyu uutacikwe milimo abuniini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.7"
              },
              "items": [
                {
                  "text": "Matl 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Kul 19:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.9"
              },
              "items": [
                {
                  "text": "Jer 33:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbubonya mbuli mulembo mbuujata kucikungu camuntu, ambebo ndakajatya luzubo lwaIsrayeli aluzubo lwa-Juda loonse kulindime, mbwaamba Jehova, kuti bandibede bantu bali ampuwo, batembaulika, bali abulemu. Nekubaboobo teebakaswiilila pe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
