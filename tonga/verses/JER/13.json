              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ijwi lya-Jehova lyakandisikila, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
