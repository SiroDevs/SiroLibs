              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino uyooambanzi noyoojana kuti abo mbowakaiisya omwini kuba bayandwi bako wababika kuti babe basilutwe baka? ",
          "type": "text",
          "attrs": {
