                }
              ]
            }
          ]
        },
        {
          "text": "Lino minzi ya-Juda abantu boonse bamu-Jerusalemu banooya bukwiilila baleza mbobatentela tununkilizyo, pele balo tabakooyoobavuna kuciindi camapenzi aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
