                  "text": "Rom 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Kambauka aya majwi oonse muminzi ya-Juda amumigwagwa ya-Jerusalemu. Amba kuti, Amuswiilile majwi aacizuminano eci, alimwi amwaacite. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kucenjezya ndakacenjezya bamausowanu mubuzuba obo nindakabagwisya munyika ya-Egepita, Ndakali kubacenjezya loko mazuba oonse akusikila kubuzuba obuno, ndati, Amuswiilile ijwi lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo tabakwe nibakaswiilila pe, nikuba kucenjeka matwi aabo, pele bakacili kuya bweenda umwi aumwi mucinguni camoyo wakwe mubi. Nciceeco ncindakabaletela majwi oonse aacizuminano eci, ngaonya ngendakabalailila kuti baacite pele tabakwe nibakaacita pe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
