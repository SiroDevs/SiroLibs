                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kobaambila kuti, Mbuboobu mbwa amba Jehova Leza wa-Israyeli, Uli alutuko muntu umwi aumwi uutaswiilili majwi aacizuminano eci, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
