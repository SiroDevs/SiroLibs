            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile majwi aacizuminano eci. Ambila bantu ba-Juda abaabo bakede mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
