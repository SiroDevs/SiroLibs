        {
          "text": "Mutalili oyo uufwide, mutamoomoki pe. Amulile oyo uutoledwe, nkaambo takooyooboola limbi kubona nyika njaakazyalilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
