              },
              "items": [
                {
                  "text": "Jer 23:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muuwo nguuyooembela beembeli bako, abazolwani bako bayootolwa mubuzike. Lino uyoofwisigwa insoni akuusa bweeme nkaambo kabubi bwako boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
