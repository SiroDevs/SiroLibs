              },
              "items": [
                {
                  "text": "2 Bam 24:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoo-kuwaala, webo abanyoko ibakakuzyala, kunyika imbi njimwatakazyalilwa, nkabela muyoofwa nkukonya oko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele nyika myoyo yabo njiisukeme, tabakooyooboola limbi kulinjiyo pe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
