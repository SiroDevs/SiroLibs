          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.25"
              },
              "items": [
                {
                  "text": "Jer 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakakwaambila kuciindi cacoolwe cako, pele wakaamba kuti, Nsikooteelela pe. Mbubonya obo mbowakali kucita lyoonse kuzwa kubwanikenike bwako. Tokwe nowakaswiilila ijwi lyangu abuniini pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 22:22"
          },
          "items": [
