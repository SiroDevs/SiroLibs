        },
        {
          "text": "Pele na mwakaka kuswiilila majwi aya, lino ndakonka muzina lyangu ndemwini, mbwaamba Jehova, kuti iŋanda eyi iyooba matongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
