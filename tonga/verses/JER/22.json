              "items": [
                {
                  "text": "Jer 21:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njookubambila basikunyonyoona, umwi aumwi azilwisyo zyakwe, nkabela bayoogonka misamu yakedari yako mibotu akwiiwaala mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
