        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.17"
              },
              "items": [
                {
                  "text": "2 Bam 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.25"
              },
              "items": [
                {
                  "text": "2 Mak 34:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo kuyoovuwigwa kuti, Nkaambo kakuti bakamwaya cizuminano ca-Jehova Leza wabo, bakakotamina baleza bambi akubamanina milimo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
