                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu Jehova mbwaamba aa-Salumu mwana wa-Josiya mwami waJuda, oyo iwakalya izina lyawisi Josiya pele sunu watolwa kuzwa ano. Takooyooboola limbi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkukonya oko nkubamutola mubuzike nkwayoofwida. Nyika ino takooyooibona limbi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
