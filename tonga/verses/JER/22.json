              "items": [
                {
                  "text": "1 Bam 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bamasi banji bayooinda kumunzi uno, nkabela bayoobuzya umwi aumwi kumweenzinyina kuti, Nkaambonzi Jehova waucitila obo, munzi oyu mupati? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.8",
            "verseOrgIds": [
              "JER.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
