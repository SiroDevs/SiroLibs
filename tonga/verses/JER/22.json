              },
              "items": [
                {
                  "text": "Mt 23:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Amubeteke cakululama, amuvune uubbididwe mumaanza aasikubba; mutapenzyi nikuba kubisizya mweenzu amucaala amukamufu, alimwi mutatili bulowa bwabaabo batakwe milandu mubusena obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.3",
            "verseOrgIds": [
              "JER.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.25"
              },
              "items": [
                {
                  "text": "Jer 17:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo na mwacita obo ncobeni, lino mumilyango yaŋanda eyi muyoonjila bami bakala acuuno cabwami bwa-Davida, balitantide ankalaki ambizi, balo abalanda babo abami babo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
        {
