              "items": [
                {
                  "text": "Jer 6:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Webo ookede ku-Lebano, ooyakide citeente cako akati kamisamu yakedari, uyootongela loko nozoomvwa kucisa, macise mbuli macise aamwanakazi uutumbuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
