        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Seluka kuya kuŋanda yamwami waJuda, ukaambe nkuko majwi aya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
              "JER.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amba kuti, Swiilila ijwi lya­ Jehova, O mwami wa-Juda nokede acuuno ca-Davida, webo abalanda bako abantu bako boonse banjila mumilyango eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
