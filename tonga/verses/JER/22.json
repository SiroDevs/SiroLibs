              "attrs": {
                "loc": "MIC.3.12"
              },
              "items": [
                {
                  "text": "Mik 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu Jehova mbwaamba aaŋanda yamwami wa-Juda. Mumeso aangu uli mbubonya mbuli Gileadi na mutwe wa-Lebano, nekubaboobo ncobeni njookulobya, ube inkanda buyo, munzi uutakalwi bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
