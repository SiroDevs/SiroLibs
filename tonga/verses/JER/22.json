                  "text": "2 Mak 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoozikwa mbubonya mbuli imbongolo mbiizikwa. Uyookwelwa akusoowegwa anze lyamilyango ya-Jerusalemu.",
          "type": "text",
