              "items": [
                {
                  "text": "Jer 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akukwaaba mumaanza aabaabo­ bayandaula buumi bwako, mumaanza aabaabo mboyoowa, mumaanza aa-Nebukadinezara mwami wa-Babuloni amumaanza aaba-Kasidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
