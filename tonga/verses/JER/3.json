                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa tona kundiita lino lino cakwaamba kuti, Taata, nduwe muzolwani wakubwanike bwangu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa ulajatisya lyoonse bukali bwakwe? Sa ulakalala akutamani? Ncobeni waamba obo, nekubaboobo wacita bubi boonse mbokonzya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
