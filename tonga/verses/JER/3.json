                  "text": "Joh 4:21-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mumazuba ayo aaza, mwamana buyo kuzyalisya akuvula, mbwaamba Jehova, tabakooyooamba limbi ibbokesi lyacizuminano ca-Jehova. Talikooyooyeeyegwa limbi, tabakooyooliibaluka nikuba kulisukama, alimwi talikooyoocitwa limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.16",
            "verseOrgIds": [
              "JER.3.16"
            ]
          }
        },
