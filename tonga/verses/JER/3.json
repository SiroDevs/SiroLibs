              },
              "items": [
                {
                  "text": "Is 44:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.1"
              },
              "items": [
                {
                  "text": "Jer 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Koya ukakambauke majwi aya kunyika. Koamba kuti, Boola, O Israyeli uutasyomeki, mbwaamba Jehova, lino nsikooyookulanga cabukali, nkaambo ndisiluzyalo, mbwaamba Jehova; nsikooyookukalalila lyoonse pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
