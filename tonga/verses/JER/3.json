          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuciindi eco Jerusalemu uyooambwa kuti ncecuuno cabwami ca-Jehova, Bantu bamisyobo yoonse bayooyobololwa nkukonya ku-Jerusalemu kukulemeka izina lya-Jehova, nkabela tabakooyooenda limbi muzinguni zyamyoyo yabo mibi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.17",
            "verseOrgIds": [
