                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kolyaamba buyo mulandu wako wakuti wakapapila Jehova Leza wako, waabila beenzu luyando lwako mucenzule camisamu yoonse mitete, alimwi tamuna kuswiilila ijwi lyangu, mbwaamba Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.5"
              },
              "items": [
                {
                  "text": "Rom 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuboole nubana batasyomeki, mbwaamba Jehova, nkaambo ndime simalelo wanu. Njoomubweza, njoosalaula omwe omwe mumunzi umwi aumwi, bobile bobile muluzubo lumwi alumwi, nkamulete ku-Zioni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.4"
              },
              "items": [
                {
                  "text": "Jer 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.11"
              },
              "items": [
                {
                  "text": "Ef 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.28"
              },
              "items": [
                {
                  "text": "Inc 26:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino njoomupa beembeli mbubonya mbuuyanda moyo wangu, nkabela bayoomusanina luzibo abusongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.15",
