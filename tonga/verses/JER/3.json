                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nciceeco lusuunsu ncilwakakakilwa, amvula yamainza tiina kuloka. Ulijisi inkumu yasibwaamu, wakaka kuusa bweeme. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        },
