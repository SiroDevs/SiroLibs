              "items": [
                {
                  "text": "Jer 39:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amumwaka wakumi amusanu aitatu wabwami bwa-Nebukadinezara, wakatola mubuzike kuzwa ku-Jerusalemu bantu bali myanda iili musanu aitatu amakumi otatwe ababili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
