        },
        {
          "text": "Zedekiya kajisi myaka iili makumi obile aumwi naakaba mwami, nkabela wakeendelezya mu-Jerusalemu myaka iili ikumi aumwi. Izina lyabanyina basali Hamutala mwana musimbi wa-Jeremiya wakuLibina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakacita bubi mumeso aa-Jehova mbubonya mbwaakacita Jehoyakimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12+EZK.17.13+EZK.17.14+EZK.17.15+EZK.17.16"
              },
              "items": [
                {
                  "text": "Ezk 17:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bukali bwa-Jehova bwakali kuya bukomena mu-Jerusalemu amucisi ca-Juda mane lumwi wakabatanda kuzwa kubusyu bwakwe. Elyo Zedekiya wakapapila mwami wa-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
