                "loc": "GEN.40.13+GEN.40.14+GEN.40.15+GEN.40.16+GEN.40.17+GEN.40.18+GEN.40.19+GEN.40.20"
              },
              "items": [
                {
                  "text": "Matl 40:13-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mumwaka wamakumi otatwe amusanu aibili wabuzike bwa-Joyakini mwami wa-Juda, mumwezi wakumi aibili, mubuzuba bwamakumi obile amusanu bwamumwezi, Evili-Merodaki mwami wa-Babuloni, mumwaka oyo nguwenya naakalya bwami, wakaangununa Joyakini mwami wa-Juda muntolongo mwaakabede. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
