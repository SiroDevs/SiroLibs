                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aminsende, bulamfu bwaumwi aumwi bwakali tukokola tuli ikumi amusanu arutatu, amubalo wawo wakali tukokola tuli ikumi atubili, antuli yawo yakali indiya yaminwe yone, nkaambo wakalifokwedwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atala lyawo kakuli ciimikilo camukuba. Bulamfu bwaciimikilo cimwi acimwi cakali tukokola tosanwe, alimwi ciimikilo cakalizyungulukidwe tusabwe tupesedwe amapomegranite; zyoonse zyakalifulidwe mukuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
