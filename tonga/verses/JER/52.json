          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "alimwi mumunzi wakabweza umwi, silutwe iwakali kulanga basilumamba, abasinkuta bamwami bali musanu ababili ibakajanwa mumunzi, amulembi wasilutwe wampi iwakali kubunganya bantu bacisi, abantu banyika bali makumi aali musanu alimwi ibakajanwa mukati kamunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba boonse Nebuzaradana mupati wabasikutabilila wakababweza akubasisya kumwami wa-Babuloni ku-Ribila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
