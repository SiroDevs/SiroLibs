              },
              "items": [
                {
                  "text": "Kul 27:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azyalo zilongo, amaliko, atugele, amigano, azinkomba, azibelesyo zyoonse zyamukuba nzibakali kupaizya, zyoonse buyo bakazitola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayalo mitiba, ankayi zyamulilo, amigano, azilongo, azibikilo zyamalampi, azinkomba zyatununkilizyo amitiba yazipaizyo zyakunywa, zibulo zyoonse zyangolida mupati wabasikutabilila wakatola ingolida yazyo, azibulo zyoonse zyansiliva wakatola insiliva yazyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela minsende yobile, acikozyano comwe caziba lyamaanzi, abasune bali ikumi ababili bamukuba ibakaimvwi kunsi lyaziba, azikazikilo, mwami Solomoni nzyaakacitila iŋanda ya-Jehova, bulemu bwamukuba wa zintu ezi zyoonse teebwakali kweelekeka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
