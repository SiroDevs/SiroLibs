                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakatenta iŋanda yaJehova aŋanda yamwami amaanda oonse aamu-Jerusalemu. Maanda oonse mapati wakaatenta amulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aalo malambo oonse aa-Jerusalemu aazyungulukide munzi, bakaamwaya basilumamba baba-Kasidi, mupati wabasikutabilila mbaakeza abo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bamwi batengwana, abantu bamwi ibakasyeede mumunzi, abaabo ibakalyaabide kale mumaanza aamwami waBabuloni, abana baleya, boonse Nebuzaradana mupati wabasikutabilila wakabatola mubuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Nebuzaradana mupati wabasikutabilila wakaleka bamwi bacete bacisi kuti babe basimyuunda yamasaansa abasikulima,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
