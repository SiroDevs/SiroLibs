                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino minsende yamukuba iyakali muŋanda ya-Jehova, azikazikilo, acikozyano caziba lyamaanzi camukuba icakali muŋanda ya-Jehova, zyoonse ba-Kasidi bakazipwayaula akutola mukuba wazyo woonse ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
