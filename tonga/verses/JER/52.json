              "type": "tag",
              "attrs": {
                "loc": "EZK.4.16"
              },
              "items": [
                {
                  "text": "Ezk 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mubuzuba bwamusanu aane bwamwezi wane, inzala yakakomena loko mumunzi, abantu bacisi teebakajisi zilyo abuniini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Ezk 33:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo munzi wakaanduka, nkabela basilumamba boonse bakacija masiku, bazwa mununzi akwiinda kumulyango uuli akati kamalambo obile, kufwaafwi kumuunda wamwami, ba-Kasidi nibakacili kuzyunguluka munzi. Lino bakatola inzila iiya ku-Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele basilumamba baba-Kasidi bakatobela mwami, bamweenzya Zedekiya mugezi lya-Jeriko, nkabela basilumamba bakwe boonse bakamwaika, bamusia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.4"
              },
              "items": [
                {
                  "text": "Jer 32:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakajata mwami, bamuleta kumwami wa-Babuloni ku-Ribila munyika ya-Hamati, bamubeteka nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.6"
              },
              "items": [
                {
                  "text": "Jer 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bana ba-Zedekiya, mwami wa-Babuloni wakabajaya kumeso aakwe, abalo basilutwe boonse ba-Juda, wakabajaya ku-Ribila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Ezk 12:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakaofwaazya meso aa-Zedekiya, wamwaanzya inkeetani, nkabela mwami wa-Babuloni wakamusisya ku-Babuloni, wamubika muntolongo mane kusikila kubuzuba bwalufu lwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
