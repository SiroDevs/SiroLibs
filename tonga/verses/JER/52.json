        },
        {
          "text": "Nkabela munwaka wamusanu aine wabwami bwakwe, munwezi wakumi, mubuzuba bwakumi bwamwezi, kwakasika Nebukadinezara mwami wa-Babuloni, walo abasilumamba bakwe boonse, ku-Jerusalemu kuzoolwisya, nkabela bakausinkinizya akuyaka lubaya lwakuuzyungulusya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo munzi wakalisinkinizidwe mane kusikila kumwaka wakumi aumwi wabwami bwa-Zedekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.14"
              },
              "items": [
                {
                  "text": "Lev 26:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.26"
              },
              "items": [
                {
