                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Wabona kabotu, nkaambo mebo ndalangilila majwi aangu kuti nkaazuzikizve.",
          "type": "text",
          "attrs": {
