                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Jeremiya musinsimi wakabaambila kuti, Ndamvwa. Ncobeni ndakomba kuli-Jehova Leza wanu, mbubonya mbumwaamba, lino kufumbwa cintu Jehova ncasi muvuwe ndamulwiida ncico, nsikoosisa cintu niciba comwe pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo bakaambila Jeremiya kuti, Jehova abe kamboni musyomesi mulusinizyo, atupe mulandu na twakaka kucita zintu zyoonse Jehova Leza wako nzyasi twaambile. Ncobeni tunoocita mbubonya mbwaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
