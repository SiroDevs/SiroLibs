                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njoomufwida luzyalo, kuti amufwide luzyalo akumupilusya kunyika yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
