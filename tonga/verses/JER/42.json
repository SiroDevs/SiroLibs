                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngaayo makani Jehova ngaamwaambila nuba-Juda basyeede. Mutainki ku-Egepita pe. Ncobeni muzibe kuti ndamucenjezya buzuba obuno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
