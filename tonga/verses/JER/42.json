          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwaamba kuti, Pe, tulaya kunyika ya-Egepita, nkututakonzya kubona inkondo nikuba kumvwa kulila kwamweembo nikuba kubula cakulya, tukakale nkuko, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
