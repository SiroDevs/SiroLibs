          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalyeena nubeni, nkaambo mwakandituma kuli-Jehova Leza wanu, mwati, Utukombele kuli-Jehova Leza wako, nkabela kufumbwa cintu ncaamba Jehova Leza wesu, utulwiide ncico, lino tuyoocita mbubonya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
