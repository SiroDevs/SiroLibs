          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amane buyo mazuba aali ikumi, ijwi lya-Jehova lyakasika kuli-Jeremiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
