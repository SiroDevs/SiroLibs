            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakaita Johanani mwana wa-Kareya, abasilutwe boonse babasilumamba mbaakali abo, abantu boonse nibaba baniini nibaba bapati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
