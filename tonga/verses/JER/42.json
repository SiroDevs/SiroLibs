          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabaambila kuti, Mbuboobu mbwaamba Jehova Leza wa-Israyeli, ngumwakandituma kulinguwe kumutolela cikumbilo canu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
