              "items": [
                {
                  "text": "Int 32:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ncobeni njookufutula, aboobo tokooyoojazigwa ipanga, pele buumi bwako buyooba bulumbu bwako nkaambo kakuti ulasyoma ndime, mbwaamba Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.18",
            "verseOrgIds": [
