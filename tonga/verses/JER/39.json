                  "text": "Jer 52:4-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jerusalemu nuwakazundwa, (mumwaka wamusanu aine wabwami bwa-Zedekiya mwami wa-Juda, mumwezi wakumi, Nebuka­ dinezara mwami wa-Babuloni wakeza ku-Jerusalemu abasilumamba bakwe boonse, wausinkinizya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.1",
            "verseOrgIds": [
              "JER.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mumwaka wakumi aumwi wabwami bwa-Zedekiya, mumwezi wane, mubuzuba bwamusanu aane bwamumwezi, munzi wakapwayaulwa), ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.2",
            "verseOrgIds": [
              "JER.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "basilutwe boonse bamwami wa-Babuloni bakasika, bakali mumulyango waakati, Kwakasika Nerigalisarezara, Samgari Nebo, Sarisekimu mupati wabazibe, Nerigalisarezara mupati wabasilutwe, abapati bamwi boonse bamwami wa-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.3",
            "verseOrgIds": [
              "JER.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Zedekiya mwami wa-Juda abasilumamba bakwe boonse nibakababona, bakacija, bazwa mumunzi masiku, batola inzila iinda kumuunda wamwami akati kamalambo obile, batola inzila yakuya ku-Araba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.4",
            "verseOrgIds": [
              "JER.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
