              },
              "items": [
                {
                  "text": "26:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bagwisya Jeremiya kuzwa kulubuwa lwabalindizi, bamwaaba mumaanza aa-Gedaliya mwana wa-Ahikamu mwana wa-Safani, kuti amutole kulinguwe, aboobo wakakala akati kabantu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        }
      ]
