              },
              "items": [
                {
                  "text": "Jer 52:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele impi yaba-Kasidi yakabatobela, nkabela bakeenzya Zedekiya mumabanda aa-Jeriko, bamujata, bamuleta kuli-Nebukadinezara mwami wa-Babuloni ku-Ribila mucisi ca-Hamati, elyo wakabeteka makani aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.5",
            "verseOrgIds": [
              "JER.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami wa-Babuloni wakajaya bana ba-Zedekiya kumeso aakwe oko ku-Ribila mucisi ca-Hamati, abalo basilutwe ba-Juda mwami wa-Babuloni wakabajaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.6",
            "verseOrgIds": [
              "JER.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela wakaofwaazya meso aa-Zedekiya, wamwaanzya inkeetani, wamutola ku-Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.7",
            "verseOrgIds": [
              "JER.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino iŋanda yamwami amaanda aabantu, ba-Kasidi bakaatenta oonse amulilo, abwalo bulambo bwa-Jerusalemu bakabumwaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.8",
            "verseOrgIds": [
              "JER.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu boonse ibakasyeede mumunzi, nibaba abo ibakalyaabide mumaanza aakwe nibaba abo ibakasyaala, Nebuzaradana silutwe wampi wakabatola mubuzike kuBabuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.9",
            "verseOrgIds": [
              "JER.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bamwi bantu batengwana ibatakajisi cintu, Nebuzaradana wakabasia mucisi ca-Juda, wabapa myuunda yamasaansa amyuunda imwi mubuzuba obo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
