        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.10",
            "verseOrgIds": [
              "JER.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Nebukadinezara mwami wa-Babuloni wakalailila aa-Jeremiya kujanza lya-Nebuzaradana silutwe wampi, wati, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umubweze, umulange kabotu. Utamubisizyi pe, pele kufumbwa ncakwaambila, uleelede kumucitila mbubonya mbwaamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Nebuzaradana silutwe wampi aNebusazibani mupati wabazibe a-Nerigalisarezara mupati wabasilutwe abapati boonse bamwami wa-Babuloni bakatuma, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
