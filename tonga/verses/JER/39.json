            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ijwi lya-Jehova lyakasika kuli-Jeremiya kuciindi eco naakacijalidwe mulubuwa lwabalindizi, liti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
              "JER.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.42"
              },
              "items": [
                {
                  "text": "Mt 10:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.12"
              },
              "items": [
                {
                  "text": "Dan 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Koya ukaambile Ebedi-meleki muKusi kuti, Mbuboobu mbwaamba Jehova wamakamu Leza wa-Israyeli. Ncobeni njoozuzikizya majwi aangu aamunzi uno. Ngemajwi aamapenzi, taali majwi aacoolwe pe. Mubuzuba obo makani ayooboneka kumeso aako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele webo, njookuvuna mubuzuba obo, mbwaamba Jehova. Tokooyooabwa mumaanza aabantu abomboyoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.17",
            "verseOrgIds": [
              "JER.39.17"
            ]
          }
        },
