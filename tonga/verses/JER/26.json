              "items": [
                {
                  "text": "1 Bam 19:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwami Jehoyakimu abasinkuta bakwe abasilutwe bakwe boonse, nibakaswiilila majwi aakwe, mwami wakayanda kumujaya, lino Uriya naakamvwa wakayoowa, wakacijila ku-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
