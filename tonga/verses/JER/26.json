            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.20"
              },
              "items": [
                {
                  "text": "Mt 27:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jeremiya naakamana kwaamba makani oonse Jehova ngaakamulailila kwaambila bantu boonse, ndilyonya bapaizi abasinsimi abantu boonse bakamujata, bati, Ncobeni ulafwa! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambonzi wasinsima muzina lya-Jehova aya majwi aakuti iŋanda eyi iyooba mbuli Silo, amunzi Oyu uyooba itongo buyo litakwe bantu? Nkabela bantu boonse bakayoboloka Jeremiya nkwaakabede muŋanda ya-Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
