              "items": [
                {
                  "text": "Inc 5:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bamwi bapati banyika bakanyampuka, bakaambila bantu boonse babungene kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
