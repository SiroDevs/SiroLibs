        {
          "text": "Lino bapaizi abasinsimi abantu boonse bakamvwa Jeremiya ulaamba majwi aya muŋanda ya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
