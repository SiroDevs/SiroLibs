                  "text": "Tus 29:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo mwami Jehoyakimu wakatuma bantu ku-Egepita, Elinatani mwana wa-Akiboro abantu bamwi ibakamusindikila ku-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
