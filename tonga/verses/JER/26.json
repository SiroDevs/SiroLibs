              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpoonya awo basilutwe abantu boonse bakaambila bapaizi abasinsimi kuti, Muntu oyu teelede kufwa pe, nkaambo watwaambila muzina lyaJehova Leza wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
