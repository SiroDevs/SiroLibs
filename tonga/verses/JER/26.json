            }
          ]
        },
        {
          "text": "Mpoonya awo Jeremiya wakaambila basilutwe boonse abantu boonse kuti, Jehova nguwakandituma kukusinsima aaŋanda eyi amunzi uno majwi oonse ngemumvwide. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
