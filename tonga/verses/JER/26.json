              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.1"
              },
              "items": [
                {
                  "text": "Mik 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.12"
              },
              "items": [
                {
                  "text": "3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mika waku-Morese wakali kusinsima mumazuba aa-Hezekiya mwami wa-Juda, nkabela wakaambila bantu boonse ba-Juda kuti, Mbuboobu mbwaamba Jehova wamakamu: Ziyoni uyoolimwa mbuli muunda, a-Jerusalemu uyooba malwi malwi, acilundu cantempele ciyooba mbuli kalundulundu kamusokwe buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        },
        {
