              },
              "items": [
                {
                  "text": "Jer 38:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mebo ndi mumaanza aanu. Amundicitile kufumbwa cintu cibota akululama mumeso aanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo amuzibe calusinizyo kuti, na mwandijaya, muyooliletela, inywe nubeni amunzi uno abantu bakede mulinguwo, mulandu wakutila bulowa bwamuntu uutakwe kaambo, nkaambo ncobeni Jehova nguwakandituma kulindinywe kuti nkakambauke majwi aya oonse mumatwi aanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
