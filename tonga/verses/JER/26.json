                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambweni bayooswiilila, ambweni bayooleka umwi aumwi bubi bwanzila yakwe, elyo njookonzya kuleka mapenzi ngendili mukuyeeya kubaletela nkaambo kabubi bwamilimo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
