              "items": [
                {
                  "text": "Inc 5:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa mwami Hezekiya abantu boonse ba-Juda bakamujaya na? Sa takakayoowa Jehova akutontozya busyu bwa-Jehova? Lino Jehova sa takakaleka mapenzi ngaakaamba kubaletela? Pele swebo twaamba kuliletela mapenzi mapati tubeni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        }
