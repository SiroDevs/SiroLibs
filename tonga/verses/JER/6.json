                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.11"
              },
              "items": [
                {
                  "text": "Ezk 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.2"
              },
              "items": [
                {
                  "text": "Mik 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli kasensa mbukatuntumusya maanzi aako cakutayuminina, ulatuntumusya bubi bwawo mbubonya, Mukati kawo mulamvwigwa lunyansyo alunyonyooko, Malwazi amabunda mpaali lyoonse kumeso aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.7",
            "verseOrgIds": [
              "JER.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.18"
              },
              "items": [
                {
                  "text": "Ezk 23:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.12"
              },
              "items": [
                {
                  "text": "Hos 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kolayigwa, O Jerusalemu, kuti moyo wangu utaleki kukuyanda, ntakubiki mbuli matongo, nyika iibula bantu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.8",
            "verseOrgIds": [
              "JER.6.8"
            ]
          }
        }
      ]
    },
