                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uleelede kubaambila kuti, Ndakali kukumbila kumwami kuti atandipilusyi kuŋanda ya-Jonatani, kuti ntafwidi nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
