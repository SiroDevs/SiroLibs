              },
              "items": [
                {
                  "text": "Jer 32:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele na wakaka kwiinka kuyoolyaaba mumaanza aabasilutwe bamwami wa-Babuloni, munzi uno uyooabwa mumaanza aaba-Kasidi, nkabela bayooutenta mumulilo, ayebo tokooyooloboka kuzwa kumaanza aabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        },
