              "items": [
                {
                  "text": "2 Kor 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Jeremiya wakati, Tokooyooabwa mumaanza aabo pe, Koswiilila ijwi lya-Jehova, makani ngendakwaambila, kuti ube kabotu, ukapone, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na wakaka kwiinka kuyoolyaaba, swiilila cilengano Jehova ncaanditondezya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
