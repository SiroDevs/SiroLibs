            }
          ]
        },
        {
          "text": "Mpawo Zedekiya wakaambila Jeremiya kuti, Kutabi muntu naba omwe uuzi majwi aya, lino tokooyoofwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.24",
