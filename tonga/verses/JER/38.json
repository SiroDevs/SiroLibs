            "number": "10",
            "style": "v",
            "sid": "JER 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo mwami wakalailila Ebedi-meleki mu-Kusi kuti, Tolelela bantu botatwe kuzwa ano, mukagwisye Jeremiya musinsimi omo mumulindi naatana kufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.10",
            "verseOrgIds": [
              "JER.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Ebedi-meleki wakatolelela bantu, waya kuŋanda yamwami, kucilondwedo kunsi lyaciyobwedo, wagwisya mumonya zisani zideluukide azyakusama zikulukulu, waziselusya intambo kuliJeremiya mumulindi mwakabede. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.11",
            "verseOrgIds": [
              "JER.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 38:12"
          },
          "items": [
