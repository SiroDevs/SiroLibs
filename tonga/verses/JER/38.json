              "items": [
                {
                  "text": "1 Sam 31:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mwami Zedekiya wakaambila Jeremiya kuti, Ndayoowa ba-Juda abo balyaabide kale mumaanza aaba-Kasidi. Ambweni bayoondipa mumaanza aabo kuti bandiwele. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        },
        {
