              "items": [
                {
                  "text": "Jer 39:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Banakazi bako abana bako boonse balabaleta kuliba-Kasidi, Tokooyooloboka kuzwa kumaanza aabo, nkaambo uyoojatwa kumaanza aamwami wa-Babuloni, nkabela munzi uno uyootentwa amulilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
