          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambweni basilutwe bayooswiilila kuti twaambaula ayebo, alimwi bayoosika kulinduwe akwaamba kuti, Utulwiide makani ngowakaambaula amwami; utasisi makani kulindiswe, lino tatukooyookujaya; aalo makani mwami ngaakaamba kulinduwe, utulwiide ngao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
        {
          "name": "verse",
