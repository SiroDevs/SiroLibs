              "type": "text"
            }
          ]
        },
        {
          "text": "Pele balo tabakwe nibakaswiilila nikuba kucenjeka matwi aabo. Bakayumya insingo zyabo kuti bataswiilili nikuba kutambula lulayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
