                {
                  "text": "Int 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyooba mbuli musamu uubyalidwe kumbali lyamaanzi, uutunga miyanda yawo kukalonga, uutayoowa inkasaaloniisika, Maatu aawo alasia lyoonse, amumwaka wacimpayuma taakwe cuukataazya, tuuleki kuzyala micelo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
