              },
              "items": [
                {
                  "text": "Job 20:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uli mbuli kasamu kamunkanda, takooyoobona cintu niciba cimwi cibotu cimusikila. Ulakala mumasena aayuminide aamunkanda, munyika yamunyo iitakalwi bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
