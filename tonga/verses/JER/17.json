              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utandibedi ciyoosyo. Nduwe macijilo aangu mubuzuba bwamapenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.17",
            "verseOrgIds": [
              "JER.17.17"
