        },
        {
          "text": "Mbuboobu mbwaamba Jehova. Uli alutuko muntu umwi aumwi uusyoma muntu uulya maila, uubika moyo wakwe kukuboko kwanyama yabuntu, uulesya moyo wakwe kuzwa kuli-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        },
        {
          "name": "verse",
