          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele na mwandiswiilila camoyo woonse, mbwaamba Jehova, na mwakaka kunjizya mikuli mumilyango yamunzi oyu mubuzuba bwa-Sabata, na mwalemeka buzuba bwa-Sabata akutabeleka milimo niiba imwi mulimbubo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
