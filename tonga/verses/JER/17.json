          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basikundipenzya bausigwe insoni, pele mebo ntausigwi insoni pe! Bayoosegwe balo, pele mebo ne! Kobaletela buzuba bwamapenzi akubanyonyoona lunyonyooko kobile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
