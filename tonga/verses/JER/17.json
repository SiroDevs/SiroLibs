              "items": [
                {
                  "text": "Tus 16:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uli acoolwe muntu uusyoma Jehova, uujisi Jehova mbuli mutabilizi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
