              "items": [
                {
                  "text": "Jer 16:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino uyooleka lukono lwako ndundakakupa, nkabela njoocita kuti ubelekele basinkondonyoko milimo munyika njotezi, nkaambo mubukali bwangu mwadukuwa mulilo uuyoopya lyoonse cakutazima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
