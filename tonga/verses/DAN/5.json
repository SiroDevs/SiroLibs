        },
        {
          "text": "Lino Belisazara, naakalabila waini, wakalailila kuti aletelwe zinywido zyangolida azyansiliva, wisi Nebukadinezara nzyaakagwisya kuzwa kuntempele yaku-Jerusalemu, kuti mwami abasilutwe bakwe abanakazi bakwe abasimamambe bakwe banywide mulinzizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakaleta zinywido zyangolida azyansiliva izyakagwisigwa muntempele yaŋanda ya-Leza yamu­-Jerusalemu, nkabela mwami abasilutwe bakwe abanakazi bakwe abasimamambe bakwe bakanywida mulinzizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.4+PSA.115.5+PSA.115.6+PSA.115.7+PSA.115.8"
              },
              "items": [
                {
                  "text": "Int 115:4-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.20"
              },
              "items": [
                {
                  "text": "Ciy 9:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakali kunywa waini akutembaula baleza bangolida abansiliva, bamukuba ababutale, bazisamu abamabwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
