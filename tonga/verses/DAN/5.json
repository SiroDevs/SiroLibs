            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuciindi eco nciconya kwakaboneka minwe yajanza lyamuntu ilalemba abulambo bwaŋanda yamwami kunembo lyaciimikilo calampi, nkabela mwami wakabona ijanza ilyakali kulemba. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.5",
            "verseOrgIds": [
              "DAN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
