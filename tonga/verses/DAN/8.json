              "items": [
                {
                  "text": "Dt 28:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kumamanino aaciindi cabo cakweendelezya, basikubisya nebanooyoozwide bubi bwabo, kuyoobuka mwami muyumu moyo uumvwisya tulabi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.23",
            "verseOrgIds": [
              "DAN.8.23"
            ]
          }
        },
        {
