            "number": "19",
            "style": "v",
            "sid": "DAN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati, Bona! Ndakuzibya ciyooba kumamanino aaciindi cabukali, nkaambo ciindi ceelede cakumamanino cilibikidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.19",
            "verseOrgIds": [
              "DAN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugutu ngowakabona uuli ameja obile-nkokuti bami ba-Mediya aba-Persia, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.20",
            "verseOrgIds": [
              "DAN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asijembwe uuli aboya ngu mwami waba-Helene, aluja lupati luli akati kameso aakwe ngumwami mutaanzi, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.21",
            "verseOrgIds": [
              "DAN.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mbubonya mbowakabona kuti, luja nelwakatyoka, kwakamena ambi one mucibaka calo, nkokuti mami one ayoozwa mubwami obo, pele taakooyooelana abo munguzu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.22",
            "verseOrgIds": [
              "DAN.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
