          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino naakacili kundaambila, ndakafwida mutjonzi cakuvundama, pele wakandaampa akundiimika amaulu aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.18",
            "verseOrgIds": [
              "DAN.8.18"
            ]
          }
        },
        {
