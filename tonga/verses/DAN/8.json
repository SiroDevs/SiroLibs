          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mebo nde-Daniele, nindakabona cilengano, ndakali kuyandaula kucimvwa, Elyo kwakaimvwi kubusyu bwangu cili mbuli muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.15",
            "verseOrgIds": [
              "DAN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.21"
              },
              "items": [
                {
                  "text": "Dan 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.19"
              },
              "items": [
                {
                  "text": "Lk 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela ndakamvwa ijwi lyamuntu akatikati kankomwe zya-Ulai, lyakali koongolola, liti, Gabriyeli, pandulwida muntu oyu cilengano, acimvwisye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.16",
            "verseOrgIds": [
              "DAN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
              },
              "items": [
                {
                  "text": "Ciy 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino wakaswena afwaafwi mpondakaimvwi, nkabela naakaswena, ndakayoowa, ndavunduma ansi. Pele wakandaambila kuti, Swiililisya, O mwana amuntu, cilengano ncecaciindi camamanino.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.17",
            "verseOrgIds": [
              "DAN.8.17"
            ]
          }
        }
      ]
    },
