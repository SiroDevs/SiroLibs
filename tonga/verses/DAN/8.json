              "items": [
                {
                  "text": "Ciy 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inguzu zyakwe ziyoovula, nkabela uyoonyonyoona cakuyoosya akujana coolwe mumilimo yoonse njacita. Uyoonyonyoona basinguzu abantu basalala. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.24",
