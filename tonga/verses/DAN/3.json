        {
          "text": "Aboobo beendelezi bazisi abangambela abami abasinkuta abasimubambamali ababetesi abasikwiiminina abasilutwe boonse bazisi bakabungana kukusalazya eco cikozyano mwami Nebukadinezara ncaakaimikide. Nkabela bakaliimvwi kunembo lyacikozyano Nebukadinezara ncaakaimikide, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
