          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Webo, O mwami, ulibikide mulao wakuti kufumbwa muntu uumvwa ijwi lyamweembo amilozi akantimbwa anyeele acinamondonga amutetele aziimbyo­ zyoonse, uleelede kuvundama akukotamina cikozyano cangolida, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
