                  "text": "Dan 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo sikoongolola wakaita canguzu, wati, Mwalaililwa nubantu bamisyobo yoonse azisi zyoonse amyaambo yoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti kufumbwa ciindi nimuswiilila ijwi lyamweembo amilozi akantimbwa anyeele acinamondonga amutetele aziimbyo­ zyoonse, muleelede kuvundama akukotamina cikozyano cangolida mwami Nebukadinezara ncaimikide, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
