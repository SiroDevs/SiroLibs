          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabela kufumbwa muntu uukaka kuvundama akucikotamina uleelede kuwaalwa mukati kabbila lyamulilo wamabangabanga, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
