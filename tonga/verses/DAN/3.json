          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.22"
              },
              "items": [
                {
                  "text": "Jer 29:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.15"
              },
              "items": [
                {
                  "text": "Ciy 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kufumbwa muntu uukaka kuvundama akucikotamina, uyootolwa ndilyonya akuwaalwa mubbila lyamulilo wamabangabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako bantu boonse nibakamvwa ijwi lyamweembo amilozi akantimbwa anyeele acinamondonga aziimbyo zyoonse, bantu bamisyobo yoonse abazisi zyoonse abamyaambo yoonse bakali kuvundama akukotamina cikozyano cangolida mwami Nebukadinezara ncaakaimikide.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
