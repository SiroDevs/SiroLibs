                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bakaambila mwami Nebukadinezara kuti, O mwami, kopona lyoonse, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
