              "items": [
                {
                  "text": "Is 53:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zimane insondo zili makumi aali musanu alimwi azibili, uunanikidwe uyoonyonyoonwa, cakubula sikulya izina, Nkabela bantu bamwami uuboola bayoonyonyoona munzi acikombelo. Izambangulwe ndeliyooumanisya, alimwi kuyooba inkondo mane kusikila kumamanino. Insaalo zilibikidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
