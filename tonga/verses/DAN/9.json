          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asike, wandaambila kuti, Daniele, ndeza lino kuzookutya busongo aluzibo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumatalikilo aakukumbila kwako, kwakazwa ijwi, lino ciindi ecino ndeza kukulwiida, nkaambo uli muntu uuyandwa loko. Lino teelela ijwi, umvwisye cilengano,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
