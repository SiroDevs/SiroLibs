              "type": "tag",
              "attrs": {
                "loc": "JOL.2.13"
              },
              "items": [
                {
                  "text": "Joel 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwami Leza wesu ngujisi luzyalo alulekelelo, nkaambo twamupapila, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tatuna kuswiilila ijwi lya-Jehova Leza wesu kukweenda mumilao yakwe njaakatubikila kumilomo yabalanda bakwe basinsimi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
