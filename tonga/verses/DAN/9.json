            }
          ]
        },
        {
          "text": "Mpawo ndakalanzya busyu bwangu ku-Mwami Leza kukumuyandaula azikombyo azikumbizyo cakuliimya kulya acakusama zisani zyamasaka akulibubula mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakakomba kuli-Jehova Leza wangu akulyaamba zibi, ndati, Akaka Mwami, Leza mupati uuyoosya, uusyomeka mucizuminano cakwe, uubafwida luzyalo boonse bamuyandisya akubamba milao yakwe! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
