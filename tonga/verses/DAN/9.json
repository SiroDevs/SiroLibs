          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nendakacili kwaamba, akukomba, akulyaambilila zibi zyangu azibi zyabantu bangu ba-Israyeli, akuleta inkumbizyo zyangu kubusyu bwaJehova Leza wangu nkaambo kacilundu cisalala ca-Leza wangu— ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
