              "attrs": {
                "loc": "DEU.27.15+DEU.27.16+DEU.27.17+DEU.27.18+DEU.27.19+DEU.27.20+DEU.27.21+DEU.27.22+DEU.27.23+DEU.27.24+DEU.27.25+DEU.27.26"
              },
              "items": [
