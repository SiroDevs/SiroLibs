                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino sikutema mulandu wabulowa, amutobela, tabakooyooaba sikujaya mumaanza aakwe, nkaambo wakajaya mweenzinyina cakutaziba buyo, takamusulide kale pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
