              "items": [
                {
                  "text": "Jos 22:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutalubi ijwi Musa mulanda wa-Jehova ndyaakamulailila, Wakati, Jehova Leza wanu wamupa kulyokezya, wamupa nyika ino. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino banakazi banu atwana twanu aŋombe zyanu, boonse balasyaala mumonya munyika Musa njaakamupa mutala omuno lya-Jordano, pele inywe nubeni muleelede kuzubuka azilwisyo zyanu kunembo lyabasiluzubo banu. Bazubuke boonse baalumi basintaze, kuti mubagwasye, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.14",
            "verseOrgIds": [
              "JOS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.4"
              },
              "items": [
                {
                  "text": "Jos 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mane Jehova amane kupa basiluzubo banu kulyokezya mbubonya mbumwapegwa anywe, bavube abalo nyika Jehova Leza wanu njabapa, elyo kusule muzooboola kunyika yalukono lwanu, mwiivube eyi nyika Musa mulanda wa-Jehova njaakamupa omuno mutala lya-Jordano kubuzwezuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bakavwiila Joshua kuti, Makani oonse ngotulailila tulaacita, alimwi koonse nkoyootutuma tuyooinka nkuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.16",
