          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nibwakaca buzuba bwabili, bakazyunguluka munzi lomwe, akupiluka kuzilao nkubakakede, Mbuboobo mbubakacita mazuba aali musanu abumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.14",
            "verseOrgIds": [
              "JOS.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
