              "items": [
                {
                  "text": "Gal 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bapaizi bali musanu ababili ibakali amyeembo iili musanu aibili kunembo lyabbokesi lya-Jehova bakali kuya bulizya myeembo. Basilumamba bakabasololela, abamwi bakeza kusule lyabbokesi lya-Jehova, Bakaya bulizya myeembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
