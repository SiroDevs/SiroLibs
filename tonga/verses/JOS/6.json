                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jehova wakaambila Joshua kuti, Bona! Jeriko amwami wawo abaalumi basintaze bawo, boonse ndabaaba mumaanza aako, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino muleelede kuya buzyunguluka munzi, nubaalumi basilumamba nyoonse, kuzyunguluka munzi lomwe abuzuba, Kamucita obo mazuba aali musanu abumwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.16"
              },
              "items": [
                {
                  "text": "Bab 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.8"
              },
              "items": [
                {
                  "text": "My 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela bapaizi bali musanu ababili kabaya bulizya myeembo iili musanu aibili cakusekelela kunembo lyabbokesi lya-Leza, Lino mubuzuba bwamusanu aabili kamuzyunguluka munzi ziindi zili musanu azibili, elyo bapaizi baleelede kusibisya myeembo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ciindi ncibati sibe myeembo ciindi cilamfu, mwa-mvwa buyo ijwi lyamweembo, bantu boonse baleelede koompolola loompololo lupati, nkabela mpawo bulambo bwamunzi buzoowida ansi mbumu, kuti bantu banjile buyo manjilanjila.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Joshua mwana wa-Nu ni wakaita bapaizi, wakabaambila kuti, Amubweze ibbokesi lyacizuminano, alimwi bapaizi bali musanu ababili beende amyeembo iili musanu aibili kunembo lyabbokesi lya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino wakaambila bantu kuti, Kamuya kunembo, mukazyunguluke munzi, abalo basilumamba bai nde kunembo lyabbokesi lya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.4.13"
              },
              "items": [
                {
                  "text": "Jos 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Joshua amane buyo kwaambila bantu, abo bapaizi bali musanu ababili ibakabwezede myeembo iili musanu aibili kubusyu bwa-Jehova bakainda kunembo, bakali zya myeembo, nkabela ibbokesi lyacizuminano ca-Jehova lyakatobela munsi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 6:9"
          },
          "items": [
