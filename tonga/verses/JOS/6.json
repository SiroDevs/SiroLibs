          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibwakaca buzuba bwamusanu aabili, bakafuma loko junza-Junza, bakazyunguluka munzi mbubonya ziindi zili musanu azibili. Buzuba obo luzutu bakazyunguluka munzi ziindi zili musanu azibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.15",
            "verseOrgIds": [
              "JOS.6.15"
            ]
          }
        },
        {
