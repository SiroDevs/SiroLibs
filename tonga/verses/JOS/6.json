              "attrs": {
                "loc": "ISA.42.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo basilumamba bakasololela bapaizi basikulizya myeembo, abamwi bakatobela musule lyabbokesi. Bakali kuya bulizya myeembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Joshua wakalailila bantu kuti, Mutaakuyobayoba nanka kwaamba pe. Kutabi ijwi niliba lyomwe lizwa mumilomo yanu, mane obo buzuba mbunti kamwaambile kuti, Amoompolole. Ndilyonya muloompolola. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboobo ibbokesi lya-Jehova wakalizyungulusya munzi. Lyakauzyunguluka komwe, elyo bakaboola muzilao, bakoona mumonya muzilao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
