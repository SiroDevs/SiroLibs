              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "antoomwe aminzi bana ba-Efraimu njibakaabilwa akati kacisi cabana ba-Manase, minzi yoonse atunzuunzi twayo. ",
          "type": "text",
          "attrs": {
