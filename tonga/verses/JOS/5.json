        {
          "text": "Lino bami boonse baba-Amori ibakali mutala lya-Jordano kumbo, abami boonse baba-Kanana ibakali kumbali alwizi, nibakamvwa Jehova mbwaakayuminizya maanzi aa-Jordano kubusyu bwabana ba-Israyeli ciindi eciya nibakazubuka, myoyo yabo yakayaaya, katacikwe bukozu mulimbabo nkaambo kabana ba-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
