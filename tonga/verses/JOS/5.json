                }
              ]
            }
          ]
        },
        {
          "text": "Lino ba-Israyeli nibakakede ku-Giligala, bakaiya ipobwe lya-Pasika mubuzuba bwakumi aane bwamwezi, ciindi camangolezya, nkukonya oko kumabanda aa-Jeriko, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela ipobwe lya-Pasika nilyakamana, nibwakaca bakatalika kulya micelo yanyika. Bakalya zinkwa zitakwe bumena amaila mayoke mubuzuba obo mbubonya, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
