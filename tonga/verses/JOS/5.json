            }
          ]
        },
        {
          "text": "Elyo bantu boonse nibakamana kupalulwa, bakakala nkukonya kumalabba nkubakabede mane bakapona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
