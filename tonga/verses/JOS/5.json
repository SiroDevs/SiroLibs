              "items": [
                {
                  "text": "Heb 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo myaka iili makumi one bana baIsrayeli kabeendeenda munkanda, mane bakamana boonse basilumamba bacisi ibakazwide mu-Egepita, ibakakaka kuswiilila ijwi lya-Jehova. Aba bantu Jehova wakabakonkezya kuti tabakooyoobona nyika eyo Jehova njaakasyomezya bamawisaabo kutupa, nyika iizwide malili abuci, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.31"
              },
              "items": [
                {
                  "text": "My 14:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bana babo mbaakabusya mucimanga cabo, mbembabo Joshua mbaakapalula, nkaambo kabali basilulomo, ikuti kabatana kubapalula munzila.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
