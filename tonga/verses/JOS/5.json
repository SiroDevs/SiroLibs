                  "text": "Dt 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ncencico Joshua ncaakabapalwida. Bantu boonse ibakazwa ku-Egepita, nkukuti baalumi basilumamba, bakafwa munkanda nibakacili munzila kuzwa ku-Egepita, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu boonse ibakazwa ku-Egepita bakalipalwidwe, pele bantu ibakazyalilwa munkanda nibakacili munzila teebakaina kupalulwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
