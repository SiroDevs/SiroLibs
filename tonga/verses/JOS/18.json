                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba-Levi tabakonzyi kupegwa caabilo akati kanu, nkaambo bupaizi bwa-Jehova ncecaabilo cabo, alimwi ba-Gadi aba-Rubeni acisela camukowa wa-Manase batambula kale caabilo cabo mutala lya-Jordano lyakujwe, ncencico Musa mulanda waJehova ncaakabapa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        }
