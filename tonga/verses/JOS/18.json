              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.1"
              },
              "items": [
                {
                  "text": "Jos 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.1+JOS.16.2+JOS.16.3+JOS.16.4"
              },
              "items": [
