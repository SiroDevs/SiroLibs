          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.2"
              },
              "items": [
                {
                  "text": "Jos 14:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulembe nyika mbwiibede muzyaabilo zili musanu azibili, akuleta cilembelo okuno kulindime, elyo njoomuwaalila cisolo okuno kubusyu bwa-Jehova Leza wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
