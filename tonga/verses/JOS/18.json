                  "text": "Jos 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mugaano wabo wakunyika wakazwa ku-Jordano, wakainda kubbazu lya-Jeriko kunyika, alimwi wakainda kuzilundulundu zyakumbo, amagolelo aawo akali kunkanda ya-Beti-aveni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
