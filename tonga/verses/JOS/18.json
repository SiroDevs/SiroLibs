              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzwa oko wakainda kukalundu kalangene a-Araba kunyika, akusika ku-Araba, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
