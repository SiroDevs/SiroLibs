        {
          "text": "Lino kwakasyaala misyobo iili musanu aibili akati kabana ba-Israyeli iyakatalina kwaabilwa zyaabilo zyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
