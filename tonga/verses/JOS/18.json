              "type": "text"
            }
          ]
        },
        {
          "text": "Lino caabilo camukowa wabana ba-Benjamini muziinga zyabo nceeci. Nyika yabo njibakawaalilwa cisolo yakali akati kabana ba-Juda abana baJosefa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.11",
            "verseOrgIds": [
              "JOS.18.11"
            ]
          }
        },
        {
