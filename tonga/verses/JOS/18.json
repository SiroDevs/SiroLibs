                  "text": "16:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bayooiaba muzyaabilo zili musanu azibili. Bana ba-Juda basyaale kucisi cabo nkubabede kumusanza, amukowa wa-Josefa usyaale mucisi cawo cakunyika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
