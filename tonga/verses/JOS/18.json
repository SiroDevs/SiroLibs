            }
          ]
        },
        {
          "text": "Lino abo bantu bakanyamuka akwiinka, nkabela nibakainka Joshua wakabalailila kuti balembe nyika yoonse. Wakati, Kamuya bweendeenda munyika, mwiilembe, akuboola alimwi kulindime, nkamuwaalile cisolo kumeso aa-Jehova okuno ku-Silo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo bantu bakainka, bakainda moonse munyika, bakailemba aminzi yayo mubbuku, muzyaabilo zili musanu azibili, elyo bakaboola kuli-Joshua kuzilao nkwaakabede ku-Silo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.9",
            "verseOrgIds": [
              "JOS.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.16.33"
              },
              "items": [
                {
                  "text": "Tus 16:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Joshua wakabawaalila cisolo kumeso aa-Jehova ku-Sile. Nkonkuko Joshua nkwaakaabilila bana ba-Israyeli nyika muzipanzi zyabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        }
      ]
    },
