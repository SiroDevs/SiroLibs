              },
              "items": [
                {
                  "text": "71:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Farao ulaamba aabana ba-Israyeli kuti, Balipatide munyika eyo; inkanda yabajalila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.3",
            "verseOrgIds": [
              "EXO.14.3"
            ]
          }
        },
        {
