              },
              "items": [
                {
                  "text": "Jer 44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambila bana baIsrayeli kuti bapiluke, bayake zilao zyabo kunembo lya-Pihahiroti, akatikati ka-Migidoli alwizi kunembo lya-Baala-Zefoni. Amuyake zilao zyanu nkukonya oko kumbali lyalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.2",
            "verseOrgIds": [
              "EXO.14.2"
            ]
          }
        },
        {
