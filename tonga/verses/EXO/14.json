                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Musa wakaambila bantu kuti, Mutayoowi, amwiime, mubone lufutuko Jehova ndwasi mucitile buzuba obuno, Aba ba-Egepita mbomubwene sunu tamukooyoobabona limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
