            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.22"
              },
              "items": [
                {
                  "text": "Dt 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu aba boonse ibakazwa mucikungu ca-Jakobo bakali makumi aali musanu aabili, nkaambo Josefa kali kale mu-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 1:6"
          },
          "items": [
