        },
        {
          "text": "Ngaaya mazina aabana ba-Israyeli ibakeza ku-Egepita a-Jakobo, umwi aumwi aciinga cakwe: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
