            }
          ]
        },
        {
          "text": "Pele bana ba-Israydi bakazyalisya akuvulisya, bakaba banji akujata inguzu loko loko, mane nyika yakazula mbabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
