                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Josefa wakafwa, abakulana bakwe boonse, abamusdanyina boonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
