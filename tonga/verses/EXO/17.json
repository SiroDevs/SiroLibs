        },
        {
          "text": "Mpawo Musa wakakwiilila Jehova, wati, Mbacitilenzi aba bantu? Baamba kundifusa mabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
