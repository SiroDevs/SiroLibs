        },
        {
          "text": "Lino kuzwa kunkanda ya-Sini imbungano yoonse yabana ba-Israyeli yakali kuya bulonga-longa, mbubonya mbuli Jehova mbwaakalailila, mane lumwi bakasika ku-Refidimu, bakayaka zilao zyabo nkuko. Pele oko kakutakwe maanzi aakunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "verse",
