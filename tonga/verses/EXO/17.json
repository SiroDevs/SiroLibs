              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.45"
              },
              "items": [
                {
                  "text": "Inc 7:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.8"
              },
              "items": [
                {
                  "text": "Heb 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Musa wakaambila Joshua kuti, Kotusalila bantu, uinke, ukalwanye ba-Amaleki. Junza njooima atala lyacilundu, amusako wa-Leza mujanza lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Joshua wakacita mbubonya mbwaakamulailila Musa, waakulwisya ba-Amaleki, Nkabela ba-Musa a-Aroni a-Huri bakatanta atala lyacilundu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Jak 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino kufumbwa ciindi Musa naakasumpula ijanza lyakwe, ba-Israyeli bakali kuzunda, pele kufumbwa ciindi naakaleka kusumpula ijanza lyakwe, ba-Amaleki bakali kuzunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele maanza aa-Musa akalema; nkaambo kako bakabweza ibbwe, balibika munsi lyakwe, wakala mpawo, nkabela ba-Aroni a-Huri bakatabilila maanza aakwe, umwi kulubazu oko aumwi kulubazu oko, aboobo maanza aakwe akaliimvwi nji mane kusikila kumabbililo aazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Joshua wakawisya Amaleki abantu bakwe kupanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        }
      ]
    },
