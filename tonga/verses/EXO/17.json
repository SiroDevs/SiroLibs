              "attrs": {
                "loc": "1CO.10.4"
              },
              "items": [
                {
                  "text": "1 Kor 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bona! Ndaima kubusyu bwako agale oko ku-Horebi, lino ukaume igale; mulindilyo maanzi alazwa, abantu balanywa, Elyo Musa wakacita mbubonya obo kumeso aabapati ba-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.8"
              },
              "items": [
                {
                  "text": "Int 95:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.8"
              },
              "items": [
                {
                  "text": "Heb 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela oko kuntu wakakuulika izina lyaMasa, a-Meriba, nkaambo kakwaambana kwabana ba-Israyeli, akaambo kakuti bakasunka Jehova cakwaamba kuti, Sa Jehova mpali akati kesu na pe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
