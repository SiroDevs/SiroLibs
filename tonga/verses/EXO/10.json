          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Musa wakavuwa kuti, Uleelede kupa mumaanza esu zipaizyo azituuzyo, tuzibambile Jehova Leza wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
