              "items": [
                {
                  "text": "Kul 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Tandabika ijanza lyako atala lyanyika ya-Egepita kuti cisozi ciboole munyika ya-Egepita, cilye mani oonse aanyika, oonse ngecakasia civulamabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Musa wakatandabika musako wakwe atala lyacisi ca-Egepita, nkabela Jehova wakaungya muuwo wakujwe munyika buzuba obo boonse isikati amasiku, Lino nebwakaca, oyo muuwo wakujwe wakaleta cisozi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
