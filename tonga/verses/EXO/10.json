                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aboobo Musa wakatondeka ijanza lyakwe kujulu, nkabela kwakaba mudima uusia mbi munyika yoonse ya-Egepita mazuba otatwe. ",
          "type": "text",
          "attrs": {
