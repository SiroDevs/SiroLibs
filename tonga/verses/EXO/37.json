                  "text": "4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakacicitila malampi aali musanu aabili, amano zyaco ankaye zyaco; zyoonse zyakali zyangolida iisalala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciimikilo azibelesyo zyaco zyoonse wakazicita atalenta lyomwe lyangolida.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
