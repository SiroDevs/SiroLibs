              "items": [
                {
                  "text": "My 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.11"
              },
              "items": [
                {
                  "text": "Jer 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aalo aciimikilo cini akabezwa inkomeki zyone zili mbuli micelo yaalmondi, zili atunkuli amalubaluba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kwakali kankuli kunsi lyamitabi yobile, akamwi kunsi lyamitabi yobile, akamwi kunsi lyamitabi yobile, kumitabi yoonse iili musanu aumwi iizwa kuciimikilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunkuli amitabi, zyoonse kazijatilide mulincico, coonse cacifulamubisi, ingolida iisalala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
