              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.20"
              },
              "items": [
                {
                  "text": "Ciy 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Acalo ciimikilo camalampi wakacifuzya ingolida iisalala. Matako aaco amubili waco kaali acifulamubisi; inkomeki zyaco atunkuli twaco amalubaluba aaco zyoonse zyakajatilila mulincico. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela mumabazu aaco mwakazwa mitabi iili musanu aumwi; yotatwe kulubazu lumwi alumwi lwaciimikilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabi umwi aumwi kaubezedwe ankomeki zyotatwe zili mbuli micelo yaalmondi, zili atunkuli amalubaluba; mitabi yoonse iili musanu aumwi iizwa kuciimikilo mbuyakacitidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
