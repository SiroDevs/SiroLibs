                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi wakacita intafule yamuunga. Bulamfu bwayo bwakali tukokola tobile, bwaamba bwayo bwakali kakokola komwe, abwiime bwayo bwakali kakokola komwe acisela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
            "verseOrgIds": [
              "EXO.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaiziluluzya ingolida iisalala, akwiifulila moongola wangolida cakuzyunguluka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.11",
            "verseOrgIds": [
              "EXO.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakaicitila mubalo uuzingulukide uuli abwaamba bwajanza, ayooyo mubalo kauli amoongola wangolida koonse koonse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.12",
            "verseOrgIds": [
              "EXO.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi wakaifulila incoko zyone zyangolida akubika incoko kuzyooko zyone zyakumaulu aayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.13",
            "verseOrgIds": [
              "EXO.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufwaafwi kumubalo kwakabikwa incoko, zijate miziyo yakuyumuzya intafule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.14",
            "verseOrgIds": [
              "EXO.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miziyo wakaibezya muunga, waiziluluzya ingolida, ibe yakuyumuzya intafule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.15",
            "verseOrgIds": [
              "EXO.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.29"
              },
              "items": [
                {
                  "text": "Kul 25:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azyalo zibelesyo zyantafule wakazicitya ingolida iisalala: mitiba yayo, azilongo zyayo, amfulu zyayo zyakupaizya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        }
      ]
    },
