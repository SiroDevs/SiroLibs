            "sid": "EXO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Musa wakaakulwiida bantu majwi oonse aa-Jehova, ambeta zyoonse, nkabela bantu boonse bakavuwa ajwi lyomwe, bati, Makani oonse Jehova ngaamba tulaacita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 24:4"
          },
          "items": [
