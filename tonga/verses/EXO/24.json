        },
        {
          "text": "Lino wakaambila Musa kuti, Amutante nkwabede Jehova, yebo a-Aroni a-Nadabu a-Abihu abapati ba-Israyeli bali makumi aali musanu aabili, mukombe kulaale. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa alike nguelede kuswena afwaafwi kuli-Jehova. Bamwi batasweni afwiifwi pe, abalo bantu tabeelede kumusindikila.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        }
      ]
    },
    {
