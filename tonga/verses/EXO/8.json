            }
          ]
        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Fuma cifumo, ukaime kubusyu bwa-Farao, anooya kumaanzi, Uleelede kumwaambila kuti, Mbuboobu mbwaamba Mwami Jehova. Leka bantu bangu, baye, bandikombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
