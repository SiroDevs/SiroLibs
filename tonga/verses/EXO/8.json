          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo Musa naakazwa kuliFarao, wakakumbila kuli-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
