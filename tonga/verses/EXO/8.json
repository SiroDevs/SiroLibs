                }
              ]
            }
          ]
        },
        {
          "text": "Farao wakati, Mbubo, ndamuleka, kuti mukapaile Jehova Leza wanu munkanda, pele mutainki kule. Amundikumbilile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
