                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mubuzuba obo njooanzaanya cisi ca-Goseni, nkobakede bantu bangu, kuti kutabi mazi oko, kuti muzibe kuti ndime Jehova mukati kanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
