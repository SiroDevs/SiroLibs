        },
        {
          "text": "Lino Jehova wakaambila Musa kuti, Njila muli-Farao, ukamwaambile kuti, Mbuboobu mbwaamba Jehova. Leka bantu bangu, baye, bandi­ kombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.14"
              },
              "items": [
                {
                  "text": "Kul 7:14",
