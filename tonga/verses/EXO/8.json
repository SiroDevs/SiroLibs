              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooanzaanya bantu bangu abantu bako. Eci citondezyo ciyooba junza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
