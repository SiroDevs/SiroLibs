                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo ba-Musa a-Aroni bakazwa kuli-Farao, nkabela Musa wakakwiilila Jehova nkaambo kabacaande mbaakabikilide Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakacita mbubonya mbuli mbwaakaamba Musa, nkabela bacaande bakafwa mumaanda amumbuwa amunyuunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo bakababungika muzilwi zilwi mane cisi cakanunka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
