                "loc": "REV.16.13"
              },
              "items": [
                {
                  "text": "Ciy 16:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wakaka kubaleka, mebo ndauma nyika yako abacaande. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.2",
            "verseOrgIds": [
              "EXO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.30"
              },
              "items": [
                {
                  "text": "Int 105:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lwizi lulazula bacaande. Balazwa nkuko, akunjila muŋanda yako, amukaanda kako kakoona, aatala lyabulo bwako oonse, amumaanda aabalanda bako, aakati kabantu bako, amuziko zyako, amuzyaambikwa zyako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.3",
            "verseOrgIds": [
              "EXO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alinduwe aabantu bako aabalanda bako boonse buyo, bacaande balamusikila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Kul 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jehova wakaambila ba-Musa a-Aroni kuti, Tandabika ijanza lyako amusako wako atala lyamilonga alwizi amalambwa, kuti kuze bacaande munyika yoonse ya-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.45"
              },
              "items": [
                {
                  "text": "Int 78:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.30"
              },
              "items": [
                {
                  "text": "105:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo Aroni wakatandabika ijanza lyakwe atala lyamaanzi aa-Egepita, nkabela kwakasika bacaande kuzuzya nyika yoonse ya-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.11"
              },
              "items": [
                {
                  "text": "Kul 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele basimabibo abalo bakacita mbubonya amabibo aabo akuleta bacaande munyika ya-Egepita,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        }
      ]
