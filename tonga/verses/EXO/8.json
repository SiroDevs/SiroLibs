            }
          ]
        },
        {
          "text": "Wakati, Kube junza. Wakati, Ncibotu, kuyooba mbubonya mbuli majwi aako, kuti uzibe kuti taakwe naba omwe uuelene a-Jehova Leza wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacaande balazwa kulinduwe akumaanda aako akubalanda bako akubantu bako, balasyaala mulwizi luzutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
        {
