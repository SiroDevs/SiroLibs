              "items": [
                {
                  "text": "Muk 8:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.29"
              },
              "items": [
                {
                  "text": "Tus 21:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Farao naakabona kuti wajana buyoyelo, wakayumya moyo wakwe, wakaka kubaswiilila mbubonya mbuli Jehova mbwaakaamba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
