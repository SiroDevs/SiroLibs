          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa wakati, Bona! Ndakusia buyo, ndakumbila kuli-Jehova, kuti junza agwisye matanga aamazi kuzwa kuli-Farao akubalanda bakwe akubantu bakwe. Pele Farao atatweeni limbi kukutaleka bantu kuti bakapaile Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
