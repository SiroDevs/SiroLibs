            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele Musa wakati, Tacicitiki obo pe, nkaambo tulapaizizya Jehova Leza wesu zintu zisesemya ba-Egepira. Na twapaizya zintu zibasesemya kumeso aabo, sa tabakootufusa mabwe? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
