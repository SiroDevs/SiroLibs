          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wakaka kuleka bantu bangu, bona! Ndamutumina, yebo abalanda bako abantu bako amumaanda aako, matanga matanga aamazi. Maanda aabaEgepita alazula mazi, aalo ansi mpobeenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
              "EXO.8.21"
            ]
          }
        },
