                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo Jehova wakaambila Musa kuti, Amuzwe okuno, yebo abantu mbowagwisya mucisi ca-Egepita, muye munyika njindakakonkezya Abrahamu a-Izaka a-Jakobo cakwaamba kuti, Njooipa lunyungu lwako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.22"
              },
              "items": [
                {
                  "text": "Dt 7:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.11"
              },
              "items": [
                {
                  "text": "Jos 24:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndatuma angelo kumuzulwida, atande ba-Kanana aba-Amori aba-Hiti aba-Perizi aba-Hivi aba-Jebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.9"
              },
              "items": [
                {
                  "text": "Kul 32:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.6"
              },
              "items": [
                {
                  "text": "Dt 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kamuya kunyika iikunka malili abuci. Pele mebo nsikooinka akati kanu, pe, nkaambo muli bantu bayumu mumyoyo, Ambweni ngandaba nemujaya munzila.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        }
      ]
    },
