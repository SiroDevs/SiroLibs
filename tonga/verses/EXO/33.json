                "loc": "2SA.19.24"
              },
              "items": [
                {
                  "text": "2 Sam 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino bantu nebakamvwa makani aya mabi, bakalila, nkabela katakwe muntu iwakacaala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.23"
              },
              "items": [
                {
                  "text": "Int 139:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Jehova wakaambila Musa kuti, Ambila bana ba-Israyeli kuti, Muli bantu bayumu mumyoyo. Na ndeenda akati kanu kaindi kaniini buyo, inga ndamujaya. Lino amusamunune zyakucaula zyanu, nzibe na ndamucitilanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako bana ba-Israyeli bakasamununa zyakucaula zyabo kuzwa kucilundu ca-Horebu akuya kunembo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
    },
