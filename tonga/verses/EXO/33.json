              "items": [
                {
                  "text": "2 Sam 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Musa wakali kubweza itente akuliyaka anze lyamalabba kulekule, nkabela wakali kulyaamba kuti nditente lyambunganino. Nkabela kufumbwa muntu iwakali kuyandaula Jehova wakaya kutente lyambunganino oko kunze lyamalabba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.27"
              },
              "items": [
                {
                  "text": "My 16:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Musa naakainka kuya kutente, bantu oonse bakali kunyampuka akwiimikila umwi aumwi kumulyango wacilao cakwe, nkabela bakali kulangilizya Musa mane wanjila mutente. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.99.7"
              },
              "items": [
                {
                  "text": "Int 99:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Musa naakanjila mutente, musumpululu wajoba wakali kuseluka akwiimikila kumulyango watente, Elyo Jehova wakali kwaambaula a-Musa mpoonya awo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bantu boonse nebakabona kuti musumpululu wajoba uliimvwi kumulyango watente, bantu boonse bakanyampuka, bakomba, umwi aumwi kumulyango wacilao cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
