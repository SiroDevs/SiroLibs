        },
        {
          "text": "Alimwi wakapanga cisambilo camukuba, atako lyaco lyamukuba; mukuba wakazwa kuziboniboni zyabanakazi ibakali kubungana kumulyango watente lyambunganino.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
