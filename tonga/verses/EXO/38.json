              "attrs": {
                "loc": "EXO.30.11+EXO.30.12+EXO.30.13+EXO.30.14+EXO.30.15+EXO.30.16"
              },
              "items": [
                {
                  "text": "Kul 30:11-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayalo insiliva njibakapa basimbungano yakali matalenta aali mwanda amasyekeli aali cuulu amyanda iili musanu aibili amakumi aali musanu aabili amusanu, mbubonya mbuli isyekeli lyacikombelo. ",
          "type": "text",
