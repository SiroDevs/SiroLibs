                }
              ]
            }
          ]
        },
        {
          "text": "bakabaambila kuti, Jehova alange, abeteke makani esu, nywebo aswebo, nkaambo mwasampauzya bwema bwesu mumeso aa-Farao amumeso aabalanda bakwe. Wabika ipanga mumaanza aabo, kuti batujaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.21",
