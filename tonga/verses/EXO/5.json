                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.19"
              },
              "items": [
                {
                  "text": "Kul 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Farao wakati, Ma! Nguni Jehova? Sa ndakonzya kuswiilila ijwi lyakwe akuleka ba-Israyeli? Nsizi Jehova na nguni, abalo ba-Israyeli nsikoobaleka pe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.18"
              },
              "items": [
                {
                  "text": "Kul 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino bakati, Leza waba-Hebrayo waswanaana aswebo, Utuleke, tutole lweendo lwamazuba otatwe kuya munkanda, tupailile Jehova Leza wesu, kuti atatuumyi malwazi na ipanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.15"
              },
              "items": [
                {
                  "text": "Tus 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Kul 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele mwami wa-Egepita wakabaambila kuti, Nywebo, Musa a-Aroni, mwalesezyanzi bantu kubeleka? Kamuya kumilimo yanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.4",
            "verseOrgIds": [
              "EXO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.7"
              },
              "items": [
                {
                  "text": "Kul 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi Farao wakati, Ncobeni sunu bantu banyika bavula, lino mulabalesya milimo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.5",
            "verseOrgIds": [
              "EXO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Kul 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo mbubonya Farao wakalailila basikubelesya bantu abasilutwe babo kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutapi bantu limbi bwizu bwakuumya zitina, mbumwali kucita mazuba aakainda. Baye kuyoomwa beni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.7",
            "verseOrgIds": [
              "EXO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekubaboobo mweelwe wazitina ngubakali kucita, bacicite mbubonya obo, Mutacesyi mweelwe pe, nkaambo mbatolo; nciceeco ncibalilila cakuti, Katuya, tukapailile Leza wesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.8",
            "verseOrgIds": [
              "EXO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu balemezegwe milimo miyumu, baicite, batabiki myoyo yabo kumajwi aakubeja.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
