                "loc": "JHN.7.35"
              },
              "items": [
                {
                  "text": "Joh 7:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoobusizya bamasi citondezyo, uyoobunganya ba-Israyeli bamwaikide akuyobolola ba-Juda batandidwe kuzwa kumabazu oonse one aanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.28"
              },
              "items": [
                {
                  "text": "Gal 3:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo ibbivwe lya-Efraimu liyooleka, abasinkondonyina Juda bayoonyonyoonwa. Ba-Efraimu tabakooyoofwida ba-Juda ibbivwe, abalo ba-Juda tabakooyoopenzya ba-Efraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bayoosaala minkuni yaba-Filisti kumbo, abalo bana bakujwe bayoobanyanzya antoomwe. Bayootandabika maanza aabo kukulwisya ba-Edomu aba-Moabu, abalo bana ba-Amoni bayoocita milazyo yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
