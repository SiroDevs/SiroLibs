              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo Mwami uyootandabika lwabili ijanza lyakwe kukunununa bantu bakwe bacisyeede, nkukuti abo basyeede bazwa ku-Asuri aku-Egepita aku-Patirosi aku-Kusi aku-Elamu aku-Sinara aku-Hamati akutusuwa twakulwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
