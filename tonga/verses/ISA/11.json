        },
        {
          "text": "Uyoobeteka bacete cakululama, akukosweda batengwana banyika makani aaelede. Nkabela inkoli yamilomo yakwe uyooiumya basikupenzya, aluyooyo lwamukanwa lyakwe uyoolujazya basizibi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
