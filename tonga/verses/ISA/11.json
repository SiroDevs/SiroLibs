                "loc": "EPH.6.14"
              },
              "items": [
                {
                  "text": "Ef 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bululami buyooba lutambo lwakucibunu cakwe, alusyomo luyooba lutambo ndwalyaanzya kucikungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        },
        {
