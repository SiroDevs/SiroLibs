        },
        {
          "text": "Uyookalwa Muuya wa-Jehova, Muuya wabusongo awakuswiililisya, Muuya walulayo awanguzu, Muuya waluzibo awakulemeka Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyookondwa kulemeka Jehova, Takooyoobeteka kukuyeeya zintu ziboneka kumeso buyo, nikuba kukosola makani cakuzuminina majwi ngaamvwa kumatwi buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        },
        {
