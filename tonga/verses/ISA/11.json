                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Ciy 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino Jehova uyoonyonyoona lulimi lwalwizi lwa-Egepita, alimwi uyoobusya ipuumina lyakwe akuzungaanya ijanza lyakwe kumulonga, uyoovuma ube tulonga tuli musanu atubili, elyo kuyoozubukwa ansangu kumaulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
