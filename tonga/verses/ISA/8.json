          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nibalanga ansi, bayoobona mapenzi amudima. Kulasia mbi nkaambo kamafwabi. Nkabela bayootandwa oko kumudima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.22",
