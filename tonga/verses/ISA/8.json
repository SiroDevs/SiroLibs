          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balainda akati kanyika balipengede akufwa inzala, Elyo kuyooba kuti, ciindi eco nibayoofwa inzala, bayoocimwa, bayootukila mwami wabo a-Leza wabo, akupungula ajulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
