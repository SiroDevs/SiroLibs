                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutaambi kuti, Twaabwa, ciindi coonse bantu aba nibaamba kuti, Twaabwa. Mutayoowi ncibayoowa balo, nikuba kukankama nkaambo kaco. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
