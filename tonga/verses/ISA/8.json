            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Jehova wakandaambila kuti, Ulibwezele ibbwe ipati lyakulembela, ukalembye alindilyo cilembyo camuntu. Lemba kuti, Eci ncica-Sikubi­ nzyalusaalo Sikufwanzyalunyanzyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.10"
              },
              "items": [
                {
                  "text": "2 Bam 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela njoolibwezela bakamboni basyomesi, Uriya mupaizi a-Zekariya mwana wa-Jeberekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo nindakaswanaana amukamusinsimi, wakaminta, wazyala mwana mulombe. Nkabela Jehova wakandaambila kuti, Umuulike izina lya-Sikubinzyalusaalo Sikufwanzyalunyanzyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.16"
              },
              "items": [
                {
                  "text": "Is 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mwana natana kuba aluzibo lwakwaamba kuti “Ta” a “Ma”, imbono zya-Damasko abuvubi bwa-Samariya zyoonse ziyootolwa kumwami wa-Asuri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
