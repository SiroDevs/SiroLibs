          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubike myoyo yanu kumulao akubukamboni! Na tabaambi mbuli ijwi eli, nkukuti tamukwe mumuni mulimbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
