                  "text": "Joh 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bantu aba mbubakaka maanzi aa-Siloamu aaenda caluumuno, alimwi babika myoyo yabo ku-Rezini akumwana wa-Remaliya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
