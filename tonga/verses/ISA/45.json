            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Am 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime uubumba mumuni akulenga mudima. Ndime uucita luumuno akulenga mapenzi. Ndime Jehova uucita zintu ezi zyoonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
