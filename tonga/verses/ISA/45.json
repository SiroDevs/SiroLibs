              "items": [
                {
                  "text": "Mal 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti bazibe bantu boonse, kuzwa kubuzwezuba akuzwa kububbila, kuti taakwe umbi kunze kwangu. Ndime Jehova, taakwe umbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 45:7"
          },
          "items": [
            {
              "text": "7",
