        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.5"
              },
              "items": [
                {
                  "text": "Jer 27:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime ndakaanza nyika akulenga muntu alinjiyo. Maanza aangu ngaakatandabika ijulu, alimwi ndime ndakalailila makamu makamu aalyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 45:13"
          },
          "items": [
