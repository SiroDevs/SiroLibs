                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kamulanda wangu Jakobo a-Israyeli ngunsalide, nciceeco ncindakwiitila muzina lyako. Ndakuulika izina nekuba kuti tona kundiziba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.35"
              },
              "items": [
                {
                  "text": "Dt 4:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.18.32"
              },
              "items": [
                {
                  "text": "Int 18:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime Jehova, taakwe umbi. Taakwe Leza umbi kunze kwangu, Njookuyumya nekuba kuti tona kundiziba, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
