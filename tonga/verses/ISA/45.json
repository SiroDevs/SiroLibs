        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.9"
              },
              "items": [
                {
                  "text": "Jer 31:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.23"
              },
              "items": [
                {
                  "text": "Is 29:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwaamba Jehova, Uusalala wa-Israyeli, a-Mubumbi wakwe. Amundibuzye makani aaciza, Amundilailile aabana bangu azilenge zyamaanza aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
