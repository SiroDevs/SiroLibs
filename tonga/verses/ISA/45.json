                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuyoboloke, muboole. Amuswene afwaafwi nyoonse nubamasi basyeede, Tabajisi luzibo abo bayumwide zisamu zyazikozyano zibezedwe, bakomba Leza uutafutula. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
