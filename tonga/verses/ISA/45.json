          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.1"
              },
              "items": [
                {
                  "text": "Ezr 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.24"
              },
              "items": [
                {
                  "text": "Rom 3:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime ndakamubusya mubululami, nkabela njoolulamika inzila zyakwe zyoonse. Ngonguwe uuti yake munzi wangu akwaangununa baange bangu. Teensi muulo nibuba bulumbu ncacitila obo, mbwaamba Jehova wamakamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
