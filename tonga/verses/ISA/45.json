              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyooambwa kuti, Muli-Jehova alike momujenwe bululami anguzu. Boonse ibakamubusizya inkondo bayooboola nkwabede, bayoofwa insoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.24",
            "verseOrgIds": [
              "ISA.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
