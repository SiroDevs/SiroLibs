                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu Jehova mbwaambila munanike wakwe Koresi, nguwenya ngundajata kujanza lyalulyo kuti mfwiinsye bamasi kubusyu bwakwe akwaangununa bami muzibuno nkamujalwide milyango akukasya zitendele kujalwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njookuzulwida kuti nkacincimike masena aapilingene. Njoopwayaula makoma aamukuba akutendaula zitendele zyabutale. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.12"
              },
              "items": [
                {
                  "text": "Kul 33:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino njookupa zilondwedo zyamudima azintu ziyandisi ziyubikidwe, kuti uzibe kuti ndime Jehova iwakakwiita muzina lyako, nkukuti Leza wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
