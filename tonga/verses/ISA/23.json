              "items": [
                {
                  "text": "Ciy 17:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elyo kumamanino aamyaka iili makumi aali musanu aabili Jehova uyooswaya Turo, nkabela uyoopiluka kumbono zyakwe, uyooya buvuula azisi zyoonse zyamunyika yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
