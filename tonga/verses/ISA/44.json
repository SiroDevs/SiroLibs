                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Boonse babumba zikozyano zyamituni balipilingene, Zintu zyabo nzibayandisya tazigwasyi pe. Bakamboni babo tababoni, tabazi, Aboobo balausigwa insoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.5"
              },
              "items": [
                {
                  "text": "Jer 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.18"
              },
              "items": [
                {
                  "text": "Hab 2:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nguni uubumba leza nanka kufula cikozyano citagwasyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.7"
              },
              "items": [
                {
                  "text": "Int 97:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.17"
              },
              "items": [
                {
                  "text": "Is 42:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni beenzinyina boonse bayoousa insoni. Basimilimo mbantu buyo, Babungane, banyampuke. Bayooyoowa akuusigwa insoni boonse antoomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
