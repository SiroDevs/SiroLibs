                "loc": "JER.30.10"
              },
              "items": [
                {
                  "text": "Jer 30:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino swiilila, Jakobo mulanda wangu, a-Israyeli ngundisalide. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.1",
            "verseOrgIds": [
              "ISA.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.15"
              },
              "items": [
                {
                  "text": "Dt 32:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuboobu mbwa amba Jehova iwakakulenga, iwakakubumba mwida, uukugwasya. Utayoowi, Jakobo mulanda wangu, O Jesuruni ngundisalide. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.2",
            "verseOrgIds": [
              "ISA.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Joh 7:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo njootila maanzi aliyooyo uufwa nyota atulonga anyika injumu. Njootila Muuya wangu alunyungu lwako, acoolwe cangu njoocitilila bana bako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.3",
            "verseOrgIds": [
              "ISA.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela bayoosonsa akati kabwizu mbuli mizimbwa kumbali atulongalonga twamaanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.4",
            "verseOrgIds": [
              "ISA.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.9"
              },
              "items": [
                {
                  "text": "Kul 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.38"
              },
              "items": [
                {
                  "text": "Neh 9:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umwi uyooamba kuti, Mebo ndiwa-Jehova; umwi uyoolibanda izina lya-Jakobo; aumwi uyoolemba ajanza lyakwe kuti, Wa-Jehova, akulipa izina lya-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.5",
            "verseOrgIds": [
              "ISA.44.5"
            ]
          }
        }
      ]
