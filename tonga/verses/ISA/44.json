        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.35"
              },
              "items": [
                {
                  "text": "Dt 4:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.2"
              },
              "items": [
                {
                  "text": "1 Sam 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.22.32"
              },
              "items": [
                {
                  "text": "2 Sam 22:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutayoowi nikuba kukanduka. Sa teendakamulwiida makani kalekale? Sa teendakamutondezya? Ndinywe bakamboni bangu, Sa kuli Leza umbi uutali ndime? Ncobeni taakwe Mwala umbi. Taakwe ngumbwene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        }
