                "loc": "HOS.13.10"
              },
              "items": [
                {
                  "text": "Hos 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime Jehova, Uusalala wanu, Mulengi wa-Israyeli, Mwami wanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
