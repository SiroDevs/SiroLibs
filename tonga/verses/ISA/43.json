              "items": [
                {
                  "text": "44:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utayoowi, nkaambo ndi ayebo. Njooleta lunyungu lwako kuzwa kujwe akuyobolola bana bako kuzwa kumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooambila kunyika kuti, Leka, Akwalo kumusanza njookwaambila kuti, Utakasyi, Leta bana bangu kuzwa kule abana bangu basimbi kuzwa kumagolelo aanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 43:7"
          },
          "items": [
