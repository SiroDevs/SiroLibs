        },
        {
          "text": "Ndinywe bakamboni bangu, mbwaamba Jehova, alakwe mulanda wangu ngundisalide ngukamboni, kuti muzibe, mundizuminine, mumvwisye kuti ndime oyo uuliwo. Taakwe Leza iwakanditaangunina kubumbwa, alimwi taakwe uuyoondisyaala munsi lyangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndime, ndime Jehova, Taakwe Mufutuli umbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
