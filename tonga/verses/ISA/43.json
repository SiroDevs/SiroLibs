                  "text": "2 Tim 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele lino mbuboobu mbwaamba Jehova, ngonguwe iwakakulenga O Jakobo, ngonguwe iwakakubumba O Israyeli. Utayoowi, nkaambo ndakunununa, ndakwiita kuzina lyako, uli wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        },
        {
