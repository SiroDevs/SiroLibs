                "loc": "DEU.32.16"
              },
              "items": [
                {
                  "text": "Dt 32:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime ndakamulwiida makani, ndime ndakafutula, ndime ndakamukananina, ciindi eco nikwatakuli Leza mweenzu akati kanu. Ndinywe bakamboni bangu, mbwaamba Jehova. Ndime Leza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
