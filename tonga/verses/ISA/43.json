              "items": [
                {
                  "text": "Mt 19:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni kuzwa kubuzuba obuno ndime oyo. Taakwe uukonzya kuvuna kumaanza aangu. Milimo niindibeleka, nguni uukonzya kwiikasya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
