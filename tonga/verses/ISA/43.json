            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.19"
              },
              "items": [
                {
                  "text": "42:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pozya boofu bali ameso abasinkematwi bajisi matwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamasi boonse babungane, inzubo zyoonse ziyoboloke, Nguni akati kabo uukonzya kutulwiida aya makani akutukananina makani aaciindi. Balete bakamboni babo kuti babalulamike. Baswiilile akuzumina kuti, Ndusinizyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 43:10"
          },
          "items": [
            {
