          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.18"
              },
              "items": [
                {
                  "text": "Tus 21:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo ndime Jehova Leza wako, Uusalala wa-Israyeli, Mufutuli wako, Ndapa Egepita cibe cinunuzyo cako; Etiopiya a-Seba zyoonse ndazyaaba mucibaka cako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Kul 19:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli mbuwakayandika mumeso aangu, alimwi wakali abulemu, ndakuyandisya, aboobo ndaaba bantu mucibaka cako, ndapa misyobo yabantu kukunununa buumi bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        },
        {
