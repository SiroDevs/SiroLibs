              },
              "items": [
                {
                  "text": "Dan 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ciindi noinda akati kamaanzi, njooba ayebo, Noinda akati kamilonga, tiikooyookutola. Noenda mukati kamulilo, tokooyoopya pe, amabangabanga taakooyookutenta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 43:3"
          },
          "items": [
            {
              "text": "3",
