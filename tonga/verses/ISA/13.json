                "loc": "JER.51.25"
              },
              "items": [
                {
                  "text": "51:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amusimpike citondezyo atala acilundu cikukwidwe muuwo. Kolizya loko ijwi lyako lyakubaita, Koboobola ajanza lyako kuti banjile mumilyango yabasilutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.11"
              },
              "items": [
                {
                  "text": "Joel 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndalailila basalazi bangu, ndaita basinguzu bangu, balemu bangu basekelela, kuti bazuzikizye bukali bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile! Lyamvwigwa ijwi lyalupyopyongano akati kazilundu mbuli ijwi lyabantu banji. Amuswiilile! Ndijwi lyamakamu makamu aabantu bamami aabamasi, balibungene. Jehova wamakamu ulabunganya impi yabasilumamba bakulwisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balazwa kucisi cili kule loko, kumagolelo aakujulu, nkukuti Jehova azibelesyo zyabukali bwakwe. Baleza kukunyonyoona nyika yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.18"
              },
              "items": [
                {
                  "text": "Am 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.7"
              },
              "items": [
                {
                  "text": "Zef 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.15"
              },
              "items": [
                {
                  "text": "Joel 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amulile, nkaambo buzuba bwa-Jehova buli afwaafwi. Buyoosika mbuli lunyonyooko luzwa kuli-Syaatwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako maanza conse ayookompama, amyoyo yoonse yabantu iyoowizuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayookankama, Kuciswa akuzunta kuyoobajata mbubonya mbuli inzunto zyamwanakazi uumisr. Bayoogamba kukulangana umwi aumwi mweenzinyina. Masyu aabo ayooba mbuli mulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.1"
              },
              "items": [
                {
                  "text": "Mal 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubone! Buzuba bwa-Jehova buleza. Mbuzuba buyumu, bulijisi lunyemo abukali bunji. Bulasaala nyika cakugambya akunyonyoona basizibi bali mulinjiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.7"
              },
              "items": [
                {
                  "text": "Ezk 32:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mt 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.24+MRK.13.25"
              },
              "items": [
                {
                  "text": "Mk 13:24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.15"
              },
              "items": [
                {
                  "text": "Lk 21:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Ciy 6:12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo inyenyeezi zyakujulu abandakutema zilaleka kumunika. Izuba liyoosizigwa ciindi cakupasula; awalo mwezi uyookasya mumuni wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo njoobweedezya nyika bulumbu bwabubi bwayo, abasizibi bayoopegwa mulandu ngubeelede. Njoolesya kulisumpula kwabasicinguni akufwiinsya basikupenzya balikankaizya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoocita kuti muntu abe muyandisi mbuli ingolida iisalala. Muntu uulya maila uyooyandika mbuli ingolida yaku-Ofiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.16"
              },
              "items": [
                {
                  "text": "Joel 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Hag 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mt 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.12"
              },
              "items": [
                {
                  "text": "Malo 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kako njoozungaanya ijulu, ayalo nyika iyootenkana mpiibede, mubukali bwa-Jehova wamakamu amubuzuba bwalunyemo lwakwe lupati. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino kuyooba kuti, mbubonya mbuli insya iitandidwe ambuli imbelele iitakwe mweembeli, bayoopiluka umwi aumwi kubantu bakwe mwini, bayoocija umwi aumwi kunyika yakwe nkwaakazyalilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.14",
            "verseOrgIds": [
              "ISA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwi aumwi uujanwa uyooyaswa; umwi aumwi uujatwa uyoojazigwa ipanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.15",
            "verseOrgIds": [
              "ISA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.10"
              },
              "items": [
                {
                  "text": "Nah 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atwalo twana twabo tuyoopwayaulwa kumeso aabo. Maanda aabo ayoosaalwa, abanakazi babo bayootizigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.16",
            "verseOrgIds": [
              "ISA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.11"
              },
              "items": [
                {
                  "text": "Jer 51:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amubone! Ndabusya ba-Medi kuti babalwisye. Aba tabayeeyi insiliva, tabayandi ingolida. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.17",
            "verseOrgIds": [
              "ISA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mata aabo ayoopwayaula bakubusi. Tabakooyoofwida bana bamwida luzyalo, Meso aabo taakooyoofwida bana luse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.18",
            "verseOrgIds": [
              "ISA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Matl 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Babuloni, uujisi bulemu kwiinda zisi zyoonse, bweebesi ba-Kasidi mbubalikankaizizya, uyooba mbuli Sodoma a-Gomora ciindi eciya Leza naakaimwaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.19",
            "verseOrgIds": [
              "ISA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.23"
              },
              "items": [
                {
                  "text": "Is 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taukooyookalwa limbi mane kukabe kutamani. Taakwe uuyookala mulinguwo mumazyalani oonse. Mu-Arabu takooyooliyakila cilao nkuko, abalo beembeli tabakooyoocezya matanga aabo mulinguwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.20",
            "verseOrgIds": [
              "ISA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 13:21"
          },
