              "items": [
                {
                  "text": "2 Kor 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amunyamuke, amunyamuke, muzwe okuno. Mutaampi cintu niciba cimwi cisofweede. Amuzwe mulinguwo, musalale, inywe numubweza zibelesyo zya-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        },
        {
