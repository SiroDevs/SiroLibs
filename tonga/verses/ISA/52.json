        },
        {
          "text": "Amubone! Mulanda wangu uyoojana coolwe. Uyoosumpulwa, uyoolemekwa, uyooba mulemu loko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.13",
