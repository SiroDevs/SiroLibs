        },
        {
          "text": "Buka! Buka! Kolisamika inguzu, O Zioni. Sama zikobela zyako zyeebesi, O Jerusalemu, munzi uusalala, nkaambo tokooyoonjilwa limbi batapalwidwe abasofweede. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.7"
              },
              "items": [
                {
                  "text": "Zek 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kolitikumwida itombe lyaansi, ukabuke, Jerusalemu nowakali mubuzike, Angununa zyaanzyo zili kunsingo yako, mwana musimbi wa-Zioni nowakali mubuzike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
