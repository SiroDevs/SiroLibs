                "loc": "1PE.1.18"
              },
              "items": [
                {
                  "text": "1 Pet 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Jehova. Mwakauzigwa cintu cabuyo, nkabela teensi mali aati mununune. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Mwami Jehova. Bantu bangu bakataanguna kuya ku-Egepita kuyookalakala nkuko, abalo ba-Asuri bakabapenzya ciindi cimwi katakwe kaambo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.24"
              },
              "items": [
                {
                  "text": "Rom 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino ndaba anzi okuno? mbwaamba Jehova. Nkaambo bantu bangu batolwa buyo. Beendelezi babo balalila, mbwaamba Jehova, nkabela izina lyangu lilasampaulwa lyoonse mazuba oonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako bantu bangu bayooziba izina lyangu. Mubuzuba obo bayooziba kuti ndime uuamba makani aya, Mpendi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
