            }
          ]
        },
        {
          "text": "Pele mutazwi cakubindaana, muteendi cakucija pe, nkaambo Jehova nguuyoomuzulwida, a-Leza wa-Israyeli nguuyoomusindikila.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
