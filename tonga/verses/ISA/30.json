                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.23"
              },
              "items": [
                {
                  "text": "Ciy 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mumuni wamwezi uzooba mbubonya mbuli mumuni wazuba, amumuni wazuba uyoovuzigwa ziindi zili musanu azibili, ube mbuli mumuni wamazuba aali musanu aabili, mubuzuba obo Jehova naazooanga zyuumo zyabantu bakwe akusilika mabunda ngubayasidwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
