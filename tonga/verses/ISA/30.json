          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalo basune ambongolo zilima nyika ziyoolya malilu aalungidwe, aapupulwidwe acikombozyo acipupuluzyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela atala azilundu zyoonse zilamfu atulundu toonse tusumpwidwe ayooba tulonga amifolo yamaanzi mubuzuba obo bwabujayi bupati, maanda malamfu naazoowa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
        {
