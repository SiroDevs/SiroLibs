              },
              "items": [
                {
                  "text": "2 Tim 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maawe kubana bapapila! mbwaamba Jehova. Balalayigwa lulayo, pele taluzwi kulindime; balalivumbya cilivumbyo, pele taceensi ca-Muuya wangu; kuti baliyungizizye zibi atala lyazibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.1",
            "verseOrgIds": [
              "ISA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
