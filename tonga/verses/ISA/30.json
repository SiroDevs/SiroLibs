                  "text": "Hos 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaya makani aasinsimwa aabanyama ba-Negebi, Munyika yamapenzi ayamafwabi, mebajenwe balavu abasyuumbwa, munyingwe anzoka inkali iiuluka, balayumuna imbono zyabo amisana yambongolo, azintu zyabo ziyandisi balaziyumuna antunda zyankamele, bazitola kubantu batakonzya kubagwasya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.6",
            "verseOrgIds": [
              "ISA.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.7"
              },
              "items": [
                {
                  "text": "Jer 37:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lugwasyo lwa-Egepita ndwabuyo, talukwe milimo pe, Nciceeco ncindamuulikila izina lya-Rahabu uukede buyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.7",
            "verseOrgIds": [
              "ISA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.7",
            "verseOrgIds": [
              "ISA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino koya ukalembe acilembelo, ukagwale makani mubbuku, kuti kube ciibalusyo mumazuba aaciza mane kukabe kutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.8",
            "verseOrgIds": [
              "ISA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.20"
              },
              "items": [
                {
                  "text": "Dt 32:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbantu bapapila, bana babeja, bana bata yandi kuswiilila mulao wa-Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.9",
            "verseOrgIds": [
              "ISA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.11.21"
              },
              "items": [
                {
                  "text": "Jer 11:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.13"
              },
              "items": [
                {
                  "text": "1 Bam 22:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balaambila balunguluzi kuti, Mutalungululi Abasinsimi balabaambila kuti, Mutatusinsimini zyakutapatila, amutwaambile majwi matete akubona zilengano zyakweena-ena; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.10",
            "verseOrgIds": [
              "ISA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.8"
              },
              "items": [
                {
                  "text": "Inc 13:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amuleye kuzwa munzila, mutole mugwagwa umbi; mutatwaambili limbi makani aa-Uusalala wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.11",
            "verseOrgIds": [
              "ISA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako mbuboobu mbwaamba Uusalala wa-Israyeli, Mbuli mbumusampaula aya majwi, akubika myoyo yanu kulunyansyo akulupapilo akusyoma nzizyo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.12",
            "verseOrgIds": [
              "ISA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "lino oyu mulandu wanu uyooba mbuli lwaanzi luyanda kuwa; lulaboneka kujulu kubulambo, elyo kaba kaindi bulafwamba kuwa akumwaika ndilyonya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.13",
            "verseOrgIds": [
              "ISA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 30:14"
          },
          "items": [
