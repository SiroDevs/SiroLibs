              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.9"
              },
              "items": [
                {
                  "text": "Int 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.4"
              },
              "items": [
                {
                  "text": "2 Pet 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lumwayo lwabo luli mbuli lumwayo lwanongo yamubumbi; ilapwayigwa pwa akutafwidwa luzyalo, aboobo akati katupanzipanzi takujenwe niluba lukaye lwakubweza mulilo kuciko niluba lwakutesya maanzi kumukalo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.14",
            "verseOrgIds": [
              "ISA.30.14"
            ]
          }
        }
      ]
