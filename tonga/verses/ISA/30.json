          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba kuti Mwami wamwaabila insima yamapenzi amaanzi aakufwaba, Mwiyi wanu takooyooyuba limbi pe; meso aanu ayoobona Mwiyi wanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.20",
            "verseOrgIds": [
              "ISA.30.20"
            ]
          }
        },
