                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.2"
              },
              "items": [
                {
                  "text": "Jer 21:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Banyamuka kuya ku-Egepita, pele tabana kubuzya makani kumulomo wangu, Balayanda kuliyumya munguzu zya-Farao akusyoma cenzule ca-Egepita. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.2",
            "verseOrgIds": [
              "ISA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.5"
              },
              "items": [
                {
                  "text": "Jer 37:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino inguzu­ zya-Farao nzeziyoomuusya bweeme, akusyoma eenzule ca-Egepita nkokuyoomulwisya insoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.3",
            "verseOrgIds": [
              "ISA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekuba kuti basilutwe bakwe bali ku-Zoani, abatumwa bakwe basika aku-Hanesi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.4",
            "verseOrgIds": [
              "ISA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.36"
              },
              "items": [
                {
                  "text": "Jer 2:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "boonse balausa insoni nkaambo kabantu aba batakonzya kubagwasya. Tabagwasyi, tabakwe milimo, balausya bweeme buyo akuleta lusampauko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.5",
            "verseOrgIds": [
              "ISA.30.5"
            ]
          }
        }
      ]
    },
