                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.18"
              },
              "items": [
                {
                  "text": "34:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Mulemu Uusumpwidwe uukede mubwami butamani, izina lyakwe ngu-Uusalala. Ndikede mubusena busalalisya busumpwidwe, pele mubombumoyo uupengede alakwe ndikede awe. Ndime uubusya muuya wamuntu uubombede akukatalusya moyo wayooyo uupengede. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 57:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.38"
              },
              "items": [
                {
                  "text": "Int 78:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
