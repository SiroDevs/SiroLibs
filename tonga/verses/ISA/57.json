              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.18"
              },
              "items": [
                {
                  "text": "Mik 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.9"
              },
              "items": [
                {
                  "text": "Heb 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nsikooyookazyanya lyoonse, nisikooyookalala akutamani pe, nkaambo buumi bwazwa kulindime, alimwi ndime iwakalenga kuyooya kwabuumi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 57:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.31"
              },
              "items": [
                {
                  "text": "Ezk 33:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakakalala nkaambo kamulandu wakulikumbuzya kwakwe, elyo ndakamuuma, ndasisa busyu bwangu, ndakalala. Nkabela wakacili kweenda cakukataazya munzila njiwakayanda moyo wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 57:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.73.24"
              },
              "items": [
                {
                  "text": "Int 73:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndibwene inzila zyakwe, pele njoomuponya. Njoomweenzya akumuboozezya luumuno, abalo basikulila bakwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.18",
            "verseOrgIds": [
              "ISA.57.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 57:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.15"
              },
              "items": [
                {
                  "text": "Heb 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.39"
              },
              "items": [
                {
                  "text": "Inc 2:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.17"
              },
              "items": [
                {
                  "text": "Ef 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "njoobalengela micelo yakulumba. Boonse bayoojana luumuno, nibaba bali kule nibaba bali kufwaafwi, mbwaamba Jehova. Njoomuponya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 57:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele bantu basizibi bali mbuli maanzi aalwizi aayuwana, nkaambo taakonzyi kuumuna pe, pele lyoonse alaya bulivundaanya matope amatombe. ",
          "type": "text",
          "attrs": {
