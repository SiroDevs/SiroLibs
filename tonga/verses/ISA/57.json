        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu baluleme balanyonyooka, pele taakwe muntu uubika moyo wakwe. Bantu basiluzyalo balatolwa, pele taakwe muntu uumvwisya. Nkaambo muntu uululeme ulatolwa kuzwa kububi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "elyo ulanjila muluumuno. Balalyookezya mumalo aabo, abo beenda mubululami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
