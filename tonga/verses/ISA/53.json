                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele wakayaswa nkaambo kamilandu yesu, wakaumwa nkaambo kazibi zyesu. Kutugwasya iswe nciceeco ncaakakwabbawidwa, amibunda yakwe niiituponya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
