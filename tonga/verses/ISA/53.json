              "items": [
                {
                  "text": "1 Pet 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Toonse twapambuka mbuli imbelele ziswekede, twatola umwi aumwi inzila njayanda mwini, lino Jehova walemezya nguwe milandu yesu toonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
