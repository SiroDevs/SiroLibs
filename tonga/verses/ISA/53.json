                  "text": "Dan 9:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakakasigwa kubetekwa kabotu, aboobo wakatolwa. Nguni akati kabasanyina wakabika moyo wakwe kumakani aya aakuti, naakagwisigwa munyika yabaumi njimilandu yabantu bangu njaakauminwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
