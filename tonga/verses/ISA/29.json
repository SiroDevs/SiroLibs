              "items": [
                {
                  "text": "Ciy 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino cilengano coonse camubeda mbuli majwi aabbuku linamatikidwe. Bapa muntu uuiyide, bati, Kobala, pele ulavuwa kuti, Nsikonzyi kubala pe nkaambo lilinamatikidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi bapa muntu uutaiyide ibbuku, bati, Kobala, pele ulavuwa kuti, Nsicibwene kubala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
