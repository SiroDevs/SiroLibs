              "items": [
                {
                  "text": "Rom 11:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo Jehova wamutilila muuya waŋonzi, Wamufwinya kumeso nubasinsimi, anywebo nubasicilengano wamuvumba kumitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        },
        {
