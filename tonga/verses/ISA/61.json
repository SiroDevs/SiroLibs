                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "Kul 19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pele inywe muyooambwa kuti bapaizi ba-Jehova, muyooambwa kuti basimilimo ba-Leza wesu. Muyoolya imbono zyabamasi akulikankaizya mubulemu bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        },
        {
