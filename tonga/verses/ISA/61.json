              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.3"
              },
              "items": [
                {
                  "text": "Is 55:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mebo nde-Jehova ndayandisya lubeta lubotu, ndasula kubba abubi. Njoobapa bulumbu bwabo cakusyomeka akutangana abo cizuminano citamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 61:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunyungu lwabo luyoozibwa akati kabamasi, abana babo akati kamisyobo yabantu. Boonse bababona bayoozumina kuti ncobeni ndunyungu Jehova ndwaakalongezya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
