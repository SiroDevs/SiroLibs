            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.12"
              },
              "items": [
                {
                  "text": "Zek 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mucibaka cansoni yanu muyooba acaabilo acimwi cabili. Mucibaka cakufwa bweeme bayoosekelela lukono lwabo, Munyika yabo beni bayoovuba caabilo acimwi cabili, nkabela bayooba alukondo lutamani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
