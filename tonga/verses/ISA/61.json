              "items": [
                {
                  "text": "Is 60:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbubonya mbuli nyika mbwiisyuusya insyuuko zyayo, ambuli muunda mbuumeneka zibyedwe mulinguwo, mbubonya obo Mwami Jehova uyoomeneka bululami alutembaulo kumeso aamasi oonse.",
          "type": "text",
