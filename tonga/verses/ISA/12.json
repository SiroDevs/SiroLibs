                }
              ]
            }
          ]
        },
        {
          "text": "Lino mubuzuba obo uyooamba kuti, Nkatembaule Jehova, Nekuba kuti wakandikalalila, bukali bwako bwamana, wandifwida luzyalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
