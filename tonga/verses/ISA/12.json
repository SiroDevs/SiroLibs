                  "text": "Int 118:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ncobeni Leza ndufutuko lwangu. Njoosyoma akutayoowa, nkaambo Mwami Jehova ninguzu zyangu, ndolwiimbo lwangu, lino waba lufutuko lwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
