              "type": "tag",
              "attrs": {
                "loc": "HOS.5.15"
              },
              "items": [
                {
                  "text": "Hos 5:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O Jehova, mumapenzi aabo balibikide myoyo yabo kulinduwe. Baka-kukomba ciindi eco niwakali kubakoma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.16",
            "verseOrgIds": [
              "ISA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuli mwanakazi uuminsi uuli kufwaafwi kutumbuka mbwaamvwa inzunto, alimwi ulalila mukuciswa kwakwe, mbubonya obo mbutwakabede kumeso aako, O Jehova. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.17.14"
              },
              "items": [
                {
                  "text": "Int 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twakaminta, twakamvwa inzunto, pele ncitwatumbuka muuwo buyo. Tatuna kucita buvuni ansi, abantu bakede munyika tabana kuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        },
