              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Mwami Jehova wamakamu ulagonka mitabi cakuyoosya. Balamfu ciimo balagonkwa; basumpwidwe balafwiinsigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
              "ISA.10.33"
            ]
          }
        },
        {
          "name": "verse",
