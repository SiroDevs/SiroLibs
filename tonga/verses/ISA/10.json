                "loc": "ZEP.2.13+ZEP.2.14+ZEP.2.15"
              },
              "items": [
                {
                  "text": "Zef 2:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Webo mu-Asuri! Nduwe inkoli yabukali bwangu. Musako wamujanza lyako ndolunyemo lwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.5",
            "verseOrgIds": [
              "ISA.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njoomutuma kukulwisya cisi citalemeka. Njoomulailila mbwaelede kucitila bantu mbundikalalila, kuti asaale lusaalo akunyanzya lunyanzyo akubalyataula mbuli intimba yamumigwagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.6",
            "verseOrgIds": [
              "ISA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.12"
              },
              "items": [
                {
                  "text": "Mik 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele walo tayeeyi obo pe. Moyo wakwe tuukanzi obo. Nkaambo mumoyo wakwe ulayeeya kunyonyoona bantu akumana zisi zinji loko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.7",
            "verseOrgIds": [
              "ISA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.24"
              },
              "items": [
                {
                  "text": "2 Bam 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulaamba kuti, Basilutwe bangu sa tabali bami? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.8",
            "verseOrgIds": [
              "ISA.10.8"
            ]
          }
        },
