              "items": [
                {
                  "text": "1 Sam 25:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ongolozya ijwi lyako, O Mwana musimbi wa-Galimu! Koswiilila, O Laisi! Komuvwiila, O Anatotu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.30",
