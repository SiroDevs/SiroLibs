              "items": [
                {
                  "text": "1 Sam 21:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buzuba obuno ulaima ku-Nobi. Ulazungaanya ijanza lyakwe kumwana musimbi waZiyoni, cilundu caku-Jerusalemu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.32",
