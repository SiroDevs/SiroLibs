            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako Mwami Jehova wamakamu uyootuma bulwazi bwakukotezya baneneede bakwe, alimwi kunsi lyabulemu bwakwe kuyooyaka kuyaka mbuli kuyaka kwamulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.16",
            "verseOrgIds": [
              "ISA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuni wa-Israyeli uyooba mulilo, alakwe Musalazi wakwe uyooba mabangabanga. Uyooyaka akutenta mamvwa aakwe amitubetube yakwe mubuzuba bomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.17",
            "verseOrgIds": [
              "ISA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyoomaninina bulemu bwalusaka lwakwe abwamuunda wakwe wambolezi. Mubili amuuya woonse, zyoonse ziyootentwa. Kuyooba mbuli sikuyumuna citondezyo naawizuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.18",
            "verseOrgIds": [
              "ISA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela misamu iisyeede mulusaka lwakwe iyooba mice buyo; mwana uyookonzya kumana kwiilemba yoonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
          }
        }
      ]
    },
