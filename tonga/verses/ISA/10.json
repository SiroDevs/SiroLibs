                "loc": "LUK.19.44"
              },
              "items": [
                {
                  "text": "Lk 19:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ino muyoocitanzi mubuzuba bwakuswayigwa, mapenzi naazoosika kuzwa kule? Muyoocijila kulini kuti mugwasigwe? Ambono zyanu muyoozisia kuli? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.3",
            "verseOrgIds": [
              "ISA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyookotama buyo kunsi lyabaabo bajatwa, muyoowa kunsi lyabaabo bajayidwe. Aya makani oonse aba, nekubaboobo bukali bwakwe tabuna kumana, ijanza lyakwe licitandabikidwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.4",
            "verseOrgIds": [
              "ISA.10.4"
            ]
          }
        }
      ]
    },
