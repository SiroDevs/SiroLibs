          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulagonka butale zisaka zyamusokwe, nkabela Lebanoni ulawa mbuli mbwawa singuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.34",
            "verseOrgIds": [
