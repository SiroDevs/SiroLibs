          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo mubuzuba obo, ba-Israyeli basyeede abaabo baluzubo lwa-Jakobo balobokede tabakooyoosyoma limbi oyo iwakabauma. Bayoosyoma ncobeni Jehova Uusalala wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.20",
            "verseOrgIds": [
              "ISA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulapiluka bamwi basyeede, bana baJakobo basyeede, kuli-Leza Singuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.21",
            "verseOrgIds": [
              "ISA.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.3"
              },
              "items": [
                {
                  "text": "Mik 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Rom 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo bantu bako, O Israyeli, nekuba kuti bavulisya mbuli musenga wakunkomwe yalwizi, kuyoopiluka bamwi buyo basyeede. Bulwazi bwakumaninizya bwakosoka, Makani alapazya bululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.22",
            "verseOrgIds": [
              "ISA.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.22"
              },
              "items": [
                {
                  "text": "Is 28:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo kuyooba mamanino aakosokede. Mwami Jehova wamakamu uyooacita akati kanyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        }
      ]
    },
    {
