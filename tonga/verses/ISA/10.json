              "items": [
                {
                  "text": "Jos 15:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Madimena waloboka. Bantu bakede mu-Gebimu balibamba kucija. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.31",
            "verseOrgIds": [
              "ISA.10.31"
            ]
