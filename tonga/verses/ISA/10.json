              "type": "text"
            }
          ]
        },
        {
          "text": "Bona! Wasika ku-Aiati. Wainda ku-Migroni. Ku-Mikimasi ulatula mikuli yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.28",
