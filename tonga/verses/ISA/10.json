                "loc": "2KI.16.9"
              },
              "items": [
                {
                  "text": "2 Bam 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sa Kalino tuuli mbuli Karikemesi? Sa Hamati tuuli mbuli Aripadi? Sa Samariya tuuli mbuli Damasko? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.9",
            "verseOrgIds": [
              "ISA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijanza lyangu lyatana akuzisi zyamituni izyakajisi zikozyano kwiinda Jerusalemu a-Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.10",
            "verseOrgIds": [
              "ISA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino sa nsikooyoocitila Jerusalemu azikozyano zyawo mbubonya mbuli mbundakacitila Samariya azikozyano zyawo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.11",
            "verseOrgIds": [
              "ISA.10.11"
            ]
          }
        }
      ]
    },
    {
