        },
        {
          "text": "Maawe kulibaabo bakosola makani aataluleme, abalembi balemba zyakupenzya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.1",
            "verseOrgIds": [
              "ISA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti bakasye batengwana kubetekelwa kabotu akunyanzya bacete babantu bangu imbeta zyabo zyeelede, kuti basaale bamukabafu akunyanzya imbono zyabamusyaala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.2",
            "verseOrgIds": [
              "ISA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
