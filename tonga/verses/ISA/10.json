              "ISA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino Mwami naazoomaninina milimo yakwe yoonse mucilundu caZiyoni amu-Jerusalemu, uyoobweedezya moyo uusumpwidwe wamwami wa-Asuri bulumbu bweelede akubonzya bulemu bwakulikankaizya kwameso aakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.9"
              },
              "items": [
                {
                  "text": "Kul 15:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.20.7"
              },
              "items": [
                {
                  "text": "Int 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.24"
              },
              "items": [
                {
                  "text": "Is 37:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo wakati, Ncendacita ndacicita kunguzu zyajanza lyangu akubusongo bwangu, nkaambo ndicenjede, Ndasandula minyinza yamisyobo yabantu, azyalo imbono zyabo ndazisaala. Mbundi singuzu ndafwiinsya abo ibakakede azyuuno zyabwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijanza lyangu lyakajana buvubi bwabantu mbuli citeente camuyuni mbucijanwa. Mbubonya mbuli muntu mbwabunganya mai aasiidwe, mbuboobo mbundakabunganya nyika yoonse. Katakwe naba omwe iwakaputya ibbaba nanka kwaasama amulomo nanka kulila nsiyonsiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.14",
            "verseOrgIds": [
              "ISA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.20"
              },
              "items": [
                {
                  "text": "Jer 51:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.20"
              },
              "items": [
                {
                  "text": "Rom 9:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma! Sa kaleba kalakonzya kulikankaizya kuliyooyo uukatebbya? Sa isaha lilalisumpula kuliyooyo uulibelesya? Sa inkoli ilalyuumya oyo uuibwezede? Na musako sa ulabweza muumi uutali cisamu buyo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.15",
            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        }
      ]
    },
