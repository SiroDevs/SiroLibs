            "number": "3",
            "style": "v",
            "sid": "ISA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wavuzya bantu bacisi, wabayungizizya busekelezi. Balasekelela kuhusyu bwako mbubonya mbubasekelela basikutebula, mbuli mbubakondwa bantu baabana lusaalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
