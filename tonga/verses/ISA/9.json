          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.3"
              },
              "items": [
                {
                  "text": "Jer 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu tabana kupiluka kuliyooyo iwakabauma, tabana kubika myoyo yabo kuli-Jehova wamakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.13",
            "verseOrgIds": [
              "ISA.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako Jehova uyoogonkela cisi ca-Israyeli mutwe amucila woonse, tukunka amatete oonse, mubuzuba bomwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.14",
            "verseOrgIds": [
              "ISA.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munene amulemu, ngonguwe mutwe; amusinsimi uuiisya zyakubeja, ngonguwe mucila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.15",
            "verseOrgIds": [
              "ISA.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basikweenzya bantu aba balabaleesya munzila imbi; abaabo baenzegwa banyonyooka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.16",
            "verseOrgIds": [
              "ISA.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo kako Mwami takooyookondelwa bakubusi babo, abalo bamusyaala babo abamukabafu babo takooyoobafwida luse, nkaambo boonse buyo mbasicinguni, balacita zibi, ayalo milomo yoonse ilaamba bufubafuba, Aya makani oonse aba, nekubaboobo bukali bwakwe tabuna kumana, ijanza lyakwe licitandabikidwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.17",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        }
      ]
    },
