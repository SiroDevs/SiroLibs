        {
          "text": "Bantu ibakeenda mumudima babona mumuni mupati, Abo ibakakede munyika yalufu iisia mbi bapasukilwa mumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
