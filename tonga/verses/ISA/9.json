            }
          ]
        },
        {
          "text": "Nkaambo ijoko lyamukuli wakwe amusako wakucifunzi cakwe ankoli yayooyo iwakamupenzya, zyoonse wazipwaya mbuli mubuzuba bwakuzundwa kwa-Midyani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo insangu zyoonse zyabasilumamba ziya bundindima munkondo, azyakusama zyoonse zikandidwe mubulowa, zyoonse buyo ziyooba zyakutenta, ziyooba inkuni zyamulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        },
