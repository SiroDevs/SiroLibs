                  "text": "Job 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuti babone akuziba akubika myoyo yabo kumakani, bamvwisye boonse kuti ijanza lya-Jehova ndelyakacita obo, Uusalala wa-Israyeli nguwakazilenga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        }
      ]
