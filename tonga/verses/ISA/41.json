              },
              "items": [
                {
                  "text": "Jak 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele uwe, O Israyeli mulanda wangu, Jakobo ngonsalide, lunyungu lwaAbrahamu muzolwani wangu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.8",
            "verseOrgIds": [
              "ISA.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwe ngundakajata kuzwa kumagolelo aanyika, ngundakaita kuzwa kuzyooko zyayo, akukwaambila kuti, Nduwe mulanda wangu, ndakusala, nsikutandide pe, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.9",
            "verseOrgIds": [
              "ISA.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.6"
              },
              "items": [
                {
                  "text": "Dt 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.31"
              },
              "items": [
                {
                  "text": "Rom 8:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utayoowi, nkaambo ndili ayebo. Utakankami, nkaambo ndime Leza wako. Njookuyumya, njookugwasya, ncobeni njookutabilila ajanza lyalulyo lyabululami bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.10",
            "verseOrgIds": [
              "ISA.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.22"
              },
              "items": [
                {
                  "text": "Kul 23:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.3"
              },
              "items": [
                {
                  "text": "Zek 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bona! Boonse bakukalalila bayoofwa insoni, bayoousigwa bweeme. Abo bakubusizya inkondo bayooba cintu buyo, bayoonyonyooka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.11",
            "verseOrgIds": [
              "ISA.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo basikwaambana ayebo, uyoobayandaula akutabajana. Boonse basinkondonyoko bayooloba, bayooba cintu buyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.12",
            "verseOrgIds": [
              "ISA.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mebo nde-Jehova njookujata kujanza lyalulyo, njookwaambila kuti, Utayoowi, ndime sikugwasya wako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.13",
            "verseOrgIds": [
              "ISA.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.19.25"
              },
              "items": [
                {
                  "text": "Job 19:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utayoowi O ciyokansi Jakobo, anywebo nubantu ba-Israyeli. Nookugwasya, mbwaamba Jehova a-Munununi wako Uusalala wa-Israyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.14",
            "verseOrgIds": [
              "ISA.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.13"
              },
              "items": [
                {
                  "text": "Mik 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.4"
              },
              "items": [
                {
                  "text": "2 Kor 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bona! Ndakubika kuti ube cipozyo cibosya cipya cijisi meno, lino uyoopola zilundu akuzipwayaula, atwalo tulundulundu uyootuvwimbaula mbuli buungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.15",
            "verseOrgIds": [
              "ISA.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.2"
              },
              "items": [
                {
                  "text": "Jer 51:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uyoozimwaya, elyo muuwo uyoozitola, akale kambizi kayoozimwaisya. Lino uyoosekelela muli-Jehova akutembaula Uusalala wa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.16",
            "verseOrgIds": [
              "ISA.41.16"
            ]
          }
        }
      ]
    },
    {
