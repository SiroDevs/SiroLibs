              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
            "verseOrgIds": [
              "ISA.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubambe makani aanu, mbwaamba Jehova. Amulete bukamboni bwanu, mbwaamba mwami wa-Jakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.21",
            "verseOrgIds": [
              "ISA.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balete makani, batulwiide zintu ziyooboneka. Amutulwiide makani aakainda, tuzibe mbwaabede, kuti tubike myoyo yesu kulingao, tuzibe makani aaciza. Na makani aaciza, amutulungulwide ngao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.22"
              },
              "items": [
                {
                  "text": "Dt 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.5"
              },
              "items": [
                {
                  "text": "Jer 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amutulwiide makani aacili kunembo, kuti tuzibe kuti muli ba-Leza. Amucite makani naaba mabotu naaba mabi, kuti twaabone akugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma! Muli zintu buyo, amilimo yanu tiikwe makani. Kufumbwa muntu uumusala ulasesemya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
            "verseOrgIds": [
              "ISA.41.24"
            ]
          }
        }
      ]
    },
