        },
        {
          "text": "Mubuzuba obo muunda mubotu wamasaansa muyoouimbila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
