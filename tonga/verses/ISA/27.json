                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cita ajate inguzu zyangu kuti tuyanzane awe. Ncobeni atuyanzane awe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
