        {
          "text": "Sa wabauma mbubonya mbwaakauma basikubauma? Sa balijayidwe mbubonya mbuli basikubajaya mbubakajayigwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
