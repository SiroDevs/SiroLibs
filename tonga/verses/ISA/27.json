                "loc": "ISA.17.2"
              },
              "items": [
                {
                  "text": "Is 17:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo munzi uuzyungulukidwe lubaya ulisaalidwe, waba matongo, walekwa, wabula bantu mbubonya mbuli inkanda. Nkukooko nkubacela boombe, nkukooko nkubalalalala akulya matu aawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
