            "number": "3",
            "style": "v",
            "sid": "ISA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mebo nde-Jehova ndaulanga, ndautuntulwida lyoonse. Ndaulanga masiku asikati kuti kutabi uubisizya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.6"
              },
              "items": [
                {
                  "text": "2 Sam 23:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nsikwe bukali. Nicakabota myuunga amitubetube niyakabikwa kuti indilwisye. Nindakailyataula, akwiiumpa yoonse antoomwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        },
        {
