                "loc": "1CO.10.13"
              },
              "items": [
                {
                  "text": "1 Kor 10:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kutanda wakamutanda, wakakazyanya awe, Wamutandya kuunga kwakwe mubuzuba bwamuuwo wakujwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino ncinzi cikonzya kumanya milandu ya-Jakobo? Ncinzi cikonzya kugwisya zibi zyakwe? Cita ataangune kusowa mabwe oonse aacipaililo mbuli mulambo uupwayawidwe kuti zikozyano zya-Aseri azikozyano zyazuba zitabuki limbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
