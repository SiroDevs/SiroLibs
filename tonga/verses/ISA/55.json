                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amuyandaule Jehova naacijanika. Amumukwiilile naacili afwiifwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
