              "ISA.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu Jehova mbwaandaambila. Mulavu naavuluma, asyuumbwa naandondoma mukulya kwakwe, nekuba kuti beembeli banji loko baitwa kukumulwisya, takonzyi kuyoowa ijwi lyabo nikuba kulibombya nkaambo kakuyobayoba kwabo. Mbubonya obo Jehova wamakamu uyooseluka kuzoolwisya atala lyacilundu ca-Zioni atulundu twaco. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.11"
              },
              "items": [
                {
                  "text": "Dt 32:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.4"
              },
              "items": [
                {
                  "text": "Int 91:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbuli tuyuni tuuluka-uluka, Jehova wamakamu uyoovuna Jerusalemu. Uyooutabilila akuuvuna, uyooufwida luse akuufutula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
