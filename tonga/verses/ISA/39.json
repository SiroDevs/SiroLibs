                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abalo bana bako bazyalwa kulinduwe, bayootolwa kuti bakabe bazike muŋanda yabwami yamwami wa-­Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
