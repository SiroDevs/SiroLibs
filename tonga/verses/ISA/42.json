              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile nubasinkematwi. Amulange nuboofu kuti mubone. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
