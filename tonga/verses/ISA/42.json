        {
          "text": "Ngooyu mulanda wangu nguntabilila, musale wangu moyo wangu nguukondelwa. Ndabika Muuya wangu alinguwe, kuti aletele bamasi lubeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takooyoongolola nikuba kulizya ijwi lyakwe. Ijwi lyakwe talikooyoomvwigwa mumugwagwa pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itete lifuyukide takooyoolityola, akamuni kasuka takooyookazimya. Uyooleta lubeta cakusyomeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.2"
              },
              "items": [
                {
                  "text": "Heb 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.10"
              },
              "items": [
                {
                  "text": "Matl 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Takooyooceelwa mumuni nikuba kutyolwa, mane akabike lubeta mukati kanyika, Azyalo nyika zyakunkomwe yalwizi ziyoolindila mulao wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
