                "loc": "ISA.1.3"
              },
              "items": [
                {
                  "text": "Is 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.21"
              },
              "items": [
                {
                  "text": "Rom 2:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulabona zintu zinji pele tobiki moyo wako kulinzizyo. Matwi aakwe alisinkukide pele taswiilili. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova wakakondwa nkaambo kabululami bwakwe, aboobo uyoolemeka mulao, utembaulike ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pele oyu musyobo wabantu, balisaalidwe, balipenzedwe. Boonse balicedwe mumalindi, baliyubide muntolongo. Basaalwa, elyo taakwe uubavuna. Balanyanzigwa imbono, nkabela taakwe uuamba kuti, Amuzipilusye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguni akati kanu uuzumina kuswiilila aya makani? Nguni uuzumina kumvwisya, ateelele makani aaciindi ciza? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguni wakaaba Jakobo kuti asaalwe? Nguni wakaaba ba-Israyeli mumaanza aabasikubba? Sa teensi Jehova? Sa teensi oyo nguwenya ngutwabisizya, ngutwakakakila inzila zyakwe, ngutwakakaka kuswiilila mulao wakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
