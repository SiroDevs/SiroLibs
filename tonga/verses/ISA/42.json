        },
        {
          "text": "ubononosye meso aaboofu, uvune baange muntolongo, ugwisye abo bakede mumudima muŋanda yabuzike. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
