                  "text": "107:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwiimbile Jehova lwiimbo lupya. Amumutembaule kuzwa kumagolelo aanyika. Lwizi luvuume azyoonse zili mulindulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igundu aminzi yalyo iongolole, minzi iikalwa ba-Kedari. Bantu bakede ku-Sela baimbe cakukondwa, baongolole kuzwa kumitwe yazilundu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bape Jehova bulemu, bamutembaule munyika yakunkomwe yalwizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova uyooinka mbuli mwaalumi sintaze, uyoobusya busungu mbuli silumamba. Uyookwiila akuvuluma, uyoolwisya basinkondonyina canguzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakalyuumwide ciindi cilamfu. Ndakalitontwede akulyaanga. Pele sunu ndalila mbuli mwanakazi uumyongwa. Ndafooma akufwekemba loko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njooyuminizya zilundu atulundulundu, njoopusamya misamu yazyo yoonse. Njoocita kuti milonga ibe nyika injumu, amaziba oonse njooayuminizya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela njooenzya boofu munzila njibatezi, njoobatola mumigwagwa njebatabwene, Njoosandula mudima kunembo lyabo ube mumuni, amasena aapilingene njooalulamika. Ngaaya makani ngenti cite, nkabela nsikooyoobalekelezya pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayoopilusigwa kusule, bayoousa insoni boonse basyoma mituni, baambila zikozyano zifulidwe kuti, Ndinywe ba-Leza besu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
