              "items": [
                {
                  "text": "Ezk 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.49"
              },
              "items": [
                {
                  "text": "Joh 7:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nguni moofu cita mulanda wangu? Nguni musinkematwi mbuli mutumwa wangu ngundatuma? Nguni moofu mbuli similimo wangu? Nguni moofu mbuli mulanda wa-Jehova? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
