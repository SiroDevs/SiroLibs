                  "text": "Is 48:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime Jehova. Ndezina lyangu. Bulemu bwangu nsikooyoobupa umbi, akulemekwa kwangu nsikooyookupa zikozyano zifulidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubone! Makani aaciindi amana kale. Ndamulwiida makani mapya. Naatana kuboneka, ndamwaambila ngao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
