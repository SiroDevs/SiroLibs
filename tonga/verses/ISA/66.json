          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukondwe a-Jerusalemu, amumusekelele, nyoonse nemumuyanda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
