                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo mbuboobu mbwaamba Jehova. Njoomuvuzizya luumuno mbuli mulonga, abuvubi bwabamasi buyoomubeda mbuli kalonga kapaya, elyo muyoonyonka, muyoobbalwa asolo akusumpaulwa amazwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbubonya mbuli muntu banyina ngubaumbulizya, ambebo njoomuumbulizya, nkabela muyooumbulizigwa mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.1"
              },
              "items": [
                {
                  "text": "Ezk 37:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lino muyoobona, nkabela myoyo yanu iyookondwa, azyalo zifuwa zyanu ziyoojata inguzu mbuli mweemvwe. Kuyoozibwa kuti ijanza lya-Jehova ndeligwasya balanda bakwe, pele basinkondonyina ulabakalalila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.5"
              },
              "items": [
                {
                  "text": "Is 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.8"
              },
              "items": [
                {
                  "text": "2 Tes 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo amubone! Jehova uyoosika amulilo, ankalaki zyakwe ziyooba mbuli kambizi, kuti bukali bwakwe bubuke canguzu, atapatile bantu amabangabanga aamulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        },
