                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.9"
              },
              "items": [
                {
                  "text": "1 Kor 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuzwa kalekale bantu tabanamvwide nikuba kuswiilila, aalo meso aabantu taana kubona, Leza umbi uucita mbocita yebo, uubelekela abo bamulindila. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.35"
              },
              "items": [
                {
                  "text": "Inc 10:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.6"
              },
              "items": [
                {
                  "text": "Mal 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ulaswanaana ayooyo uubotelwa kucita bululami abaabo bakuyeeya munzila zyabo, Ncobeni wakakalala nitwakabisya. Muzibi zyesu motwakalilila ciindi cilamfu, lino tufutulwe buti? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.9"
              },
              "items": [
                {
                  "text": "Flp 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Toonse twaba mbuli uusofweede. Incito zyesu ziluleme zyoonse zyaba mbuli cisani cisofweede cinunka nsu. Toonse tulapusama mbuli matu, amilandu yesu ilatutola mbuli muuwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.7.7"
              },
              "items": [
                {
                  "text": "Hos 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taakwe uukwiilila izina lyako, uulibusya kuti akujate, pe. Nkaambo watusisila busyu bwako, watwaaba mumaanza aamilandu yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.6"
              },
              "items": [
                {
                  "text": "Jer 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.10"
              },
              "items": [
                {
                  "text": "Ef 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele nduwe tateesu, O Jehova, Ndiswe bulongo, nduwe mubumbi wesu. Toonse tuli zilenge zyamaanza aako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utakalali loko, O Jehova; utayeeyi milandu yesu lyoonse akutamani. Langa, utuyeeye, nkaambo tuli bantu bako toonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minzi yako iisalala yaba inkanda buyo; Zioni waba inkanda, a-Jerusalemu waba matongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.9"
              },
              "items": [
                {
                  "text": "2 Bam 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.7"
              },
              "items": [
                {
                  "text": "Int 74:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.24.21"
              },
              "items": [
                {
                  "text": "Ezk 24:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iŋanda yesu iisalala injebesi, batateesu mubakali kukutembwiida, yapya mumulilo, amasena esu aayandika oonse aba matongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa ulakonzya kulikasya kucita cintu nobona makani aali obo, O Jehova? Sa ulakonzya kuumuna buyo akutupenzya loko?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.12"
            ]
          }
        }
      ]
    }
