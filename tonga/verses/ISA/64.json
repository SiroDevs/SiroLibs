      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nicakabota niwakaandula ijulu akuseluka ansi. Zilundu nizyakakankama kubusyu bwako! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwakaba mbubonya mbuli tukuni nitutentwa mumulilo, na mbuli maanzi naaselauka aciko, kuti izina lyako lizibwe kulibasinkondonyoko, kuti bamasi bakankame kubusyu bwako! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowakacita zintu ziyoosya nzitwatakali kulangila, wakaseluka, nkabela zilundu zyakakankama kunembo lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
