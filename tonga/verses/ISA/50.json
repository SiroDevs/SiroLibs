              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasamika ijulu cikobela cisia mbi akulivumbya zisani zyamasaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
