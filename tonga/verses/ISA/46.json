                "loc": "TIT.1.2"
              },
              "items": [
                {
                  "text": "Tit 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Njooita muyuni mukali kuzwa kujwe, sinkuta wangu kuzwa kucisi cili kule. Ndaamba kale makani, lino njooazuzikizya. Ndikanzide, lino njoocita obo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
