                "loc": "DEU.32.7"
              },
              "items": [
                {
                  "text": "Dt 32:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amwiingasile makani mataanzi aakalekale, nkaambo ndime Leza, taakwe umbi. Ndime Leza, taakwe ngutweelene awe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        },
        {
