                  "text": "Heb 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndime uulungulula makani aamamanino nikuba kuzwa kumatalikilo, uumulwiida makani naatana kuba. Ndati, Lulayo lwangu luyoozuzikizigwa, njoocita zyoonse nzinjanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        },
        {
