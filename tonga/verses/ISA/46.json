                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amundiswiilile O luzubo lwa-Jakobo, aboonse bamukowa wa-Israyeli basyeede, bayumwidwe ndime kuzwa kumala, babbedwe kuzwa kuzyalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
