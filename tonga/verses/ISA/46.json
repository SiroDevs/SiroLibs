                  "text": "Rom 10:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amundiswiilile nubayumu myoyo bali kule kuzwa kubululami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
