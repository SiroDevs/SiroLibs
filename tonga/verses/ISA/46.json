                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Beli wakotama! Nebo wafuuntila! Zikozyano zyabo zili amisana yabanyama ayaŋombe. Zintu nzimubwezede zyaba mikuli iilemena banyama bakateede. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafuuntila, bakorama boonse antoomwe. Bakakacilwa kuvuna mukuli. Balo beni baya mubuzike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
