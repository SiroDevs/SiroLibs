        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino amuswiilile majwi aa-Jehova nubantu basampaula, inywe numweendelezya bantu aba bakede mu-Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.14",
            "verseOrgIds": [
              "ISA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaamba kuti, Tulitangene cizuminano alufu, acikalilo cabafu twaswiilizyanya aco; mitatula yakukoma yainda, tiikooyoosika kulindiswe pe, nkaambo twabika zyakubeja zibe macijilo esu, amulweeno motuyubide. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.15",
            "verseOrgIds": [
              "ISA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 28:16"
          },
          "items": [
