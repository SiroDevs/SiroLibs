              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuswiilile, mumvwe ijwi lyangu. Amubike myoyo yanu, mumvwe majwi aangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.23",
            "verseOrgIds": [
              "ISA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa mulimi ulalima buzuba boonse kuti abyale? Sa ciindi coonse uli mukusya akupwayaula makankala aakwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.24",
            "verseOrgIds": [
              "ISA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amana kubambasika, sa taminzi imbuto zyakezahi akumwaya imbuto zyakumini? Sa tabyali bulotwe mumifolo yabo abbaale mumitundulu amaila kumagolelo aamuunda? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.25",
            "verseOrgIds": [
              "ISA.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulibwene mbukweelede kucitwa, nkaambo Leza wakwe ngumwiiyisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.26",
            "verseOrgIds": [
              "ISA.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo cisyu cakezali tacipolwi acipozyo, acisyu cakumini tacipwandwi ivwili lyaŋola pe. Kezahi cilaumisigwa cisamu, akumini cilaumisigwa musako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.27",
            "verseOrgIds": [
              "ISA.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa bulotwe bulapwayigwa? Muntu tabulyatauli cakutaleka pe. Amana kwiinzya mavwili aaŋola yakwe amabbiza aakwe, tapwayauli limbi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.28",
            "verseOrgIds": [
              "ISA.28.28"
            ]
          }
        },
        {
