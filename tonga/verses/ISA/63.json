                }
              ]
            }
          ]
        },
        {
          "text": "Bantu bako basalala bakavuba cikombelo cako kaindi kaniini buyo, lino basinkondoma besu bacilyataula. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.18",
