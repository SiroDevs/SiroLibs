                  "text": "Mt 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambonzi notuleesya kuzwa kunzila zyako, O Jehova? Nkaambonzi noyumya myoyo yesu kuti tutakuyoowi? Boola kuzoogwasya balanda bako, misyobo yabantu mbovubide. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.17",
