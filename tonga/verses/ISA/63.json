              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakanane milimo yaluzyalo njaakacita Jehova, nkatembaule Jehova nkaambo kacoolwe coonse ncatupede abubotu bwakwe bugambya kuluzubo lwa-Israyeli, buuya bwakwe mbwatufwida aluzyalo lwakwe lugambya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaamba kuti, Ncobeni mbantu bangu, bana bangu batakonzya kundeena, aboobo wakaba mufutuli wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        },
        {
