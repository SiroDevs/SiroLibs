        },
        {
          "text": "Ndakalyataula mucisinino endike. Katakwe muntu naba omwe akati kabamasi ngundakali awe, Lino ndakabalyataula mubukali bwangu akubakandaula mulunyemo lwangu. Bulowa bwabo bwakasansailwa azikobela zyangu, ndakabisya zyakusama zyangu zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaambo buzuba bwakuliya inkoto buli mumoyo wangu, amwaka walununuko wasika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        },
