                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaambo nduwe tateesu, nekuba kuti Abrahamu tatuzi, alakwe Israyeli tatuzuminini. Nduwe tateesu, O Jehova. Munununi wesu wakale ndizina lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.16",
            "verseOrgIds": [
