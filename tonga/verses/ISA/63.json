                  "text": "Ciy 16:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndakalyataula bantu mulunyemo lwangu, ndakabakozya mubukali bwangu, abulowa bwabo ndakabutila ansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
