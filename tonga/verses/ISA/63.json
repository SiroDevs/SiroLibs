                "loc": "REV.19.13"
              },
              "items": [
                {
                  "text": "Ciy 19:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ino nkaambonzi zyakusama zyako zilasalala pyu? Nkaambonzi zikobela zyako zili mbuli zikobela zyayooyo uulyataula mucisinino camisaansa? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        },
