              "items": [
                {
                  "text": "Lk 4:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buka, uinke ku-Zarefati mucisi ca-Sidoni, ukakale nkuko, Bona! Ndalailila umwi mukamufu wakooko kuti akulele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.9",
            "verseOrgIds": [
