              },
              "items": [
                {
                  "text": "1 Pet 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pele Eliya wakamwaambila kuti, Utayoowi, Koya ukajike mbubonya mboamba. Pele taanguna kundijikila mebo kasima kasyoonto, ukandiletele okuno, Lino kusule uyoolijikila, webo amwanaako. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.13",
            "verseOrgIds": [
              "1KI.17.13"
            ]
          }
        },
        {
