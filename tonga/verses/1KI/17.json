                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakavuwa kuti, Ma! Jehova Leza wako mbali muumi, nsijisi zyakujika cita inkankamaanza yomwe buyo yabusu iili mucinkuli, atumafuta tuniini munsazi. Lino ndili mukutebba tukuni tobile twakujisya, kuti tulye, mebo amwanaangu, elyo tulafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
