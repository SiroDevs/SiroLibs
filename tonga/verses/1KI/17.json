                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cinkuli cabusu tacikwe nicakamana, ayalo insazi yamafuta tiikwe niyakayuminina, mbubonya mbuli ijwi lya-Jehova ndyaakaamba kumulomo wa-Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
