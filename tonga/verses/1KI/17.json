              "items": [
                {
                  "text": "Heb 11:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mpawo wakanyamuka, waya ku-Zarefati, nkabela naakasika kumulyango wamunzi, wakajana mukamufu mpawo, uli mukutebba inkuni. Lino wakamwiita, wati, Kondiletela tumaanzi mukanywido, nywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.10",
            "verseOrgIds": [
              "1KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo naakali kuya kukuleta, wakoompolola kuti, Ulete amunsuma wansima mujanza lyako. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
