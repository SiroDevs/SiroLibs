            }
          ]
        },
        {
          "text": "Mpawo wakaakucita mbubonya mbuli Eliya mbwaakalailila, nkabela bakaiya boonse, Eliya amwanakazi amwanaakwe musankwa, mazuba manji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
