              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino mwami Solomoni wakanjizya bantu mucibalo kumikowa yoonse ya-Israyeli, Eci cibbalo cakatola bantu bali zyuulu zili makumi otatwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.18"
              },
              "items": [
                {
                  "text": "1 Bam 12:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela wakabatuma ku-Lebano, mwezi umwi aumwi bantu bali zyuulu zili ikumi, camalizi. Mwezi omwe bantu kabakala ku-Lebano, amyezi yobile kabakala kumunzi, Adoniramu nguwakali kubelesya basicibalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi Solomoni kajisi bantu bali zyuulu zili makumi aali musanu aabili bakuyumuna mikuli, abantu bali zyuulu zili makumi aali musanu aatatu bakutema misamu kucilundu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
