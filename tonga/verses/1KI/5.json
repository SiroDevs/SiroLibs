              },
              "items": [
                {
                  "text": "2 Mak 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alakwe Solomoni wakapa Hiramu masaka aabulotwe aali zyuulu zili makumi obile aakusanina basiŋanda bakwe, amingomo iili zyuulu zili makumi obile yamafuta aakutwa, Mbuboobo Solomoni mbwaakali kupa Hiramu myaka yoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
