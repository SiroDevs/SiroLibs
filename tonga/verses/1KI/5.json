              "type": "text"
            }
          ]
        },
        {
          "text": "Elyo Hiramu naakamvwa majwi aa-Solomoni, wakakondwa loko, wakati, Alumbwe Jehova buzuba obuno, nkaambo wapa Davida mwana uucenjede wakweendelezya aba bantu banji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela Hiramu wakatumina Solomoni, wakati, Ndakamvwa ncowakanditumina. Njoocita coonse ncoyanda kumakani aamisamu yakedari amisamu yamu lombe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
