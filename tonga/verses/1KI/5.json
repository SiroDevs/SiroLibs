              "items": [
                {
                  "text": "Jak 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela Jehova wakapa Solomoni busongo mbubonya mbwaakamusyomezya, alimwi Solomoni a-Hiramu bakakala caluumuno akutangana cizuminano.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
