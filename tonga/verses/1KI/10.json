        },
        {
          "text": "Alimwi maato aa-Hiramu, aakaakugwisya ingolida mucisi ca-Ofiri, akaleta kuzwa ku-Ofiri zisamu zinji loko zyaalmugi, amabwe mayandisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
