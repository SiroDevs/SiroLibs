          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.11"
              },
              "items": [
                {
                  "text": "2 Mak 9:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela zisamu ezyo zyaalmugi, mwami Solomoni wakazibezya zitabilizyo zyaŋanda ya-Jehova azyaŋanda yamwami, atuntimbwa anyeele zyabasikwiimba. Teekwakaboneka limbi zisamu zili boobo akusikila sunu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
