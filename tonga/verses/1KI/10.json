                "loc": "PRO.8.34"
              },
              "items": [
                {
                  "text": "Tus 8:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bali acoolwe bantu bako! Bali acoolwe aba balanda bako baimvwi lyoonse kubusyu bwako, baswiilila busongo bwako. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
