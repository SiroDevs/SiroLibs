                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atembaulwe Jehova Leza wako, iwakabotelwa nduwe akukukazika acuuno cabwami bwa-Israyeli. Jehova mbwayandisya Israyeli lyoonse, nciceeco ncaakakubikila kuti ube mwami, ubeteke makani cakululama. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpawo wakapa mwami matalenta aangolida aali mwaanda amakumi obile, atulisyo tunji loko, amabwe mayandisi, Teekwakaboneka limbi tulisyo tunji tuli boobo mbuli oto mwami mwanakazi waku-Seba ntwaakapa mwami Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        }
      ]
