                  "text": "2 Mak 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkabela insiliva mwami wakaivuzya mu-Jerusalemu mbuli mabwe, ayalo misamu yakedari wakaivuzya mbubonya mbuli mikuyu iili mutulundulundu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
