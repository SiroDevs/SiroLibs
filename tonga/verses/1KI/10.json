                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alimwi mwami wakapanga cuuno cipati cameja aanzovu akucivumbya ingolida iisalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
