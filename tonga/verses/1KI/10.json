                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amabbiza aa-Solomoni akazwa ku-Egepita aku-Kuwe. Basambazi bamwami bakaaula ku-Kuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
