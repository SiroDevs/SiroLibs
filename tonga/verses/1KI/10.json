          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimwi kakuli balavu bali ikumi ababili baimvwi amatantilo aali musanu alimwi kulubazu lumwi alumwi. Teekwakacitwa cimwi ceelene ancico abuniini muzisi zyoonse. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
