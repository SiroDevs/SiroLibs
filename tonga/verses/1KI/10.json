          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eco cuuno cakalijisi matantilo aali musanu alimwi, akusule lyaco kakuli mutwe wamunamani, akubbazu limwi alimwi lyacikalilo kacijisi zilyokezezyo zyamaboko, abalavu bobile baimvwi kumbali lyazilyokezezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19",
            "verseOrgIds": [
              "1KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
