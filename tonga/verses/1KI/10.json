          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabela zinywido zyoonse zyamwami Solomoni zyakali zyangolida, azinywido zyoonse zyamuŋanda yamucisaka caku-Lebano zyakali zyangolida iisalala, Katakwe zyansiliva pe, Eci teecakagambya abuniini pe mumazuba aa-Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
