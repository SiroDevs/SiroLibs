  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MIC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yawe afundi bato na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka makambo oyo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "« Telema mpe samba likambo na yo liboso ya bangomba,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "mpe tika ete bangomba mikuse eyoka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "makambo oyo ozali koloba !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bangomba mpe bino miboko oyo eninganaka te,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "boyoka likambo oyo Yawe afundeli bato na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "pamba te azwi bango na likambo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "mpe alingi kosamba na Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bato na Ngai, nasali bino penza nini ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:3"
      },
      "items": [
        {
          "text": "Boyanola Ngai nanu, nalembisi bino na likambo nini ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali te mpo ete nabimisaki bino na Ejipito",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "to mpo ete nakangolaki bino na ndako ya bowumbu ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "Boni, ezali te mpo ete natindelaki bino",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "Moyize, Aron mpe Miriami mpo ete bakamba bino ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato na Ngai, bokanisa nanu makambo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "oyo Balaki, mokonzi ya Moabi, akanaki kosala bino,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "mpe makambo oyo Balami, mwana mobali ya Beori,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "azongiselaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "Bokanisa nanu nzela oyo botambolaki",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "longwa na Sitimi kino na Giligali",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "mpo ete bokoka kondima ata misala ya bosembo ya Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloko nini penza tokoki komema epai na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "mpo na kofukama liboso ya Nzambe-Oyo-Aleki-Likolo ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "Boni, tomema bambeka ya kotumba",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "to bana ngombe ya mibali ya mobu moko ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akosepela solo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "soki tomemeli Ye minkoko ya bameme ya mibali",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "to soki topesi Ye mafuta ebele lokola mayi ya ebale ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Boni, topesa solo bana na biso ya liboso",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "mpo ete tozwa bolimbisi masumu na biso ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Boni, topesa bana na biso ya mibali",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "oyo bawuti na mikongo na biso",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "mpo ete akoka kolongola masumu na biso ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh moto, bateyaki yo makambo oyo ezali malamu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Mpe tala makambo oyo Yawe azali kosenga epai na yo :",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Tambola na bosembo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "linga boboto mpe tambola",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "elongo na Nzambe na yo na komikitisa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaele akweyisami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka ! Yawe azali kobelela na engumba !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "Kotosa Kombo na Ye, yango nde kozala na bwanya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "Boyoka sango ya etumbu na bino",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "na monoko na Ye oyo atindi yango !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh libota ya mobulu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:10"
      },
