          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masumu ya bakambi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, nalobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "« Boyoka, bino bakambi ya libota ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "bino batambolisi ya libota ya Isalaele !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "Ezali bino te bato bosengeli",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "koyeba malamu mibeko ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, ezali bino bato bozali koboya bolamu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "mpe bozali kolinga mabe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "Bozali kolongola poso ya nzoto ya bato ya libota na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "bozali kolongola misuni na bango",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "mpe kobuka mikuwa na bango.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali kodunda misuni ya bato ya libota na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "bozali kolongola bango poso ya nzoto",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "mpe kobuka mikuwa na bango.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "Bozali kokata bango mike-mike",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "lokola misuni oyo bakalingaka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "to oyo batokisaka na nzungu. »",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tango bakobelela Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "akoyanola bango te.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "Na tango wana, akobombela bango elongi na Ye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "likolo ya mabe na bango nyonso oyo basalaki.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "mpo na kotelemela basakoli ya lokuta",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "oyo babungisaka bato na ngai nzela :",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "« Soki bapesi bango eloko ya kolia,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "basakolaka kimia ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "soki bapesi bango te eloko ya kolia,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "basakolaka bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na butu, bokozwa lisusu bimoniseli te.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "Soki bapesi bango te eloko ya kolia,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "molili ekozingela bino",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "mpe bokokoka lisusu kosakola te !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "Moyi ekobimela lisusu basakoli yango te,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "mpe mokolo ekokoma molili mpo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamoni makambo bakotonda na soni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "mpe bato oyo balobaka makambo oyo ekoya bakosambwa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "Bango nyonso bakobomba bilongi na bango,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "pamba te Nzambe akoyanola bango te. »",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ngai, na nzela ya Molimo na Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "natondisami na nguya, na bosembo mpe na mpiko",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "mpo na kobimisa polele mabe ya Jakobi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "mpe lisumu ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka maloba oyo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "bakambi ya Jakobi mpe batambolisi ya Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "bino oyo bolingaka makambo ya sembo te",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
