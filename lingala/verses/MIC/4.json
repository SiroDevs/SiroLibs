  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MIC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokonzi ya Nzambe kati na Siona",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo oyo ekoya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "ngomba ya Tempelo ya Yawe ekolendisama ngwi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "na songe ya bangomba,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "ekoleka bangomba mikuse nyonso na molayi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "mpe bikolo ekokende kotondana kuna.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya bikolo ebele bakokende kuna mpe bakoloba :",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "« Boya, tomata na ngomba ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "na Tempelo ya Nzambe ya Jakobi !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Akoteya biso banzela na Ye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "mpo ete tolanda banzela mike na Ye. »",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Pamba te Mobeko ekowuta na Siona,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "mpe Liloba na Yawe ekowuta na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akozala Mosambisi kati na bikolo ebele,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "akokata makambo ya kowelana kati na mabota ya nguya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "ezala oyo ezalaka mosika.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Bakotumba mipanga na bango na moto",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "mpo na kosala bakongo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "mpe makonga na bango mpo na kosala bambeli.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Ekolo moko te ekotombola lisusu mopanga",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "mpo na kobundisa ekolo mosusu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "bato bakoyekola lisusu te kobunda bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso akovanda na kimia",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "kati na bilanga na ye ya vino",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "mpe na se ya nzete na ye ya figi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "Moto moko te akobangisa ye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "pamba te Yawe, Mokonzi ya mampinga, nde alobi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekolo na ekolo ekotambola",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "na kombo ya nzambe na yango,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "kasi biso tokotambola na Kombo na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "oyo azali Nzambe na biso, mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mabongisi ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Na mokolo yango, » elobi Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "« Nakosangisa libota na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "oyo ezali kotambola tengu-tengu ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "nakoyamba oyo ezalaki na bowumbu, mosika na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "mpe oyo natiaki pasi likolo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosala ete libota oyo ezali kotambola tengu-tengu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "ekoma batikali,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "mpe oyo bazalaki na bowumbu mosika na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "libota ya nguya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "Yawe akozala Mokonzi na bango, na ngomba Siona,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "kobanda na mokolo yango kino libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yo, ndako molayi ya bakengeli bibwele,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "ngomba ya Siona, mboka kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "bakozongisela yo bokonzi na yo ya kala,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
