  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "DEU 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana mobali moko te akoki kobala mwasi ya tata na ye, noki te akosambwisa mbeto ya tata na ye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bato oyo bakoki kondimama te kati na mayangani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobali moko te oyo baboma mokongo to balongola nzoto ya mibali akoki kokota na lisanga ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana makangu moko te to bakitani na ye bakoki kokota na lisanga ya Yawe ata sima na milongo zomi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto moko te ya Amoni to ya Moabi to bakitani na bango bakoki kokota na lisanga ya Yawe ata sima na milongo zomi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.4",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bayaki te koyamba bino na mapa mpe na mayi na nzela na bino tango bobimaki na Ejipito ; mpe bazwaki Balami, mwana mobali ya Beori, moto ya Petori, wuta na mokili ya Mezopotami, mpo ete alakela bino mabe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yawe, Nzambe na bino, ayokaki Balami te mpe abongolaki elakeli mabe lipamboli mpo na bino, pamba te Yawe, Nzambe na bino, alingi bino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.6",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango nyonso bokozala na bomoi, bokoki te kosala boyokani ya kimia elongo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
            "verseOrgIds": [
              "DEU.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokoki te komona bato ya Edomi lokola bato ya mbindo, pamba te bazali bandeko na bino. Bokoki te komona bato ya Ejipito lokola bato ya mbindo, pamba te bovandaki kati na mokili na bango lokola bapaya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani na bango, kobanda na molongo ya misato, nde bakoki kokota na lisanga ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.9",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mibeko na tina na bozangi mbindo ya molako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bokotonga milako mpo na kobundisa banguna na bino, bozala mosika na eloko nyonso oyo ezali mbindo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.10",
            "verseOrgIds": [
              "DEU.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mobali moko kati na bino azali mbindo, pamba te abimisaki mayi ya mibali na butu, asengeli kokende libanda ya molako mpe kovanda kuna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.11",
            "verseOrgIds": [
              "DEU.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi na pokwa, na tango moyi elalaka, asengeli komisukola nzoto mpe kozonga na molako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.12",
            "verseOrgIds": [
              "DEU.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokopona esika moko na libanda ya molako, mpo na kosala zongo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.13",
            "verseOrgIds": [
              "DEU.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto na moto, kati na bisalelo na ye, asengeli kozala na pawu ya moke mpo na kotimola mabele ; mpe soki akei kosala zongo inene, akotimola mwa libulu mpe akokunda nyei na ye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe, Nzambe na bino, atambolaka kati na molako na bino mpo na kobatela bino mpe kokangola bino na maboko ya banguna na bino. Molako na bino esengeli kozala bule mpo ete akoka komona te eloko moko ya mbindo kati na bino mpe apesa bino mokongo te.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.15",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makoki ya moto oyo aluki ebombamelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mowumbu ayei kobombama epai na yo, kozongisa ye te na maboko ya nkolo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete awumela epai na yo, na esika nyonso oyo alingi, mpe na engumba nyonso oyo aponi ; konyokola ye te.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kindumba ya bule epekisami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bana ya Isalaele, azala mobali to mwasi, moko te asengeli komipesa na kindumba ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosengeli te kokotisa na Tempelo ya Yawe, Nzambe na bino, lifuti ya mwasi ya ndumba to ya mobali ya ndumba, mpo na kokokisa ndayi ya lolenge nyonso, pamba te Yawe, Nzambe na bino, amonaka bango nyonso mibale nkele.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Epekisami kodefisa mpo na kozwa mileki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoki te kozwa mileki epai ya ndeko na yo tango odefisi ye mosolo, bilei to eloko mosusu oyo ekoki kobota mileki.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoki kozwa mileki epai ya mopaya, kasi epai ya ndeko na yo moto ya Isalaele te ; mpo ete Yawe, Nzambe na bino, apambola bino na misala nyonso oyo maboko na bino ekosala kati na mokili oyo bokokota mpo na kozwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mibeko na tina na bandayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki olapi ndayi epai na Yawe, Nzambe na yo, kowumela te mpo na kokokisa yango ; noki te Yawe, Nzambe na yo, akotuna yo yango mpe ekozala lisumu mpo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki oboyi na yo kolapa ndayi, okomema ngambo te.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likambo nyonso oyo bibebu na yo ekobimisa, osengeli kosalela yango, pamba te olapaki ndayi epai na Yawe, Nzambe na yo, na monoko na yo moko mpe wuta na mokano ya motema na yo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makoki ya kobuka bambuma kati na elanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki okoti na elanga ya vino ya moninga na yo, okoki kolia bambuma nyonso oyo olingi, kasi kotia eloko moko te na kitunga na yo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki okoti na elanga ya ble ya moninga na yo, okoki kobuka ble na maboko, kasi kosalela mbeli te.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.26",
            "verseOrgIds": [
              "DEU.23.26"
            ]
          }
        }
      ]
    }
  ],
