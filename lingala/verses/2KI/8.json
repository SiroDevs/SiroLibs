    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yorami, mwana mobali ya Akabi, mokonzi ya Isalaele, akokisaki mibu zomi na mibale na bokonzi, Akazia, mwana mobali ya Yorami, akomaki mokonzi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazia azalaki na mibu tuku mibale na mibale ya mbotama tango akomaki mokonzi, mpe akonzaki mobu moko na Yelusalemi. Kombo ya mama na ye ezalaki « Atali. » Atali azalaki koko ya Omiri, mokonzi ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alandaki nzela oyo libota ya Akabi etambolaki na yango mpe asalaki mabe na miso ya Yawe ndenge libota ya Akabi esalaki, pamba te abalaki na libota ya Akabi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazia akendeki elongo na Yorami, mwana mobali ya Akabi, mpo na kobundisa Azaeli, mokonzi ya Siri, na Ramoti ya Galadi. Bato ya Arami bazokisaki Yorami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, mokonzi Yorami azongaki na Jizireyeli mpo na kokawusa bapota oyo bato ya Arami bazokisaki ye na Rama, na bitumba oyo babundaki na Azaeli, mokonzi ya Siri. Akazia, mwana mobali ya Yorami, mokonzi ya Yuda, akendeki na Jizireyeli mpo na kotala Yorami, mwana mobali ya Akabi, pamba te bazokisaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    }
