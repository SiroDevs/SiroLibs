      "attrs": {
        "style": "li1",
        "vid": "1CH 27:33"
      },
      "items": [
        {
          "text": "mpe Ushayi, moto ya Ariki, azalaki mobateli sekele ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
