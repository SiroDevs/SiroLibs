            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabi, mwana mobali ya Tseruya, abandaki kotanga bango kasi asilisaki te. Pamba te likolo ya botangi wana, Yawe akitiselaki Isalaele kanda na Ye. Boye, motango ya bato yango ekomamaki te na buku ya masolo ya mokonzi Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babateli bozwi ya mokonzi",
          "type": "text"
        }
