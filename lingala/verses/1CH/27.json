      "attrs": {
        "style": "li1",
        "vid": "1CH 27:27"
      },
      "items": [
        {
          "text": "Zabidi, moto ya engumba Shefami, azalaki mobateli masanga ya vino mpe bilanga ya vino.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
