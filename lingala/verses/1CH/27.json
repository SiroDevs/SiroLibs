              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatan, ndeko ya tata ya Davidi, azalaki mopesi toli, moto ya mayele mpe mokomi mikanda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
