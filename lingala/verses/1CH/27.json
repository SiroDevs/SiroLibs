      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:25"
      },
      "items": [
        {
          "text": "Jonatan, mwana mobali ya Oziasi, azalaki mobateli ya bibombelo na bazamba, na bingumba, na bamboka mike mpe na bandako milayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
    },
