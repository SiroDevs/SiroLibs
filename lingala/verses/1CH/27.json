          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atangaki te molongo ya mibali oyo bazalaki na se ya mibu tuku mibale ya mbotama, pamba te Yawe alakaki ete akokomisa Isalaele ebele lokola minzoto ya likolo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
