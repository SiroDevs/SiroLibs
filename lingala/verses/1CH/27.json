          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azimaveti, mwana mobali ya Adieli, azalaki kobatela bibombelo ya bozwi ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
