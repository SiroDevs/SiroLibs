        "style": "s1"
      },
      "items": [
        {
          "text": "Suka ya bomoi ya Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
