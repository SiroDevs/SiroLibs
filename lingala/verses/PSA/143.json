            "number": "6",
            "style": "v",
            "sid": "PSA 143:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasemboli maboko na ngai epai na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:6"
      },
      "items": [
        {
          "text": "nakomi komimona lokola mabele ya kokawuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 143:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, zongisela ngai eyano noki !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Molimo na ngai ezali kolemba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Kopesa ngai mokongo te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "noki te nakozala lokola bato oyo bazali kokita na libulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 143:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tongo makasi, sala ete nayoka boboto na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "pamba te natia elikya na ngai kati na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Lakisa ngai nzela ya kolanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "pamba te napesi bomoi na ngai epai na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
