      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "nakoningana te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
