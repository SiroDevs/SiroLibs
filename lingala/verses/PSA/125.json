        {
          "text": "Nzembo 125",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Kimia ya solo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 125:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya mobembo mpo na kokende na Ndako ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "Bato oyo batiaka elikya kati na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "bazali lokola ngomba Siona oyo eninganaka te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "oyo epikama mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 125:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge bangomba ezingeli Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "ndenge wana mpe Yawe azingeli bato na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "kobanda sik'oyo kino libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 125:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokonzi ya mabe ekowumela te na etuka ya bato ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "mpo ete basangana te na mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 125:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, zala malamu mpo na bato malamu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:4"
      },
      "items": [
        {
          "text": "mpe mpo na bato oyo bazali alima na mitema !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 125:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tika ete Yawe abengana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "bato ya kilikili elongo na bato ya misala mabe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 125:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "Tika ete kimia ezala na Isalaele !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    }
