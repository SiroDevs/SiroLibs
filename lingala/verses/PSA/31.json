  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PSA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Natie elikya na ngai kati na Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Wuta na buku ya mokambi ya bayembi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh Yawe, kati na Yo nde nazwa ebombamelo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "kondima te ete nayoka soni !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "Bikisa ngai na bosembo na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoka ngai mpe kangola ngai noki !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:3"
      },
      "items": [
        {
          "text": "Zala mpo na ngai libanga oyo ezingelami na bamir",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:3"
      },
      "items": [
        {
          "text": "mpe ndako batonga makasi mpo na kobikisa ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete ozali libanga na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:4"
      },
      "items": [
        {
          "text": "mpe ndako na ngai ya makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:4"
      },
      "items": [
        {
          "text": "kamba mpe tambolisa ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:4"
      },
      "items": [
        {
          "text": "mpo na lokumu ya Kombo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikisa ngai na motambo oyo batieli ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:5"
      },
      "items": [
        {
          "text": "pamba te ozali ebombamelo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazongisi molimo na ngai kati na maboko na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:6"
      },
      "items": [
        {
          "text": "Yawe, Nzambe ya solo, oyo okangolaki ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalingaka te bato nyonso oyo bakangamaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "na banzambe ya bikeko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "pamba te natiaka elikya na ngai kati na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakozalaka moto ya esengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:8"
      },
      "items": [
        {
          "text": "mpe nakosepelaka kati na bolingo na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:8"
      },
      "items": [
        {
          "text": "pamba te omonaka pasi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:8"
      },
      "items": [
        {
          "text": "mpe oyebi mitungisi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okabaki ngai te na maboko ya monguna na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "kasi obombaka ngai mosika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "na esika ya kimia penza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, yokela ngai mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "pamba te nazali kati na pasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "miso, motema mpe nzoto na ngai mobimba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "ebebi mpo na mawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bomoi na ngai ekawuki mpo na pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "mpe mibu na ngai ezali koleka kati na kolela ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "makasi na ngai esili mpo na mabe na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "mpe mikuwa na ngai elembi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banguna na ngai nyonso bakomi kozwa ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "lokola eloko ya lisuma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "baninga na ngai bakomi kozwa ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "lokola eloko ya soni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "mpe bato oyo bayebi ngai bakomi kozwa ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "lokola eloko ya somo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babosani ngai lokola moto oyo asila kokufa ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:13"
      },
      "items": [
        {
          "text": "nakomi lokola mbeki oyo epanzana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
