    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nkembo ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi ; ezali ya koyemba na lindanda ya bato ya Gati.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, Nkolo na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "Kombo na Yo ezali monene kati na mokili mobimba !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 8:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "Ovandisi nkembo na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "kati na Lola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nzela ya masanzoli ya bana mpe bana mike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "otelemisi ndako batonga makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "mpo na kotelemela bayini na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "mpe kokanga monoko ya monguna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "mpe ya moto oyo alingaka kozongisa mabe na mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango natalaka Lola na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:4"
      },
      "items": [
        {
          "text": "mosala ya misapi na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:4"
      },
      "items": [
        {
          "text": "sanza mpe minzoto oyo otia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namitunaka : Moto azali nini mpo ete okanisa ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:5"
      },
      "items": [
        {
          "text": "mpe moto azali nani mpo ete obatela ye ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osalaki ye moke koleka ba-anjelu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:6"
      },
      "items": [
        {
          "text": "mpe olatisaka ye motole ya nkembo mpe ya lokumu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "otia ye moyangeli ya misala ya maboko na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:7"
      },
      "items": [
        {
          "text": "otia nyonso na se ya matambe na ye :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "bameme, bantaba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:8"
      },
      "items": [
        {
          "text": "bangombe mpe banyama ya zamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bandeke ya likolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:9"
      },
      "items": [
        {
          "text": "mbisi ya ebale monene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:9"
      },
      "items": [
        {
          "text": "mpe nyonso oyo etambolaka na bibale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.9",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
