            "sid": "PSA 95:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokende liboso na Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
