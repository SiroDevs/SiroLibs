      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:2"
      },
      "items": [
        {
          "text": "elongo na mabondeli ya kozongisa matondi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
