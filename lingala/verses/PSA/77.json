    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe abongwani to te ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 77:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi, kolanda Yedutuni. Nzembo ya Azafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 77:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabelelaka Nzambe na koganga ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:2"
      },
      "items": [
        {
          "text": "nabelelaka Nzambe mpo ete ayoka ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.2",
            "verseOrgIds": [
              "PSA.77.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 77:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango nazalaka na pasi, nalukaka Nkolo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "text": "na butu, nalembaka te kotombola maboko na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 77:3"
      },
      "items": [
        {
          "text": "mpe naboyaka kobondisama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.3",
            "verseOrgIds": [
              "PSA.77.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
