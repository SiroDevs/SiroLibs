      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 77:11"
      },
      "items": [
        {
          "text": "loboko ya mobali ya Ye-Oyo-Aleki-Likolo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.77.11",
            "verseOrgIds": [
              "PSA.77.11"
            ]
          }
