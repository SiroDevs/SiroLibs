    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 122",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Bosambela mpo na kimia ya Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 122:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 122:1"
      },
      "items": [
        {
          "text": "Nasepelaka tango balobaka na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:1"
      },
      "items": [
        {
          "text": "« Tokende na Tempelo ya Yawe ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 122:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelusalemi, makolo na biso etelemi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:2"
      },
      "items": [
        {
          "text": "na bikuke na yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 122:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelusalemi, engumba oyo etongama malamu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:3"
      },
      "items": [
        {
          "text": "engumba oyo biteni na yango ekangana esika moko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 122:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali kuna nde mabota ekendaka, mabota ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "kolanda mibeko kati na Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "mpo na kosanzola Kombo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 122:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bakiti ya bokonzi ya bato",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:5"
      },
      "items": [
        {
          "text": "oyo basalelaka bosembo ezali kuna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:5"
      },
      "items": [
        {
          "text": "bakiti ya bokonzi mpo na ndako ya Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 122:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosenga kimia ya Yelusalemi !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:6"
      },
      "items": [
        {
          "text": "Tika ete bato oyo balingaka yo, Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:6"
      },
      "items": [
        {
          "text": "babika na kimia !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 122:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete kimia ezala kati na yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:7"
      },
      "items": [
        {
          "text": "mpe kati na bandako na yo ya bokonzi !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 122:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo ya bolingo na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:8"
      },
      "items": [
        {
          "text": "mpo na bandeko mpe balingami na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:8"
      },
      "items": [
        {
          "text": "nalobi : « Tika ete kimia ezala kati na yo ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 122:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo ya bolingo na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:9"
      },
      "items": [
        {
          "text": "mpo na Tempelo ya Yawe, Nzambe na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:9"
      },
      "items": [
        {
          "text": "nasengi bolamu mpo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    }
