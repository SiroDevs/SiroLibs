        {
          "text": "Kotosa Yawe ezali peto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "ewumelaka libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "Mitindo ya Yawe ezali ya solo,",
