      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:12"
      },
      "items": [
        {
          "text": "moto nyonso oyo atosaka yango azwaka litomba mingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
