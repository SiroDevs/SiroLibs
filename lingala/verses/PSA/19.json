          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitindo ya Yawe ezali alima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "esepelisaka motema ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "malako na Ye ezali peto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "epesaka bososoli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
