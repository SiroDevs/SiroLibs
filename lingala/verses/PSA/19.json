          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epesaka mosali na Yo mayele ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
