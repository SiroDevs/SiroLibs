      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:11"
      },
      "items": [
        {
          "text": "koleka wolo ebele ya peto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:11"
      },
      "items": [
        {
          "text": "wolo oyo basangisa na eloko mosusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:11"
      },
      "items": [
        {
          "text": "eleki mafuta ya nzoyi na elengi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:11"
      },
      "items": [
        {
          "text": "mafuta ya nzoyi oyo ezali kobima sika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
