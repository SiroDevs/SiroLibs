          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolembi penza kotiolama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
