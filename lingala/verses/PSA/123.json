          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 123:1"
      },
      "items": [
        {
          "text": "Natomboli miso na ngai epai na Yo, Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:1"
      },
      "items": [
        {
          "text": "oyo ovandi na Kiti na Yo ya Bokonzi kati na Lola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 123:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge miso ya bawumbu etalaka nkolo na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "mpe miso ya mwasi mosali etalaka nkolo na ye ya mwasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "ndenge wana mpe miso na biso ezali kotala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "Yawe, Nzambe na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "kino asalela biso ngolu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
