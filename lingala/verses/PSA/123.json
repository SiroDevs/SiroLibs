          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, salela biso ngolu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:3"
      },
      "items": [
        {
          "text": "yokela biso mawa !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:3"
      },
      "items": [
        {
          "text": "Pamba te tolembi kotiolama !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
