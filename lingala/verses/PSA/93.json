      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 93:1"
      },
      "items": [
        {
          "text": "Solo, mokili etelema ngwi, eninganaka te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
