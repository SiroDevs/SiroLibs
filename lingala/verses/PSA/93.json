          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiti ya Bokonzi na Yo epikama wuta kala ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.2",
            "verseOrgIds": [
              "PSA.93.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:2"
      },
      "items": [
        {
          "text": "seko na seko, ozali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.2",
            "verseOrgIds": [
              "PSA.93.2"
            ]
          }
        }
      ]
    },
