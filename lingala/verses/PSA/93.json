          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali kokonza, alati lokumu monene ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:1"
      },
      "items": [
        {
          "text": "Yawe alati penza lokumu monene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:1"
      },
      "items": [
        {
          "text": "mpe amizingeli na nguya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
