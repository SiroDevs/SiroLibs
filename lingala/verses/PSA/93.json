      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "Bibale etombolaka lokito na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
