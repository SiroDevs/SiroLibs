          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Azafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "Oh Nzambe, tala ndenge bato ya bikolo ya bapaya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "bakoti na makasi kati na libula na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "bakomisi Esika na Yo ya bule mbindo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:1"
      },
      "items": [
        {
          "text": "mpe bakomisi Yelusalemi mipiku ya mabanga !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.1",
            "verseOrgIds": [
              "PSA.79.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 79:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapesi bibembe ya basali na Yo lokola bilei",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "epai ya bandeke ya likolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "mpe bibembe ya bayengebene na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:2"
      },
      "items": [
        {
          "text": "epai ya banyama ya zamba ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.2",
            "verseOrgIds": [
              "PSA.79.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 79:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "basopi makila na bango lokola mayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "zingazinga ya Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:3"
      },
      "items": [
        {
          "text": "mpe moto ya kokunda bango azalaki te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.3",
            "verseOrgIds": [
              "PSA.79.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 79:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge bato ya bikolo oyo ezingeli biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "bazali kofinga biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "mpe tokomi lokola eloko ya liseki",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:4"
      },
      "items": [
        {
          "text": "na miso na bango !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.4",
            "verseOrgIds": [
              "PSA.79.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 79:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino tango nini, Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:5"
      },
      "items": [
        {
          "text": "okokangela biso kanda ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:5"
      },
      "items": [
        {
          "text": "Kino tango nini zuwa na Yo ekopela lokola moto ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.5",
            "verseOrgIds": [
              "PSA.79.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 79:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sopela bikolo oyo eyebi Yo te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "mpe mikili oyo ebelelaka Kombo na Yo te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:6"
      },
      "items": [
        {
          "text": "kanda makasi na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.6",
            "verseOrgIds": [
              "PSA.79.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 79:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te babebisi Jakobi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:7"
      },
      "items": [
        {
          "text": "mpe bapanzi mokili na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.7",
            "verseOrgIds": [
              "PSA.79.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 79:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotangela biso te masumu na biso ya kala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "kokangela biso motema te, yokela biso mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:8"
      },
      "items": [
        {
          "text": "pamba te tokomi na suka !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.8",
            "verseOrgIds": [
              "PSA.79.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 79:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe Mobikisi na biso, sunga biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "mpo na lokumu ya Kombo na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "kangola biso mpe limbisa masumu na biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:9"
      },
      "items": [
        {
          "text": "mpo na Kombo na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.9",
            "verseOrgIds": [
              "PSA.79.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 79:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini bikolo eloba :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "« Nzambe na bango azali wapi ? »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "Tika ete, na miso na biso, bato ya bikolo bayeba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "ete ozongiseli bango mabe na mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:10"
      },
      "items": [
        {
          "text": "mpo na makila ya basali na Yo, oyo basopaki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.10",
            "verseOrgIds": [
              "PSA.79.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 79:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete kolela ya bakangami kati na boloko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "ekoma liboso na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "Na nguya monene na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 79:11"
      },
      "items": [
        {
          "text": "bikisa ba-oyo bazwa etumbu ya kufa !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.79.11",
            "verseOrgIds": [
              "PSA.79.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 79:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nkolo, zongisela bikolo",
