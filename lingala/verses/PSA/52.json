  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "PSA 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Suka ya mozwi oyo anyokolaka bato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Wuta na buku ya mokambi ya bayembi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyembamaki tango Doegi, moto ya Edomi, akendeki koyebisa Saulo ete Davidi akoti na ndako ya Ayimeleki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo elombe, mpo na nini ozali komikumisa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:3"
      },
      "items": [
        {
          "text": "na tina na mabe ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:3"
      },
      "items": [
        {
          "text": "Bolingo ya Nzambe emonanaka mikolo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo oyo otambolaka na lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:4"
      },
      "items": [
        {
          "text": "lolemo na yo esalaka mabongisi ya libebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:4"
      },
      "items": [
        {
          "text": "ekosaka lokola mbeli bapelisa malamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olingaka mabe koleka bolamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "lokuta koleka koloba bosolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh lolemo ya lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:6"
      },
      "items": [
        {
          "text": "olingaka maloba nyonso oyo epanzaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, Ye moko Nzambe akobebisa yo mpo na libela,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "akokanga yo kati na ndako na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "akobwaka yo libanda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "mpe akopikola yo na mokili ya bato ya bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya sembo bakomona",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "mpe bakokoma na somo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "bakotiola ye na maloba oyo :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala moto oyo azalaki te kozwa Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "lokola ebombamelo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "azalaki kotiela bozwi na ye motema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "mpe kobakisa makasi na ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "na nzela ya kobebisa bato mosusu. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ngai, kati na Ndako na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.10",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:10"
      },
      "items": [
        {
          "text": "nazali lokola nzete ya olive",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.10",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:10"
      },
      "items": [
        {
          "text": "oyo etondi na makasa ya mobesu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.10",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:10"
      },
      "items": [
        {
          "text": "natiaka tango nyonso elikya na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.10",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:10"
      },
      "items": [
        {
          "text": "kati na bolingo monene ya Nzambe, mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.10",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosanzola Yo mikolo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.11",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:11"
      },
      "items": [
        {
          "text": "mpo na oyo osali ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.11",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:11"
      },
      "items": [
        {
          "text": "mpe nazalaka na elikya kati na Kombo na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.11",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:11"
      },
      "items": [
        {
          "text": "pamba te ozali malamu mpo na bayengebene na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.11",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    }
  ],
