      "attrs": {
        "style": "q2",
        "vid": "PSA 26:3"
      },
      "items": [
        {
          "text": "mpe nabikaka bomoi na ngai kolanda bosembo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
