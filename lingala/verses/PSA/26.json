      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:4"
      },
      "items": [
        {
          "text": "natambolaka nzela moko te na bato ya mitema mibale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
