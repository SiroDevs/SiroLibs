  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "PSA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Mpo na libala ya mokonzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya bolingo oyo bana ya Kore bayembaki. Wuta na buku ya mokambi ya bayembi. Eyembamaki na lindanda oyo babengaka Lisi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema na ngai etondi na maloba kitoko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "Namilobeli : Nakotatola misala na ngai mpo na mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "Tika ete lolemo na ngai ezala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "lokola ekomeli ya mokomi ya mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleki bato nyonso na kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:3"
      },
      "items": [
        {
          "text": "mpe bibebu na Yo ebimisaka ngolu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:3"
      },
      "items": [
        {
          "text": "yango wana Nzambe apambola Yo mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elombe ya bitumba, kanga mopanga na loketo na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "Lata lokumu mpe kongenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na kongenga na Yo, zala molongi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "text": "mata na shar na Yo, telema mpo na solo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "text": "mpo na komikitisa, mpe mpo na bosembo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "text": "tika ete loboko na Yo ya mobali esala misala minene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete makonga na Yo ya minu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:6"
      },
      "items": [
        {
          "text": "etobola mitema ya banguna ya mokonzi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:6"
      },
      "items": [
        {
          "text": "tika ete bikolo ekweya na se ya matambe na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe, Kiti ya Bokonzi na Yo ekowumela seko na seko ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "lingenda ya bokonzi na Yo ezali mpo na bosembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olingaka bosembo mpe oyinaka mabe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "yango wana, oh Nzambe, Nzambe na Yo apakoli Yo mafuta ya esengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "asepeli na Yo koleka baninga na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilamba na Yo nyonso ezali kolumba solo kitoko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "ya malasi ya mire, ya aloe mpe ya kaneli ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "wuta na bandako minene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "oyo ebongisama na pembe ya nzoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "mandanda ezali kosepelisa Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana basi ya bakonzi bazali kati na basi ya lokumu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:10"
      },
      "items": [
        {
          "text": "mwasi ya mokonzi azali na ngambo ya loboko na Yo ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:10"
      },
      "items": [
        {
          "text": "alati biloko ya wolo ya Ofiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai ya mwasi, tala mpe yoka ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:11"
      },
      "items": [
        {
          "text": "bosana bato na yo mpe ndako ya tata na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi asepeli na kitoko na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:12"
      },
      "items": [
        {
          "text": "lokola azali nkolo na yo, gumbama liboso na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiri, mboka kitoko, bato oyo baleki na bozwi kati na bato",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:13"
      },
      "items": [
        {
          "text": "bakomemela yo bakado mpo ete olinga bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana mwasi ya mokonzi azali kongenga na kitoko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "kati na ndako ya mokonzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "alati elamba batonga wolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
