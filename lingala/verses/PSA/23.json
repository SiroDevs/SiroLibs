          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:1"
      },
      "items": [
        {
          "text": "Yawe azali mobateli na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:1"
      },
      "items": [
        {
          "text": "nakozanga ata eloko moko te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apemisaka ngai na matiti ya mobesu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:2"
      },
      "items": [
        {
          "text": "mpe amemaka ngai pembeni ya mayi ya kimia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeisaka sika makasi ya bomoi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "akambaka ngai na banzela ya bosembo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "mpo na lokumu ya Kombo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata soki nasengeli kokatisa lubwaku",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "oyo etondi na molili ya kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "nakobanga mabe ata moko te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "pamba te ozali elongo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "nzete na Yo ya mobateli ekambaka ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "mpe lingenda na Yo ebatelaka ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obongisaka mesa mpo na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "na miso ya bayini na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "opakolaka moto na ngai mafuta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "mpe otondisaka kopo na ngai kino kosopana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, na mikolo nyonso ya bomoi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "esengo mpe bolingo na Yo ekobanda kolanda ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "mpe nakovanda kati na Tempelo ya Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "kino suka ya bomoi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
