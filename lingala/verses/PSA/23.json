      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe azali Mobateli na ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
