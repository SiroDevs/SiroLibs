    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe ayokaka ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 116:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalingaka Yawe, pamba te ayokaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:1"
      },
      "items": [
        {
          "text": "mongongo mpe mabondeli na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 116:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayokaki ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:2"
      },
      "items": [
        {
          "text": "boye nakobelela Ye bomoi na ngai mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 116:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minyololo ya kufa ezingelaki ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "somo ya mboka ya bakufi ekangaki ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "nakomaki moto ya pasi mpe ya mawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 116:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi nabelelaki Kombo ya Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:4"
      },
      "items": [
        {
          "text": "« Yawe, nabondeli Yo, bikisa ngai ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 116:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe asalaka ngolu mpe azali sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:5"
      },
      "items": [
        {
          "text": "Nzambe na biso ayokelaka bato mawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 116:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe abatelaka bato oyo bazangi mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:6"
      },
      "items": [
        {
          "text": "Nalembaki nzoto, kasi abikisi ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 116:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimo na ngai, zongela kimia na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:7"
      },
      "items": [
        {
          "text": "pamba te Yawe asaleli yo bolamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 116:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, okangoli ngai na kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "okawusi mpinzoli na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "mpe obateli makolo na ngai ete ekweya te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 116:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakotambola liboso ya Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:9"
      },
      "items": [
        {
          "text": "kati na mokili ya bato ya bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 116:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, nazalaka na elikya, ezala soki nalobaka :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:10"
      },
      "items": [
        {
          "text": "« Nazali moto na pasi makasi. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 116:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na mitungisi na ngai, nazalaki komilobela :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:11"
      },
      "items": [
        {
          "text": "« Bato nyonso bazali bakosi. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 116:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nini nakoki kozongisela Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:12"
      },
      "items": [
        {
          "text": "mpo na bolamu na Ye nyonso epai na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 116:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakotombola kopo ya elonga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:13"
      },
      "items": [
        {
          "text": "mpe nakobelela Kombo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 116:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakokokisa bandayi na ngai epai na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:14"
      },
      "items": [
        {
          "text": "na miso ya bato na Ye nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 116:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufa ya bayengebene ya Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:15"
      },
      "items": [
        {
          "text": "ezali na motuya makasi na miso na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 116:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, yoka ngai, nazali mosali na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "Nazali mosali na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "mwana mobali ya mwasi mosali na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "Ofungoli minyololo oyo ekangaki ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 116:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakobonzela Yo mbeka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.17",
            "verseOrgIds": [
              "PSA.116.17"
            ]
          }
        }
      ]
