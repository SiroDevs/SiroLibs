        "sid": "PSA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Tokolonga kaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Eyembamaki ndenge moko na « Lisi ya litatoli. » Nzembo ya Davidi mpo na koteya bato.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayembaki yango tango abundisaki bato ya Siri ya Mezopotami mpe bato ya Siri ya Tsoba, mpe tango Joabi azongaki, sima na ye kolonga bato nkoto zomi na mibale ya Edomi, na bitumba kati na Lubwaku ya Mungwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, obwakaki mpe opanzaki biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:3"
      },
      "items": [
        {
          "text": "osilikaki penza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:3"
      },
      "items": [
        {
          "text": "Sik'oyo, zongisa biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, oningisaki mabele mpe obukaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:4"
      },
      "items": [
        {
          "text": "Bamba madusu na yango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:4"
      },
      "items": [
        {
          "text": "pamba te ekomi koningana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omonisaki bato na Yo pasi makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:5"
      },
      "items": [
        {
          "text": "omelisaki biso vino oyo elangwisaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opesaki na bato oyo batosaka Yo bendele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "mpo na koyebisa bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "ete bakima liboso ya batolotolo ya banguna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete balingami na Yo bakangolama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "bikisa na nguya ya loboko na Yo ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "mpe yanola biso ! Yanola ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe alobaki kati na Esika na Ye ya bule :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "« Nakolonga ! Nakokabola Sishemi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "mpe nakomeka molayi ya lubwaku ya Sukoti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galadi ezali ya ngai, Manase mpe ezali ya ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:9"
      },
      "items": [
        {
          "text": "Efrayimi ezali ekoti na ngai ya ebende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:9"
      },
      "items": [
        {
          "text": "mpe Yuda ezali lingenda na ngai ya bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moabi ezali sani monene oyo nasukolelaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:10"
      },
      "items": [
        {
          "text": "Edomi ezali esika oyo nabwakaka sandale na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:10"
      },
      "items": [
        {
          "text": "Mpo na Filisitia, nabetaka milolo ya elonga. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akomema ngai kino na engumba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:11"
      },
      "items": [
        {
          "text": "oyo batonga makasi ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:11"
      },
      "items": [
        {
          "text": "Nani akotambolisa ngai kino na Edomi ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 60:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali Yo te, Nzambe oyo obwakaki biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:12"
      },
      "items": [
        {
          "text": "Nzambe oyo ozalaki lisusu te kokende bitumba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:12"
      },
      "items": [
        {
          "text": "elongo na mampinga na biso ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 60:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaka kosunga biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.13",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:13"
      },
      "items": [
        {
          "text": "kangola biso liboso ya moyini ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.13",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:13"
      },
      "items": [
        {
          "text": "pamba te lisungi ya bato ezali pamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.13",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 60:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, elongo na Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.14",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:14"
      },
      "items": [
        {
          "text": "tokosala makambo minene mpe ya kokamwa ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.14",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:14"
      },
      "items": [
        {
          "text": "ezali Ye nde akonyata banguna na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.14",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    }
  ],
