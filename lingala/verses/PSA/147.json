      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:6"
      },
      "items": [
        {
          "text": "kasi akitisaka bato mabe kino na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
