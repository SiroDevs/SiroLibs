          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayebi motango ya minzoto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
