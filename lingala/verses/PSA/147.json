      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:7"
      },
      "items": [
        {
          "text": "Bobetela Nzambe na biso lindanda mpo na kosanzola Ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
