          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo na biso azali monene mpe atonda na nguya ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
