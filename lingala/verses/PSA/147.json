      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:3"
      },
      "items": [
        {
          "text": "mpe akawusaka bapota na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
