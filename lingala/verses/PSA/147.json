      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:4"
      },
      "items": [
        {
          "text": "mpe abengaka moko na moko na kombo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
