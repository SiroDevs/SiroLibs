        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe azali ekimelo na biso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya bana ya Kore. Wuta na buku ya mokambi ya bayembi. Eyembamaki na mongongo moke ya bilenge basi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na biso, Nzambe azali ebombamelo mpe eyekamelo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:2"
      },
      "items": [
        {
          "text": "azali lisungi oyo ezangaka te na tango ya pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tobangaka te ata soki mabele eningani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:3"
      },
      "items": [
        {
          "text": "bangomba ekweyi kati na ebale monene ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ata soki bambonge na yango etelemi, ebimisi fulufulu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:4"
      },
      "items": [
        {
          "text": "mpe eningisi bangomba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na ebale moko oyo mayi na yango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:5"
      },
      "items": [
        {
          "text": "esepelisaka engumba ya Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:5"
      },
      "items": [
        {
          "text": "oyo eleki bule kati na bivandelo ya Ye-Oyo-Aleki-Likolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe azali kati na yango, ebukani te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:6"
      },
      "items": [
        {
          "text": "Nzambe asungaka yango wuta na tongo makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikolo ezali kotomboka, bamboka ezali kokweya ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:7"
      },
      "items": [
        {
          "text": "kasi Nzambe atomboli mongongo na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:7"
      },
      "items": [
        {
          "text": "mpe mabele ebukani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Mokonzi ya mampinga, azali elongo na biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:8"
      },
      "items": [
        {
          "text": "Nzambe ya Jakobi azali ekimelo na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.8",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boya kotala misala ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:9"
      },
      "items": [
        {
          "text": "makambo minene oyo asalaka kati na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.9",
            "verseOrgIds": [
              "PSA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilisaka bitumba kino na basuka ya mokili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "akataka batolotolo, abukaka makonga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "mpe atumbaka na moto bashar ya bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki : « Bovanda kimia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.11",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:11"
      },
      "items": [
        {
          "text": "boyeba ete ngai nazali Nzambe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.11",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:11"
      },
      "items": [
        {
          "text": "nakonzaka bikolo, nakonzaka mpe mokili. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.11",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Mokonzi ya mampinga, azali elongo na biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.12",
            "verseOrgIds": [
              "PSA.46.12"
            ]
          }
        }
      ]
    },
