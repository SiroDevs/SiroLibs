      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya Tsofari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsofari, moto ya engumba ya Naama, azwaki maloba mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.1",
            "verseOrgIds": [
              "JOB.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Boni, maloba oyo nyonso ekoki solo kozanga eyano ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:2"
      },
      "items": [
        {
          "text": "Moto oyo azali koloba alonga na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:2"
      },
      "items": [
        {
          "text": "kaka mpo ayebi koloba ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bavanda kaka nye likolo ya maloba na yo ya pamba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:3"
      },
      "items": [
        {
          "text": "oyo ozali kobimisa ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:3"
      },
      "items": [
        {
          "text": "Bapamela yo te soki ozali kosala maseki ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozali koloba na Nzambe :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:4"
      },
      "items": [
        {
          "text": "‹ Makambo oyo nazali koloba ezali ya solo ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:4"
      },
      "items": [
        {
          "text": "nazali sembo na miso na Yo. ›",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh, tala ndenge nini nazali na posa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:5"
      },
      "items": [
        {
          "text": "ete Nzambe aloba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:5"
      },
      "items": [
        {
          "text": "ete afungola monoko na Ye mpo na kopamela yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe asosolisa yo basekele ya bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "pamba te bwanya ya solo ezalaka na bilongi mibale.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "Yeba likambo oyo :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "Nzambe abosana masumu na yo ebele.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoki penza kososola mabombami ya Nzambe ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:7"
      },
      "items": [
        {
          "text": "Okoki solo kososola bandelo ya Nkolo-Na-Nguya-Nyonso ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandelo yango eleki Lola na likolo ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:8"
      },
      "items": [
        {
          "text": "yo penza okosala nini ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 11:8"
      },
      "items": [
        {
          "text": "Eleki mboka ya bakufi na bozindo ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:8"
      },
      "items": [
        {
          "text": "yo penza okoyeba nini ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molayi ya bandelo yango eleki mokili na molayi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:9"
      },
      "items": [
        {
          "text": "mpe eleki ebale monene na kopanzana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki akotisi yo na boloko",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:10"
      },
      "items": [
        {
          "text": "mpe asangisi basambisi mpo na kokata likambo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:10"
      },
      "items": [
        {
          "text": "nani akotelemela Ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, ayebaka bakosi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:11"
      },
      "items": [
        {
          "text": "mpe asosolaka mabe na pete.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge mwana ya ane ya zamba ebotaka moto te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:12"
      },
      "items": [
        {
          "text": "ndenge mpe kizengi akokoka te kokoma mayele.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, soki opesi Ye motema na yo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:13"
      },
      "items": [
        {
          "text": "mpe osemboli maboko na yo epai na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki olongoli lisumu oyo ezali na loboko na yo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:14"
      },
      "items": [
        {
          "text": "mpe opekisi mabe kovanda kati na ndako na yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "okotombola elongi na yo na soni te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:15"
      },
      "items": [
        {
          "text": "okotelema ngwi mpe okobanga eloko te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te okobosana pasi na yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
