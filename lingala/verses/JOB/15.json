  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOB 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya Elifazi : moto mabe azwaka etumbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifazi, moto ya Temani, azwaki maloba mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Boni, moto ya bwanya akopesaka solo eyano",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "na maloba ya pamba boye, maloba oyo ezanga ata tina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "to alingaka kotondisa libumu na ye na mopepe ya moto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "oyo ewutaka na Este ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoki solo komilobela na maloba ezanga ata tina ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:3"
      },
      "items": [
        {
          "text": "Akoki solo kosalela maloba milayi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:3"
      },
      "items": [
        {
          "text": "oyo ezali ata na motuya te ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ozali penza kobebisa lokumu ya Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:4"
      },
      "items": [
        {
          "text": "okomi koboya lokumu liboso ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisumu na yo ezali kokamba monoko na yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:5"
      },
      "items": [
        {
          "text": "ozwi elobeli ya bakosi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monoko na yo moko nde ezali komemela yo etumbu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:6"
      },
      "items": [
        {
          "text": "kasi monoko na ngai te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:6"
      },
      "items": [
        {
          "text": "bibebu na yo moko nde ezali kofunda yo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nde moto ya liboso oyo obotama kati na bato ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:7"
      },
      "items": [
        {
          "text": "Omona moyi liboso ya bangomba mikuse ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osila koyoka makambo oyo elobamaka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:8"
      },
      "items": [
        {
          "text": "kati na Likita ya Nzambe ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:8"
      },
      "items": [
        {
          "text": "Bwanya ezalaka kaka epai na yo moko ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo nini oyebi, oyo biso toyebi te ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:9"
      },
      "items": [
        {
          "text": "Boyebi nini ozali na yango, oyo biso tozali na yango te ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngambo na biso, ezali na bato ya suki pembe, bampaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:10"
      },
      "items": [
        {
          "text": "bato oyo baleki tata na yo na mibu ya mbotama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobondisama ya Nzambe mpe maloba ya kimia",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:11"
      },
      "items": [
        {
          "text": "oyo bazali koloba mpo na yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:11"
      },
      "items": [
        {
          "text": "ekoki te mpo na yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini motema na yo ezali kopengwisa yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:12"
      },
      "items": [
        {
          "text": "mpe miso na yo ezali kobeta-beta ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete obwakela Nzambe kanda na yo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:13"
      },
      "items": [
        {
          "text": "mpe obimisa makambo ya boye na monoko na yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto azali nani mpo ete azala peto ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:14"
      },
      "items": [
        {
          "text": "Ye oyo abotami na mwasi azali nani mpo ete azala sembo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki Nkolo azali kondimela basantu na Ye te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:15"
      },
      "items": [
        {
          "text": "soki kutu likolo ezali peto te na miso na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekozala boni mpo na moto mabe, moto oyo abeba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:16"
      },
      "items": [
        {
          "text": "oyo asalaka mabe lokola azali komela mayi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoka ngai, mpe nakolimbolela yo !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
