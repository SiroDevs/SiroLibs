  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "JOB 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyebi tango nini bantaba ya ngomba ebotaka ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:1"
      },
      "items": [
        {
          "text": "Osila komona ndenge mboloko ebotaka ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osila kotanga basanza oyo ewumelaka na zemi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:2"
      },
      "items": [
        {
          "text": "Oyebi tango oyo ebotaka ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekogumbama, ekobota bana na yango",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:3"
      },
      "items": [
        {
          "text": "mpe ekolongwa na pasi na yango ya kobota.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana na yango ekozwa makasi, ekokola na libanda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:4"
      },
      "items": [
        {
          "text": "ekokende mosika mpe ekozonga lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akangoli ane ya zamba ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:5"
      },
      "items": [
        {
          "text": "Nani apesi yango bonsomi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai nde napesi yango esobe lokola ndako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:6"
      },
      "items": [
        {
          "text": "mpe mabele ya mungwa lokola esika ya kovanda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esekaka makelele ya bingumba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:7"
      },
      "items": [
        {
          "text": "mpe eyokaka te mongongo ya motambolisi ya mpunda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etambolaka na ngomba mpo na koluka bilei",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:8"
      },
      "items": [
        {
          "text": "mpe elukaka na bokebi matiti nyonso ya mobesu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpakasa ekoki kondima kosalela yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:9"
      },
      "items": [
        {
          "text": "Ekoki kolekisa butu na elielo na yo ya banyama ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoki kokanga mpakasa na singa ya ebende oyo ebalolaka mabele ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:10"
      },
      "items": [
        {
          "text": "Ekoki kolanda yo mpo na kotondisa mabwaku na mabele ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia solo elikya na yo kati na yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:11"
      },
      "items": [
        {
          "text": "mpo ete makasi na yango ezali monene ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:11"
      },
      "items": [
        {
          "text": "Okotikela yango mosala na yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotiela yango solo motema mpo na komemela yo bambuma",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:12"
      },
      "items": [
        {
          "text": "mpe kosangisa yango na etutelo na yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapapu ya maligbanga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        },
        {
          "text": "efungwamaka na esengo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:13"
      },
      "items": [
        {
          "text": "kasi, boni, lipapu mpe nsala na yango ekokani na oyo ya nkongi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maligbanga ebwakaka maki na yango na mabele",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:14"
      },
      "items": [
        {
          "text": "mpe etikaka yango ete ezwa moto ya mabele,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasi ebosanaka ete lokolo ekoki kopanza yango",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:15"
      },
      "items": [
        {
          "text": "mpe banyama ya zamba ekoki konyata-nyata yango.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyokolaka bana na yango makasi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:16"
      },
      "items": [
        {
          "text": "lokola nde ezali bana na yango te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 39:16"
      },
      "items": [
        {
          "text": "emonaka na yango motema pasi te",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:16"
      },
      "items": [
        {
          "text": "lokola nde esali mosala ya mpunda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te Nzambe apimeli yango bwanya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:17"
      },
      "items": [
        {
          "text": "mpe apesi yango mayele te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
