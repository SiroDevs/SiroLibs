  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JOB 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya mibale ya Tsofari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsofari, moto ya Naama, azwaki maloba mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.1",
            "verseOrgIds": [
              "JOB.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Makanisi na ngai ezali kotinda ngai ete nayanola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:2"
      },
      "items": [
        {
          "text": "nakoki kovanda nye te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:2"
      },
      "items": [
        {
          "text": "pamba te motema na ngai ekomi likolo-likolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali koyoka maloba mabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:3"
      },
      "items": [
        {
          "text": "maloba oyo eyokisi ngai soni !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:3"
      },
      "items": [
        {
          "text": "Kasi mayele na ngai elakisi ngai maloba ya kozongisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, oyebi malamu ete wuta kala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:4"
      },
      "items": [
        {
          "text": "wuta tango batia moto na likolo ya mabele,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "elonga ya bato mabe ezalaka ya tango moke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:5"
      },
      "items": [
        {
          "text": "mpe esengo ya moto oyo azangi boyengebene",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:5"
      },
      "items": [
        {
          "text": "ewumelaka kaka mwa tango moke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata molayi na ye emati kino likolo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:6"
      },
      "items": [
        {
          "text": "mpe moto na ye etuti mapata,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akobebisama libela lokola nyei na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:7"
      },
      "items": [
        {
          "text": "mpe bato oyo bakomona ye bakoloba : ‹ Azali wapi ? ›",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abungaka lokola ndoto, mpe bakomona ye lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:8"
      },
      "items": [
        {
          "text": "alimwaka lokola na ndoto ya butu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liso oyo ezalaki kotala ye ekomona ye lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:9"
      },
      "items": [
        {
          "text": "esika oyo azalaki kovanda ekomona ye lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bana na ye basengeli kofuta lomande epai ya babola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:10"
      },
      "items": [
        {
          "text": "maboko na ye ekozongisa bozwi oyo abotolaki,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mikuwa na ye oyo ezalaki makasi na bolenge",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:11"
      },
      "items": [
        {
          "text": "ekolala elongo na ye kati na putulu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mabe ezali sukali na monoko na ye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:12"
      },
      "items": [
        {
          "text": "mpe abombi yango na se ya lolemo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki ameki elengi na yango mpe atiki yango te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:13"
      },
      "items": [
        {
          "text": "soki abombi yango na se ya minu na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bilei na ye ekobongwana kati na libumu na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:14"
      },
      "items": [
        {
          "text": "ekokoma lokola ngenge ya nyoka kati na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amelaki na pamba bozwi ebele, asengeli kosanza yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:15"
      },
      "items": [
        {
          "text": "Nzambe akofutisa ye yango.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akofiba ngenge ya nyoka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:16"
      },
      "items": [
        {
          "text": "lolemo ya etupa ekoboma ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akomona lisusu te mayi mike, miluka, bibale,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:17"
      },
      "items": [
        {
          "text": "mayi oyo etiolaka makasi elongo na mafuta ya nzoyi mpe miliki ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "akozongisa bambuma ya mosala na ye mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:18"
      },
      "items": [
        {
          "text": "akomela ata moko te,",
          "type": "text",
