      },
      "items": [
        {
          "text": "mpe beta na ngambo ya loboko ya mwasi ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        }
