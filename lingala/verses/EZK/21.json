          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai mpe, nakobeta maboko na Ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
