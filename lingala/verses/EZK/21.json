    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 21:20"
      },
      "items": [
        {
          "text": "Tala, bangalisi yango mpo ete epela lokola mikalikali ;",
          "type": "text",
