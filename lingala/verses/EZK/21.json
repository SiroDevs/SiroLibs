      "attrs": {
        "style": "q2",
        "vid": "EZK 21:20"
      },
      "items": [
        {
          "text": "na bikuke nyonso ya bingumba na bango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        }
