    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mwana na moto, Nabukodonozori, mokonzi ya Babiloni, alendisaki makasi mampinga na ye mpo na kobundisa engumba Tiri ; mito ya basoda nyonso ekomaki mabandi mpe mapeka na bango elongwaki-longwaki baposo. Nzokande, ye mpe mampinga na ye batikalaki kozwa litomba ata moko te na mosala na bango ya kobundisa engumba Tiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tala liloba oyo Nkolo Yawe alobi : Nakokaba Ejipito na maboko ya Nabukodonozori, mokonzi ya Babiloni ; mpe ye, akobotola bomengo na yango, akozwa bomengo ya bitumba mpe akobebisa yango nyonso penza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napesi epai ya Nabukodonozori mokili ya Ejipito lokola lifuti mpo na misala na ye, pamba te ye mpe mampinga na ye basalaki mpo na Ngai, elobi Nkolo Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, nakobimisa liseke mpo na libota ya Isalaele ; nakofungola monoko na yo kati na bango, mpe bakoyeba solo ete Ngai, nazali Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        }
      ]
