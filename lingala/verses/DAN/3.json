  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "DAN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekeko ya wolo mpe libulu ya moto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Nabukodonozori asalisaki ekeko moko ya wolo, oyo ezalaki na bametele pene tuku misato na bosanda mpe bametele pene misato na mokuse. Atelemisaki yango kati na etando ya Dura, na etuka ya Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abengisaki bayangeli oyo atiaki na bituka, bakalaka oyo babatelaka biloko ya mokonzi, bayangeli, bapesi toli, babateli bomengo ya mokonzi, bato ya mibeko, basambisi mpe bakalaka nyonso ya bituka, mpo ete baya na feti ya kobandisa losambo ya ekeko oyo mokonzi Nabukodonozori asalisaki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bayangeli oyo atiaki na bituka, bakalaka oyo babatelaka biloko ya mokonzi, bayangeli, bapesi toli, babateli ya bomengo ya mokonzi, bato ya mibeko, basambisi mpe bakalaka nyonso ya bituka basanganaki mpo na feti ya kobandisa losambo ya ekeko oyo mokonzi Nabukodonozori asalisaki, mpe batelemaki liboso na yango.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molobeli ya mokonzi atatolaki na mongongo makasi :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:4"
      },
      "items": [
        {
          "text": "— Bino bato ya bikolo nyonso mpe ya nkota nyonso, tala makambo oyo bosengeli kosala :",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tango kaka bokoyoka lolaka ya kelelo, ya flite, ya lindanda ya moke, ya lindanda, ya nzenze, ya fanfari mpe makelele ya lolenge nyonso ya bibetelo mindule, bosengeli kofukama mpo na kogumbamela ekeko ya wolo oyo mokonzi Nabukodonozori asalisi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo akoboya kofukama mpo na kogumbamela ekeko yango, bakobwaka ye mbala moko kati na libulu ya moto. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tango kaka bayokaki lolaka ya kelelo, ya flite, ya lindanda ya moke, ya lindanda, ya nzenze, ya fanfari mpe makelele ya bibetelo mindule lolenge nyonso, bato ya bikolo nyonso, ya mikili nyonso mpe ya nkota nyonso bafukamaki mpo na kogumbamela ekeko ya wolo oyo mokonzi Nabukodonozori asalisaki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka na tango yango, ndambo ya bato ya soloka, oyo basalelaka minzoto bayaki kofunda Bayuda.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balobaki na mokonzi Nabukodonozori :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:9"
      },
      "items": [
        {
          "text": "— Oh mokonzi, tika ete owumela na bomoi seko na seko !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh mokonzi, opesaki mitindo ete moto nyonso oyo akoyoka lolaka ya kelelo, ya flite, ya lindanda ya moke, ya lindanda, ya nzenze, ya fanfari mpe makelele ya lolenge nyonso ya bibetelo mindule afukama mpo na kogumbamela ekeko ya wolo ;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe ete moto nyonso oyo akoboya kofukama mpo na kogumbamela ekeko yango, babwaka ye kati na libulu ya moto !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi, mokonzi, ezali na ndambo ya Bayuda oyo okomisaki bayangeli na etuka ya Babiloni : Shadraki, Meshaki mpe Abedinego, oyo bazali kotosa yo ata moke te : bazali kosalela banzambe na yo te mpe kogumbamela te ekeko ya wolo oyo osali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Nabukodonozori atombokaki makasi mpe abengisaki Shadraki, Meshaki mpe Abedinego. Boye, bamemaki bango liboso ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukodonozori atunaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:14"
      },
      "items": [
        {
          "text": "— Shadraki, Meshaki mpe Abedinego, ezali penza ya solo ete bozali kosalela banzambe na ngai te mpe bozali kogumbamela te ekeko ya wolo oyo nasali ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, bomibongisa ! Tango kaka bokoyoka lolaka ya kelelo, ya flite, ya lindanda ya moke, ya lindanda, ya nzenze, ya fanfari mpe makelele ya nyonso ya bibetelo mindule, bokofukama mpo na kogumbamela ekeko oyo nasali. Soki boboyi kogumbamela yango, bokobwakama mbala moko kati na libulu ya moto. Boye, tokotala soki nzambe nini akokoka kokangola bino na maboko na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shadraki, Meshaki mpe Abedinego bazongiselaki mokonzi Nabukodonozori :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:16"
      },
      "items": [
        {
          "text": "— Tozali na tina na komibundela te na likambo oyo liboso na yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki babwaki biso kati na libulu ya moto, Nzambe oyo tosalelaka azali na makoki ya kobikisa biso wuta na libulu yango mpe ya kokangola biso na maboko na yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ata soki abikisi na Ye biso te, tolingi mokonzi oyeba ete, biso, tokosalela banzambe na yo te mpe tokogumbamela te ekeko ya wolo oyo osalaki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukodonozori atombokelaki makasi Shadraki, Meshaki mpe Abedinego, mpe akangelaki bango elongi ; apesaki mitindo ete bapelisa moto makasi penza mbala sambo koleka ndenge bapelisaka yango tango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo apesaki mitindo na ndambo ya basoda ya mpiko kati na mampinga na ye ete bakanga Shadraki, Meshaki mpe Abedinego basinga mpe babwaka bango kati na libulu ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bakangaki Shadraki, Meshaki mpe Abedinego basinga, wana balataki bilamba na bango, banzambala na bango, bakazaka na bango, bitendi na bango oyo bakangaka na moto mpe bilamba mosusu, mpe babwakaki bango kati na libulu ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
            "verseOrgIds": [
              "DAN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola mokonzi apesaki mitindo ete bapelisa moto ya libulu ya moto makasi penza, moto yango ebomaki basoda oyo babwakaki Shadraki, Meshaki mpe Abedinego kati na libulu ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.22",
            "verseOrgIds": [
              "DAN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Shadraki, Meshaki mpe Abedinego bakweyaki kati na libulu yango ya moto, bakanga bango basinga makasi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisungi ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Nabukodonozori akamwaki mpe atelemaki na lombangu ; atunaki bapesi toli na ye :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:24"
      },
      "items": [
        {
          "text": "— Boni, tobwakaki te bato misato kati na moto, bakanga bango basinga ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 3:24"
      },
      "items": [
        {
          "text": "Bazongiselaki mokonzi :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:24"
      },
      "items": [
        {
          "text": "— Mokonzi, tosalaki bongo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na bapesi toli na ye :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:25"
      },
      "items": [
        {
          "text": "— Botala ! Nazali komona bato minei bazali kotambola kati na moto, bakangama basinga te mpe moto ezali kozikisa bango te ; mpe moto ya minei azali lokola mwana ya banzambe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukodonozori apusanaki pene ya monoko ya libulu ya moto mpe agangaki na mongongo makasi :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:26"
      },
      "items": [
        {
          "text": "— Shadraki, Meshaki mpe Abedinego, basali ya Nzambe-Oyo-Aleki-Likolo, bobima kuna mpe boya awa !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 3:26"
      },
      "items": [
        {
          "text": "Shadraki, Meshaki mpe Abedinego babimaki wuta na libulu ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayangeli oyo mokonzi atiaki na bituka, bakalaka oyo babatelaka biloko ya mokonzi, bayangeli mpe bapesi toli ya mokonzi bazingelaki bango ; mpe bamonaki ete moto ezikisaki te ezala banzoto na bango, suki ya mito na bango to bilamba na bango, mpe batikalaki koyoka bango ata solo ya moto te.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukodonozori alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "DAN 3:28"
      },
      "items": [
        {
          "text": "— Tika ete Nzambe ya Shadraki, Meshaki mpe Abedinego akumisama ; Ye nde atindaki anjelu na Ye mpo ete abikisa basali na Ye, pamba te batielaka Ye motema ! Batosaki mitindo ya mokonzi te mpe bandimaki kobungisa bomoi na bango na esika ya kosalela mpe kogumbamela nzambe mosusu, soki Nzambe na bango te.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, nazwi mokano ete moto nyonso, azala ya mokili, ekolo to lokota nini, oyo akoloba mabe mpo na Nzambe ya Shadraki, Meshaki mpe Abedinego, bakokata-kata ye na biteni, bakobuka ndako na ye mpe bakokomisa yango mopiku ya mbindo, pamba te Nzambe mosusu azali te, oyo akoki kobikisa bato na Ye na lolenge oyo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, mokonzi atombolaki Shadraki, Meshaki mpe Abedinego kati na etuka ya Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
            "verseOrgIds": [
              "DAN.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndoto ya nzete monene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Nabukodonozori alobaki na bato ya bikolo, ya bamboka mpe ya nkota nyonso, oyo bavandaka na mokili mobimba :",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.31",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 3:31"
      },
      "items": [
        {
          "text": "Natombeli bino kimia monene !",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.31",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali na esengo ya koyebisa bino bikamwa mpe makambo minene oyo Nzambe-Oyo-Aleki-Likolo asali mpo na ngai !",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.32",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikamwa na Ye ezali solo minene,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 3:33"
      },
      "items": [
        {
          "text": "makambo minene na Ye elakisaka nguya na Ye !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 3:33"
      },
      "items": [
        {
          "text": "Bokonzi na Ye ezali na suka te,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 3:33"
      },
      "items": [
        {
          "text": "ewumelaka seko na seko !",
          "type": "text"
        }
      ]
    }
  ],
