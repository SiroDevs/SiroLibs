{
  "id": "JHN.2",
  "number": "2",
  "bookId": "JHN",
  "reference": "Yoane 2",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JHN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likamwisi ya liboso : Yesu abongoli mayi vino",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mikolo mibale, ezalaki na feti moko ya libala na mboka Kana ya Galile. Mama ya Yesu azalaki na feti yango.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.1",
            "verseOrgIds": [
              "JHN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babengisaki mpe Yesu elongo na bayekoli na Ye na feti yango.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.2",
            "verseOrgIds": [
              "JHN.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esalemaki ete tango vino esilaki, mama ya Yesu alobaki na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.3",
            "verseOrgIds": [
              "JHN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:3"
      },
      "items": [
        {
          "text": "— Bazali lisusu na vino te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yesu azongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.4",
            "verseOrgIds": [
              "JHN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mwasi, biso na yo likambo nini ? Tango na Ngai ekoki nanu te.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mama na Ye alobaki na basali :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.5",
            "verseOrgIds": [
              "JHN.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:5"
      },
      "items": [
        {
          "text": "— Bosala makambo nyonso oyo akoloba na bino.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki wana na bambeki motoba ya mabanga, oyo Bayuda bazalaki kosalela mpo na komipetola. Mbeki moko na moko ekokaki kokota balitele kobanda tuku mwambe kino nkama moko na tuku mibale.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.6",
            "verseOrgIds": [
              "JHN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yesu alobaki na basali :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.7",
            "verseOrgIds": [
              "JHN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Botondisa bambeki oyo na mayi.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 2:7"
      },
      "items": [
        {
          "text": "Batondisaki yango meke.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.7",
            "verseOrgIds": [
              "JHN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Sik'oyo, botoka mayi wuta na bambeki mpe bomema yango epai ya mokambi ya feti.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 2:8"
      },
      "items": [
        {
          "text": "Bamemaki yango epai na mokambi ya feti.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokambi ya feti amekaki mayi oyo Yesu abongolaki vino. Ayebaki te soki basali bazwaki vino yango wapi ; nzokande bango moko basali bayebaki, pamba te bango nde batokaki mayi. Mbala moko, mokambi ya feti abengaki mobali oyo abalaki",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.9",
            "verseOrgIds": [
              "JHN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe alobaki na ye : « Bato nyonso bapesaka nanu vino oyo eleki kitoko ; bongo, sima na babengami komela mingi, nde bayaka na vino oyo ya kitoko penza te. Kasi yo, obombi na yo vino oyo eleki kitoko kino sik'oyo ! »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.10",
            "verseOrgIds": [
              "JHN.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nde ezalaki likamwisi ya liboso, oyo Yesu asalaki : esalemaki na Kana ya Galile. Ezalaki moko kati na bikamwa oyo, na nzela na yango, amonisaki nkembo na Ye ; mpe bayekoli na Ye bandimaki Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Yesu akendeki elongo na mama na Ye, bandeko na Ye mpe bayekoli na Ye, na Kapernawumi epai wapi basalaki kaka mwa mikolo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kokoso ya liboso kati na Tempelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.21.12-MAT.21.17"
          },
          "items": [
            {
              "text": "Mat 21.12-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.11.15-MRK.11.17"
          },
          "items": [
            {
              "text": "Mlk 11.15-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.19.45-LUK.19.46"
          },
          "items": [
            {
              "text": "Lk 19.45-46",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola mokolo oyo Bayuda basepelaka feti ya Pasika ekomaki pene, Yesu akendeki na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango akotaki kati na lopango ya Tempelo, akutaki bato bazali koteka bangombe, bameme mpe bibenga ; amonaki lisusu bato oyo babongolaka mbongo bavandi liboso ya bamesa na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, asalaki fimbu ya basinga mpe abenganaki bango nyonso, longwa na lopango ya Tempelo, elongo na bangombe mpe bameme na bango ; abalolaki bamesa ya bato oyo bazalaki kobongola mbongo, mpe apanzaki mbongo na bango na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na bato oyo bazalaki koteka bibenga :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Bolongola biloko oyo awa ! Ezali Ndako ya Tata na Ngai ! Ebandi ndenge nini bokomisa yango zando ? »",
              "type": "text",
              "attrs": {
                "verseId": "JHN.2.16",
                "verseOrgIds": [
                  "JHN.2.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayekoli na Ye babandaki kokanisa makambo oyo ekomama : « Oh Nzambe, bolingo makasi oyo nazali na yango mpo na Ndako na Yo ekozikisa ngai lokola na moto ! »",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayuda balobaki na Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:18"
      },
      "items": [
        {
          "text": "— Likamwisi nini okoki kolakisa biso mpo na kotalisa biso ete ozali na bokonzi ya kosala makambo oyo nyonso ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.19",
            "verseOrgIds": [
              "JHN.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:19"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bobuka Tempelo oyo, mpe Ngai nakotonga yango lisusu na mikolo misato.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayuda balobaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 2:20"
      },
      "items": [
        {
          "text": "— Boni, soki esalaki mibu tuku minei na motoba mpo na kotonga lisusu Tempelo oyo, yo okanisi ete okotelemisa yango na mikolo misato ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande Tempelo oyo Yesu azalaki kolobela, ezalaki nde nzoto na Ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima, tango Yesu asekwaki, bayekoli na Ye basosolaki makambo oyo alobaki na bango. Boye bandimaki Makomi mpe maloba oyo Yesu alobaki.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        }
      ]
    },
