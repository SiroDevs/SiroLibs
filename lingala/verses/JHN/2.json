              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yesu amipesaki te epai na bango, pamba te ayebaki bato nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
            "verseOrgIds": [
