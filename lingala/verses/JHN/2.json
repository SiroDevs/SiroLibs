              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Yesu azalaki kati na Yelusalemi mpo na feti ya Pasika, bato mingi bandimelaki Kombo na Ye tango bazalaki komona bikamwa oyo azalaki kosala.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
            "verseOrgIds": [
