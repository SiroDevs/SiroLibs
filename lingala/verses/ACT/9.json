{
  "id": "ACT.9",
  "number": "9",
  "bookId": "ACT",
  "reference": "Misala ya Bantoma 9",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ACT 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo abongoli motema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Saulo azalaki kaka kokanela mpe koluka koboma bayekoli ya Nkolo. Akendeki epai ya mokonzi ya Banganga-Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.1",
            "verseOrgIds": [
              "ACT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe asengaki ye mikanda ya mosala mpo na bandako ya mayangani ya Damasi, mpo ete, soki akuti kuna bato oyo bazali kolanda nzela ya Nkolo, akanga bango mpe amema bango na Yelusalemi, ezala basi to mibali.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.2",
            "verseOrgIds": [
              "ACT.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana azalaki kokende na Damasi mpe akomaki pene ya engumba yango, amonaki mbala moko pole moko kowuta na likolo mpe kongengela ye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.3",
            "verseOrgIds": [
              "ACT.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akweyaki na mabele mpe ayokaki mongongo moko koloba na ye :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.4",
            "verseOrgIds": [
              "ACT.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Saulo, Saulo, mpo na nini ozali konyokola Ngai ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo atunaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:5"
      },
      "items": [
        {
          "text": "— Nkolo, yo nani ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:5"
      },
      "items": [
        {
          "text": "Mongongo ezongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Ngai, nazali Yesu oyo yo ozali konyokola.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi sik'oyo, telema, kota kati na engumba, mpe, kuna, bakoyebisa yo makambo oyo osengeli kosala.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bazalaki kokende mobembo elongo na Saulo batelemaki mpe bazangaki maloba ya koloba ; bayokaki mongongo yango, kasi bamonaki moto moko te.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.7",
            "verseOrgIds": [
              "ACT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo atelemaki wuta na mabele ; kasi tango afungolaki miso, amonaki lisusu te. Boye, basimbaki ye na loboko mpe bamemaki ye na Damasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.8",
            "verseOrgIds": [
              "ACT.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikolo misato, akokaki komona te, aliaki eloko te mpe amelaki eloko te.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na Damasi, ezalaki na moyekoli moko oyo kombo na ye ezalaki « Ananiasi. » Nkolo abengaki ye kati na emoniseli :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Ananiasi !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:10"
      },
      "items": [
        {
          "text": "Azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:10"
      },
      "items": [
        {
          "text": "— Nkolo, ngai oyo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Telema, kende na ndako ya Yuda, oyo ezali na balabala oyo babengaka « Alima » mpe tuna moto moko ya mboka Tarse, kombo na ye « Saulo. » Azali kosambela",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpe, kati na emoniseli, awuti komona moto moko kokota mpe kotia ye maboko mpo ete amona lisusu ; kombo na ye « Ananiasi. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananiasi azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.13",
            "verseOrgIds": [
              "ACT.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:13"
      },
      "items": [
        {
          "text": "— Nkolo, bato ebele bayebisi ngai makambo na tina na moto yango mpe mabe nyonso oyo asali babulami na Yo, na Yelusalemi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe ayei awa, na Damasi, mpo ete bakonzi ya Banganga-Nzambe bapesi ye bokonzi ya kokanga bato nyonso oyo babelelaka Kombo na Yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Nkolo alobaki na Ananiasi :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Kende, pamba te nasila kopona moto wana lokola esalelo na Ngai mpo na kosakola Kombo na Ngai epai ya bikolo ya bapaya, epai ya bakonzi na bango mpe epai ya bana ya Isalaele.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nakolakisa ye ndenge nini asengeli konyokwama mpo na Kombo na Ngai.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Ananiasi akendeki mpe akotaki kati na ndako ; atielaki Saulo maboko na koloba :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.17",
            "verseOrgIds": [
              "ACT.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:17"
      },
      "items": [
        {
          "text": "— Ndeko na ngai, Saulo ; Nkolo Yesu oyo abimelaki yo na nzela, wana ozalaki koya awa, atindi ngai mpo ete omona lisusu mpe otonda na Molimo Mosantu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka na tango yango, biloko moko lokola biteku ekweyaki wuta na miso ya Saulo, mpe akomaki lisusu komona. Atelemaki mpe azwaki libatisi ;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.18",
            "verseOrgIds": [
              "ACT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe, sima na ye kolia, nzoto na ye ezongaki lisusu makasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 9:19"
      },
      "items": [
        {
          "text": "Saulo atatoli mpo na Yesu-Klisto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:19"
      },
      "items": [
        {
          "text": "Saulo avandaki mwa mikolo elongo na bayekoli oyo bazalaki kati na Damasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka na tango yango, abandaki koteya na bandako ya mayangani ete Yesu azali Mwana na Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso oyo bayokaki ye bakamwaki mingi mpe batunaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.21",
            "verseOrgIds": [
              "ACT.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:21"
      },
      "items": [
        {
          "text": "— Boni, ezali ye te moto oyo azalaki konyokola makasi, kati na Yelusalemi, bato oyo babelelaka Kombo ya Yesu ? Boni, ayei awa te mpo na kokanga mpe komema bango epai ya bakonzi ya Banganga-Nzambe ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, kondima ya Saulo ezalaki se kokoba kolendisama mpe azalaki kondimisa Bayuda oyo bavandaka na Damasi ete Yesu azali Klisto.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.22",
            "verseOrgIds": [
              "ACT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mikolo ebele, Bayuda bayokanaki koboma Saulo ;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasi Saulo ayokaki sango na tina na mabongisi na bango. Butu mpe moyi, bazalaki kokengela bikuke ya engumba mpo na koluka koboma ye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
            "verseOrgIds": [
              "ACT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bayekoli ya Saulo bamemaki ye na butu mpe babimisaki ye libanda ya mir, na kokitisa ye kati na kitunga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo kati na Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Saulo akomaki na Yelusalemi, amekaki kosangana na bayekoli, kasi bango nyonso bazalaki kobanga ye, pamba te bazalaki penza kondima te ete akomi penza moyekoli.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
            "verseOrgIds": [
              "ACT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barnabasi azwaki ye mpe amemaki ye epai ya bantoma ; ayebisaki bango ndenge nini Saulo, na mobembo na ye, amonaki Nkolo, mpe ete Nkolo alobaki na ye. Ayebisaki bango lisusu ndenge nini, kati na Damasi, ateyaki na mpiko na Kombo na Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, wuta na tango wana, Saulo avandaki elongo na bango, azalaki kokende mpe kozonga na bonsomi kati na Yelusalemi, wana azalaki koteya na mpiko, na Kombo ya Nkolo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo azalaki kosolola mpe kotia tembe na Bayuda oyo balobaka lokota ya Greki ; nzokande, bango, bazalaki koluka nzela ya koboma ye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bandimi bayokaki likambo yango, bamemaki Saulo na Sezarea, mpe, longwa kuna, batindaki ye na Tarse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na Yuda mobimba, Galile mpe Samari, Lingomba ezalaki na kimia, ezalaki kolenda mpe kotosa Nkolo, mpe motango ya bandimi na yango ezalaki kobakisama na lisungi ya Molimo Mosantu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lobiko ya Ene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola Petelo azalaki kosala mibembo kati na mboka mobimba, akendeki mpe kotala basantu oyo bazalaki kovanda kati na Lidi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.32",
            "verseOrgIds": [
              "ACT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna, amonaki moto moko alala na etoko wuta mibu mwambe mpo ete azalaki kobela bokono ya bukabuka ; kombo na ye « Ene. »",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.33",
            "verseOrgIds": [
              "ACT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.34",
            "verseOrgIds": [
              "ACT.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:34"
      },
      "items": [
        {
          "text": "— Ene, Yesu-Klisto abikisi yo ; telema mpe kanga etoko na yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:34"
      },
      "items": [
        {
          "text": "Mbala moko, Ene atelemaki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.34",
            "verseOrgIds": [
              "ACT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bavandi nyonso ya Lidi mpe ya esobe ya Saroni bamonaki ye, bandimelaki Nkolo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisekwa ya Tabita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na Jafa, ezalaki na mwasi moyekoli moko, kombo na ye ezalaki « Tabita. » Na lokota ya Greki, kombo na ye ezalaki Dorkasi (oyo elingi koloba : Mboloko). Azalaki tango nyonso kosala bolamu mpe kosunga babola.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.36",
            "verseOrgIds": [
              "ACT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo wana, akomaki kobela mpe akufaki. Sima na kosukola nzoto na ye, batiaki yango kati na shambre ya likolo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.37",
            "verseOrgIds": [
              "ACT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bayekoli bayokaki sango ete Petelo azali kati na Lidi oyo ezali penza pene ya Jafa, batindelaki ye mibali mibale mpo na kosenga na ye : « Tobondeli yo, yaka noki ! »",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.38",
            "verseOrgIds": [
              "ACT.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbala moko, Petelo akendeki elongo na bango ; mpe tango akomaki, bamemaki ye na shambre ya likolo. Basi nyonso oyo bakufisa mibali bayaki kozingela ye, bazalaki kolela mpe kolakisa ye banzambala mpe bilamba mosusu oyo Dorkasi asalaki, wana azalaki nanu elongo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.39",
            "verseOrgIds": [
              "ACT.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo abimisaki bato nyonso ; bongo afukamaki mpe asambelaki. Wana azalaki kotala epai ebembe ya mama Dorkasi ezalaki, alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.40",
            "verseOrgIds": [
              "ACT.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 9:40"
      },
      "items": [
        {
          "text": "— Tabita, telema !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:40"
      },
      "items": [
        {
          "text": "Tabita afungolaki miso ; mpe wana amonaki Petelo, avandaki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.40",
            "verseOrgIds": [
              "ACT.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo asimbaki ye na loboko na ye mpe atelemisaki ye. Bongo abengaki bandimi, mingi-mingi basi oyo bakufisa mibali, mpe alakisaki bango Dorkasi ya bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.41",
            "verseOrgIds": [
              "ACT.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sango yango epanzanaki kati na engumba mobimba ya Jafa, mpe bato mingi bandimelaki Nkolo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.42",
            "verseOrgIds": [
              "ACT.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo avandaki tango molayi kati na Jafa, epai ya moto moko oyo kombo na ye ezalaki « Simona ; » azalaki mobongisi baposo ya banyama.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.43",
            "verseOrgIds": [
              "ACT.9.43"
            ]
          }
        }
      ]
    }
  ],
