        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngomba ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala makambo oyo Ezayi, mwana mobali ya Amotsi, amonaki na tina na Yuda mpe Yelusalemi :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo oyo ekoya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "ngomba ya Tempelo ya Yawe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "ekolendisama ngwi na songe ya bangomba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "ekoleka bangomba mikuse nyonso na molayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "mpe bikolo nyonso ekokende kotondana kuna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya bikolo ebele bakokende kuna mpe bakoloba :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "« Boya, tomata na ngomba ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "na Tempelo ya Nzambe ya Jakobi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Akoteya biso banzela na Ye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "mpo ete tolanda banzela mike na Ye. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Pamba te Mobeko ekowuta na Siona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "mpe Liloba na Yawe ekowuta na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akozala Mosambisi kati na bikolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "akokata makambo ya kowelana kati na bato ebele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Bakotumba mipanga na bango na moto",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "mpo na kosala bakongo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "mpe makonga na bango mpo na kosala bambeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Ekolo moko te ekotombola lisusu mopanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "mpo na kobundisa ekolo mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "bato bakoyekola lisusu te kobunda bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh ndako ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:5"
      },
      "items": [
        {
          "text": "yaka, tika ete totambola na pole ya Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mokolo ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, osundolaki bato na Yo, libota ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "mpo ete batondisami na bizaleli ya soloka oyo ewuti na Este ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "bazali kosalela maji lokola bato ya Filisitia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "bazali kosala boyokani elongo na bapagano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili na bango etondi na palata mpe wolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "bomengo na bango ezali na suka te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "Mokili na bango etondi na bampunda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "mpe bakoki ata moke te kotanga bashar na bango ya bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili na bango etondi na banzambe ya bikeko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "bato bakomi kofukamela biloko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "oyo esalemi na maboko na bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "oyo misapi na bango esili kosala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, bato bakokitisa mito,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "mpe bato ya lokumu bakotonda na soni ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "kolimbisa bango te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimela na madusu ya mabanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "bombama na putulu ya mabele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "liboso ya nguya ya kanda ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "liboso ya nkembo ya lokumu na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, moto ya lolendo akokitisa elongi,",
