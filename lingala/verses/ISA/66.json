      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:16"
      },
      "items": [
        {
          "text": "na nzela ya moto mpe ya mopanga ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
