      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "Nzokande, kaka tango Siona ayoki pasi ya kobota,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
