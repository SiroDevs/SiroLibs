          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akosambisa bato nyonso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
