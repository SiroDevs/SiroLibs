      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:16"
      },
      "items": [
        {
          "text": "bongo, bato ebele bakokufa na mopanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:16"
      },
      "items": [
