  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ISA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moabi esengi lisungi na Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botinda mpate lokola mpako epai ya mokambi ya mokili ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "wuta na Sela kino na ngomba Siona, mboka kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "bokatisa esobe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakobengana basi ya Moabi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "lokola bandeke na zala na yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "na suka ya ebale ya Arinoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Pesa biso toli, kamata mokano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Sala ete elili na yo ezala lokola butu na moyi makasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Bomba bato oyo bakimeli epai na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "kobimisa bango te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bato ya Moabi oyo bakimi epai na yo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "bawumela elongo na yo !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Zala nguba na bango liboso ya mobomi. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Tango minyoko ekokoma na suka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "kobebisama ekotikala lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "mpe koboma ekosila na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiti ya bokonzi ekolendisama na bolingo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "moto moko akovanda na kiti yango na bosolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "akobimela na ndako ya Davidi :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "alukaka bosembo kati na kosambisa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "mpe alongisaka makambo ya bosembo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyokaki sango ya lolendo ya Moabi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "ndenge atombolaka mapeka :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "lolendo na ye oyo eleka ndelo mpe lofundu na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "lolendo mpe maloba na ye ya lofundu ezanga na yango tina.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, bato ya Moabi bakosala matanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "bakomilela bango na bango mpo na Moabi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "Bolela mpe bozala na mawa mpo na mikate ya Kiri-Aresheti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "oyo basala na bambuma ya vino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete bilanga ya Eshiboni esili kokawuka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "elongo na bilanga ya vino ya Sibima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Bakambi ya bikolo babukaki-bukaki bitape na yango oyo eleki kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "oyo ekenda kino na Yaezeri mpe eleka kino na esobe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Bitape yango ezalaki epanzana makasi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "mpe ekenda mosika kino na ebale monene.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, nazali kolela lokola Yaezeri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "mpo na vino ya Sibima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Eshiboni mpe Eleale, nazali kosopa mpinzoli mpo na bino !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Koganga ya esengo esili mpo bambuma na bino",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "mpe mpo na biloko oyo bobuki na bilanga na bino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo mpe kosepela ebungi na bilanga ya kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "banzembo mpe koganga ya esengo ezali lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "kati na bilanga ya vino !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
