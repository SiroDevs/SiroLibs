  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "ISA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawa na bato oyo batalelaka Ejipito",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na bato oyo bazali kokende",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "na Ejipito mpo na koluka lisungi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "oyo bazali kotia mitema na bampunda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "oyo bazali kotia elikya na bashar",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "mpo ete ezali ebele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "mpe na nguya ya basoda oyo batambolisaka yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "kasi batalelaka Mosantu ya Isalaele te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "mpe balukaka lisungi epai na Yawe te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Ye mpe azali na bwanya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "mpe akoki koyeisa pasi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "abongolaka maloba na Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "Atelemelaka ndako ya bato mabe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "mpe bato oyo basungaka bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Ejipito bazali kaka bato, kasi bazali Nzambe te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "bampunda na bango ezali kaka mosuni, kasi ezali molimo te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "Tango Yawe akosembola loboko na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "ye oyo asungaka akobeta libaku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "mpe ye oyo bazali kosunga akokweya ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "bongo, bango mibale bakobebisama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezali Yawe nde Abikisaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobi na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "« Ndenge nkosi to mwana nkosi egangaka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "liboso ya mosuni na yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "ata lisanga monene ya babateli bibwele basangani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "mpo na kotelemela yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "ezalaka na somo ya makelele na bango te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "mpe ezongaka sima te na mangungu na bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "ndenge wana mpe Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "akokita na ngomba Siona mpe na ngomba na yango ya moke",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "mpo na kobunda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge ndeke efungolaka mapapu na yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "ndenge wana mpe Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "akobatela Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "akobatela mpe akokangola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "akobikisa yango na likama mpe akosunga yango. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh bana ya Isalaele, bozonga epai na Ye oyo botombokeli makasi !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, moko na moko kati na bino akobwaka banzambe na ye ya bikeko ya palata mpe ya wolo oyo bosalaki na maboko na bino ya masumu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mokili ya Asiri ekokweyisama na mopanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "ya moto ya mokili oyo te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "ekobebisama na mopanga ya moto te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "Bato ya Asiri bakokima liboso ya mopanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "mpe basoda na bango ya bilenge bakokoma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "kosala misala ya makasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libanga na bango ya makasi ekolimwa na somo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "mpe bakambi na bango bakolenga na somo na komona bendele ya etumba, »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
