      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:3"
      },
      "items": [
        {
          "text": "mpe ekoti ya bokonzi kati na loboko ya Nzambe na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
