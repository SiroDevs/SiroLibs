          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "Bakobenga yo na kombo ya sika",
