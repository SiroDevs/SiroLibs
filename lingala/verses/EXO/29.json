      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libulisi ya Banganga-Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge okosala mpo na kobulisa Aron elongo na bana na ye ya mibali, na mosala ya bonganga-Nzambe mpo ete basalela Ngai. Okozwa mwana ngombe ya mobali mpe bameme mibale ya mibali, ezanga mbeba ;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "okosala mapa mpe bagato ezanga levire, oyo farine na yango basangisa na mafuta ; okosala mpe mikate ezanga levire, kasi bapakola yango mafuta ; okosala yango na farine oyo batuta mpe bayungola malamu.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia yango nyonso na kitunga moko mpe okomema yango na ekuke ya Mongombo, elongo na mwana ngombe ya mobali mpe bameme mibale ya mibali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomema Aron mpe bana na ye ya mibali na ekotelo ya Ndako ya kapo ya Bokutani mpe okosukola bango na mayi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa bilamba ya bule mpe okolatisa Aron nzambala, kazaka, efode mpe elamba ya tolo ; mpe okokanga ye mokaba ya efode.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokanga ye kitendi na moto mpe okobakisa na likolo ya kitendi yango elembo ya libulisi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa mafuta ya epakolami, okosopa yango na moto na ye mpe okopakola ye yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomema bana na ye ya mibali mpe okolatisa bango banzambala.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okolatisa Aron mpe bana na ye ya mibali mikaba na loketo na bango mpe okolatisa bango bikoti. Na bongo, okobulisa bango na mosala ya bonganga-Nzambe oyo ekozala ya bango kolanda mobeko ya libela na libela.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomema ngombe ya mobali liboso ya Ndako ya kapo ya Bokutani ; Aron mpe bana na ye ya mibali bakotia maboko na bango na moto na yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokata ngombe yango kingo liboso na Ngai Yawe, na ekotelo ya Ndako ya kapo ya Bokutani.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa ndambo ya makila ya ngombe yango, mpe okosalela mosapi na yo mpo na kotia makila yango na maseke ya etumbelo ; okosopa na makolo ya etumbelo makila oyo ekotikala.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa mafuta nyonso oyo ezalaka pembeni-pembeni ya biloko ya kati, mafuta oyo ezipaka bafwa mpe bambuma nyonso mibale oyo ezalaka kati na loketo elongo na mafuta na yango ; mpe okotumba yango na etumbelo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi okotumba na libanda ya molako misuni ya ngombe yango, poso na yango mpe nyei na yango. Ezali mbeka mpo na masumu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa lisusu meme moko ya mobali ; Aron mpe bana na ye ya mibali bakotia maboko na bango na moto na yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokata meme yango kingo, okozwa makila na yango mpe okosopa yango na bapembeni nyonso ya etumbelo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokata-kata meme yango na biteni, okosukola biloko na yango ya kati elongo na makolo na yango mpe okotia yango likolo ya biteni mosusu mpe likolo ya moto.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotumba meme mobimba ya mobali na etumbelo ; ezali mbeka ya kotumba mpo na Yawe, likabo bazikisa na moto mpo na Yawe, likabo oyo solo kitoko na yango esepelisaka Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa meme mosusu ya mobali ; Aron elongo na bana na ye ya mibali bakotia maboko na bango na moto na yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokata meme yango kingo, okozwa ndambo ya makila na yango mpe okotia yango na songe ya litoyi ya ngambo ya loboko ya mobali ya Aron mpe ya bana na ye ya mibali. Okotia yango lisusu na mosapi ya monene ya loboko na bango ya ngambo ya mobali mpe na mosapi ya monene ya lokolo na bango ya ngambo ya loboko ya mobali.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa makila oyo ekozala na etumbelo mpe mafuta ya epakolami, okosopela yango Aron mpe bilamba na ye, bana na ye mpe bilamba na bango. Na bongo, ye mpe bana na ye elongo na bilamba na bango bakobulisama.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala biteni ya mafuta ya meme ya mobali oyo okozwa : mokila, mafuta nyonso oyo ezalaka pembeni-pembeni ya biloko ya kati, mafuta oyo ezipi bafwa, bambuma mibale oyo ezalaka kati na loketo elongo na mafuta na yango mpe mopende ya ngambo ya mobali, pamba te meme yango ya mobali ezali ya libulisi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala biloko oyo okozwa kati na kitunga ya mapa ezanga levire, oyo ezali liboso ya Yawe : lipa moko, gato moko balamba na mafuta mpe galeti moko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia biloko oyo nyonso na maboko ya Aron mpe ya bana na ye ya mibali ; okoyebisa bango ete batombola yango liboso ya Yawe lokola likabo ya kotombola.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa yango lisusu na maboko na bango mpe okotumba yango na etumbelo, na likolo ya mbeka ya kotumba ; ezali likabo bazikisa na moto mpo na Yawe, likabo oyo solo kitoko na yango esepelisaka Yawe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozwa tolo ya meme ya mobali mpo na kobulisa Aron, okotombola yango liboso ya Yawe lokola mbeka ya kotombola ; ekozala eteni na yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okobulisa biteni ya libulisi mpo na Aron mpe bana na ye ya mibali : tolo mpe mopende ya meme oyo batombolaki mpo na kobonzela Yawe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biteni yango ekozala ya Aron mpe ya bana na ye ya mibali lokola mobeko ya libela na libela. Pamba te ezali makabo ya bana ya Isalaele mpo na Yawe, makabo oyo ekowuta na mbeka na bango ya boyokani.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilamba ya bule ya Aron ekotikala sima na ye epai ya bana na ye. Bakolata yango tango bakopakola bango mafuta mpe bakobulisa bango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikolo sambo, moko kati na bana na ye ya mibali oyo akokitana na ye lokola Nganga-Nzambe, akolata yango mpe akokota na Ndako ya kapo ya Bokutani mpo na kosala mosala ya bonganga-Nzambe kati na Esika ya bule.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokamata meme ya mobali ya libulisi mpe okolamba mosuni na yango na esika moko ya bule.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aron mpe bana na ye ya mibali bakolia mosuni ya meme mpe lipa oyo ezali kati na kitunga, na ekotelo ya Ndako ya kapo ya Bokutani.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka bango nde bakolia makabo oyo na nzela na yango mosala ya bolimbisi masumu esalemaki tango babulisaki bango mpo na mosala ya bonganga-Nzambe ; kasi moto oyo abulisama te akoki kolia yango te, pamba te ezali bule.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mosuni ya mbeka ya libulisi mpe lipa ekomi kino na tongo, okotumba yango na moto. Bakoki kolia yango lisusu te, pamba te ezali bule.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala mpo na Aron mpe mpo na bana na ye ya mibali makambo nyonso oyo natindi yo. Okosala mikolo sambo mpo na kobulisa bango na mosala ya bonganga-Nzambe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo na mokolo, okobonza mbeka ya ngombe ya mobali lokola mbeka mpo na bolimbisi masumu. Okopetola etumbelo na nzela ya mosala ya bolimbisi masumu, oyo okosala mpo na etumbelo yango mpe okosopela yango mafuta ya epakolami mpo na kobulisa yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikolo sambo, okosala mosala ya bolimbisi masumu na etumbelo mpo na kobulisa yango. Boye etumbelo ekokoma bule koleka mpe nyonso oyo ekotutana na yango ekokoma bule.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbeka ya kotumba ya mokolo na mokolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 29:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala mbeka oyo okopesela mitindo ete batumbaka mokolo na mokolo na etumbelo mpo na libela : bana meme mibale ya mobu moko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotumba mwana meme moko na tongo, mpe mosusu, na pokwa.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na mwana meme ya liboso, okopesa bakilo misato ya farine basangisa na litele moko na kati-kati ya litele ya mafuta, mpe okosopa litele moko na kati-kati ya litele ya vino lokola mbeka ya masanga.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 29:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na mwana meme ya mibale, okobonza yango na pokwa elongo na lolenge moko ya makabo oyo obonzaki na tongo : farine, mafuta mpe mbeka ya masanga ya vino ; okobonza yango lokola likabo bazikisa na moto mpo na Yawe, oyo solo kitoko na yango esepelisaka Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 29:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali mbeka ya kotumba ya tango nyonso, kati na bikeke nyonso : bokobanda kotumba yango na ekuke ya Ndako ya kapo ya Bokutani liboso ya Yawe ; ezali na esika wana nde nakobanda kokutana mpe kolobana na bino.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 29:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na esika yango nde nakobanda kokutana na bana ya Isalaele ; bongo nkembo na Ngai ekobulisa esika yango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 29:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakobulisa Ndako ya kapo ya Bokutani mpe etumbelo ; nakobulisa lisusu Aron mpe bana na ye ya mibali mpo ete basalela Ngai lokola Banganga-Nzambe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 29:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye nakovanda kati na bana ya Isalaele mpe nakozala Nzambe na bango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 29:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoyeba solo ete Ngai nazali Yawe, Nzambe na bango, Nzambe oyo abimisaki bango wuta na Ejipito mpo na kovanda kati na bango. Nazali Yawe, Nzambe na bango.",
          "type": "text"
        }
      ]
    }
  ],
