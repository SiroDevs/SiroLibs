          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobi azongaki epai ya Izaki, tata na ye, na Mamire, pene ya Kiriati-Ariba oyo ebengami Ebron, epai wapi Abrayami mpe Izaki bazalaki kovanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
