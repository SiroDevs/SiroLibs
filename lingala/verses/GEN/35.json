          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaki awumelaki na bomoi mibu nkama moko na tuku mwambe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
