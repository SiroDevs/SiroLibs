              "type": "text"
            }
          ]
        },
        {
          "text": "Tala lisolo ya libota ya Adamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        }
      ]
