              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na kobota Enoshi, Seti awumelaki lisusu na bomoi mibu nkama mwambe na sambo mpe abotaki bana mosusu ya mibali mpe ya basi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
