  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "GEN 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Lisolo ya libota ya Jakobi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndoto ya Jozefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobi avandaki na mokili ya Kanana epai wapi tata na ye azalaki kovanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.1",
            "verseOrgIds": [
              "GEN.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala molongo ya libota ya Jakobi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 37:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:2"
      },
      "items": [
        {
          "text": "Elenge mobali Jozefi azalaki na mibu zomi na sambo ya mbotama mpe azalaki kobatela bibwele. Azalaki kosala mosala yango elongo na bandeko na ye ya mibali, bana ya Bila mpe ya Zilipa, basi ya tata na ye. Jozefi azalaki koyebisa tata na bango makambo mabe ya bandeko na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele azalaki kolinga Jozefi mingi koleka bana na ye nyonso, pamba te abotaki ye na kimobange. Asalelaki ye elamba ya kitoko mpe ya talo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.3",
            "verseOrgIds": [
              "GEN.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bandeko na ye ya mibali bamonaki ete tata na bango azali kolinga ye koleka bango nyonso, bayinaki ye mpe bakokaki lisusu te koloba na ye na motema malamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.4",
            "verseOrgIds": [
              "GEN.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jozefi alotaki ndoto mpe tango ayebisaki yango epai ya bandeko na ye ya mibali, bayinaki ye lisusu makasi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.5",
            "verseOrgIds": [
              "GEN.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.6",
            "verseOrgIds": [
              "GEN.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:6"
      },
      "items": [
        {
          "text": "— Boyoka ndoto oyo nalotaki :",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tozalaki kokanga maboke ya ble kati na bilanga. Mbala moko, liboke na ngai elamuki mpe etelemi ngwi ; bongo maboke na bino, oyo ezalaki zingazinga ya liboke na ngai, egumbamaki liboso ya liboke na ngai. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandeko na ye ya mibali balobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.8",
            "verseOrgIds": [
              "GEN.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:8"
      },
      "items": [
        {
          "text": "— Okanisi ete okokoma mokonzi na biso mpe okokonza biso ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:8"
      },
      "items": [
        {
          "text": "Bongo bayinaki ye lisusu koleka likolo ya ndoto na ye mpe likolo ya makambo oyo alobaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.8",
            "verseOrgIds": [
              "GEN.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotaki lisusu ndoto mosusu mpe ayebisaki yango epai ya bandeko na ye ya mibali. Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.9",
            "verseOrgIds": [
              "GEN.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:9"
      },
      "items": [
        {
          "text": "— Boyoka, naloti lisusu ndoto mosusu : « Namonaki moyi, sanza mpe minzoto zomi na moko kogumbama liboso na ngai. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango ayebisaki tata na ye ndenge ayebisaki bandeko na ye ya mibali, tata na ye agangelaki ye mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.10",
            "verseOrgIds": [
              "GEN.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:10"
      },
      "items": [
        {
          "text": "— Ndoto nini wana yo osili kolota ? Okanisi ete ngai, mama na yo mpe bandeko na yo ya mibali, tokoya mpe tokogumbama na mabele liboso na yo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandeko na ye ya mibali bakomaki na motema likunya epai na ye, kasi tata na ye abombaki kaka likambo yango na motema.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.11",
            "verseOrgIds": [
              "GEN.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jozefi atekami lokola mowumbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandeko mibali ya Jozefi bakendeki koleisa bibwele ya tata na bango pembeni ya Sishemi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.12",
            "verseOrgIds": [
              "GEN.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele alobaki na Jozefi :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:13"
      },
      "items": [
        {
          "text": "— Oyebi ete bandeko na yo bazali koleisa bibwele pembeni ya Sishemi ; yaka, pamba te nalingi kotinda yo epai na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:13"
      },
      "items": [
        {
          "text": "Jozefi azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:13"
      },
      "items": [
        {
          "text": "— Malamu !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata na ye alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:14"
      },
      "items": [
        {
          "text": "— Kende mpe tala soki makambo nyonso ezali kotambola malamu mpo na bandeko na yo mpe mpo na bibwele, bongo omemela ngai sango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:14"
      },
      "items": [
        {
          "text": "Boye, atindaki ye wuta na lubwaku ya Ebron. Wana Jozefi akomaki na Sishemi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "moto moko amonaki ye tango azalaki koyengayenga na bilanga. Atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.15",
            "verseOrgIds": [
              "GEN.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:15"
      },
      "items": [
        {
          "text": "— Ozali koluka nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jozefi azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.16",
            "verseOrgIds": [
              "GEN.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:16"
      },
      "items": [
        {
          "text": "— Nazali koluka bandeko na ngai. Okoki koyebisa ngai esika nini bazali koleisa bibwele na bango ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto yango azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:17"
      },
      "items": [
        {
          "text": "— Balongwaki awa mpe nayokaki bango koloba : « Tokende na Dotani. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:17"
      },
      "items": [
        {
          "text": "Boye Jozefi alandaki bandeko na ye mpe amonaki bango pembeni ya Dotani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bango bamonaki ye na mosika liboso ete akoma pene na bango, bayokanaki mpo ete baboma ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.18",
            "verseOrgIds": [
              "GEN.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balobanaki bango na bango :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.19",
            "verseOrgIds": [
              "GEN.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:19"
      },
      "items": [
        {
          "text": "— Tala moloti bandoto azali koya.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, boya mpo ete toboma ye mpe tobwaka ye na moko kati na mabulu oyo. Tokoloba ete nyama mabe eliaki ye. Bongo tokotala oyo ekoya sima na bandoto na ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Ribeni ayokaki bongo, alukaki nzela ya kokangola ye na maboko na bango. Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.21",
            "verseOrgIds": [
              "GEN.37.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:21"
      },
      "items": [
        {
          "text": "— Toboma ye te !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosopa makila na ye te ! Bobwaka ye kaka na libulu oyo ezali kati na esobe, kasi bosala ye mabe te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:22"
      },
      "items": [
        {
          "text": "Ribeni alobaki bongo pamba te azalaki na makanisi ya kokangola ye na maboko na bango mpe kozongisa ye na maboko ya tata na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.22",
            "verseOrgIds": [
              "GEN.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango kaka Jozefi akomaki epai ya bandeko na ye ya mibali, balongolaki ye elamba na ye ya kitoko mpe ya talo oyo alataki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.23",
            "verseOrgIds": [
              "GEN.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakangaki ye mpe babwakaki ye na libulu. Libulu yango ezalaki na eloko te, ezalaki mpe na mayi te na kati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana bavandaki mpo na kolia, batombolaki miso mpe bamonaki bato ya libota ya Isimaeli elongo na bashamo na bango koya wuta na Galadi. Bashamo na bango ezalaki komema na Ejipito : biloko ya mike-mike ya solo kitoko oyo balambelaka, mafuta ya solo kitoko mpe mire.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.25",
            "verseOrgIds": [
              "GEN.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Yuda alobaki na bandeko na ye ya mibali : « Litomba nini tokozwa soki tobomi ndeko na biso mpe tozipi makila na ye ?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
            "verseOrgIds": [
              "GEN.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malamu toteka ye epai ya bato ya ekolo ya Isimaeli, kasi toboma ye te ; pamba te azali kaka ndeko na biso mpe tozali na ye makila moko. » Boye bandeko na ye bandimaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.27",
            "verseOrgIds": [
              "GEN.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande tango bato ya mombongo ya mokili ya Madiani balekaki wana, babimisaki Jozefi wuta na libulu mpe batekaki ye epai ya bato ya ekolo ya Isimaeli, na motuya ya mbongo ya bibende, tuku mibale ; mpe bango bamemaki ye na Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Ribeni azongaki na libulu mpe amonaki ete Jozefi azali lisusu kuna te, apasolaki bilamba na ye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "azongaki epai ya bandeko na ye mpe alobaki : « Elenge mobali azali lisusu kuna te ! Sik'oyo ngai, nakosuka wapi ? »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye babomaki ntaba, bazwaki elamba ya Jozefi mpe bazindisaki yango na makila ya ntaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima, bazongisaki elamba yango ya kitoko mpe ya talo epai ya tata na bango. Balobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:32"
      },
      "items": [
        {
          "text": "— Tala eloko oyo tomoni ; tala yango malamu soki ezali penza elamba ya mwana na yo to te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobi asosolaki ete ezali elamba ya Jozefi mpe agangaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 37:33"
      },
      "items": [
        {
          "text": "— Ezali elamba ya mwana na ngai ! Nyama moko ya mabe elie ye ! Solo, bakati-kati Jozefi na biteni !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobi apasolaki bilamba na ye, alataki saki mpe asalaki matanga mpo na mwana na ye mikolo ebele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana na ye nyonso ya mibali mpe ya basi bayaki kobondisa ye ; kasi aboyaki kobondisama. Alobaki : « Te ; nakozala na matanga kino nakolanda mwana na ngai na mboka ya bakufi epai wapi mwana na ngai azali. » Boye, tata na ye alelaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya mokili ya Madiani batekaki Jozefi na Ejipito epai ya Potifari, kalaka ya lokumu ya Faraon mpe mokonzi ya bakengeli ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
      ]
    }
  ],
