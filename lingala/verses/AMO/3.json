      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:10"
      },
      "items": [
        {
          "text": "mpe na biloko oyo babotoli na makasi. › »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
