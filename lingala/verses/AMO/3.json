          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, tala liloba oyo Nkolo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "« Monguna moko akozingela yo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "akosukisa yo mpe akobotola na makasi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "biloko kati na bandako na yo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:11"
      },
      "items": [
