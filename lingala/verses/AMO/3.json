      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:10"
      },
      "items": [
        {
          "text": "‹ batondisi bandako na bango na bomengo ya bitumba",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
