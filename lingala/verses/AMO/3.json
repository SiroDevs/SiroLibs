    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makebisi mpe pamela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh bana ya Isalaele, boyoka liloba oyo Yawe alobi na tina na bino, na tina na etuka nyonso oyo nabimisaki na Ejipito :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Bozali etuka moko kaka oyo Ngai napona",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "kati na bituka nyonso ya mabele ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "yango wana nakopesa bino etumbu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "mpo na mabe nyonso oyo bosali.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, bato mibale bakoki solo kotambola nzela moko",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:3"
      },
      "items": [
        {
          "text": "soki bayokani te ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi ekoki solo koganga na zamba",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "soki emoni te nyama ya kolia ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "Mwana nkosi ekoki penza konguluma",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "na esika oyo evandaka soki ekangi nyama te ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeke ekoki solo kokangama na motambo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "oyo ezali na mabele",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "soki ezangi eloko ya kolia ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "Motambo ekoki solo koningana",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "soki ekangi eloko te ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, kelelo ya bitumba ekoki solo kobeta kati na engumba,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:6"
      },
      "items": [
        {
          "text": "bongo bato bazanga kobanga ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:6"
      },
      "items": [
        {
          "text": "Pasi ekoki solo koya na engumba",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:6"
      },
      "items": [
        {
          "text": "soki Yawe atindi yango te ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, Nkolo Yawe asalaka eloko moko te",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:7"
      },
      "items": [
        {
          "text": "soki alakisi mabongisi na Ye te",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:7"
      },
      "items": [
        {
          "text": "epai ya basali na Ye, basakoli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi egangi ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "nani akobanga te ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "Nkolo Yawe alobi ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
