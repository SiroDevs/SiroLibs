      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "ezali kosalema kati na yango !",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
