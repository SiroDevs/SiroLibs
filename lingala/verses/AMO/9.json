    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobebisama ya Esika ya bule",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namonaki Yawe atelemi pene ya etumbelo, mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "« Buka makonzi ya Tempelo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "mpo ete ndako mobimba eningana",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "mpe ekweyela bato nyonso na mito.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Bato oyo bakotikala,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "nakoboma bango na mopanga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Moko te akokima, moko te akobika.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki bakimi na se ya mabele, na mboka ya bakufi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "loboko na Ngai ekobimisa bango kuna ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "soki bakimi na Lola,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "nakokitisa bango na se.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki babombami na songe ya ngomba Karimeli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "nakokanga bango mpe nakokitisa bango na se ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "soki babombami Ngai na se ya ebale monene,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "nakopesa mitindo na nyoka ete eswa bango kuna.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala banguna na bango bamemi bango na bowumbu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "nakopesa mitindo na mopanga ete eboma bango kuna.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "AMO 9:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "Miso na Ngai ekozala likolo na bango",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "mpo na kosala bango mabe, kasi bolamu te.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki Yawe, Mokonzi ya mampinga, asimbi mabele,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "mabele eninganaka,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "mpe bavandi na yango nyonso bakomaka na matanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "mokili mobimba etelemaka lokola ebale Nili",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "mpe ekawukaka lokola mayi ya Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atonga ndako na Ye kati na Lola",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "mpe atia miboko na yango na mabele ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "abengaka mayi ya ebale monene",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "mpe asopaka yango na etando ya mabele.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "Kombo na Ye ezali : Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etumbu ya bato nyonso ya masumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bana ya Isalaele, boni, bokokani te",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "na bato ya mokili ya Kushi ? »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "« Boni, nabimisaki te Isalaele wuta na Ejipito,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "bato ya Filisitia wuta na Kreti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "bato ya Siri wuta na Kiri ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, miso ya Nkolo Yawe ezali kotala bokonzi ya masumu ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "nakobebisa mpe nakolongola yango na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "Nzokande, nakobebisa te libota mobimba ya Jakobi, »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:8"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
