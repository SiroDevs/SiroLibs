{
  "id": "JDG.1",
  "number": "1",
  "bookId": "JDG",
  "reference": "Bilombe 1",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JDG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaele ayei kovanda na Kanana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na kufa ya Jozue, bana ya Isalaele batunaki Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 1:1"
      },
      "items": [
        {
          "text": "— Libota nini kati na biso ekokende liboso mpo na kobundisa bato ya Kanana ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.2",
            "verseOrgIds": [
              "JDG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 1:2"
      },
      "items": [
        {
          "text": "— Libota ya Yuda nde ekokende liboso, pamba te napesi mokili oyo na maboko na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo bato ya libota ya Yuda balobaki na bandeko na bango ya libota ya Simeoni :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 1:3"
      },
      "items": [
        {
          "text": "— Boya elongo na biso mpo ete tobundisa bato ya Kanana, mpo na eteni ya mabele oyo epesamelaki biso. Bongo, biso mpe tokokende elongo na bino, na eteni ya mabele na bino.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 1:3"
      },
      "items": [
        {
          "text": "Boye, bato ya libota ya Simeoni bakendeki elongo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango libota ya Yuda ekotaki na bitumba, Yawe akabaki bato ya Kanana mpe ya Perizi na maboko na bango, mpe babomaki bato nkoto zomi, na Bezeki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki kuna nde bakutaki Adoni-Bezeki mpe babundisaki ye. Balongaki bato ya Kanana mpe ya Perizi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.5",
            "verseOrgIds": [
              "JDG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoni-Bezeki akimaki ; kasi balandaki ye mpe bakangaki ye, bakataki ye misapi ya minene ya maboko mpe ya makolo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.6",
            "verseOrgIds": [
              "JDG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoni-Bezeki alobaki : « Bakonzi tuku sambo, oyo bakata bango misapi ya minene ya maboko mpe ya makolo, bazalaki kolokota biloko oyo ezalaki kokweya na se ya mesa na ngai. Sik'oyo, Nzambe azongiseli ngai makambo oyo nasalaki baninga. »",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 1:7"
      },
      "items": [
        {
          "text": "Bamemaki ye na Yelusalemi, mpe akufaki kuna.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Yuda babundisaki Yelusalemi mpe babotolaki yango ; babomaki bato ya engumba yango na mopanga mpe batiaki yango moto.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.8",
            "verseOrgIds": [
              "JDG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, bato ya libota ya Yuda bakendeki kobundisa bato ya Kanana oyo bazalaki kovanda na mokili ya bangomba, na Negevi, mpe na etando oyo ezalaki pembeni ya ebale.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.9",
            "verseOrgIds": [
              "JDG.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Yuda babundisaki lisusu bato ya Kanana oyo bazalaki kovanda na Ebron, oyo kombo na yango ezalaki na kala « Kiriati-Ariba. » Balongaki Sheshayi, Ayimani mpe Talimayi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.10",
            "verseOrgIds": [
              "JDG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Longwa wana, bapusanaki mpe bakendeki kobundisa bavandi ya Debiri oyo kombo na yango ezalaki na kala « Kiriati-Seferi. »",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.11",
            "verseOrgIds": [
              "JDG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebi alobaki : « Nakopesa na libala Akisa, mwana na ngai ya mwasi, epai ya moto nyonso oyo akobundisa mpe akobotola Kiriati-Seferi. »",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.12",
            "verseOrgIds": [
              "JDG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otinieli, mwana mobali ya Kenazi, ndeko ya Kalebi, abotolaki yango ; boye Kalebi apesaki Akisa, mwana na ye ya mwasi, na libala epai ya Otinieli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.13",
            "verseOrgIds": [
              "JDG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, tango Akisa akomaki na ndako ya Otinieli, atindikaki ye ete asenga elanga epai ya Kalebi, tata na ye. Boye, tango Akisa akitaki wuta na ane na ye, Kalebi atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.14",
            "verseOrgIds": [
              "JDG.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 1:14"
      },
      "items": [
        {
          "text": "— Olingi nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisa azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 1:15"
      },
      "items": [
        {
          "text": "— Salela ngai ngolu. Lokola opesaki ngai eteni ya mabele kati na Negevi, pesa ngai lisusu bitima.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 1:15"
      },
      "items": [
        {
          "text": "Boye, Kalebi apesaki ye bitima ya likolo mpe ya se.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani ya Keni oyo azalaki bokilo ya Moyize balongwaki na engumba ya banzete ya Mbila elongo na bato ya libota ya Yuda, mpe bakendeki kovanda esika moko na bavandi ya esobe ya Yuda, oyo ezali na sude ya Aradi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.16",
            "verseOrgIds": [
              "JDG.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Yuda elongo na bandeko na bango ya libota ya Simeoni bakendeki kobundisa bato ya Kanana oyo bazalaki kovanda na Tsefati, mpe babebisaki bango. Yango wana, bapesaki engumba yango kombo « Orima. »",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.17",
            "verseOrgIds": [
              "JDG.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Yuda babotolaki lisusu Gaza, Ashikeloni mpe Ekroni, elongo na mabele na yango ya pembeni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.18",
            "verseOrgIds": [
              "JDG.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azalaki elongo na bato ya libota ya Yuda. Babotolaki mokili ya bangomba, kasi balongaki te kobengana bavandi ya etando, pamba te bazalaki na bashar ya bibende.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolanda ndenge Moyize alobaki, bapesaki na Kalebi engumba Ebron. Mpe Kalebi abenganaki na Ebron bana mibali misato ya Anaki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, bato ya libota ya Benjame babenganaki te bato ya Yebusi oyo bazalaki kovanda na Yelusalemi. Boye, kino na mokolo ya lelo, bato ya Yebusi bavandaka esika moko na bato ya libota ya Benjame.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato kati na ndako ya Jozefi bamataki mpo na kobundisa Beteli, mpe Yawe azalaki elongo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango libota ya Jozefi etindaki bato ete bakende kononga engumba Beteli oyo bazalaki kobenga na kala Luze,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
              "JDG.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "banongi bamonaki moto moko kobima na engumba mpe balobaki na ye : « Lakisa biso esika nini tokoki kokotela na kati ya engumba, mpe tokosalela yo bolamu. »",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.24",
            "verseOrgIds": [
              "JDG.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, alakisaki bango esika ya kokotela na kati na engumba. Mpe babomaki bato ya engumba yango na mopanga, kasi babikisaki moto wana elongo na libota na ye mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto yango akendeki na mokili ya bato ya Iti mpe atongaki kuna engumba oyo apesaki kombo « Luze » oyo etikala kino lelo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bato ya libota ya Manase babenganaki te bato ya Beti-Sheani mpe bamboka na yango ya mike, bato ya Taanaki mpe bamboka na yango ya mike, bato ya Dori mpe bamboka na yango ya mike, bato ya Yibileayimi mpe bamboka na yango ya mike, bato ya Megido mpe bamboka na yango ya mike ; pamba te bato ya Kanana batingamaki kaka kovanda na mokili yango.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bana ya Isalaele bakomaki lisusu makasi, bakomaki kosalisa bato ya Kanana misala makasi, kasi babenganaki bango nyonso te.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Efrayimi babenganaki te bato ya Kanana oyo bazalaki kovanda na Gezeri, mpe bato ya Kanana bakobaki kovanda esika moko na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Zabuloni babenganaki te bavandi ya Kitroni mpe ya Naaloli. Bato ya Kanana bakobaki kovanda esika moko na bango, kasi bakomaki kosalisa bango misala makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Aseri babenganaki te bato ya Ako, ya Sidoni, ya Ayilabi, ya Akizibi, ya Eliba, ya Afiki mpe ya Reobi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo na yango, bato ya libota ya Aseri bakomaki kovanda esika moko na bato ya Kanana oyo bazalaki kovanda na mokili yango.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya libota ya Nefitali babenganaki te bato oyo bazalaki kovanda na Beti-Shemeshi mpe na Beti-Anati. Boye, bakomaki kovanda esika moko na bato ya Kanana oyo bazalaki kovanda na mokili yango ; kasi bato ya Beti-Shemeshi mpe ya Beti-Anati bakomaki kosala misala makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Amori batindikaki libota ya Dani mosika, na likolo ya bangomba, mpo ete balonga te kokita na etando ya polele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bato ya Amori mpe batingamaki kaka kovanda na Ari-Eresi, na Ayaloni mpe na Shaalibimi. Kasi tango ndako ya Jozefi ekomaki lisusu na nguya, bakomaki kosalisa bango misala makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mondelo ya mabele ya bato ya Amori ezalaki longwa na Libanga ya Sela, elekaki na bangomba ya Akarabimi kino na likolo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        }
      ]
    }
