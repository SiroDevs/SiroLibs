{
  "id": "JER.13",
  "number": "13",
  "bookId": "JER",
  "reference": "Jeremi 13",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JER 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mokaba ya lino",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobaki na ngai : « Kende kosomba mokaba ya lino mpe lata yango na loketo na yo, kasi kopolisa yango na mayi te. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, nasombaki mokaba, ndenge Yawe atindaki ngai mpe nalataki yango na loketo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na ngai lisusu na mbala ya mibale :",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Kamata mokaba oyo osombaki mpe oyo olati na loketo na yo, kende sik'oyo na Perati mpe bomba yango kuna kati na madusu ya mabanga. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.4",
            "verseOrgIds": [
              "JER.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye nakendeki kobomba mokaba yango na Perati, ndenge Yawe alobaki na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mikolo ebele, Yawe alobaki na ngai lisusu : « Kende kokamata mokaba oyo nalobaki na yo ete obomba na Perati. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakendeki na Perati, nalukaki mokaba yango epai nabombaki yango ; kasi mokaba yango ebebaki makasi mpe etikalaki lisusu na tina te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala liloba oyo Yawe alobi : ‹ Ezali boye nde nakosilisa lolendo ya Yuda mpe nakokitisa mapeka ya Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bazali bato mabe, bayokaka maloba na Ngai te, bazali mito makasi, batingamaka kosala kolanda baposa ya mitema na bango, mpe balandaka banzambe ya bapaya mpo na kosalela mpe kogumbamela yango ; bakokoma kaka lokola mokaba oyo, mokaba oyo etikali lisusu na tina te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ndenge balingaka mokaba na loketo, ndenge wana mpe nalingaki libota mobimba ya Isalaele mpe libota mobimba ya Yuda epai na Ngai, › elobi Yawe, ‹ mpo ete bazala bato na Ngai mpe basala lokumu ya Kombo na Ngai. Kasi batikali koyoka Ngai te. ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vino ya kanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bango : ‹ Tala liloba oyo Yawe, Nzambe ya Isalaele, alobi : Mbeki nyonso esengeli kotonda na masanga ya vino. › Mpe soki batuni yo : ‹ Boni, okanisi ete biso toyebi te ete mbeki nyonso esengeli kotonda na masanga ya vino ? ›",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebisa bango : ‹ Tala liloba oyo Yawe alobi : Nakolangwisa bavandi nyonso ya mokili oyo masanga ; ezala bakonzi oyo bavandaka na kiti ya bokonzi ya Davidi, Banganga-Nzambe, basakoli mpe bavandi nyonso ya Yelusalemi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosala ete babomana bango na bango, batata mpe bana na bango, elobi Yawe, eloko moko te ekopekisa Ngai koboma bango, ezala motema monene to mawa to ngolu. › »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makebisi mpo na kokima bowumbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka malamu mpe bosala keba !",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "text": "Bosala lolendo te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "text": "pamba te ezali Yawe nde alobi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bopesa nkembo epai na Yawe, Nzambe na bino,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "liboso ete amemela bino molili,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "liboso ete makolo na bino ebeta mabaku",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "na bangomba oyo ezipami na molili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "Bino bozali kozela pole,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "kasi Ye akobongola yango molili makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki boyoki te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "nakolela na nkuku mpo na lolendo na bino,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "nakolela makasi, mpe miso na ngai ekosopa mpinzoli,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "pamba te etonga ya Yawe ekokende na bowumbu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na mokonzi mpe na mama ya mokonzi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:18"
      },
      "items": [
        {
          "text": "« Bolongwa na bakiti na bino ya bokonzi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:18"
      },
      "items": [
        {
          "text": "pamba te mitole na bino ya nkembo ekolongwa na mito na bino. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bingumba ya sude ekokangama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:19"
      },
      "items": [
        {
          "text": "mpe moto moko te akokoka kofungola yango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:19"
      },
      "items": [
        {
          "text": "Bato nyonso ya Yuda bakokende na bowumbu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:19"
      },
      "items": [
        {
          "text": "bango nyonso penza bakokende.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yelusalemi, tombola miso na yo mpe tala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
