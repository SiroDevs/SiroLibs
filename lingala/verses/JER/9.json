      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:16"
      },
      "items": [
        {
          "text": "« Botala malamu makambo oyo !",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
