              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobi : « Makambo oyo nyonso ekomeli bango mpo ete basundoli Mobeko na Ngai oyo natiaki liboso na bango, batosi Ngai te mpe basaleli malako na Ngai te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
