      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libota ya bakosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ah ! Soki nazalaki ata na ndako ya bapaya kati na esobe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "nalingaki ata kokima bato na ngai",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "mpe kozala mosika na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "pamba te bango nyonso bazali bandumba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "bazali lisanga ya bakosi !",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Babongisaka lolemo na bango",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "lokola tolotolo mpo na kokosa ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "balongaka kati na mokili na nzela ya solo te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "pamba te basalaka se mabe likolo ya mabe",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "mpe batosaka Ngai te, »",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tika ete moto na moto asala keba na moninga na ye",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "mpe atia motema te na ndeko na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "pamba te ndeko nyonso azali moto ya lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "mpe moninga nyonso azali moto ya matongi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moninga azali kokosa moninga na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "mpe moto moko te azali koloba solo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "Bamibongisaka mpo na koloba lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "babimisaka motoki na bango mpo na kosala masumu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosala na bango se kokosa na kokosa ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "mpe na lokuta na bango, baboyaka kotosa Ngai, »",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tala liloba oyo Yawe, Mokonzi ya mampinga, alobi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "« Tala, nakopetola mpe nakomeka bango na moto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "pamba te nasala lisusu nini",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "mpo na masumu ya bato na Ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolemo na bango ezali lokola likonga oyo ebomaka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "ebimisaka kaka maloba ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "Moto na moto alobaka na moninga na ye",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "na esengo na monoko ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "kasi na se ya motema, atielaka ye motambo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo na makambo ya boye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "napesa bango etumbu te, »",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "elobi Yawe ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "« Nazongisa mabe na mabe te na ekolo ya boye ? »",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosala matanga mpe nakolela",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "mpo na bangomba mpe matiti ya esobe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "Nyonso esili kokawuka",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "mpe moto moko te azali lisusu kolekela wana ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "ezala makelele ya bibwele to ya bandeke",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "ezali lisusu koyokana te ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "bandeke ya likolo ekimi",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "mpe banyama ya zamba esili kokende.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
