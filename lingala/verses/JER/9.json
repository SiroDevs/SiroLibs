          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, batiaki kaka mito makasi mpe bakobaki kolanda banzambe ya Bala oyo batata na bango balakisaki bango. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        }
      ]
    },
    {
