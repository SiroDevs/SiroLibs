{
  "id": "JER.3",
  "number": "3",
  "bookId": "JER",
  "reference": "Jeremi 3",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JER 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwasi ya ndumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Soki mobali abomi libala na mwasi na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "mpe mwasi yango akei kobala mobali mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "boni, mobali yango akoki lisusu kozongela ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Bomoni te ete mokili mobimba ekokoma penza mbindo ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Nzokande yo, osalaki kindumba na mibali ebele,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "bongo olingi sik'oyo kozongela Ngai, »",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tombola miso na yo na likolo ya bangomba mpe tala :",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Boni, ezali penza na esika epai wapi ozangaki kosala ekobo ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Ovandaki na nzela mpo na kozela bamakangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "ovandaki wana lokola moto ya Arabi kati na esobe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Boye, okomisaki mokili mbindo",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "na nzela ya ekobo na yo mpe ya misala na yo ya mabe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, mvula ekangamaki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "mpe mvula ya sima enokaki lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "Kasi atako bongo, okangami kaka na kosala kindumba na yo",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "mpe oboyi koyoka soni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, obengaka Ngai te :",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:4"
      },
      "items": [
        {
          "text": "‹ Tata na ngai, moninga na ngai ya bomwana ! ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozali kutu kotuna Ngai :",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "‹ Boni, kino tango nini okokanga kanda ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Kotomboka na yo ekosila te ? ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Yango nde makambo ozali koloba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "kasi ozali mpe kaka kokoba na misala na yo ya mabe. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaele apengwi nzela ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Joziasi azalaki mokonzi, Yawe alobaki na ngai : « Omoni makambo Isalaele oyo apengwi nzela na Ngai azali kosala ? Amataki likolo ya bangomba nyonso mpe atambolaki na se ya banzete nyonso ya mibesu mpo na kosala kindumba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakanisaki ete akozongela Ngai soki asilisi kosala makambo nyonso oyo azalaki na yango posa ; kasi azongeli Ngai te, mpe ndeko na ye ya mwasi, mopengwi Yuda, amonaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napesaki mopengwi Isalaele mokanda na ye ya koboma libala mpe nabenganaki ye likolo ya kindumba na ye ; kasi namonaki ete ndeko na ye ya mwasi, mopengwi Yuda, abangaki te ; ye mpe abimaki mpo na kosala kindumba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.8",
            "verseOrgIds": [
              "JER.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola ezalaki likambo ya pamba mpo na Isalaele kosala kindumba, akomisaki mokili mbindo mpe asalaki kindumba na banzambe ya bikeko oyo basala na mabanga mpe na banzete.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.9",
            "verseOrgIds": [
              "JER.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atako bongo, ndeko na ye ya mwasi, mopengwi Yuda, azongaki epai na Ngai te na motema na ye mobimba ; azongaki na ye kaka likolo-likolo, » elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na ngai : « Mopengwi Isalaele azali sembo koleka mopengwi Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kende kosakola sango oyo na nor :",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "‹ Oh mopengwi Isalaele, zonga, ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "elobi Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "‹ Nakokangela yo lisusu elongi te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "pamba te nazali Moyengebene, ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "‹ Nakokangela yo lisusu kanda te mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndima kaka mabe na yo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "mpo ete otombokelaki Yawe, Nzambe na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "obebisaki ngolu na yo epai ya banzambe ya bapaya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "na se ya banzete nyonso ya mibesu,",
          "type": "text",
          "attrs": {
