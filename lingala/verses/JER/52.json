          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bongo na mobu ya tuku mibale na misato ya bokonzi ya Nabukodonozori,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Nebuzaradani, mokonzi ya bakengeli ya mokonzi, amemaki na bowumbu Bayuda nkama sambo na tuku minei na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
