          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayuda nkama mwambe na tuku misato na mibale oyo bawutaki na Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
