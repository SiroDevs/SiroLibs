    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Bango nyonso bazalaki bato nkoto minei na nkama motoba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeoyakini abimi na boloko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yeoyakini, mokonzi ya Yuda, akokisaki mibu tuku misato na sambo na bowumbu, Evili-Merodaki, mokonzi ya Babiloni, ayokelaki Yeoyakini, mokonzi ya Yuda, mawa mpe abimisaki ye na boloko, na mokolo ya tuku mibale na mitano ya sanza ya zomi na mibale, kaka na mobu oyo akomaki mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evili-Merodaki asololaki na Yeoyakini na boboto mpe apesaki ye lokumu koleka bakonzi mosusu oyo bazalaki elongo na ye, na bowumbu kati na Babiloni ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "apesaki mitindo ete balongola ye bilamba ya boloko mpe andimaki ete abanda kolia mesa moko elongo na ye, mokolo na mokolo kino na suka ya bomoi na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi ya Babiloni azalaki kopesa ye nyonso oyo asengeli na yango mikolo nyonso ya bomoi na ye kino na mokolo ya kufa na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
