      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "Tika ete mongongo na yo eyokana kino na Bashani !",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
