  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JER 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokawuki, nzala makasi mpe mopanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobaki na Jeremi na tina na bokawuki :",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Bato ya Yuda bazali na matanga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "bingumba na bango esili kobebisama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "bazali kolela mpo na mokili na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "mpe koganga ezali koyokana wuta na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambi bazali kotinda basali na bango",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "mpo ete bakende kotoka mayi ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "kasi soki bakomi na libulu ya mayi, mayi ezali te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "bongo bazali kozonga na mbeki ya pamba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "bazipi bilongi na soni mpe na mawa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabele esili kokawuka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "pamba te mvula ezali konoka lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "basali bilanga bakomi na pasi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "mpe bazipi bilongi na bango mpo na soni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala mboloko kati na zamba ekomi kokima",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "ata mwana na yango oyo esili kobota,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "pamba te matiti ya kolia ezali lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba-ane ya zamba etelemi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "na basonge ya bangomba ekawuka",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "mpe ezali kobenda mopepe lokola mbwa ya zamba ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "miso na yango elembi kotala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "pamba te matiti ya kolia ezali te. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, ata masumu na biso ezali kofunda biso,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "sala mpo na lokumu ya Kombo na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "pamba te towangani Yo mpe mingi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "tosalaki masumu liboso na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Elikya ya Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "Mobikisi na ye na tango ya pasi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "mpo na nini ozali kosala makambo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "lokola mopaya kati na mboka oyo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "to lokola moleki nzela oyo atelemaka kaka na mboka",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "mpo na kolekisa butu ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini ozali kosala makambo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "lokola moto oyo asutuki",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "to lokola elombe oyo azangi makoki ya kobikisa moto ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "Nzokande, Yo, Yawe, ozali kati na biso",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "mpe tobengami solo na Kombo na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "Kosundola biso te !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobi na tina na bato oyo :",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "« Bato oyo balingaka kaka kotambola-tambola,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "bavandaka esika moko te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "Yango wana, Yawe asepelaka na bango te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "akobosana mabe na bango te",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "mpe akopesa bango etumbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "mpo na masumu na bango. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JER 14:11"
      },
      "items": [
        {
          "text": "— Kosambela mpo na bolamu ya bato oyo te !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata soki bakili bilei, nakoyoka kolela na bango te ; ata soki babonzi mbeka ya kotumba mpe ya bagato, nakondima yango te. Nzokande, nakobebisa bango na mopanga, na nzala makasi mpe na bokono oyo ebomaka.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi nazongiselaki Ye :",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JER 14:13"
      },
      "items": [
        {
          "text": "— Oh Nkolo Yawe, basakoli bazali kokoba koloba na bango : « Te ! Bokotikala komona mopanga to nzala makasi te, kasi nakopesa bino kimia ya solo na esika oyo. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JER 14:14"
      },
      "items": [
        {
          "text": "— Basakoli bazali kosakola makambo ya lokuta na Kombo na Ngai. Natindaki bango te, naponaki bango te mpe nalobaki na bango likambo moko te. Bimoniseli mpe masakoli na bango ezali ya lokuta ; makambo nyonso oyo bazali kosakola ezali pamba, ewutaka nde na makanisi ya mitema na bango moko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tala liloba oyo Yawe alobi mpo na basakoli oyo bazali koloba na Kombo na Ngai : « Natindaki bango te, atako bazali koloba : ‹ Mopanga mpe nzala makasi ekokweya na mokili oyo te. › Basakoli yango bakokufa na mopanga mpe na nzala makasi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, bato oyo bazali kondima masakoli na bango bakobwakama na libanda, na babalabala ya Yelusalemi likolo ya nzala makasi mpe ya mopanga. Moto moko te akozala mpo na kokunda bango, ezala bango to basi na bango to mpe bana na bango ya mibali to ya basi. Nakozongisela bango mabe na mabe oyo basalaki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bango maloba oyo :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "‹ Butu mpe moyi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "miso na ngai ezali kobimisa mpinzoli,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "ezali kokawuka te !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "Pamba te moseka na ngai, bato na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "bazali na pasi mingi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "mpo ete babetami makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki nakeyi na zamba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "nazali komona bibembe ya bato",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "oyo babomi na mopanga ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "soki nakoti kati na engumba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "nazali komona bato oyo bazali kokufa na nzala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "Basakoli mpe Banganga-Nzambe bazali kososola",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "likambo moko te tango bazali kotambola na mokili. › »",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, obwaki solo Yuda ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Oyini penza Siona ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Mpo na nini otindeli biso pasi makasi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "oyo ezangeli nzela ya kobika ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Tokanisaki ete tokozwa kimia ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "nzokande, eloko moko ya malonga esalemi te !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Tokanisaki ete tokozala na nzoto kolongono ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "nzokande, tozali kaka komona pasi na pasi !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, tososoli solo mabe na biso",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:20"
      },
      "items": [
        {
          "text": "mpe masumu ya batata na biso !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:20"
      },
      "items": [
        {
          "text": "Solo, tosali penza masumu liboso na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyina biso te mpo na lokumu ya Kombo na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "Kobebisa te nkembo ya Kiti ya Bokonzi na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "Kanisa boyokani oyo osalaki elongo na biso",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "mpe kobebisa yango te !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, ezali na nzambe moko ya ekeko, kati na bikolo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "oyo enokisaka mvula ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Boni, likolo ekoki penza konokisa yango moko mvula ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Te ! Ezali nde Yo, Yawe, Nzambe na biso !",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Totie elikya na biso nyonso epai na Yo,",
          "type": "text",
          "attrs": {
