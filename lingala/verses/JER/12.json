  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JER 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mituna ya Jeremi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, ozalaka tango nyonso sembo ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "mpe ngai nakokoka kosamba na Yo te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Nzokande nalingi kotuna Yo mwa mituna",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "na tina na oyo etali bosembo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Mpo na nini misala ya bato mabe ekendaka liboso ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Mpo na nini bato oyo batosaka Yo te",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "bazalaka na bomoi ya kimia ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olonaki bango mpe bazwi misisa ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "bazali kokola mpe kobota mbuma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "Ozali tango nyonso pene ya minoko na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "kasi mosika ya mitema na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, oh Yawe, oyebi ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "omonaka ngai mpe oyebi",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "makanisi ya motema na ngai mpo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Tindika bango lokola bameme",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "oyo babongisi mpo na koboma !",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Bongisa bango mpo na mokolo ya kufa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino tango nini mokili ekowumela na kolela",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "mpe matiti ya bilanga nyonso",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "ekowumela ya kokawuka ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Banyama mpe bandeke esili kokufa",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "mpo ete bavandi ya mokili bazali mabe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Balobaka :",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "« Yawe akoyeba te makambo oyo ekokomela biso. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyano ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki ozali kosala momekano",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "ya kokima mbangu elongo na bato",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "oyo bazali kotambola na makolo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "mpe bango bazali komelisa yo pema,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "ndenge nini okoki komekana",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "na bato oyo batambolaka likolo ya bampunda ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "Soki ozali komitungisa na mokili oyo ezali na kimia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "ekozala boni liboso ya mpela ya ebale Yordani ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ezala bandeko na yo mpe bato ya libota na yo moko bateki yo, bazali koganga makasi mpo na kotelemela yo. Kotiela bango motema te, ata tango bazali kobimisa maloba kitoko mpo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakobosana libota na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "nakosundola libula na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "nakokaba molingami na ngai",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "na maboko ya banguna na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libula na ngai ekomi na miso na ngai",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "lokola nkosi ya zamba :",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "ezali kogangela ngai ; yango wana nayini yango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, libula na ngai ekomi na miso na ngai",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:9"
      },
      "items": [
        {
          "text": "lokola ndeke oyo eliaka misuni, bongo ebebi na makila,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:9"
      },
      "items": [
        {
          "text": "mpo ete bandeke mosusu oyo eliaka misuni",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
