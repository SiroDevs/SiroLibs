    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana bato wana mibale bazalaki kobima, bamemelaki Yesu moto moko oyo azalaki na se ya bokonzi ya molimo mabe mpe azalaki koloba te.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abenganaki molimo mabe yango, mpe moto oyo azalaki koloba te akomaki koloba. Ebele ya bato bakamwaki mpe balobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 9:33"
      },
      "items": [
        {
          "text": "— Kati na Isalaele, totikala nanu komona likambo ya boye te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Bafarizeo bazalaki koloba :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 9:34"
      },
      "items": [
        {
          "text": "— Azali kobengana milimo mabe na nguya ya mokonzi ya milimo mabe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ayokeli bato mawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
