            "id": "MRK.6.34"
          },
          "items": [
            {
              "text": "Mlk 6.34",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.10.2"
          },
          "items": [
            {
              "text": "Lk 10.2",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azalaki kotambola na bamboka mpe na bingumba nyonso, azalaki koteya kati na bandako na bango ya mayangani mpe kosakola Sango Malamu ya Bokonzi ; azalaki kobikisa bato na bokono mpe na pasi ya ndenge na ndenge.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        }
      ]
    },
