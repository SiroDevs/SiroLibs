          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bingumba oyo elongo na bamboka na yango ya mike-mike nde ezalaki libula ya libota ya Nefitali, kolanda bituka na bango.",
          "type": "text"
        }
