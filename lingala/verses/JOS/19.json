          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbala ya sambo, zeke ekweyaki epai ya libota ya Dani, kolanda bituka na bango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libula na bango ya mabele ezalaki :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:41"
      },
      "items": [
        {
          "text": "Tsorea, Eshitaoli, Iri-Shemeshi ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaalabini, Ayaloni, Yitila ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloni, Timinata, Ekroni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliteke, Gibetoni, Baalati,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeudi, Bene-Beraki, Gati-Rimoni ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "mayi ya Yarikoni, Rakoni mpe etuka oyo etalana na Jafa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bakitani ya Dani balongaki te kobotola eteni ya mabele na bango, boye bakendeki kobundisa Leshemi mpe babotolaki yango. Babomaki bato ya Leshemi na mopanga, babotolaki yango mpe bakomaki kovanda kuna. Bakomaki kobenga Leshemi « Dani, » kombo ya koko na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bingumba oyo elongo na bamboka na yango ya mike-mike nde ezalaki libula ya libota ya Dani, kolanda bituka na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eteni ya mabele ya Jozue",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bana ya Isalaele basilisaki kokabola mokili na biteni na zeke, bapesaki Jozue, mwana mobali ya Nuni, libula moko kati na bango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolanda mitindo na Yawe, bapesaki ye engumba oyo asengaki ; ezali Timinati-Sera, kati na etuka ya bangomba ya Efrayimi. Bongo Jozue atongaki engumba yango mpe akomaki kovanda kuna.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango nde ezalaki libula ya mabele oyo Nganga-Nzambe Eleazari ; Jozue, mwana mobali ya Nuni, mpe bakambi ya bituka, kolanda mabota ya bana ya Isalaele, bakabolaki na zeke liboso ya Yawe, na Silo, na ekotelo ya Ndako ya kapo ya Bokutani. Boye nde basilisaki kokabola mokili.",
          "type": "text"
        }
      ]
    }
