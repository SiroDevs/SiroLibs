{
  "id": "JOS.9",
  "number": "9",
  "bookId": "JOS",
  "reference": "Jozue 9",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOS 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jozue asalaki boyokani elongo na bato ya Gabaoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bakonzi nyonso (bakonzi ya bato ya Iti, ya Amori, ya Kanana, ya Perizi, ya Evi mpe ya Yebusi) oyo bazalaki na ngambo ya weste ya Yordani, kati na mokili ya bangomba, na etando mpe na mokili oyo ezalaki pembeni-pembeni ya Mayi monene Mediterane, pene ya Libani, bayokaki sango ya makambo yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.1",
            "verseOrgIds": [
              "JOS.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "basanganaki mpo na kobundisa Jozue mpe Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.2",
            "verseOrgIds": [
              "JOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango mpe bato ya Gabaoni bayokaki makambo oyo Jozue asalaki na Jeriko mpe na Ayi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.3",
            "verseOrgIds": [
              "JOS.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "basalelaki mayele mabe : babongolaki lolenge na bango, batiaki na likolo ya ba-ane na bango basaki epasuka-pasuka mpe bambeki ya kala ya vino oyo etoboka-toboka mpe babamba-bamba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.4",
            "verseOrgIds": [
              "JOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balataki basapato ya kala oyo babamba-bamba mpe bilamba ya kala ; mapa na bango ya kolia ezalaki biteni-biteni mpe ya kokawuka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
              "JOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakendeki kokutana na Jozue kati na molako ya Giligali, mpe balobaki na ye mpe na bana ya Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
            "verseOrgIds": [
              "JOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:6"
      },
      "items": [
        {
          "text": "— Towuti na mokili moko ya mosika ; bosala boyokani elongo na biso.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Isalaele balobaki na bato ya Evi :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:7"
      },
      "items": [
        {
          "text": "— Tango mosusu bozalaka kaka pembeni na biso ! Ndenge nini tosala boyokani elongo na bino ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongiselaki Jozue :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:8"
      },
      "items": [
        {
          "text": "— Tozali basali na yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 9:8"
      },
      "items": [
        {
          "text": "Kasi Jozue atunaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:8"
      },
      "items": [
        {
          "text": "— Bozali banani mpe bowuti wapi ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:9"
      },
      "items": [
        {
          "text": "— Basali na yo bawuti na mokili moko ya mosika penza, likolo ya sango na Yawe, Nzambe na bino. Pamba te toyokaki sango na Ye mpo na makambo nyonso oyo asalaki kati na Ejipito",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe epai ya bakonzi mibale ya bato ya Amori oyo bazalaki na ngambo ya este ya Yordani : Sikoni, mokonzi ya Eshiboni, mpe Ogi, mokonzi ya Bashani, oyo azalaki kovanda na Ashitaroti.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bampaka na biso mpe bavandi nyonso ya mokili na biso balobaki na biso : « Bokamata biloko ya kolia na nzela, bokende kokutana na bango mpe boyebisa bango : ‹ Tozali basali na bino, bosala boyokani elongo na biso. › »",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala kutu mapa na biso, ezalaki ya moto tango tobongisaki yango na bandako na biso lokola bilei ya mobembo, na mokolo oyo tolongwaki mpo ete toya epai na bino. Kasi sik'oyo tala ndenge nini esili kokawuka mpe kokoma biteni-biteni.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe lisusu, totondisaki bambeki oyo na vino tango ezalaki nanu ya sika, kasi tala sik'oyo ndenge nini esili kopasuka-pasuka mpe tala ndenge nini bilamba mpe basapato na biso esili kokufa mpo ete nzela ya mobembo eleki molayi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ya Isalaele bazwaki bilei oyo bato ya Gabaoni bayaki na yango, kasi batunaki Yawe te.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jozue asalaki elongo na bango boyokani ya kimia ; alakaki ete akoboma bango te. Mpe bakambi ya lisanga ya Isalaele bandimaki yango na kolapa ndayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, mikolo misato sima na kosala boyokani elongo na bato ya Gabaoni, bana ya Isalaele bayokaki ete bato yango bazalaka pene na bango mpe bavandaka kati na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bana ya Isalaele batelemaki mpo na kokende ; mpe na mokolo ya misato, bakomaki na bingumba na bango : Gabaoni, Kefira, Beyeroti mpe Kiriati-Yearimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bana ya Isalaele babundisaki bango te, pamba te bakambi ya lisanga balapaki ndayi mpo na bango na Kombo na Yawe, Nzambe ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 9:18"
      },
      "items": [
        {
          "text": "Boye, lisanga mobimba ekomaki koyimayima mpo na bakambi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bakambi nyonso balobaki na lisanga mobimba : « Solo, tolapaki ndayi mpo na bango na Kombo na Yawe, Nzambe ya Isalaele. Boye, tokoki kosala bango mabe te.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tala ndenge nini tokoki kosala bango : Tokotika bango kobika mpo ete kanda na Nzambe ekitela biso te, pamba te tolapaki ndayi na tina na bango. »",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambi babakisaki lisusu : « Tika ete bazala na bomoi, kasi bakobanda kokata banzete mpe kotoka mayi mpo na lisanga mobimba. » Wana nde ezalaki mokano oyo bakambi bazwaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jozue abengisaki bato ya Gabaoni mpe atunaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:22"
      },
      "items": [
        {
          "text": "— Mpo na nini bokosaki biso na koloba : « Tovandaka mosika na bino, » nzokande bovandi kaka pene na biso awa ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali sik'oyo na se ya elakeli mabe mpe bokotikala libela kozala bawumbu ; bokobanda kokataka bakoni mpe kotokaka mayi mpo na Ndako ya Nzambe na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongiselaki Jozue :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 9:24"
      },
      "items": [
        {
          "text": "— Basali na yo bayokaki sango ya mitindo oyo Yawe, Nzambe na bino, apesaki epai ya mosali na Ye Moyize, ete akopesa bino mokili oyo nyonso mpe akoboma bato na yango nyonso liboso na bino. Boye, tozalaki na somo makasi ya kobungisa bomoi na biso liboso na bino ; yango wana tosalaki bongo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala biso oyo, tomitiki na maboko na yo ; nyonso oyo okomona malamu mpe sembo na miso na yo, sala biso yango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jozue abikisaki bango na maboko ya bana ya Isalaele, mpe babomaki bango te.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, Jozue akomisaki bango bawumbu mpo na kokata bakoni mpe kotoka mayi mpo na lisanga ya Isalaele mpe mpo na etumbelo ya Yawe, kino na mokolo ya lelo, na esika nyonso oyo Yawe akopona.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        }
      ]
    }
