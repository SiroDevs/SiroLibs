{
  "id": "JOS.2",
  "number": "2",
  "bookId": "JOS",
  "reference": "Jozue 2",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jozue atindaki banongi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na Shitimi, Jozue, mwana mobali ya Nuni, atindaki na nkuku banongi mibale ; alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:1"
      },
      "items": [
        {
          "text": "— Bokende kononga mokili, mingi-mingi Jeriko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 2:1"
      },
      "items": [
        {
          "text": "Boye, bakendeki mpe bakotaki na ndako ya mwasi moko ya ndumba, Raabi, mpe bavandaki kuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayebisaki mokonzi ya Jeriko :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:2"
      },
      "items": [
        {
          "text": "— Tala, bato moko kati na bana ya Isalaele bayaki awa na butu mpo na kononga mokili.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, mokonzi ya Jeriko atindaki maloba oyo epai ya Raabi :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:3"
      },
      "items": [
        {
          "text": "— Bimisa mibali oyo bayaki epai na yo mpe bakotaki na ndako na yo, pamba te bayei nde mpo na kononga mokili mobimba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi mwasi yango akamataki mibali wana mibale mpe abombaki bango. Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:4"
      },
      "items": [
        {
          "text": "— Solo, mibali bayaki epai na ngai, kasi nayebaki te esika bango bawutaki.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakendeki na pokwa na tango oyo bakangaka ekuke ya engumba. Nayebi mpe te soki bakendeki na nzela nini. Bolanda bango noki. Bokoki solo kokanga bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande amatisaki bango likolo ya mwanza ya ndako mpe abombaki bango na se ya matiti oyo basalelaka bilamba ya lino, oyo atiaki likolo ya mwanza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, batindami ya mokonzi babimaki mpo na kolanda banongi na nzela oyo ekenda kino na esika oyo bakatiselaka ebale Yordani na makolo. Tango kaka batindami yango babimaki na engumba, bakangaki mpe mbala moko ekuke.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na butu, liboso ete banongi balala, Raabi amataki likolo ya mwanza",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:9"
      },
      "items": [
        {
          "text": "— Nayebi ete Yawe apesi mokili oyo na maboko na bino. Tozali na somo makasi mpo na bino mpe bavandi nyonso ya engumba oyo bazali kolenga na somo likolo na bino.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyokaki ndenge nini Yawe akawusaki Ebale monene ya Barozo liboso na bino tango bobimaki na Ejipito, mpe makambo oyo bosalaki Sikoni mpe Ogi, bakonzi mibale ya bato ya Amori, oyo bobomaki penza na ngambo ya este ya Yordani.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango toyokaki sango yango, mitema na biso ebukanaki mpe makasi ya moko na moko kati na biso esilaki likolo na bino, pamba te Yawe, Nzambe na bino, azali Nzambe ya likolo, kuna penza na lola, mpe Nzambe ya se, awa na mabele.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye sik'oyo, bolapa ndayi liboso na ngai na Kombo na Yawe ete bokosalela libota na ngai bolamu ndenge ngai nasaleli bino. Bopesa ngai elembo ya solo ;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "elembo oyo ekolakisa ete bokobikisa bomoi ya tata mpe ya mama na ngai, ya bandeko na ngai ya mibali mpe ya basi mpe ya bato nyonso oyo bavandaka elongo na bango, mpe lisusu ete bokobikisa biso na kufa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banongi bayebisaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:14"
      },
      "items": [
        {
          "text": "— Solo, tolapi ndayi, tokondima kokufa mpo na bino soki olobi te makambo oyo tozali kosala. Tokosalela bino bolamu mpe ngolu tango Yawe akopesa biso mokili oyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Raabi abimisaki bango na lininisa mpe akitisaki bango na singa, pamba te ndako oyo azalaki kovanda ezalaki ya kokangama na eteni ya mir ya engumba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
            "verseOrgIds": [
              "JOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:16"
      },
      "items": [
        {
          "text": "— Bokende na nzela ya bangomba ya mikuse mpo ete bato oyo bazali kolanda bino bamona bino te. Bobombama kuna mikolo misato kino tango bakozonga, bongo nde bokoki kokoba nzela na bino.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banongi balobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.17",
            "verseOrgIds": [
              "JOS.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:17"
      },
      "items": [
        {
          "text": "— Tokozala na ngambo te na ndayi oyo olapisi biso",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki, tango tokokota na mokili, okokangisa singa oyo ya motane na lininisa oyo okitiseli biso mpe okosangisa, kati na ndako na yo, tata mpe mama na yo, bandeko mpe bato nyonso ya libota na yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moto moko abimi libanda ya ndako na yo mpe akei na balabala, makila na ye ekotangama na moto na ye moko ; ekozala ngambo na biso te. Kasi soki babomi moto moko kati na bato oyo bakozala kati na ndako na yo, wana makila na ye ekotangama na mito na biso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki mpe olobi makambo oyo biso tozali kosala, tokozala na ngambo te liboso ya ndayi oyo olapisi biso.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raabi azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:21"
      },
      "items": [
        {
          "text": "— Boye, tika ete esalema ndenge bolobi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 2:21"
      },
      "items": [
        {
          "text": "Atikaki bango kokende, mpe bakabwanaki. Bongo na sima, akangisaki singa ya motane na lininisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na bango kokabwana, bakendeki na bangomba mikuse mpe bavandaki kuna mikolo misato kino tango bato oyo bazalaki kolanda bango balembaki koluka bango na nzela nyonso. Lokola bamonaki bango te, bazongaki na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.22",
            "verseOrgIds": [
              "JOS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banongi oyo mibale bazongelaki nzela na bango, babimaki na bangomba mikuse, bakatisaki ebale mpe bakomaki kino epai ya Jozue, mwana mobali ya Nuni. Bayebisaki ye makambo nyonso oyo ekomelaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.23",
            "verseOrgIds": [
              "JOS.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balobaki na Jozue :",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.24",
            "verseOrgIds": [
              "JOS.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 2:24"
      },
      "items": [
        {
          "text": "— Solo, Yawe apesi mokili oyo nyonso na maboko na biso ; bato nyonso bazali kolenga liboso na biso.",
          "type": "text"
        }
      ]
    }
  ],
  "next": {
    "id": "JOS.3",
