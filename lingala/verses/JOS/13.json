          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango nde libula oyo Moyize apesaki tango azalaki na etando ya Moabi, na ngambo ya Yordani, na ngambo ya este ya Jeriko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Moyize apesaki libula te epai ya libota ya Levi, pamba te Ye moko Yawe, Nzambe ya Isalaele, nde azali libula na bango, ndenge alakaki bango.",
          "type": "text"
        }
      ]
