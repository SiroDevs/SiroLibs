{
  "id": "NUM.12",
  "number": "12",
  "bookId": "NUM",
  "reference": "Mitango 12",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "NUM 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miriami mpe Aron batongi Moyize",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriami mpe Aron bazalaki kotonga Moyize likolo ya mwasi na ye, pamba te abalaki mwasi ya mokili ya Kushi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.1",
            "verseOrgIds": [
              "NUM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balobaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 12:2"
      },
      "items": [
        {
          "text": "— Boni, Yawe alobaka kaka na nzela ya Moyize ? Alobaki mpe na nzela na biso te ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 12:2"
      },
      "items": [
        {
          "text": "Yawe ayokaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande Moyize azalaki moto ya komikitisa makasi koleka bato nyonso ya mokili.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbala moko, Yawe alobaki na Moyize, Aron mpe Miriami :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 12:4"
      },
      "items": [
        {
          "text": "— Boya bino misato na Ndako ya kapo ya Bokutani.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 12:4"
      },
      "items": [
        {
          "text": "Bango nyonso misato bakendeki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akitaki na likonzi ya lipata, atelemaki na ekuke ya Ndako ya kapo mpe abengaki Aron mpe Miriami. Tango bango mibale batelemaki liboso,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "— Boyoka maloba na Ngai !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "Soki mosakoli moko ya Yawe azali kati na bino,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "namimonisaka Ngai moko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "epai na ye na nzela ya bimoniseli,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "nalobaka na ye na nzela ya bandoto.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ezalaka bongo te",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:7"
      },
      "items": [
        {
          "text": "mpo na Moyize, mosali na Ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:7"
      },
      "items": [
        {
          "text": "Azali sembo kati na ndako na Ngai mobimba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasololaka na ye elongi na elongi,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "na polele penza kasi na masese te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "Amonaka lolenge ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "Mpo na nini bozali na somo te",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "ya kotonga Moyize, mosali na Ngai ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yawe apeliselaki bango kanda na Ye mpe atikaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango kaka lipata elongwaki likolo ya Ndako ya kapo, bokono ya maba ezwaki mbala moko Miriami : ezalaki pembe lokola mvula ya pembe. Aron abalukaki mpo na kotala Miriami mpe amonaki ete azwi bokono ya maba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.10",
            "verseOrgIds": [
              "NUM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Aron alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.11",
            "verseOrgIds": [
              "NUM.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 12:11"
      },
      "items": [
        {
          "text": "— Nabondeli yo, nkolo na ngai ! Kotangela biso te masumu oyo tosali na bozoba !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotika te ete Miriami azala lokola mwana oyo abotami ya kokufa, oyo abimi na libumu ya mama na ye na ndambo ya nzoto ya kopola !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Moyize abelelaki Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 12:13"
      },
      "items": [
        {
          "text": "— Oh Nzambe, nabondeli Yo, bikisa ye !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azongiselaki Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.14",
            "verseOrgIds": [
              "NUM.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 12:14"
      },
      "items": [
        {
          "text": "— Soki tata na ye abwakelaki ye soyi na elongi ; boni, alingaki kozala na soni te mikolo sambo ? Tia ye na libanda ya molako mikolo sambo, na sima na yango nde akoki kozonga.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye batiaki Miriami libanda ya molako mikolo sambo mpe bato bazalaki kotambola te kino tango Miriami azongaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, bato batikaki Atseroti mpe bakendeki kotonga molako na bango na esobe ya Parani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.16",
            "verseOrgIds": [
              "NUM.12.16"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "NUM.13",
    "number": "13",
    "bookId": "NUM"
  },
  "previous": {
    "id": "NUM.11",
