              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani ya libota ya Ribeni batongaki bingumba oyo : Eshiboni, Eleale mpe Kiriatayimi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
