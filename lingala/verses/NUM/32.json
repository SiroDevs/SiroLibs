          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti-Nimira mpe Beti-Arani lokola bingumba ya makasi ; mpe batongaki lisusu mapango mpo na bibwele na bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
