              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani ya Gadi batongaki bingumba oyo : Diboni, Ataroti, Aroeri ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
