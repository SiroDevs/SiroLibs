          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani ya Makiri, mwana mobali ya Manase bakendeki kino na Galadi, babotolaki yango mpe babenganaki bato ya Amori oyo bazalaki kovanda kuna.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Moyize apesaki mokili ya Galadi epai ya bakitani ya Makiri, mwana mobali ya Manase, mpe bakomaki kovanda kuna.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yairi, moko kati na bakitani ya Manase, abotolaki bamboka na yango ya mike mpe abengaki yango Avoti Yairi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe Noba abotolaki Kenati mpe bamboka na yango ya mike oyo ya zingazinga mpe abengaki yango Noba, ndenge ezalaki kombo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
