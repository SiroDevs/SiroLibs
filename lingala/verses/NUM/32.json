              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na Nebo mpe Bala-Meoni, kombo oyo babongola na Sibima. Bapesaki bakombo na bingumba oyo batongaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
