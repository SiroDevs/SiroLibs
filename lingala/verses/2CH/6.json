  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Salomo akumisi Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Salomo alobaki : « Yawe alobaki ete akovanda kati na esika ya molili !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe ngai natongeli Yo ndako ya lokumu, esika oyo okovanda mpo na libela ! »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.8.14-1KI.8.21"
          },
          "items": [
            {
              "text": "1Ba 8.14-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi abalukaki mpe apambolaki lisanga mobimba ya Isalaele. Lisanga mobimba ya Isalaele ezalaki ya kotelema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "— Tika ete Yawe, Nzambe ya Isalaele, apambolama ; Ye oyo, na monoko na Ye moko, alobaki na tata na ngai, Davidi, mpe akokisi, na maboko na Ye, makambo oyo alakaki :",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Wuta mokolo oyo nabimisaki bato na Ngai, Isalaele, na Ejipito, naponaki engumba moko te kati na mabota nyonso ya Isalaele mpo ete batonga kuna Tempelo epai wapi Kombo na Ngai ekozala, mpe naponaki moto mosusu te lokola mokonzi ya bato na Ngai, Isalaele,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasi naponaki nde Yelusalemi mpo ete Kombo na Ngai ezala kuna, mpe Davidi mpo ete akamba bato na Ngai, Isalaele ! »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata na ngai, Davidi, azalaki na makanisi ya kotonga Tempelo mpo na lokumu ya Kombo ya Yawe, Nzambe ya Isalaele.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yawe alobaki na Davidi, tata na ngai : « Osali malamu lokola ozwi makanisi ya kotonga Tempelo mpo na lokumu ya Kombo na Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ezali yo te moto okotonga Tempelo yango ; ezali nde mwana na yo ya mobali, oyo akobima na mokongo na yo moko, moto akotonga Tempelo yango mpo na lokumu ya Kombo na Ngai. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akokisi elaka na Ye : nakitani tata na ngai, Davidi ; navandi na kiti ya bokonzi ya Isalaele, ndenge kaka Yawe alobaki, mpe natongi Tempelo mpo na lokumu ya Kombo ya Yawe, Nzambe ya Isalaele.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natie kuna Sanduku ya Boyokani ya Yawe, boyokani oyo asalaki elongo na bana ya Isalaele.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libondeli ya Salomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.8.22-1KI.8.53"
          },
          "items": [
            {
              "text": "1Ba 8.22-53",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Salomo atelemaki liboso ya etumbelo ya Yawe ; mpe na miso ya lisanga mobimba ya Isalaele, atombolaki maboko na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, Salomo atongaki na bronze etemelo ya kolobela : ezalaki na bametele mibale na basantimetele tuku mitano na molayi, bametele mibale na basantimetele tuku mitano na mokuse, mpe metele pene moko na bosanda ; mpe atiaki yango na kati-kati ya lopango. Amataki na likolo na yango, afukamaki liboso ya lisanga mobimba ya Isalaele, atombolaki maboko likolo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe asambelaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:14"
      },
      "items": [
        {
          "text": "— Yawe, Nzambe ya Isalaele ! Ezali na nzambe moko te oyo akokani na Yo, ezala kuna na likolo to awa na se. Obatelaka boyokani mpe bolingo na Yo mpo na basali na Yo, oyo batambolaka kolanda mokano na Yo na mitema na bango mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokisi bilaka oyo opesaki na Davidi, tata na ngai mpe mosali na Yo ; makambo oyo olobaki, na monoko na Yo, okokisi yango na nguya ya loboko na Yo, ndenge ezali komonana na mokolo ya lelo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, oh Yawe, Nzambe ya Isalaele, kokisa mpe elaka mosusu oyo opesaki na Davidi, tata na ngai mpe mosali na Yo, tango olobaki na ye : « Okozangaka te moto oyo akovanda na kiti ya bokonzi ya Isalaele, na miso na Ngai, soki bana na yo bakotambola malamu liboso na Ngai mpe bakotosa mibeko na Ngai, ndenge yo otamboli kolanda mokano na Ngai. »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, Nzambe ya Isalaele, tika ete elaka oyo opesaki na Davidi, mosali na Yo, ekokisama !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, Nzambe akoki solo kovanda na mokili elongo na bato ? Soki kutu Likolo mpe Likolo oyo eleki likolo ekoki kokoka Yo te, bongo ekozala boni mpo na Tempelo oyo ngai natongi ?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Nzambe na ngai, yoka na bokebi losambo mpe libondeli na ngai, mowumbu na Yo ! Yoka koganga mpe libondeli oyo mowumbu na Yo azali kotombola epai na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete, moyi mpe butu, miso na Yo ezala ya kofungwama mpo na kotala Tempelo oyo, esika oyo olobaki ete okotia kuna Kombo na Yo ! Yoka losambo oyo mowumbu na Yo azali kotombola na esika oyo !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoyoka mabondeli oyo mowumbu na Yo mpe bato na Yo, Isalaele, bakotombola epai na Yo na kotala na ngambo ya esika oyo ! Tika ete oyoka biso wuta na Likolo, evandelo na Yo ; yoka mpe limbisa !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moto asali lisumu epai ya mozalani na ye, mpe batindi ye na makasi ete alapa ndayi esangana na bilakeli mabe, liboso ya etumbelo na Yo kati na Tempelo oyo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka wuta na Likolo ; sala mpe kata makambo kati na bawumbu na Yo mpo na kokweyisa moto oyo asali mabe mpe komemisa ye ngambo ya mabe na ye kolanda etamboli na ye, mpe mpo na kolongisa moto ya sembo mpe kosalela ye kolanda bosembo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki banguna balongi bato na Yo, Isalaele, mpo ete basalaki masumu liboso na Yo, soki babongoli mitema mpo na kozongela Yo, basanzoli Kombo na Yo, basambeli mpe babondeli Yo, kati na Tempelo oyo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka wuta na Likolo, limbisa masumu ya Isalaele, bato na Yo, mpe zongisa bango na mabele oyo opesaki bango mpe batata na bango !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki likolo ekangami mpe mvula ezali lisusu te mpo ete basalaki masumu liboso na Yo, soki basambeli na kotala na ngambo ya esika oyo, basanzoli Kombo na Yo mpe batiki masumu na bango, pamba te osili koyokisa bango soni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka bango wuta na Likolo, limbisa masumu ya bawumbu na Yo mpe ya Isalaele, bato na Yo, —tango osili kolakisa bango nzela malamu oyo basengeli kolanda— mpe tinda mvula na mokili na Yo, mokili oyo opesaki lokola libula epai ya bato na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki nzala makasi to bokono makasi to moto to bokawuki to kopola ya bambuma to mabanki to mankoko eyei kati na mokili, soki banguna bazingeli bato na Yo kati na mokili na bango, na bikuke ya bingumba na bango, to soki pasi to bokono ya lolenge nyonso ekweyeli bango,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki, wana bato na Yo, Isalaele, bayoki mawa makasi kati na mitema na bango mpo na pasi to bokono yango, moko na moko atomboli maboko na ye na ngambo ya Tempelo oyo, asambeli to abondeli Yo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka ye wuta na Likolo, evandelo na Yo, limbisa, zongisela moto na moto kolanda etamboli na ye, mpo ete oyebi motema na ye. Solo, Yo kaka nde oyebi mitema ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala bongo mpo ete batosa Yo mpe batambola na banzela na Yo mikolo nyonso oyo bakovanda na mabele oyo opesaki epai na batata na biso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge moko mpe mpo na mopaya oyo azali te na molongo ya Isalaele, bato na Yo : wana akowuta na mokili ya mosika, mpo na Kombo monene na Yo, mpo na loboko na Yo ya nguya mpe esembolama ; soki ayei mpe asambeli na kotala na ngambo ya Tempelo oyo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka wuta na Likolo, evandelo na Yo, mpe salela ye nyonso oyo akosenga Yo mpo ete bikolo nyonso ya mokili bayeba Kombo na Yo, batosa Yo lokola Isalaele, bato na Yo, mpe bayeba ete Tempelo oyo natongi ebulisami nde mpo na Kombo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bato na Yo bakokende kobundisa banguna na bango na nzela oyo okolakisa bango, soki basambeli Yo na kotala na ngambo ya engumba oyo oponaki mpe na ngambo ya Tempelo oyo natongi mpo na Kombo na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka wuta na Likolo losambo mpe libondeli na bango, mpe longisa bango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bakosala masumu liboso na Yo, pamba te moto nyonso asalaka masumu, bongo Yo osilikeli bango mpe okabi bango na maboko ya banguna oyo bamemi bango na bowumbu kati na mokili songolo, ezala ya mosika to ya pene,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki, wuta na mokili ya bowumbu, basosoli, babongoli mitema, babondeli Yo kati na mokili ya bowumbu na bango mpe balobi : « Tosalaki masumu, tosalaki bambeba, tosalaki makambo mabe ; »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki, wuta na mokili epai wapi bamemaki bango na bowumbu, basengi Yo bolimbisi, na mitema mpe na milimo na bango mobimba, soki basambeli na kotala na ngambo ya mokili na bango, oyo opesaki epai na batata na bango, na ngambo ya engumba oyo oponaki mpe na ngambo ya Tempelo oyo natongi mpo na lokumu ya Kombo na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoka wuta na Likolo, evandelo na Yo ; yoka losambo mpe mabondeli na bango, longisa bosembo na bango mpe limbisa bato na Yo na masumu oyo basalaki liboso na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobanda sik'oyo, oh Nzambe na ngai, tika ete miso na Yo ezala ya kofungwama mpe matoyi na Yo eyoka na bokebi mabondeli oyo ekosalema na esika oyo !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, oh Yawe Nzambe,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "telema mpe yaka na esika na Yo ya bopemi,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Yo elongo na Sanduku ya nguya na Yo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Oh Yawe Nzambe, tika ete Banganga-Nzambe na Yo balata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "lobiko lokola elamba ;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "mpe tika ete basantu na Yo basepela na boboto na Yo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe Nzambe, kobwaka te mopakolami na Yo,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:42"
      },
      "items": [
        {
          "text": "kanisa bolingo monene na Yo,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:42"
      },
      "items": [
        {
          "text": "oyo otalisaki epai ya Davidi, mosali na Yo !",
          "type": "text"
        }
      ]
    }
