          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bisalelo ya Tempelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo asalaki etumbelo ya bronze ya bametele zomi na molayi, bametele pene zomi na mokuse, mpe bametele mitano na bosanda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.7.23-1KI.7.26"
          },
          "items": [
            {
              "text": "1Ba 7.23-26",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki nzungu ya monene ya bronze, oyo ezalaki na lolenge ya libungutulu : monene na yango ezalaki na bametele mitano ; bosanda na yango, bametele mibale na basantimetele tuku mitano, mpe zingazinga na yango, bametele zomi na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na se ya monoko na yango, na pembeni na yango nyonso, ezalaki na milongo mibale ya bililingi ya bangombe oyo banyangwisaki mpe babambaki na nzungu ya monene mpo ete esala eloko kaka moko ; ezalaki bililingi zomi mpo na molayi ya kati-kati ya metele moko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzungu yango evandisamaki na likolo ya bikeko ya bangombe zomi na mibale : misato etalaki na ngambo ya nor ; misato, na ngambo ya weste ; misato, na ngambo ya sude ; mpe misato, na ngambo ya este. Bongo sima ya bangombe yango nyonso etalaki na ngambo ya kati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbinga ya nzungu yango ezalaki na basantimetele pene mwambe. Babongisaki pembeni ya monoko na yango lokola pembeni ya kopo oyo batia bililingi ya fololo ya lisi. Ezalaki kotonda na balitele ya mayi pene nkoto tuku minei na misato.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo asalaki lisusu basani zomi ya minene : mitano na ngambo ya loboko ya mobali, mpe mitano, na ngambo ya loboko ya mwasi, mpo na kosukola bisalelo mpo na bambeka ya kotumba. Kasi Banganga-Nzambe bazalaki kosukola na nzungu ya monene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki lisusu bitelemiselo zomi ya minda, basala na wolo kolanda ndakisa na yango oyo epesamaki ; mpe atiaki yango na eteni oyo eleki monene kati na Tempelo : mitano na ngambo ya loboko ya mobali, mpe mitano na ngambo ya loboko ya mwasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki bamesa zomi mpe atiaki yango kati na eteni oyo eleki monene : mitano na ngambo ya loboko ya mobali, mpe mitano na ngambo ya loboko ya mwasi. Asalaki lisusu bakopo nkama moko ya wolo mpo na kosopela makila na likolo ya etumbelo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki lopango ya Banganga-Nzambe mpe lopango monene. Asalaki bikuke ya lopango mpe alatisaki yango bronze.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.7.38-1KI.7.51"
          },
          "items": [
            {
              "text": "1Ba 7.38-51",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaki nzungu ya monene na ngambo ya loboko ya mobali ya Tempelo, na ngambo ya sude-este.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urami asalaki basani ya kotia putulu, bapawu mpe bakopo mpo na kosopela makila.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 4:11"
      },
      "items": [
        {
          "text": "Urami asilisaki mosala nyonso oyo mokonzi Salomo atindaki ye kosala mpo na Tempelo ya Nzambe :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "makonzi mibale, mito mibale ya libungutulu na suka ya makonzi nyonso mibale, bililingi mibale ya basinga oyo basala lokola monyama mpo na kozipa mito nyonso mibale ya makonzi yango,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bililingi ya bambuma ya grenade nkama minei ekangana na maboke ya bililingi ya basinga oyo basala lokola monyama : milongo mibale ya bililingi ya grenade mpo na elilingi moko na moko ya basinga oyo basala lokola monyama, mpo na kozipa mito nyonso mibale ya makonzi ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bivandelo zomi mpe basani zomi ya minene, oyo batiaki na likolo ya bivandelo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzungu ya monene ya libungutulu, bikeko ya bangombe zomi na mibale oyo ezalaki komema nzungu ya monene,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "basani mpo na kotia putulu, bapawu, biloko ya songe mpo na misuni elongo na bisalelo na yango nyonso. Urami-Abi asalelaki mokonzi Salomo biloko oyo nyonso mpo na Tempelo ya Yawe ; asalaki yango na bronze oyo bapetola na moto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi asengaki ete banyangwisa yango kati na mabele, na etando ya Yordani, kati na Sukoti mpe Tseredata.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete Salomo asalaki biloko oyo nyonso ebele koleka, yango wana bakokaki te koyeba kilo ya bronze oyo basalelaki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo asalaki lisusu na wolo biloko nyonso oyo ezalaki kati na Tempelo ya Nzambe : etumbelo ; bamesa oyo, na likolo na yango, bazalaki kotia mapa liboso ya Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bitelemiselo ya minda elongo na minda na yango, oyo basala na wolo ya peto, mpo na kopela liboso ya Esika-Oyo-Eleki-Bule,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bafololo na yango, minda na yango mpe biloko ya wolo ya kozwela makala na moto, basala na wolo ya peto makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
            "verseOrgIds": [
              "2CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "bambeli, bakopo mpo na kosopela makila, bakeni, bambabola ya wolo ya peto, bikangelo ya wolo ya bikuke ya Esika-Oyo-Eleki-Bule mpe bikuke ya esika oyo bato nyonso bavandaka, na ekotelo ya Tempelo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.22",
            "verseOrgIds": [
              "2CH.4.22"
            ]
          }
        }
      ]
    }
  ],
