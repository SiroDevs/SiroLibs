  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "HOS 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa ya Efrayimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Efrayimi azalaki koloba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "bato bazalaki kolenga ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "azalaki kokonza kati na Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "kasi asalaki mabe na kosambela nzambe Bala ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "yango wana akufaki.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, bazali kokoba kosala masumu ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "na mayele na bango, bazali komisalela banzambe ya bikeko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "na nzela ya palata na bango balekisa na moto,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "bililingi oyo babongisa malamu :",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "nyonso wana ezali mosala ya bato ya misala ya maboko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "Balobaka na tina na bango :",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "« Babonzaka bato lokola bambeka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "mpe bapesaka beze na bana ngombe ya mibali. »",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, bakozala lokola lipata ya tongo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "lokola londende ya tongo oyo elimwaka,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "lokola lititi oyo mopepe ememaka mosika",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "na esika oyo batutelaka ble,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "mpe lokola molinga oyo ebimaka na lidusu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Nzokande Ngai Yawe, nazali Nzambe na yo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "oyo abimisaki yo wuta na Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "Oyebi Nzambe mosusu te libanda na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "ozali na mobikisi mosusu te.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai, nayebaki yo kati na esobe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:5"
      },
      "items": [
        {
          "text": "kati na mabele oyo ekawuka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi sik'oyo, lokola bolie mpe botondi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "bokomi lofundu mpe bobosani Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, nakokweyela bino lokola nkosi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:7"
      },
      "items": [
        {
          "text": "mpe nakozela bino na nzela lokola nkoyi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakolanda bino lokola ngombolo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "oyo ebungisi bana na yango",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "mpe nakopasola misuni ya mitema na bino.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "Nakolia bino wana, lokola nkosi ya mwasi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "bongo banyama ya zamba ekoya kopanza bino biteni-biteni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele, obebisami ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:9"
      },
      "items": [
        {
          "text": "pamba te Ngai kaka nde Mosungi na yo !",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapi mokonzi na yo mpo ete abikisa yo ?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "Wapi bakambi na yo kati na bingumba na bino nyonso",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "oyo, na tina na bango, bozalaki koloba :",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "‹ Bopesa biso mokonzi mpe moyangeli ? ›",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, na kanda na Ngai, napesaki bino mokonzi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:11"
      },
      "items": [
        {
          "text": "mpe na kotomboka na Ngai, nakolongola ye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 13:12"
          },
          "items": [
            {
              "text": "12",
