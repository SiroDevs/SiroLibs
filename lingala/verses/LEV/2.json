          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Na tina na makabo ya bambuma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moto alingi komema makabo ya mbuma epai na Yawe, makabo yango ekozala ya farine. Bongo na likolo na yango, akosopa mafuta mpe akotia ansa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akomema yango epai ya Banganga-Nzambe, bana mibali ya Aron, oyo moko kati na bango akozwa loboko mobimba ya farine mpe mafuta elongo na ansa nyonso, mpe akotumba yango na etumbelo lokola ekaniseli. Ezali likabo bazikisa na moto, oyo solo kitoko na yango ekosepelisa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndambo oyo ekotikala, kati na makabo ya mbuma, ekozala ya Aron mpe ya bana na ye. Ezali eteni ya bule penza kati na makabo bazikisa na moto mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki amemi likabo ya farine batumba na fulu ya moto, likabo yango esengeli kozala ya gato oyo ezanga levire, oyo basangisa na mafuta to ya mikate oyo ezanga levire mpe bapakola mafuta na likolo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki ezali likabo bakalinga na kikalungu, esengeli kozala ya farine ezanga levire mpe basangisa na mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakokata yango na biteni mpe bakosopa mafuta likolo na yango. Ezali likabo ya bambuma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo soki likabo yango ezali ya bambuma bakalinga na kikalungu, ekozala ya farine basangisa na mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakomema epai na Yawe makabo ya mbuma oyo babongisi mpe bakopesa yango epai ya Nganga-Nzambe oyo akomema yango na etumbelo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akolongola na makabo ya mbuma eteni oyo esengeli kobonzama lokola ekaniseli mpe akotumba yango na etumbelo. Ezali likabo bazikisa na moto oyo solo kitoko na yango ekosepelisa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo bagato oyo ekotikala, ekozala ya Aron mpe ya bana na ye ya mibali. Ezali eteni ya bule penza kati na makabo bazikisa na moto mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likabo moko te ya mbuma, oyo bokomemela Yawe ekozala na levire, pamba te bokotumba te levire to mafuta ya nzoyi lokola likabo bazikisa na moto mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomema yango epai na Yawe lokola likabo ya bambuma ya liboso, kasi bokobonza yango te na etumbelo lokola makabo ya solo kitoko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotia mungwa na makabo na yo nyonso ya bambuma mpe okobosana te kotia mungwa na likabo na yo ya bambuma, pamba te ezali elembo ya boyokani oyo Nzambe na yo asalaki. Okotia mungwa na makabo na yo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki omemeli Yawe likabo ya bambuma ya liboso, okomema bambuma ya sika bakalinga na moto mpe batuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosopela yango mafuta mpe ansa. Ezali likabo ya bambuma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Nganga-Nzambe asengeli kotumba eteni ya likabo elongo na ansa nyonso lokola ekaniseli. Ezali likabo bazikisa na moto mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        }
      ]
    }
  ],
