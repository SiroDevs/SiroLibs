  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LEV 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mibeko na tina na kopetolama ya bato na maba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala mobeko oyo etali moto oyo azali na bokono ya maba, na mokolo ya kopetolama na ye : ‹ Basengeli komema moto oyo azali na bokono ya maba epai ya Nganga-Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akokende libanda ya molako mpo na kotala ye malamu. Soki abiki na bokono na ye ya maba,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akopesa mitindo ete bamema biloko oyo, mpo na kopetolama ya moto oyo abiki na bokono ya maba : bandeke mibale ya peto mpe ya bomoi, eteni ya nzete ya sedele, eteni ya elamba ya motane makasi mpe eteni ya nzete ya izope.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akopesa mitindo ete bakata kingo ya ndeke moko kati na bandeke wana mibale, na likolo ya sani basala na mabele mpe etondi na mayi ya peto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo akokamata ndeke ya mibale, ya bomoi, elongo na eteni ya nzete ya sedele, eteni ya elamba ya motane makasi mpe eteni ya nzete ya izope ; akozindisa yango kati na makila ya ndeke oyo bawuti kokata kingo na likolo ya mayi ya peto ;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akosopa makila yango mbala sambo na nzoto ya moto oyo asengeli kopetolama na maba. Sima na yango, Nganga-Nzambe akotatola ete moto yango akomi peto ; mpe akotika ndeke oyo ya bomoi kopumbwa mpe kokende na zamba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo asengeli na kopetolama akosukola bilamba na ye, akokata bapwale na ye nyonso mpe akomisukola nzoto na mayi ; sima na yango, akokoma peto. Bongo, akoki kozonga kati na molako, kasi akovanda mikolo sambo libanda ya ndako na ye ya kapo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya sambo, akokata lisusu bapwale na ye, suki na ye ya moto mpe ya miso, mandefu na ye mpe bapwale nyonso mosusu ; akosukola bilamba na ye mpe akomisukola nzoto na mayi. Na bongo, akozala peto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya mwambe, akokamata bana meme mibale ezanga mbeba elongo na meme moko ya mwasi ezanga mbeba mpe esili kokokisa mobu moko, kilo libwa ya farine basangisa na mafuta lokola, likabo ya bambuma, mpe kati-kati ya litele moko ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe oyo azali kosala mosala ya kopetola akotia ye elongo na makabo na ye liboso ya Yawe, na ekotelo ya Ndako ya kapo ya Bokutani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akozwa mwana meme ya liboso mpe akobonza yango elongo na kati-kati ya litele moko ya mafuta lokola mbeka mpo na kozongisa boyokani ; akotombola yango liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akokata mwana meme yango kingo na esika oyo babomaka banyama oyo babonzi epai ya Nzambe lokola mbeka mpo na bolimbisi masumu mpe lokola mbeka ya kotumba, kati na esika yango ya bule ; pamba te, ezala mbeka mpo na kozongisa boyokani to mbeka mpo na bolimbisi masumu, ezali ya Nganga-Nzambe : ezali eloko ya bule koleka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akozwa makila ya mbeka oyo ebonzami mpo na kozongisa boyokani, akopakola yango na likolo ya litoyi ya ngambo ya loboko ya mobali ya moto oyo azali komipetola, na mosapi ya liboso ya loboko na ye ya ngambo ya mobali mpe na mosapi ya liboso ya lokolo na ye ya ngambo ya loboko ya mobali.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akokamata kati-kati ya litele ya mafuta mpe akosopa ndambo na yango na loboko na ye ya ngambo ya mwasi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akozindisa, kati na mafuta oyo asili kosopa na loboko na ye ya ngambo ya mwasi, mosapi ya mibale ya loboko na ye ya ngambo ya mobali mpe akosalela yango mpo na kosopa mbala sambo mafuta liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo kati na mafuta oyo ekotikala ye na loboko, Nganga-Nzambe akokamata ndambo na yango mpo na kopakola na likolo ya litoyi ya ngambo ya loboko ya mobali ya moto oyo azali komipetola, na mosapi ya liboso ya loboko na ye ya ngambo ya mobali mpe na mosapi ya liboso ya lokolo na ye ya ngambo ya loboko ya mobali, kaka na esika oyo awuti kotia makila ya mwana meme oyo ebonzami lokola mbeka mpo na kozongisa boyokani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Nganga-Nzambe akosopa, na moto ya moto oyo azali komipetola, mafuta oyo ekotikala na loboko na ye mpo na kosala, liboso ya Yawe, mosala ya bolimbisi masumu na ye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Nganga-Nzambe akobonza, liboso ya Nzambe, mbeka mpo na masumu, mpo ete asala mosala ya bolimbisi masumu ya moto oyo azali komipetola na mbindo na ye ; mpe akokata lisusu kingo ya nyama oyo ebonzami lokola mbeka ya kotumba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akotia mbeka yango na likolo ya etumbelo elongo na makabo ya farine. Boye, Nganga-Nzambe akosala mosala ya bolimbisi masumu ya moto yango, mpe akozala peto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moto yango azali mobola, bongo akoki kozwa te biloko wana nyonso, akokamata kaka mwana meme moko lokola mbeka mpo na kozongisa boyokani, mpo na kobonza yango mpo na mosala ya bolimbisi masumu ya moto yango ; akobakisa na likolo na yango lokola makabo bakilo misato ya farine basangisa na mafuta mpe kati-kati ya litele moko ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akobonza lisusu bibenga mibale kolanda bozwi na ye : moko lokola mbeka mpo na bolimbisi masumu, mosusu lokola mbeka ya kotumba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya mwambe, akomema yango epai ya Nganga-Nzambe, na ekotelo ya Ndako ya kapo ya Bokutani, liboso ya Yawe, mpo na kopetolama na ye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akokamata mafuta mpe mwana meme oyo ebonzami lokola mbeka mpo na bolimbisi masumu, mpe akobonza yango epai na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akokata kingo ya mwana meme yango oyo ebonzami lokola mbeka mpo na bolimbisi masumu. Nganga-Nzambe akotia makila ya mbeka mpo na bolimbisi masumu, na likolo ya litoyi ya ngambo ya loboko ya mobali ya moto oyo azali komipetola, na mosapi ya liboso ya loboko na ye ya ngambo ya mobali mpe na mosapi ya liboso ya lokolo na ye ya ngambo ya loboko ya mobali.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akosopa lisusu ndambo ya mafuta na loboko na ye ya ngambo ya mwasi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe na nzela ya mosapi ya mibale ya loboko na ye ya ngambo ya mobali, Nganga-Nzambe akokamata mpe akosopa mafuta yango mbala sambo, liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akokamata ndambo mosusu mpe akotia yango na likolo ya litoyi ya ngambo ya loboko ya mobali, ya moto oyo azali komipetola, na mosapi ya liboso ya loboko na ye ya ngambo ya mobali mpe na mosapi na ye liboso ya lokolo na ye ya ngambo ya loboko ya mobali, mpe na bisika oyo atiaki makila ya mbeka mpo na bolimbisi masumu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo mpo na ndambo ya makila oyo ekotikala na loboko na ye ya mwasi, Nganga-Nzambe akosopa yango na moto ya moto oyo azali komipetola, mpo na kosala mosala ya bolimbisi masumu na ye liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akozwa moko kati na bibenga mibale oyo moto wana abonzi kolanda bozwi na ye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe akobonza yango lokola mbeka mpo na masumu ; bongo akobonza ebenga mosusu lokola mbeka ya kotumba elongo na makabo ya farine. Mpe Nganga-Nzambe akosala liboso ya Yawe, mosala ya bolimbisi masumu ya moto oyo azali komipetola. ›",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nde mibeko oyo ezali kotala moto oyo abeli bokono ya maba, oyo azali penza na makoki te mpo na kopetolama na ye. »",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maba kati na bandako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize mpe Aron :",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tango bokokota na mokili ya Kanana oyo napesi bino, soki natie litono ya maba na ndako moko ya mokili oyo napesi bino,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkolo ndako asengeli kokende koloba boye epai ya Nganga-Nzambe : ‹ Namoni litono ya maba kati na ndako na ngai. ›",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Nganga-Nzambe akopesa mitindo ya kobima na ndako yango liboso ete ye akota kuna mpo na kotala malamu litono yango. Bongo akoloba ete biloko nyonso kati na ndako yango ezali peto. Sima na yango, Nganga-Nzambe akokota kati na yango mpo na kotala malamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akobanda kotala malamu litono yango kati na mir. Soki amoni ete ezwi langi ya mayi ya pondu to ya motane mpe esali lidusu kati na mir,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe asengeli kobima wuta na ndako mpe kotelema na ekotelo na yango ; bongo akokanga ndako yango mpo na mikolo sambo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya sambo, Nganga-Nzambe akozonga mpo na kotala lisusu malamu. Soki litono yango epanzani kati na mir,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akopesa mitindo ete balongola mabanga oyo ebebi na matono mpe babwaka yango libanda ya engumba na esika ya mbindo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo akosenga ete bakokola mir nyonso na ngambo na yango ya kati mpe babwaka libanda ya engumba na esika ya mbindo mabele nyonso oyo bakokola.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima, bakozongisa mabanga mosusu na bisika oyo balongolaki mpe bakozwa mabele mosusu mpo na kopakola ndako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na kolongola mabanga oyo ebebaki, kokokola bamir mpe kopakola mabele mosusu, soki litono esalemi lisusu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akokende kotala lisusu malamu : soki amoni solo ete litono esalemi lisusu mpe epanzani, wana elakisi ete maba ezali kati na ndako mpe ndako yango ekokoma mbindo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye bakokweyisa ndako yango : mabanga mpe mabaya na yango nyonso ekobwakama na libanda ya engumba na esika ya mbindo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo nyonso oyo ndako ekozala ya kokangama, moto nyonso oyo akokota akozala mbindo kino na pokwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo akolekisa butu to kolia kati na ndako yango, asengeli kosukola bilamba na ye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, soki na ngonga ya kotala malamu ndako sima na kopakola yango mabele, Nganga-Nzambe amoni te kobima ya litono, wana akoloba ete ndako yango ezali peto, pamba te mbindo na yango esili kolongwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye mpo na kopetolama na yango, Nganga-Nzambe akozwa bandeke mibale, mabaya ya sedele, eteni ya elemba ya motane makasi mpe eteni ya nzete ya izope ;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "akokata kingo ya ndeke ya liboso na likolo ya sani oyo basala na mabele mpe ezali na mayi ya peto kati na yango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akokamata mabaya ya sedele, eteni ya nzete ya izope, eteni ya elamba ya motane makasi mpe ndeke mosusu, akozindisa yango kati na makila ya ndeke oyo asilaki kokata kingo mpe kati na mayi ya peto oyo akobwaka na likolo ya ndako mbala sambo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akopetola ndako na nzela ya makila ya ndeke, ya mayi ya peto, ya ndeke oyo ezali na bomoi, ya mabaya ya sedele, ya eteni ya nzete ya izope mpe ya eteni ya elamba ya motane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo akotika ndeke oyo etikalaki ya bomoi kokende na zamba, na libanda ya engumba. Ezali ndenge wana nde akosala mosala ya bolimbisi masumu ya ndako ; mpe ndako yango ekokoma peto. »",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nde mibeko oyo etali lolenge nyonso ya maba, litono,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "maba ya elamba mpe ya ndako,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "bambuma ya mike-mike, mapalata mpe matono oyo ezali kongenga,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kotalisa soki moto azali mbindo to te. Yango nde mibeko oyo etali maba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
    }
  ],
