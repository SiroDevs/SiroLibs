        },
        {
          "text": "Ekozala mpo na bino mokolo ya Saba, mokolo ya bopemi, mpe bosengeli komikitisa. Ezali malako ya libela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
