            "sid": "PRO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masese ya Salomo, mwana mobali ya Davidi, mokonzi ya Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.1",
            "verseOrgIds": [
              "PRO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na koyeba bwanya, kozwa mateya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:2"
      },
      "items": [
        {
          "text": "mpe kososola maloba ya mayele ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kozwa mateya ya bwanya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:3"
      },
      "items": [
        {
          "text": "oyo epesaka bizaleli ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:3"
      },
      "items": [
        {
          "text": "ya boyengebene mpe makambo ya alima ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kopesa mayele epai ya bazoba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:4"
      },
      "items": [
        {
          "text": "mpe boyebi epai ya bilenge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moto ya bwanya ayoka yango,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "mpe akobakisa bwanya na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "bongo moto ya mayele akoyeba mayele",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "ya kotambolisa bato ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kososola masese mpe sambole,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:6"
      },
      "items": [
        {
          "text": "maloba ya bwanya mpe kolimbola makambo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fungola ya bwanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotosa Yawe ezali mosisa ya mayele ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:7"
      },
      "items": [
        {
          "text": "bato oyo bazangi mayele batiolaka bwanya mpe toli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai ya mobali, yoka toli ya tata na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:8"
      },
      "items": [
        {
          "text": "mpe kobwaka te mateya ya mama na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ekozala lokola ekoti ya ngolu na moto na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:9"
      },
      "items": [
        {
          "text": "mpe lokola mayaka ya kitoko na kingo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:10"
      },
      "items": [
        {
          "text": "soki bato ya masumu balingi kokweyisa yo, komitika te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki balobi na yo : « Yaka elongo na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "tika ete tosala motambo mpo na koboma bato,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "tokosepela mpo na kokanga moto",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "oyo ayebi likambo te !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge mokili ya bakufi esalaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "tokomela ye ya bomoi, tokomela ye mobimba",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "lokola bato oyo bakitaka na libulu ya kufa ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokozwa biloko ya talo ya ndenge na ndenge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:13"
      },
      "items": [
        {
          "text": "mpe tokotondisa bandako na biso",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:13"
      },
      "items": [
        {
          "text": "na bomengo ya bitumba ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "okozwa ndambo na yo epai na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:14"
      },
      "items": [
        {
          "text": "pamba te biso nyonso tokosangisa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:14"
      },
      "items": [
        {
          "text": "biloko na biso esika moko ; »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana na ngai ya mobali, kokende elongo na bango te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:15"
      },
      "items": [
        {
          "text": "longola makolo na yo na nzela na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te makolo na bango ekimaka mbangu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:16"
      },
      "items": [
        {
          "text": "mpo na kolanda mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:16"
      },
      "items": [
        {
          "text": "mpe bapotaka mbangu mpo na kosopa makila.",
          "type": "text",
