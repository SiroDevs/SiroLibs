          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monoko ya moto oyo azangi mayele ememelaka ye kufa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
