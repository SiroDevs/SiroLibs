      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:12"
      },
      "items": [
        {
          "text": "motema na ye ekomaka na lolendo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
