      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:8"
      },
      "items": [
        {
          "text": "ekitaka na esengo kino na libumu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
