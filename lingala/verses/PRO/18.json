      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:6"
      },
      "items": [
        {
          "text": "mpe monoko na ye eyeisaka fimbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
