      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:5"
      },
      "items": [
        {
          "text": "mpe kokweyisa moyengebene, kati na kosambisama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
