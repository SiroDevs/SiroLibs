      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:7"
      },
      "items": [
        {
          "text": "mpo na molimo na ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
