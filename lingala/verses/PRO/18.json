      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:1"
      },
      "items": [
        {
          "text": "atelemelaka bososoli nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
