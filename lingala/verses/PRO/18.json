      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:4"
      },
      "items": [
        {
          "text": "oyo etondi makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
