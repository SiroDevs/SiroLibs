      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:4"
      },
      "items": [
        {
          "text": "ezala bato mabe, asala bango mpo na mokolo ya pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
