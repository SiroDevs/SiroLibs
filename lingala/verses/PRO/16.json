          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema ya moto esalaka mabongisi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:1"
      },
      "items": [
        {
          "text": "kasi eyano ewutaka epai na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
