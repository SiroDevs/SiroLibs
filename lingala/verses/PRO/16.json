      "attrs": {
        "style": "q2",
        "vid": "PRO 16:15"
      },
      "items": [
        {
          "text": "elingi koloba : bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
