          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolingo mpe bosembo elongolaka mbeba ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
