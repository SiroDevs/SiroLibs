      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:6"
      },
      "items": [
        {
          "text": "kotosa Yawe etindaka moto kokima mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
