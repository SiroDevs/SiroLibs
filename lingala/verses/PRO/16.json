      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:2"
      },
      "items": [
        {
          "text": "kasi Yawe nde amekaka mitema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
