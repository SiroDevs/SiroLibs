          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki Yawe asepeli na nzela ya moto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
