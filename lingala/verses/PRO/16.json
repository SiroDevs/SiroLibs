      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:3"
      },
      "items": [
        {
          "text": "mpe mabongisi na yo ekokokisama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe asalaka makambo nyonso na tina,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
