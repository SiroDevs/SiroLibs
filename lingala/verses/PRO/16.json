            "number": "2",
            "style": "v",
            "sid": "PRO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzela nyonso ya moto emonanaka peto na miso na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
