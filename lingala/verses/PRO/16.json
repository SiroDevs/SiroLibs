        "style": "q2",
        "vid": "PRO 16:16"
      },
      "items": [
        {
          "text": "mpe kozwa mayele ezali na litomba koleka palata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
