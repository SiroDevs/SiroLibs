            "sid": "PRO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso ya lolendo azalaka nkele na miso ya Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:5"
      },
      "items": [
        {
          "text": "solo, akozanga te kozwa etumbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
