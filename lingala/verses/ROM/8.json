{
  "id": "ROM.8",
  "number": "8",
  "bookId": "ROM",
  "reference": "Barome 8",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ROM 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Molimo apesaka bomoi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana sik'oyo, etumbu ezali lisusu te mpo na bato oyo bazali kati na Yesu-Klisto.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.1",
            "verseOrgIds": [
              "ROM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te kati na Yesu-Klisto, Mobeko ya Molimo oyo apesaka bomoi ekangoli ngai na bowumbu ya mobeko ya lisumu mpe ya kufa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.2",
            "verseOrgIds": [
              "ROM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te likambo oyo Mobeko ekokaki kosala te mpo ete bomoto ezangisaki yango nguya, Nzambe asalaki yango na kotinda Mwana na Ye, na nzoto oyo ekokani na nzoto ya bato ya masumu, mpo ete akoma likabo mpo na lisumu. Boye, akatelaki masumu etumbu kati na nzoto ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.3",
            "verseOrgIds": [
              "ROM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki bongo mpo ete bosembo oyo Mobeko esengaka ekokisama kati na biso oyo totambolaka te kolanda baposa ya nzoto, kasi kolanda Molimo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.4",
            "verseOrgIds": [
              "ROM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo batambolaka kolanda baposa ya nzoto batiaka makanisi na bango na makambo ya nzoto, kasi ba-oyo batambolaka kolanda Molimo batiaka makanisi na bango na makambo ya Molimo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.5",
            "verseOrgIds": [
              "ROM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baposa ya nzoto ememaka na kufa, kasi baposa ya Molimo ememaka na bomoi mpe na kimia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.6",
            "verseOrgIds": [
              "ROM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baposa ya nzoto etombokelaka Nzambe, etosaka Mobeko ya Nzambe te mpe ekotikala kotosa yango ata moke te.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.7",
            "verseOrgIds": [
              "ROM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo batambolaka kolanda baposa ya nzoto bakoki kosepelisa Nzambe te.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.8",
            "verseOrgIds": [
              "ROM.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande bino, botambolaka te kolanda baposa ya nzoto, kasi kolanda baposa ya Molimo, mpo ete Molimo ya Nzambe azali kati na bino. Mpe soki moto azangi Molimo ya Klisto azali mpe moto na Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.9",
            "verseOrgIds": [
              "ROM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki Klisto azali kati na bino, atako nzoto na bino ekokufa mpo na lisumu, kasi Molimo azali bomoi kati na bino, pamba te bokoma bato ya sembo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.10",
            "verseOrgIds": [
              "ROM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe soki Molimo ya Ye oyo asekwisaki Yesu kati na bakufi azali kovanda kati na bino, Ye oyo asekwisaki Klisto kati na bakufi akopesa mpe bomoi epai na banzoto na bino, oyo ebengami na kokufa, na nzela ya Molimo na Ye, oyo avandaka kati na bino.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.11",
            "verseOrgIds": [
              "ROM.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana bandeko na ngai, tozali na niongo—kasi ezali niongo ya nzoto te mpo ete totambola te kolanda baposa ya nzoto.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.12",
            "verseOrgIds": [
              "ROM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te soki botamboli kolanda baposa ya nzoto bokokufa ; kasi soki bobomi, na nzela ya Molimo, misala mabe oyo bosalaka kati na banzoto na bino, bokozala na bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.13",
            "verseOrgIds": [
              "ROM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bato oyo batambolisamaka na Molimo ya Nzambe bazali bana na Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.14",
            "verseOrgIds": [
              "ROM.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, bozwaki te Molimo oyo akomisaka bino bawumbu mpo ete bozala na kobanga, kasi bozwaki Molimo oyo akomisaka bino bana na Nzambe, mpe ezali na nzela ya Molimo yango nde togangaka : « Tata ! »",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.15",
            "verseOrgIds": [
              "ROM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimo Ye moko atatolaka na molimo na biso ete tozali bana na Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.16",
            "verseOrgIds": [
              "ROM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe soki tozali bana, tozali mpe bakitani ya libula : tozali bakitani ya libula ya Nzambe, mpe bakitani ya libula elongo na Klisto, soki penza tozali komona pasi elongo na Ye mpo ete tozwa mpe nkembo elongo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.17",
            "verseOrgIds": [
              "ROM.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pasi ya tango oyo mpe nkembo oyo ezali koya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakanisi ete pasi ya tango oyo ekokani te na motuya ya nkembo oyo ekomonisama mpo na biso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bikelamu nyonso ezali kozela na posa makasi ete bana na Nzambe bamonisama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.19",
            "verseOrgIds": [
              "ROM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bikelamu nyonso ezali na se ya bokonzi ya nguya oyo esukaka na pamba ; na mokano na yango moko te, kasi na mokano ya Ye oyo atiaki bikelamu yango na se ya bokonzi yango, na elikya ete",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.20",
            "verseOrgIds": [
              "ROM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bikelamu nyonso mpe ekokangolama na bowumbu ya libebi na yango mpo na kozwa bonsomi ya nkembo oyo bana na Nzambe bakozwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.21",
            "verseOrgIds": [
              "ROM.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyebi malamu ete kino sik'oyo, bikelamu nyonso ezali kolela pasi lokola mwasi oyo azali na pasi ya kobota.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.22",
            "verseOrgIds": [
              "ROM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali yango moko kaka te nde ezali kolela ; kasi biso ba-oyo mpe tozwaki Molimo lokola mbuma ya liboso tozali mpe komona pasi kati na mitema, wana tozali kozela na posa makasi ete Nzambe akomisa biso bana na Ye penza mpe asikola banzoto na biso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.23",
            "verseOrgIds": [
              "ROM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te tosila kobika, kasi kobika yango ezali nanu elikya. Nzokande soki tozali komona eloko oyo tozali kotiela elikya, wana ezali lisusu elikya te, pamba te nani akoki kotia elikya na eloko oyo azali komona ?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.24",
            "verseOrgIds": [
              "ROM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki tozali kotia elikya na eloko oyo tozali komona te, solo tokozela yango na molende.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge moko mpe Molimo ayaka kosunga biso kati na bolembu na biso ; pamba te toyebi te kosambela na lolenge oyo esengeli, kasi Molimo Ye moko abondelaka mpo na biso na maloba oyo moto akoki koloba te.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.26",
            "verseOrgIds": [
              "ROM.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe Nzambe oyo akundolaka mozindo ya mitema ayebi makanisi ya Molimo, pamba te Molimo abondelaka mpo na basantu kolanda mokano ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe toyebi malamu ete kati na makambo nyonso, Nzambe asalaka mpo na bolamu ya bato oyo balingaka Ye, ba-oyo babengama kolanda mabongisi na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bato oyo Nzambe ayeba wuta kala, abongisa mpe bango wuta kala mpo ete bakokana na Mwana na Ye, mpo ete azala Mwana ya liboso kati na bandeko ebele.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe ba-oyo abongisa wuta kala, abenga mpe bango ; ba-oyo abenga, akomisa bango bato ya sembo ; mpe ba-oyo akomisa bato ya sembo, apesa bango mpe nkembo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bolingo ya Nzambe epesaka elikya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, toloba lisusu nini ? Soki Nzambe azali mpo na biso, nani akotelemela biso ?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.31",
            "verseOrgIds": [
              "ROM.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye oyo aboyaki te kopesa Mwana na Ye se moko, kasi akabaki Ye mpo na biso nyonso, ndenge nini azanga kopesa biso biloko nyonso elongo na Ye na nzela ya ngolu ?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.32",
            "verseOrgIds": [
              "ROM.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akofunda bato oyo Nzambe apona ? Ezali Nzambe nde akomisaka sembo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.33",
            "verseOrgIds": [
              "ROM.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akokatela bango etumbu ? Moko te ! Yesu-Klisto akufaki ; kutu, asekwaki, azali na ngambo ya loboko ya mobali ya Nzambe, mpe azali kobondela mpo na biso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.34",
            "verseOrgIds": [
              "ROM.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akokabola biso na bolingo ya Klisto ? Pasi, somo, minyoko, nzala, kozanga bilamba, likama to mopanga ?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.35",
            "verseOrgIds": [
              "ROM.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolanda ndenge ekomama :",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 8:36"
      },
      "items": [
        {
          "text": "« Ezali mpo na Yo nde balukaka koboma biso mikolo nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 8:36"
      },
      "items": [
        {
          "text": "bazwaka biso lokola bameme ya koboma. »",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ROM 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi kati na makambo oyo nyonso, tozali penza balongi na nzela ya Ye oyo alinga biso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.37",
            "verseOrgIds": [
              "ROM.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ROM 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te nandimisami ete ezala kufa to bomoi, ba-anjelu to milimo mabe, makambo ya mikolo oyo to makambo oyo ekoya, banguya ya ndenge na ndenge,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.38",
            "verseOrgIds": [
              "ROM.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ROM 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "banguya ya likolo to ya se ya mabele to eloko mosusu oyo Nzambe akela, eloko moko te ekoki kokabola biso na bolingo ya Nzambe kati na Yesu-Klisto, Nkolo na biso.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.39",
            "verseOrgIds": [
              "ROM.8.39"
            ]
          }
        }
      ]
    }
