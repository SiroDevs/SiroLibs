    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Nzembo ya mitano : Libondeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:1"
      },
      "items": [
        {
          "text": "kanisa makambo oyo ekomeli biso !",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:1"
      },
      "items": [
        {
          "text": "Tala mpe mona soni na biso !",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libula na biso ekeyi na maboko ya bapaya,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:2"
      },
      "items": [
        {
          "text": "bandako na biso ekeyi na maboko ya bato mosusu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokomi lokola bana bitike, tozangi tata ;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:3"
      },
      "items": [
        {
          "text": "bamama na biso bakomi lokola basi bakufisa mibali !",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosengeli kofuta mbongo ata mpo na mayi na biso ya komela",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:4"
      },
      "items": [
        {
          "text": "to mpe mpo na bakoni na biso !",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banguna na biso bazali kolanda biso,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:5"
      },
      "items": [
        {
          "text": "bakomi na sima ya mokongo ;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:5"
      },
      "items": [
        {
          "text": "bongo biso tolembi nzoto, tozangi kimia.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokomi ata kobondela bato ya Ejipito mpe ya Asiri",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:6"
      },
      "items": [
        {
          "text": "mpo ete bapesa biso bilei.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo batata na biso basalaki masumu,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:7"
      },
      "items": [
        {
          "text": "kasi bazali lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 5:7"
      },
      "items": [
        {
          "text": "bongo biso tokomi komema",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:7"
      },
      "items": [
        {
          "text": "mokumba ya etumbu na bango.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawumbu bakomi kokonza biso,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:8"
      },
      "items": [
        {
          "text": "mpe moto ata moko te amonani",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:8"
      },
      "items": [
        {
          "text": "mpo na kokangola biso na maboko na bango.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tozali kozwa bilei na biso na motuya ya bomoi na biso,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:9"
      },
      "items": [
        {
          "text": "likolo na mopanga ya babomi kuna na esobe.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poso ya nzoto na biso ekomi moto",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:10"
      },
      "items": [
        {
          "text": "lokola nde balekisi yango na mbabola,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:10"
      },
      "items": [
        {
          "text": "pamba te nzala ezali kotumba biso makasi.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basambwisi basi kati na Siona,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:11"
      },
      "items": [
        {
          "text": "mpe bilenge basi oyo bayebi nanu nzoto ya mibali te",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:11"
      },
      "items": [
        {
          "text": "kati na bingumba ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badiembiki bakalaka, na maboko na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:12"
      },
      "items": [
        {
          "text": "mpe bapesi bakambi lokumu te.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilenge mibali bazali komema libanga oyo banikelaka ble ;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:13"
      },
      "items": [
        {
          "text": "bongo bana mike bazali kotepatepa na se ya kilo ya bakoni.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambi batika kokende na ekuke ya engumba,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:14"
      },
      "items": [
        {
          "text": "mpe bilenge batika kobeta mindule.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo ezalaka lisusu te kati na mitema na biso,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:15"
      },
      "items": [
        {
          "text": "mabina na biso ebongwana matanga.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitole ekweyi wuta na mito na biso.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:16"
      },
      "items": [
        {
          "text": "Mawa na biso, mpo ete tosali masumu !",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
