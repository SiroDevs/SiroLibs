  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ECC 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobosana Mokeli na yo te",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanisa Mokeli na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "na mikolo nyonso ya bolenge na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "liboso ete mikolo ya pasi ekomela yo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "mpe mibu epusana, mibu oyo okoloba na tina na yango :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:1"
      },
      "items": [
        {
          "text": "« Nazali kosepela na ngai na yango te ; »",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "liboso ete moyi mpe pole, sanza mpe minzoto,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:2"
      },
      "items": [
        {
          "text": "ekoma molili,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:2"
      },
      "items": [
        {
          "text": "mpe mapata ezonga sima na mvula ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "tango bakengeli ya ndako bakolenga,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "mpe bato ya makasi bakofukama ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "tango basi oyo banikaka ble bakotika konika yango",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "mpo ete bazali lisusu mingi te,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "mpe bato oyo batalaka na maninisa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:3"
      },
      "items": [
        {
          "text": "bakobungisa kitoko na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tango bikangelo ya ekuke ekokangama na balabala,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:4"
      },
      "items": [
        {
          "text": "mpe makelele ya basi oyo banikaka ble ekosila ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:4"
      },
      "items": [
        {
          "text": "tango bato balamukaka na banzembo ya bandeke",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:4"
      },
      "items": [
        {
          "text": "mpe bayembi ya basi batikaka koyemba ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tango bato bakomaka kobanga komata likolo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "mpe bakomaka kobanga makama na nzela ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "tango nzete ya pome ebimisaka mbuma,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "tango mabanki ekomaka kilo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "mpe baposa ekokisamaka lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "pamba te moto akendaka na ndako ya libela,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "mpe basi oyo balelaka na bibembe",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:5"
      },
      "items": [
        {
          "text": "basanganaka na balabala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, kanisa Mokeli na yo liboso ete",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:6"
      },
      "items": [
        {
          "text": "singa ya palata ekatana, kopo ya wolo efinana,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 12:6"
      },
      "items": [
        {
          "text": "eloko ya mayi ebukana na libulu ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:6"
      },
      "items": [
        {
          "text": "mpe mashini oyo babendelaka mayi na libulu ebukana ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "liboso ete putulu ezonga na mabele",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:7"
      },
      "items": [
        {
          "text": "epai wapi ewutaki,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:7"
      },
      "items": [
        {
          "text": "mpe pema ezonga epai ya Nzambe oyo apesaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba na pamba, elobi mosakoli,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 12:8"
      },
      "items": [
        {
          "text": "makambo nyonso ezali kaka pamba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Suka ya mateya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosakoli azalaki kaka moto ya bwanya te, kasi azalaki mpe koyekolisa bato boyebi ; akanisaki mingi, alukaki mingi mpe atiaki na molongo masese ebele penza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosakoli asalaki makasi mpo na koluka koyeba maloba ya elengi mpe kokoma na bosembo makambo ya solo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba ya bato ya bwanya ezali lokola banzube, mpe buku ya masese na bango ezali lokola basete oyo ekotaka makasi na libaya. Masese yango nyonso ewuti epai ya Mobateli mpate moko.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai, keba ete obakisa eloko moko te na likolo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ECC 12:12"
      },
      "items": [
        {
          "text": "Suka ezali te mpo na kokoma mikanda ebele, mpe koyekola mingi elembisaka nzoto.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
