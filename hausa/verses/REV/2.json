        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na ba ta lokaci tă tuba daga fasikancinta, amma ba ta da niyya.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
