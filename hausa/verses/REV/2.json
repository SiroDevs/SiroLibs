          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Don haka zan jefa ta a kan gadon wahala, zan kuma sa waɗanda suke zina da ita, su sha azaba ƙwarai, sai dai in sun tuba daga hanyoyinta.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
