        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Zai yi mulki a kansu da sandar sarauta ta ƙarfe, zai farfashe su, kamar tukwanen yumɓu'",
              "type": "text"
            }
          ]
        },
