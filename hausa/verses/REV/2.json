        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sai dai ku riƙe abin da kuke da shi har sai na zo.'",
              "type": "text"
            }
          ]
        }
      ]
    },
