              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zan kashe 'ya'yanta. Sa'an nan dukan ikkilisiyoyi za su san cewa ni ne mai bincika zukata da tunani, zan kuwa sāka wa kowannenku gwargwadon ayyukansa.",
              "type": "text"
            }
          ]
        }
      ]
    },
