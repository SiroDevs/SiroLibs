        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yanzu, ina ce wa sauranku da kuke a Tiyatira, ku da ba ku riƙe da koyarwarta ba kuma ba ku koyi abin da suke kira zurfafan asiran Shaiɗan, 'Ba zan ƙara muku wani nauyi ba.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
