          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gare shi wanda ya ci nasara ya kuma aikata nufina har ƙarshe, zan ba shi iko a kan al'ummai.",
