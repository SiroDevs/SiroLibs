{
  "id": "JHN.1",
  "number": "1",
  "bookId": "JHN",
  "reference": "Yohanna 1",
  "copyright": "Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™ Neman RubutaccenIzini © 2009, 2020 ta hannun Biblica, Inc. Biblica® Open Hausa Contemporary Bible™ Copyright © 2009, 2020 by Biblica, Inc. \"Biblica\" wani tambarin ne da aka yi wa rajista a ofishi Lamba Ƙerar da Tambari a Amurka ta hannun Biblica, Inc. Wanda aka yi amfani ta wurin samun izini. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JHN 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalman ya zama mutum",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tun farar farawa akwai Kalma, Kalman kuwa yana nan tare da Allah, Kalman kuwa Allah ne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.1",
            "verseOrgIds": [
              "JHN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yana nan tare da Allah tun farar farawa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.2",
            "verseOrgIds": [
              "JHN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta wurin Kalman ne aka halicci dukan abubuwa. In ba tare da shi ba, babu abin da aka yi wanda aka yi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.3",
            "verseOrgIds": [
              "JHN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A cikinsa rai ya kasance, wannan rai kuwa shi ne hasken mutane.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.4",
            "verseOrgIds": [
              "JHN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasken yana haskakawa cikin duhu, amma duhun bai rinjaye shi ba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.5",
            "verseOrgIds": [
              "JHN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwai wani mutumin da aka aiko daga Allah; mai suna Yohanna.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.6",
            "verseOrgIds": [
              "JHN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya zo a matsayin mai shaida domin yă ba da shaida game da wannan haske, don ta wurinsa dukan mutane su ba da gaskiya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.7",
            "verseOrgIds": [
              "JHN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shi kansa ba shi ne hasken ba; sai dai ya zo a matsayin shaida ne kaɗai ga hasken.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.8",
            "verseOrgIds": [
              "JHN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haske na gaskiya da yake ba da haske ga kowane mutum mai shigowa duniya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yana a duniya, kuma ko da yake an yi duniya ta wurinsa ne, duniya ba tă gane shi ba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.10",
            "verseOrgIds": [
              "JHN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya zo wurin abin da yake nasa, amma nasa ɗin ba su karɓe shi ba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.11",
            "verseOrgIds": [
              "JHN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duk da haka dukan waɗanda suka karɓe shi, ga waɗanda suka gaskata a sunansa, ya ba su iko su zama 'ya'yan Allah",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.12",
            "verseOrgIds": [
              "JHN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "'ya'yan da aka haifa ba bisa hanyar 'yan adam,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        },
        {
          "text": "ko shawarar mutum ko nufin namiji ba, sai dai haifaffu bisa ga nufin Allah.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalman ya zama mutum, ya kuwa zauna a cikinmu. Muka ga ɗaukakarsa, ɗaukaka ta wanda yake Ɗaya kuma Makaɗaici, wanda ya zo daga wurin Uba, cike da alheri da gaskiya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Yohanna ya ba da shaida game da shi. Ya ɗaga murya yana cewa, \"Wannan shi ne wanda na ce, 'Mai zuwa bayana ya fi ni girma domin yana nan kafin ni.' \")",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.15",
            "verseOrgIds": [
              "JHN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daga yalwar alherinsa dukanmu muka sami albarka bisa albarka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.16",
            "verseOrgIds": [
              "JHN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama an ba da doka ta wurin Musa; alheri da gaskiya kuwa sun zo ne ta wurin Yesu Kiristi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.17",
            "verseOrgIds": [
              "JHN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba wanda ya taɓa ganin Allah, sai dai Allah da yake Ɗaya da kuma Makaɗaici wanda yake a gefen Uba, shi ne ya bayyana shi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yohanna Mai Baftisma ya ce ba shi ne Kiristi ba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "To, ga shaidar Yohanna sa'ad da Yahudawan Urushalima suka aiki firistoci da Lawiyawa su tambaye shi ko shi wane ne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.19",
            "verseOrgIds": [
              "JHN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bai yi mūsu ba, amma ya shaida a fili cewa, \"Ba ni ne Kiristi ba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.20",
            "verseOrgIds": [
              "JHN.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai suka tambaye shi suka ce, \"To, wane ne kai? Kai ne Iliya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "Ya ce, \"A'a, ni ba shi ba ne.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "\"Kai ne Annabin nan?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:21"
      },
      "items": [
        {
          "text": "Ya amsa ya ce, \"A'a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ƙarshe suka ce, \"Wane ne kai? Ka ba mu amsa don mu mayar wa waɗanda suka aike mu. Me kake ce da kanka?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.22",
            "verseOrgIds": [
              "JHN.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanna ya amsa da kalmomin annabi Ishaya, \"Ni murya ne mai kira a hamada, 'Ku miƙe hanya domin Ubangiji.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "To, waɗansu Farisiyawan da aka aika",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.24",
            "verseOrgIds": [
              "JHN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "suka tambaye shi suka ce, \"Don me kake yin baftisma in kai ba Kiristi ba ne, ba kuwa Iliya ba, ba kuma annabin nan ba?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.25",
            "verseOrgIds": [
              "JHN.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanna ya amsa ya ce, \"Ni dai ina baftisma da ruwa ne, amma a cikinku akwai wani tsaye da ba ku sani ba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.26",
            "verseOrgIds": [
              "JHN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shi ne mai zuwa bayana, wanda ko igiyar takalmansa ma ban isa in kunce ba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.27",
            "verseOrgIds": [
              "JHN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wannan duk ya faru ne a Betani a ƙetaren Urdun, inda Yohanna yake yin baftisma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Ɗan Rago na Allah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kashegari Yohanna ya ga Yesu yana zuwa wajensa sai ya ce, \"Ku ga, ga Ɗan Rago na Allah mai ɗauke zunubin duniya!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.29",
            "verseOrgIds": [
              "JHN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wannan shi ne wanda nake nufi sa'ad da na ce, 'Mutum mai zuwa bayana ya fi ni girma, domin yana nan kafin ni.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.30",
            "verseOrgIds": [
              "JHN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko ni ma dā ban san shi ba, sai dai abin da ya sa na zo ina baftisma da ruwa shi ne domin a bayyana shi ga Isra'ila.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.31",
            "verseOrgIds": [
              "JHN.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai Yohanna ya ba da wannan shaida, \"Na ga Ruhu ya sauko kamar kurciya daga sama ya zauna a kansa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.32",
            "verseOrgIds": [
              "JHN.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dā ban san shi ba, sai dai wanda ya aiko ni in yi baftisma da ruwa ya gaya mini cewa, 'Mutumin da ka ga Ruhu ya sauko ya kuma zauna a kansa shi ne wanda zai yi baftisma da Ruhu Mai Tsarki.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.33",
            "verseOrgIds": [
              "JHN.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na gani na kuma shaida cewa wannan Ɗan Allah ne.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Almajiran Yesu na farko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kashegari kuma Yohanna yana can tare da biyu daga cikin almajiransa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.35",
            "verseOrgIds": [
              "JHN.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da ya ga Yesu yana wucewa, sai ya ce, \"Ku ga, ga Ɗan Rago na Allah!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.36",
            "verseOrgIds": [
              "JHN.1.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da almajiran nan biyu suka ji ya faɗi haka, sai suka bi Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.37",
            "verseOrgIds": [
              "JHN.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da juyewa, sai Yesu ya ga suna bin sa, sai ya tambaye, su ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Me kuke nema?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.38",
                "verseOrgIds": [
                  "JHN.1.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:38"
      },
      "items": [
        {
          "text": "Suka ce, \"Rabbi\" (wato, \"Malam\"), \"ina kake da zama?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya amsa musu ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku zo, za ku kuma gani.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.39",
                "verseOrgIds": [
                  "JHN.1.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:39"
      },
      "items": [
        {
          "text": "Saboda haka suka je suka ga inda yake da zama, suka kuma zauna a can tare da shi. Wajen sa'a ta goma ce kuwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andarawus ɗan'uwan Siman Bitrus, yana ɗaya daga cikin biyun nan da suka bi Yesu bayan da suka ji maganar Yohanna a kan Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.40",
            "verseOrgIds": [
              "JHN.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu na fari da Andarawus ya yi shi ne ya sami ɗan'uwansa Siman ya gaya masa cewa, \"Mun sami Almasihu\" (wato, Kiristi).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.41",
            "verseOrgIds": [
              "JHN.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya kuma kawo shi wurin Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:42"
      },
      "items": [
        {
          "text": "Yesu ya dube shi ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kai ne Siman ɗan Yohanna. Za a ce da kai Kefas\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.42",
                "verseOrgIds": [
                  "JHN.1.42"
                ]
              }
            }
          ]
        },
        {
          "text": "(in an fassara, Bitrus ke nan",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "text": ").",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ya kira Filibus da Natanayel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kashegari Yesu ya yanke shawara yă tafi Galili. Da ya sami Filibus sai ya ce masa,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bi ni.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.43",
                "verseOrgIds": [
                  "JHN.1.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filibus, kamar Andarawus da Bitrus shi ma daga garin Betsaida ne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.44",
            "verseOrgIds": [
              "JHN.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filibus ya sami Natanayel ya kuma gaya masa, \"Mun sami wanda Musa ya rubuta game da shi a cikin Doka, kuma wanda annabawa suka rubuta a kansa, Yesu Banazare, ɗan Yusuf.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.45",
            "verseOrgIds": [
              "JHN.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natanayel ya ce, \"A Nazaret! Wani abin kirki zai iya fito daga can?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:46"
      },
      "items": [
        {
          "text": "Filibus ya ce, \"Zo ka gani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da Yesu ya ga Natanayel yana zuwa, sai ya yi magana game da shi cewa,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ga mutumin Isra'ila na gaske wanda ba shi da ha'inci.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.47",
                "verseOrgIds": [
                  "JHN.1.47"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natanayel ya yi tambaya ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A ina ka san ni?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.48",
                "verseOrgIds": [
                  "JHN.1.48"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:48"
      },
      "items": [
        {
          "text": "Yesu ya amsa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na gan ka yayinda kake a gindin itacen ɓaure, kafin Filibus yă kira ka.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.48",
                "verseOrgIds": [
                  "JHN.1.48"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai Natanayel ya ce, \"Rabbi, kai Ɗan Allah ne. Kai ne Sarkin Isra'ila.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.49",
            "verseOrgIds": [
              "JHN.1.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka gaskata domin na ce maka na gan ka a gindin itacen ɓaure. Za ka ga abubuwan da suka fi haka.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.50",
                "verseOrgIds": [
                  "JHN.1.50"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai ya ƙara da cewa,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.51",
            "verseOrgIds": [
              "JHN.1.51"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gaskiya nake gaya muku, za ku ga sama a buɗe, mala'ikun Allah kuma suna hawa suna kuma sauka a kan Ɗan Mutum.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.51",
                "verseOrgIds": [
                  "JHN.1.51"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "next": {
