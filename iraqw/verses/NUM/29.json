          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "dinkwa nee ilahhooár balaangw nee ar muruú wahaango, an aweedá' alhanisá', nee gwaandaaweero nee deeláyduú gwaandaawe, adoodá' hariímár faaror'ín i diri'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
