            }
          ]
        },
        {
          "text": "«Bál tsare muruú ta ilahhooár wa hanisa' a kwí: Awér batlaay mibaá nee tsár, nee gwaandaawe tsár, nee deeloó gwaandaawe mibaá nee tsiyáhh, oo kurkú wák, masók ki xaslxaansli wasl, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
