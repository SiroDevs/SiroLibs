          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dinkwa nee ilahhooár balaangw, nee ar muruú wahaangw an awuudá' alhanisá' nee gwaanduudá' nee deelayduú gwaandaawe, adoodá' hariímár faaror'ín i diri'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.37",
            "verseOrgIds": [
              "NUM.29.37"
            ]
          }
        },
        {
