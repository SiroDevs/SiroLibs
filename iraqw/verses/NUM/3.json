              "NUM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk guruú doó Kohati xafay'ín ngu tleehhiye' bihhaá basa awa didá' hhoohhoo', ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Elisafani, garmoó Usieli an geeraharusmoó guruú doó Kohati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadiyér'ín an sandakmoó alqado amohhe'eemis, nee meésa, nee kitángw tsaa'aso kay qamaamin, nee kitángw ilahhooa nee xoosladár didá' hhoohhoo' ar tar gadiyuusi nee kaahamuuse, nee inqwaruú tarereiingw. Gadiyeduuká' sleémeero inooín ngin tlehhiitiyá'.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee Eleasari garmoó Aroni, kaahamusmoó Mungú kuna qaás tawa geeraharusmoó múk urén baraá tlahhoó Laáwiwo, nee sagesihhtusmoó múk gadiyuús didá' hhoohhoó' wa ale.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk guruú doó Merari a xwaylár Mahli nee ar Mushi, inooín awa guruú doó Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hhawaate sleémeero kina faár iimír na/oó slahhángw wák wa oohang ay kudá' urene, dinkwaaro a kume lahhoó' nee tsiire tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó guruú doó Merari a Surieli garmoó Abihaili. Inooín xafay'ín nguna tleehhiyé' bihhaá /iya awa heémaadá' hhoohhoo'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadiyér'ín a peehhoó heémaadá' hhoohhoo' amohhe'eemis, nee waqas, nee uheemi, nee yukmi'iidaá uheemiwo, nee xoslu sleémeero awa heémaadá' kara óh, gadiyeé sleémeero ar peehhoó heémaarí hhoohhoo' a inooín ngin tlehhiitiyá'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inooín sleeme uheemidá' afeeni kara harweér ngina amohhe'eemisiyé' nee yukumáydae, nee kika'aaro, nee hhutlemiiwose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose nee Aroni nee daaqay'ine kina slaá' xafay'ín nguwa tleehhiya' dír geeraá heémaadá' hhoohhoo' bihhaá da/aáw wa ale, amoodá' tsee/amá iwa ti'imiiti. Gadiyér'ín dír kawa tleehhi a didaádá' hhoohhoo', nee umuúqo gár tleehhamór sla'a as xoorór Israeli. Barnaxés heé hatlá' aa tseewúy bihhaadá' aqo kun gaas. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tlahhoó Laáwi dinkwaaro ar adoodá' maray'ín i diri'iia, hhawaate sleémeero iimír na/oó slahhángw wák wa oohang, ar adór Mose nee Aroni ngira faarii'i, adoodá' AAKOÓ MUNGÚ ngira ádbáy, faaror'ín a kume mibeeri tsár nee tsár.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 3:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy AAKOÓ MUNGÚ Mose guri báy, «Na/aá baris awa daaqaay sleémeero awa múk Israeli iimír slahhángw wák wa oohang nee awa ngaa ba/iye' faareek ar umer'ín. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuúng múk Laáwi paraatleek as anuú AAKOÓ MUNGÚ kitángw na/aá baris sleémeero awa xoorór Israeli, nee sleeme hikwaaín paraatleek as aníng kitángw na/aá barisuú wa alé awa hikwaá múk Israeli.» ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 3:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Mose na/aá baris sleémeero awa múk Israeli gina faár adoodá' AAKOÓ MUNGÚ ngira oó'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na/aá baris sleémeero awa daaqaay adoodá' kira faari ar umer'ín, iimír na/oó slahhángw wák wa oohang nee awa ngaa ba/iye', inooín a kume mibeerí tsár nee tsár nee tsiire tsár nee mibeeri faanqw nee tám.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 3:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ iri axweés nee Mose iwa kaahi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Hamí daxta múk Laáwi sleémeero paraatleek as tawa muk'eé' kitángw na/aá baris awa múk Israélír wa ale. Nee sleeme hikwaá múk Laáwi sleémeero paraatleek kitángw tsa/eetaá baris awa hikwaá múk Israélír wa ale. Aníng an AAKOÓ MUNGÚ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 3:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na/aá baris awa daaqaay awa múk Israeli kudaá tsiire tsár nee mibeeraá faanqw nee tám, as kiwa tu/i, kudá' handá' faarór hhawaataá múk Laáwi ba/a. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekeéli kooán ooheek daanduú umuúqo heewo ar qoomoó didaádá' hhoohhoo', tidá' handá' alqoomá' nee gadaádá' ta bay geéra mibeeri tsár, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 3:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee peésaarí ar tu/utá mukdá' aa harwaaraahh ka hanís dír Aroni nee daaqaywós.» ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe Mose peésaadár tu/utá mukdá' aa harwaaraahh dír faarór múk tlahhoó Laáwiwo gari burumbuúr. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peésaadá' gana ilaaóh dír na/aá baris awa Israeli, peésa dinkwaaro a shekeéli kumuú wák tsiire tám nee mibeeri lahhoó' nee kooán, ar qoomoó didaádá' hhoohhoo'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose peésaadá' mukdá' kura tuú/ gari haniís dír Aroni nee daaqaywós, adoodá' axweesantá AAKOÓ MUNGÚ i diri', nee ar adoodá' AAKOÓ MUNGÚ Mose ngura hara'ayín.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
              "NUM.3.51"
            ]
          }
        }
      ]
    }
