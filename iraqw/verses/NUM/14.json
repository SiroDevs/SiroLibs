        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tam adoorihe inooín tana sií', tari tsa/án gawaá tlooma tam handá' sandakmoó alqadór AAKOÓ MUNGÚ, laqaá Mose, aa tlaykahe dír heémaro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy múk Amaleki nee oo Kana'ani, kudá' gawaá yaamaá tlom'aá hootá', tindáy aweér, kiri i haratláy, kingiri baál, kiri guús ay gixsár Horma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
