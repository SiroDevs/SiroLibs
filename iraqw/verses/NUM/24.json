              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki iri qa/iít buhhtaawo amór Bala'amu, tsa/aá daba' giri slaáhh buhhtaawo, iri oó', «Án kuúng una ateét as wakuuser'eé' kawa lu'us, ala ga/aaweek kuúng ina tsúq ay sagaáwa tám! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamí, tláw gwagoów amoorók ar ta xu'! Geera ana slaá' uwa qaw ar muruú yaariír, ala AAKOÓ MUNGÚ qeemuwí ngwa kuúngár slaiiká, gwaa /itín diroge!»",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        }
      ]
    },
    {
