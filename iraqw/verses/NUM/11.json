          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ Mose guri mu/aywaáts, «Ahaá aleesleemueé' aa /aarúyí? Gimáy daxta axweesante'eé' adór tar ló' laqaá lama a tsáhh.»",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        }
      ]
    },
    {
