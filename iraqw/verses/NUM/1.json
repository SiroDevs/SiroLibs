            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk tlahhoó Reubeni garmoó baris oo Israeli, ar adór xwaylar'ine tira haraahariyé' nee adór maray'ine i dirii'iya', nee adór gur'ér maray'ín i diria, nee adór umer'ín i diria, adoodá' kira wakeetín faarooro, umuúqo hhawaatuuwo oo kureeriiwós mibeeri tsár ngaa aye' nee ngaa ba/iye', múk slaqwara eemuwo ido, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "dinkwaaro a muu kume mibeeri tsiyáhh nee lahhoó' nee tsiire kooán.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
