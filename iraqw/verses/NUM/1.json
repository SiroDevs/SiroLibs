            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma AAKOÓ MUNGÚ Mose guna báy, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
