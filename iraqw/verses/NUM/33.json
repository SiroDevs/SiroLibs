          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Almon-diblataimúr wa tláy, xafay'ín kuri tleéhh baraá tlom'aá Abarimu bihhaá tloomár Nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.47",
            "verseOrgIds": [
              "NUM.33.47"
            ]
          }
        },
        {
