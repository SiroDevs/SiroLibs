              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Obotír wa tláy ay Iye-abarimu, baraá yaamaá Moabu, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
