              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Yot-batár wa tláy ay Abrona, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.34",
