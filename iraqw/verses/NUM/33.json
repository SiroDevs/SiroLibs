              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Esion-geberír wa tláy ay xaanxoó Sini (laqaá Kadeshi), xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
