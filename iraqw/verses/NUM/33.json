              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár Aroni iwa gwaá' gawaá tloomár Hori, kureeriiwós a tsiiru nee mibeeri tsár nee tám.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
