          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari baraá tlom'aá Abarimúr wa tláy, xafay'ín kuri tleéhh baraá xatstá Moabu, afaá yaaér Yordani, didá' nee Yeriko ti ga/aawá'. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.48",
            "verseOrgIds": [
              "NUM.33.48"
            ]
          }
        },
        {
