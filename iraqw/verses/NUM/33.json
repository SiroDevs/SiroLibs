          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xafay'ín kuna baraá xatstá Moabú i tleéhh iisaapoó yaaér Yordani tla/ángw Bet-yeshimoti nee xatstá Abel-shitimu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
