          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Iye-abarimúr wa tláy ay Dibon-gadi, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.45",
