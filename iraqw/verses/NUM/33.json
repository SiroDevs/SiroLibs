            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Dibon-gadír wa tláy ay Almon-diblataimu, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.46",
            "verseOrgIds": [
              "NUM.33.46"
            ]
          }
        },
        {
