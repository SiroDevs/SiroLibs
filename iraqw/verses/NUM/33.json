        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.9",
            "verseOrgIds": [
              "NUM.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Elimúr wa tláy ay iisaapoó tlawtá Shamu, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.10",
            "verseOrgIds": [
              "NUM.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari didár tlawtá Shamúr wa tláy ay xaanxoó Sini, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.11",
            "verseOrgIds": [
              "NUM.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari baraá xaanxoó Sinír wa tláy ay Dofka, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.12",
            "verseOrgIds": [
              "NUM.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Dofkár wa tláy ay Alushi xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.13",
            "verseOrgIds": [
              "NUM.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Alushír wa tláy ay Refidimu, xafay'ín kuri didií tleéhh. Didaádae hhaynuú ma'aá wahaangw i kaahh.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.14",
            "verseOrgIds": [
              "NUM.33.14"
            ]
          }
        }
      ]
    },
