            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari Refidimúr wa tláy ay xaanxoó Sinai, xafay'ín kuri didií tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.15",
            "verseOrgIds": [
              "NUM.33.15"
            ]
          }
