    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Heedaádá' arba/ati ga sláw, aníng u ya/aám mamaá xa'anooduú slafiingw ngiwa /ayi, kudá' baraá asalmoó Mungú i dirií'.»",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
    {
