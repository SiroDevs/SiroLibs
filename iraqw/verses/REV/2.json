          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Kaangwí gooiimeek amór malaykamooduú múk kríshaanáy oo baraá Pergámó i dirií',",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        }
