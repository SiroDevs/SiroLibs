              "type": "text"
            }
          ]
        },
        {
          "text": "«Kaangwí gooiimeek amór malaykamooduú múk kríshaanáy oo baraá Smirnár i dirií',",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
