          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Gooidá' a tí MENE, MENE, TEKELI, nee PERESI. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaarí an gár axweesantí i kat, MENE, gár i kat a Mungú deelór waawuti'iimarók gaa faár nee gaa alhhe'eesáy hardahaás. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEKELI, a kuúng taa qoomeés ar qoomaay, naxés kuúng tu ló'wa inslaáhh. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "PERESI, a waawuti'iimarók aa qasít dír múk Medi nee múk Persia.»",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
              "DAN.5.28"
            ]
          }
        }
      ]
    },
