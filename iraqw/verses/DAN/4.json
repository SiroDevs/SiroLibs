              "DAN.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muruuwí sleémeero aa oó' ina boó/ dír waawutmo Nebukadnesa i ale. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaá slahheeraá mibaá nee tsár niwa waaraahhiyé', looarka wake waawutmo Nebukadnesa i hi'iimiit gawaá daanduú do'ós kuduú waawuti'imár wa alé oo Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo iri oó', «Ga/aawak áx adór gixsár Babuloni i diri' uraywo, tidá' aníng naa tleéhh ar aleesleemueé', as tawa gixsár ur ar waawutmo i hooti nee ar xiríf baraá waawuti'iimar'eene.»",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
