          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Qoomaadár kilá' fuqurangw'eé' niwa kií/, xirfueé' kuduú waawuti'iima kunguri ki/ís. Mukdaádá' aníng i hara'ayayiím nee geeraharuuser'eé' niri hardihiyé', iri leelehhtuú ayé', tiri ar kií/ gawaá kitangw'eé' kuduú waawuti'iima, nee ilaiwa/ame kingiri tleéhh adoodá' aáng har geeraawo i diri' ba/a.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        }
      ]
