            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi kaahamusmoó Mungú, nee geeraharuusér tlahh'aá xoorór Israeli kudá' nee inós taa alkone', axweesanoó tlahh'aá Reubeni nee oo Gadi nee tlaqtá tlahhoó Manase kuwa axaás, tari qwalaá/. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi garmoó Eleasari, kuduú kaahamusmoó Mungú tlahhi'iidaá Reubeni nee Gadi nee Manase giri báy, «Atén laarí aga tsaahhaán adór AAKOÓ MUNGÚ ir dinkwa nee atén, asma kuungá' inós ugwa ahhi'iiká nee as tlehhmusinge kuungá' xoorór Israeli aga tu/é' baraá xaraasleemaá AAKOÓ MUNGUHE.»",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
