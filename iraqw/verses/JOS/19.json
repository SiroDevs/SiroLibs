              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsawdór faanqw tlahhoó Dani guna sleér ar harqoomoó maray'ín i dirii'iya'. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
