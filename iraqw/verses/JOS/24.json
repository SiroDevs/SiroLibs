            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fadaá slaqwtá Yosefu, kudá' aáng tinda huúw nee xoorór Israeli iimír yaamaá Misrír wa ale, kiri foól yaamaá Shekemu, dír yaamuudá' Yakobo aa tlaáxw dír daaqoó Hamórí wa ale baabuú Shekemu, ar parhheemaá muqslír peésa awa tsiiruú wák. Yaamuuká' aluuwo tari aalír xwaylár Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
      ]
    },
