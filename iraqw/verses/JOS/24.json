          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo tam Eleasari garmoó Aroni sleeme iri gwaá'. Kuri foól baraá gixsár Gibea, tidá' taa garmaawós Finehasí haniís. Gixsarí i baraá tlom'aá yaamaá Efraímúrí dirí'.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
            "verseOrgIds": [
              "JOS.24.33"
            ]
          }
        }
