              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi hareerós Bat-sheba gari gurkwa/amís. Iri amór hareerós káy, inós tsiihaay guri sleér, na/oó garma guri xwayluúr. Na/aydá' Daudi guri umií tsaát guri báy Solomon. AAKOÓ MUNGÚ na/aywí guri slaá'. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inós Natani guri ya/aáw amór Daudi, as umuú na/aywí nguwa bay Yedidia",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:25",
              "type": "text"
            },
            {
              "text": "Yedidia:",
              "type": "text"
            },
            {
              "text": "Kángw Ebraniaro a ‹Oo ta slai nee AAKOÓ MUNGÚ.›",
              "type": "text"
            }
          ]
        },
        {
          "text": " as AAKOÓ MUNGÚ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomaadae, Yoabu gixsár Raba ar múk Amoni gana i haratláy slaqwaraaro. Inós gixsadár waawuti'iima gari hayóh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu hee guri ya/aáw amór Daudi, guri báy, «Aga slaqwaán nee gixsár Raba. Aníng tlahhasar'ín tidár ma'aay nga hayóh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gimáy, muu burumbureek sleémeero kudá' aa meet, xafaay sihheek, gixsa ka harwét nee ka hayót. Bar adooriheeká án bir nga hayóh, umuú gixsa kar ateeti a kwe'eé'.» ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe Daudi muu sleémeero guri burumbuúr iri tláy ay Raba, tari slaáqw nee gixsadá' ngiri hayóh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi slamangwduú waawutmooín gurir tláy gawaá sagós wa ale. Iiloeemaá slamangdá' taa tleéhh ar sahaábu a adór kílo mibeeri tám nee kooán, baraá guruuwose tlaa/anoó tlaxo úr i deer. Slamangwí kuri dahaás gawaá sákw Daudi. Slám muruú yaariír oo baraá gixsadá' guna hayóh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo múk gixsadá' guri ar tláy, giri qaás baraá gadiyeé. Xooslaá tar gadiyuusi a kuká': Masmeenadu nee sururuú muqsla, nee tsabuuwo, nee gadiyér matofaáli da/a/aangw kawa tleehhi. Adoorí an adór aa tlehhiít baraá gixsadu sleémeero awa múk Amoniwo. Alhhe'eesaywo Daudi nee muu sleémeero tari kií/ Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
      ]
    }
