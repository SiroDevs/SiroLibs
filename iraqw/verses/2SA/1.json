            "style": "v",
            "sid": "2SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Mukduú xirfuuwók kwaa tsuú/ gawaá tlom'iiwók wa ale.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.19",
            "verseOrgIds": [
              "2SA.1.19"
            ]
          }
        }
      ]
