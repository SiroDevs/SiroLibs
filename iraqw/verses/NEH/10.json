              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al'axweesani an qaasaán umuú kurko bu'úngw geera oo balaangw nee mamaá geera awa umuú xa'anoowo kiwa huwaan baraá doó AAKOÓ MUNGÚ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        }
      ]
    },
    {
