        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó múk tlahhoó Laáwi a Usi garmoó Bani, garmoó Hashabia, garmoó Matania, garmoó Mika oo tlahhoó Asafu. Inooín a daauuse nee múk gadiyér doó Mungú gaa sagesihhiit. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo adór baalaqaasir'ín gaa oó', nee gadiyér daauuseero nee muruuín oo ta slai.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        }
      ]
    },
    {
