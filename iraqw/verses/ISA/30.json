            "sid": "ISA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.7",
            "verseOrgIds": [
              "ISA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungú aníng iri báy,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.8",
            "verseOrgIds": [
              "ISA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.18",
            "verseOrgIds": [
              "ISA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungá' múk Siyoni, kudá' Yerusalemúr hootá' kuungá' a sangw baloó /aa/eé ki/a'aaká. Asma looeemawo Mungú kuungá' nu gurtláy as afór /aa/eehúng, qoomár /aa/eehúng birnga axaás, inós kuungá' nun mu/aywaats. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.19",
            "verseOrgIds": [
              "ISA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tam Aako kuungá' na slahh'eemisi nee tam naa muxi, ala tam adoorihe, intsaahhatusmoohúng aa nahhaatiiká, nee kuungá' intsaahhatusmoohúng u aandá' ilaahunge. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.20",
            "verseOrgIds": [
              "ISA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraá loohiro bar papaaslá' bartá doó basáy laqaá ar doó /iyáy, afo aqo axasá' amór aluuhúng ar kah, «Loohi a tí, loohirí nar oohaak.» ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.21",
            "verseOrgIds": [
              "ISA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungá' munguiihúng kudaá murslaaqat kudá' taa qaaliindé' ar peésa, nee kudá' taa qaaliindé' ar sahaábu kuri siá', kuri amór saáwí kwahhá' adór gár ta waki, kuri beera', «Tsumumu'uút.» ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungú tluwaay nguri haniis oo kuungá' tar dahasiinda', balaangw kuri sleerá' oo tindi hamareesi nee yaamu, balángw yaariír nee oo bu'uút. Baalaadae hikwaahúng sleeme qawór yaariir ngi slayá'. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.23",
            "verseOrgIds": [
              "ISA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awerhúng nee daqwayedár dooslaro, kin dimbeé /aymiis ar muruú /aymár taa maamahhaás, nee oo taa haritleés ar iimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalaadá' wakuuserhúng barka hhaamiís, nee /aampar'ín tidá' tleer barka daáhh, kutltá ma'aay nin gawaá tlom'ií wa wá/, nee gawaá gongooamawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalaadae slahhaangw in gwa/aat ar adór tsee/amá, nee tsee/amá in gwa/aat sagáwa faánqw wa alé, adór tsee/amuú deelo faanqw kuna baalár wák gwa/atís. Adoorí i tleehharút bál AAKOÓ MUNGÚ mukós kudá' aa muúx burngwa huungu/uusár áy, nee inkaahha'aá mukós birnga tseegár áy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
