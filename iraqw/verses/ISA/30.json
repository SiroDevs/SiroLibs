            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga/aawaak, AAKOÓ MUNGÚ ni amór saáw wa tláy.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.27",
            "verseOrgIds": [
              "ISA.30.27"
            ]
          }
        }
      ]
