          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afór Aako ngiri axaás, i kat, «Heé ni ya/aaw a heemá oo daanduurén wa daqáw?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
