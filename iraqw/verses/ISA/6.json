              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afkueé' guri kwatiít ar gil'idaádá', iri báy, «Ga/aaweek tí afkók gwaa kwatít, dakuúsarók kaa hingeés nee tlakweemaawók kaa gurtláy.»",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
