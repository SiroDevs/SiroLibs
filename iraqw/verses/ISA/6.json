          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy seraáfamoó wák dír seraáfidae, niri tláy, aníng iri haratseewúy, gawaá dakose i gil'ír asltá kón, ngina óh ar oohamaayi gawaá daanduú kitángw ilahhooár wa ale.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        }
