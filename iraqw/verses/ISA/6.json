        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afor'ín iihhafiirír doó Mungú gari diingís, nee do' iri haáts quuiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        }
      ]
