          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Aníng niri mu/aywaáts, «Aníng a diirí, án ya/aawáng!»",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
