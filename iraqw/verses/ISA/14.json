          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bál anuú AAKOÓ MUNGÚ kuungaá múk Israeli barna amohhooárí haniís baraá slahh'amuuhunge, nee baraá tlaahhiro nee lawaali'iimár gawit ar taa /agi'i, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "baldá' kuungá' waawutmoó Babuloni kuri kooyiindá' ar girayduuwí,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
      ]
    },
