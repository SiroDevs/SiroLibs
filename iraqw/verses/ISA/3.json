        },
        {
          "text": "Baala i hardát ar Aako muruudá' sleémeero /ameenár Yerusalemu ir daara/aan nguwa hayoohi, mungi'i nee himtaawero, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.18",
            "verseOrgIds": [
