          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "piiraa/ó nee mitingiri nee slam'eeri, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
          }
        },
        {
