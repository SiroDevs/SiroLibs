          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee tlabaá tar ti'imiiti deelór urene, nee biritsitoó gawaá sum'i, nee burungétaydá' iló' ta gawaá sum'i wá untsumisi, nee tlakwi'iwo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
        {
