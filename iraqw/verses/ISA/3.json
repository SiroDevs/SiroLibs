          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee warqamaá sageero, nee baangélaywo nee inqwaruú siinootaywo, nee chúpár mooyángw kooma, nee hiriísaywo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
          }
        },
        {
