            "style": "v",
            "sid": "ISA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya iri oó', «Baraá do'oge gár naa ariyé'?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Hesekia iri oó', «Umuú gár baraá dooeéní diriia ngaa ariyé', gár naa meetiís laqaamaro i káhh.»",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarusmo Isaya Hesekia guri báy, «Axweesantá AAKOÓ MUNGÚ Aleesleemusmo iiárií qaaseek, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "‹Ga/aaweek, baala ni xeér umuú gár baraá do'ógí diriia, nee muruudá sleémeero xwayliteérók aa baabáts ay laarí, sleémeero kinar tláy ay baraá yaamaá Babuloni, gár ta meetisi i káhh tam ar wák. Anuú AAKOÓ MUNGÚ tí ngina oó'. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Slám baraá daaqaywoge, bahh'ale kunár tláy baraá yaamaá Babuloni, kuri karmumúy as tawa gadiyuusi baraá doó waawutmoó Babulonír wa ale.› » ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekia Isaya guri báy, «/Aymuusíng AAKOÓ MUNGÚ i kaahi i qón.» Asma ina baraá muunaáwósí oó', «Deelo sleémeero ar slafingw'eene wayda nee amohhooa i dayá'.»",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
  ],
