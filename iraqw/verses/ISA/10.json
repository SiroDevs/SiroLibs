        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
