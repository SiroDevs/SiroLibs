          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakusmo naa Rimoni wa tláy,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.28",
            "verseOrgIds": [
              "ISA.10.28"
            ]
          }
        }
