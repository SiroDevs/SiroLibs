          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu Yehoshafati guri báy, «Aníng kuúng una qaroó bawiíke, tam looár wake aníng iga aarír hhoóí ooiiká, umuú daqto aqo gár tlaakw ngin aaín.»",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
              "2CH.18.17"
            ]
          }
        }
      ]
    },
