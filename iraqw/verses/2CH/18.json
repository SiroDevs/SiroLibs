              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya iri oó', «Aga ár slaqwaruusér Israeli sleémeero aa tsiyayaaxát gawaá tlom'i adór bee/ángw de'eemusmoó koomaaká. AAKOÓ MUNGÚ i kaahi, ‹Mukwí i geeraharusmoó konká, raaqaay inooín ta watli ar wayda.› »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
