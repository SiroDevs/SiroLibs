            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy gadiyeé sleémeero ar Solomon iri hhooeér iimír baalaadá' ihhafiirír doó Mungú ngiwa qaás, ay baalaadá' Doó AAKOÓ MUNGÚ iwa hhooáy.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Solomon iri tláy ay Esion-geberi nee Eloti, tidár afaá tlawi baraá yaamaá Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:18",
              "type": "text"
            },
            {
              "text": "Huramu:",
              "type": "text"
            },
            {
              "text": "Dirkaaro umuuwí ku babay Hiramu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " miringe gari amór Solomon ya/aáw ar geeraharuuseerós dinkwa nee múk ga madiít baraá tlawto. Kuká' dinkwa nee sagadiyuusér Solomon nay aa'aá kayé' ay yaamaá Ofiri, nee sahaábuú kílo kume mibaá nee kooán ngway amoodá' wa huwiyé' amór Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
