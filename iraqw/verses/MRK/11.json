          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu kuri báy, «A xuanaaká.»",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.33",
            "verseOrgIds": [
              "MRK.11.33"
            ]
          }
        }
      ]
    },
