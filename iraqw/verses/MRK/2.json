              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk Farisayo Yesu kuri báy, «Ga/aaweek, eeharuuseerók baré adór hariimaaká gan tlehhít bál deelór Sabaátoro.»",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
