              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ ni amór Siyonír wa /orootl,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.16",
            "verseOrgIds": [
