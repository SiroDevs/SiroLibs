              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu iri oó', «Ala bar adoosíng, na/ii ki amohhoo'. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
