          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala heé /aymu tlaxwto gwa aleeslay i kaahh. Nee iimír baalaadae heé yaahasaro gwa qiitl i kaahh.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.46",
