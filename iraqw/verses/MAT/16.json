          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu kurir bihhí suruúk nee Petro guri iigahhaát, guri báy, «Aasla'áy Aáko, Mungú tisíng ngi pa/asi, kuúng muwa sleér.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        }
