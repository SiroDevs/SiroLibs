              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomaadár kilae Yesu eeharuuseerós gari báy, «Umuúqo heewo oo aníng i eehartá wa slaá', gar kuwa hariím a sla'aarirós gan gunqarees, nee msalaábarós gari gagaar, aníng iri eehar. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma heé slafiingós gu ba/amisár wa slaá', gun qwaarees. Nee heé slafiingós qwaareesaro gwa ya/an as aníng, a gun ba/amis. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala tam hee yaamu sleémeero ngi slaya, gár nguwa buiya' a milá, bar slafiingós aa qwaár? Laqaá hee gár i duuxi a umós ar slafiingós ngur ki/isi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma Garmoó Hee i hardah ar baraá xirfuú Baabuúwós dinkwa nee malaykeerós. Qoomaadá' an qoomár umuú heewo nguwa bui ar qoomoó tlehhemi'iiwós. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Án a kah, muu i deer baraá tla/ángw mukwí sihhimiita, oo baloó qatlaaká, ay dír Garmoó Hee kway ari birna hardáh ar baraá waawuti'iimarós.»",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
          }
        }
      ]
