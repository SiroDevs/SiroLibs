              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Aá Yerusalému, Yerusalému, kiídá' aaruusér tsu/aa/iim, nee mukdá' tinda amoorók i ya/aáw un tlaqwaaqút ar tlaa/e. A sagaáwa magá' án mukók nguwa dinkwárí burumburtá wa slaá', adoodár koonki tsiioorós ngir baraá hhaampi'iiwósií burumburaariin, ala kuungá' aga ya/aandi'iiká. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga/aawaak, marayhúng naa dewaaiyé'. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma án a kah, aníng i baloó aanda'aaká daxta ay dír ti oa', ‹I xirfuuti kudá' hardáh ar umuú Aako.› »",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
            "verseOrgIds": [
              "MAT.23.39"
            ]
          }
        }
      ]
    }
