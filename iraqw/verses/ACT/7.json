              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomaadá' Stefano kuwa tlaquuti ar tlaa/e inós iri firín iri oó', «Aakoó Yésu, qeeruueé' ilaooheek.» ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.59",
            "verseOrgIds": [
