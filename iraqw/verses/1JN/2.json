              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tidá' kuungá' taa qaroó axasé' iimír iimu/uungo masók i baraahúng wa hót. Tidá' taa qaroó axasé', bir baraahúng wa hót, kuungá' daqaní sleeme a baraá Garmá wa hotá' nee baraá Baabá. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al'axweesantá inós naa dirén i oó' a tí, slafíngw alhhe'eesay wásl kuwa slawaan.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        }
      ]
    },
