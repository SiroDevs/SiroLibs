              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungá' laqwalór ninakw, baraawós wa hootaak, as qoomár Kristo birna hardáh, burkwa geehhooeés, atén mitiwa mureekeés dír geeraawós wa ale. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungá' a xuá' adór inós tar kudá' gan'amuú koóm. Gawaá adoorihe xuaak sleeme adór umuúqo heé hota ganaá' kura laqwaál nee inós.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
