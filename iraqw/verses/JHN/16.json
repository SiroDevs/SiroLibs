              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu giri báy, «Daxta aga haratlinti'í'i? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga/aawaagáy, qooma i hardát, slám qooma naa qaroó hardát, ar kuungá' sleémeero tawa diyaya/ata', umuú heewo amoorós, nee aníng iri kilooeé' geexeerá'. Ala aníng a kilooeeneeká, asma Baabá nee aníng a dinkwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
              "JHN.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí án ngina kuungá' báw, as wayda kuwa sleera' baraaeene. Baraaká' yaamuwo slahh'amu u sleerá'. Ala ma mune siaara', asma aníng yaamu iga ar baá/.»",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.33",
            "verseOrgIds": [
              "JHN.16.33"
            ]
          }
        }
      ]
