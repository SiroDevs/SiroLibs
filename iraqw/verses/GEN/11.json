              "type": "text"
            }
          ]
        },
        {
          "text": "Arpakshadi kureeriiwós tawa mibeeri tám nee kooán, Shela guri laqwaál. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
