          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera Abramu garmaawós gurir tláy, nee Loti garmoó naangós, na/oó Harani, nee Sarai harér garmaawós Abramu. Inooín nina altlayé' iimír gixsár Uri wa alé ar baraá yaamaá Kaldayo as tawa yaamaá Kana'anír kay. Ala tawa hardáh yaamaá Harani, tana baraadá' wa hoót. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera ina gwaá' baraá yaamaá Harani kureeriiwós tawa tsiire tsár nee kooán.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
