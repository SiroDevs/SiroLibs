              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuká' an xwaylár Shemu. Shemu kureeriiwós tawa tsiiru, Arpakshadi guri laqwaál, kureeraá tsár alaá tluwoó da/tene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu iri hoót kureeraá tsiire kooán alaá Arpakshadi nguwa laqwaál, na/aá hatlá' awa daaqaay nee dasu giri laqwaál.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
