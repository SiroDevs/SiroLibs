          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaá slahheeraá tám niwa waarahhiyé', Yuda kaangw gway axaás tawa kaahi, «Harér garmaawók Tamari aa fuqús, nee tsiihaay gwaa sleér.»",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
