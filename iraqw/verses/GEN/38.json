          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda iri oó', «Tsee/áy duuxaak, da/aak.»",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
