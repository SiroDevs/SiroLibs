              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda muruudá' guri tsaáhh tawa kós, iri oó', «Inós i gan'amuú koón ta ak aninge, asma aníng inós aga haniisiiká dír garmaaeé' Shela.» Aluudae Yuda gaa sangw haratseewuyká malé alé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
