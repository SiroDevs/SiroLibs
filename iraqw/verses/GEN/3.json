          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:20",
              "type": "text"
            },
            {
              "text": "Adam:",
              "type": "text"
            },
            {
              "text": "Umuuwí baraá tsifrír Ebraniaro gídaabárós a hee.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hareerós gari umií tsaát, gari báy Hawa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:20",
              "type": "text"
            },
            {
              "text": "Hawa:",
              "type": "text"
            },
            {
              "text": "Baraá tsifrír Ebraniaro a slaqmís nee slafiingw.",
              "type": "text"
            }
          ]
        },
        {
          "text": " asma a aayór múk slaáf sleémeero. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ Mungú Adam nee hareerós giri tlabaá kadú i tleéhh, giri tsiitiís.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ Mungú iri oó', «Ga/aaweek, hee daxta aa adór atén tleehhiít gawaá xu'utír hhooeema nee tlakweemaawo. Ala wané dakose mamaá xa'anoó slafíngw koóm gi taataahh, giri /aay, iri slaaf ay kureeraá kureér.» ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy AAKOÓ Mungú giri duúx baraá asalmooduú Edeniro, as yaamu ngiwa doosli, kudá' hhaper'ín inós kura tleéhh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ Mungú hee guri guús baraá asalmoodae, keruúbi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:24",
              "type": "text"
            },
            {
              "text": "Keruúbi:",
              "type": "text"
            },
            {
