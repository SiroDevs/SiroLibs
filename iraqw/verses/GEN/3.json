          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ameenidá' iri ó', «Dayshamo aníng ina al/aáy, ngiri /aáy.»",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
