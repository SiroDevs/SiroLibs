          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe, qaymór Efroni tidár baraá Makpela, bihhaá da/aáw awa Mamre, mar'i nee xaai sleémeero kudá' baraadií diriiá' kiri weeriís, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "dír Abrahamu geeraá múk Hiti sleémeero wa ale, kudá' taa dook dír afkú gixsa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
