          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo iri waátl Gibea amoodár do'ós dinkwa nee slawtá slaqwaruuse, tidá' Mungú aa mune kwatiít. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
            "verseOrgIds": [
              "1SA.10.26"
            ]
          }
        },
        {
