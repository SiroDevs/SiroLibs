          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qeemuwí oo múk Beteli nee oo múk Ramotír Negebu, nee oo múk Yatiri, ",
          "type": "text",
          "attrs": {
