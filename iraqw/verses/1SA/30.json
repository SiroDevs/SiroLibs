              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iimír baldá' Daudi hara'ayaarí gana dawa tleéhh baraá yaamaá múk Israeliro ay laarí.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
