              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy múk Amori tlahhoó Dani nguna harakeesiyé' tawa hotaá ay gawaá tlom'i, asma kaa ya/aniiká niwa aweeriya' baraá xatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
