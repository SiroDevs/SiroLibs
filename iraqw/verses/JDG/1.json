          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala tlahhoó Asheri iri hoót baraá tla/ángw múk Kana'anír wa ale, asma yaamuloouuse nga guusi'iiká.",
          "type": "text",
          "attrs": {
