          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala qoomár múk Israeli /uuru nguwa sláy, mukduú Kana'ani ngwa guusa hhe'eesi'iiká ala nguna qaminé' baraá gadiyedaá tawa bihhií biririkitiiká.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
