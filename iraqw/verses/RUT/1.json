          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
