      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari kumiít tsaraawo, tari hardáh Betilehemu. Tawa hardáh Betilehemú i alé, múk baraá gixsadá' sleémeero iri waa/oó/ as inooín. /Ameena iri waa/ó/ iri ó', «Heewí aqo tsuwaá Naómíwo?»",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        }
      ]
    },
