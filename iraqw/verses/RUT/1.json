              "RUT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inooín /aa/e ngiri malé iimu/uné'. Orpa aayír hhawaatuuwós gari deeloórí ó' ar ma'aasa. Ala Ruti iri dirós i mét. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Naomi Ruti gari beér, «Ga/aaweek, harér hhiyoó hhawaatuuwók aa kí/ amór mukós nee amór munguiiwós. Gimáy, kiíng sleeme kií/ nee inós ti koonde'.»",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
            "verseOrgIds": [
              "RUT.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
