              "RUT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoorí an adór Naomi nira kí/ baraá ayaá Moabú wá alé dinkwa nee Ruti, harér garmaawós, dasír xoorór Moabu. Niwa hardihiyé' gixsár Betilehemu a qoomár bu'úngw angaánoó shayiíri iwa iimu/u/un.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.22",
