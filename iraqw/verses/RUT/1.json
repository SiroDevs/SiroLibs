        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi ngiwa tsáhh adór Ruti ira tsabiín nee inós tiwa kona', gari sangw gaa beeriiká.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
      ]
    },
    {
