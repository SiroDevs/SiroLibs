          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Ruti iri ó',",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        }
      ]
