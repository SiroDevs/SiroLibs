          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi giri beér,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
