            "number": "20",
            "style": "v",
            "sid": "JER 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ i kaahi, «Gawaá adoorihe ga/aaweek, aníng in intsaahhatís, qoomaarihe aníng inooín in /uuruueé' xu'utís, nee aleesleemueene, inooín ngiri tsaahhiyá' adór umuueé' tar AAKOÓ MUNGÚ.»",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    }
