            "sid": "JER 51:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Adór Babuloni kara ar tláy,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.41",
            "verseOrgIds": [
              "JER.51.41"
            ]
          }
        }
