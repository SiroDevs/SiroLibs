          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe, AAKOÓ MUNGÚ i kaahi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.36",
            "verseOrgIds": [
              "JER.51.36"
            ]
          }
        }
