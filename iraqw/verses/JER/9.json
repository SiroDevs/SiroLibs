              "type": "text"
            }
          ]
        },
        {
          "text": "Alók geeraawo sagw'eé' an adór ma'aay",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.9.1"
