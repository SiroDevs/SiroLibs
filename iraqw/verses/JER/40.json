              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Gedalia garmoó Ahikamu Yohanani garmoó Karea guri báy, «Gám adoosíng ma tleehhaar kuúng Ishmaeli un lámtí tláq.»",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
