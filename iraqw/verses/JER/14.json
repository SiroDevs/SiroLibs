              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ aníng ina báy, as muu nguwa kángw baw daanduú gurhaamir'eene nee nay oó',",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
