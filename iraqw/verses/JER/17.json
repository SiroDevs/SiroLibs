            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ án hungu/uusáng,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
