        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
