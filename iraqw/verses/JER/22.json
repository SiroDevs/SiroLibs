          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungá' múk Yerusaleému, tsa/amé' gawaá Lebanoni, /aa/é',",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
