          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tsaxwaawós heedaádá' do' gwaa tleehh ar /ayta,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
