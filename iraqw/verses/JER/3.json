          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aníng ngiwa xuu' geeraawo, kuúng un adór na/ay'eé' tleéhh,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
