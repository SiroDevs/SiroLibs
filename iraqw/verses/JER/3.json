              "type": "text"
            }
          ]
        },
        {
          "text": "Barnaxes hee hareerós gaa talaákárií haniís,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
