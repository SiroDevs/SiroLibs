          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAKOÓ MUNGÚ aníng iri báy, «Múk Israeli kudá' aa dee/anuut, a tsiní ta múk Yuda kuduú lamuuseero. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tláw múk Israeli axweesantí baweek:",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
