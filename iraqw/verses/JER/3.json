            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
