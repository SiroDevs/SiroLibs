              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Laqaá barnaxes pu/i ngin huwa gawaá daanduú yaamuuká', nee buhhtaaeene muu nee makaywo ngiri tsuú/, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.19",
            "verseOrgIds": [
              "EZK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "tam geeraawo barnaxes Noa, nee Danieli, nee Yobu in baraá yaamuukae, adór anuú Aakoó MUNGÚ nirqo hotaatina, ar ló', tam na/oó wák oo garma laqaá oo dasi oo ta ba/amiisi i kaahh. Aqo har inooín slafingw'ín kilós ngun /iisiyá', asma gan'amuuín kudá' ta kon.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Ala anuú Aakoó MUNGÚ a kah, qoomár bar Yerusalemu aga slaáhh ar muruuwí tsiyáhh oo sakwasleemar'eé' tidá' ló'wa xaraasl, ngiri sakwasleemuút ar slaqwara nee qwari, nee makaá xaraaslá' nee tiqtír pu/i, as muu nee makaywo ngiwa hhaamiis baraakae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
