              "EZK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Barnaxes makaá sla/a awa xaraaslá' in ya/aawa muu nguwa /ayiya', na/ii'ín ngiri hayohiyá', yaamu niri deewaaiyá', nee heé waarahhamuú baraá yaamuudá' gu qiítl tumu wák iri kaahh as makaydá' xaraaslá'. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.15",
            "verseOrgIds": [
              "EZK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tam geera mukwí tám bar in deero baraá yaamuukae, lo'o an /aáy ar umuueé', anuú AAKOÓ MUNGÚ, tam na/ii'ínaá kilá' /iisaro ngi aleeslay'aaká, tam na/oó garma laqaá oo dasi, aqo har inooín kilooín kin ba/amis, ala yaamuudá' aqo in deewaaiyá' adór panmo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Barnaxes aníng slaqwara an iimu/uuma dír yaamuukae ar muu nee makaywo kiwa hhaamisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
              "EZK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwí tám geera bar in baraá yaamuuká' i dirii'i, looeemaawo tam na/oó wák baraá na/ii'ine ba/amiisaro ngu aleeslayká, tam na/oó garma laqaá oo dasi. Inooín aqo har slafingw'ín kilós tu/uto ngun aleeslayá'.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
