        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Waawitá sleémeero oo xoordaá bihhaá /iya sleeme ta baraadií dirii', tam sleeme múk Sidoni ta aldinkwa nee múk baraá gi'i. Qoomár tawa slafi, muu nguna daandeemo feehhamiisiyé' ar /uuruuín, ala hamí daxta mukdá' taa hheehhe'eemisiiká kaa yaamií qaás ar mure, dinkwa nee kudá' taa tsuú/ baraá slaqwarár wa alé. Inooín ta aldinku'umiis nee mukdá' aa /eet baraá gi'ií alé.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
