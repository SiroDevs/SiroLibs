          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Gawaá adoorihe, kuungá' múk Misri tundu hhaamiis nee tunduri haragaas dinkwa nee mukdá' taa hheehhe'eesiiká, kudá' taa tsuú/ baraá slaqwarár wa alé.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
