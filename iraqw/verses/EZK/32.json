        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Múk Misri ku hhaamiis dinkwa nee mukdá' taa tsuú/ baraá slaqwaraaro. Paánga kaa amohhe'eés ar múk yaamaá Misri tsu/uta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharuuseedá' uren nee múk alee/isay'ín kudá' baraá gi'ií dirií' tari oó', ‹Múk Misri aa /eét ay baraá gi'i, kaa haragaás dinkwa nee mukdá' taa hheehhe'eemisiiká, kudá' taa tsuú/ baraá slaqwarár wa alé.›",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
