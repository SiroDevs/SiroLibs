          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamaá tlahhoó Sebuluni a digma nee yaamaá tlahhoó Gadi, iimír bihhaá da/aáw wá tleemu ay /uwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
