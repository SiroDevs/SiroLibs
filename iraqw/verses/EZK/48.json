            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamaá tlahhoó Simeon a digma nee yaamaá Isakari iimír da/aáw wá tleemu ay /uwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
