              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamaá tlahhoó Isakari a digma nee yaamaá tlahhoó Sebuluni, iimír da/aáw wá tleemu ay /uwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
