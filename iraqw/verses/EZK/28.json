          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Axweesantá AAKOÓ MUNGÚ ana malé axaás, i kat, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.11",
            "verseOrgIds": [
              "EZK.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Heewí, tsuunqumiís daanduú waawutmoó múk Tirowo. Ku beer, Aakoó MUNGÚ i kaahi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
