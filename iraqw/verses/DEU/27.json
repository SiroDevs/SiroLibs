        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
