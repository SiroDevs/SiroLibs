          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama ina laqwaál Nuni, Nuni ina laqwaál Yeshua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
