          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na/aá Heberi a kuká': Yafleti, nee Shomeri, nee Hotamu, nee dasír wák ar ta bay Shua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
