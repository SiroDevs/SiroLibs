              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dasirós a She'era tidá' gixsadaá Bet-horoni tsaraawo gaa tlehh ar baraay nee ar gawto nee gixsár Usen-she'eraro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
