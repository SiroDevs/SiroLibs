            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo Efraimu nee harerós tari qaát harerós iri tsít, na/aay gway xwayluúr umuuwós kway báy, Beria, asma amotlakwe do'ose kana sláy.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        }
