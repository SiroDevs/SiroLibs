          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu ina laqwaál Refa, Refa ina laqwaál Reshefu, Reshefu ina laqwaál Tela, Tela ina laqwaál Tahani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        },
        {
          "name": "verse",
