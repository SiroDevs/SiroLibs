          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó mibaá nee tsár oo slahhángw mibaá nee tsár a Heldai, heé gixsár Netofatír daáhh oo tlahhoó Otnieli, baraá baalaqaasirose mukós a kume mibeeri tsár nee tsiyáhh.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
