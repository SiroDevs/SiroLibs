          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó baalaqaasír lahhoó', oo slahhángw lahhoó' a Ira garmoó Ikeshi oo Tekoár daáhh, baraá baalaqaasirose mukós a kume mibeeri tsár nee tsiyáhh.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
