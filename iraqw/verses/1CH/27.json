          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heé doosluuse gaa sagesihhiit a Esri garmoó Kelubu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        }
      ]
