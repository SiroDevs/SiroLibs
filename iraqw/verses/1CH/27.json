        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó baalaqaasír faanqw, oo slahhángw faanqw a Helesi heé Pelonír daáhh, inós oo tlahhoó Efraimu, baraá baalaqaasirose mukós a kume mibeeri tsár nee tsiyáhh.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
            "verseOrgIds": [
              "1CH.27.10"
            ]
          }
        }
      ]
    },
    {
