          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó baalaqaasír gwaleél oo slahhángw gwaleél a Abieseri oo Anatotír daáhh, heé tlahhoó Benyamini, mukós a kume mibeeri tsár nee tsiyáhh.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
