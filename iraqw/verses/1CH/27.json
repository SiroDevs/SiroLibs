        {
          "text": "Tlahhoó Efraimuwo a Hoshea garmoó Asasia, oo tlaqtá tlahhoó Manase a Yoeli garmoó Pedaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        }
      ]
    },
    {
