          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó baalaqaasír dakaát oo slahhángw dakaát a Sibekai, heé Hushati oo tlahhoó Sera, baraá baalaqaasirose mukós a kume mibeeri tsár nee tsiyáhh.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        }
      ]
    },
    {
