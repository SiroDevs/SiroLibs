          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó mibaangw oo slahhángw mibaangw a Maharai, heé Netofatír daáhh, oo tlahhoó Sera, inós mukós a kume mibeeri tsár nee tsiyáhh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geeraharusmoó mibaá nee wak oo slahhángw mibaá nee wak a Benaya kuduú Piratonír daáhh, heé tlahhoó Efraimu. Baraá baalaqaasirose mukós a kume mibeeri tsár nee tsiyáhh.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        }
      ]
