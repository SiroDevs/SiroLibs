          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwí Daudi nee sagadiyuuseerós taa tsuú/ a xwaylár mukdá' tleedaadét dirén oo yaamaá Gati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
