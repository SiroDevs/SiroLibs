        },
        {
          "text": "Mukwí an mukdá' urén baraá gur'ér maraá baabi'ii'ine ar adoodá' xwaylar'ín i diria, múk iiatleér, oo Yerusalemúr hoót.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        }
      ]
    },
    {
