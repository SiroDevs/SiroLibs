          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Ishmerai nee Islia, nee Yobabu, kuká' an daaqoó Elpa'ali, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.18",
            "verseOrgIds": [
              "1CH.8.18"
            ]
          }
        },
