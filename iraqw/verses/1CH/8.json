          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseli na/iiwós a lahhoó', umer'ín a tí: Asrikamu, nee Bokeru, nee Ishmaeli, nee Shearia, nee Obadia, nee Hanani. Kuká' sleémeero an daaqoó Aseli aa laqwaál. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
