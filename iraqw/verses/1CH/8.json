            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benyamini Bela guri laqwaál, garmawós oo baris, garmoó tsár a Ashbeli, nee oo tám a Ahara, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo tsiyáhh a Noha, nee oo kooán a Rafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
            ]
          }
        }
      ]
    },
    {
