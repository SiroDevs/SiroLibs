          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó hhiyaawós Esheki a kwí: Ulamu na/oó baris, nee oo tsár a Yeushi, oo tám a Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
