          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Ya'areshia, nee Eliya, nee Sikri, kuká' an daaqoó Yerohamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
