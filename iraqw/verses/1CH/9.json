        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.12",
            "verseOrgIds": [
              "1CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk urén baraá tlahh'aá baabi'ii'ine dinkwa nee hhaeeine a muu kumuú wák nee tsiire faanqw nee mibeeri lahhoó'. Mukwí a múk aleesleemuú úr gu koóm baraá gadiyér Doó Munguhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
