          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekaria garmoó Meshelemia an heé afkú heémár Mungú gwaa xun.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
