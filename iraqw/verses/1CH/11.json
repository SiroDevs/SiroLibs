          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Yoeli hhiyoó Natani, nee Mibhari garmoó Hagri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.38",
            "verseOrgIds": [
              "1CH.11.38"
            ]
          }
        },
