          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elieli kuduú Mahawi, nee Yeribai, nee Yoshafia daaqoó Elna'amu nee Itima kuduú Moabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
