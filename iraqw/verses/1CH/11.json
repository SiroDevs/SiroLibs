          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Adina garmoó Shisa kuduú tlahhoó Reubeni, geeraharusmoó múk tlahhoó Reubeni, ta dinkwa nee kudaá mibeeraá tám. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
