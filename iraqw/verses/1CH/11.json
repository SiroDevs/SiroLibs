          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Itai garmoó Ribai kuduú Gibea oo tlahhoó Benyamini, nee Benaya kuduú Piratoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.31",
            "verseOrgIds": [
              "1CH.11.31"
            ]
          }
        },
