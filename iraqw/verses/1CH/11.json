          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Ira garmoó Ikeshi kuduú Tekoa, nee Abieseri kuduú Anatoti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.28",
            "verseOrgIds": [
              "1CH.11.28"
            ]
          }
        },
