          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Ahiamu garmoó Sakari kuduú Harari, nee Elifali garmoó Uri, nee Heferi garmoó Mekeroti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.35",
            "verseOrgIds": [
              "1CH.11.35"
            ]
          }
        },
