          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira nee Garebu kudaá Itiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
