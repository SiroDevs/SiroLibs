          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Seleki oo tlahhoó Amoni, nee Naharai kuduú Be'eroti. Inós an kudá' xooslár slaqwara ar Yoabu, garmoó Seruya, ga loohamaamiís. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
