          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Shamoti kuduú Harodi, nee Helesi kuduú Peloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.27",
            "verseOrgIds": [
              "1CH.11.27"
            ]
          }
        },
