          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya garmoó Yehoyada muruuwí guna tleéhh, inós kuri harafaár baraá tla/ángw miguuseedá' tám. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dír kudaá mibeeraá tame Benaya ilaiwa/ame gana ló'wa sláy, ala dír kudá' tám awa geera ga ayká. Daudi inós guri heé úr wa qaás oo xuumuuseerós.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
