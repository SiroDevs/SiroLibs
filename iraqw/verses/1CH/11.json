          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heferi oo tlahhoó Mekerati, nee Ahiya kuduú Peloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.36",
            "verseOrgIds": [
              "1CH.11.36"
            ]
          }
        },
