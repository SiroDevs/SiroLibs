          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee Sibekai kuduú Hushati, nee Ilai kuduú Ahohi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.29",
            "verseOrgIds": [
              "1CH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
