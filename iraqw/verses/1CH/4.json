          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó harér Hodia, hho'ór Nahamu, aa laqwál, inooín an xoorór Garmi, an kudá' gixsár Keila ngaa iimu/une', nee awa xoorór Ma'akati kudá' gixsár Eshtemoa ngaa iimu/une'.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        }
      ]
    },
