        {
          "text": "Daaqoó Yehaleli a kwí: Sifu, nee Sifa, nee Tiria, nee Asareli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
