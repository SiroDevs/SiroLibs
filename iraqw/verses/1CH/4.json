          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nee daaqoó Ishi a kwí: Soheti nee Ben-soheti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
