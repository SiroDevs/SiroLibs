          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaqoó Kalebu garmoó Yefune a kwí: Iru nee Ela nee Na'amu. Ela ina laqwaál Kenasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
