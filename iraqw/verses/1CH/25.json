              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ar gwaleél heé aa sleér a Matania nee daaqaywós, nee hhaeewós sleémeero dinkwaaro a mibaá nee tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
