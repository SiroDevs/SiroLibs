        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsawdór geera Yosefu guna sleér, oo guruú doó Asafu, tsawdór tsár Gedalia guna sleér, nee hhaeewós nee daaqaywós sleémeero dinkwaaro a mibaá nee tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ar tám Sakuri guna sleér, nee daaqaywós nee hhaeewós sleémeero dinkwaaro a mibaá nee tsár, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.10",
            "verseOrgIds": [
              "1CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ar tsiyáhh heé aa sleér a Seri nee daaqaywós, nee hhaeewós sleémeero dinkwaaro a mibaá nee tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
