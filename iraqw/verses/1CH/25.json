          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ar lahhoó' heé aa sleér a Bukia nee daaqaywós, nee hhaeewós sleémeero dinkwaaro a mibaá nee tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
