          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inooín dinkwa nee hhaeeín, kudá' taa intsaahhatís AAKOÓ MUNGÚ nguwa i daaiya', kudá' sleémeero ado ngi baalá', a muu tsiire tsár mibeeri dakaát nee dakaát.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        }
      ]
    },
    {
