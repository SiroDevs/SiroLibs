            "sid": "1CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ar kooán heé aa sleér a Netania nee daaqaywós, nee hhaeewós sleémeero a mibaá nee tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
            "verseOrgIds": [
              "1CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
