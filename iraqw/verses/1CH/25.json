          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ar dakaát heé aa sleér a Yeshaya nee daaqaywós, nee hhaeewós sleémeero dinkwaaro a mibaá nee tsár. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
