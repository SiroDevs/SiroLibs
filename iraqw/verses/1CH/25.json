          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsawdo kari tleéhh ar tawa gadiyuusi ar baalaqaasi, tam heé niiná laqaá tam heé úr, intsaahhatusmo laqaá kudá' ta intsaahhatmiisi, sleémeero a wak.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
