              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy AAKOÓ MUNGÚ malaykamoowós guri ádbáy paánga ngiwa ki/isi baraá tlakwaay, malaykamo paánga gari qaás baraá tlakwaywós. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ngiwa ár adoodá' AAKOÓ MUNGÚ firoorós ngiwa mu/aywaáts dír kitangwduú balaangw muxta aa tlaáxw dír Ornaní wá alé, heé Yebusi, inós ilahhooár muruú ta tsu/i gay hanmiís didá' wa alé. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
