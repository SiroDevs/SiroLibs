          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma heémadár AAKOÓ MUNGÚ tidá' Mose aa tleéhh baraá xaanxaywo, nee kitangwdá' taa ilahhooár wa da/a/án qoomaadae i amoodár gawa ar Gibeonír í dirii'iyá'. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
