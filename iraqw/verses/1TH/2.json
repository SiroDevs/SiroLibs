{
  "id": "1TH.2",
  "number": "2",
  "bookId": "1TH",
  "reference": "1 Tesalonike 2",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
