              "1KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo waawutmo iri oó', «Tí i kat, ‹Aasla'áy na/ay'eé' a kwí slaáf, kók a kwisíng aa gwaa'.› Tí i malé kat, ‹Aasla'áy na/ay'eé' a kwí slaáf, kók a kwisíng aa gwaa'.› » ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
              "1KI.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy waawutmo iri oó', «Paánga huwaare'.» Paánga kari huúw dír waawutmo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waawutmo iri oó', «Na/aywí slaáf tla/a tsataak, tí bihhaá wák ti hanisé', nee tiqá' bihhaá hatlá'.»",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
      ]
    },
