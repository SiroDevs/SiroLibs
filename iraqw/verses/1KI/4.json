              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungú Solomon guna sagalooárí haniís nee tsaahha nee xu'utír yaariir adór hhasángw afaá tlawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon múk yaamaá da/aáw nee oo Misriro gi baa/ sagalooaro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asma sagalooa ngiwa kon a muu sleémeero ba/a, ta Etaniwo heé tlahhoó Esrahi, nee Hemani nee Kalkoli, nee Darda, inooín a daaqoó Maholi, inós iri iiatleerúy baraá xoordaá inslaawaywose. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inós axweesanoó sagalooa oo kume tám guna káh, nee daa'angós a kumuú wák nee kooán. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kángw xaai guna káh, iimír sahhtír yaamaá Lebanoni nee xa'anoó ta bay hisoópo, kudá' koo/ír do' gaa alti'iit, slám kángw daanduú makaay guna axweés nee oo tsir/ooro nee daa'aweemaá makaá qanhhuumisá' nee kudá' tseerdu tsatsaa'aren nee siyó. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múk xoordu sleémeero guri i daqaaqáy as sagalooarós kawa axamiisi, iimír waawituú yaamu sleémeero kudá' kángw sagalooár Solomon ngwaa axaasiye'.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.4.34"
            ]
          }
        }
      ]
