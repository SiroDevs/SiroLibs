              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afeenidár guruú do' gana tleéhh ar hhai tám ar tlaa/aá taa daákw nee hháw wák guna tleéhh ar peehhoó sahhta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
