          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tam Yosefu sleeme a heé haratlintaaór koóm. Qoomár gwa'araarós iwa naká/, inós kángw ti'inángw múk Israeli baraá yaamaá Misriro guri alki/iít, hara'aya gari oó' adór faduuwós ki laqi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.22",
            "verseOrgIds": [
              "HEB.11.22"
            ]
          }
        }
      ]
