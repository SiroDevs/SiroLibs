              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe, pihh'uumarhúng ma qwaareesara', asma qeemuú ak úr gu koón. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
