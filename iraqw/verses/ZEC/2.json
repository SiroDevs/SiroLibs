      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuungaásingaá muu sleémeero, dír geeraá AAKOÓ MUNGÚ i xaslitaak, asma inós naa dirós tidá' hhoohhoó' wa tláy.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
