              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aá Lebanoni, afér do'ók gweereek",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
