          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala mukdaádá' AAKOÓ MUNGÚ nguna sluufmiisiyé', slám bartaqae inooín murslaaqatuín kudá' naa tleehhiyé' ar dabaaín nguna sagadiyusiyé'. Tam ay laarí na/ii'ín nee na/aá nangw'ine aqo adoodár kilá' ar xwaylitér'ín aa tlehhít ngina tleehhiyé'.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
