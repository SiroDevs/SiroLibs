              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala sagadiyusmoowós iri oó', «Adór muruú /aymaarí kur haniisi dír múk tsiiruú wák?»",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
