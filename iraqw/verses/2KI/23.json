          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakimu waawuti'iima ngiwa iimu/ún kureeriiwós a mibeeri tsár nee kooán, inós baraá waawuti'iimaro kureeri ngaa /aáy a mibaá nee wak baraá Yerusalemuro. Umuú aayoorós a Sebida dasír Pedaya kuduú Ruma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
