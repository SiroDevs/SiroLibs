          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekia iri oó', «Axweesantasír AAKOÓ MUNGÚ ta kat i qoón.» Asma inos ina baraá guruuwósí oó', «Ahaá ala, gár is tleehharutká a milá, bar baraá waawuti'iimar'eene wayda i deer nee saxremaawo?»",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        }
      ]
    },
