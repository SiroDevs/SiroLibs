          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu iri gwaá', kuri foól baraá /antaá waawitá, nee garmaawós Sekaria iri waawuti'ín kitaangós wa ale.",
          "type": "text",
