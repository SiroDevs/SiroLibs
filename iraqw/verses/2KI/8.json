          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gawaá adoorihe, tam ay laarí múk Edomu aa sií' kuwa sawaawuti'in nee múk Yuda. Qoomaadár kilae, múk Libna sleeme ina sií' kuwa sawaawuti'ín nee múk Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
    },
