{
  "id": "2KI.8",
  "number": "8",
  "bookId": "2KI",
  "reference": "2 Waawitá 8",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2KI 8"
      },
      "items": [
        {
