          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu iri gwaá', kuri foól baraá /antaá waawitá, kudaá baraá gixsár Daudi, nee Ahasia garmaawós iri waawuti'ín kitaangós wa aleeró.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
