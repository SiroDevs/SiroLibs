        },
        {
          "text": "Looár na tleer, qoomár ilahhooár muruú ta tsu/i ar matlaatle, ma'aay nina wa/iyé' amór yaamaá Edomúr wa ale, nee xatstadá' ngiri dalaa/iyé'.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.20",
            "verseOrgIds": [
              "2KI.3.20"
            ]
          }
        }
      ]
