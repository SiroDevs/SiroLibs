          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "tari oó', «Gaarí a tseere, anga/áw waawitaádá' tám taa kilooín muxiyé' tiri tsu/iyé', gusé' a haasaánguú leehhaán.»",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        }
