              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehasi iri oó', «Anuú sagadiyusmoowók amór naa káw i káhh.»",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
