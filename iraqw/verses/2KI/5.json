          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy Gehasi iri tláy didae nee slaqwtós tiqtír tsatmit gaa qaroó ót, kaahartós aa /awaakuúr adór tlaa/aá tluwaay.",
          "type": "text",
          "attrs": {
