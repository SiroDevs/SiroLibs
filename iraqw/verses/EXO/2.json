        },
        {
          "text": "Alaá qoomár deelór yaariir iwa waaráhh, waawutmoó Misri iri gwaá'. Xoorór Israeli slahh'amuú úr guri sleér baraá lawaali'iimaro, tari /aa/amín. /Aa/eeín niri hardihiyé' amór Mungú. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.23",
            "verseOrgIds": [
              "EXO.2.23"
            ]
          }
        },
