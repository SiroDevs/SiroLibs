          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungú /aa/eeín giri axaás, nee alqadoorós tidá' aa oó' dír Abrahamu, nee Isaka nee Yakobo gari insláy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.24",
            "verseOrgIds": [
              "EXO.2.24"
            ]
          }
