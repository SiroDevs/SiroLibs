              "type": "text"
            }
          ]
        },
        {
          "text": "Adoorí an adór AAKOÓ MUNGÚ múk Israeli ngura ba/amís baalaadae dír múk Misriro. Múk Israeli tuaá slaqwaruusér Misri ngiri ariyé' afaá tláwtí ale. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
