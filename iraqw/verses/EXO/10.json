            }
          ]
        },
        {
          "text": "Ala AAKOÓ MUNGÚ muunuú Farao guri gawdeés, inós iri sií' múk Israeli geemawto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
