              "type": "text"
            }
          ]
        },
        {
          "text": "«Hee bar lawaalmoowós oo hhawaata laqaá /ameeni gwa ilaa slaáhh, nee gari gaás, lawaalmoowós ngu geemay baraá lawaali'iimaro tawa hariímár bu'utuú iltós. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laqaá bar hee lawaalmoó hhawaata laqaá /ameeni gwa sihhno slaáhh, guri kwaáhh, lawaalmoodá' ngu geemay baraá lawaali'iimaro tawa hariímár bu'utuú sihhnoowós.»",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
