          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Heé hee gwaa fiis as nguwa weerisi, laqaá nguwa lawaalmoowós wa oohi aqo kun gaas.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
      ]
    },
    {
