              "EXO.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Heé kuqá' gwa muux iri gwaá', inós sleeme aqo kun gaas. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala barnaxes gwa haramamahhatiiká aqo har Mungú guna gawaá dabaawós i qaás, daqaní aníng wa/aamér múk aa tsu/uut ngi dirók i laqaám. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala hee barnaxes ina tsabín kuqá' nguwa geewaqaati, guri gaas, heewí tam bira goów dír kitángw ilahhooa, ku didá' wa hingeesá', ku gasá'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
