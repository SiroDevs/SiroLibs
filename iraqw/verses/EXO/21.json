          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Heé baabuúwós gwa muux, laqaá aayoorós aqo kun gaas.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        }
