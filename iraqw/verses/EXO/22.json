          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Mungú mu /ooslimaar, tam geeraharusmoowók mu lu'usaar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
