          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Barismoowók ngun aníngí hanís. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoorí an tlehhá' sleeme dír na/aá baris awa hikwaahúng nee awa bee/angwhunge. Na/oó slee in dír aayírós wa du'ún deelo faanqw, bál dakaate ngu aníngí haniisá'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
