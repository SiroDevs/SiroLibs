            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Kuungá' daqaní a múk taa paraátl as aníng, gawaá adoorihe fu'unaá makiito'ór taa gaás nee makiito'ór sla/a mi /ayaara'. Fu'unaysíng seeaawe ti hanise'.»",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.31"
            ]
