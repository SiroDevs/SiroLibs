          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Hee bar slér hee gaa kiriík nee kari qanqín, laqaá iri gwá', seebuúduú slee loó' didae bir kaahh, aqo sleedá' kan buu'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bar seebuúduú slee i didií dirii', daqaní ka buiiká, aqo har bu'utuduú iina ooha.»",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        }
      ]
    },
