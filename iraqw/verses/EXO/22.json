          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Hee bar /amaatliito'ór taa sa'axweesiiká gaa al/aáy, tari fuquús nee inós, aqo gwada gun haniis, /amaatliito'oodá' gari duux. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala bar baabuú dasiidá' aa sií' dasiirós haniisaro, heedaádá' bu'utuú hariím dasír /amaatliito'ór wa ale ngu bui.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
