          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "«Dahaaymo mu baramaanusaar laqaá mu slahh'eemisaar asma kuungá' aáng sleeme dah'iima ana /agé' baraá yaamaá Misriro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
