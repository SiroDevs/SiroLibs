          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoomár tawa loohír i dirii'i dír qata, AAKOÓ MUNGÚ nee inós tiri doogiyé', guri gaasár wa slaá'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sipora tlaa/anoó tsingaarmo guri taatáhh, garmaawós guri al/utl, tumbidá' gari ya'aá Mosér kwatiít guri beér, «Kuúng an hhawaatuueé' oo naa tuú/ ar tseere.»",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        }
