              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagáy AAKOÓ MUNGÚ Mose guri máy. Asma Sipora ina ó', «Kuúng an hhawaatuueé' oo naa tuú/ ar tseerér al/utlo.»",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
