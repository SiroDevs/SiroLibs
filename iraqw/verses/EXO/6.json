              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni nee Mose an múk AAKOÓ MUNGÚ aa báy, «Múk Israeli duuxare' baraá yaamaá Misriro ar adoodá' daqooráy'ín i dirii'i.» ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
