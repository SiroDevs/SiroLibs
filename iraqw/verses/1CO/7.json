            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ameenír taa duúx, hhawaatuuwós bir slaaf, /ameenidá' makawa duúx. Ala bar hhawaatuuwós aa gwaá', i ya/aán kawa duuxi nee heé inós i sla'. Ala adoorí ka tleehhi ar baraá Aako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala a gár ak hhoo' dirose bar duuxo ngaa meér. Gaarí aníng an káh, ala tam aníng sleeme án ngi slaá' Qeeruú Mungú u koóm.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    }
