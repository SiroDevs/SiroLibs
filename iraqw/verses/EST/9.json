              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluuwo waawuto'o Esta, dasír Abihaili nee Mordekai kuduú Yahudumo barwiito'ór tsár kari gooín ar aleesleemu sleémeero as deeloorír Purimu kawa gawdeemiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barwadu kina ya/aáw amór múk Yahudi sleémeero kuduú baraá ayeemo sleémeero awa tsiiru nee mibeeri tsár nee faanqw awa waawuti'iimár Ahasuero. Baraá barwadukae múk Yahudi kuna amohhooár i slaá' nee looeema, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nee as múk Yahudi nee xwaylar'ín deelór Purimu ngiwa harmagaahhiya' ar afiqoomaarós, ar adór dabér gwaawito nee tsuunqumis ngira harmagaahhiyé'. Hara'ayaarí Mordekai kuduú Yahudumo, nee waawito'o Esta ngina ooiyé' dír múk Yahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hara'ayár Esta kaangwí oo Purimu gway gawdés, kway gooín baraá kitaábu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
        }
