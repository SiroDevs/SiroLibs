              },
              "items": [
                {
                  "text": "Ëhë 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömösaacha gösë ömögaikörö ariihe atagaacha kohooyera gösë kohooyeroa na itiinyi ërë yonsui; bhöyö nö öbhöhotoku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
