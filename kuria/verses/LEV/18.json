            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.12"
              },
              "items": [
                {
                  "text": "Gar 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö, iga ömöntö abhe ho, kuhika agoote imigiro na amaragirriö gaane. Uni nu uni ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        }
      ]
    },
    {
