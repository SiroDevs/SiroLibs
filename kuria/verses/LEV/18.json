              "items": [
                {
                  "text": "Abhar 20:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uriihe ötagaacha köhönyöra ëkëng'aabhi ke mökaamura omoinyu, këyö në ëkëng'aabhi ke mura omoinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
