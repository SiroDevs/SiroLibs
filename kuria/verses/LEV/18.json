              "items": [
                {
                  "text": "Abhar 20:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uriihe ötagaacha köhönyöra ëkëng'aabhi ke mökamoona waao, öyö nö ömökari wö ömoona waao. Uriihe ötagaacha köhönyöra ëkëng'aabhi keee. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
