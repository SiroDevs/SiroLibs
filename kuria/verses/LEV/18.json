            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uriihe ötagaacha köraara na ömösaacha wöndë këö ömökari, këyö ni ikiriirriö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
