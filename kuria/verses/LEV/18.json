              "items": [
                {
                  "text": "Ëhë 27:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uriihe ötagaacha köhönyöra ëkëng'aabhi kö ömögaikörö na umusubhaati waae gösë öhönyöre ëkëng'aabhi kia abhasubhaati bhu umumura waae gösë abhasubhaati bhu umusubhaati waae. Bhayö mbagootaini urutundura. Bhöyö nu ubhunyanku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriihe ötagaacha göteta musubhaati omoobho mökaao nkaaga mökaao aho; irihari ndëraabhe ho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        }
      ]
