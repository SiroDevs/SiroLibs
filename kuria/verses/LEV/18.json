              },
              "items": [
                {
                  "text": "Abhar 20:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uriihe ötagaacha kohooyera ömökari wö ömöröbhëri waao na kuigootera ibhikui nawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        }
