        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ömögambi atërrökërë akorrë iriraga köng'ana ëno ëkongoa na irirago riö ÖMÖNENE, Ënooköë waae, abhaayë ni irisoro, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano öngöra iriraga reee kuhika arenta ëgorohe ëno ëtaana isoro köbha ësataaka yë ëgësönsööro keee. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atööre ököbhoko kooe kömötöe göë ëgorohe ëyö na kögësënchëra haara bhakumuensera ikimuenso ke gösambërëërröa mbere yö ÖMÖNENE. Këyö ni ikimuenso ki iriraga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua umunchaama achabhia ëkeera keee kömaanyinga gi ikimuenso ki iriraga ahaka guchintëra chi irikëngë ri ikimuenso ke gösambërëërröa. Na gaara gatamërë ahöma irungu yi irikëngë ri ikimuenso ke gösambërëërröa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na öbhönöre bhonsui bhöë ëgorohe ëyö kuhika abhösambërëërra guikëngë ke bhööra bheene ikimuenso kiö ömörembe këgökoroa. Igo, umunchaama asönsööra ömögambi öyö iriraga reee nawe abhëroa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
    },
