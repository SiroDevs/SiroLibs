          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua umunchaama achabhia ëkeera keee kömaanyinga gë ikimuenso ki iriraga, ahaka guchintëra chi irikëngë ri ikimuenso ke gösambërëërröa. Na gaara gatamërë ahöma irungu yi irikëngë ri ikimuenso ke gösambërëërröa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
