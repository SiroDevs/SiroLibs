          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Göno ngo umugiro göno guitungërë ichitiinyi, ibhinyunyi, na ëgëteemoa kërë gionsui këno gëkögenda kömanchë na këra gëteemoa këno gëkögenda gökëbhara, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri këbhe ho ekehokaniö gatai ya këno këëna ibhikui na këno gëtaana ibhikui na ibhiteemoa bhino bhikaarëëbhoa na bhino bhitakaarëëbhoa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
            "verseOrgIds": [
              "LEV.11.47"
            ]
          }
