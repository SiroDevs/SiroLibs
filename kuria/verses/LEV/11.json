              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano nyoora itiinyi ëno mökarëëyë ikuurë, öno wonsui aturubhani ikihundugu keeyo nköbha arë na ibhikui kuhika ömögoroobha, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "na öno araare inyama inkuurë ëyö naarahure ichingëbho chaae na nköbha arë na ibhikui kuhika ömögoroobha; na öno araimuki ikihundugu keeyo, kuhika ahura ichingëbho chaae, nawe naarabhe ni ibhikui kuhika ömögoroobha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ëgëteemoa kërë gionsui këno gikuing'uura hansë gökëbhara, këyö ni ikiriirriö harë bhainyu; gëtagaacha körëëbhoa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.41",
            "verseOrgIds": [
              "LEV.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kërë gionsui gëkögendera ënda, gösë këno gekögendera amagörö anai, gösë këno këëna amagörö amaaru, bhino bhionsui bhikuing'uura gökëbhara, mötagaacha körea; kugira ni ibhiriirriö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
              "LEV.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötagaacha guikorra ikiriirriö abhiene gö kërë gionsui gikuing'uura, na mötagaacha kuinyankia nabhio, gëtarë igo möraabhe ni ibhikui. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
              "LEV.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.2"
              },
              "items": [
                {
                  "text": "Abhar 19:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.16"
              },
              "items": [
                {
                  "text": "1 Bhe 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira uni nö ÖMÖNENE, Ënooköë weinyu ndë, köhayö isaabhuura abhiene möbhe abhahoreeru, kugira uni nö ömöhoreeru ndë. Mötagaacha kuinyankia na gëntö kërë gionsui këno gikuing'uura këraagura gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira nu uni ÖMÖNENE öno naabharuusiri gönsë ya Misiri, korri iga nëbhe Ënooköë weinyu, köhayö möbhe abhahoreeru, kugira uni nö ömöhoreeru ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        }
      ]
    },
