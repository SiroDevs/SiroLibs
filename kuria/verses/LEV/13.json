            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Si hano umunchaama aitaaha amaahe iga irimooa rëëra ngusuuha rërë nyuma ya kuhuroa, atandöra haara haana uruaha roa amagenge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano irimooa rëyö rëmaahëkana guiki köngëbho ëyö itumërë gösë ërökërë gösë gö kërë gionsui ki irisaaköa, ömanye iga uruaha röyö roisaköranda. Hayö, ëngëbho ëyö ësamboa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ëngëbho ëno ihurrue uruaha ruruurë kuhika ërëngëroe kuhurua korri ëbhe ëndabhu.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LEV 13:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Göyö nu umugiro göno guitungërë uruaha roa amagenge köngëbho yö öbhöchörö gösë ëyë ëhanga inyëke gösë ëno itumëröë gösë ërökëröë gösë yi irisaaköa. Gönchëra ëyö möraahökani ëngëbho yi ibhikui na ëno ëtaana ibhikui.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.59",
            "verseOrgIds": [
              "LEV.13.59"
            ]
          }
        }
      ]
