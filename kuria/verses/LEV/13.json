              "LEV.13.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano umunchaama amaaha iga, uruaha röyö tërörandërë köngëbho hai, bhoono, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "umunchaama agamba ëngëbho ëyö ihuroa na götööroa hagarë guchinsikö chindë muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama agitaaha ësookia kuhuroa. Hano nyoora irimooa rëëra rëtaihönchööyë ërangë ninyoora uruaha rööra rötarandërë, ëngëbho ëyö nëëna ibhikui. Nënkanyoora irimooa rëyö rëbhe nyuma gösë mbere, kuhika ëngëbho ëyö ësamboa kömörro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        }
      ]
    },
