              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Öyö wa amagenge kuhika asuare amanyaara na anga guchanora tuukia, gëtatiga ësagamarra igo, na kuhika ayi aragubha ëkënenebhu keee ke igörö, naaya ararundia iga, ‘Uni nëëna ibhikui, uni nëëna ibhikui!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naragenderri köbha na ibhikui ichinsikö chonsui chino arëngë ömörooyi, na amenye umuene isikö yu umugi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imigiro gëno giitungërë ichingëbho chu uruaha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ëngëbho ëna uruaha ronga roa amagenge, ëbhe ëyö öbhöchörö gösë ëhanga inyëke, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ëngëbho ëyö ëbhe në ëno itumëröë gösë ërökëroe kurua köhanga inyëke gösë köbhöchörö gösë në ëngëbho ëno ëkoreeyë irisaaköa rërë rionsui, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano nyoora uruaha röyö ronga amanyanki amabhësë gösë nö öröbherretu köngëbho ëyö, igo, ëngëbho ëyö nëëna uruaha. Köhayö kuhika yoorokibhia umunchaama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama aitaaha uruaha röyö na götööra ëngëbho ëyö hagarë guchinsikö muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro muhungatë aitaaha uruaha röyö. Hano nyoora uruaha röyö ndörandërë köngëbho yonsui, ëbhe ni iya gutumöa gösë iya körököa gösë yi irisaaköa rërë rionsui, ëngëbho ëyö nëëna uruaha. Igo ëngëbho ëyö nëëna ibhikui. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama asamba ëngëbho ëyö kugira nëëna uruaha roa amagenge.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
