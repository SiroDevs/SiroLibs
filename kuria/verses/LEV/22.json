          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia Haruni na abhaana bhaae na abhantö bhonsui bha Isiraeri iga, Hano Umuisiraeri gösë umuitongo arenta ësataaka yaae, ëbhe ya köhëkëërania ëndagano gösë ësataaka ya kimuguuni ëno ikuruusiribhöa ÖMÖNENE kobha ikimuenso ke gösambërëërröa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "körri agitabhirri kuhika uruusi ëgësaacha këno gëtaana isoro, kebhe ni iki ichigaini gösë amang'ondi gösë ichimburi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.1"
              },
              "items": [
                {
                  "text": "Ëhë 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ötagaacha kumuensa kërë gionsui këno këëna irisoro, kugira tëkëraitabhirribhöe harë uwe hai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö örë wonsui hano arenta ikimuenso kiö ömörembe kö ÖMÖNENE, korri ahiki ëndagano gösë ësataaka ya kimuguuni gukurua kuihicho reee ri ichitugo, korri iga itugo ëyö itabhirribhöe kuhika ëbhe inchiiya; itugo ëno ëtaana isoro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itugo ihukuru, gösë ëmbeeru, gösë inyahaariku, gösë ëno ëkögeria örötai, gösë ëno ëna uruaha, gösë irigökö ötagaacha kugimuensera ÖMÖNENE, gösë kögëkora ikimuenso ke gösambërëërröa kömörro guikëngë riö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëgaini gösë ëkëmaano ki iring'ondi këno këëna ikiimo ikimui ëgëtambë bhökong'u gösë ikiëng'ë bhökong'u, nögakiruusia gë ësataaka ya kimuguuni; si gë ësataaka yë ëndagano tëraitabhirribhöe hai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötagaacha kuruusiria ÖMÖNENE ikimuenso gi itugo ëno yanyahaarëka iribheere, gösë köbhöröngöroa, gösë kuihoa, gösë guturoa gönsë yeinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë ötagaacha kuruusiria Ënooköë ichitugo chino uruusiri kömöhamatë. Kugira nyoora nchiina amasoro, ngëtënë chirë, chiyö tichikaitabhirribhöa hai.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
