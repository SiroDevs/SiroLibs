              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wamuensa ësataaka yu umukumo kö ÖMÖNENE, umuensa iga witabhirribhöe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
