              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itugo ëyö kuhika ërëëbhoa na gusira röyö bheene; ëtagaacha gutigara kuhika icho. Uni nu uni ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
