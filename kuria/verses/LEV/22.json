              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö mögoote amarago gaane na kögahëkëërania. Uni nu uni ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
