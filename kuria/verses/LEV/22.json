          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötagaacha guchoria iriina reene irihoreeru, gëtatiga nsöököe köbhantö bhonsui bha Isiraeri. Uni nu uni ÖMÖNENE öno nköbhasaabhuura, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
