                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Ëhë 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Hano ömöntö araaara na ömökari wu ömöröbheri waae, bhonsui bhayö bhaitöa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
