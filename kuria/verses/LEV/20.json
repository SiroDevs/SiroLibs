                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Ëhë 22:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.20"
              },
              "items": [
                {
                  "text": "27:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömöntö öno aköraara na ömökari wa isawaabho öyö nyoora ahönyööyë ëkëng'aabhi gei isawaabho; bhonsui bhabhërë kuhika bhaitöa, na amaanyinga gaabho mbo abhiene garaitungë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Abhar 18:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ömöntö araara na mökamoona waae, bhonsui kuhika bhaitöa, bhaakorrë ichinsoni, amaanyinga gaabho mbo abhiene garaitungë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.22"
              },
              "items": [
                {
                  "text": "Abhar 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ömösaacha araara na ömösaacha wöndë kiö ömögaikörö, bhonsui bhayö bhaakorrë ikiriirriö, bhonsui bhaitöa, amaanyinga gaabho mbo abhiene garaitungë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
