              "items": [
                {
                  "text": "Ëhë 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ömösaacha araara na itiinyi kuhika aitöa na muite itiinyi ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömögaikörö araara na itiinyi ërë yonsui muita ömögaikörö öyö na itiinyi ëyö; mbiraitungoe na amaanyinga gaae na agaayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
