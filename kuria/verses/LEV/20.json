            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.19"
              },
              "items": [
                {
                  "text": "Abhar 18:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ömösaacha araara na ömögaikörö öno aitöëkërë, bhonsui bhabhërë kuhika bhagiröa na abhantö bhaabho, kugira ömösaacha öyö araayë na ömökari öno aitöëkërë na ömökari öyö araayë na ömösaacha na haara naitöëkërë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        },
        {
