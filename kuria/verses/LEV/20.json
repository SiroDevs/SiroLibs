            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.10"
              },
              "items": [
                {
                  "text": "Mk 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira örë wonsui akuihiima isawaabho gösë nyaköwaabho, kuhika aitöa; öno aihiima nyaköwaabho gösë isawaabho, amaanyinga gaae nëwe umuene garaitungë.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
