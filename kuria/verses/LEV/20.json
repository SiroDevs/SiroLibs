              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.17"
              },
              "items": [
                {
                  "text": "Abhar 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Ëhë 27:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ömöntö ateta ömökari na guiki göteta nyaköwaabho, bhöyö nu ubhunyanku; kuhika bhasamboa bhonsui ömösaacha na abhakari bhayö, körri ubhunyanku bhonga bhöyö bhötagaacha köbha harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
