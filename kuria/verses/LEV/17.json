    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umugiro göa amaanyinga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia Haruni, na abhaana bhaae, na Abhaisiraeri bhonsui iga, këno nkio ÖMÖNENE aabhasimisiiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömöntö örë wonsui asënchëra isikö ëng'ombe, gösë imburi gösë ëkëmaano ki iring'ondi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "sooki anga körenta itugo ëyö kuihita ri iritunteera re gusikanëra korri agimuensa ki igituho kö ÖMÖNENE mbere yi iritume riö ÖMÖNENE, ömöntö öyö nköbha arë na irisoro re köhöma amaanyinga; igo, kuhika agiröa na abhantö bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibhune kiu umugiro göyö niiga, Abhaisiraeri bhatige kömuensera waabho ichitugo, gëtatiga bhachirenta kö ÖMÖNENE. Bhachirenta kumunchaama kuihita ri iritunteera re gusikanëra, nawe achisënchëra ho gë ësataaka yi ibhimuenso bhiö ömörembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama aminchiria amaanyinga irikëngë riö ÖMÖNENE, irihita ri iritunteera re gusikanëra na gösambërëërröa igitinya köbha isiisui inchiiya ya götegeria ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Abhaisiraeri bhariihe kuruusiria ibhihui ibhimuenso, kugira ëng'ana ëyö ya abhakora bhaabhöra ubhukumia harë uni. Umugiro göno nö ögokuya ëyö kömaköra gaabho gonsui.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Öbhateebhi iga ömöntö örë wonsui gösë umuitongo öno amenyërë kö Abhaisiraeri öno akuruusia ibhimuenso bhia gösambërëërröa gösë ikimuenso kërë gionsui, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "si tagökërenta mbere yi irihita ri iritunteera re gusikanëra korri aruusiri ÖMÖNENE ikimuenso, kuhika agiröa na abhantö bhaae.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        }
      ]
