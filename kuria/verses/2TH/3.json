        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mötösabhëre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kögösookerria bhantö bhaitö mötösabhëre, korri iga ëng'ana yö Ömönene iyi nkuma na guiki iriganibhue gösööko, kehaara yaabhaayë harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
            "verseOrgIds": [
              "2TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mösabhe Ënooköë atutuuri kurua köbhantö abhabhëëbhë na abhanyanku; gikugira tëbhonsui bhaakumia amang'ana gano hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.2",
            "verseOrgIds": [
              "2TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Ömönene nö ömöheene, naraabhahe ichinguru na köbhariiha kurua Munyanku ööra. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntööna iriteng'ero kö Ömönene gikugira yeinyu, na ntööna öbhöheene iga ngökora mörë na mmöragenderri gökora gano tököbhateebhia.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Ömönene atangate imioyo geinyu gëbhe na öbhöhanchi bhöë Ënooköë na gëbhe na ubhugumirria bhööra tukunyoora harë Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uguitungua gököra ëmërëmo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö törabhateebhia kuriina riö Ömönene weitö Yesö Kirisitö iga möhaatërane na umukumia örë wonsui öno arëngë ömörusu na öno atakögoota amaigiö gano moonyoorrë kurua harë bhaitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.6",
            "verseOrgIds": [
              "2TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu abhiene mmömanyërë iga kuhika möbhe kehaara toorëngë. Kugira tëtoorë abharosu nkaaga toorëngë hamui na bhainyu hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.7",
            "verseOrgIds": [
              "2TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëtoorëëyë ibhiakörea bhiö ömöntö bhuchua igo tötahakainë hai. Ntookorrë ëmërëmo kugituunyo ubhutikö na ömöbhasö, korri iga tötagaacha köbha ömösairë kömöntö örë wonsui harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.8",
            "verseOrgIds": [
              "2TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëtookorrë igo gikugira iga tituisainë kunyoora ubhutuurria hai; ntookorrë igo korri iga këbhe igituubhaniö harë bhainyu, mökore keeho bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.9",
            "verseOrgIds": [
              "2TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga toorëngë hamui na bhainyu, ntoobhateebhiri iga, “Hano ndanyoore ömöntö örë wonsui tagutuna gökora ëmërëmo, tiga ange köraagëra.” ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.10",
            "verseOrgIds": [
              "2TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira toiguurë iga abhamui bhainyu na abharosu tëbhagutuna gökora gëntö hai, gëtatiga na amang'ana ga abhantö bhandë bheene bhamanyërë guisohania mo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.11",
            "verseOrgIds": [
              "2TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuriina riö Ömönene Yesö Kirisitö, töratakia abhantö bhayö na köbhatööra ömooyo iga, bhamenye irimenya iriiya na bhakore ëmërëmo geebho kubhuuya korri bhanyoore ibhintö bhiabho abhiene.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö mötagaacha gutiita gökora amaiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö örë wonsui öno arange kögoota amang'ana gano tondëkërë kunyarubha ëno, öyö mömaahërre bhökong'u monge gösanga nawe korri amaahe ichinsoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.14",
            "verseOrgIds": [
              "2TH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono mötakamömaaha kiu umubhisa; mömötaki kiu umukumia umui weinyu.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amang'ana ga gösoorria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Ömönene öno arëngë ënsëmöka yö ömörembe, we umuene abhahe ömörembe ichinkaaga chonsui na guchinchëra chonsui. Ömönene abhe na bhainyu bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gököbhoko koone umuene uni Bhauro ndandëka amakeeriö gano. Nigo nkondëka iriina reene kögösookia inyarubha ërë yonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita yö Ömönene weitö Yesö Kirisitö ëbhe na bhainyu bhonsui.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.18",
            "verseOrgIds": [
              "2TH.3.18"
            ]
          }
        }
      ]
    }
  ],
