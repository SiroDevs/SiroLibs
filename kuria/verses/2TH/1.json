                {
                  "text": "Ama 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhauro, Siriwano na Timoteo, törandëkëra ëkanisa ya Abhatesaronike, ëno ërëngë abhantö bhë Ënooköë Taata na Ömönene Yesö Kirisitö: ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita na ömörembe kurua kö Ënooköë Taata na kö Ömönene Yesö Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökengeröa ikiina ngönkaaga yu uguucha go Kirisitö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, kuhika töhe Ënooköë umukumo ruiso ronsui gikugira yeinyu keebhörë këragërë. Kugira ubhukumia bhoinyu bhoiyengeria na öbhöhanchi bho këra umui weinyu köbhandë bhonsui nabho bhoiyengeria. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkio gikugira törairaha igörö yeinyu guchikanisa chë Ënooköë. Ngökora törë igo gikugira yu ubhugumirria na ubhukumia bhöno möönabho kumiiriiro geinyu na guchinyaanyi chino mukugumirria. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonsui gano nkoorokia garë iga ögökenga ikiina köë Ënooköë nö ököröngë na gikugira ya ëyö mörabharröe iga mmuisainë kunyoora Öbhögambi bhöë Ënooköë bhöno bhukugira mörairiira. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.5",
            "verseOrgIds": [
              "2TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë nö ömöröngë, köhayö narahakane igisiomba köbhaara bhaköbhairiiria, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.6",
            "verseOrgIds": [
              "2TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "narabhamuunyi bhainyu bhano mukuiriira hamui na bhaitö bhonsui. Narëkora gano nkaaga ëno Ömönene Yesö arëhönyöröa kurua kuriöbha ana abhamaraika bhaae abhahikërë, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.7",
            "verseOrgIds": [
              "2TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ömörro görooka, ögo köbhörööta abhantö bhano bhakonga Ënooköë na bhano bhatakuiguëra igichiratë kiö Ömönene weitö Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.8",
            "verseOrgIds": [
              "2TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.10"
              },
              "items": [
                {
                  "text": "Isa 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ukuiriiribhua koobho nkörëbhe ugusikibhua go kuya ëyö na mbariruusibhua kurua kö Ömönene na kurua ku ubhuhiku bhö ögötöra kooe, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.9",
            "verseOrgIds": [
              "2TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano ariicha urusikö rööra köhaabhöa ubhuhiku, na abhantö bhaae körögöörröa na bhonsui bhaara bhaamukumia, kugira mookumia amang'ana gano toobhateebhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyo ikugira törabhasabhhëra ruiso ronsui. Ngösabhha törë Ënooköë weitö abhakore möbhe bhano muisainë kömenya irimenya rëno aköbhabhërëkëra iga mömenye. Guchinguru chaae ahëkëërani këra ëng'ana inchiiya ëno mugutuna gökora bhuuya, na ahëkëërani ëmërëmo geinyu igiu ubhukumia. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.11",
            "verseOrgIds": [
              "2TH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönchëra ëyö iriina riö Ömönene weitö Yesö ndëranyoore ubhuhiku kurua harë bhainyu, na bhainyu munyoore kurua harë we, kuguitung'ana na ësaramita yë Ënooköë weitö na iyö Ömönene Yesö Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.12",
            "verseOrgIds": [
              "2TH.1.12"
            ]
          }
        }
      ]
    }
  ],
