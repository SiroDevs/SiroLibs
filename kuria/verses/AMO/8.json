            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE Ënooköë nawe akambuuria iga, “Amosi nkë ökömaaha?” Nani nkamuhunchukiria iga, “Në ëkegabho kia amakö gë ëmaaö nkömaaha.” Hakurua ÖMÖNENE Ënooköë aganteebhia iga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ugusika ko Isiraeri",
          "type": "text"
        }
      ]
    },
