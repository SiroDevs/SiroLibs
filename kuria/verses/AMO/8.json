            }
          ]
        },
        {
          "text": "ÖMÖNENE Ënooköë akanhönyöörra amamaaho gandë: Nkamaaha ëkëgabhö këno gichööyë amakö gë ëmaaö. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
