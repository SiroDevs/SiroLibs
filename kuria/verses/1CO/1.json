            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ëng'ana yu uruku ro Yesö kömösarabha në ëng'ana yö öbhökangi köbhaara bhagusira; sibhoono harë bhaitö bhaara tugutuuribhua ni ichinguru chë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.14"
              },
              "items": [
                {
                  "text": "Isa 29:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira amandëkö nkögamba garë iga,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
