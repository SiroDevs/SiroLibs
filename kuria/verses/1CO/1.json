          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni Bhauro, öno naabhërëkëëyöë iga mbe ömötömöa wa Kirisitö Yesö gököreng'aana na kebhörë Ënooköë agutuna, na mura omoitö Sositene.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        }
      ]
    },
    {
