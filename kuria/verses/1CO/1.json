                "loc": "ROM.16.23"
              },
              "items": [
                {
                  "text": "Rum 16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nkögönga ndë Ënooköë iga tënaabhaatiisërë möntö örë wonsui gatai yeitö gëtatiga Kisibho na Gayo bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ömöntö atagaacha kögamba iga moobhaatiisëröë kuriina rëënë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.15"
              },
              "items": [
                {
                  "text": "1 Ko 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Guiki naabhaatiisërë ëka ya Sitebhano, sibhoono köhëtëëra bhayö tëngökanya iga naabhaatiisërë möntö örë wonsui guiki hai.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirisitö taantömërë iga mbaatiise hai. Naantömërë iga ndundi Igichiiratë, tiiga nkömang'ana gö öbhöng'aini bhö ömöntö hai, korri iga ichinguru chu uruku ro Kirisitö kömösarabha chitakaabha cha bhuchua.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kirisitö nëwe ichinguru na ëseemi yë Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
