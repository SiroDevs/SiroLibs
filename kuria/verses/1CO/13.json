        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhöhanchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkanyoora ngusumaacha ndë ibhigambo bhia abhantö na bhia abhamaraika, sibhoono ntaana bhöhanchi, hayö nköbha ndë ki iritebhe iriömö rëno regökangaratana, gösë ki amatoasi gano gaguchegera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mat 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.21"
              },
              "items": [
                {
                  "text": "21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.23"
              },
              "items": [
                {
                  "text": "Mk 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nënkanyoora nëëna ëkahaano kiö öbhönaabhi, na köngöra ibhibhisërë bhionsui na ubhunguri bhonsui; nënkanyoora nëëna ubhukumia öbhönene bho götöra köng'aanyia ichinguku kurua harë chirë, sibhoono hano ndanyoore ntaana bhöhanchi mbuchua ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkageseha nhaane ibhintö bhiane bhionsui bhino nëënabhio köbhataka, ninyoora nihaane ömöbhërë goone gösamböe, sibhoono hano ndanyoore ntaana bhöhanchi, gayö tëgagankorra bhuëra hai.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöhanchi nkugumirria bhörë, nkögesehia bhörë; öbhöhanchi tëbhööna ihari gösë ubhuirahi hai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöhanchi tëbhököbhöra bhusuuki gösë tibhuguitönëra bhuëra gösë tëbhökögootöa na nkoro hai; na guiki öbhöhanchi tëbhökëbhëëkërra amasaria hai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "öbhöhanchi tëbhökögookeröa na ubhunyanku hai, gëtatiga nkögookeröa bhörë na öbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.6",
            "verseOrgIds": [
              "1CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöhanchi nköremerria bhörë gonsui; ngukumia bhörë gonsui nguiteng'era bhörë gonsui na nkugumirria bhörë gonsui.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöhanchi nö öbhö kuya ëyö. Hano ndanyoore ibhihaano bhiö öbhönaabhi bhiiho, bhiyö mbirisira; ndanyoore ibhihaano bhia gusumaacha ibhigambo bhiiho, mbiina umuhiko; ndanyoore ubhunguri bhööho nabho bhonsui mböraahete. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira öbhöng'aini bhoitö tibhiisërë hai na öbhönaabhi bhoitö tibhuisërë hai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sibhoono hano këëra kërëngë öbhöhekëëranu kirihika, bhira bhionsui bhitarë ibhihëkëëranu mbirisira.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga naarëngë ömoona, nnaakagambërë kiö ömoona, nnaamanyërë amang'ana kiö ömoona na naagaitegerreeyë kiö ömoona; hano naabhaayë ömöntömökörö nnaatigërë amang'ana gë ëkeena. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këno bhoono tökömaaha kënga ikiiriiri gukiimaahëro; sibhoono sooki ntörëmaaha gëtoonooni. Bhoono igo nëmanyërë kuing'ënga; sooki nëndësësöra kimui-kimui, kebhörë nani nmanyëkainë kimui-kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö amang'ana atatö gano ngo gakögöma, ubhukumia, uguiteng'era, na öbhöhanchi; ihiku bhökong'u gökëra gonsui nö öbhöhanchi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.13",
            "verseOrgIds": [
              "1CO.13.13"
            ]
          }
        }
      ]
    }
  ],
