  "bookId": "1CO",
  "reference": "1 Abhakorinto 8",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1CO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iribhuuriö igörö yi ibhiakörea bhino bhikumuenseroa ibhihooru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono amang'ana gano gaitung'aini ibhiakörea bhino bhimuenseeyöë ibhihooru: Ntömanyërë iga, “Bhaitö bhonsui ntööna ubhunguri,” Ubhunguri nkörenta bhörë ubhuihechu; sibhoono öbhöhanchi nköhagaacha bhörë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.1",
            "verseOrgIds": [
              "1CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öno agökanya iga namanyërë amang'ana öbhöheene tukunyoora amanyërë kebhörë këragërë iga amanye hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.2",
            "verseOrgIds": [
              "1CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömöntö öno ahanchërë Ënooköë, namanyëkaini harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.3",
            "verseOrgIds": [
              "1CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono mbe, igörö yö ökörëa ibhiakörea bhino bhimuenseeyöë ibhihooru; ntömanyërë iga ëkëhooru kiö ömökörö maheene na ëgëntö këno gëtaaho na guiki ntömanyërë iga Ënooköë nu umui bheene aho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.4",
            "verseOrgIds": [
              "1CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkanyoora chiiho chino chiköbhërëkëröa iga, “Ichinooköë,” kuriöbha gösë gökëbhara këno, na niigo kërë nchiiho “ichinooköë” na mbaaho “abhanene,” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.5",
            "verseOrgIds": [
              "1CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono harë bhaitö Ënooköë nu umui, Taata, öno arëngë Möteemi wi ibhintö bhionsui, na ngikugira yaae tööho; na Ömönene umui, Yesö Kirisitö öno ibhintö bhionsui bhiiho gököhetera harë we na bhaitö bhonsui tööho gököhetera harë we.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.6",
            "verseOrgIds": [
              "1CO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.6",
            "verseOrgIds": [
              "1CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono tëbhonsui bhaköngöra igo hai. Kugira abhantö abhamui mbaaho bhano bhaisa könara ibhihooru, abhantö bhano ninyoora mboono hano bharaare ibhiakörea bhiyö nkubhimaaha bharë nkanya iga ni ibhiakörea bhino bhimuensëröë kubhihooru; ëntariki yaabho në ëndosu, hano bharaare ibhiakörea bhiyö nkömaaha bharë iga bhatöörröë ibhikui. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.7",
            "verseOrgIds": [
              "1CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiakörea, tibhigutuhikia hang'i na Ënooköë hai; tëtörasööhëröe gëntö kërë gionsui hai hano törange körëa ibhiakörea bhiyö hai, gösë tëtörengeribhue gëntö kërë gionsui, hano ndanyoore tubhirëëyë.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.8",
            "verseOrgIds": [
              "1CO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.8",
            "verseOrgIds": [
              "1CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono muiraarërre, ögötöra koinyu koogökora amang'ana götakaagira bhaara bharëngë abharosu kubhukumia bhakore iriraga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.9",
            "verseOrgIds": [
              "1CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira, hano ömöntö öno ndanyoore ana ëntariki ëndosu arakömaahe uwe öno öna ubhunguri öraraagëra köhekaru yi ibhihooru, bhoono ëyö tëraagire arë ibhiakörea bhino bhimuenseeyöë ibhihooru? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.10",
            "verseOrgIds": [
              "1CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbe, ömöntö öno arëngë omorosu kubhukumia, ömöntö weinyu öno Kirisitö aakuërëëyë, narasire gikugira yu ubhunguri bhooo! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.11",
            "verseOrgIds": [
              "1CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na köng'ana ëyö nöranyoore ökorrë iriraga harë Kirisitö kögökora iriraga köbhantö bhainyu na kunyahaara ichintariki chaabho ichindosu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.12",
            "verseOrgIds": [
              "1CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbe hano ndanyoore ibhiakörea bhigaakora ömöntö weitö agöe kuiraga, tënkaarëa guiki inyama röndë hai, ntagaacha gökora ömöntö weitö agöe kuiriraga.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.13",
            "verseOrgIds": [
              "1CO.8.13"
            ]
          }
        }
      ]
    }
  ],
