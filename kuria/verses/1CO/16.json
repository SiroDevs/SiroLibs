            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichikanisa chino chirëngë kömöndaara go Asia chibhakeerri; Akuira na Bhirisika na ëkanisa ëno ikuiranëra moobho bhabhakeerri bhökong'u kö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakumia bhonsui bhano bhaahano bhabhakeerri. Mökeerani bhonsui möranaamuunana köbhöhanchi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
