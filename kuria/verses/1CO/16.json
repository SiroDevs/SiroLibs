            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Timoteo araache harë bhainyu hayö, mömanye möna möramuirigani korri iga atakoobhoha guikara na bhainyu, kugira nö Ömönene agökorra ëmërëmo, ke hano nkömökorra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö örë wonsui atagaacha kömösera, gëtatiga kuhika mumutuurri agenderri na örögendo rooe kömörembe, korri iga aringe guucha harë uni; kugira nkömöganya ndë hamui na abhakumia bhandë.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
