              "items": [
                {
                  "text": "Ama 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndaache harë bhainyu hano ndaise köhetera Maketonia, kugira Maketonia ndëëchëra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handë kaanyoora nëndëbha na bhainyu guchinsikö nyabhörebhe, handë kura ënkaaga yonsui ya mabheho, sooki muuche guntuurria, ngenderri na örögendo roone kuya harë honsui ndituna kuya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tingutuna köbhamaaha ndahëëta igo na kögenderria na örögendo hai, nguiteng'era ndë köbha na bhainyu gönkaaga ëntambë, hano Ömönene arahanche.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        }
      ]
    },
