                  "text": "1 Ko 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uni ömögaaka – ndakondëkëra uwe ömöhanchöa Gayo, öno nhanchërë köbhöheene.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "3JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "3JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöhanchöa ngösabha ndë iga amang'ana gonsui gabhe bhuuya harë uwe ninyoora nö ömöbhërë ghöbhe bhuuya kehaara bheene ömoöyö gooo görëngë bhuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.2",
            "verseOrgIds": [
              "3JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "3JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabhaayë na ömögooko bhökong'u hano abhamui bha abhakumia bhaachërë bhakaruusia ubhutubhuri keebhörë örëngë ömöheene, na keebhörë ökögenda köbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.3",
            "verseOrgIds": [
              "3JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëgëntö këëho këno gëköngookia gökëra hano naigua iga abhaana mbamenyërë köbhöheene.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gayo aragöngöa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "3JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöhanchöa, nörëngë ömöheene gö kërë gonsui ukunyooraa örakore gikugira ya abhakumia, ninyoora ötabhamanyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.5",
            "verseOrgIds": [
              "3JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "3JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbaaruusiri öbhöherekia gökanisa igörö yö öbhöhanchi bhooo. Nörakore bhuuya bhökong'u hano örabhatuurri bhagenderri na örögendo roobho gönchëra ëno ërategeri Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.6",
            "verseOrgIds": [
              "3JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "3JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira mbaatanga örögendo roobho gikugira yi Iriina reee na tëbhanyoorrë bhutuurria bhörë bhonsui kurua kö abhahamatë. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.7",
            "verseOrgIds": [
              "3JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "3JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkëragërë iga tutuurri abhantö ke bhayö korri na bhaitö tösangë kömërëmo gëyö köbhöheene.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tioterebhe na Temetirio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "3JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "3JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naandëka ëng'ana nyabhörebhe kuya gökanisa, sibhoono Tioterebhe öno ahanchërë guitangatia tagutuna kunyigua hai. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.9",
            "verseOrgIds": [
              "3JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö hano ndiicha nindihiita ntööre harabhu amakora amabhëëbhë gano agökora hamui na amang'ana amanyanku gano akögamba igörö yeitö! Guiki gayö tëgamuisërë hai, tagutuna ninyoora nu ukuirigania abhahanchöa hai na bhaara bhagutuna iga bhabhairigani nköbharugia arë kurua gökanisa.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "3JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhahanchöa monge kuëga gökora gano garëngë amanyanku si muëge gökora amaiya. Örë wonsui agökora amaiya öyö nö öwë Ënooköë; na örë agökora amanyanku öyö tarëmaaha Ënooköë hai.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "3JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temetirio nkögamböa arë bhuuya na abhantö bhonsui, na öbhöheene ubhuene nkömögönga bhörë. Na bhaitö nkuruusia törë öbhöherekia igörö yaae, na bhainyu bhonsui mmömanyërë iga öbhöherekia bhoitö nö öbhöheene.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakeerio ga gösookerria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "3JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnëëna amaaru ga gökondëkëra, sibhoono tingutuna kögandëka gökaraamu na ëkarataasi hai. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.13",
            "verseOrgIds": [
              "3JN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguiteng'ëra ndë gökömaaha bhöngö igo korri tusumaache gëtonooni.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "3JN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömörembe ghöbhe na uwe. Abhasaani bhagökeerri. Ökeeri abhasaani bhonsui, na këra umui kuriina reee.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
            ]
          }
        }
      ]
    }
