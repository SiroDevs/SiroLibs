      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Suremani arasabha öbhöng'aini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani agakora urutundurra na Bharao ömögambi wa Misiri, kögöteta umuisëkë waae. Akarenta umuisëkë o Bharao na kömötööra kumugi go Tauti, kuhika hano asookiri köhagaacha inyumba yaae umuene, hamui na ëhekaru yö ÖMÖNENE na urugito kuinaara umugi go Yerusaremu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karai hayö, abhantö mbakamuesërë guchinguku kugira nkanyoora inyumba yë Ënooköë tërahagaachöa hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani nahanchërë ÖMÖNENE, na kögoota amaragirriö ga Tauti, isawaabho; gëtatiga bheene, hano we aakamuensërë guchinguku na gösamba öbhöbhaani kubhikerege.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
