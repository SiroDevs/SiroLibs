    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaragirrio ga gösokeerria ga Tauti harë Suremani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Tauti aatunërë gukua, naabhërëkëëyë ömoona waae Suremani akamöragirria aragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.1",
            "verseOrgIds": [
              "1KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Moona waane, kebhörë ibhintö bhionsui mbiang'oreeyöë uruku gökëbhara, ichinsikö chaane chisirrë. Bhoono ögöme na köbha ömökarë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.2",
            "verseOrgIds": [
              "1KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hëkëërania amaragirriö gö ÖMÖNENE, Ënooköë waao, ösoorane ichinchëra chaae imigiro, amarago, amaragirriö na kögoota ichindagano chaae kebhörë kendëkërë kömarago ga Mösa, korri ösaraare harë këra ng'ana ögökora na harë honsui ukuya, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.3",
            "verseOrgIds": [
              "1KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri ÖMÖNENE ahëkëërani ëndagano yaae ëno aanyihimiirriiyi iga ndanyoore uruibhöro roone nduiguëra amarago gaae na kömökorra ëmërëmo köbhöröngë na kömooyo gonsui, taarëbhöra möntö o kögambëra Isiraeri ichinkaaga chonsui.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
