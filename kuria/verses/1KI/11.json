    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Suremani Araihönchöra kurua harë Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Ëhë 17:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Suremani nahaanchere abhagaikörö bhe ichihamatë: Umuisëkë o Bharao, abhagaikörö bha Abhamoabhu, Abhaamoni, Abhaetomu, Abhasitoni na Abhahiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.16"
              },
              "items": [
                {
                  "text": "Ëgt 34:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.3"
              },
              "items": [
                {
                  "text": "Ëhë 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhagaikörö bhi ichihamatë chino ÖMÖNENE wanyoorrë aakania Isiraeri aragamba iga, “Mötagaateta waabho, gösë bho göteta weinyu kugira abhakari bhayö mbarahotore imioyo geinyu korri mösengere ichinooköë chaabho, Suremani naahanchërë bhökong'u abhakari bhayö.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani naarë, na abhakari amagana muhungatë (700), bhano bharëngë abhaisëkë bha abhagambi; na abhaikarani amagana atatö (300). Abhawsazkari bhaara bhakamöhotora. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano akunguhërë, bhakaae mbamöhotooyë agasengera ichinooköë chindë, na tabhaayë möheene kimui kö ÖMÖNENE, Ënooköë waae, kehaara Tauti isawabho aarëngë ömöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani nakoreeyë Asitoroti ënooköë ënkari wa Abhasitaroti eno yaarëngë ënooköë ënkari ya Abhasitoni, na naasoraini Mirikomu öno aarëngë ikiriirriö kia Abhaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Suremani agakora amanyaanku mbere yö ÖMÖNENE, na tagooterë amatuno gö ÖMÖNENE kehaara Tauti isawaabho wanyoorrë aakora hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këgörö yi inguku ëno yaarëngë ëntahana ya rögörö Yerusaremu, Suremani naahagaachërë ho ahasë ha kumuensera Kemosi, ikirirrio kia Abhamoabhu, na ahase ha kumuensera Moreki, ikirirrio kia Abhaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene akahagaachëra bhakaae abhahamatë bhonsui ahasë ha gösambëra öbhöbhaani na kumuensera ichinooköë chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe, ÖMÖNENE, Ënooköë wa Isiraeri, akarëërërra Suremani, kugira nkanyoora atigërë ÖMÖNENE, Ënooköë wa Isiraeri, ninyoora we naanyoorrë amurichokera harë kabhërë, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kömöteebhia iga, atagaacha gosengera ichinooköë chindë, sibhono Suremani taagootërë amarago gö ÖMÖNENE hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayo ÖMÖNENE agateebhia Suremani iga, “Gikugira wairuusia gökora igo, wasaria ëndagano yaane nawe, na göteeyera amarago gaane gano naaköhaayë, maheene nëndakuruusi öbhögambi bhöyö na köha ömökoramërëmo waao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, gikugira ya isaweinyu Tauti, tëndaakore igo kömabhaho gaao hai, getatiga nindiruusia obhogaambi bhöyö kömabhoko gö omoona waao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora newe tindimuruusia öbhögambi bhonsui hai, gëtatiga nëndatëgëre ömoona waao ikiaro kimui, gikugira ya Tauti ömökoramërëmo waane, na gikugira yu umugi go Yerusaremu göno naahöra köbha ögoone.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhabhisa bha Suremani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ÖMÖNENE, akorrë Hatati öno aarëngë we ëka yö ömögambi wa Ëtomu, köbha umubhisa o Suremani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Tauti aasikiri Abhaetomu, Yoabhu ömökönaare wi iricheesi re Tauti, naagëëyë ho götökëra bhano bhaitëröë. Yoabhu naitërë abhasaacha bhonsui bha Ëtomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15",
            "verseOrgIds": [
              "1KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Yoabhu naamenyërë ho na abhasirikare bhaae kumieri ësaansabha, korri asiki abhasaacha bhonsui bha Etomu). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.16",
            "verseOrgIds": [
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, Hatati öno ënkaaga ëyö aarëngë ömöhentani, naang'oseeyë Misiri hamui na Abhaetomu bhaandë bhano bharëngë, abhakoramërëmo bha isawaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatati na bharikia bhaae, mbaagendërë gukurua Mitiani, bhakahetera abhantö bhaandë Bharani haara, bhakaya nabho kuhika Misiri, harë Bharao ömögambi wë ënsë ëyö. Bharao akaha Hatati inyumba, akaruusia ëngamba iga, ayi arahaabhöa ibhiaakörëa, na akamöha irirëma. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharao naategeribhui bhokong'u na Hatati. Igo mbe Bharao agaitabhirria mököë waaë, ömöke harë musubhati omoobho Tabhenesi ömökari wö ömögambi, atetöe na Hatati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na musubhaati omoobho Tabhenesi akaibhörra Hatati ömoona öno aarë köbhërëkëroa iga, Genubhati. Genubhati naakinibhui na Tabhenesi kunyumba ya Bharao, hamui na abhaana bhö ömögambi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Hatati aiguurë aarëngë Misiri haara iga, Tauti hamui na Yoabhu ömökönaare wi iricheesi, bhaakuurë, agateebhia Bharao iga, “Ndasabha iga, untige niyi gönsë yaane.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, Bharao akamubhuuria iga, “Nkë ntagököha örakenga ikiina ge kuringa gönsë yaao?” Hatati nawe akamögeya aramba iga “Tatiga uwe niyi.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene, Ënooköë, naakorrë Resoni ömoona o Eriata köbha umubhisa o Suremani. Nkanyoora Resoni aang'osa ömönene waae, Hatateseri ömögambi wa Sobha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Tauti asookiri guita abhantö Sobha haara, Resoni naakömërë abhantö na göseemia irikomo ria abhateeyu, nawe umuene akabha ömötangati waabho, igo, bhakaya Tamasiko, bhakamenya ho na götööra Resoni köbha ömögambi wa Tamasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resoni nabhaayë umubhisa wa Isiraeri guchinsikö chonsui cha öbhogaambi bho Suremani, akamuiriria bhökong'u kehaara Hatati aarë kumuiriiria. Resoni naaserrë Isiraeri, nawe akagambëra ënsë ya Samu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëndagano yë Ënooköë harë Yerobhoamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobhoamu ömoona o Nebhati, Ömuibhuraimu wa Sereta, ömökoramërëmo wa Suremani, öno nyaköwaabho aarëngë umusino öno aköbhërëkëroa iga, Serua, nawe nateyeeyë ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këno nkio ikibhune ke göteeyëra ömögambi: Nkaaga Suremani aarë gösaacha köhagaacha Miro na gökong'erria ichindigi chu umugi go Tauti isawaabho, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobhoamu naamahëkaini köbha ömöhentani öno arëngë umutirimiku na ömökarë; Nëho Suremani arööchë iga, ömoona ööra Yerobhoamu naarë na ömökëa, akamötööra köbha umuimirirri wë ëmërëmo gë köhaamirribhua gëno gekorröë na abhantö bhiëka ya Yosebhu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röndë, nkanyoora Yerobhoamu aragenda kurua Yerusaremu, agasikana Ahiya ömönaabhi wa Siro gönchëra. Nkanyoora Ahiya asuarrë ëngëbho ëhëa. Bhonsui bhabhërë mbaarë abhiene këbhara haara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho hayö igo, Ahiya akaruusia ëngëbho yaae ëhëa, akagëtandöra ibhitati ikumi na bhibhërë, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakurua agateebhia Yerobhoamu iga, “Imukia ibhitati ikumi kugira ÖMÖNENE, Ënooköë wa Isiraeri, aragamba iga: ‘Tamaaha, hang'i ndë nyërëgani öbhögambi na kubhuruusia kurua kömabhoko ga Suremani, na uni nëndaköhe ibhiaro ikumi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, we nëndamötëgëre ikiaro kimui gikugira yö ömökoramërëmo waane Tauti, na gikugira yu umugi go Yerusaremu, göno naahöra köbha ögoone kumigi gu ibhiare bhionsui bhia Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndakore igo gikugira Suremani antiga, asengera ichinooköë chindë: Asitaroti ënooköë ënkari iya Abhasitoni, Këmosi, ënooköë ya Abhamoabhu na Mirikomu ënooköë ya Abhaamoni. Suremani anteyeera, na gökora amanyaanku mbere yaane, na anga kögoota imigiro geene na amaragirriö gaane kehaara Tauti isawaabho aakorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora niigo, tëndamuruusi öbhögambi bhonsui hai, gösë ögötöra kömabhaho gaae, gikugira ya ömökoramërëmo waane Tauti öno naahöyë, na öno agootërë imigiro geene na amaragirriö gaane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sibhoono, nëndaruusi ömoona waae, öbhögambi bhöyö, na uni nëndaköhe uwe Yerobhoamu ibhiaro ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumura öyö o Suremani nëndamutigiri ikiaro kimui korri umuibhöröa ömökoramërëmo waane Tauti abhe ömöbhaahi Yerusaremu nkaaga yonsui, abhe ëtara ëno ëkömörëka kuya ëyö mbere yaane kumugi göno naahöra köbha ahasë ha gönsengera. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, uwe Yerobhoamu, nëndagökore ömögambi wa Isiraeri, nawe nöragambëre kebhörë öhanchërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na, hano ndanyoore nögoota gaara gonsui ndagöteebhi, hano ndanyoore nömenya gököreng'ana ke bhööra ngutuna, hano ndanyoore nökora amaiya mbere yaane gökögoota amaragirriö gaane na amarago gaane, kebhörë ömökoramërëmo waane Tauti aakorrë, uni nëndaabhe hamui nawe nkaaga chonsui. Na nëndaaköhe ënsë ya Isiraeri na gutuurria öbhögambi bhooo bhögöme kebhörë naakoreeyë Tauti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gököreng'ana na gayö, nëndabhörööte ëka ya Tauti si tikuya ëyö hai.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ya gayo, Suremani naasachërë iga, aite Yerobhoamu, sibhoono, Yerobhoamu akang'osera Misiri wa Sisaki ömögambi o Misiri akamënya hö kuhika hano Suremani aakuurë.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruku ro Suremani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana gandë ga Suremani, gonsui gano aakoorrë na öbhöng'aini bhooe ngandëkëröë ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani naagambëëyë ënsë yonsui ya Isiraeri, kömeeka mërongo ënai, amenyërë Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, Suremani agakua, agatökëröa kumugi go Tauti isawaabho. Rehobhoamu, ömoona o Suremani akagambëra kuibhaga reee.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
