                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.31"
              },
              "items": [
                {
                  "text": "Ruk 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ömögaikörö ömögambi wa Sëbha aiguurë ichinkuma cha Suremani, gikugira yi iriina riö ÖMÖNENE, naagëëyë harë we korri iga amösaache kömabhuuriö amaköng'u.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naachërë na abhantö abhaaru hamui na ichingamëëra chino wanyoorrë chimukiri ubhurumbasi, ibhituho ibhiaru bhökong'u na amagëna gi iriguri irinene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani nawe naahunchukiri amabhuurio gaara gonsui; tibhuurio rërrë rionsui reekërë ömögambi hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömögaikörö ömögambi wa Sebha arööchë öbhöng'aini bhonsui bho Suremani hamui na inyumba ëno wanyoorrë ahagaacha naarögöörrë bhökong'u; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "guiki hano aarööchë ibhiakörea bhino bhiarenteröë kömeesa yaae, kebhörë abhaimiriirri bhaae wanyoorrë bhaikaayë kömeesa, kebhörë abhakoramërëmo bhaae bhaarë gökora ëmërëmo na kebhörë wanyoorrë bhasuarrë, hamui na abhakaguri bhaae, na ibhiruusio bhia gösambërëërröa bhino aruusiri kunyumba yö ÖMÖNENE naaggënërë na körögööra bhokong'u.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, agatëëbhia ömögambi Suremani iga, “Amang'ana gonsui gano naigua gönsë yaane igörö yë ëmërëmo na öbhöng'aini bhooo, na amaheene! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, tënaitabhirriiyi amang'ana gayö, kuhika hano niichërë na kuiheerria umuene. Kana kura tënateebhibhui ninyoora ni iritënë reego hai; öbhöng'aini bhooo, na öbhomë bhooo mbikërrë amang'ana gano naarënteeyöe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakao mbaana iriyeega! Abhakoramërëmo bhaao, bhano bhaagökora ëmërëmo, ichinkaaga chonsui na kuigua öbhöng'aini bhooo mbaana iriyeega! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agöngöe ÖMÖNENE, Ënooköë waao, öno aategeribhua na uwe, akagötööra igörö yi igitumbë kiö öbhögambi ke Isiraeri! Kugira ÖMÖNENE naahanchërë Isiraeri kuya ëyö, aagökora köbha ömögambi, korri ökore öbhöheene na öbhöröngë.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögaikörö ömögambi wa Sebha ööra akaha ömögambi Suremani ësahaabhu ëno yaareenge ichikirö ibhiköë bhinai (4,000), ëkërengere ëkënene kiu ubhusuraancha na amagëna gi iriguri irinene. Ëkërëngere kiu ubhurumbasi ëkënene gë këyö arusiiyi Ömögambi Suremani, tëgekarentëröë guiiki hai.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiiki, irikomo ri ichimeri cha Hiramu nchaarentërë ësahaabhu kurua Obhiri, na ëmëtë giö ömosandari köbhooru na amagëna gi iriguri irinene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ömögambi Suremani akaimukia ëmëtë gëyö giö ömösandari agakorra imitimö gi inyumba yö ÖMÖNENE, na igi inyumba nköörano na gökoorra amatungu na ibhinande bhia abhasiringia. Ëkërengere kië ëmëtë gio mösandari gë këyö tëgëkabhaayë ho kuhika reero.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Suremani nawe akaha ömögaikörö ömögambi wa Sebha kërë gionsui waanyoorrë aigombërë na këno aatunërë; hamui na ibhintö bhindë bhino ömögambi Suremani amöhaayë köbhögesa bhooe bhö öbhögambi. Köhayö ömögaikörö akariinga kuya gönsë yaae, hamui na abhakoramërëmo bhaae.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhoomë bhö ömögambi Suremani (Enk 9:13-29)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra ömökari wa Suremani naarë köherröa ësahaabhu ichikiro ibhiköë mërongo ëbhërë na ibhërë (22,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëkërengere këyö nëkëhagarë na këëra aanyoorrë kobhasuruusia na abharanguri, köbhagabhana bhonsui bha Abhaharabhu na abhanene bhië iching'ongo cha Isiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Suremani naakorrë ichingubha ichiinene amagana abhërë (200) kurua gö ësahaabhu inyëke; chino chaarë na ubhurito bhui ichikiiro muhungatë ichë ësahaabhu inchiiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua agakora ichingubha ichinke nke amagana atatö (300) kurua gösahaabhu inyëke, këra ingubha yaarë na ikiiro imui ni iritënë, hakurua ömögambi agachitööra guitendeera rëno rebhërekëëyöë iga, Nyumba ya isisi re Rebhanoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, ömögambi naakorrë igitumbë ëkënene kiö öbhögambi këno keerë na ichintera, agakëhaka ësahaabhu inchiiya bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitumbe këyö nkeerë na ichisagaro isansabha. Ëntahana ya igörö këgakorröa ahasë ha kuegeka ököbhoko ichintahana chonsui ibhërë; na ibhihooru bhi ichindui ibhërë bhimërëëyëe, ikimui mbarëka ya ahasë hayö ha kuëgëka ököbhoko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19",
            "verseOrgIds": [
              "1KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiarënge ho guiki ibhihooru ikumi na bhibhërë ibhi ichindui bhimërëëyë, ikimui gönsonga yë ësagaro. Igitumbë ge këyö tëkegakorröë kö öbhögambi bhörë bhonsui hai.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
