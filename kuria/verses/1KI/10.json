            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe, Ömögambi Suremani nakërrë abhagambi bhonsui gökëbhara gionsui köbhoomë na köbhöng'aini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui gökëbhara mbaarë kuigomba kuya harë Suremani korri iga bhategeerre öbhöng'aini bhooe bhöno wanyoorrë Ënooköë aamösakiria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra öno arëngë kuya harë we, naarë kömörentera igituho: Ibhintö bhia amatiini gi ichimbiria, bhië ësahaabhu, ichingëbho, manemane, ubhurumbasi, ichibharaasi natëkërë-bharaasi. Naakanyoorrë ibhituho bhino këra ichi mooka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
