                {
                  "text": "1 Gam 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani naakömërë amagaari gi ichibharaasi na abhagendia-bharaasi, naarëngë na amagaari ga ichibharaasi ëgëköë kimui na amagana anai (1,400) abhagendia-bharaasi ibhiköë ikumi na bhibhërë (12,000) bhano atörrë kumigi gëno gerëngë na ubhusikanëro bhua amagaari gi ichibharaasi, na Yerusaremu haara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Ëhë 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, ömögambi Suremani naarööchë amatiini gi ichimbiria gano gaarë Yerusaremu kanya na amagëna gandë igo, na ichimbaara chi imieresi nchaarë ichincharu gi chimbaara chi ëmëkö ge Sebhera. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Ëhë 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suremani nagatömaini ichibharaasi kurua Misiri, na kurua Kirikia hano abhasuruusia bhaae bhaakagurribhui na abhantö bha Kirikia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irigari irimui re kurutua ndeerë kuguribhua amatiini gi ichimbiria ichikiirö muhungatë Misiri, na ëbharaasi imui yaarë kurua amatiini gi ichimbiria ichikiiro ibhërë. Abhasuruusia bhö ömögambi Suremani mbaakahirrë amagaari na ichibharaasi chiyö na kugurria abhagambi bhonsui bha Abhahiti na Abhasamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
