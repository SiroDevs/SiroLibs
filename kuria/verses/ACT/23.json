          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömökönaare ööra akagooterra ömöhentani ööra ököbhoko, akamoohukia hagarë akamubhuuria iga, “Në ng'ana kë önayo ëno ugutuna gönteebhia?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.19",
            "verseOrgIds": [
              "ACT.23.19"
            ]
          }
        }
      ]
