            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhauro akabhahunchukiria iga, “Bharikia bhaane Abhaisiraeri, tinyoorrë mmanyërë iga nëwe umunchaama umuhikërë hai. Kugira ërendëko nkögamba rërë iga, ‘Ötagaacha kögamba bhöbhëëbhë ömögambi wa abhantö bhainyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        }
      ]
    },
    {
