            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua röyö abhakumia bha Yerusaremu, mbaatangërë kuiriiribhua bhökong'u. Ëkanisa yonsui gutiga abhatömöa bheene, mbaanyeregainë kuya kömëndaara ge Yutea na Samaria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhandë abhasengeri bhë Ënooköë mbo bhaahirrë Sitebhano bhui, bharamököörra bhökong'u.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        }
      ]
    },
    {
