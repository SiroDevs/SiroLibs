          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Bhauro aasookiri gusumaacha, naasigamërë hansë hamui na abhantö bhonsui bhagasaasaama. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui mbaarë gukuura bhamuibhaarrë bharamoomuuna. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaaitumatërë köhaara wanyoorrë aabhateebhiri iga tëbharëmömaaha röndë hai. Köhayö bhakamöröngëka kuya kömeeri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
            "verseOrgIds": [
              "ACT.20.38"
            ]
          }
        }
