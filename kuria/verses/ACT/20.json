              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na bhoono mbatöörrë kubhuriihi bhöe Ënooköë, na köng'ana yë ësaramita yaae, ëno ëraatöre köbhahagaacha na köbhaha amaitabhiriö gë Ënooköë gano aabhëëkëëyë abhaahöroa bhaae bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.32",
            "verseOrgIds": [
              "ACT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tënaatuna mbiria cha möntö, gösë sahaabhu gösë ngëbho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu abhiene mmömanyërë iga, kömabhoko gaane gano umuene naakorrë ëmërëmo ngatuurria bharë toorë nabho kërë gionsui bhaarë gutuna hamui na uni umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
              "ACT.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naisa köbhoorokia kömang'ana gonsui iga, kögökora ëmërëmo na umutuunyo ke hano ntöratuurri abharosu, na törahëëtöka amang'ana gö Ömönene Yesö gano aagambërë iga, ‘Në ëmësaaraaro ëmënene köhaana gökëra köhaabhöa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        }
      ]
    },
    {
