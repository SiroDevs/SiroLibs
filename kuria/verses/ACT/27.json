        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhasirikare bhagakora ëseemi iga bhaite abhabhohe bhaara bhonsui, korri iga wöndë atagaacha kuerema ang'ose ayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömöhobhisa wi iricheesi agatuna iga atuuri Bhauro atagaitöa. Köhayö akabhakaania iga bhatige ëseemi ëyö. Kuibhaga rëyö agateebhia abhantö bhonsui bhano wanyoorrë bhamanyërë kuerema iga bhaibhurruke kurua kömeeri bheereme kuya ihumbu tanga; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "na abhandë bhurue nyuma bhaisöngërërrëëyë amabhaara gaara wanyoorrë gabhötökërë kurua kömeeri. Niigo bhonsui tookorrë tökahika nkunguguni mörembe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
