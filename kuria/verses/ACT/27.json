        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhutikö bho ikumi na kanai, ntoorë gutunduatundua na amagengiö gi inyancha ya Atiria. Hano bhoobhaayë ubhutikö gatai abhagendia bhë ëmeeri, bhagakanya iga töbhaayë hang'i na ömögai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.27",
            "verseOrgIds": [
              "ACT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö bhakarenga amanchë na urusiri bhakanyoora gahikërë öbhötambë kuya hansë hang'i ichimiita mërongo ënai; bhagaikara hake igo guiki bhakarenga ëkërengo këëra mo, bhakanyoora chihikerë hang'i ichimiita mërongo ëtatö. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.28",
            "verseOrgIds": [
              "ACT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakoobhoha iga ëmeeri ëgaisurruka ichintare, köhayö bhagasikiria ichinanga inyai chë ëmeeri, bhagasabha iga bhuhike gökëa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.29",
            "verseOrgIds": [
              "ACT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhaara bhaarëngë kömeeri bhagatuna köng'osa, bhagasikiria ihioto ihike hiira kömanchë bharaing'ainirria iga nkuya bharë gusunga amagëna gandë mbere yë ëmeeri haara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.30",
            "verseOrgIds": [
              "ACT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si Bhauro agateebhia ömöhobhisa wi iricheesi hamui na abhasirikare iga, “Hano ndanyoore abhantö bhano bhë ëmeeri bhatagötama kömeeri, tëmökahona hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.31",
            "verseOrgIds": [
              "ACT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö abhasirikare bhaara bhagakenga ichinsiri chiira wanyoorrë chigooterreeyë öbhooto bhööra chikabhötoka bhökahirua na amanchë.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhootunërë gökëa, Bhauro akabhageya bhonsui iga bhare ibhiakörea aragamba iga, “Reero nu urusikö ro ikumi na kanai mörëngë guchinganigania na guchinsikö chiyö chonsui moobha götabhaaabhaaria mötaana bhiakörëa na tëmoorë na gëntö kërë gionsui hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhageya iga bhoono möre ibhiakörea bhino bhirabhahe ichinguru cha kömenya. Ninyoora nö örötame rui ituukia yeinyu tërögaasira hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.34",
            "verseOrgIds": [
              "ACT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Bhauro aasookiri kögamba igo, akaimukia ömögaate, akaruusia umukumo kö Ënooköë mbere yaabho hayö, akagöbhötora agatanga körëa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.35",
            "verseOrgIds": [
              "ACT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho bhoono bhaatërëmëkërë bhonsui bhakaragëra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.36",
            "verseOrgIds": [
              "ACT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui bhano toorëngë kömeeri mööra ntoorëngë amagana abhërë na mërongo muhungatë na bhasansabha (276). ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.37",
            "verseOrgIds": [
              "ACT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhonsui bhaasookiri köraagëra bhakaigöta, bhakaimukia imirigo gë ëngano kurua kömeeri mööra bhararekera kunyancha korri iga ëmeeri ëhöhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögötaagana köë ëmeeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono hano bhookëëyë, tëbhöngööyë ënsë ëëra hai, sibhoono, mbaarööchë ömösori na ëmbarëka yi inyancha, harë bhaaseemiri iga bhakaagobha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.39",
            "verseOrgIds": [
              "ACT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatabhuta ichinanga chiira, bhagachitiga kunyancha, hamui na kunyoonyoogia ichinsiri chë ëgëtaari, bhagatimbia ëhanga nke korri ërëbhërre ömökama, bhakaya kömbarëka ëëra yi inyancha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.40",
            "verseOrgIds": [
              "ACT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ëmeeri yaihonyërë kömösense göno wanyoorrë googöröka kunyancha; ëntahana ya mbere yë ëmeeri yaaitemeeyë ëgakira iga kiri, na haara ëntahana ya nyuma wanyoorrë nköbhötökabhötöka ërë amatënë gikugira ya amagengiö gano gaarëngë amanene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
