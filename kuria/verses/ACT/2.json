                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono Ënooköë akamuriukia kurua köbhaku, akamuruusia hansë yö ögötöra kuruku, kugira uruku tërögaatörrë kumugumia hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
