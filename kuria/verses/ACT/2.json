                "loc": "PSA.16.8+PSA.16.9+PSA.16.10+PSA.16.11"
              },
              "items": [
                {
                  "text": "Sab 16:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira Tauti naagambërë amang'ana gaae iga,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
