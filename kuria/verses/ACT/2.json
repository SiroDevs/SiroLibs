                "loc": "DEU.16.9+DEU.16.10+DEU.16.11"
              },
              "items": [
                {
                  "text": "Ëhë 16:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano urusikö ro Bhentekosite roohikërë, wanyoorrë abhakumia bhonsui bhairaini hamui. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho hayö igo bhakaigua ikihimo kërarua kuriöbha guchinguru këno kënga ikigumbë, këgaichöra nyumba mööra wanyoorrë bhaikaayë. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakarichokeröa na ichindëmë chino chaahökaini gi ichindëmë chö ömörro chino chaabhaikareëyë këra umui waabho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui bhagaichuribhua na Nkoro Nhoreeru, bhagatanga gösabhucha kubhigambo bhindë, keebhörë Nkoro abhahaayë ögötöra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti mbaarëngë Yerusaremu, abhantö bhi itiini bhano wanyoorrë bharuurë këra ëhamatë hansë ya kuriöbha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaaiguurë igichagano këyö, irikomo irinene ndeechërë rëgasanga ho. Bhonsui mbaaibhambökërë, kugira bhonsui mbaaiguurë ibhigambo bhiabho hagarëhagarë bhiragamböa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagataraaha na karögööra bharagamba iga, “Abhantö bhano bhakögamba ibhigambo bhino, kana ndaigua bhonsui na Abhagariraya! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mbe niyekë këbhaayë, nkögamba bharë bhonsui töraigua kubhigambo bhietö? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano turuurë Bharitia, Metia na Eramu; abhandë mbaaruurë Mesobhotamia, Yutea na Kabhatokia; gukurua Bhonto na Asia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Bhirigia na Bhamubhiria, gukurua Misiri na kömëndaara ge Ribhia hang'i na Kirene na abhandë kurua Rumi, bhonsui Abhayahuti hamui na Abhahamatë bhano bhaihönchörra ësengero yi itiini ya Abhayahuti, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakirete na Abhaarabhu, nköbhaigua törë bharagamba kubhigambo bhietö, amang'ana amanene gano Ënooköë akorrë!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagataraaha bhakanaganaga, bhakaya bharabhuurania iga, “Kana këno nkë?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhandë mbaarë kunyagia bharagamba iga, “Abhantö bhano mbareehëröë!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëng'ana ya Bhetero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Bhetero akaimöka hamui na abhatömöa bhandë ikumi na umui bhaara, agatanga gusumaacha köngamba ënene köbhantö aragamba iga, “Bhainyu abhantö bha Yutea, na bhano bhonsui mömenyërë Yerusaremu, mötantegeerra muigue mbateebhi kërë këbhaayë. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.14",
            "verseOrgIds": [
              "ACT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhano ëtarë iga mbareehëröë keebhörë muguitegeerra; ni inkio ëkërë, kugira chino ni ichinkaaga isatö. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.15",
            "verseOrgIds": [
              "ACT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene niiga gano ngano ömönaabhi Yoeri aagambërë iga,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
