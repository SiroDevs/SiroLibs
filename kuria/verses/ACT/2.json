            }
          ]
        },
        {
          "text": "Ënooköë göseemi yaae umuene wanyoorrë aahancha gukurua karai iga Yesö atööröe kömabhoko gainyu; na bhainyu mökamuita, hano mootigërë abhantö abhabhëëbhë bhakamöbhamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
