          "items": [
            {
              "text": "2 Mak 14:35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na taagutuna gëntö kërë gionsui tökaamöha gökömökorra ëmërëmo hai, kugira nëwe umuene aköhaana öbhöhoru na umuika na kërë gionsui kö örë wonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
