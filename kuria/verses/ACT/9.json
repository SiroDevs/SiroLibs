              "ACT.9.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.32"
              },
              "items": [
                {
                  "text": "2 Ko 11:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ichinsikö ichincharu chaahetërë, Abhayahuti bhakairania hamui bhagaseemia guita Sauri, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "sibhoono agateebhibhua ëseemi yaabho. Ömöbhasö na ubhutikö mbaarë kuriiha kömahita gu umugi korri iga bhamuite. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
            "verseOrgIds": [
              "ACT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhiëga bhaae bhakamuimukia ubhutikö bhakamusikirria gököhetera kurugito, bhakamusikiria arëngë gökëgabhö.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauri arëngë Yerusaremu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauri naagëëyë Yerusaremu agasaacha gösoha köbhiëga bhandë. Sibhoono bhonsui mbaamoobhöhërë gikugira tëbhaakumiri iga mmaheene nabhaayë umuëga hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
            "verseOrgIds": [
              "ACT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki Bharinabha akamuimukia akamuhira köbhatömöa. Akabhateebhia möna Sauri aarööchë Ömönene gönchëra, na guiki iga Ömönene naasumaachërë nawe. Guiki naabhateebhiri möna Sauri aarundiri köbhökarë kuriina re Yesö kumugi go Tamesike. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Sauri akabha hamui nabho na akaya Yerusaremu yonsui, ararundia köbhökarë kuriina riö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na guiki naasumaachërë agakërana na Abhayahuti bhano bhaarë kögamba Ikigiriki si mbaatunërë kumuita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhakumia bhaaiguurë amang'ana gayö, mbaahirrë Sauri Kaisaria korri iga ayi Tariso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö ëkanisa ëno yaarëngë Yutea, Gariraya na Samaria, mbaabhaayë na ömörembe. Mbaatöörröë ömooyo na Nkoro Nhoreeru, ëkahagachöa na kuiyengeria, keebhörë bhaamenyërë na ësööko kö Ömönene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ainea arahunibhua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Bhetero aarë kuinaaranaara harë honsui, naataarëëyë abhantö bhë Ënooköë bhano wanyoorrë bhaamenyërë Rita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.32",
            "verseOrgIds": [
              "ACT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho aasikaini ömöntö wöndë iga Ainea, öno wanyoorrë aaroora irisusu na kömeeka ënanai, taatörrë köbhööka kurua bhörrë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.33",
            "verseOrgIds": [
              "ACT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetero akamöteebhia iga, “Ainea, Yesö Kirisitö akuhueniri. Tabhööka waari öbhörrë bhooo.” Ho hayö igo, Ainea akabhööka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.34",
            "verseOrgIds": [
              "ACT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano wanyoorrë bhaamenyërë Rita na Saroni, hano bhaamörööchë, mbaaihönchörëëyë Ömönene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögaikörö wöndë aarëngë ho kumugi go Yobha wöndë iga Tabhita, nawe nu umuëga aarëngë. (Iriina reee gu Ikigiriki niiga Torika, na ësësöro yario niiga, “Ikimune.”) Ichinsikö chonsui naarëngë gökora bhuuya na guiki aratuurria abhataka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.36",
            "verseOrgIds": [
              "ACT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guchinsikö chiyö bheene, naaroorrë agakua. Ikihundugu keee këgaisaabhibhua këgatööröa kugisuumua kögorobha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.37",
            "verseOrgIds": [
              "ACT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobha tëhaarë harai bhökong'u kurua Rita hai, hano abhiëga bha Yobha bhaiguurë iga Bhetero Ndita arë mbaatömërë abhantö bhabhërë bhakaherra Bhetero ëng'ana iga, “Törakögeya tangöha uche weitö hano.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.38",
            "verseOrgIds": [
              "ACT.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Bhetero naaimökërë bhakageenana nabho. Hano aagëëyë akuhika, naahirröë kugisuumua këno keerë kögorobha, hayö nëho abhasino bhonsui bhaasangërë bhainaarrrë Bhetero, bharakuura na kömoorokia ibhikarënga na ichingëbho chindë chino Torika aagatumërë. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.39",
            "verseOrgIds": [
              "ACT.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetero naabharichokiri kurua kugisuumua mööra, sooki agasigama; hakurua akaihönchöra kuya gukihundugu këëra akagamba iga, “Tabhita tabhööka!” Ho hayö igo akaramukia, na hano aarööchë Bhetero, naabhöökërë agaikara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.40",
            "verseOrgIds": [
              "ACT.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetero akahika hang'i akamutuurria kuimöka. Sooki akabhërëkëra abhakumia bhonsui, hamui na abhasino bhaara, akamöhaana harë bho arëngë ömöhoru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.41",
            "verseOrgIds": [
              "ACT.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana gayö gakaranda Yobha yonsui, na abhantö abhaaru mbaakumiri Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.42",
            "verseOrgIds": [
              "ACT.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetero naaikaayë Yobha ichinsikö ichincharu kömöntö wöndë iga Simioni, umuigusi wa amahö.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.43",
            "verseOrgIds": [
              "ACT.9.43"
            ]
          }
        }
      ]
    }
  ],
