              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhaisiraeri bhaarööchë iga Abhimereki akuurë, bhagatanöra na kuringa këra möntö waae ka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
            "verseOrgIds": [
