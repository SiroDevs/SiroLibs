          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkio, ömögaikörö ööra agaacha kuhika gësaku kinyumba möno mösaacha waae aarëngë, akagöa hansë gësaku hayö na guikara ho kuhika hano iriöbha reerasërë kimui.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        }
      ]
