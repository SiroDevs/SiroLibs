            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhi ikiaro ke Manase tëbhaarugiri abhamenyi bhi imigi ge Bheti-seani na ibhichichi bhiago, Taanaki na ichimberi chagio, Tori na ibhichichi bhiago, Ibhireamu na ibhichichi bhiago, na Megito na hamui na ichimberi chagio, Abhakanaani mbaagenderreeyi kömenya ho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora hano Abhaisiraeri bhaarëngë na ichinguru tëbhaarugiri Abhakanaani si mbaabhahaayë ëmërëmo ge köhaamirribhua.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
