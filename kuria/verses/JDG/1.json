              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaamori mbaarugiri abhantö bhë ikiaro ge Tani kuya kubhikerege. Tebhaabhahaayë mueya go guucha kömenya gönsë yi iritendeera. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaamori mbaagenderreeyi kömenya kumigi gëno geerëngë kögëkerege ke Heresi, Aiyaroni na Saaribhimu. Si abhantö bhi ibhiaro bhia Manase na Ebhuraimu mbaabhaahërë Abhaamori na köbhakora bhakore ëmërëmo ge köhaamirribhua. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöbhaga göa Abhaamori ngoorëngë mööchë ya Sera, köhetera bhöheto bho Akarimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
