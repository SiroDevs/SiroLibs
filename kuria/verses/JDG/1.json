              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhë ikiaro ke Aseri tëbhaarugiri abhamenyi bhu umugi go Ako, Sitoni, Arabhu, Akisibhu, Heribha, Abheka, na Rehobhu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhë ëhamatë ya Aseri mbaamenyërë hamui na Abhakanaani abhamenyi bhë ënsë ëyö kugira tëbhaabharugiri hai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        }
