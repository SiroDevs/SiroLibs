          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhë ikiaro ya Sabhuroni tëbhaarugiri abhamenyi bhu umugi go Gituroni, gösë bhaara bhu umugi go Naharari, mbaagenderreyi kömenya nabho bharabhakoorra ëmërëmo ge köhaamirribhua.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        }
