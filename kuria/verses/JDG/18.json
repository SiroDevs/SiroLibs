              "JDG.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Mika aarööchë iga bhaamukiirri ichinguru, akaihönchöra akaringa ka; abhantö bhë ëhamatë ya Tani nabho bhakaya bhoobho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.26",
            "verseOrgIds": [
              "JDG.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.26",
            "verseOrgIds": [
              "JDG.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö bhë ëhamatë ya Tani bhakaimukia ibhintö bhiira Mika wanyoorrë aakora, bhakaimukia na umunchaama ööra aarë kumuirigania. Köhayö bhakaya guitania Raisi bhagaita gunchonge abhamenyi bhaago bhano bhaamenyërë mo kögaareeya na bhataana nganigania, bhagasambërëërra umugi göyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamenyi bhu umugi göyö tëbhaarëngë na möntö wa köbhatuuria gikugira mbaarëngë harai na umugi go Sitoni, guiki tëbhaarëngë na bhögootaini na abhantö bhandë hai. Umugi göyö ngorënge kuibhatë re Bheti-rehobhu. Abhantö bhë ëhamatë ya Tani bhakagöhagaacha bhöhëa, bhakamenya mo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakahönchöra iriina riu umugi göyö, bhakagöbhërëkëra iga Tani, gököreng'aana na iriina re guuka waabho öno aarëngë ömoona wa Isiraeri. Si umugi göyö ëkëmbere ngokabhërëkëëyöë iga Raisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhi ikiaro ge Tani bhakaimiirria ëkëhooru këëra ge köbhaacha, Yonatani, ömoona o Gerisomu, ömoona o Mösa, akabha umunchaama waabho. Abhaibhöroa bhaae guiki mbaarëngë abhanchaama bhi ikiaro ge Tani kuhika hano abhantö bhë ënsë ëyö bhaahirruë köng'aanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga yonsui ëno inyumba yë Ënooköë yaarëngë Siro hayö, abhantö ikiaro ge Tani mbaasengeeyë ëkëhooru ge köbhaacha këno Mika aakoorrë.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
      ]
    }
