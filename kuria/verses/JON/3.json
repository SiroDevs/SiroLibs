            "sid": "JON 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono guiki ëng'ana yö ÖMÖNENE ëgaachëra Yona ëre kabhërë, ëragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Taya Ninawi, kumugi ÖMÖNENE gööra, na urundi kö abhantö ëng'ana ëëra naagötömërë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona akaiguëra ÖMÖNENE na akaya Ninawi, umugi ömönene bhökong'u göno goimukiri ichinsikö isatö kuguinaara.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.3",
            "verseOrgIds": [
              "JON.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
