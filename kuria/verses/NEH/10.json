        },
        {
          "text": "Ömöntö wa mbere kögötööra ëkeera nö ömögabhana, Nehemia ömoona o Hakaria, akarobheroa na Setekia. Na bhano mbo abhanchaama bhano bhaatöörrë ëkeera:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        }
      ]
    },
