                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuitörëëyë irirago iga, këra ömooka nturaayi töraruusia iring'ënga rimui harë atatö rë ësëkeeri gukuirigania inyumba yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhino mbio ibhintö bhino töraruusi köhekaru ya gösengera: Ëmëgate ëmëhoreeru, ësataaka yi ibhiakörea, ikimuenso ke gösambërëërröa ke ruiso ronsui, ikiruusio kiu urusikö röë Ësabhato, ësögökörö ya götaachöa kui imieri, ichisögökörö chindë, ibhintö bhindë ibhihoreeru, ikimuenso ki iriraga, korri öbhögotaini köbhantö bha Isiraeri bhöbhe ho na ëmërëmo gëndë gionsui gi inyumba yë Ënooköë weitö.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö, abhantö bhonsui, abhanchaama, na Abharawi ntörakore ëgëkoobhoe korri tuyi töranyoora këra mooka iga ngësaku kë këraayi kërarenta ichinkui cha gösambërëërröa ibhimuenso guikëngë riö ÖMÖNENE, Ënooköë weitö keebhörë imigiro gërë. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Ëgt 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "34:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "Ëhë 26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Töragaini iga këra mooka ntörayi törarenta ibhiakörea ibhitongore na amakö amatongore gë ëmëtë gërë gionsui kunyumba yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ëgt 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kebhörë këragërë kumigiro iga, ömoona ömötangi wë ëgësaacha narayi araherröa abhanchaama köhekaru atööröa harë Ënooköë. Bhöyö bheene, ibhimoori ibhitangi bhia këra ëng'ombe na ibhimaano ibhitangi bhichimburi na amang'ondi bhiyi bhiratööröa harë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Ëbh 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ntöraayi töraherra abhanchaama Köhekaru öbhöse bhöno bhökonyërë öbhö öbhötongore këra mooka, na itibhaai, amaguta na amakö hagarëhagarë. Guiki ntörayi törarentera Abharawi iring'enga rei ikumi ri ibhikörea bhietö, kugira Abharawi mbo bhakuiria amang'enga gai ikumi guchimberi chaitö chonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.26"
              },
              "items": [
                {
                  "text": "Ëbh 18:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umunchaama umuibhörröa öwa Haruni, naraabhe hamui na Abharawi nkaanga bhaakuimukia iring'ënga re ikumi. Gikugira ya kuirigania ëhekaru, Abharawi mbarahire iring'ënga re ikumi rë iring'ënga re ikumi yonsui ëno irusiibhui kunyumba yë Ënooköë na guitara rë ëhekaru. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Isiraeri na abhaana bha Rawi kuhika bharuusi ibhiakörea, itibhaai na amaguta bhitööröe haara ibhintö ibhihoreeru bhiköbhëëköa, hano abhanchaama, abhariihi bha amahita na abhasiringia bhaana ibhisuumua bhiabho. Na ruiso ronsui kuhika tötanaahi inyumba yë Ënooköë weitö.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    }
