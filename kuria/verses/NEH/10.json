                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tëtorateti abhaana bhaitö bhë ëgesaacha gösë abhe ëgëkari tëbharatetöe na abhantö abhahamatë bhë ënsë ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
