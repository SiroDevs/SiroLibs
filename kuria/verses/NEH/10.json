                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tëtökaagöra gëntö kurua köbhahamatë hano ndanyoore bharasuuruusia kurusikö röë ësabhato gösë urusikö rörë ronsui röno rörëngë öröhoreeru. Tëtöraayi törarëma ëmëgöndö kömooka go muhangatë, na ichisirë chonsui nchirai chiratigua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
