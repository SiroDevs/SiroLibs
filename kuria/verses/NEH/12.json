              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö abhantö mbaaruusiri ibhimuenso köbhooru na köbha na imiiguano kugira Ënooköë naabhakorrë bhakabha na ëmëgooko ëmënene. Bhonsui hamui abhagaikörö na abhaana mbaachëngërë. Ibhiririato mbieiguuröë kurua Yerusaremu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhituho bhiö Öbhösengeri Köhekaru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö mbaahööyöë abhakuimërëërra ibhituho bhionsui bhino bhiarë kuruusibhua köhekaru, hamui na iring'ënga re ikumi na öbhötongore na amakö amatobhu. Abhantö bhayö mbo bhaaragëröë iga bhayi bharaiiria ibhintö bhiyö bhionsui kurua kömarëma gaabho na kumigi gikugira ya kuirigania Abharawi na abhanchaama keebhörë këragërë kumigiro. Abhantö bhonsui bha Yuta mbaatëgëribhöe na abhanchaama na Abharawi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikugira yu ukuirigania koobho gösengero yë ësabhuuro, na ögösengera köndë hagarëhagarë köno Ënooköë arë gutuna. Abhasiringia na abhariihi bhë ëhekaru ninyoora mbo mbairigaini ëmërëmo gëëbho keebhörë Ömögambi Tauti na ömoona waae Suremani bhaaragërë gëkoröe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömötangati wa amasiringia ho aarëngë gukurua gönkaaga yö Ömögambi Tauti na ömötemi wë ëmëbhari Asabhu, na amasiringiö gagötoonia na köhaana umukumo harë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gönkaaga ya Serubhabheri na Nehemia, abhantö bhonsui bha Abhaisiraeri mbaarë kuruusia ibhituho bhia gutuurria abhasiringia na abhariihi bha amahita. Gökera hayö Abhaisiraeri mbaarë kuruusia ibhituho bhiabho kö Abharawi, na Abharawi mbaarëkoohöra iring'enga ria abhanchaama.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
    }
