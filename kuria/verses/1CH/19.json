{
  "id": "1CH.19",
  "number": "19",
  "bookId": "1CH",
  "reference": "1 Amang'Ana Gi Ichinkaaga 19",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
