{
  "id": "1CH.8",
  "number": "8",
  "bookId": "1CH",
  "reference": "1 Amang'Ana Gi Ichinkaaga 8",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1CH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruibhöro ro Bhenchamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenchamini naarëngë na abhaana bhataano: Bhera ömötangi waae, Asibheri, Ahara, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noha öwa kanai, na Rabha mökogoti waae.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhera nawe naarëngë na abhaana: Atari, Gera, Abhihuti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.3",
            "verseOrgIds": [
              "1CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhisua, Naamani, Ahoa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.4",
            "verseOrgIds": [
              "1CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gera, Subhamu na Huramu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.5",
            "verseOrgIds": [
              "1CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo uruibhöro ro Ehuti. Bhano mbaarëngë abhatangati bhi ichika cha bhaara bhanyoorre bhaamenyërë Gebha, sibhoono bhakaimukibhua kuya köng'aanyi Manahaati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6",
            "verseOrgIds": [
              "1CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani, Ahiya na Gera. Gera, isawaabho Usa na Ahihuti, nëwe abhatangatërëë gökora ke bhöyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.7",
            "verseOrgIds": [
              "1CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saharaimu akahatërana na bhakaae bhabhërë, Husimu na Bhaara. Hakurua akanyoora abhaana bhë ëgësaacha hano aarëngë gönsë ya Moabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.8",
            "verseOrgIds": [
              "1CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatetërë Hotesi, öno amuibhörëyë abhaana muhungatë: Yoabhu, Sibhia, Mesa, Marakamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.9",
            "verseOrgIds": [
              "1CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeusi, Sakia, na Mirima. Abhaana bhaae bhano bhonsui mbaabhaayë abhanene bhi ichika chaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.10",
            "verseOrgIds": [
              "1CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saharaimu na mökaae Husimu mbaanyoorrë abhaana bhandë bhabhërë: Abhitubhu na Eribhaari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.11",
            "verseOrgIds": [
              "1CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Eribhaari mbaarëngë bhatatö: Ebheri, Misamu na Semeti öno ahagachërë imigi ge Ono na Roti, hamui ni ichimberi chino chigiinaarrë.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhabhenchamini bhano bhaamenyërë Gati na Aiyaroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheria na Sema mbaarëngë guchika chiira waanyoore chimenyëre kumugi go Aiyaroni, na kurugia abhamenyi isimisi bha Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ahio, Sasaki, Yeremoti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.14",
            "verseOrgIds": [
              "1CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebhatia, Arati, Eteri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.15",
            "verseOrgIds": [
              "1CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaeri, Isibha, na Yoha nu uruibhöro rööndë ro Bheria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.16",
            "verseOrgIds": [
              "1CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebhatia, Mesurramu, Hasiki, Hebheri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.17",
            "verseOrgIds": [
              "1CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinerai, Isria na Yobhabhu nu uruibhöro ro Ebhaari bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.18",
            "verseOrgIds": [
              "1CH.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakimu, Sikiri, Sabhuti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.19",
            "verseOrgIds": [
              "1CH.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erienai, Siretai, Erieri ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.20",
            "verseOrgIds": [
              "1CH.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataya, Bheraya na Simurati nu uruibhöro ro Simei bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.21",
            "verseOrgIds": [
              "1CH.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isbhani, Ebheri, Erieri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.22",
            "verseOrgIds": [
              "1CH.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhutoni, Sikiri, Hanani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.23",
            "verseOrgIds": [
              "1CH.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanania, Eramu, Antotiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.24",
            "verseOrgIds": [
              "1CH.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhuteya na Bhenueri nu uruibhöro ro Sasaki bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.25",
            "verseOrgIds": [
              "1CH.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samserai, Seharia, Ataria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.26",
            "verseOrgIds": [
              "1CH.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaresia, Eria na Sikiri ni iring'ënga rë uruibhöro ro Yerohamu bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbo bhaarëngë abhanene bhi ibhisaku bhiabho köreng'aana na uruibhöro roobho. Mbaare abhanene na Yerusaremu bhaamenyërë.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhabhenchamini bhano bhamenyërë Gibheoni na Yerusaremu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeieri, öno aarëngë umusimuri wu umugi go Gibheoni. Mökaae niiga Maaka akabhërëkëyöë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhutoni nö ömötangi waae aarëngë. Abhaana bhaae abhandë mbaarë Suri, Kisi, Bhaari, Natabhu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.30",
            "verseOrgIds": [
              "1CH.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Getori, Ahio, Sekaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.31",
            "verseOrgIds": [
              "1CH.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mikroti isawaabho Simea. Bhano nabho mbamenyërë Yerusaremu hang'i na abhantö bhandë bhë ëgësaku keebho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëka yö Ömögambi Sauri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri akaibhöra Kisi, Kisi akaibhöra Sauri. Sauri naarëngë na abhaana bhanai: Yonatani, Markisua, Abhinatabhu na Esibhaari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani akaibhöra Meribhaari, na Meribhaari akabhöra Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika naarëngë na abhaana bhanai: Bhitoni, Mereki, Terea na Ahasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi akaibhöra Yehoata. Yehoata nawe akaibhöra Aremeti, Asmaweti na Simri. Simri akaibhöra Mösa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akaibhöra Bhinea, öno aibhööyë Rabha, öno aibhööyë Ereasa, Ereasa nawe akaibhöra Aseri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Aseri mbasansabha bhaarëngë, amariina gaabho ngano iga; Asirikamu, Bhokeru, Isimaeri, Searia, Obhatia, na Hanani. Bhonsui bhano na bhaana bha Aseri bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhaana bha Eseki, mura omoobho Aseri, mbaarëngë bhatatö. Ömötangi waae Uramu aarëngë, ömögatai waae Yeusi, na Eribhërëti ömökogoti waae. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Uramu mbaarëngë abhantö abhakarë bhökong'u bhi iriihi, na abharasi bhi imigui ibhihubheebhe. Naarënge na abhaana na abhachökörö abhaaru, bhonsui igo irigana na mërongo ëtaano (150). Bhayö bhonsui bhatarröë hayö na abhë ikiaro ke Bhenchamini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
    }
