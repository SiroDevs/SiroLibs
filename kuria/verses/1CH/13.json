    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisandëko ri Imuuma rëraruusibhua Kiriati-yearimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti mbaasumaachërë na abhakönaare bha amacheesi gi ibhiköë na abha amacheesi ga amagana, hamui na abhatangati bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki agateebhia Abhaisiraeri bhonsui bhano wanyoorrë bhairaini iga, “Hano mögaitabhirrania nani, na hano ndanyoore ni irituno riö ÖMÖNENE, Ënooköë weitö, niiga törakore: Tötöme abhantö bhayi köbhërëkëra bhaana bhatamërë gönsë ya Isiraeri, hamui na abhanchaama na Abharawi bhano bharëngë kumigi geebho na guchimberi chaabho, bhaache töbhe hamui. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki tuyi kuimukia Irisandëko ri Imuuma yë Ënooköë weitö, kugira tëtöndörrëëyöë nario ënkaaga yö öbhöbhaahi bhö ömögambi Sauri.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui mbaitabhërraini në ëng'ana ëyö kugira mbaaröchë iga në ëng'ana inchiiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1"
              },
              "items": [
                {
                  "text": "1 Sam 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhöyö mbe, Tauti akairania Abhaisiraeri bhonsui gönsë; kurua kögëtabhöka ge Sihori këno kërëngë Misiri, kuhika kubhisohero bhia Hamati korri bharënte Irisandëko ri Imuuma yë Ënooköë kurua Kiriati-yearimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Ëgt 25:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tauti na Abhaisiraeri bhonsui bhakaya kumugi go Bhaara, nko ökögamba iga Kiriati-yearimu, kömöndaara go Yuta, korri bharente Irisandëko ri Imuuma yë Ënooköë kurua ho rëno rëköbhërëkëröa kuriina riö ÖMÖNENE öno aikaayë kugitumbë kiu ubhukumahe igörö yi ibhiteemoa bhino bhiina amabhabha, bhino bhiköbhërëkëroa iga amakerubhi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, bhakaimukia Irisandëko ri Imuuma yë Ënooköë kurua kunyumba ya Abhinatabhu kuigaari irihëa. Usa na Ahio mbo bhaarë kögendia irigaari rëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti na Abhaisiraeri bhonsui mbaarë göchënga guchinguru chaabho chonsui mbere yë Ënooköë. Mbaarë körentia bharatema amatungu, ibhinande, ibhichegeriö, amatoasi na ibhirëmbëëta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaahikërë gökëhöörro ke Gitoni, Usa akarambëka ököbhoko kogooterra Irisandëko ri Imuuma kugira ichintang'ana chiira nchaituurrëtuurrë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho hayö igo ÖMÖNENE akarërëërra Usa gökögoota irisandëko, igo, akamuita. Usa agakuëra ho bheene mbere yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akabha nö öbhörrö kugira ÖMÖNENE aitërë Usa; igo, ahasë hayö hakabhërëkëröa iga Bheresi-usa ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:11",
              "type": "text"
            },
            {
              "text": "Bheresi-usa:",
              "type": "text"
            },
            {
              "text": "Ësësoro yaho niiga “Iribhörööta re Usa”",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuhika reero. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Mak 7:19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö Tauti akoobhoha Ënooköë na kögania iga, “Bhoono kana niyekë ndaarente Irisandëko ri Imuuma waane ka?” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Tauti taahirrë irisandëko ka kumugi go Tauti hai,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:13",
              "type": "text"
            },
            {
              "text": "Umugi go Tauti:",
              "type": "text"
            },
            {
              "text": "Nko kögamba iga Yerusaremu",
              "type": "text"
            }
          ]
        },
        {
          "text": " sibhoono akarihira o Obheti-etomu Umugiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.4"
              },
              "items": [
                {
                  "text": "1 Ich 26:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Irisandëko rëyö rë Ënooköë rëkabheera o Obheti-etomu kumieri ëtatö, ÖMÖNENE nawe agaitabhiria umugi go Obheti-etomu na ibhintö bhiae bhionsui.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    }
  ],
