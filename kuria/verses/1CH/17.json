              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono wei ÖMÖNENE, uwe nuwe Ënooköë, öndagaini ömökoramërëmo waao ëng'ana inchiiya ëno; ",
          "type": "text",
          "attrs": {
