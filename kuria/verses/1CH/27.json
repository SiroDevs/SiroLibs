                {
                  "text": "2 Sam 24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.1+1CH.21.2+1CH.21.3+1CH.21.4+1CH.21.5+1CH.21.6+1CH.21.7+1CH.21.8+1CH.21.9+1CH.21.10+1CH.21.11+1CH.21.12+1CH.21.13+1CH.21.14"
              },
              "items": [
                {
                  "text": "1 Ich 21:1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yoabhu ömoona o Seruya naatangërë köbhabhara sibhoono taasokiri hai; guiki iribhörööta ndenyoorrë Isiraeri gikugira yë ëng'ana ëyö, ëbharo ëyö nayo tiyasohibhui köhetöko yö Ömögambi Tauti hai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhaimiriirri bhi ibhintö biö öbhögambi",
          "type": "text"
        }
      ]
    },
