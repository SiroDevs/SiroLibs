                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömögambi Tauti taabharrë bhaara bhaarëngë hansë yë ëmeeka mërongo ëbhërë kugira ÖMÖNENE naragaini kuengeria Abhaisiraeri köbha abhaaru gi ichinyunyuunyi cha igörö kuriöbha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
