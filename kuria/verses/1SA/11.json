        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauri arakëra Abhaamoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Nahasi ömögambi wa Abhaamoni akaya akanaaria umugi go Yabhesi-gireati. Abhamenyi bhu umugi göyö bhakamöteebhia iga “Kora amaitabhërranio na bhaitö, na bhaitö ntöragökorre ëmërëmo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.1",
            "verseOrgIds": [
              "1SA.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Nahasi Ömöamoni akabhateebhia iga, “Nëndaitabhëërrani na bhainyu ndanyoore muitabhiirria mbabhochori bhonsui amaiso ga bhörëo korri nsukiirri Abhaisiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.2",
            "verseOrgIds": [
              "1SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhatangati bha Yabhesi bhakamöteebhia iga, “Töha umueya gui ichinsikö muhungatë tötöme abhantö bhainaare ënsë yonsui ya Isiraeri. Hano ndanyoore ömöntö wa gututuuria ataaho, tuihaane abhiene harë uwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.3",
            "verseOrgIds": [
              "1SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhatömöa bhaara bhahikërë Gibhea hano Sauri amenyërë, bhakögamba amang'ana gaara kömatui ga abhantö; Abhantö bhonsui bhakaahuria gukuura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.4",
            "verseOrgIds": [
              "1SA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora Sauri ararua mögöndö na ichintang'ana chaae; nawe akabhuuria iga, “Nkë këbhaayë, abhantö bharakuura?” Bhakamöteebhia amang'ana ga abhantö bha Yabhesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.5",
            "verseOrgIds": [
              "1SA.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Sauri aiguure amang'ana gaara, Ënkoro yë Ënooköë yamösëkërrëëyë na kumuhiukirria öbhörrö öbhönene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.6",
            "verseOrgIds": [
              "1SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaimukia ichintang'ana cha körëmëra, agachikengakenga amang'ënga agatöma abhantö bhakainaara ënsë yonsui ya Isiraeri bharagamba iga, “Ömöntö örë wonsui öno ataarichoke kuya kuiihi hamui na Sauri na Samueri nkeehayö ichintang'ana chaae chirakoroe!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.7",
            "verseOrgIds": [
              "1SA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhoobha bhö ÖMÖNENE bhökagoota abhantö, bhakarichoka bhonsui kubhumui. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.7",
            "verseOrgIds": [
              "1SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Sauri abhaitaahërë göntahana ya Bheseki nkanyoora mbarëngë abhantö ibhiköë amagana atatö (300,000) kurua Isiraeri, na abhantö ibhiköë mërongo ëtatö (30,000) kurua Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.8",
            "verseOrgIds": [
              "1SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagateebhia abhantö bhaara wanyoorrë bhatömëröë kurua Yabhesi, iga, “Kaya möteebhi abhantö bha Yabhesi-gireati iga, Icho gönkaaga yö ömöbhasö ömörro möraache möbhöhoribhui.” Hano abhatömöa bhaara bhaachërë bhagöteebhia abhantö bha Yabhesi amang'ana gaara, mbagookërë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.9",
            "verseOrgIds": [
              "1SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, abhantö bha Yebhesi, bhagachaarra Nahasi bharamöteebhia iga, “Icho ntörachetuihaane harë uwe ötökore bhörë ugutuna.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.10",
            "verseOrgIds": [
              "1SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icho yaho inkio Sauri agatööra abhantö kömakomo atatö, bhagasëkëërra gataigatai yi irisanchö, na götogooya Abhaamoni kuhika ömöbhasö, bhano bhaatamërë ichintirruki mbaanyereganibhui, abhantö bhabhërë bhanga götama hamui.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.11",
            "verseOrgIds": [
              "1SA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho abhantö bhaabhuurri Samueri iga, “Mbaabhö ng'ui bhaara bhaagambërë iga, ‘Bhoono Sauri nagatögambëra?’ Tabharenta hano töbhaite.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.12",
            "verseOrgIds": [
              "1SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Sauri akagamba iga, “Tëmöntö örë wonsui araitöe reero hai, kugira ÖMÖNENE aarentërë öbhöbhohoria Isiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.13",
            "verseOrgIds": [
              "1SA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Samueri agateebhia abhantö iga, “Taachö tögende Girigari turundi guiki iga Sauri nö ömögambi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.14",
            "verseOrgIds": [
              "1SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo abhantö bhonsui bhakaya Girigari, bhagatööra Sauri köbha ömögambi mbere yë Ënooköë Girigari haara. Bhakaruusia ikimuenso kiö ömörembe mbere yö ÖMÖNENE, Sauri hamui na abhantö bhonsui bha Isiraeri bhagachënga bhökong'u.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.15",
            "verseOrgIds": [
              "1SA.11.15"
            ]
          }
        }
      ]
    }
  ],
