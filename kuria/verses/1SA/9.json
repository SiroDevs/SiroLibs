              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaasëkëyë kurua kunguku bhaguucha kumugi, Sauri akaarribhua öbhörrë kögorobha këgörö akaraara.",
          "type": "text",
          "attrs": {
