              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira uni hang'i ndë nduusibhöe ikimuenso, ënkaaga yaane ya götanöra yaahikërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.6",
            "verseOrgIds": [
              "2TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitana iriihi iriiya, naakënya nasookia, guiki naariiha ubhukumia bhoone. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.7",
            "verseOrgIds": [
              "2TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhoono ëmandaara yö öbhöröngë nkönganya ërë, ëmandaara ëno Ömönene öno arëngë ömökengi wi ibhiina ömöheene arëntöörra kurusikö rööra, na guiki tiiga nu uni bheene hai gëtatiga nhamui na bhaara bhonsui bhaköganya uguucha kooe köbhöhanchi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        }
      ]
    },
