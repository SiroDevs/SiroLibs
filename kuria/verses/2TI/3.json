              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.8+ACT.14.9+ACT.14.10+ACT.14.11+ACT.14.12+ACT.14.13+ACT.14.14+ACT.14.15+ACT.14.16+ACT.14.17+ACT.14.18+ACT.14.19+ACT.14.20"
              },
              "items": [
                {
                  "text": "Ama 14:8-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ukuiriiribhua koone na inyaanyi yaane. Gayö ngaanyoorrë nkaaga naarë Antiokia, Ikonio na Risitira, nnaagumirriiyi imiiriiro ëmënene, sibhoono Ömönene naantuurri kurua kömang'ana gayö gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheene bhonsui bhano bhagutuna kömenya kubhusuuki bhöë Ënooköë harë Kirisitö Yesö, kuhika mbarairiiribhue; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ënkaaga ëyö abhantö abhanyanku na abharongo mbarëgenderria köbha abhabhëëbhë, bharang'aina abhandë nabho bhonsui bharang'ainöa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono uwe genderria kömang'ana gonsui gano wëga na kögakumia kimuikimui. Nömanyërë bhano bhaarëngë abhaigia bhaao, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na guiki nkohëëtöka örë iga gukurua köbhoona bhooo wamanya Amandëko Amahoreeru gano garatöre gököha ëseemi ëno ërakuhiki kubhuituuria gököhetera kubhukumia harë Kirisitö Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amandëko gonsui ngandëkëröë köbhörongoochi bhöë Ënooköë na ngaisaini gukuigia abhantö, kögötakia, ukurungihia amang'ana amabhëëbhë na gököragirria abhantö igörö yi irimenya iriröngë, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri iga ömöntö wë Ënooköë abhe ömöhëkëëranu na aseemibhua atöre gökora këra irikora rëno rërëngë iriiya.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
      ]
    }
