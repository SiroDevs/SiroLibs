    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umusirikare ömöheene wa Yesö Kirisitö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe moona waane öbhe na ichinguru gököhetera gosaramita ëno ërëngë harë Kirisitö Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.1",
            "verseOrgIds": [
              "2TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imukia amaigiö gano waiguurë kurua harë uni mbere ya abhaherekia abhaaru, sooki ögahaane köbhantö abhaheene, bhano bharatöre kuigia abhandë.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiga ösange imiiriiro ku umusirikare umuuya öwa Kirisitö Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.3",
            "verseOrgIds": [
              "2TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusirikare nkaaga arëngë kömërëmo tagösoherra amang'ana gandë gano gataitungaini na ubhusirikare hai, gikugira ngutuna arë iga ategeri ömönene waae. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.4",
            "verseOrgIds": [
              "2TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukinyi öno arëngë kömëhöörö tagaatöra gökëra ahaabhöe igituho, ëtarë iga nyoore naiguërëëyë amarago gë ëmëhöörö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.5",
            "verseOrgIds": [
              "2TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umurimi öno akora ëmërëmo imirito nëwe kisaini iga anyoore irigesa re mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witegeerre igörö ya gayö ngusumaacha, gikugira Ömönene naragutuurri ögasësöre gonsui.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hëëtöka Yesö Kirisitö, öno aariukiibhui kurua köbhaku, nawe naarëngë uruibhöro ro Tauti, kuguitung'ana na Igichiratë këno nkurundia. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira yi Igichiratë këyö nairiiribhöe na köbhohöa na ibhirang'ani ki irinyamörro, sibhoono ëng'ana yë Ënooköë tiyaabhohöa na ibhiraang'ani hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö nkugumirria ndë gonsui gikugira ya abhaahöroa, korri iga nabho bhonsui bhanyoore ubhuituuria bhöno bhörëngë harë Kirisitö Yesö na bhoorenta ubhuhiku bho kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëkërengio këno në ëkëheene:",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömökoramërëmo öno aitabhirribhua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukia abhantö bhaao na öbhataki mbere yë Ënooköë iga bhange köhamanëra amang'ana. Tëgaana ng'ana gagutuurria hai gëtatiga gösaria bhaara bhakögategeerra. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökore ömökëa kuiyorokia umuene iga waitabhirribhua na Ënooköë, ömökoramërëmo öno ataana kibhune ge kumusuukirria, ono akuigia bhöröngë ëng'ana yö öbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wibhechi isumaacho ëno ëtaisaini na iyö öbhötöhö kugira ngökora ërë abhantö bhanga gösööka Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaigiö gaabho ngaranyegane ki iritamuëga rëno rëkörëa ömöbhërë. Abhamui bha abhantö bhayö mbaabho Himenayo na Bhireto. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
            "verseOrgIds": [
              "2TI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbano bhaisa kurua gönchëra yö öbhöheene na bhoono nguchinchikania bharë ubhukumia bhöa abhakumia abhamui gökögamba iga ukuriööka goitö goisa köbha karai. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.18",
            "verseOrgIds": [
              "2TI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Ëbh 16:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono öbhörösa öbhökong'u bhöno Ënooköë aatööra tëbhögasingisibhua hai, na köbhörösa köyö ngandëkëröë iga, “Ömönene namanyërë bhano bharëngë abhaae” na “Örë wonsui akögamba iga nö öwö Ömönene, niiga ahaatëre ubhunyaanku.” ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyumba ënene tiiga iga ni ibhintö bhino bhikoreeyöë ësahaabu na amatiini gi ichimbiria bheene bhiimo hai, si guiki mbiimo ibhië ëmëtë na iritagito, na ibhimui köbhökori bhöë ësööko na ibhindë köbhökori bho ruiso ronsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.20",
            "verseOrgIds": [
              "2TI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö hano öranyoore ömöntö naisaabhuura umuene kurua kömang'ana amanyanku gayö, naraabhe ëgëntö kiö öbhököri bhöë ësööko, öno asaabhuurua na öno aisaini kömërëmo giö Ömönene, na guiki öno aseemibhua gökora këra mörëmo göno görëngë umuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wibhechi ubhuigombi bhö öbhoonabhöke, ökore amang'ana göbhöröngë, ubhukumia, öbhöhanchi, ömörembe, hamui na bhaara bhagösabha Ömönene kömooyo ömörabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2TI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhechia ichinkaani chö öbhökangi na öbhötöhö; nömanyërë iga gayö nkörenta garë öbhöhotokani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2TI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömökoramërëmo wö Ömönene kuhika ange köbha na iribhëëha. Niiga abhe ömöhaabhu köbhantö bhonsui, abhe umuigia umuuya guiki umugumirria, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.24",
            "verseOrgIds": [
              "2TI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2TI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "öno agötakia köbhöhaabu, bhaara bhagökërana nawe kugira nkaanyoora Ënooköë akaabhaha umueya go kuihönchöra korri bhamanyë öbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.25",
            "verseOrgIds": [
              "2TI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2TI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho bharasësöre, bhaibhechi ömöhana gui Irisambo, rëno wanyoora rebhagootia, bhararëkorra keebhörë rigutuna.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.26",
            "verseOrgIds": [
              "2TI.2.26"
            ]
          }
        }
      ]
    }
  ],
