        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.6",
            "verseOrgIds": [
              "DAN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
