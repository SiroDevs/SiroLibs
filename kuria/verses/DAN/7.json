                  "text": "Öbhö 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nkëëmaahëërra, örötëra röyö rögaitana iriihi na abhahoreeru, na rökabhahicha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.21",
            "verseOrgIds": [
              "DAN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.4"
              },
              "items": [
                {
                  "text": "Öbhö 20:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono ‘Ömögaaka ööra wa karai ëyö’ akaimöka, agakengera ikiina abhahoreeru bhë Ënooköë Umuhikërë köbhöheene na hano ënkaaga yaahëkëëraini, abhahoreeru bhayö bhakahaabhöa öbhögambi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.22",
            "verseOrgIds": [
              "DAN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agansësöörra iga: ‘Itinyi ya kanai nö öbhögambi bho kanai bhöno bhörëbha ho gökëbhara, nabho tibhurituubhana na amagambi gandë, mbörëraröra ëkëbhara ikigima, na gukiguisia hansë na kögëkora ibhing'ënga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.23",
            "verseOrgIds": [
              "DAN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.12"
              },
              "items": [
                {
                  "text": "Öbhö 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igörö yi ichintëra ikumi, kurua kö öbhögambi bhöyö abhagambi ikumi mbaririchokera, Mbaarërobheroa na ömögambi wöndë; öno arëbha bhöndë na bhaara bhaamötangatërë, na aguisi abhagambi bhatatö bhaara. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.24",
            "verseOrgIds": [
              "DAN.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "Öbhö 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5"
              },
              "items": [
                {
                  "text": "13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naarëchuaria Ënooköë Umukumahe na kunyankia abhahoreeru bhaae. Naarësaacha köhönchöra ichinkaaga na imigiro geebho, na abhahoreeru mbarëtööroa kömabhoko gaae kömeeka ëtatö na iritënë. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.25",
            "verseOrgIds": [
              "DAN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ëgooti nëraikare ikiina; na öbhögambi bhooe, bhuimukibhui na gusikibhua kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.26",
            "verseOrgIds": [
              "DAN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.4"
              },
              "items": [
                {
                  "text": "Öbhö 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "Öbhö 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Öbhögambi na öbhögambiri na öbhönene bhöa amagambi gonsui hansë ya kuriöbha mbörahabhöe abhantö abhahoreeru bhë Ënooköë Umukumahe; öbhögambi bhoobho mböraabhe ho kuya ëyö na ëyö, na öbhögambiri bhonsui mbörabhakoorrë ëmërëmo na köbhasööka.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        }
      ]
    },
