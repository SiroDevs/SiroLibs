                }
              ]
            }
          ]
        },
        {
          "text": "“Gönkaaga ya amamaaho gayö ubhutikö, nkamaaha umui öno anga ömoona wö ömöntö araacha kömasaaro kurua kuriöbha, akagëëra Ömögaaka ööra wa karai ëyö, bhakamörenta mbere yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
