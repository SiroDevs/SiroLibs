        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amamaaho gano narööchë uni Tanieri ngaanyibhambukiri, nani ngaitumata. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.15",
            "verseOrgIds": [
              "DAN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkagëëra umui wa bhaara wanyoorrë bhaimëërëëyë haara na kumubhuuria iga ansësöörre amang'ana gayö gonsui. Nawe aganteebhia ësësöro yaago iga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.16",
            "verseOrgIds": [
              "DAN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Ichitinyi chiyo inyai ichinene na abhagambi bhanai bhano bharaabhe ho gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.17",
            "verseOrgIds": [
              "DAN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.5"
              },
              "items": [
                {
                  "text": "Öbhö 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono abhahoreeru bhë Ënooköë Umuhikërë mbaarëhaabhöa öbhögambi bhameri kuya ëyö na ëyö.’",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
