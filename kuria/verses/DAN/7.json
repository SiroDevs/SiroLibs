            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gököreng'ana na amang'ana gu ubhuikumburi gano gaarë kögamböa na örötëra rööra. Nkëëmaahëërra, itinyi ëëra ya kanai ëgaitoa, ömöbhërë gooyo gögasaribhöa na köhaanöa iga gösamboe kömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichitinyi chindë chiira chikaruusibhua ögötöra goocho, si cho ichiene chigatigöa chigendeerri köbha ho gönkaaga nke igo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
