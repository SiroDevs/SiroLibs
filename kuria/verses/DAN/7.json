              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua ngatuna kömanya ësësöro yi itinyi ëëra ya kanai, ëno yaarëngë yi ituubho ëhagarë na ichindë, iya kuruguuria na koobhohia bhökong'u, ëno amaino gaayo gaarë agi ikiöma na ichinkömö chaayö chi iriche, ëno yaarë köraröra na kubhunabhuna, na götachatacha amatigiö. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.19",
            "verseOrgIds": [
              "DAN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ngatuna manye ësësöro yi ichintëra ikumi chiira yaarëngë nacho kömötöe gooyo, na örötëra rumui rööra roorë kömera, na gökora ichintëra isatö kögöa; örötëra röno roorë na amaiso na umunyua göno goorë kögamba amang'ana gi ikiiheemo, na röno romaahëkaini köbha örönene gökëra ichindë chonsui.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.20",
            "verseOrgIds": [
              "DAN.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
