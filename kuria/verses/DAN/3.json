    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebhugatinesa araruusia ëngamba iga këra möntö asengere ëkëhooru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Nebhugatinesa agakora ëkëhooru gë ësahaabhu, këno këëna öbhötambë bhui ichimiita mërongo ëbhërë na muhungatë na öbhögarë bhui ichimiita isatö. Agakiimiirria kuihancha re Tura, kömöndaara go Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi Nebhugatinesa akaruusia ëngamba iga abhanangua, abhaimiriirri, abhagabhana, abharagiirria, abhabhiiki bhë ëmongo, abhakengabhiina, abhakengabhiina abhanene na abhatuurria bhonsui bhë ëmëndaara bhaache kunyangi yö ögötööra ëkëhooru këno ömögambi Nebhugatinesa aaimiiriiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, abhanangua, abhaimiriirri, abhagabhana bhë ëmëndaara, abharagiirria, abhabhiiki bhë ëmongo, abhakengabhiina, abhakengabhiina abhanene na abhatuurria bhonsui bhë ëmëndaara bhakairania kögötööroa göë ëkëhooru këno ömögambi Nebhugatinesa aaimiiriiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömörandia akarundia köngamba ënene, “Bhainyu abhantö bhi ibhiaro bhionsui, ichihamatë chonsui na ibhigambo bhionsui, ëngamba ichërë iga ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano muigua ëngamba yi irirongöë, ibhirongöë, iritungu, ëkëgoogo, ibhinande, igikuru na ibhintö bhindë bhë ëmëbhari, kuhika muhigame hansë na gösengera ëkëhooru këyö gë ësahaabhu këno ömögambi Nebhugatinesa aimiiriiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na örë wonsui öno ataahigame na gösengera ëkëhooru nararekeroe kuibheri riö ömörrrö ömönene.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, abhantö bhi ichihamatë chonsui, na ibhigambo bhionsui, niigo bhaiguurë ëngamba yi irirongöë, ibhirongöë, iritungu, ëkëgoogo, ibhinande, igikuru na ibhintö bhindë bhë ëmëbhari, bhakahigama na gösengera ëkëhooru këëra gë ësahaabhu këno keimiirriibhui na ömögambi Nebhugatinesa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhasaani bha Tanieri bharachöngëröa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö Abhagaritayo nyabhörebhe, köbhörëërëëma bhagachöngëra Abhayahuti. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagateebhia ömögambi Nebhugatinesa iga, “Mögambi öbhe ho kuya ëyö! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mögambi, waaruusiri ëngamba iga ömöntö örë wonsui hano aigua ëngamba yi irirongöë, ibhirongöë, iritungu, ëkëgoogo, ibhinande, igikuru na ibhintö bhindë bhë ëmëbhari ahigama hansë na gösengera ëkëhooru keera gë ësahaabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na iga öre wonsui öno ataahigame hansë na gösengera ëkëhooru këyö arekeroe kuibheri riö ömörro ömörrrö. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, bhaaho Abhayahuti nyabhörebhe bhano waatööra kömaahëërra amang'ana gö öbhögambi kömöndaara go Bhabheri, nabho Nsataraka, Mesaki na Abhetinego; mögambi abhantö bhano, tëbhasöökërë ëngamba yaao hai. Tëbhagösengera ichinooköë chaao na gösengera ëkëhooru gë ësahaabhu këëra weimiirria hai.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho ömögambi Nebhugatinesa aichööyë öbhörrö akaruusia ëngamba iga Sataraka, Mesaki na Abhetinego bhahiroe mbere yaae. Nabho bhakarëntoa mbere yö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Nebhugatinesa akabhabhuuria iga, “Sataraka, Mesaki na Abhetinego maheene iga tëmököhigamëra ichinooköë chaane gösë gösengera ëkëhooru gë ësahaabhu këno naimiirria? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, hano möraache muigue guiki ëngamba yi irirongöë, ibhirongöë, iritungu, ëkëgoogo, ibhinande, igikuru na ibhintö bhindë bhë ëmëbhari möbha hang'i kuhigama hansë na gösengera ëkëhooru këno naakora? Niigo mörange gökora igo, mörekeroe kuibheri riö ömörro ömörrrö. Gösë, në ënooköë kë agatöra köbhatuuria kurua kömabhoko gaane?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sataraka, Mesaki na Abhetinego bhakahunchukiria ömögambi iga, “Nebhugatinesa, bhaitö titugutuna iga tukuhunchukiri köng'ana ëyö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mögambi, Ënooköë weitö öno tögösengera naratutuuri kurua kuibheri riö ömörro ömörrrö; na guiki naratutuuri kurua kömabhoko gaao. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
            "verseOrgIds": [
              "DAN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mögambi, ninyoora gëtabhaayë igo, ömanye iga bhaitö tëtörakoorre ëmërëmo ichinooköë chaao gösë gösengera ëkëhooru gë ësahaabhu këno waimiirria hai.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhasaani bha Tanieri bharakengeroa ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö ömögambi Nebhugatinesa akarëërra bhökong'u, ëgësösa keee gëkaihönchöra kugira yö öbhörrö harë Sataraka, Mesaki na Abhetinego. Akaruusia ëngamba iga ömörro guengeribhöe kuibheri harë muhungatë köhëtëëra ëkërengere keego. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaruusia ëngamba kö abhantö nyabhörebhe guicheesi reee bhano bhaana ichinguru bhabhohe Sataraka, Mesaki na Abhetinego na köbharekera kuibheri rëëra riö ömörro ömörrrö. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, abhahentani bhayö bhakabhohoa bhasuarrë ichisöröbhare chaabho, ibhikarenga bhiabho, ichingosiira na ichingëbho chaabho chindë, bhakarekeroa gataigatai yi iribheri rëëra riö ömörro ömörrrö. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
            "verseOrgIds": [
              "DAN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ëngamba yö ömögambi në ëndörö yaarë, ömörro gööra ngonyoorrë göhembeeyöë gööbhaayë ömörrrö bhoköng'u, ubhuibhanchi bhö ömörro bhögasikia bhaara bhahiirrë Sataraka, Mesaki na Abhetinego kuibheri. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.22",
            "verseOrgIds": [
              "DAN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ira 1:1-68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhahentani bhatatö bhayö Sataraka, Mesaki na Abhetinego, bhakagöa gatagatai yi iribheri rëëra riö ömörro ömörrrö bhabhohërë.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        }
      ]
