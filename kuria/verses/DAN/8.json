        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni Tanieri, nkagërëka na köroora göchinkaaga. Hano naahuenërë, nkagëndeerria na ëmërëmo giö ömögambi. Si amamaaho gaara nganduguurri, na tëgamanyëröë hai.”",
          "type": "text",
