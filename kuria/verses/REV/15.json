                  "text": "Ëgt 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaarë gusiringia irisiringio re Mösa ömökoramërëmo wë Ënooköë hamui na irisingio rë Ëkëmaano ki Iring'ondi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
