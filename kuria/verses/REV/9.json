      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika wa gataano akagambia ëkërëmbëëta keee, nkamaaha inyunyuunyi ëno wanyoorrë ëgööyë gökëbhara kurua kuriöbha. Nayo ëkahaabhoa örösöngörö ru ubhuina bhöno ibhihui bhigösëëkërroa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.28"
              },
              "items": [
                {
                  "text": "Ögt 19:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano inyunyuunyi ëëra yaigööyë ubhuina bho Bhuku, iriooki ri iribheri irinene ndeeruurë mo. Iriöbha na igörö bhigasunta gikugira ya iriooki rëëra re Bhuku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.12+EXO.10.13+EXO.10.14+EXO.10.15"
              },
              "items": [
                {
                  "text": "Ëgt 10:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Öbh 16:9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichingigë chikarua kuriooki mööra chigaacha gökëbhara, chikahaabhoa ichinguru chi ibhitoromoni bhino bhirëngë gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ese 9:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chigateebhibhua iga chitagaasaria amanyanki gë ëkëbhara gösë ibhiakörea gösë ninyoora nö ömötë görë gonsui; gëtatiga abhantö bhaara bheene bhataana öröbhaaso röë Ënooköë kömahanya ga amasiö gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.4",
            "verseOrgIds": [
              "REV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichingigë chiyö tichaitabhirriibhui guita abhantö hai gëtatiga köbhairiiria kumieri ëtaano. Öbhörrö bhöno bhaaiguurë bhonga öbhörrö bhöno ömöntö akuigua hano arömöa në ëgëtoromoni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.5",
            "verseOrgIds": [
              "REV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.21"
              },
              "items": [
                {
                  "text": "Ayb 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.3"
              },
              "items": [
                {
                  "text": "Yer 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kumieri ëtaano gëyö abhantö mbaririgia uruku, si tëbharërunyoora hai; mbarituna uruku, sibhoono ndörëbhang'osa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.4"
              },
              "items": [
                {
                  "text": "Yoe 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ichingigë chiyö, nchaarëngë gi ichibharaasi chino chaaseemibhua guitana. Nchaarëngë na ichiköndö changa ichië ësahaabhu kömëtöe geecho, na amasiö gaacho ganga aga abhantö gaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.6"
              },
              "items": [
                {
                  "text": "Yoe 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ituukia yaacho yaarëngë kiiya abhagaikörö, na amaino gaacho ngaarëngë kia agi indui. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.5"
              },
              "items": [
                {
                  "text": "Yoe 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibhikubha bhiacho wanyoorrë mbikundikiiyi ëgëntö kenga ingubha yi ikiöma. Na ëngamba ya amabhabha gaacho yaarë kë ëngamba ya amagari gi ichibharaasi ichincharu chino chikuya kuiihi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchaarëngë na ëmëkëra na amahöa ki ibhitoromoni, na ëmëkëra gëyö ngeerë ni ichinguru cha kunyahaara abhantö kumieri ëtaano. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki nchiina ömögambi öno aguchigambëra nawe nëwe wa Bhuku; iriina reee gu Ikiebhurania niiga Abhatoni na gu Ikigiriki niiga Abhorioni ësësöro yario niiga ömösaria. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëhöbhë ya mbere ëhetërë; tamaaha nyuma ya gayö ëhöbhë ya kabhërë na iya gatatö nguucha chirë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.1+EXO.30.2+EXO.30.3"
              },
              "items": [
                {
                  "text": "Ëgt 30:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ömömaraika wa gasansabha akagambia ëkërëmbëëta keee. Nkaigua ëngamba imui ërarua guchintëra inyai chi irikëngë rë ësahaabhu rëno rërëngë mbere yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
            "verseOrgIds": [
              "REV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëngamba ëyö ëgateebhia ömömaraika ööra wa gasansabha öno aarëngë na ëkërëmbëëta iga, “Tahaatëra abhamaraika bhanai bhano bhabhohërë kömooro ömönene go Yubhurati!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamaraika bhanai bhayö bhakahaatëroa, nabho wanyoorrë bhaseemibhui gönkaaga ëyö, na urusikö röyö na umueri göyö na ömooka göyö bheene, guita iring'ënga rimui ria abhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaigua iga ëkërëngere kia abhasirikare bhi ichibharaasi nkerëngë ibhigata amagana abhërë (200,000,000.) ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Öbh 11:17,18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöno mbo naarööchë ichibharaasi chiyö na abhagendia bhaacho kuimaaaho rëyö: Mbaarëngë na ichingubha kubhikubha bhiabho chino chaarëngë ömörro uguene, chino chaarëngë bhurru, mayaayi kia amatiini gi ikibhiriti. Ëmëtöe gi ichibharaasi chiyö ngeerë ki igi ichindui na ömörro na iriooki bhikarua kuminyua geecho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.17",
            "verseOrgIds": [
              "REV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iring'ënga irimui ria abhantö rëgaitöa na ichihöbhë isatö chiyö, nko kögamba iga; ömörro, iriooki na amatiini gi ikibhiriti, nchino chaarë kurua kuminyua geecho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.18",
            "verseOrgIds": [
              "REV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ichinguru chi ichibharaasi chiyö nkömëkëra na kuminyua geecho chaarëngë. Ëmëkëra geecho gëno chaarë kunyahaarra abhantö genga ichinchoka geerëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.19",
            "verseOrgIds": [
              "REV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.4+PSA.115.5+PSA.115.6+PSA.115.7"
              },
              "items": [
                {
                  "text": "Sab 115:4-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.135.15+PSA.135.16+PSA.135.17"
              },
              "items": [
                {
                  "text": "135:15-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.23"
              },
              "items": [
                {
                  "text": "Tan 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhantö bhandë bhano bhaatamërë bhataitëröë na ëhöbhë ëyö, tëbhaihönchööyë kurua kubhintö bhino bhaarë gökora na amabhoko gaabho abhiene hai; gösë köhaatëra gösengera ibhihui, ibhihooru bhië ësahaabhu, iriche, amatiini gi ichimbiria, amagëna na ëmëtë; ibhintö bhino bhitakömaaha, kuigua, gösë kögenda. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki tëbhaihönchööyë kurua kubhuiti, öbhörogi, öbhöraaya na ubhuibhi hai.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.21",
            "verseOrgIds": [
              "REV.9.21"
            ]
          }
        }
      ]
    }
  ],
