                  "text": "Ruk 21:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha, na nkaaga Ëkëmaano ki Iring'ondi keerë kuigora ömöbhaaso go gasansabha, ikirigiti ëkënene gëkarigita, iriöbha rëkabha irimuamu ki irigoneera ria amachoki, umueri gonsui gökabherreta kia amaanyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ichinyunyuunyi cha kuriöbha chikagöa gökëbhara kehaara amakö ga mabheho gano gatarakong'a gakögöa nkaaga ömötë googo gösingisibhua nö ömökama umurito. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Öbhö 16:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igörö hakarua ho kehaara ëkarataasi ikuringuaringua; ichinguku chonsui na ibhisima bhikaruusibhua ho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.19"
              },
              "items": [
                {
                  "text": "Isa 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua abhagambi bhë ëkëbhara, abhanene, abhakönaare, abhaamë, monyanguru, këra mögöre na öno atarë ömögöre, bhakaibhisa guchimbaata na hansë yi ichintare guchinguku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.10.8"
              },
              "items": [
                {
                  "text": "Hos 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.30"
              },
              "items": [
                {
                  "text": "Ruk 23:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhagateebhia ichinguku na amarëngo gayö iga, “Tatuguëra mutubhise kurua harai kööra aikaayë kugitumbë kiu ubhukumahe na kurua kubhusinanku bhöë Ëkëmaano ki Iring'ondi! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.16",
            "verseOrgIds": [
              "REV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.11"
              },
              "items": [
                {
                  "text": "Yoe 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.2"
              },
              "items": [
                {
                  "text": "Mari 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira urusikö urunuhe ru ubhusinanku bhoobho ruhikërë. Ning'ui akarörëbhërra?”",
