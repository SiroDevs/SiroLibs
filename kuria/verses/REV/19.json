              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ëngamba ëkarua kugitumbë kiu ubhukumahe ëragamba iga, “Mögönge Ënooköë weitö bhainyu abhakoramërëmo bhaae bhonsui, bhonsui bhano mökömösööka, abhake köbhanene.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
