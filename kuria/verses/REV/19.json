            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoe 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Öbhö 14:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inchonge inyögë ërarua kumunyua gooe na gunchonge ëyö narahiche ichihamatë. Nëwe bheene arabhagambëre kunyimbo yi ikiöma na kumita itibhaai kurua gökëmëtëro kiu ubhusinanku bhöë Ënooköë Umukumahe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këgörö yë ënganchö yaae na igörö yë ëkënama keee wanyoorrë andëkëröë iga, “Ömögambi wa abhagambi na Ömönene wa abhanene.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
