              "items": [
                {
                  "text": "97:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.99.1"
              },
              "items": [
                {
                  "text": "99:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hakurua nkaigua ëgëntö këno këëna umurrumo gönga ugu ubhuiko bhöa abhantö abhaaru na ugua amanchë amaaru, göno gönga umurrumo umurito gui ibhibhagatiö, këragamba iga, “Hareruya! Kugira Ömönene weitö, Ënooköë Umukumahe nkögambëra arë! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tötagooka na guchënga, tömötogi kugira ënkaaga inyangi yë Ëkëmaano ki Iring'ondi ihikërë, na ömörekari waae aiseemiri kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaayöë ögötöra kogusuara ëhanga inyëke, ëno yaahurua na kömenenekia!” (Ëhanga inyëke ëyö na amakora amaröngë ga abhantö bhë Ënooköë).",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
