            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra nkaaga ibhiteemoa bhinai bhiyö hano bhiaarë götogia, na gösööka, na kuruusia umukumo harë öyö aikaayë kugitumbë kiu ubhukumahe, öno aaho kuya ëyö na ëyö, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhagaaka mërongo ëbhërë na bhanai bhaara nkuhigama bharë mbere ya öyö aikaayë kugitumbë kiu ubhukumahe na gösengera öyö aho kuya ëyö na ëyö; bhatööra ichiköndö chaabho mbere ya igitumbë kiu ubhukumahe bharagamba iga:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
