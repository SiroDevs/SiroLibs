              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano gayö gaasirrë, nkamaaha ëgësaku kigööyöë kuriöbha. Na ëngamba ëëra naiguurë ëkëmbëre ëno yaarë kë ëngamba yë ëkërëmbëëta, ikagamba iga, “Taacha igörö hano, nani nëndakooroki amang'ana gano gararichokere nyuma ya gano.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Ese 1:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
