                "loc": "EZK.10.1"
              },
              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ho hayö igo ngaichuribhua na Nkoro. Nkamaaha igitumbë kiu ubhukumahe kërëngë kuriöbha na ömöntö aikaayë ko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na öno wanyöörrë aikaayë kö naarëngë ke yasibhi na agiki, na igitumbë këyö wanyoorrë kiinaarröë na umukubhia nnyöngö göno goorë na ërangë ëno yanga sumariti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora ibhitumbë bhindë mërongo ëbhërë na bhinai mbinaarrë igitumbë këëra kiu ubhukumahe na abhagaaka mërongo ëbhërë na bhanai wanyoorrë mbaikaayë kubhitumbe bhiyö bhasuarrë ichingëbho ichindabhu, na nkanyoora bhatöörrë ichiköndö chë ësahaabhu kömëtöe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
