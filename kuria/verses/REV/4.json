                "loc": "ISA.6.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibhiteemoa bhinai bhiyö mbiaarë na amabhabha asansabha, na këra kimui wanyoorrë ngiichööyë amaiso mönsë na këbhara. Na mbiaarë gusiringia bhitakumuunya:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
