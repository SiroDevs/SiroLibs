                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "11:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua itiinyi ëyö ëkahaabhöa umueya go kuiheema na köno kootökërë Ënooköë; ëkahaabhöa umueya go köbha na ögötöra kumieri mërongo ënai na ëbhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëgatanga götöka Ënooköë na iriina reee, na amaikaro gaae, hamui na bhonsui bhano bhamenyërë kuriöbha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Tan 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agaitabhirribhua guitania abhantö bhë Ënooköë na köbhakëra. Ëkahaabhöa ögötöra igörö ya abhantö bha këra kiaro, ëgësaku, ibhigambo, na ëhamatë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Sab 69:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano bhamenyërë gökëbhara mbarëmösengera, gëtatiga bhaara bheene amariina gaabho gaandëkëröë kögëtabhö kiö öbhöhoru bhöë Ëkëmaano ki Iring'ondi öno aasinchëröë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno ana amatui aigue.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha itiinyi yëndë ërarua kuirobha, ëna ichintëra ibhërë gi ichi iring'ondi ëgësumaacha ki irichöka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo yaarë na ögötöra ökönene kurua gutiinyi ëëra ya mbere, kögötöra köyö ëkahaamirria ëkëbhara gionsui na bhano bhamenyërë mo, gösengera itiinyi ëëra ya mbere, ëno yaarëngë ni iriseechöa riu uruku rëno wanyoorrë reehuena. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, itiinyi ëyö ya kabhërë ëgakora ibhirögööro ibhinene, ëkërengere ke gusikiria ömörro kurua kuriöbha guucha gökëbhara mbere ya abhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëkahotora abhantö bhe ëkëbhara kubhirögööro bhiyö yaasakiribhöë gökora mbere yi itiinyi ëëra ya mbere. Ëgateebhia abhantö bhano bhamenyërë gökëbhara iga bhakore ëkëhooru gikugira ya ësööko yi itiinyi ëëra wanyoorrë yaaseechöa na inchonge sibhoono ëkahona. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.14",
            "verseOrgIds": [
              "REV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ëgaitabhirribhua köhöötëra umuika gö öbhöhoru ëkëhooru këëra gi itiinyi ëëra ya mbere, kuhika ëgasumaacha na guita abhantö bhonsui bhano bhataagësengeeyë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itiinyi ëyö ëkahamirria abhantö bhonsui abhake na abhanene, abhaamë na abhataka, abhagöre na bhano bhatarë abhagöre, bhabhaasoe ëmëbhaaso kömabhoko gaabho ga bhörëo gösë kömahanya ga amasiö gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korri iga möntö örë wonsui atakaagöra gösë kuguria gëntö gëtatiga ööra bheene ana öröbhaso röyö, nko kögamba iga iriina ri itiinyi ëëra gösë ichinamba chiö öröbhaaso röyö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano, kuhika ömöntö abhe na öbhöng'aini! Nëho ömöng'aini aröngöre ësësöro yi ichinamba chi itiinyi ëyö, kugira në ësësöro ya ömöntö nyabhabhörebhe. Ichinamba chiyö na amagana asansabha na mërongo ësansabha na isansabha (666).",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.18",
            "verseOrgIds": [
              "REV.13.18"
            ]
          }
        }
      ]
    }
