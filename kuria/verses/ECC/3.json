      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Këra gëntö na ënkaaga yaakio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra gëntö nkëëna ënkaaga yaakio, këra ng'ana hansë yi iriöbha nëëna ënkaaga yaayo:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mbuëra kë ömökoramërëmo anabho? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë ëmërëmo imirito gëno Ënooköë aha abhaana bha abhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë akora këra gëntö köbha ikiiya gönkaaga yaakio. Aaha ömoona wö ömöntö inyonta ya kömanya amang'ana gano gaaguucha, sibhoono taamöha umueya go kömanya amang'ana gë Ënooköë gukurua kögötanga na gösokeerria. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë iga, kömontö në ëng'ana ëmui bheene ëno imuisaini; gökögooka na gökora gaara garagërë nkaaga amenyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni igituho kë Ënooköë iga bhonsui töre, tunyue na gökora ëmëgooko kö gaara tokoorra ëmërëmo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë iga kërë gionsui Ënooköë agökora në ëgekuya ëyö. Tëkëndë gëkengeribhua ko gösë kuruusibhua ko hai; ikibhune ke gökora igo niiga abhantö bhabhe na ubhususeenu harë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këno gëköbha reero, nyoora keebha karai; këno këraache këbhe nyoora keebha karai; na Ënooköë ngökora arë ëgëntö këëra bheene gëkorekane ruiso ronsui.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ököbhöra öbhöheene gökëbhara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igörö ya gayö, naaröchë hansë yi iriöbha iga, harë öbhöheene bhörëngë na ësëëra inchiiya nëho ësëra yö öbhöbhëëbhë ikuiyimukiirria bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaiteebhia iga, “Nkanya Ënooköë naarëkengera ikiina abhaiya na abhabhëëbhë, gikugira aatööra ënkaaga inuhe harë këra ng'ana na harë këra mörëmo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasokëeerria kuibhöörra iga, Ënooköë ngösaacha arë abhaana bha abhantö korri abhorooki iga mbamui na ichitinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ögösokeerria ko abhaana bha abhantö na ugui ichitinyi nkumui kööra bheene. Ke bhööra ömöntö agukua nkeho bheene itinyi igukua. Bhonsui ököhechera koobho nkumui; ömoona wö ömöntö töwakehaiya gökëra itinyi hai. Harë bho gonsui gayö mbuchua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.19",
            "verseOrgIds": [
              "ECC.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhionsui ömöntö na itinyi ngukua bhirë bhigenda ahasë hamui. Bhionsui nkömarobha bhikurua; na bhionsui nkömarobha bhikuringa kuya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
            "verseOrgIds": [
              "ECC.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ui amanyërë köbhöheene iga hano ömöntö akua ënkoro yaae nkuya ërë kuriöbha na iyi itinyi nkömarobha ikuya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.21",
            "verseOrgIds": [
              "ECC.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo nëho naamanyërë iga tëng'ana ërë yonsui ërëngë inchiiya bhökong'u kö ömoona wö ömöntö köhëtëëra ögökora ëmëgooko kömërëmo gee, kugira niigo Ënooköë amöng'oreeyë. Ning'ui akariukia ömöntö ache kömaaha gaara gaköbha nyuma yu uruku rooe?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.22",
            "verseOrgIds": [
              "ECC.3.22"
            ]
          }
        }
      ]
    }
  ],
