            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amang'ana gu Umurundia, ömoona o Tauti, öno aarëngë ömögambi wa Yerusaremu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gano umurundia aarööchë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni Umurundia, naarëngë ömögambi wa Abhaisiraeri kumugi go Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nairuusiri kuguisuncha na kuëëga gano gonsui garëngë gökëbhara këno, na kögöngöra köbhöng'aini. Ëyö ni isina ënene ëno Ënooköë ahaayë abhantö.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamaaha gonsui gano gagökoroa hansë yë iriöbha; gonsui mbuchua: Kehaara ököhanga öbhökama!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:14",
              "type": "text"
            },
            {
              "text": "Gösë ökörëa ömökama (Hos 12:1)",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
