            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.29+1KI.4.30+1KI.4.31"
              },
              "items": [
                {
                  "text": "1 Gam 4:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Sir 47:14-18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ngaitegeerra nkaibhuuria iga, “Nanyoora öbhöng'aini öbhönene gökëra bhonsui bhano bhaatangatërë Yerusaremu ntaraabha ömötangati. Igo, naaköngööröka köbhöng'aini na ubhunguri.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakoorrë ömökëa go köngöra öbhökërakërani bhö öbhöng'aini, ubhuchuuru na öbhökangi. Sibhoono mbe nöngööyë iga kögökora igo ngutubhanaini na ököhanga ömökama.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
