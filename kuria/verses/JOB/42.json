            }
          ]
        },
        {
          "text": "Hakurua Ayubhu akahunchukiria ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögösookerria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE hano aasookiri gusumaacha na Ayubhu, naateebhiri Eribhasi, Ömötemani iga, “Ubhusinanku bhoone bhöbhaayë ho kuguisiira na bhasaani bhaao bhabhërë, kugira tëmögambërë öbhöheene igörö yaane kehaara ömökoramërëmo waane Ayubhu akorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö muimuki ichigaini muhungatë na ichiguruki muhungatë, muyi kömökoramërëmo waane Ayubhu, mumuense ikimuenso ke gösambërëërröa gikugira yeinyu. Ömökoramërëmo waane Ayubhu nawe narabhasabhëre, nani nëndaigue amasabhi gaae na gukubhia köbhakorra bhöbhëëbhë köreng'aana na öbhökangi bhueinyu; kugira tëmögambërë öbhöheene igörö yaane kehaara ömökoramërëmo waane Ayubhu agambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono Eribhasi Ömötemani, Bhiritati Umusua na Sobhari Ömönaamati, bhagakora keebhörë ÖMÖNENE aabhateebhiri, ÖMÖNENE akaigua amasabhi ga Ayubhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
