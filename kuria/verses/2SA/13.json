              "items": [
                {
                  "text": "2 Sam 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si Abhusaromu naang'oseyë Tarimai ömoona o Amihuti, ömögambi wu mugi go Gesuri. Ömögambi Tauti akang'uunyëra ömoona waae Amunoni guchinsikö ichincharu ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu naang'oseyë kumugi go Gesuri, akamenya ho ëmeeka ëtatö. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Tauti atëndërë gikugira ya uruku ro Amunoni naigombërë kömaaha ömoona waae Abhusaromu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
