{
  "id": "2SA.1",
  "number": "1",
  "bookId": "2SA",
  "reference": "2 Samueri 1",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2SA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tauti aröngöra igörö yu uruku ro Sauri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Sauri aisërë gukua, Tauti naringërë kurua guita Abhaamareki, akabheera Sikiragi ichinsikö ibhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro gatatö ömöntö akarua guisanchö re Sauri aana ichingëbho chino wanyoorrë chitandööyöë kugira ya amaachiichi aana amarobha kömötöe, akagëëra Tauti. Hano ahikërë harë Tauti naahigamërë kuhika hansë kubhusuuki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.2",
            "verseOrgIds": [
              "2SA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akamubhuuria iga, “Nëhai ukurua?” Nawe akamuhunchukiria iga, “Nköröhari röa Abhaisiraeri ng'osërë kurua.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.3",
            "verseOrgIds": [
              "2SA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akamubhuuria iga, “Nteebhia këbhörë amang'ana gaabhaayë ho?” Nawe akamuhunchukiria iga, “Abhantö bhang'osërë kurua kuiihi, na abhaaru bhaabho bhaitëröë, ninyoora Nsauri na ömoona waae Yonatani bhakuurë.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.4",
            "verseOrgIds": [
              "2SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Tauti akabhuuria ömöhentani ööra iga, “Yekë ökorre ömanyërë iga Sauri na ömoona waae Yonatani bhakuurë?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.5",
            "verseOrgIds": [
              "2SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.1+1SA.31.2+1SA.31.3+1SA.31.4+1SA.31.5+1SA.31.6"
              },
              "items": [
                {
                  "text": "1 Sam 31:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.1+1CH.10.2+1CH.10.3+1CH.10.4+1CH.10.5+1CH.10.6"
              },
              "items": [
                {
                  "text": "1 Ich 10:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömöhentani ööra akamuhuunchukiria iga, “Kuiyega nëmbaayë kunguku ya Giribhoa ndööchë Sauri aitöngërë guitimö reee; na amatoka ga abhagendia-bharaasi ga abhabhisa gamöhëgërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.6",
            "verseOrgIds": [
              "2SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe hano aamagiri nyuma aköömaaha naambërëkëëyë. Hano naitabhërë, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.7",
            "verseOrgIds": [
              "2SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akambuuria iga, nuwe ng'ui? Nani nkamuhunchukiria iga, nö Mömareki ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.8",
            "verseOrgIds": [
              "2SA.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe aganteebhia iga, ‘Tahika hang'i önsooki; kugira nseechëröë bhöbhëëbhë na nëna öbhörrö öbhönene. Si nköhechera nkërë.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.9",
            "verseOrgIds": [
              "2SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö nhikërë hang'i mmösookiri, kugira naarë na öbhöheene iga hano araagöe hansë, taraabhe ho guiki hai. Sooki; nimukiri ëköndö ëno yaarë kömötöe na akagubha kano kaarë gököbhoko kooe mbirentërë harë uwe Ömönene waane.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.10",
            "verseOrgIds": [
              "2SA.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti na abhantö bhaara bharë hamui nawe bhagatandrra ichingëbho chaabho kömaachiichi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.11",
            "verseOrgIds": [
              "2SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakang'uunya na gukuura na guisasa kuhika ömögorobha gikugira ya Sauri, Yonatani umumura waae, na abhantö bhë nsë ya Abhaisiraeri, na abhantö bhö ÖMÖNENE, kugira abhaaru bhaabho mbaitëröë kuiihi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.12",
            "verseOrgIds": [
              "2SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akabhuuria ömöhentani ööra amörenteeyë amang'ana gaara, iga, “Nöwahai örë?” Nawe akamuhunchukiria iga, “Nö ömoona wö ömöhamatë ndë, Ömömareki si nëmenyërë gönsë yaao kibhuitongo” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akamubhuuria iga, “Nkë kigirree wangërë koobhoha körambëka ököbhoko guita ömöhaköa maguta wö ÖMÖNENE?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Tauti akabhërëkëra umui wa abhamura bhaae na kömöteebhia iga, “Taita ömöntö önö!” Nawe akamötema na kumuita. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akamöteebhia iga, “Tiga amaanyinga gaao gabhe igörö yaao; kugira nu umuene wiragankërë, gökögamba iga, ‘Niitërë ömöhaköa maguta wö ÖMÖNENE.’”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tauti arang'unyëra Sauri na Yonatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akang'uunyëra Sauri na umumura waae Yonatani aragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.17",
            "verseOrgIds": [
              "2SA.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.13"
              },
              "items": [
                {
                  "text": "Yos 10:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "abhantö bha Yuta bhaigibhöe ökong'uunya köno; nako nkondëëkëröë kögëtabhö ke Yasari. Agasiringia aragamba iga:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.18",
            "verseOrgIds": [
              "2SA.1.18"
            ]
          }
        }
      ]
    }
  ],
