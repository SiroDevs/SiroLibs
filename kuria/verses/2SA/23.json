          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sama, Ömöharari; Ahiamu ömoona wa Sarari, Ömöharari; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
            ]
          }
        },
        {
