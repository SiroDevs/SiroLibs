          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eribhereti ömoona wa Ahasibhai, Ömömaaka; Eriamu ömoona wa Ahitobheri, Ömögironi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesiro, Ömökarimeri; Bharai, Ömwaribhi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.35",
            "verseOrgIds": [
              "2SA.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igari, ömoona wa Natani Ömösobha; Bhani, Ömögati; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.36",
            "verseOrgIds": [
              "2SA.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sereki, Umöamoni; Naharai, Ömöbheeroti; öno aarëngë umuimukia bhiögë wa Yoabhu ömoona wa Seruya; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira na Garebhu, Abhaitiri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.38",
            "verseOrgIds": [
              "2SA.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
