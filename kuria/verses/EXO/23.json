            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhe harai na amachöngëro gö öbhörongo, na ötagaacha guita bhano bhataana isoro na abharöngë, kugira uni tënkaabhëra ömöntö umunyanku hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötagaacha kuimukia amasooya, kugira amasooya nkuhukuria garë abhanene na köhërëngëtëra bhano bharëngë köbhoheene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
