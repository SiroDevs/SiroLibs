                }
              ]
            }
          ]
        },
        {
          "text": "“Ötagaacha körandia uruambai. Ötagaacha kögootana na ömontö gukuruusia ëherekiö ëmbëëbhë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötagaacha götaarania na ëgëkomo kia abhantö abhanyanku, gösë kögootana na ëgëkomo kia abhantö kuya kuruusia ëherekiö yö öbhörongo kogooti korri iga möhotore öbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Abhar 19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ötagaacha köhërëngëtëra ömötaka gukiina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
