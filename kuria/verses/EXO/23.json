              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano wanyoora ëntang'ana gösë ëtëkërë yu umubhisa waao ëno isirrë, ugimuringiria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wamaaha ëtëkërë yö ömöntö öno aköregërë ëgööyë na ömösairë goyo, utuurria ömöntö öyö kubhukiirria ëtëkërë yaae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
