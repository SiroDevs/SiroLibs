              "type": "text"
            }
          ]
        },
        {
          "text": "“Kömeeka ësansabha ubhusura ëmëgöndö geeo, na kögesa irigesa reegio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono kömooka go muhungatë utiga gimuunya, wanga kögesa kërë gionsui kurua ko, korri abhataka bha abhantö bhainyu bhanyoore ibhiakörea bhino bhiatama mo. Ökora bhöyö bheene ninyoora nkömëgöndö geeo gë ëmësabhibhu na ëmëseituni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
