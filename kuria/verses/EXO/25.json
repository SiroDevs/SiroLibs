    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichisataaka chi iritume irihoreeru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia Abhaisiraeri bhaköhe ësataaka kuibhaga reene. Wimuki ësataaka kurua kömöntö örë wonsui akuruusia kömooyo ömötachöre. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ëno niyo ësataaka ëno öraimuki: Ësahaabhu, amatiini gi ichimbiria na iriche, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.3",
            "verseOrgIds": [
              "EXO.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "isuubhi ëno ibhurru na iyi iriini na ëmberretu na ehanga inyeke inchiiya ëno ërökëëyöë ubhuchooki bhui imburi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.4",
            "verseOrgIds": [
              "EXO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "amachooki gi iring'ondi gano gahakërë ërange ëmberretu, ibhiseero bhi ichimburi, ichimbaara chë ëngongachuma, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.5",
            "verseOrgIds": [
              "EXO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaguta ga ëtara, ubhurumbaasi bhua amaguta ga köhaka, na gikugira yö öbhöbhaani bhui isiisui inchiiya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.6",
            "verseOrgIds": [
              "EXO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "amagëna gi iriguri hamui na agandë gikugira ya guchaarria ëkëmaao kiu umunchaama na ikiguchi ki igikubha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.7",
            "verseOrgIds": [
              "EXO.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki Abhaisiraeri bhankorre iritume irihoreeru, korri mmenye harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.8",
            "verseOrgIds": [
              "EXO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökore iritume rëyö na ibhintö bhiario köreng'aana na bhörë ndakooroki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisandëko ri Imuuma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abhaisiraeri mbarakore irisandëko ri ichimbaara chë ëngongachuma rëno rërëngë ichisentimita igana rimui na ikumi (110) öbhötambë, ichisentimita mërongo ësansabha na isansabha öbhögarë, na ichisentimita mërongo ësansabha na isansabha öbhötambe kuya igörö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömëgëre irisandëko rëyö ësahaabhu isikö na mönsë, na kuinaaria umurigi gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua örëkorre ibhigera bhinai bhë ësahaabhu na kubhitööra kömagörö gaario anai, këra kögörö ëkëgera kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örëkorre ëmëgooto gë ëngongachuma na kögëmëgëra ësahaabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öhetiri ëmëgooto gëyö kubhigera bhino bhirëngë ichintahana ibhërë chi irisandëko, gikugira ya kuriimukiria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëmëgooto gëyö gëbheere kubhigera bhiyo, gëtagaacha kuruusibhua mo röndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötööre mönsë yi irisandëko rëyö ichimbaara ibhërë cha amagëna gë ëherekiö chino ndaköhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.5"
              },
              "items": [
                {
                  "text": "Ibr 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua ökore igitumbë kia amaabhë kurua gö ësahaabhu inyëke, këno kërëngë ichisentimita irigana rimui na ikumi (110) öbhötambë, na ichisentimita mërongo ësansabha öbhögarë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ökore amakerubhi gë ësahaabhu abhërë, ögatemerre guchimbarëka chi igitumbë kia amaabhë gataachëërrane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.18",
            "verseOrgIds": [
              "EXO.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötööre irikerubhi rimui masërra gö öröbhabhare rumui na irikerubhi rëndë masërra gö öröbhabhare ro kabhërë; ögootani amakerubhi gayö hamui na igitumbë këyö kia amaabhë mbarëëno na mbarëëno masëërra gi ichimbabhare chakio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.19",
            "verseOrgIds": [
              "EXO.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakerubhi gayö gatachëërrane, na köramböra amabhabha gaago garambööyë kuhëkëëra igitumbë kia amaabhë; na amasiö gaago gataachëërre igitumbë këyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötööre ichimbaara ibhërë cha amagëna mönsë yi irisandëko, na guikaria igitumbë kia amaabhë këgörö yaario. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni nëndasikane na uwe ho; na gukurua këgörö ya igitumbë këyö kia amaabhë gataigatai ya amakerubhi gayö garëngë këgörö yi irisandëko rë ëherekiö, nsumaache na uwe na gököha amarago gonsui gikugira ya Abhaisiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëmeesa yë ëmëgaate gë ësataaka yë Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ökore ëmeesa yi ichimbaara chë ëngongachuma ëno ërëngë ichisentimita mërongo ënaanai na inyaanyai öbhötambë, ichisentimita mërongo ënai na inyai öbhögarë na ichisentimita mërongo ësansabha na isansabha öbhötambë kuya igörö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömëgëre ëmeesa ëyö ësahaabhu inchiiya na kugiinaaria umurigi guë ësahaabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ögëkorre umurigi göë ësahaabhu göno rörëngë ichisentimita mërongo muhungatë na isaanö öbhögarë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökore ibhigera bhinai bhë ësahaabhu ubhitööre guchikoona inyai cha amagörö gaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhigera bhiyö bhibhe hang'i na öröbhaara rööra ruinaarrë ëmeesa, korri rögooterre ëmëgooto ge kugiimukiria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.27",
            "verseOrgIds": [
              "EXO.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökore ëmëgooto gë ëngongachuma ögëmëgëre ësahaabhu; nagio ngëraabhe ëge kuimukiria ëmeesa ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.28",
            "verseOrgIds": [
              "EXO.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökore ichisahaani na ibhikombe bhia götööra öbhöbhaani kömeesa, iribhakuri hamui na ibhiriga ya köhömëra ësataaka yi itibhaai. Ibhintö bhiyö bhionsui bhibhe ibhië ësahaabhu inchiiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.29",
            "verseOrgIds": [
              "EXO.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8"
              },
              "items": [
                {
                  "text": "Abhar 24:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ötööre ëmeesa ëyö mbere yi irisandëko ri imuuma, na guikaria kö ëmëgaate ëmëhoreeru gëëra ge götööra mbere yaane nkaaga chonsui.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëgëtagacha gë ëtara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ökore ëgëtagacha gë ëtara gë ësahaabhu inchiiya. Ubhuikarro bhöë ëgëtagacha këyö na umutihaachë gookiö bhigootane, na bhöyö bheene ibhikombe bhiakio, ibhitubha bhiakio, na amaua gabhio, bhionsui bhiyö bhiturue kurua kögëntö kimui gë ësahaabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichinsagia isansabha chitörre ichintahana ibhërë chu umutihaachë göyö, ichinsagia isatö chë ëgëtagacha gë ëtara chibhe ëntahana imui na ichinsagia isatö chë ëgëtagacha gë ëtara chindë ëntahana yëndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra örösagia guchinsagia isansabha röbhe na amaua atatö gano gachaaribhue ki ibhisekere bhiö ömötë gö ömörosi; na ibhikombe bhitatö bhino bhikorröë kugituubhaniö ki ibhisekere bhiö ömötë gö ömörosi, këra ikimui na igitubha geekio na iriua reekio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kögëtagacha këyö gë ëtara, ibhikombe bhinai bhino bhinga ibhisekere bhiö ömörosi bhibhe ko, hamui na ibhikombe bhino bhinga amakö gaago. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hansë ya haara ichinsonga chi ichintagara isansabha chiira chigötörra kurua kögëtagacha gë ëtara, habhe na iriköndëko rimui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaköndëko gayö na chintagara bhigootane na ëgëtagacha këyö, na bhionsui bhibhe ibhië ësahaabhu inchiiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ökore ichitara muhungatë gikugira yë ëgëtagacha këyö, uchiikari këgörö yakio chimörëke kuya mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ökore ichihööma na ichisahaani kurua gö ësahaabhu inyëke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökore ëgëtagacha këyö hamui na ibhintö bhiakio bhionsui kurua guchikiiro mërongo ëtatö na isaano chë ësahaabhu inchiiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.44"
              },
              "items": [
                {
                  "text": "Ama 7:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.8.5"
              },
              "items": [
                {
                  "text": "Ibr 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömaahe iga ubhikorrë kugituubhaniö këëra woorokibhui kunguku haara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
