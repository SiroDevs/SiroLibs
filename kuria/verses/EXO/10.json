              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Mösa akamöteebhia iga, “Kuhika utuitabhirri tuimuki ichitugo chi ibhimuenso na ikimuenso ke gösambërëërröa korri turuusiri ÖMÖNENE, Ënooköë weitö ikimuenso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhika tuimuki iching'ombe chaitö, tëgëkereete ninyoora nkimui këratigare hai, kugira harë cho töraruusi itugo ya kumuensa kö ÖMÖNENE Ënooköë weitö, gikugira tëtömanyërë ntugo kë töramuense kö ÖMÖNENE gëtarë iga tuhikërë ho.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        }
      ]
    },
    {
