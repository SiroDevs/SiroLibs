          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, Bharao akabhërëkëra Mösa, akamöteebhia iga, “Taimukia ninyoora na abhaana bhainyu muyi gösengera ÖMÖNENE. Si mutige amang'ondi geinyu, ichimburi cheinyu na iching'ombe cheinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
