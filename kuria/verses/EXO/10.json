        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Mösa iga, “Tagëëra Bharao kugira mmökorrë abhaayë na ömötöe ömökong'u, we hamui na abhakoramërëmo bhaae korri iga nkore ibhimanyiirriö harë bho, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri muuche könabhëra abhaana bhainyu na abhachökörö bhainyu möna naakorrë Abhamisiri kögökora ibhimanyiirriö bhino harë bho korri mömanye iga uni nu uni ÖMÖNENE.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Mösa na Haruni bhakagëëra Bharao bhakamöteebhia iga, “ÖMÖNENE, Ënooköë wa Abhaebhurania arabhuuria iga, ‘Kuhika rööhai uritiga konga gususeena mbere yaane? Tahaatëra abhantö bhaane bhayi gönsengera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoorrë wangërë köhaatëra abhantö bhaane bhayi, icho nëndaache ndente ichingigë chisoherrë ënsë yaao, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënsë yonsui ya Misiri nëraache ëbhe igisuntë gikugira yaacho. Nchirasereeki kërë imbura yi irigörö yaatigiri; na tichiraatigi gëntö kërë gionsui këgörö yë ëmëtë gëno gëkömera këbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichingigë chiyö nchiraichöre kunyumba yaao, na guchinyumba cha abhakoramërëmo bhaao, na guchinyumba cha Abhamisiri bhonsui, nchiraabhe ichincharu ëkërengere këno ninyoora bhaguuka bhainyu bhatakarööchë gukurua bhaatangërë köbha gökëbhara, kuhika reero.’” Köhayö, Mösa akarua harë Bharao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bha Bharao bhakabhuuria Bharao iga, “Kuhika nkaaga kë ömöntö öno aratuiriiri? Tahaatëra abhantö bhano bhagende gösengera ÖMÖNENE, Ënooköë waabho. Gösë nötatöndörrëëyöë kömaaha iga ënsë ya Misiri ërasika?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Mösa na Haruni bhaabhërëkëëyöë guiki kuya harë Bharao nawe akabhateebhia iga, “Taya mösengere ÖMÖNENE, Ënooköë weinyu! Sibhoono mbaabho ng'ui kana bhakuya?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akamuhunchukiria iga, “Ntöraayi na abhachabhaani na abhasensegeru bhaitö, abhaana bhaitö bhë ëgësaacha na ëgëkari, amang'ondi gaitö na iching'ombe chaitö; kugira kuhika tökörre ÖMÖNENE ësögökörö.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharao akabhateebhia iga, “ÖMÖNENE abhe hamui na bhainyu, hano ndanyoore nëmbahaatëra muyi na abhaana bhainyu. Mbörabhu kimui iga mmööna iritegeerro iribhëëbhë kömooyo goinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa-a iga hai! Na abhasaacha abhiene bharaayi gösengera ÖMÖNENE, kugira ëyö niyo mugutuna.” Igo, Mösa na Haruni bhakarugibhua kurua harë Bharao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Rambëka ököbhoko koo, igörö yë ënsë ya Misiri, ichingigë chiiche chire këra mötë hamui na bhionsui bhino imbura ëëra yi irigörö yaatigiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Mösa akarambëka inyimbo igörö yë ënsë ya Misiri. ÖMÖNENE akarenta ömökama kurua rögörö gönsë, gökahusa ömöbhasö umugima na ubhutikö ubhugima. Hano bhookëëyë nkanyoora ömökama gööra görentërë ichingigë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.2"
              },
              "items": [
                {
                  "text": "Öbhö 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ichingigë chiyö chiganchaara këra hasë gönsë ya Misiri, chigaikarra ënsë yonsui. Ichingigë chiyö nchaarëngë irikomo irinene bhökong'u ëkërengere këno gëtakarichokeeyë na këno gëtaririchokera guiki röndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.14",
            "verseOrgIds": [
              "EXO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigakundikiria ënsë yonsui ya Misiri, hansë hakabha igisuntë; chikarëa ëmëtë na amakö gonsui bhino imbura ëëra yi irigörö yaatigiri. Tiitö rërë rionsui reetamërë kömötë gösë inyanki harë honsui gönsë yonsui ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.15",
            "verseOrgIds": [
              "EXO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.15",
            "verseOrgIds": [
              "EXO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho guiki Bharao aabhërëkëëyë Mösa na Haruni bhöngöbhöngö akabhateebhia iga, “Nakorrë iriraga guisiira ÖMÖNENE, Ënooköë weinyu, na köbhaisiira bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono ndabhageya munyabhëre iriraga reene harë rimui rëno bheene, mösaasaame ÖMÖNENE, Ënooköë weinyu anheniri uruku röno.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
            "verseOrgIds": [
              "EXO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Mösa akarichoka kurua harë Bharao akaya gösaasaama ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.18",
            "verseOrgIds": [
              "EXO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE nawe akahönchöra ömökama ömurito kurua nyancha gökaimukia ichingigë chiira na guchirekera Nyancha Mberretu. Tiingige yaatigaayë ninyoora nimui gönsë ingima ya Misiri hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ÖMÖNENE naakong'iri ömötöe go Bharao, nawe akanga köhaatëra Abhaisiraeri bhayi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        }
      ]
    },
