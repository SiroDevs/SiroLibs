            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Öbh 17:1-21\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Taimukiirria ököbhoko koo, kuya igörö kuriöbha korri igisuntë ëkënene gikure gönsë yonsui ya Misiri, këno ömöntö akuhuunahuuna.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
