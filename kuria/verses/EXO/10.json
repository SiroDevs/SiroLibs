          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ÖMÖNENE agakong'ia ömötöe go Bharao, akanga köhaatëra Abhaisiraeri bhayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Bharao agateebhia Mösa iga, “Tarua mbere yaane! Na wiraarërre ötagaacha guucha harë uni guiki, kugira röno uriicha mbere yaane, nuurikua!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
      ]
