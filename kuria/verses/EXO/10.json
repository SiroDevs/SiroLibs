                  "text": "Öbhö 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö Mösa akaimukirria ököbhoko kooe kuya igörö kuriöbha, igisuntë këgakura gönsë yonsui ya Misiri guchinsikö isatö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhakanga kömaahana, gösë kurua harë bhaarëngë guchinsikö isatö. Sibhoono Abhaisiraeri bho mbaarë na öbhörabhu Goseni haara wanyoorrë bhaamenyërë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        }
      ]
