          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bhë ëgësaacha bha Kora mbano: Asiri, Erikana, na Abhiasabhu, nabho mbo bhaguuka bhi ichika cha Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriasari ömoona o Haruni naatetërë umui wa abhaisëkë bha Bhutieri, nawe akamuibhörra Bhinehasi. Bhayö mbo bhaguuka bhi ichika cha Abharawi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
      ]
    },
