        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni naatetërë Erisebha, umuisëkë wa Aminatabhu, musubhaati omoobho Nasoni, nawe akamuibhörra Natabhu, Abhihu, Eriasari, na Itamari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
