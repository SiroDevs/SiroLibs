                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ënooköë guiki agateebhia Mösa iga, “Uni nu uni ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaarichokeeyë Ibhurahimu, Isaka na Yakobho nnaamanyikaini kë Ënooköë Umukumahe, ninyoora ntaimanyëkaini harë bho kuriina reene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki nnaarëëyë imuuma nabho iga nëndabhahe ënsë ya Kanaani ëno bhaamenyërë kea abhaitongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gökëra gayö, niguurë ikuuratë ya Abhaisiraeri, bhano Abhamisiri bhagökoria ëmërëmo giu ubhunyambu, nhiitërë imuuma yaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö teebhia Abhaisiraeri iga, ‘Uni nu uni ÖMÖNENE! Nëndaabharuusi hansë yë ëmësaire gia Abhamisiri na nëndabhatuuri kurua kubhunyambu bhoobho gököbhoko köno körambëkërë na ököbhörööta ökönene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndabhakore möbhe abhantö bhaane, nani nëbhe Ënooköë weinyu. Mmöramanye iga Nu uni ÖMÖNENE, Ënooköë weinyu, öno aabharuusiri kurua hansë yë ëmësairi gia Abhamisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndabhahire gönsë ëno naituenerriiyi köha Ibhurahimu, Isaaka na Yakobho. Nëndaabhahe ënsë ëyö ëbhe iyeinyu. Nu uni ÖMÖNENE.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agateebhia Abhaisiraeri amang'ana gayö, sibhoono bhakanga kömötegeerra, kugira nkanyoora bhaakua nkoro gikugira yö öbhörërëëma bhu ubhunyambu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Mösa, iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.10",
            "verseOrgIds": [
              "EXO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Taya harë Bharao ömögambi wa Misiri ömöteebhi ahaatëre Abhaisiraeri bharichoke kurua gönsë yaae.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
            "verseOrgIds": [
              "EXO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Mösa akahunchukiria ÖMÖNENE iga, “Tamaaha, Abhaisiraeri tëbhakunyiguëra hai, gëtaakë Bharao! Guiki uni nö ömöntö öno ntagötöra gusumaacha!” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ÖMÖNENE agasumaacha na Mösa na Haruni, akabhatöma kuya harë Bharao ömögambi wa Misiri, gönsë ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichika cha Mösa na Haruni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo abhasimuri bhi ichika cha bhaise waabho: Abhaana bha Rubheni ömötangi wa Isiraeri mbaarëngë bhanai, nabho mbo bhano: Hanoki, Bharu, Hesironi, na Karimi; bhayö mbo bhaguuka bhi ichika cha Rubheni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Simioni mbaarëngë: Yemueri, Yamini, Ohati, Yakini, Sohari, na Sauri ömoona wö ömögaikörö Ömökaanani. Bhayö mbo bhaarëngë bhaguuka bhi ichika cha Simioni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
