              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ÖMÖNENE agateebhia Mösa iga, “Bhoono nöramaahe bhörë ndakore Bharao; kugira narahaatëre abhantö bhaane gököhaamirribhua na ichinguru chaane. Ee-e guchinguru chaane narabharugi kurua gönsë yaae.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ënooköë arabhërëkëra Mösa",
          "type": "text"
        }
      ]
    },
