          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni na Mösa mbo bhaateebhibhui na ÖMÖNENE iga, “Murichoki Abhaisiraeri kurua gönsë ya Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho mbo bheene bhaasumaachërë na Bharao ömögambi wa Misiri igörö ya kurichokia Abhaisiraeri kurua gönsë ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
              "EXO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëngamba yö ÖMÖNENE harë Mösa na Haruni",
          "type": "text"
        }
      ]
    },
