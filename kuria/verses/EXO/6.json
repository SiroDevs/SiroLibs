          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuramu naatetërë Yokebheti, gaakai waabho, nawe akamuibhörra Haruni na Mösa. Amuramu naamenyërë ëmeeka irigana rimui na mërongo ëtatö na muhungatë (137). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.20",
            "verseOrgIds": [
              "EXO.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhaana bhë ëgësaacha bha Isihari mbano: Kora, Nebhegi, na Sikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.21",
            "verseOrgIds": [
              "EXO.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bhë ëgësaacha bha Usieri mbano: Misaeri, Erisabhani, na Sitiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        }
      ]
    },
    {
