              "type": "text"
            }
          ]
        },
        {
          "text": "Rööra ÖMÖNENE aasumaachërë na Mösa gönsë ya Misiri, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
