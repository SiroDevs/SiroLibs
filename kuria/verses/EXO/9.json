          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akamoteebhia iga, “Nigo ndarichoke këbhara yu umugi igo, nimukiirri amabhoko gaane kuya igörö na nsaasaame ÖMÖNENE ibhabhagatiö bhisire, na imbura yi irigörö tëraabhe ho guiki hai, korri ömanye iga ëkëbhara ni ikiö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nëmanyërë iga uwe na abhakoramërëmo bhaao tëmökoobhoha ÖMÖNENE hai.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        }
      ]
    },
    {
