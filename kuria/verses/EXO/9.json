              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Mösa agatanöra kurua harë Bharao akaya këbhara yu umugi, akaimukiirria amabhoko gaae agasaasaama ÖMÖNENE, ibhhibhagatiö na imbura yi irigörö bhikaimëërra na imbura ëkagatöka gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano Bharao aarööchë iga imbura yi irigörö, na ibhibhagatiö bhibhötökërë, narëngëëyë guiki iriraga reee, agakong'ia ömötöe we na abhakoramërëmo bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ke bhööra bheene wanyoorrë ÖMÖNENE aateebhia Mösa; Bharao naakong'iri ömötöe akanga köhaatëra Abhaisiraeri bhayi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
