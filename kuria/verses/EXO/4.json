          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga wanyoorrë bharaayë kunyumba ya abhageni bhakëërëngë körögendo, ÖMÖNENE agasikana nawe agatuna kumuita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Sibhora ömökari wa Mösa akahörömöka, akaimukia irigëna iriögë agakenga irichöbhö riö ömoona waae, agaturubhania nario Mösa kömagörö aragamba iga, “Uwe nö ömöteti wa amanyinga örë harë uni.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo ÖMÖNENE akahaatëra Mösa. Sibhora wanyoorrë agambërë iga, “Uwe nö ömöteti öwa amanyinga örë harë uni,” gikugira ya gösaaröa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
      ]
    },
    {
