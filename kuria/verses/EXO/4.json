        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Haruni iga, “Taimöka uyi guturung'ana Mösa guiköngö.” Igo Haruni akaya, guturung'ana Mösa kunguku yë Ënooköë, akamomuuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa agateebhia Haruni amang'ana gonsui gano ateebhibhui nö ÖMÖNENE iga agambe, na ibhirögöörö bhionsui bhino asimisiribhui gökora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa na Haruni bhakaya bhakairia abhagaaka bhonsui bha Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
              "EXO.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni akabhateebhia amang'ana gaara gonsui ÖMÖNENE asimisiiyi Mösa, na gökora ibhirögöörö mbere ya abhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhagakumia. Na hano bhaiguure iga ÖMÖNENE achërë gutuurria Abhaisiraeri, na iga arööchë inyaanyi yaabho, bhonsui mbaahigamërë kömösengera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        }
