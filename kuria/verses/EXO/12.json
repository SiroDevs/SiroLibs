              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagatanöra kurua kumugi go Ramesesi, bhakagenda na amagörö bhakaya Sukoti. Nabho mbaarëngë abhasaacha ibhiköë amagana asansabha (600,000) kugutiga abhakari na abhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaatanööyë na irikomo ria abhantö bhandë na ichitugo ichincharu, amang'ondi na iching'ombe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira wanyoorrë bhaatanööyë kurua Misiri bharamaamaana, tëbhaahikërë göseemia ibhiakörea bhiö örögendo hai, gëtatiga öbhöse bhööra bheene wanyoorrë bhökonyëröë bhötaana mëmera. Igo, bhagakora ëmëgaate gëno gëtatöörröë ëmëmera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
