                  "text": "Gar 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wanyoorrë bhaamenya gönsë ya Misiri kömeeka amagana anai na mërongo ëtatö (430). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kögösookirria ömooka göa amagana anai na mërongo ëtatö (430), ndo ibhiaro bhionsui bhiö ÖMÖNENE bhaatëkërë kurua gönsë ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhutikö bhööra ÖMÖNENE naahurrë korri arichoki Abhaisiraeri kurua gönsë ya Misiri, köhayö ubhutikö bhöyö bho kuhura kuhika bhögootöe na köhëëtököa na Abhaisiraeri bhonsui kömakora gonsui kugira yö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imigiro igörö yë ëbhasaka",
          "type": "text"
        }
      ]
    },
