      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhaisiraeri bharatanöra kurua Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
