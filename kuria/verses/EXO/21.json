        },
        {
          "text": "hakurua ööra anyahaarröë anyoore umueya na gutumbagëra na inyimbo, ööra amunyahaarrë abhëroa; sibhoono amöhakana gikugira yë ënkaaga ëno aatabhutërë bhörrë, na kömörera kuhika hano arahuene kimui.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
