        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano abhasaacha bhaitana bhanyahaarrë ömögaikörö öno anda, ënda irue atanyahaarëkërë hasë handë, ööra amunyahaarrë atoosöa ëgëtooso gököreng'aana na keebhörë mösaacha wö ömökari ööra aratune, na keebhörë abhakengabhiina bharakenge ikiina këyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore aanyaharëka ahasë handë, kuhika amöhakane öbhöhoru köbhöhoru, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
