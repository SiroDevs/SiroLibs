              "items": [
                {
                  "text": "Öbhö 15:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa na Abhaisiraeri bhagasiringiria ÖMÖNENE irisiringiö rëno,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisiringiö re Miriamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.18",
            "verseOrgIds": [
              "EXO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga amagaari, ichibharaasi na abhagendia-bharaasi bha Bharao bhaasohërë ahasë ahöömö kunyancha, ÖMÖNENE naaringiri amanchë gakabhakundikiria. Si Abhaisiraeri bho mbagendërë ahasë ahöömö kunyancha gatai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Miriamu ömönaabhi, musubhaati omoobho Mösa na Haruni akaimukia igichegeriö na abhagaikörö bhonsui bhakabha nyuma yaae bhaana ibhichigerio bharatenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriamu akabharentiria irisiringiö rëno:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amanchë amarrrö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa agatangata Abhaisiraeri kurua Nyancha Mberretu, kuya guiköngö re Suri. Bhakagenda örögendo rui ichinsikö isatö guiköngö bhatakarööchë manchë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaahikërë ahasë handë iga Mara, bhakanga kunyua amanchë gaaho kugira namarrrö gaarëngë; igo ahasë hayö hakabhërëkëröa iga Mara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhakaröröötëra Mösa bharagamba iga, “Bhoono nkë töranyue?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Sir 38:5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Mösa aaköörëëyë ÖMÖNENE, ÖMÖNENE nawe akamoorokia ëkëng'ënga kiö ömötë, Mösa agakërekera kömanchë; nago gakabha amaiya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho ÖMÖNENE aabhahereeyë imigiro na amaragirriö korri iga abhahereki, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabhateebhia iga, “Hano möraiguëre ëngamba yaane uni ÖMÖNENE, Ënooköë weinyu, mökore garë garëngë amaiya mbere yaane, na gösööka imigiro na amaragirriö gaane gonsui, tëndabharentere amarooyi gaara narenteeyë Abhamisiri hai; kugira, Uni nu uni ÖMÖNENE öno nköbhahuenia.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Abhaisiraeri bhakahika Erimu, hano haarëngë na ichinyörrö ikumi na ibhërë na ëmëtende mërongo muhungatë. Bhagatööra irisanchö ho bheene hang'i na amanchë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
        }
      ]
    }
  ],
