                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Ëbh 28:16-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mögoote ësögökörö yë ëmëgaate gëno gëtatöörröë ëmëmera. Mmöraare ëmëgaate gëno gëtatöörröë ëmëmera guchinsikö muhungatë gönkaaga ëno yaaseemibhua kumueri go Abhibhu, keebhörë naabhateebhiri, kugira kumueri göyö go Abhibhu mmooruurë Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ëgt 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kera mötangi wë ëgësaacha nö öwaane, hamui na ichitugo ichintangi chonsui chë ëgësaacha, chi iching'ombe na amang'ondi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
