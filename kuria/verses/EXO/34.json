            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.9",
            "verseOrgIds": [
              "EXO.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Tamaaha, nëndakore imuuma na abhantö bhao. Nëndakore ibhirögööro mbere yaabho bhino bhitaagakorröë gökëbhara ikigima, gösë köhamtë ërë yonsui. Na abhantö bhonsui bhano bhamenyërë gatai yaabho mbaramaahe amakora gaane amanene. Kugira nëndakore ëng'ana yë ëkërögööro gikugira yaao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötagoota amarago gano nköbhaha reero. Mbere yeinyu nëndarugi Abhaamori, Abhakanaani, Abhahiti, Abhabheresi, Abhahibhi na Abhayebhusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.11",
            "verseOrgIds": [
              "EXO.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muriihe mötagaacha gökora imuuma na abhamenyi bhë ënsë ëëra mukuya, kugira ëyö nëraabhe ömötego harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.12",
            "verseOrgIds": [
              "EXO.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.21"
              },
              "items": [
                {
                  "text": "Ëhë 16:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono mmörataagani amakëngë gaabho gë ësengero na ibhihooru bhia Asera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.13",
            "verseOrgIds": [
              "EXO.34.13"
            ]
          }
        }
      ]
    },
