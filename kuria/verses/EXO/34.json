        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mötagaacha gösengera ënooköë ërë yonsui, gikugira uni ÖMÖNENE nëmanyëkaini iriina reene iga, ‘Nyaihari’ uni në Ënooköë nyaihari ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutagaakora ubhuiguërrani bhörë bhonsui na abhamenyi bhë ënsë ëyö, kugira hano bharasengere ichinooköë chaabho chö öbhörongo na kumuensa harë chio, mbarabharaarëke, na bhainyu mmörakorokombibhue körëa ibhiakörea bhino bhakumuensa guchinooköë chabho, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na abhahentani bhainyu bhatete abhaisëkë bhaabho, na abhaisëkë bhayö bhagösengera ichinooköë chaabho, bhakorokombi abhahentani bhainyu bhasoorane ichinooköë chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
