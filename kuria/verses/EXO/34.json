            }
          ]
        },
        {
          "text": "“Harë gatatö kömooka abhasaacha bhonsui bhayi bharairania mbere yaane uni ÖMÖNENE, Ënooköë wa Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
