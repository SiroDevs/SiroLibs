          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndarugi ichihamatë chindë mbere yeinyu na kögarihia ichibhaga cheinyu. Taaho möntö örë wonsui ariigomba ënsë yeinyu nkaaga mukuirania na gönsengera uni ÖMÖNENE, Ënooköë weinyu harë gatatö këra mooka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
