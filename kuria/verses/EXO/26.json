                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3+HEB.9.4+HEB.9.5"
              },
              "items": [
                {
                  "text": "9:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usunge ëhanga ya ëyö körökarra rui ibhigachiriö, hakurua örente Irisandëko ri Imuuma na körëtööra mönsë yi iritume na kuriikaria nyuma yë ëhanga ëya ya gutimbia. Ëhanga ëyö nërahökani ahasë ahahoreeru na ahasë ahahoreeru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönsë ya ahasë ahahoreeru bhökong'u haara wikari igitumbë kia amaabhë igörö yi Irisandëko ri Imuuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ëmeesa ëëra nöragëtööre göntahana ya këbhara yi iritume, na ëgëtagacha gë ëtara këëra nöragëtööre bhitachëërrane na ëmeesa göntahana ya sööchë; na ëmeesa ëyö ngöntahana ya mööchë öragikari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
    },
