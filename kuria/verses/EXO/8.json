              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akamöteebhia iga, “Hano töraise gutigana na uwe, nëndasabhe ÖMÖNENE, icho amakomo gano gi ichingi gaache garue harë uwe Bharao, abhakoramërëmo bhaao na abhantö bhaao. Si, ötagatöng'aina guiki hakurua wange köhaatëra abhantö bhayi kuruusiria ÖMÖNENE ikimuenso.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
