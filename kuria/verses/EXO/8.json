          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akarua harë Bharao, agasaasaama ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agakora keebhörë Mösa amösabhërë, ichingi chiira chikarua harë Bharao, köbhakoramërëmo bhaae, na köbhantö bhaae, ëkanga götama ninyoora ni imui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ninyoora nkuruito röno guiki, Bharao agakong'ia ömötöe, akanga köhaatëra Abhaisiraeri bhayi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.32"
            ]
