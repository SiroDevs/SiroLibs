        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Bharao akagamba iga “Nëndabhahaatëre muyi kuruusiria ÖMÖNENE, Ënooköë weinyu ikimuenso guiköngö. Si monge kuya harai bhökong'u. Nani mönsabhërani.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
