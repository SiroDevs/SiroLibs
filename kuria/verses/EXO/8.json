    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Mösa iga, “Taya harë Bharao ömöteebhi iga, ÖMÖNENE aragamba iga: Tahaatëra abhantö bhaane bhayi korri iga bhankorre ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano ndanyoore wangërë köbhahaatëra bhayi nëndateme ënsë yaao yonsui gö kögërentera ibhiöra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.2",
            "verseOrgIds": [
              "EXO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömooro go Nairi ngöraichöre ibhiöra. Nabhio mbirasohe ninyoora nkugisuumua ge köraara, na guchinyumba cha abhakoramërëmo bhaao. Ibhiöra bhiyö mbirasohe kömariiko gainyu, kubhikarangëro na kubhisörra bhienyu bhia gökonyera öbhöse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.3",
            "verseOrgIds": [
              "EXO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiöra bhiyö mbirarënërre ömöbhërë gooo gonsui, ëmëbhërë gia abhantö bhaao na igia abhakoramërëmo bhaao!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Teebhia Haruni, arambëke inyimbo yaae igörö yi imioro, igörö yë ëmëgëra na amatibhöngö, ibhiöra mbirarichokere na körömaania ënsë yonsui ya Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Haruni akarambëka inyimbo yaae igörö ya amanchë gonsui, ibhiöra bhikarichokera bhikagubha ënsë ya Misiri ingima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoni bha Misiri nabho bhakarenta ibhiöra bhindë Misiri gukibhisërë kiö öbhökoni bhoobho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Bharao abhërëkëëyë Mösa na Haruni, akabhateebhia iga, “Mötageya ÖMÖNENE anduusiri ho ibhiöra bhino uni na abhantö bhaane, nani nëndahaatëre Abhaisiraeri bhayi kuruusiria ÖMÖNENE ikimuenso.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akahunchukiria Bharao iga, “Gamba në ënkaaga kë ugutuna iga ngösabhëre kö Ënooköë, nsabhëre abhakoramërëmo bhaao na abhantö bhaao; nëndamösaasaame asiki ibhiöra bhino kurua guchinyumba cheinyu; bhitame kömooro go Nairi bheene.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.9",
            "verseOrgIds": [
              "EXO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.9",
            "verseOrgIds": [
              "EXO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharao akahunchukia iga, “Icho.” Mösa akagamba iga, “Nëndakore ke hayö ögambërë, korri ömanye iga, taaho öno arang'aine ÖMÖNENE, Ënooköë weitö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiöra mbirarue harë uwe na guchinyumba chaao, abhakoramërëmo bhaao na köbhantö bhaao; bhitame kömooro go Nairi bheene.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa na Haruni bhakarichoka kurua harë Bharao nawe agasaasaama ÖMÖNENE iga aruusiri ho Bharao ibhiöra bhiira wanyoorrë amörenteeyë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agakora keebhörë Mösa amösabhërë: Ibhiöra bhiira bhiarë guchinyumba, kubhiwansa, na guchihëërö chi ichinyumba bhigakua bhionsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagaköma ibhiöra bhiyö guchihurubhi; ënsë ingima ëkanyunka iga hui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano Bharao aarööchë iga ëbhaayë bhuuya, agakong'ia ömötöe guiki, akanga kuiguëra Mösa na Haruni, ke bhööra bheene wanyoorrë ÖMÖNENE agambërë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Mösa iga, “Tateebhia Haruni aimukiirri inyimbo yaae ateme urutu ruë ëkëbhara, naro ndöraihönchöre röbhe ichinkara gönsë yonsui ya Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa na Haruni bhagakora ke bhöyö. Haruni akarambëka inyimbo yaae agatema urutu ruë ëkëbhara, naro rökaihönchöra rökabha ichinkara nacho chigasoherra abhantö na ichitiinyi. Urutu ronsui ruë ëkëbhara rökaihönchöra rökabha ichinkara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.17",
            "verseOrgIds": [
              "EXO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoni bhaara bha Misiri bhagasaacha gukibhisërë kiö öbhökoni bhoobho gökora urutu röbhe ichinkara si bhakanga götöra. Ichinkara chiyö chikarömaana kömëbhërë gia abhantö na ichitiinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.20"
              },
              "items": [
                {
                  "text": "Ruk 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhakoni bhaara bha Misiri bhagateebhia Bharao iga, “Öno në Ënooköë agökora gano!” Si hayö honsui Bharao akagenderria gökong'ia ömötöe; akanga kuiguëra Mösa na Haruni. Gëkabha ke bhööra bheene ÖMÖNENE wanyoorrë agambërë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Mösa iga, “Icho nkio chuni uche umute ögëëre Bharao nkaaga akuya kömooro ömöteebhi iga, ÖMÖNENE aragamba iga: ‘Tatiga abhantö bhaane bhayi gönsengera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoore wangërë köbhahaatëra, nëndakörentere amakomo gi ichingi, uwe, abhakoramërëmo bhaao na abhantö bhaao bhonsui. Ichingi nchirasohe guchinyumba cheinyu na ichinyumba chonsui cha Abhamisiri nchiraichöre amakomo gi ichingi, hamui na irirobha rionsui re Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
              "EXO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono urusikö röyö nindichaabha ënsë ya Goseni ëno abhantö bhaane bhamenyërë, köhayö amakomo amanene gi ichingi tëgarëbha ho hai. Röyö ndo örëmanya iga uni ÖMÖNENE ngökora ndë ëmërëmo gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndakore öbhoohökani gatai ya abhantö bhaane na abhantö bhaao. Ëkëmanyiirriö keyö ni icho kërëbha.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agakora ke bhööra agambërë: Amakomo amanene gi ichingi gagasoherra inyumba ya Bharao, ichinyumba cha abhahobhisa bhaae, na ënsë ingima ya Misiri. Ënsë ingima ya Misiri ëgasaribhoa na ichingi chiyö.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Bharao aabhërëkëëyë Mösa na Haruni, akabhateebhia iga, “Taya muruusiri Ënooköë weinyu ikimuenso, si habhe gönsë ëno ya Misiri bheene.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Mösa akamuhunchukiria iga, “Tibhuuya gökora igo! Kugira ikimuenso këno töraruusiri ÖMÖNENE, Ënooköë weitö, ni ikiriirriö kö Abhamisiri. Hano Abhamisiri bharatömaahe töraruusia ikimuenso këno kërëngë ikiriirriö harë bho, mbaratöteme na amagëna? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhika tuyi örögendo rui ichinsikö isatö guiköngö, korri iga turuusiri ÖMÖNENE, Ënooköë weitö ikimuenso, keebhörë aragambe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        }
      ]
    },
