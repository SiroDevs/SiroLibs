    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mösa ararundia uruku röa abhatangi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Nëndarente iritemo rëndë rimui igörö ya Bharao, na igörö yë ënsë ya Misiri. Hakurua nëho arabhahaatëre mötanöre kurua hano. Guiki hano arabhahaatëre mötanöre, we umuene narabharugi muyi kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teebhia Abhaisiraeri iga bhategeerre bhuuya iga, këra mösaacha na këra ömögaikörö kuhika asabhe umunyaröbheri waae ibhintö bhino bhikoreeyoë amatiini gi ichimbiria na ësahaabhu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agakora Abhaisiraeri bhakahanchöa na Abhamisiri. Ninyoora Mmösa umuene ömöntö ömösööke gönsë ya Misiri, na mbere ya abhakoramërëmo bha Bharao na mbere ya abhantö bhonsui bha Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa agateebhia Bharao iga “ÖMÖNENE aragamba iga, ‘Reero bhutikö gatai nëndahete gönsë yonsui ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano ndahete këra mötangi gönsë ya Misiri naraakue: Nko kögamba iga, kögötangëra ömötangi waao uwe Bharao öno arëngë umuri wö ömöndö gö öbhögambi kuhika kömötangi wö ömökoramërëmo wë ëgëkari öno agösëa ibhiakörea körögëna. Ninyoora ni ichitugo chonsui ichintangi nchirakue. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëkërröe ëkënene nkëraabhe gönsë ya Misiri, ëkërröe këno gëtakarichokeeyë na tikiririchokera röndë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono köbhantö bhaane bha Isiraeri, tëmöntö gösë tugo gösë sëësë yaabho ëranyoore na ëtabhaaribhaaria ërë yonsui hai, korri ömanye iga uni ÖMÖNENE nkohökania ndë Abhaisiraeri na Abhamisiri.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agasookirria kögöteebhia Bharao iga, “Abhakoramërëmo bhaao bhano bhonsui mbaraache kuhigama mbere yaane gösööko, bharangeya iga ndichoke kurua gönsë ya Misiri, na abhantö bhaane bhonsui. Nëho bhoono ndatanöre.” Hakurua agatanöra kurua harë Bharao asinankërë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Bharao nkonga arë gukuiguëra korri iga ibhirögööro bhiane bhiyengeri gönsë ya Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa na Haruni mbaakorrë ibhirögööro bhiyö bhionsui mbere ya Bharao, sibhoono ÖMÖNENE agakora Bharao akabha na ömötöe ömökong'u, akanga köhaatëra bharichoke kurua gönsë yaae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
  ],
