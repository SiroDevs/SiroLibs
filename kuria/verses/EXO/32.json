                "loc": "ACT.7.40"
              },
              "items": [
                {
                  "text": "Ama 7:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhantö bhaarööchë iga Mösa atëgëtërë kuringa kurua kunguku, mbairaini bhakagëëra Haruni bhakamöteebhia iga, “Bhoono ötatökorra ichinooköë chino chiratötangate kugira tëtömanyërë garë ganyoorrë Mösa öno aaturuusiri gönsë ya Misiri hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni akabhateebhia iga, “Ruusia ibhigera bhë ësahaabhu kurua kömatui ga bhakainyu, abhaana bhainyu abhë ëgësaacha na abhë ëgëkari, möndetere.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.2",
            "verseOrgIds": [
              "EXO.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo abhantö bhonsui bhakaruusia ibhigera bhië ësahaabhu kömatui gaabho bhakarentera Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.3",
            "verseOrgIds": [
              "EXO.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Gam 12:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.41"
              },
              "items": [
                {
                  "text": "Ama 7:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe akabhiimukia akabhisasia agakora ëkëhooru gë ëkëgaini. Abhantö bhagachëërra bharagamba iga “Wei Isiraeri, öno nëwe ënooköë weitö öno aaturuusiri gönsë ya Misiri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni akahagaachëra ëkëhooru këëra irikëngë, hakurua akarundia iga, “Icho në ësögökörö yö ÖMÖNENE.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.5",
            "verseOrgIds": [
              "EXO.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.7"
              },
              "items": [
                {
                  "text": "1 Ko 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano bhookëëyë, abhantö bhakamuta köbhööka bhakaruusia ibhimuenso bhia gösambërëërröa na ibhimuenso bhiö ömörembe. Hakurua bhagaikara hansë köraagëra na kunyua sooki bhakaimöka götenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.6",
            "verseOrgIds": [
              "EXO.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Tasëkëra kuya hansë kugira abhantö bhaao bhano waaruusiri gönsë ya Misiri bhahotokërë abhiene; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.7",
            "verseOrgIds": [
              "EXO.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhantigërë bhöngöbhöngö bhabhömbörë ëkëhooru gë ëkëgaini, bhagësengeyë na gukimuensera bharagamba iga, ‘Wei Isiraerri, öno nëwe ënooköë weitö öno aaturuusiri gönsë ya Misiri!’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.8",
            "verseOrgIds": [
              "EXO.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ënooköë agateebhia Mösa iga, “Ndööchë abhantö bhano, tamaaha, mbaana ëmëtöe ëmëkong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.9",
            "verseOrgIds": [
              "EXO.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö wange köndëbhërra utige mbasiki, nu ubhusinanku bhoone; sooki ngökore uwe öbhe ëhamatë ënene.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.10",
            "verseOrgIds": [
              "EXO.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.13+NUM.14.14+NUM.14.15+NUM.14.16+NUM.14.17+NUM.14.18+NUM.14.19"
              },
              "items": [
                {
                  "text": "Ëbh 14:13-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono Mösa akageya ÖMÖNENE, Ënooköë waae aragamba iga, “Wei ÖMÖNENE, igankë öbhaayë nu ubhusinanku igörö ya abhantö bhaao bhano waruusiri gönsë ya Misiri kögötöra ökönene gö ököbhoko kooo? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene hano örakore igo, Abhamisiri mbaragambe iga, ‘Kana kura nköbhöbhëëbhë aabharuusiri hano iga ayi köbhaitëra guchinguku na köbhasikia kurua gökëbhara.’ Wei ÖMÖNENE tatindia ubhusinanku bhooo utige gökora ëng'ana ëmbhëëbhë ëno öseemiri guisiira abhantö bhaao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.12",
            "verseOrgIds": [
              "EXO.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.16"
              },
              "items": [
                {
                  "text": "Ögt 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tahiita abhakoramërëmo bhaao, Ibhurahimu, Isaka na Isiraeri, bhano watuenerreeyi umuene öragamba ga, ‘Nëndengeri uruibhöro roinyu röbhe gi ichinyunyuunyi cha kuriöbha, na köha uruibhöro roinyi ënsë yonsui ëno naabharagaini, ëbhe ömöndö gaabho kuya ëyö.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.13",
            "verseOrgIds": [
              "EXO.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ÖMÖNENE agatiga gökorra abhantö bhaae ëng'ana ëmbëëbhë ëëra wanyoorrë agambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa agasëkëra kurua kunguku ana ichimbaara ibhërë chiira wanyoorrë chandëkëröë amarago gë Ënooköë ichintahana chonsui ibhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.15",
            "verseOrgIds": [
              "EXO.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichimbaara chiira në ëmërëmo gë Ënooköë umuene geerëngë na nëwe wanyoorrë anyamërë Amandëko gaara umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.16",
            "verseOrgIds": [
              "EXO.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yosua aiguurë abhantö bharakora igituri agateebhia Mösa iga, “Si igituri ki iriihi kërëngë guisanchö.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.17",
            "verseOrgIds": [
              "EXO.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akamuhunchukiria iga, “Këyö tigituri kiu ubhukiri kuiihi hai, gëtatiga igituri këno uni nkuigua ni ikia abhantö bhano bhagusiringia” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Mösa aahikërë hang'i ni irihita; akamaaha ëkëhooru këëra gë ëkëgaini, na ahantö bharatenga; igo öbhörrö bhögooka mönsë yaae kiö ömörro, akarekera hansë ichimbaara ibhërë chiira aarë nacho chigaatëka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.19",
            "verseOrgIds": [
              "EXO.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaimukia ëkëhooru këëra gë ëkëgaini, akagësamba, akagësëa gëkabha öbhöse agatööra mo amanchë akabhöhetia na köbhahaamiirria bhakanyua. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.20",
            "verseOrgIds": [
              "EXO.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akabhuuria Haruni iga, “Niyekë kana abhantö bhano bhagökorrë kuhika öbhasohiri kuiraga irinene igo?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.21",
            "verseOrgIds": [
              "EXO.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni akahunchukia iga, “Wei ndagösabha mönene waane, wange köbha na öbhörrö igörö yaane uni ömökoramërëmo waao. Nömanyërë bhörë abhantö bhano bharëngë abhangö bhagökora amanyanku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.22",
            "verseOrgIds": [
              "EXO.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaanyëchëëyë bhaganteebhia iga, ‘Tatökorra ënooköë öno aratötangate kugira Mösa öyö aaturuusiri gönsë ya Misiri tëtömanyërë garë gaamunyoora hai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.23",
            "verseOrgIds": [
              "EXO.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani nkabhateebhia iga ömöntö örë wonsui ana ëkëgera gë ësahaabhu akëndentere. Köhayö, bhakandentera, nani nkabhisasia kömörro, ëkëmoori këyö gëkarichokera.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.24",
            "verseOrgIds": [
              "EXO.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Mösa aarööchë iga abhantö bhaara bhahotokërë na gökora bhörë bhagutuna (kugira Haruni naabhakorrë bhakahotoka na gökora bhörë bhagutuna, na kuirentera ichinsoni kubhabhisa bhaabho), ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
