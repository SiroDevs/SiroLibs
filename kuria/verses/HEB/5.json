              "type": "text"
            }
          ]
        },
        {
          "text": "Tëmöntö agaitööra umuene köbha umunchaama umuhikërë hai. Këra umui nkoohöröa arë na Ënooköë köbha umunchaama umuhikërë hai kehaara Haruni aarëngë.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
