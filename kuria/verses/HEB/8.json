              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano nkanyoorrë Imuuma ya mbere ëtaabhaayë na isoro, nyoore iya kabhërë tëgatunëröë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
