                  "text": "Ëgt 26:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyuma ya ëhanga ya kabhërë, iritunteera ndeerëngë ho rëno rëërë köbhërëkëröa iga ahasë ahahoreeru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
