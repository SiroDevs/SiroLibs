        },
        {
          "text": "Ichiseemi chiyö nchaakorröë ke hayö bheene, hakurua ëkabha ësëëra ya abhanchaama gösoha ruiso ronsui guitunteera re isikö gökora ëmërëmo geebho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
