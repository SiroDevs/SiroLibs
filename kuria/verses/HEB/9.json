                {
                  "text": "Ëgt 25:18-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igörö yi Irisandëko rëyö, ibhiteemoa bhino bhiina amabhabha, na amabhabha gaabhio wanyoorrë ngakundikiiyi igitumbë kia amaabhë. Sibhoono igo, tëtögasumaachëra köbhötambë amang'ana gayö hai.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
