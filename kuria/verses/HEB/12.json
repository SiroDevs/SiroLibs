    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhaara tööna irikomo irinene ria abhaherekia rëno rituinaarrë, tötaheenia këra kiribhiirri këno këgötörëbhërra, na iriraga rëëra rigutuibharëërra. Tökënye kubhugumirria kömahandërraniö gano gatöröa mbere yaitö. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.1",
            "verseOrgIds": [
              "HEB.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuihönchörrë Yesö öno aatangërë ubhukumia bhoitö na öno guiki arabhöhëkëërani. Gikugira yö ömögooko göno goorë kömöganya, we naagumirriiyi uruku kömösarabha, taatöndörëëyöë na nsoni chago hai, na bhoono naikaayë bhörëo bhui igitumbë kiö öbhögambi bhöë Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.2",
            "verseOrgIds": [
              "HEB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.2",
            "verseOrgIds": [
              "HEB.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötaitegeerre igörö ya amang'ana gano gaanyoorrë Yesö; kebhörë aagumiirriiyi öbhörëërëëma öbhönene kurua köbhanyamaraga, korri iga mötakarosa gösë gukua nkoro. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.3",
            "verseOrgIds": [
              "HEB.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tëmöraitana na iriraga köhëkëëra ëkërengere ge köhöma amaanyinga hansë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
            "verseOrgIds": [
              "HEB.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Ayb 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11"
              },
              "items": [
                {
                  "text": "Ibh 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gösë muëbha amang'ana gaara ga gutirimikia gano Ënooköë aköbhabhërëkëra iga bhainyu na abhaana bhaae mörë?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
          }
        }
      ]
    },
    {
