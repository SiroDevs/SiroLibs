        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösaache kömenya kömörembe na abhantö bhonsui, na köbha na irimenya irihoreeru, gikugira tëmöntö arëmaaha Ömönene gëtarë iga aana irimenya ke rëyö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.14",
            "verseOrgIds": [
              "HEB.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.18"
              },
              "items": [
                {
                  "text": "Ëhë 29:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muimaahërre bhökong'u ömöntö örë wonsui atagaacha gutiga ësaramita yë Ënooköë. Muiraarëërre korri iga ömötë gö öbhörrö götagaacha kömera gatai yainyu na guita abhaaru nö öbhösöngö bhoogo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
            "verseOrgIds": [
              "HEB.12.15"
            ]
          }
        }
      ]
    },
