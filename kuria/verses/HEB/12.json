            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muiraarërre korri iga ömöntö umuhurunkani gösë öno atakoobhoha Ënooköë ke Esau, öno aagurri öbhötangi bhooe kubiakörëa bhiu urusikö rumui. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
            "verseOrgIds": [
              "HEB.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.30+GEN.27.31+GEN.27.32+GEN.27.33+GEN.27.34+GEN.27.35+GEN.27.36+GEN.27.37+GEN.27.38+GEN.27.39+GEN.27.40"
              },
              "items": [
                {
                  "text": "Ögt 27:30-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhainyu mömanyërë iga ninyoora hano aatunërë kunyoora guiki amaitabhirio gaara gaarëngë agaae, naarekiibhöë, kugira taanyoorrë iribhaga re kuihönchöra hai, ninyoora aaritunërë kömaisori. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.17",
            "verseOrgIds": [
              "HEB.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 12:18"
