            "number": "22",
            "style": "v",
            "sid": "HEB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhainyu muuhikërë kunguku ya Sayuni, na kumugi göë Ënooköë öno aho, muuhikërë Yerusareemu, umugi go kuriöbha, harë abhamaraika ibhiköë ibhiaru bhairaini. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.22",
            "verseOrgIds": [
              "HEB.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muuhikërë kumuiraniö ömönene göa abhatangi bhë Ënooköë, bhano amariina gaabho gaandëköa kuriöbha. Muimërëëyë mbere yë Ënooköë öno ömökengi wi ibhiina wa bhonsui na mbere yi ichinkoro cha abhantö abharöngë na abhahëkëëranu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.23",
            "verseOrgIds": [
              "HEB.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Ögt 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moohika harë Yesö, öno aaseemiri Imuuma Ënhëa, na kömaanyinga gaara gaaminchëröë gano gaköragana ëng'ana inchiiya gökëra amaanyinga gaara ga Habheri.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        }
