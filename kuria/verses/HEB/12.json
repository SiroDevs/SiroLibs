              },
              "items": [
                {
                  "text": "Hag 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëngamba yaae yaasingisiri ëkëbhara gönkaaga ëëra, sibhoono igo aaragana iga, “Nindasingisi kandë guiki ëkëbhara, si tëkëbhara ikiene hai, sibhoono hamui na igörö kuriöbha.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ëno “kandë guiki” ngötörookia ërë bhörabhu iga ibhintö bhionsui bhino bhiateemëröë mbirisiingisibhua na kuruusibhua ho, korri iga bhitigare bhiira bhitagusingisibhua.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        }
