                "loc": "DEU.31.7"
              },
              "items": [
                {
                  "text": "Ëhë 31:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.4"
              },
              "items": [
                {
                  "text": "Yos 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyoora Yosua aahaayë abhantö ukumuunya köyö, Ënooköë taagasumaachërë guiki igörö ya urusikö röndë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ukumuunya köyö ho gökërë köbhantö bhë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.2"
              },
              "items": [
                {
                  "text": "Ögt 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira, örë wonsui agösoha ahasë ha kumuunya ha Ënooköë, naaramuunye kurua kömërëmo geee, kehaara bheene Ënooköë aamuunyërë kurua kömörëmo geee. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö tökore ömökëa tösohe ukumuunya köyö, korri iga möntö örë wonsui atakaabha ho harë bhaitö öno araangë kuiguëra bho bhaakorrë.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
