          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng'ana yë Ënooköë në ëhoru na nëëna ichinguru, ni inyögë gökëra inchonge mbaga ibhërë. Ngökenga ërë iga bhutu yaahökania hagarë ömooyo na ënkoro, yaahökania hagarë öbhögëngörro na ëmësontoe. Guiki ëng'ana ëyö nköngöra ërë amatuno na amaitegeerro gö ömooyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Öbh 1:6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëgëteemoa kërë gionsui gëkaibhisa mbere yë Ënooköë; këra gëteemoa nkëhönyööyöë na mbörabhu kërë mbere yaae, öno kuhika bhonsui töhaane amang'ana gaitö mbere yaae.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö Umunchaama ömönene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono tötagooterra bhökong'u ubhukumia bhöno tuguitabhirria. Kugira ntööna Umunchaama Umuhikërë öno aaya kuhika igörö kuriöbha, nko kögamba iga, Yesö Ömoona wë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama Umuhikërë weitö öyö nköngöra arë öbhörosu bhoitö; we umuene naasaachëröë kë bhaitö guchiteemo chonsui, si taakorrë iraga hai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Tiga tuhike hang'i igitumbë kiö öbhögambi bhöë Ënooköë wë ësaramita tötaana bhoobha, töhaabhöe amaabhe na ësaramita ya gutuurria gönkaaga ya inyaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
