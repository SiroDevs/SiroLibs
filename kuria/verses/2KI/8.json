            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go ikumi na kabhërë go Yoramu ömoona wa Ahabhu, ömögambi wa Isiraeri, Ahasia ömoona o Yehoramu, ömögambi wa Yuta, naatangërë kögambëra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasia naatangërë kögambëra aana ëmeeka mërongo ëbhërë na ëbhërë, akagambërë kurua Yerusaremu gönkaaga yö ömooka gumui. Nyaköwaabho naarë köbhërëkëroa iga Ataria, ömöchökörö wa Omuri ömögambi wa Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira Ahasia naarëngë umuirua wë ëka ya Ahabhu, nawe naagootërë ësëëra yë ëka ëyö ya Ahabhu, naakorrë amanyanku mbere yö ÖMÖNENE, kehaara ëka ya Ahabhu yaakorrë.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
