              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakora gandë gonsui gö ömögambi Yehoramu ngandëkëröë kögëtabhö kia Amang'ana gi Ichinkaaga cha Abhagambi bha Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu agakua agatökëröa guchindua chö öbhögambi kumugi go Tauti, na Ahasi, ömoona o Yehoramu, akagambërë kuibhaga reee.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
