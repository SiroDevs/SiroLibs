              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö abhantö bha Etomu bhagatëëyëra öbhögambi bho Yuta kuhika bhoono igo. Ënkaaga ëyö bheene, abhamenyi bha Ribhuna nabho bhagatëëya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
