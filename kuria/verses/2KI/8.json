      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömögambi Ahasia wa Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
