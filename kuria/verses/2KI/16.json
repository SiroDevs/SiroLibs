                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2 Ich 4:2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömögambi Ahasi akaruusia ho ichinkuurukuurua chino wanyoorrë chaimirribhua haara, akaruusia ho ibhiriga ëno yaare köbhërëkëröa iga inyancha ëno yaarëngë këgörö yi ichintang'ana ikumi na ibhërë chiira chi iriche akagikaria këgörö yö öbhörösa bhöa amagëna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ikibweta këno këgakorrë ëmërëmo urusikö röë Ësabhatö këno wanyoorrë kehagaachöa mönsë yi inyumba hamui na ëkërötëro ge këbhara, ömögambi naabhing'anyiri kurua kunyumba yö ÖMÖNENE gikugira yö ömögambi wa Asuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
