          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
