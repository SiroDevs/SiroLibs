        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa akabhateebhia iga, “Mötatööra ömönyö kuibhakuri iriihëa, hakurua möndentere” Nabho bhakamörentera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa akaya kunyörrö ya amanchë, akarekera ömönyö göyö mönsë na kögamba iga, “ÖMÖNENE aragamba iga: Nkorrë amanchë gano köbha gano gaisaini; gukurua bhoono tëgararente uruku gösë kuruusia nda hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amanchë gayö gakabha gano gaisaini kuhika reero, kebhörë Erisa aagambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa agatanöra kurua Yeriko, akaya Bheteri. Nkaaga aarëngë gönchëra, abhamura nyabhörebhe mbaarichokërë kurua kumugi bhagatanga kömökööyëra bharagamba iga, “Tarua hano, tarua hano nyabhööya!” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa akaihönchöra akabhataachërra na köbhaihiima kuriina riö ÖMÖNENE. Ichitubhu ibhërë ichinkari chikarua masisi, chikarandörra abhamura mërongo ënai na bhabhërë gatai yaabho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        }
      ]
