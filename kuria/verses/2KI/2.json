          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhaana bhëëga bhaara bha abhanaabhi kurua Yeriko hano bhaamörööchë, bhakagamba iga, “Ënkoro ya Eria nërëngë harë Erisa.” Köhayö bhakaya kumuturung'ana, bhakahigama mbere yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakamöteebhia iga, “Bhaitö abhakoramërëmo bhaao ntööna abhakarë mërongo ëtaano; törakögeya öbhaitabhirri bhayi kurigia ömönene waao. Hano ndanyoore Ënkoro yö ÖMÖNENE nimuimukiri na kömötabhuta igörö yi inguku nyabhörebhe gösë kuibhatë.” Erisa akahunchukia iga, “Tiigo hai, monge köbhatöma.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
