          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhantö bha Yeriko bhakagëëra Erisa, na kömöteebhia iga, “Ömönene, kebhörë ökömaaha umugi gönö nu umuuya, sibhoono amanchë gano tönago na amabhëëbhë na nkugira garë ichinda chirarua.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        }
      ]
    },
