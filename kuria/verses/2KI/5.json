              "2KI.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.27"
              },
              "items": [
                {
                  "text": "Ruk 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani, ömökönaare wi iricheesi riö ömögambi wa Samu naarëngë ömöntö ömösööke öno aahanchëröë bhökong'u na ömönene waae, kugira gököhetera harë we ÖMÖNENE naarenteeyë ënsë ya Samu ubhukiri. Ninyoora aarëngë umusirikare ömökarë, naarëngë na amagenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuihi rëno bhaarë guitana na Isiraeri, Abhaasami wanyoorrë bhaimukia ömögöre wë ëkëgaikörö ömörere kurua Isiraeri, nawe akaya arakorra möka Naamani ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö rumui agateebhia möka Naamani iga, “Mbuuya hano ömönene waane akaagëëyë amaahe ömönaabhi ööra arëngë Samaria! Nakamuhueniri amagenge gaae.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.3",
            "verseOrgIds": [
              "2KI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Naamani aaiguurë amang'ana gayö, akaya kömögambi na kömöteebhia amang'ana gö ömoona öyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.4",
            "verseOrgIds": [
              "2KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi wa Samu akamöteebhia iga, “Taimukia inyarubha ëno öherre ömögambi wa Isiraeri.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Naamani agatanöra, na hano aimukiri ichitaranta ibhiköë mërongo ëtatö (30,000) bhia amatiini gi ichimbiria, ichitaranta ibhiköë bhisansabha (6,000) bhië ësahaabhu na ichingëbho ikumi chië ësögökörö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na akahira inyarubha kömögambi wa Isiraeri, ëno ëkögamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömögambi wa Isiraeri aasomërë inyarubha ëyö naatandöyë ichingëbho chaae na kögamba iga, “Igankë ömögambi wa Samu agutuna iga ndere ömöntö öno ana amagenge? Kana gösë nguitegeerra arë iga nu uni në Ënooköë öno ana ögötöra ko guita gösë kuriukia? Mörööchë mbe, iga ömöntö öno ni iriihi aguntuna.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Erisa, ömöntö wë Ënooköë aanyoorrë amang'ana iga ömögambi wa Isiraeri atandöyë ichingëbho chaae, naatömërë amang'ana kömögambi, akamubhuuria iga, “Igankë ötandöyë ichingëbho chaao? Tarenta ömöntö öyö harë uni, korri amanye iga ömönaabhi narëngë Isiraeri!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani akaya na ichibharaasi na irigari reee kuhika gësaku ke Erisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa agatöma ömökoramërëmo waae kuya kömöteebhia iga, “Taya wisaabhe harë muhungatë kömooro go Yorotani, na uwe nörahuene kimui.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Naamani naraarërëëyë bhökong'u, akaya bhooe aragamba iga, “Nënkanyërë iga mmaheene nararichoke na gösaasaama ÖMÖNENE, Ënooköë waae, aheti amabhoko gaae ahasë hano haköndëa na kuhuenia! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë, imioro Abhaana na Bharibhari ëge Tamesike ngëtarë imiiya gökëra imiooro ge Isiraeri? Nëntagaisaabhërë mo na kuhuena?” Agatanöra na kuringa ka na hano arërëëyë bhökong'u.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhaae bhakamögëëra na kömöteebhia iga, “Taata weitö hano ömönaabhi akagöteebhiri iga ökore ëng'ana nyabhörebhe ënkong'u, gösë nötakagekorrë? Ëyö bheene agöteebhiri iga: ‘Taisaabha korri uhuene!’” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Naamani agasëkëra kömooro go Yorotani agaichibhigiria mo harë muhungatë, kebhörë aateebhibhui na Erisa ömöntö wë Ënooköë nawe akahuena kimui. Ëgëkobha keee gëkabhiribhenga gi ikiö ömoona ömöng'eerre. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho aringërë kömontö wë Ënooköë hamui na abhantö bhaae, akagamba iga, “Bhoono nöngöyë iga të Ënooköë örë wonsui aaho gökëbhara, ëtarë iga bheene në Ënooköë wa Isiraeri; köhayö, hano ökahancha wimuki ibhituho bhia abhakoramërëmo bhaao.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa akahunchukia iga, “Ndatuenerria kö ÖMÖNENE öno amenyërë, öno ngökorra ëmërëmo, iga, tënkaimukia igituho kërë gionsui hai.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani akamögeya, sibhoono Erisa akanga kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani akagamba iga, “Hano ndanyoore ötaimuki ibhituho bhiane, hano ökahancha mbe, öhe ömökoramërëmo waao amarobha gano gakaimu-kibhua na ichitëkërë-bharaasi ibhërë, kugira gukurua reero uni ömökoramërëmo waao tëndaruusi ikimuenso ke gösambërëërröa gösë ikimuenso gu ichinooköë chindë ëtarë iga nkö ÖMÖNENE bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga ÖMÖNENE anyabhëre uni ömökoramërëmo waae nkaaga tökögenana na ömögambi waane gösengera köhekaru ya Rimoni ënooköë wa Samu!” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa akamöteebhia iga, “Taya nö ömörembe.” Naamani akaya bhooe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoorrë ataraaya harai, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehasi, ömökoramërëmo wa Erisa ömöntö wë Ënooköë, akagamba iga, “Maaha, ömönene waane ahaatëyë Naamani agëëyë ataimukiri kërë gionsui kurua harë. Kebhörë ÖMÖNENE amenyërë nëndamökënyëre korri nyoore gëntö kurua harë we.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, agatanöra gösoorana Naamani. Hano Naamani aamagiri nyuma, akamaaha ömöntö, aramökënyëra, naikërë kurua kwigari reee akamuturung'ana, na kumubhuuria iga, “Aayi, ngareeya?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
