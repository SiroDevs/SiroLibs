              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke hayö Yehu aasikiri ichisengero cha Bhaari Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.28",
            "verseOrgIds": [
