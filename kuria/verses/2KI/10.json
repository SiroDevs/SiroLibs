            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30"
              },
              "items": [
                {
                  "text": "1 Gam 12:28-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono naakorrë iriraga re Yerobhoamu ömoona o Nebhati ëre götangata Abhaisiraeri bhakore iriraga. Naatöörrë ibhihooru bhi ibhimoori bhië ësahaabhu Bheteri haara na Tani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Yehu iga, “Ökoreeyë abhaibhöroa bha Ahabhu gaara gonsui ntunërë iga öbhakorre. Köhayö nköhaayë ëndagano iga abhaibhöroa bhaao kuhika uruibhöro ro kanai mbaragambërë Isiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Yehu taasöökërë imigiro giö ÖMÖNENE, Ënooköë wa Isiraeri, kömooyo gooe gonsui. Ibhaga reeho naakorrë ke Yerobhoamu öno aahotokiri abhantö bha Isiraeri bhagakora iriraga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
      ]
    },
