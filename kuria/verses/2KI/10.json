              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö ÖMÖNENE naatangërë gusuuhia ëntahana yënsë ya Isiraeri. Ömögambi Hasaeri o Samu agakëra ënsë yonsui ya Isiraeri, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "gukurua ëntahana ya rögörö yö ömooro go Yorotani, na ichinsë cha Gireati, Gati, Reubheni na Manase na kurua Areori göno görëngë kuibhatë re Arinoni, guchinsë cha Gireati na Bhasani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        }
      ]
    },
    {
