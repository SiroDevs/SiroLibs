              "attrs": {
                "loc": "EXO.30.11+EXO.30.12+EXO.30.13+EXO.30.14+EXO.30.15+EXO.30.16"
              },
              "items": [
                {
                  "text": "Ëgt 30:11-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoasi akabhërëkëra abhanchaama na köbhateebhia iga, “Ichimbiria chonsui chino chikuruusibhua kunyumba yö ÖMÖNENE hano chibhe iga chino chiguribhui ibhintö ibhihoreeru, amatiini gi ichimbiria cha këra möntö ëkërengere këno andëkëëyöë, na amatiini gi ichimbiria chino ömöntö aiyiguurë kuruusia gököhaancha kunyumba yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhanchaama bhachimuki kurua harë këra möntö; nabho bhataabhe inyumba harë honsui hagutuna iga hataabhöë.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nhano geehetërë ëmeeka mërongö ëbhërë na ëtatö giö Ömögambi Yoasi, abhanchaama tëwanyoorrë bhaakora öbhötaabhi bhörë bhonsui bhui inyumba hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Ömögambi Yoasi akabhërëkëra umunchaama Yehoyata na abhanchaama bhandë akabhabhuuria iga, “Ndaigua tëmögötaabha inyumba? Bhoono Monge kuimukia amatiini gi ichimbiria kurua köbhantö bhano mögökorra ëmërëmo, gëtatiga mmörachirente, korri inyumba ëtaabhöe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhanchaama bhagaitabhirria iga bhange kuimukia amatiini gi ichimbiria kurua köbhantö, na guiki bhakaragana konga götaabha inyumba yö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyata akaimukia irisandëko akarëhobhora iribhanga kugikundikiriö kerio, hakurua akarëtööra guikëngë ëntahana ya bhörëo bho gösohera kunyumba yö ÖMÖNENE. Na abhanchaama bhano bhaarëngë kuruhuro kuihita mbaatöörrë amatiini gi ichimbiria chonsui chino chaarentëröë kunyumba yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano bhaakarööchë iga irisandëko ndëëna amatiini gi ichimbiria ichincharu, ömöng'orong'omi wö ömögambi na umunchaama Ömonene mbaagasohërë guchibhara na guchibhoha chonsui amahuntu chino chaatöökërë kunyumba yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua hano bhagasookiri guchitiima bhachiha abhakoramërëmo bhano bhaaimërërrëëyë inyumba yö ÖMÖNENE, nabho bhahakana abhahundi na abhatuurria bhano bhaarë götaabha inyumba yö ÖMÖNENE; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na abhahagaachi, abhakengi bha amagëna, na kögöra ichimbaara na amagëna gano gasiitëröë kögötaabhëra inyumba yö ÖMÖNENE na köhëkëërania amatuno gandë gonsui gö öbhötaabhi bhui inyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono amatiini gi ichimbiria chiyö tichahakainöë kobhökori bhui ichibhiriga cha amatiini gi ichimbiria, amagasi ga gökengera ichintambë chi imisumaa, ichibhakuri, ibhirëmbëëta, gösë kubhintö bhindë bhirë bhionsui bhië ësahaabhu gösë amatiini gi ichimbiria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chonsui nchakorrë ëmërëmo ge köhakana abhakoramërëmo bhano bhachikoreeye ëmërëmo giö öbhötaabhi bhui inyumba yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.7"
              },
              "items": [
                {
                  "text": "2 Gam 22:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhano bhaaimërërrëëyë ëmërëmo gëyö mbaarëngë abhaheene kimui, köhayö tikibhune keerë ho ke gutuna kögamba ëkërengere gi ichimbiria chino bhakoreye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.7"
              },
              "items": [
                {
                  "text": "Abhar 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ichimbiria chino charuusiyabhui köbha ikimuenso ki irisaria na ikimuenso ki iriraga tichaasohibhui kunyumba yö ÖMÖNENE hai; chiyö nchabhaayë ibhintö bhia abhanchama.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö Hasaeri ömögambi o Samu agasoherra umugi go Gati akagömeria. Sibhoono hano Hasaeri aabhatërë Yerusaremu korri iga agösoheerre, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.17",
            "verseOrgIds": [
              "2KI.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoasi ömögambi wa Yuta naaimukiri ichisataka chonsui chino wanyoorrë chasabhuurua na bhaguuka abhagambi bha Yuta; Yehosabhati, Yehoramu na Ahasia, na kuengeria ichaae chiira, hamui na ësahaabhu yonsui ëno yaarëngë kömongo yi inyumba yö ÖMÖNENE na inyumba nköraano, agachitöma harë Hasaeri ömögambi wa Samu. Hasaeri nawe akarichoka kurua Yerusaremu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakora gandë gonsui gö ömögambi Yoasi ngandëkëröë kögëtabhö kia Amang'ana gi Ichinkaaga cha Abhagambi bha Yuta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhaae bhakarea inikö kumuisiira, bhakamuitëra kunyumba ya Miro kuirongatë rëno rikuya Sira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano bhaamuitërë mbaabho Yosakari ömoona o Simeati na Yehosabhati ömoona o Someri abhakoramërëmo bhaae. Hakurua bhakamötökëra guchindua chö öbhögambi kumugi go Tauti; na Amasia, ömoona waae akagambëra kuibhaga reee.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.21",
            "verseOrgIds": [
              "2KI.12.21"
            ]
          }
        }
      ]
    }
  ],
