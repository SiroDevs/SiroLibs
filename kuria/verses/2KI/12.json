        "style": "s1"
      },
      "items": [
        {
          "text": "Ömögambi Yoasi wa Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go muhungatë göë ënkaaga yö öbhögambi bhö ömogambi Yehu wa Isiraeri, Yoasi naatangërë kögambëra Yuta gukurua Yerusaremu, nawe akagambëra gönkaaga yë ëmeeka mërongo ënai Yerusaremu haara. Nyaköwaabho niiga Sibhia aakabhërëkëëyöë, kurua Bheri-sebha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga yirimenya reee rionsui naakorrë amaiya mbere yö ÖMÖNENE, gikugira umunchaama Yehoyata naarëngë kumuigia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora niigo, ahasë ha igörö ha gösengera ichinooköë tëhaasariibhui, na abhantö mbaagenderreeyi kumuensa na gösambëra öbhöbhaani ho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
