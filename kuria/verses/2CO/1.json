              "items": [
                {
                  "text": "Ama 18:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni Bhauro, ömötömöa wa Kirisitö Yesö kuguitung'ana na bhööra Ënooköë agutuna, na Timoteo mura ömoitö. Inyarubhha kuya gökanisa yë Ënooköë ëno ërëngë Korinto, gösanga abhantö bhonsui bhë Ënooköë bhano bharëngë harë honsui kömöndaara go Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita na ömörembe kurua kö Ënooköë Taata weitö na Ömönene Yesö Kirisitö bhibhe harë bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro araruusia umukumo kö Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Ënooköë Taata wö Ömönene weitö Yesö Kirisitö ahaabhöe ëgöngo, Taata wa amaabhë, Ënooköë öno harë we ubhutirimikia bhonsui bhuukurua! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëwe agutirimikia kunyaanyi yeitö yonsui, korri iga na bhaitö tötöre gutirimikia abhandë bhano bhaana inyaanyi yiichiteemo hagarëhagarë, gönchëra yu ubhutirimikia bhööra bheene bhaitö abhiene toonyoora kurua kö Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keebhörë imiriiro ge Kirisitö gërëngë emënene harë bhaitö, nkeeho guiki ubhutirimiku bhoitö bhörëngë öbhönene, gököhetera harë Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano tunyoora inyaanyi, ngikugira yu ubhutirimikia na ubhuituuria bhoinyu; na hano totirimikibhhua, ngikugira yu ubhutirimikia bhoinyu. Na ëyö nkököbharentera ichinguru cha kugumirria ëëra bheene na bhaitö bhonsui tukunyoora. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö iriteng'ero reitö harë bhainyu ndëno rëtagusingibhua; ntömanyërë iga keebhörë mörasange imiiriiro geitö, nkeeho bheene mörasange guiki ubhutirimikia bhoitö.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
