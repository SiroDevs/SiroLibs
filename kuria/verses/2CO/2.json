    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö naakengërë ikiina iga nange guucha harë bhainyu guiki köbhahiukiria öbhörrö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.1",
            "verseOrgIds": [
              "2CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano ndabhahiukiri öbhörrö ning'ui aho öno aragire ngooke, gösë tëbhaara bheene naahiukiria öbhörrö? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibhhune këno keegirrë nkabhandëkëra niiga röno ndëkora öbhögeni guucha harë bhainyu, ntagaacha guitumatibhua na bhaara bheene këragërë iga kuhika mbaagooki. Kugira nnëëna öbhöheene na bhainyu bhonsui iga ömögooko goone ngöragire na bhainyu bhonsui möbhe na ömögooko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaabhandëkëëyë nëëna inyaanyi na isina yö ömooyo na amaisori garaharröka; tiiga mbahiukiri öbhörrö hai, sibhoono niiga mbakore möngöre harë haang'ana öbhöhanchi öbhönene bhöno nëëna bho harë bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ësaramita kugira yu umunyamaraga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore ömöntö ahiuikiri öbhörrö, tuuni bheene ahiukiiyi hai, sibhoono gökërengere nyabhörebhe anga ögökora igo harë kaaru köbhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.5",
            "verseOrgIds": [
              "2CO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyaanyi ëno ömöntö öyö aanyoora kurua köbhaaru bhainyu nimuisërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.6",
            "verseOrgIds": [
              "2CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ëgëntö këno gitigaayë niiga mömoobhëre, na mumutirimiki, korri iga atagaacha köbha na öbhörrö öbhönene na gukua nkoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.7",
            "verseOrgIds": [
              "2CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na köhayö ndabhageya möhereki öbhöhanchi bhoinyu harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.8",
            "verseOrgIds": [
              "2CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibhhune këno keegirrë nkabhandëkëra niiga mbasaache na kömanya hanga nkuiguëra mörë amang'ana gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.9",
            "verseOrgIds": [
              "2CO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano moobhëra abhantö kögano bhakorrë, na uni nköbhaabhera ndë kimui. Kugira hano ndanyoore maheene ndaabhëra kërë gionsui, ngökora ndë igo mbere ya Kirisitö gikugira yeinyu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.10",
            "verseOrgIds": [
              "2CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri iga Setani ange kunyoora iribhaga re götökëra; kugira ntömanyërë ichiseemi chaae.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
            "verseOrgIds": [
              "2CO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichinganigania cha Bhauro kumugi go Turoa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
            "verseOrgIds": [
              "2CO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.1"
              },
              "items": [
                {
                  "text": "Ama 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano naahikërë kumugi go Turoa gukurundia Igichiratë igörö ya Kirisitö, nnanyoorrë iga Ömönene aisa kuigöra ëgësaku nköre ho ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono naabhaabhayëëyë bhökong'u, gikugira tënaanyoorrë mura ömöitö Tito hai. Köhayö ngateebhia abhantö bhaaho iga bhatame na ömörembe na ngatanöra kuya Maketonia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökëra köhetera harë Kirisitö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Ënooköë ahaabhöe umukumo, gikugira ruiso ronsui, ngötörongoocha arë körögendo ro gökëra, na gököhetera harë bhaitö ubhurumbaasi bho kömömanya bhonyeregana honsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tönga ubhurumbaasi ubhuuya, bhöno Kirisitö akuruusiria Ënooköë, bhöno bhukumunchaana gatai ya bhaara bhagutuuribhua na bhaara bhonsui bhagusira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhaara bhagusira nu ukurumbaasa köno gökörenta uruku; sibhoono köbhaara bhagutuuribhua, nu ukuruambaasa köno gökörenta öbhöhoru. Ning'ui mbe aisaini kömörëmo göno gönga göyö? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö tëtöönga abhandë abhaaru bhano bhaakuimukia ëng'ana yë Ënooköë kë ëgëntö ëgëtobhu bhagëkorra ubhusuuruusia, sibhoono harë Kirisitö ngusumaacha törë köbhöheene mbere yë Ënooköë kia abhantö bhano bhatömëröë na Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
      ]
    }
  ],
