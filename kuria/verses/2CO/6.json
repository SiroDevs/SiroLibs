            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Ese 37:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kana ëhekaru yë Ënooköë mbuiguërrani kë ënabho hamui na ibhihooru? Kugira bhaitö ntörëngë ëhekaru yë Ënooköë öno aho kuya ëyö! Keebhörë Ënooköë umuene aagambërë iga,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    }
