            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö ndakögeya örë mukungu töhanchane bhonsui. Rëno tiiga ni irirago iriihëa ngökondëkëra hai; ndëno toobha nario gukurua karai. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.5",
            "verseOrgIds": [
              "2JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhöno mbo öbhöhanchi iga tömenye kuguitung'ana na amarago gaae. Na irirago ndëno, keebhörë moiguurë kurua karai niiga mömenye köbhöhanchi.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abharongo abhaaru bharichokera gökëbhara, bharë bhataguitabhirria iga Yesö Kirisitö naachërë këmöbhërë. Öyö mbe nö ömörongo na newë umubhisa wa Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.7",
            "verseOrgIds": [
              "2JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muiraarërre bhainyu abhiene korri mötagaacha götabhuta këëra mookorra ëmërëmo, sibhoono munyoore igituhö keinyu köbhöhëkëëranu.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örë wonsui atakögöma kömaigiö ga Kirisitö sibhoono aragaibhëröka öyö taana Ënooköë. Si örë akögöma kömaigiö ga Kirisitö öyö naana Taata na ömoona waae. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömöntö örë wonsui araache harë bhainyu ataana amaigiö gayö mötakamuirigania moinyu gösë kömökeeria. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.10",
            "verseOrgIds": [
              "2JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örë wonsui akumuirigania na kömökeeria öyö ngösanga arë nawe kömakora gaae amanyanku.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amang'ana ga gösookerria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnëëna amaaru ga kondëkëra sibhoono tingutuna gökondëkëra gökaraamu na ëkarataasi hai. Nguiteng'era ndë guucha na nsumaache na bhainyu gëtonooni, korri ëmëgooko geitö gëhëkëërane. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha musubhaati omoinyu ömoohöröa bhagökeerri.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
            "verseOrgIds": [
              "2JN.1.13"
            ]
          }
        }
      ]
    }
