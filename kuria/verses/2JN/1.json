          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni ömögaaka ndaandëkëra umukungu ömoohöröa na abhaana bhaae bhaara nhanchërë köbhöheene. Guiki tiiga nu uni umuene mbahanchërë hai, gëtatiga nhamui na bhaara bhonsui bhamanyërë öbhöheene ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.1",
            "verseOrgIds": [
              "2JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira öbhöheene mbörëngë mönsë yeitö na mböraabhe hamui na bhaitö kuya ëyö.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
