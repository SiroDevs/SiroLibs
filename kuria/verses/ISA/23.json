          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Na Abhagaritayo, tiiga iga na Abhaasuru, bhano bhatigërë ichitinyi cha masisi chisoheerre umugi go Tiro. Bho mbo bhainaariiyi umugi göyö ëmënaara ge guitanëra, bhagatëmöra ichinyuma chaago na kögökora iritongo.)",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
