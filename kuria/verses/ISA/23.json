              "ISA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö umugi go Tiro ngörëëbhoe gönkaaga yë ëmeeka mërongo muhungatë, ënkaaga yi irimenya riö ömögambi. Hano ëmeeka mërongo muhungatë gëyö gëraahete, umugi go Tiro ngöraisirue gökëëra abhantö bhagusiringia igörö ya abhahurunkani:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 23:16"
