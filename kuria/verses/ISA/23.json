              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ëmeeka mërongo muhungatë gëyö gërahete, ÖMÖNENE naaraahe umugi go Tiro iribhörööta, nago ngörarëngëre gökora guiki ubhuhurunkani bho kuiguria guchihamatë chino chirëngë gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichimbiria chino öranyoore nchiratööroe kö ÖMÖNENE. Umugi uguene tëgöranyoore kenyöngö guchimbiria chiyö hai gëtatiga bhaara bhagösengera ÖMÖNENE mbo bharachigöre ibhiakörëa na ichingëbho ichinchiiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
