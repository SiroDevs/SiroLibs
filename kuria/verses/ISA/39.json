              },
              "items": [
                {
                  "text": "2 Ich 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guiki abhamui bha abhaana bhaao uwe umuene abhë ëgësaacha mbaarëgootöa ubhunyambu nabho mbaraabhe ichinture kunyumba ënköraano yö ömögambi ö Bhabheri.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekia nawe agateebhia Isaya iga, “Ëng'ana yö ÖMÖNENE ëno ögambërë mbuuya ërë.” Nagambërë igo kugira naitegereeyë iga, “Ömörembe na ëgaareeya mbiraabhe ho gönkaaga yonsui yö öbhöhoru bhoone.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
