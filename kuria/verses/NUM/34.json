            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agasimisiria Abhaisiraeri iga, “Ëno niyo ënsë ëno mörameri, nayo mmöratuenane kögëkoobhöe, ënsë ëno ÖMÖNENE aagamba iga, ibhiaro kenda na iritënë bhihaabhöe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiaro ke Rubheni na Gati, na iring'ënga ri ikiaro ke Manase bhaisa kunyoora ömöndö goobho gököreng'aana na ibhisaku bhiabho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiaro bhibhërë bhiyö na iritënë ri ikiaro ke Manase bhianyoora ömöndö goobho ihumbu yö ömooro go Yorotani ëntahana ya rögörö ro Yeriko haara iriöbha rëgötörra.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhatangati bhano bharaimëërre igitueno gënse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga: Gano ngo amariina ga abhantö bhano bharabhatuenani ënsë ëyö mukuya körëa ömöndö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eriasari umunchaama na Yosua ömoona o Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wimuki ömötangati umui kurua këra kiaro wa kugutuurria kubhutuenania bhuë ënsë.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amariina gaabho:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        }
      ]
