                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia Abhaisiraeri iga, Ömöntö örë wonsui, ömösaacha gösë ömögaikörö, hano akorrë iriraga rërë rionsui rëno rëkömökora abhöra ubhukumia kö ÖMÖNENE waae, na abhe na irisaria, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhika atöbhöre iriraga reee rëyö akorrë, na aruusi irihaki rionsui ri iriraga reee na kuengeria ëgëntö kimui igörö ya këra ibhintö bhitaano bhino aruusiri, na ahakane öra akoreeye iriraga rëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano naho ndanyoore ömösarribhua ataaho aakuurë na taana möntö orutundrra öwa hang'i öno akaimukia ëhakano ëyö, hayö bhoono irihaki rëyö rirusibhue kö ÖMÖNENE rëbhe ëgëntö kia abhanchaama; irihaki rëyö riyi hamui na iring'ondi iguruki rë ësönsööro, rëno arasönsööre gikugira yi iriraga reee. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësataaka ërë yonsui na ëgëntö ëkëhoreeru këno këraruusibhui na Abhaisiraeri, gökörentera umunchaama, nëraabhe iyaae. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ëgëntö kiö ömöntö ëkëhoreeru kërë gionsui gëtöörröë kö ÖMÖNENE nkëraabhe ëkeee; kërë gionsui ömöntö örë wonsui ahaayë umunchaama nkëraabhe ëkeee.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:10",
              "type": "text"
            },
            {
              "text": "Ësësöro tëyöngökaini bhuuya na amandikö gë Ëkebhurania nago tëgaamchencho hai",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhiina bhia abhakari bhano bhasaacha bhaabho bhaana isi nabho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia Abhaisiraeri iga, hano ömökari örë wonsui wö ömöntö wanyoora ataamërë abhörrë öbhöheene harë mösaacha waae, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12",
            "verseOrgIds": [
              "NUM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "araare na ömöntö wöndë, mösaacha waae atamanyërë na möntö wöndë örë wonsui atamanyërë iga hai, aikoreeyë ibhikui sibhoono tëmöntö atöökërë kömötöbhöra kong'ana ëëra akorrë, gikugira tagootëröë ikiruugi hai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mösaacha waae hano araabhe na isi harë mökaae öno aikoreeyë ibhikui gösë akorrë irihari harë mökaae ninyoora handë mökaae taitörëëyë ibhikui hai, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "hayö bhonsui bhabhërë bhayi kumunchaama na kuhira ësataaka ëno ëragërë, nayo ni iring'ënga re ikumi riö öbhöse bhöë ësayiri, sibhoono bhonge götööröa maguta gösë ubhurumbaasi, gikugira në ësataaka yi ibhiakörëa ëno ömösaacha öno ana irihari harë mökaae, ësataaka yi ibhiakörëa ëno ikuruusibhua gikugira yi irisaria rëno rëherekiibhui.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umunchaama ahire ömögaikörö öyö na kumuimiirria mbere yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua umunchaama ahöme amanchë amahoreeru kurugiö, sooki aimuki urutu kurua hansë yi iritume mööra, na körötööra kömanchë gayö korri garrröe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama atööra ömögaikörö mbere yö ÖMÖNENE na köhönyöra ituukia yaae na kömöha gaae ësataaka yi ibhiakörëa ëyö, ëno ërëngë ësataaka yi ibhiakörëa bhino bhirusiibhui gikugira yi irihari re mösaacha waae. Umunchaama nëwe umuene aragooterre ëgëntö këëra nyamanchë marrrö gano gakörenta imiihiimo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua umunchaama atueneerri ömögaikörö öyö aragamba iga, ‘Hano ndanyoore ötaraayë na mösaacha wöndë örë wonsui na kuirentera ibhikui, naho mbe nörëngë köbhömaahirri bho mösaacha waao, töranyooroe na imiihiimo gënö gëkörëntöa na amanchë amarrrö gano hai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore wahotoka na hano mbe mösaacha waao önawe, ögaitööra ibhikui gököraara na ömösaacha wöndë öno atarë mösaacha waao, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nëho umunchaama aratueneerri imiihiimo ömökari öyö iga, ÖMÖNENE aköhe iritemo, na uwe öbhe imiihiimo köbhantö bhaao, öbhe ömögömba na ënda yaao ibhimbe.’” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amanchë gano gakorenta imiihiimo gabhe öbhörrö könda yaao na kögökora ömögömba na ënda yaao ibhimbe.” Ömögaikörö ööra nawe ahunchuki iga, “Amina! Amina!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua umunchaama andëke imiihiimo gëyö kögëtabhö na kugiogia kömanchë amarrrö gaara; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.23",
            "verseOrgIds": [
              "NUM.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakurua aniisi ömögaikörö ööra amanchë amarrrö gano gakörenta imiihiimo, nago ngarasohe mönsë yaae na kömökoorra öbhörrö öbhönene bhui imiihiimo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki umunchaama aimuki ësataaka yi ibhiakörëa bhi irihari kurua kömabhoko gö ömögaikörö öra na asingisi ësataaka yi ibhiakörëa ëyö mbere yö ÖMÖNENE na agihire guikëngë re gösengera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki, umunchaama aimuki ënsanyi yë ësataaka yi ibhiakörëa ëyö ëbhe ikimuenso kë ëhëëtöko na gësambërëërröe guikëngë re gösambërëërröa. Kögösookerria, aniisi ömögaikörö öyö amanchë gayö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano arasooki köganyua hano ndanyoore aitööra ibhikui na ataarë möheene harë mösaacha waae, amanchë gayö gakörenta imiihiimo ngaramörentere öbhörrö öbhönene bhökong'u, na ömöbhërë gooe ngörabhimbe, na ënda yaae yu ubhuibhuri nërasarëke. Na ömögaikörö öyö naraabhe umuihiimo köbhantö bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano naho ndanyoore ömögaikörö öyö taikoreeyë ibhikui na taana isaria, hayö tëgaramökore gëntö hai na naragenderri kuibhöra abhaana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
