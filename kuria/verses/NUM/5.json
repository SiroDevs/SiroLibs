          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Göno ngo umugiro go gökora köbhano wanyoora bhaana ikiina ki irihari, hano ömögaikörö ninyoora ana mösaacha waae ahotokërë na guitööra ibhikui, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "gösë ënkaaga ëno ömösaacha akorrë irihari na körongohera mökaae. Kuhika arente ömögaikörö öyö kö ÖMÖNENE na umunchaama amökorre umugiro gonsui göyö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömösaacha taraabhe na bhöbhëëbhë bhörë bhonsui kö ëyö hai gëtatiga nö ömögaikörö öra arabaharröe ubhunyanku bhooe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
            "verseOrgIds": [
              "NUM.5.31"
            ]
          }
        }
