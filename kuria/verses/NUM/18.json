                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Ëhë 14:22-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Na Abharawi, mbahaayë iring'ënga re ikumi rionsui rëno Abhaisiraeri bhakunduusiria rëbhe ömöndö goobho, ndio rëraabhe irihaki reebho kömërëmo gëëra bhaagökora guitunteera re gusikanëra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua bhoono igo, Abhaisiraeri bhandë bhano bhariihe gusugatërra iritunteera re gusikanëra bhatagaacha gökora iriraga na kuirenterria uruku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Abharawi abhiene mbo bharakore ëmërëmo guitunteera re gusikanëra; na guitungua nario kimui. Ënö në ëng'ana ihiku kuya ëyö, kömaköra gainyu gonsui. Abharawi tëbharaabhe na möndö gobhintö gönsë ya Isiraeri hai, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikugira naabhaha iring'ënga re ikumi rëno Abhaisiraeri bhaköndentera köbha ömöndö goobho. Nkio kegira nabhateebhia iga, tëbharaabhe na ömöndö gui ibhintö kö Abhaisiraeri hai.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iring'enga re ikumi ria Abharawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Guiki usumaache na Abharawi öbhateebhi iga: Hano mueimukia kurua kö Abhaisiraeri iring'ënga re ikumi rëno ÖMÖNENE aabhahaayë rëbhe ömöndö gueinyu, munduusiria Uni ÖMÖNENE iring'ënga re ikumi kuing'ënga re ikumi rëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësataaka yeinyu ëno nëraitabhiribhue köbha kiö öbhötongore gösë ichisabhibhu chino umurimi akunduusiria. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo na bhainyu mbo möraayi möranduusiria Uni ÖMÖNENE iring'ënga re ikumi rëno möraayi möranyoora kurua kö Abhaisiraeri. Iring'ënga rëyö möraayi möranduusiria Uni ÖMÖNENE möha umunchaama Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua kubhiruusiö bhionsui bhino möraayi möranyoora, möraayi mörarusiria ÖMÖNENE ësataaka yi iring'ënga iriiya na irihoreeru gökëra gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe öbhateebhi iga, ‘Hano moosookia kunduusiria iring'ënga iriiya gökëra bhionsui, bhiira bhitamërë bhibha ibhienyu, keehaara umurimi akuimukia kërë gëtamërë hano asookia kuruusia ësaataka yö öbhötongore na itibhaai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe hamui nörösabho rooo möratöra körëa ibhiakörëa bhiyö bhitamërë na mubhinyeere harë honsui möratune kubhinyeera; gikugira bhiyö mbio irihakano reinyu kömërëmo gëëra mögökora guitunteera re gusikanëra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Töranyoore mökorrë iriraga rërë rionsui hai gökörëa ibhiakörëa bhiyö, hano wanyoora muruusiiyi ÖMÖNENE iring'ënga iriiya gökëra bhionsui. Sibhoono kuhika muimaahërre mötagaacha körëa ibhiruusio ibhihoreeru bhia Abhaisiraeri mötaruusiri mo iring'ënga iriiya rëëra riö ÖMÖNENE, hano mörakore igo möraakue.’”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
        }
      ]
    }
  ],
