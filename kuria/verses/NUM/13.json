            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira yë ëngamba yö ÖMÖNENE, Mösa agatöma abhantö kurua guiköngö re Bharani. Bhonsui bhano bhatömëröë mbaarëngë abhatangati bhi ibhiaro bhia Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
