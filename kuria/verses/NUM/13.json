        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Töma abhantö bhayi ërooti gökëbhara gë Kanaani, këno nköha ëhamatë ya Abhaisiraeri. Ötöme ömöntö umuiumui kurua këra ikiaro, ömöntö öyö kuhika abhe ömötangati gukiaro keee.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        }
      ]
    },
    {
