                  "text": "Abhar 16:29-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Urusikö ro ikumi ru umueri go muhungatë möraayi mörakora umuiraniö ömöhoreeru. Urusikö röyö muisasa na monga gökora mörëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muruusiri ÖMÖNENE ikimuenso ke gösambërëërröa kömörro, isiisui inchiiya ya götegeria ÖMÖNENE: Ëkëgaini igichaahe kimui, iguruki imui, ibhiguruki muhungatë bhiö ömooka gumui, bhionsui bhiyö bhibhe bhino bhitaana isoro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hagarë bhiyö mmöraruusi ësataaka yö öbhöse bhöno bhuichoganibhui amaguta bhui ichikiiro isatö kögaini ëyö na chikiiro ibhërë hamui na iguruki ëyö ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ikiiro imui harë këra kiguruki kubhiguruki bhiyö muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mmöraruusi ëgorohe yi ikimuenso ki iriraga, gutiga ikimuenso gë ësönsööro, hamui na ikimuenso ke gösambërëërröa ke ruiso ronsui na ësataaka yi ibhiakörëa yaakio na ibhinyuëbhöa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
        }
      ]
    },
    {
