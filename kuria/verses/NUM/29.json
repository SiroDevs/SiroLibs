        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.22",
            "verseOrgIds": [
              "NUM.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Urusikö ro kanai mmöraruusi: Ichigaini ikumi, ichiguruki ibhërë, ibhiguruki ikumi na bhinai bhionsui bhino bhitaana isoro, ",
          "type": "text",
          "attrs": {
