              "NUM.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Urusikö ro kabhërë muruusi ichigaini ichinchaahe ikumui na ibhërë, ichiguruki abhërë, ibhiguruki ikumi na bhinai bhino bhirëngë bhiö ömooka gumui na bhionsui bhiyö bhibhe bhino bhitaana isoro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki muruusi ësataaka yi ibhiakörëa, hamui na ikiruusio ki ibhinyuëbhöa, na ichigaini chiira, ichiguruki na ibhiguruki, bhionsui bhiruusibhue köreng'aana na öbhörengeerria bhui ibhiruusio bhi itubho ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na guiki muruusi ëgorohe imui yi ikimuenso ki iriraga, gutiga ikimuenso ke gösambërëërröa këëra ke ruiso ronsui, na ësataaka yi ibhiakörëa na ësataaka yi ikinyuëbhöa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.19",
            "verseOrgIds": [
              "NUM.29.19"
            ]
          }
        }
      ]
