              "NUM.17.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Ibr 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icho yaho, Mösa akaya guitunteera re gusikanëra, na kunyoora iga, inyimbo ya Haruni wi ikiaro kia Abharawi, ësëbhökërë na kuruusia ibhisekere na kooma amakö gö ömörosi amatobhu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.8",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki Mösa akarichokia ichinyimbo chonsui këbhara kurua mbere yö ÖMÖNENE, akoorokia Abhaisiraeri bhonsui, na këra mötangati akaimukia inyimbo yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.9",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, “Ringia inyimbo ya Haruni guisandëko ri Imuuma. Nayo ëbhëëköe hayö, na në ëkëmanyiirriö köbhaara bhonsui bhakunyirumungiria, bhahaatëre bhatagaakua.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.10",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agakora keebhörë wanyoorrë aragirribhui na ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagateebhia Mösa iga, “Maaha mbe bhoono! Ntörasike! Tusirre! Bhonsui tusirre. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öre wonsui araayi arahika hang'i iritume riö ÖMÖNENE, naraayi arakua. Gösë mbonsui töraakue tusire?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.13"
            ]
          }
        }
      ]
    }
