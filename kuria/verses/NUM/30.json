        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhörengerria bhui ichindagano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
