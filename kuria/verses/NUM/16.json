      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akaimöka na kuya harë Tatani na Abhiramu, na abhagaaka bha Isiraeri bhakaya hamui nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.25",
            "verseOrgIds": [
              "NUM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agateebhia ëhamatë yonsui iga, “Ndabhageya mötarua kömagutu ga abhantö abhataniini bhano, na muriihe kögoota ëgëntö keebho kërë gionsui, mötagaacha musikibhue hamui nabho gikugira ya amaraga gaabho gonsui.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.26",
            "verseOrgIds": [
              "NUM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ëhamatë ëkaiheenia kurua kömagutu ga Kora, Tatani na Abhiramu. Tatani na Abhiramu bhakarichoka kurua kömagutu gaabho na kuimëërra kubhisaku bhiabho hamui na abhakari bhaabho na abhaana bhaabho körenga ibhing'eerre. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.27",
            "verseOrgIds": [
              "NUM.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agateebhia abhantö iga, “Bhoono mmöröngöre iga, nö ÖMÖNENE antöma gökora gano gonsui, tiiga nkugutuna koone umuene hai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhantö bhano bharakue uruku ronga urua abhantö bhonsui, gösë bhanyooröë na ëtabhaaribhaaria kia abhantö bhandë, möngöre iga ÖMÖNENE taantömërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ÖMÖNENE arakore ëng'ana ëno ëtaagakorekaini, irirobha reetëke na kömera abhantö bhano hamui na ibhintö bhiabho bhionsui, bhasëkëre kuya Bhui bhabhahoru, nëho möröngöre iga abhantö bhano nö ÖMÖNENE bhaasera.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo asookiri kögamba amang'ana gayö gonsui, irirobha rëgaatëka hansë ya Tatani na Abhiramu rëgaasama ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kömera abhantö bhayö na abhantö bhaabho bhonsui, hamui na irikomo re Kora na ibhintö bhiabho bhionsui. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
              "NUM.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö bhonsui bhayö hamui na ibhintö bhiabho bhionsui bhagasëkëra kuya Bhui bhabhahoru, na irirobha rëkabhakundikiria, bhonsui bhagasika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
              "NUM.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhonsui bhano wanyoorrë bharëngë hang'i, hano bhaiguurë ikuuratë yaabho mbaakënyëre kurua ho bharagamba iga, “Tötang'osa, irirobha rëtagatömera na bhaitö!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömörro gökarua kö ÖMÖNENE, gösambërëërra abhantö amagana abhërë na mërongo ëtaano (250) bhaara wanyoorrë bhaagëëyë kuhusiria öbhöbhaani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhihusirio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.36",
            "verseOrgIds": [
              "NUM.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia Eriasari, ömoona wu umunchaama Haruni aruusi ibhihusirio bhiyö kömörro, anyeragani ömörro göno göömo, gikugira ibhiruusio bhiyö na ibhihoreeru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.37",
            "verseOrgIds": [
              "NUM.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhibhaayë ibhihoreeru gikugira abhantö bhano mbaabhirentërë guikëngë riö ÖMÖNENE. Maaha, wimuki ibhihusirio bhia abhantö bhayö bhaitëröë gikugira ya amaraga gaabho, bhiturue bhinyerrehe korri bhibhe igikundikiriö ki irikëngë rë ësengero. Rëyö ndëraabhe ëkögo kö Abhaisiraeri bhonsui.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe umunchaama Eriasari akaimukia ibhihusirio bhiyö bhi iriche bhino bhiarentëröë na abhantö bhaara bhaasambërërrëëyöë, bhigaturua köbha igikundikiriö ki irikëngë rië ësengero. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.39",
            "verseOrgIds": [
              "NUM.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rënö ndërëngë ëkögo kö Abhaisiraeri iga, örë wonsui atarë umunchaama, öno atarë iga nu uwurutundrra ro Haruni, ariihe kuya guikëngë rë ësengero köhöötëra ÖMÖNENE öbhöbhaani. Ëtarë igo, naraitue ge Kora na irikomo reee. Gonsui gayö ngaakorekaini keebhörë ÖMÖNENE wanyoorrë aragirriiyi Eriasari köhetera harë Mösa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haruni aratuuria abhantö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icho yaho ëhamatë yonsui ya Abhaisiraeri ëkairumungiria Mösa na Haruni bharabhööra iga, “Muitërë abhantö bhö ÖMÖNENE” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.41",
            "verseOrgIds": [
              "NUM.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhakuirania harë Mösa na Haruni köbharörötëra, bhakaihönchöra köbhata kuya guitunteera re gusikanëra, bhakamaaha irisaaro rigubhërë iritunteera na ubhukumahe bhö ÖMÖNENE bhökamaahëkana ho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.42",
            "verseOrgIds": [
              "NUM.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa na Haruni bhakaya bhakaimëërra mbere yi iritunteera re gusikanëra, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.43",
            "verseOrgIds": [
              "NUM.16.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 16:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Öbh 18:20-25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.44",
            "verseOrgIds": [
              "NUM.16.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ahökana na abhantö bhano, korri mbasiki harë rimui!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.16.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bho bhakahongoka igo bhakahurama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.16.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 16:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agateebhia Haruni iga, “Imukia ikihusirio keeo, ögëtööre ömörro na kögëtööra mbarëka ya irikëngë rë ësengero, sooki ögëtööre öbhöbhaani hakurua uyi nakio bhöngöbhöngö köbhantö na köbhakora ësönsööro. Taangoha! Ubhösinanku bhö ÖMÖNENE bhöbhahëkërëëyë na öbhöhëndö bhöbhatangërë.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.46",
            "verseOrgIds": [
              "NUM.16.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 16:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe Haruni agakora keebhörë ateebhibhui na Mösa. Akaimukia ikihusirio keee agakënya kuya gataigatai ya abhantö bhano wanyoorrë bhairaini hamui. Hano aarööchë iga öbhöhëndö bhötangërë köbhantö, agatööra öbhöbhaani gukihusirio na gökoorra abhantö ësönsööro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.47",
            "verseOrgIds": [
              "NUM.16.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 16:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aakoorrë igo öbhöhëndö mbosirrë, nawe agatama aimërëëyë gataigatai ya abhakuurei na abhahoru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.48",
            "verseOrgIds": [
              "NUM.16.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 16:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëkërëngere kia abhantö bhano bhaakuurë na öbhöhëndö, mbaarëngë ibhiköë ikumi na bhinai na amagana muhungatë (14,700), gökonga köbhara bhaara bhaakuurë köbhötanini bho Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.49",
            "verseOrgIds": [
              "NUM.16.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 16:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano öbhöhëndö bhoosirrë, Haruni akaringa harë Mösa gësaku ki iritunteera re gusikanëra.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.50",
            "verseOrgIds": [
              "NUM.16.50"
            ]
          }
        }
      ]
    }
