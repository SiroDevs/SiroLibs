            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ömöntö örë wonsui araite ömöntö, narakengeröe ikiina ke guitua hano ndanyoore abhasuuti bhaae bhatökërë bhabhërë gösë köhëtëëra; ömöntö örë wonsui atagaacha gökengeröa ikiina ke guitua gikugira yumusuuti umui bheene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        }
