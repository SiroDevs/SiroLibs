            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imigiro gëno ngëragootoe kömaköra gainyu gonsui köhase harë honsui wanyoore mömenyërë.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        }
