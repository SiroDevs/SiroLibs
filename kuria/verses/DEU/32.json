              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agaacha mbere ya Yosua ömoona o Nuni, bhagasiriingia amang'ana gi irisiringiö rëno, korri iga Abhaisiraeri bhonsui bhariigue.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaragirrio ga gösookerria ga Mösa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
