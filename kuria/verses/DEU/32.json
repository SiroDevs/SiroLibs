            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 32:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Mösa aasookiri göteebhia Abhaisiraeri amang'ana gano gonsui, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabhateebhia iga, “Tööra kumioyo geinyu amang'ana gano gonsui nköbhaha reero. Kuhika musimisiiri abhaana bhainyu korri bhagoote köbhöheene amang'ana gonsui gi imigiro gëno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira amarago gano tamang'ana amachua hai, sibhoono ngo amabhaho gainyu; komarago gano mörabhe na amabhaho amatambë gönsë ëno mukuya kuigaria, ihuumbu yö ömooro go Yorotani.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
    },
