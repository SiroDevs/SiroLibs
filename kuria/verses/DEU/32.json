                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Ëhë 3:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kurusikö röyö bheene ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Riina kunguku ëno ya Abharimu na kuhika kurusung'unuuni ro Nebho gönsë ya Moabhu, ëno ëtachërraini nu umugi go Yeriko, örekere amaiso ömaahe ënsë ya Kanaani ëno nkoha Abhaisiraeri bhagigari. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ukuëre kunguku ëyö ke bhööra mura ömoinyu Haruni aakuërëëyë kunguku ya Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira bhainyu bhonsui moosarri mbere ya abhaana bha Isiraeri hano moorëngë kömanchë ga Meribha, hang'i na umugi go Gatesi, guiköngö re Sini, mögakëröa koorokia öbhöhoreeru bhoone kö Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nöramaahe ënsë ëyö nköha Abhaisiraeri bhamenye mbere yaao, sibhoono torahike ho hai.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
