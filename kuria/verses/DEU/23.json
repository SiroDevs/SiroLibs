          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano örahetere kömögöndö gui ibhiakörea bhiö ömöröbheri waao nö gatua ibhigara nö ököbhoko ubhunge örë, sibhoono ötakaimukia ënköbhëro kögesa ibhiakörea bhiae.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
