          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.29"
              },
              "items": [
                {
                  "text": "Abhar 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuisiraeri örë wonsui, ömösaacha gösë ömökari, taraitabhirribhue köbha umuhurunkani wö öbhösengeri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichimbiria chirë chonsui chëratööke gukurua kubhuhurunkani bhöyö, change kuhirua guitunteera riö ÖMÖNENE, Ënooköë weinyu, köhakanëra ëndagano, gikugira ömösaacha gösë ömökari öno arëngë umuhurunkani wö öbhösengeri ni ikiriirriö kö ÖMÖNENE.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        }
      ]
    },
