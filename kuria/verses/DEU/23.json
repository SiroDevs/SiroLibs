        },
        {
          "text": "“Hano öraahete kömögöndö göë ëmësabhibhu giö ömöröbheri waao nö karea ichisabhibhu kögötöra koo, sibhoono wange gutua na kuimukia ichisabhibhu chirë chonsui gökëgabhö keeo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
