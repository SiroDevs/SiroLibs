            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.33"
              },
              "items": [
                {
                  "text": "Mat 5:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano öraragane ÖMÖNENE, Ënooköë waao, wanga götëgëta kögëhëkëërania, kugira ÖMÖNENE, Ënooköë waao naragitune harë uwe, na uwe nörabhe na iriraga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano örange köragana töraabhe na iriraga hai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wimaahërre köhëkëërania ëndagano yu umunyua gooo, gikugira waragaini ÖMÖNENE, Ënooköë waao, kuigonche reeo.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
