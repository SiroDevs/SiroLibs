            }
          ]
        },
        {
          "text": "“Bhainyu na abhantö bhö ÖMÖNENE, Ënooköë weinyu mörënge. Igo, hano mögököörra umukuurë monga guitara gösë kugingira öröhara, kehaara abhantö bhandë bhaagökora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
