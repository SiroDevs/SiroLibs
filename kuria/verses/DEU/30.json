              "DEU.30.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Sir 15:16,17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Reero röno ndabhaha öbhoohuri igörö ya amaiya na amabhëëbhë; igörö yö öbhöhoru na uruku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore mösöökërë amarago gö ÖMÖNENE, Ënooköë weinyu, gano nköbhaha reero, mörëhanche ÖMÖNENE, Ënooköë weinyu, na gösoorana ichinchëra chaae, na kögoota amarago, imigiro na amaragirrio gaae, hayö möraamenye na kuiyengeria; ÖMÖNENE, Ënooköë weinyu, nawe narabhaitabhiri gukiaro këyö mukuya kuigaria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano mörahotoke na konga kuigua, mötegeribhoe gösengera ichinooköë chindë na guchimuensera, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "uni ndabharundiria reero röno iga mörasike. Tëmöramenye gönkaaga ëntambë hai gukiaro këyö mukuya kuigaria, ihumbu yö ömooro go Yorotani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhërëkëra iriöbha na ëkëbhara bhihereki igörö yeinyu reero röno, iga mbahaayë öbhoohuri bhö öbhöhoru na uruku, öbhöë ëmësaaraaro na imiihiimo. Bhoono, mötaahöra öbhöhoru bhainyu nu uruibhöro röeinyu mötöre kömenya,” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "Ögt 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.3"
              },
              "items": [
                {
                  "text": "Ögt 26:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "Ögt 28:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hano mörahanche ÖMÖNENE, Ënooköë weinyu, mösööke ëngamba yaae na kögenana nawe. Kugira gökora igo nkoorokia körë iga möranyoore irimenya iritambë na kömenya gukiaro këno ÖMÖNENE weinyu aaragaini bhaguuka bhainyu, Ibhurahimu, Isaaka na Yakobho iga narabhahe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
      ]
    }
