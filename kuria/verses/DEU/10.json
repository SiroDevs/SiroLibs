            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.38"
              },
              "items": [
                {
                  "text": "33:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Abhaisiraeri mbagendërë örögendo kurua kubhisima bhia abhantö bha Yaakani kuhika Mosera. Hayö nëho Haruni akuëreeyë agatökëroa. Umumura waae Ereasari akaimukia iribhaga reee riu ubhunchaama. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua hayö bhakagenda na kuhika Gutigota, na gukurua Gutigota bhakahika Yoti-bhata öröng'ongo röno rööna ibhitabhöka ibhiaru bhia amanchë. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8"
              },
              "items": [
                {
                  "text": "Ëbh 3:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Enkaaga ëyö ÖMÖNENE naahööyë ikiaro kia Abharawi bhayi bharaimukia Irisandëko ri Imuuma yö ÖMÖNENE, bhabhe abhanchaama bhaae, na guitabhiria abhantö kuriina reee kuhika reero. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ya ëyö ikiaro kia abhantö bha Rawi tëkëëna iring'enga riö ömöndö guë ënsë hamui na bhamura omoobho; kërë bhaanyoorrë në ësööko ya köbha abhanchaama bhö ÖMÖNENE, ke bhööra ÖMÖNENE, Ënooköë weinyu, aragaini.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
