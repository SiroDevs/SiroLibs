              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Mösa akandëka irisiringiö rëyö kurusikö röyö bheene, akaigia Abhaisiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
