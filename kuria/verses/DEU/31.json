              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa agasiriingia irisiringiö rëno mbere yu umuiiranio gonsui go Abhaisiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
