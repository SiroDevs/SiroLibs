            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wange kunyanyuura ömökoramërëmo ömötaka na öno agutuna ubhutuurria, abhe mura ömoinyu Umuisiraeri gösë umui wa abhahamatë bharë bhamenyërë ku gumui gui imigi geeo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöhakane ëhakano yaae iriöbha rëtarasëkëra, gikugira nö ömötaka na ngökora arë ëmërëmo kuguitëng'ëra amatiini gi ichimbiria chiyo. Hano örange kömöhakana, naraköörre ÖMÖNENE na uwe ömahëkane köbha ni irisaria ri iriraga.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
