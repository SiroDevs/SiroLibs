                }
              ]
            }
          ]
        },
        {
          "text": "“Mötagaacha gökoonya öbhöheene bhoa abhahamatë na ichintakaana; gösë mötagaacha kuimukia ëngëbho yu umusino götööra këgooterro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
        {
          "name": "verse",
