              "text": "\n        Abhar 13:1—14:54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ömöntö araroore amagenge nkëragëre iga muimaahërre kögoota amaragirrio ga Abharawi. Bhööra naabhasimisiiyi mbo mörakore gukuiyangarra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Ëbh 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Möhëëtöke bhörë ÖMÖNENE, Ënooköë weinyu aakoreeyë Miriamu harë moorë körögendo kurua Misiri.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
