              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Öbh 2:4; 5:9-13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono möntegeerre, bhainyu bhano mökögamba iga, “Reero gösë icho nturiya kumugi nyabhörebhe, harë törëbheera kömooka umugima törakora ubhusuruusia na kunyoora ichimbiria ichincheru.” ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu mötamanyërë irimenya reinyu niyekë rërëbha icho! Bhainyu mönga induumbe, ëno ëkömaahëkana gönkaaga nke hakurua isira. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.14",
            "verseOrgIds": [
              "JAS.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuibhaga rëyö nkëragërë mögambe iga, “Hano ndanyoore Ömönene ahanchërë, ntöraabhe ho na ntörakore gano na gaara.” ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.15",
            "verseOrgIds": [
              "JAS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhainyu nkuiraha möre na kuiheema; ukuiraha könga köyö nö ököbhëëbhë. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.16",
            "verseOrgIds": [
              "JAS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbe, ömöntö öno atagökora amaiya gano garagërë iga aköre öyö ngökora arë iriraga.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.17",
            "verseOrgIds": [
              "JAS.4.17"
            ]
          }
        }
      ]
    }
  ],
