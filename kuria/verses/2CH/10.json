              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.1"
              },
              "items": [
                {
                  "text": "2 Sam 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhantö bhonsui bha Isiraeri hano bhaarööchë iga, Ömögambi angerë götondöörröa nabho bhakamöteebhia iga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö abhantö bhonsui bha Isiraeri bhakaringa waabho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
