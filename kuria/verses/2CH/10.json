              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Rehobhoamu naagambëyë abhantö bha Isiraeri bhano bhaamenyërë kumigi ge Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki Ömögambi Rehobhoamu hano aatömërë Hatoramu öno aarëngë umuimiriirri ömönene wë ëmërëmo ge köhamiirribhua, abhantö bha Isiraeri mbaamörasërë na amagëna bhakamuita. Nëho Rehobhoamu aarinërë bhöngöbhöngö kuigari reee akang'osera Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.18",
            "verseOrgIds": [
              "2CH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö mbe, abhantö bha Isiraeri bhaabha gösëëra ëyö yö öbhöteeyu guisiira öbhögambi bhöë ëka ya Tauti kuhika reero.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.19",
            "verseOrgIds": [
              "2CH.10.19"
            ]
          }
        }
      ]
