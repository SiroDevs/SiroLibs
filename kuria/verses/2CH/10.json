{
  "id": "2CH.10",
  "number": "10",
  "bookId": "2CH",
  "reference": "2 Amang'Ana Gi Ichinkaaga 10",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
