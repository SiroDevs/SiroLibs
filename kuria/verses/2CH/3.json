            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora öbhömarataati ituubho ya ichimbisia igörö yi imitimö geyö, guiki agakörönga kömang'oore ga amakomamanga irigana rimui (100). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaimiirria imitimö geyö komonëngö göë ëhekaru, umutimö ugumui ëntahana ya söchë, na ëkëndë ëntahana ya Mööchë; goora gë ëntahana ya Sööchë akagoröka iga Yakini, na gööra goorëëngë möchë aaröka iga Bhoasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
