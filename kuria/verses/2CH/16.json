    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuta na Isiraeri chirahëtërana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mërongo ëtatö na ësansabha gö öbhötangati bhö ömögambi Asa, Bhaasa, ömögambi wa Isiraeri, naitaini ënsë ya Yuta, na götanga köhagaacha umugi go Rama korri atöre gökaania möntö örë wonsui ange kurichoka gösë gösoha kömögambi Asa wa Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.1",
            "verseOrgIds": [
              "2CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ömögambi Asa aimukiri amatiini gi ichimbiria na ësahaabhu kurua kömongo yi inyumba yö ÖMÖNENE na kurua kunyumba nköraano yö ömögambi, agatöma, “Tamesike kuya harë Bheni-hatati, ömögambi wa Samu aragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndagosabha iga, togootanë kehaara Taata na isaweinyu bhaakorre; maaha ngotomëëye amatiini gi ichimbiria chiyö na ësahaabhu köbha igituho; taya ösari ubhuiguërrani bhö öbhögotaini bhooo na Bhaasa ömögambi wa Isiraeri korri atige kunyitania.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Bheni-hatati agaitabhirria irisabhi riö ömögambi Asa, agatöma abhakönaare bhaae na amacheesi gaae kuya guitania imigi ge Isiraeri. Bhakameria imigi ge Iyoni, Tani, Abheri-maimu, na imigi gionsui ge Nabhutari gëno gerëëngë na amatara gi ibhiakörëa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.4",
            "verseOrgIds": [
              "2CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Ömögambi Bhaasa aanyoorrë amang'ana gu uguitanibhua köyö, naahatëëyë köhagaacha umugi go Rama, akaimiirria ëmërëmo geee. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.5",
            "verseOrgIds": [
              "2CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Ömögambi Asa aatömërë abhantö bhonsui bha Yuta, bhakang'anyia amagëna ga Rama na ichimbaara, ibhintö bhino Bhaasa aarë köhagaachëra. Sooki Asa akahagaachëra ibhintö bhiira imigi ge Gëbha na Misibha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömönaabhi Hanani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö, Hanani umunchëëna akaya harë Asa ömögambi wa Yuta, akamöteebhia iga, “Gikugira weiteng'eeyë ömögambi wa Samu iribhaga re guiteng'era ÖMÖNENE, Ënooköë waao, iricheesi riö ömögambi wa Samu reegötërrökërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë, Abhakusi bhaara na Abharibhia bhaara mbataarëngë iricheesi irinene na amagari na abhagendia-bharaasi abhaaru? Sibhoono gikugira ëno weiteng'eeyë ÖMÖNENE, we naabhatöörrë kömabhoko gaao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE nkuriiha arë bhuuya ëkëbhara gionsui, korri köha ichinguru bhaara bharëngë abhaheene harë we. Ökorrë ëng'ana yö öbhökangi ëtöhö, köhayö kurua bhoono, nöraabhe na iriihi hake köhake.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana gayö ngaakorrë Asa arërërre umunchëëna Hanani bhökong'u, kuhika akamotööra cheera. Gönkaaga ëyö bheene, Asa agataanga kunyankia bhörrö abhantö nyabhörebhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masërra gö öbhögambi bho Asa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaköra ga Asa gukurua ögötanga kuhika masëërra gaae, ngandëkëröë kögëtabhö kia “Abhagambi bha Yuta na Isiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mërongo ëtatö na kenda gö öbhögambi bhooe, Asa naagotëröë na öbhörooyi bhua amagörö, akaroora bhökong'u. Sibhoono ninyoora në ënkaaga ëyö, Asa taihönchöörëëyë ÖMÖNENE amutuurri, gëtatiga naitönëëyë ubhutuurria kurua köbharaguri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masërra gaahö, Asa agakua kömooka go mërongo ënai na gumui gö öbhögambi bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatökëröa kundua ëno wanyoorrë aiseemiria umuene kuirëngo, kumugi go Tauti. Mbaamötöörrë guisandëko rëno riichuriibhui ubhurumbaasi bhui ichiteemo hagarëhagarë bhöno bhooseemibhui na abhahundi bhu ubhurumbaasi, bhakahuuta ömörro ömönene bhökong'u gösööko yaae.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.14",
            "verseOrgIds": [
              "2CH.16.14"
            ]
          }
        }
      ]
    }
  ],
