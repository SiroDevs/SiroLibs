      },
      "items": [
        {
          "text": "Ömögambi Ahasi wa Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasi naatangërë kögambëra ana ëmeeka mërongo ëbhërë, naagambërë Yerusalemu kömeeka ikumi na ësansabha. We taasooraini ëteemo inchiiya ya Tauti guuka waabho, gëtatiga naakörrë amanyanku mbërë yö ÖMÖNËNE, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gösoorana ichisëëra cha abhagambi bha Isiraeri. Ninyoora niigo, naakorrë ibhihooru bhia gutura bhia Bhaari. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akahösëra öbhöbhaani kuibhatë riö ömoona o Hinomu na gösambërëërröa abhaana bhaae köbha ibhimuenso kubhihooru, ariëga ichisëëra cha kuriirria ichi ichihamatë chino chaarugiibhui na ÖMÖNENE hano Abhaisiraeri bhaarë gösoha gönsë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaruusiri ikimuensö na gösamba öbhöbhaani köhasë ha gösengera ichinooköë chindë, kubhikerege na hansë ya këra mötë göno göna amatö amabhësë.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriihi ria Abhasamu na Abhaisiraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
