            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Suremani agaambërë iga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        }
      ]
    },
    {
