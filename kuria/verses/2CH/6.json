              "2CH.6.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.6"
              },
              "items": [
                {
                  "text": "2 Ich 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhoono, wei Ënooköë, maheene nöömenya gökëbhara möno hamui na ömoona wö ömöntö? Ninyoora nkuriöbha iriene, gösë kuriöbha ria amariöbha ga igörö bhökong'u hatakuguisa, niyekë inyumba ëno nhagaachërë ëraguise? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora niigo, wei ÖMÖNENE, Ënooköë waane, uni ömökoramërëmo waao, ndagösabha öntegeerre na könhëkëraniria irisabhi reene rëno nkögösabha reero. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.11"
              },
              "items": [
                {
                  "text": "Ëhë 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uriihe inyumba ëno ubhutikö na ömöbhasö ahasë hano waahöra iga abhantö bhaao bhayi bharasengera iriina reeo. Unyigua uni ömökoramërëmo waao hano naacha ahasë hano ögösaasaama. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wigua amasabhi gaane uni ömökoramërëmo waao na aga abhantö bhaao Isiraeri hano bhagöösabha bhasiorri ahasë hano. Wigua amasabhi kurua igörö kuriöbha köyö na hano ukuigua, ötoobhere.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ömöntö arasarri ööndë, nawe arentöe iga aitueneerri, atuenerribhöe guikëngë reeo kunyumba ëno, nawe aituenerria, ndakögeya ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwe wigua kurua igörö kuriöbha, wimukia iritamböka na gökengera ikiina abhantö bhaao. Öno ana irisaria, ömöha iribhörööta gököreng'ana na amasaria gaae; öno ataana isaria umutiga na ömöhe igituho köreng'aana na öbhöröngë bhooe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ënkaaga ëno abhantö bhaao Isiraeri bharëkëröa na abhabhisa bhaabho gikugira ya amaraga gano bhaakorrë kuguisiira, hano nabho bharëkuihönchoorra harë uwe na guitabhiirria iriina reeo, bharasabha amaabhë harë uwe kubhususeenu kunyumba ëno, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "uche kuigua gukurua igörö kuriöbha, waabhëre amaraga gaabho na köbharingia gönsë ëno waabhahaayë bho na bhaguuka bhaabho.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano kuriöbha harasike, imbura yange götöa, gikugira bhaakoorrë amaraga kuguisiira, bharasabhe bhasiorri ahasë hano na guitabhiirria iriina reeo, na bhatige amaraga gaabho, ndakögeya ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "öbhategeerra gukurua kuriöbha hayö, na öbhaabhëra amaraga ga abhakoramërëmo bhaao abhantö bhaao Isiraeri, na hano örabhaigia gösorana irikuuri iriröngë, öteeria imbura gönsë yaao ëno waahaayë abhantö bhaao köbha iyaabho.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ndanyoore ënsë inyoorrë inchara gösë öbhöhëndö, ëmaaö, öbhörooyi bhui ibhiakörëa, ichingige gösë ichinyëërrë, gösë ndanyoore abhantö bhaao bhanaaribhui na abhabhisa bhaabho kumugi goobho görë gonsui; hano ndanyoore iritemo rërë rionsui gösë öbhörooyi bhörë bhonsui rëëho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakogëya wigua amasabhi garë gonsui garasabhöe na ömöntö örë wonsui gösë abhantö bhaao bha Isiraeri bhonsui, këra möntö hano aramaanye inyaanko yaae na imitumato geee agösabhe na hano ararambëka amabhoko gaae gusioria inyumba ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono kurua waao kuriöbha wigua, öhaane amaabhë, na ökoorrë këra möntö keebhörë këragërë, kugira nuwe bheene ömanyërë amaitegeerro gi imioyo gia abhaana bha abhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö mbe mbarakuigöëre na gösorana irikuuri reeo nkaaga chonsui chino bhamenyërë gönsë ëno waahaayë bhaguuka bhaitö.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
