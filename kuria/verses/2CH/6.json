            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1 Gam 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö bhoono, wei ÖMÖNENE, Ënooköë wa Isiraeri, ndagösabha guiki öhëkëraini ëndagano ëëra waaragaini ömökoramërëmo waao Taata weitö Tauti, öragamba iga, ‘Ruiso ronsui nörabhe na umuibhöroa wa guikarra igitumbë kiu ubhukumahe ke Isiraeri, hano uruibhöro rooo rörasoorane bhuuya imigiro geene kehaara uwe waakorrë mbere yaane.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, wei ÖMÖNENE, Ënooköë wa Isiraeri, ndakögeya öhëkërani gaara gonsui waaragaini ömökoramërëmo waao Tauti.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
