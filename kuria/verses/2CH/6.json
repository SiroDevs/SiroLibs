              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano bhaihönchöra guchinkoro chaabho chonsui bharëngë köbhögöre hayö na kumioyo geebho gionsui na götöbhöra nagösabha amaabhë, bharagamba iga, ‘Tokora amaraga, tohotoka na gökora amabhë;’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
