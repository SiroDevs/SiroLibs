        "style": "s1"
      },
      "items": [
        {
          "text": "Ömögambi Yotamu wa Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu naarëngë na ëmeeka mërongo ëbhërë na ëtaano hano aatangërë kögambëra, naagambëëyë kurua Yerusaremu gönkaaga ya ëmeeka ikumi na ësaansabha. Nyaköwaabho naarë köbhërëkëroa iga, Yerusa umusubhaati o Satoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakorre amaiya mbere yö ÖMÖNËNE kehaara Usia isawaabho aakorrë; gëtatiga we taasohërë köhekaru yö ÖMÖNENE",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:2",
              "type": "text"
            },
            {
              "text": "köhekaru yö ÖMÖNENE:",
              "type": "text"
            },
            {
              "text": "Ësësöro yaayo niiga ahahoreeru hö ÖMÖNENE.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hai, abhantö nabho mbaagenderreeyi gökora amanyanku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu na agahaachere irihita re söchë ri inyumba yö ÖMÖNENE na kuiriira bhökong'u köhagaacha urugitö göntahana ya Obheri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naahagaachërë imigi kubhikerege bhia Yuta, na hano amasisi garë, akahagaacha amagöë na ëmënaara kubhikerege bhino bhiina ëmëtë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitaini iriihi na ömögambi wa Amoni na köbhakëra. Kömooka göyö Abhaamoni mbaamuruusiiyi iriguuti ichikiro chi ichitaranta cha amatiini gi ichimbiria ibhiköë bhitato na amagana anai (3,400), ëngano ichitaani ëgëköë kimui (1,000), na ësayiri ichikiro ëgëköë kimui (1,000); bhakagenderria gökora igo kömooka go kabhërë na ögo gatatö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Yotamu naagëndërreeyi köbha na ichinguru gikugira naamenyërë kögösööka ÖMÖNENE, Ënooköë waae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakora gandë ga Yotamu, amahi gaae na öbhögambi bhooe, ngaandëkëröë ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu naarëngë na ëmeeka mërongo ëbhërë na ëtaano hano aatangërë kögambëra, akagambëra kömeeka ikumi na ësansabha kurua Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakuurë na götökëroa kumugi go Tauti. Ahasi ömoona waae akagambëra kuibhaga reee.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
      ]
    }
