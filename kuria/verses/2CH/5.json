                {
                  "text": "Ëhë 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëgëntö keerëngë mönsë yi Irisandëko ri Imuuma, gëtatiga ichimbaara ibhërë chiira cha amagëna chino Mösa aatöörrë mo Horebhu, ahasë hano ÖMÖNENE aakoorrë imuuma na abhantö bha Isiraeri, nkaaga bhaaruurë Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
