                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Ich 15:25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhoono ömögambi Suremani akaraarëka Yerusaremu abhagaaka guucha na abhatangati bhonsui bhi ibhiaro na abhibhisaku bhia Isiraeri korri bhang'aanyi Irisandëko ri Imuuma kurua kumugi go Tauti nko kögamba iga Sayuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho bhonsui bhaasikaini mbere yö ömögambi kurusikö röë ësögökörö yu umueri go muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhagaaka bhonsui bhahikërë, Abharawi mbaimukiri Irisandëko ri Imuuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abharawi na abhanchaama, bhakang'aanyiri Irisandëko ri Imuuma na iritunteera re gusikanëra na ibhintö ibhihoreeru bhionsui bhino bhiarëngë guitunteera möyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Suremani na umuiranio go Isiraeri bhakairania mbere yi Irisandëko ri Imuuma bhakaruusia ikimuenso gi ichintang'ana na amang'ondi gano gataköbharua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhanchaama bhagasohia Irisandëko ri Imuuma yö ÖMÖNENE ahasë haario, kugisuumua kë möönsë kë ëhekaru, ahasë haario, ahasë ahahoreeru bhökong'u, hansë ya amabhabha ga amakerubhi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakerubhi ngaarambööyë amabhabha gaago igörö ya ahasë hano irisandëko retöörröë, köhayo irisandëkö na ëmemba geerio ge kurimukiria mbiarë hansë ya amabhabha ga amakerubhi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ëmemba gëëra ngerëëngë ëmëtambë bhökong'u, ichinsonga chaagio nchaarë kömaahëkana kurua ahasë ahahoreeru mbere yi igisuumua ke mönsë, sibhoono tëgemaahëkaini gukurua ëntahana ya këbhara. Ëmemba gëyö nëho gëkërë kuhika reero.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        }
      ]
    },
