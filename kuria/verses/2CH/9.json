              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani akabha na ibhitume ibhiköë bhinai (4,000) bhino ichibharaasi na amagari bhiakaraayë, na abhasirikare bhi ichibharaasi ibhiköë ikumi na bhibhërë (12,000) bhano bhaahirröë kumigi gionsui gëno geerëngë na ibhirariö bhi ichibharaasi hamui na kömögambi Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Ögt 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.21"
              },
              "items": [
                {
                  "text": "1 Gam 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naagambëëyë abhagambi bhonsui bhano bhaarëngë götangëra kömooro go Yubhurati, kuhika gönsë ya Abhabhirisiti na kuhika köbhaga ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono ömögambi Suremani agakora amatiini gi ichimbiria kumugi go Yerusaremu chikabha bhuereere kia amagëna Yerusaremu, na ichimbaara chi imieresi nchaatöökërë köbhooru kë ëmëkö ge Sebhera. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Ëhë 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Suremani akareeteroa ichibharaasi chino chaagörröë kurua Misiri na guchinsë chindë.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhötangati bho Suremani kubhuëng'ë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
