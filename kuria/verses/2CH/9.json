      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Örögendo ro ömögaikörö ömögambi wa Sebha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
