        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaköra gaandë ga Suremani, kurua kögötanga kuhika masëërra, ngaandëkëröë kögëtabhö kë “Ërondorio yö Ömönaabhi Natani,” köbhönaabhi bho “Ahiya o Siro,” na “Kö amamaaho ga Ito” umunchëëna, gano guiki gaitungërë Yerobhoamu ömoona o Nebhati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani naagambëëyë ënsë yonsui ya Isiraeri kömeeka mërongo ënai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masërra gaaho Suremani agakua, agatökeröa kumugi go Tauti isawaabho, Rehobhoamu, ömoona waae, akagambëra kuibhaga reee.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
