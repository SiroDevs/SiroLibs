            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ësögökörö yaasirrë, abhantö bhonsui bha Isiraeri mbaagëëyë kömenya kumigi hagarëhagarë ge Yuta, bhakaminyongo imitimö gia amagëna na kögechageecha ibhihooru bhia Asera, ënooköë wë ënkari, na guiki bhagasaria amakëngë na ahasë ha gösengera ichinooköë chindë. Mbaakorrë bhöyö bheene Yuta yonsui, Bhenchamini, Ebhuraimu na Manase, kuhika hano bhaasookiri gösaria bhionsui. Sooki bhakaringa kumigi geebho, këra möntö körögarë rooe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Hesekia agatööra bhöhëa Abhanchaama na Abharawi kömakomo na köha këra umui waabho ëmërëmo geee iminuhe, gökora ëmërëmo guchintahana hagarëhagarë chë ëhekaru yö ÖMÖNENE. Ëmërëmo gëyö nhamui na öbhömaahirri bhöa amahita guisanchö riö ÖMÖNENE, ukuruusia ibhimuenso bhia gösambërëërröa na ibhimuenso bhiö ömörembe, ësataaka yu umukumo na kögönga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ëbh 28:1—29:39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi akaruusia ichitugo kurua kuihicho reee chikaruusibhua ikimuenso ke gösambërëërröa inkio na ömögoroobha, ikimuenso ke gösambërëërröa kugira yë Ësabhatö na ënkaaga ya gökora ichisögökörö chö ögötaachöa kui imieri, na ichisögökörö chindë chiira chaagambëröë köreng'ana na imigiro giö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        }
      ]
    },
    {
