      },
      "items": [
        {
          "text": "Hesekia araköbhöra irimenya rë ësengero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
