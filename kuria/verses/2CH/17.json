{
  "id": "2CH.17",
  "number": "17",
  "bookId": "2CH",
  "reference": "2 Amang'Ana Gi Ichinkaaga 17",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
