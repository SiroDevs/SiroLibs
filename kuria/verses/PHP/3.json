          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhöröngë bho öbhöheene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kögösookerria, abhantö bhaitö, mögooke kö Ömönene. Tënkömaaha iga në ng'ana gökörëngëra köbhandëkëra amang'ana gaara bheene naisërë köbhandëkëra hai; kugira ëyö në ëng'ana yu ubhuëra harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.1",
            "verseOrgIds": [
              "PHP.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muiraarërre na bhaara bhaagökora amanyanku, ichisëësë chiyö, bhaara bhaguisarria ëmëbhërë geebho. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.2",
            "verseOrgIds": [
              "PHP.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira bhaitö mbo törëngë ësaaro ëheene, bhano tögosengera Ënooköë gönchëra ya Nkoro Nhoreeru,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:3",
              "type": "text"
            },
            {
              "text": "gönchëra ya Nkoro Nhoreeru:",
              "type": "text"
            },
            {
              "text": "Gönchëra yë Ënkoro yë Ënooköë",
              "type": "text"
            }
          ]
        },
        {
          "text": " na kuiraha harë Kirisitö Yesö. Bhaitö tëtöguiteng'era möbhërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono uni nëëna këno gëkaagira nitëng'ere ömöbhërë. Ndanyoore ömöntö örë wonsui agaiteng'era ömöbhërë, nu uni mbe ngaakora igo bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.4",
            "verseOrgIds": [
              "PHP.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.1"
              },
              "items": [
                {
                  "text": "Rum 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.6"
              },
              "items": [
                {
                  "text": "Ama 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.5"
              },
              "items": [
                {
                  "text": "26:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naasaarröë urusikö ro kanaanai, umui wa Abhaisiraeri, wë ikiaro ke Bhenchamini, Umuibhurania öno aaibhööyöë na Abhaebhurania; igörö ya kögoota imigiro, nö Ömöbharisayo ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.5",
            "verseOrgIds": [
              "PHP.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Ama 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "22:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikugira yö ömökëa göno naarëngë nago, naairiirri ëkanisa, na igörö yö öbhöröngë bhö ökögoota imigiro, tënaabhaayë na isoro hai. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.6",
            "verseOrgIds": [
              "PHP.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono amang'ana gaara gonsui gaarëngë agu ubhuëra harë uni, nkögabhara ndë iga tëgëntö hai, kugira ya Kirisitö Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.7",
            "verseOrgIds": [
              "PHP.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiiga ngayö agieni hai, sibhoono guiki nköbhara ndë amang'ana gonsui köbha ököheta igo kugira yu ubhuëra bhöno bhötaana kërengere, kugira ya kömanya Kirisitö Yesö Ömönene waane. Kugira ya we naanyoora ököhëta igo kömang'ana gayö gonsui na kögabhara köbha amabhi korri nyoore Kirisitö; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.8",
            "verseOrgIds": [
              "PHP.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nëbhe harë we. Na guiki nange köbha na öbhöröngë bhoone umuene bhöno bhukunyoorekana gö ökögoota imigiro, gëtatiga mbööra bhuguucha kugukumia Kirisitö, öbhöröngë bhöno bhukurua kö Ënooköë, bhöno bhuitungërë ubhukumia. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.9",
            "verseOrgIds": [
              "PHP.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö korri iga manye Yesö na ichinguru chu ukuriööka kooe, guiki nsange imiiriiro geee na köbha keewe kuruku rooe, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.10",
            "verseOrgIds": [
              "PHP.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na guiteng'era iga nani nindiriukibhöa kurua köbhaku.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukumuntana köhëkëëra irituno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiiga iga naisa kuhika gösë iga naabharoa köbha ömöhëkëëranu hai, gëtatiga nkumuntana ndë korri ngooterre igituho këëra Kirisitö aang'a kögönkora köbha öwaae. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.12",
            "verseOrgIds": [
              "PHP.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, tinguitegeerra iga naisa kunyoora igituho këyö hai; ëng'ana nimui bheene ngökora, niëbhe gaara gonsui gaisa kohëta, igo, muntane korri nnyoore gaara ga mbere yaane; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.13",
            "verseOrgIds": [
              "PHP.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkörögendö ndë ro köhëkëëra irituno, korri iga nnyoore igituho këëra kiu ubhuëra öbhönene bhöë ëmberekëra yë Ënooköë gököhetera harë Kirisitö Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.14",
            "verseOrgIds": [
              "PHP.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga mbe, bhaitö bhaara töisa köbha abhahëkëëranu tuitegeerre gayö bheene. Nënkanyoora möitegeerra bhöndë, Ënooköë narabhahönyörrë ëng'ana ëyö nayo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.15",
            "verseOrgIds": [
              "PHP.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono këëra toohëkëëra, tiga tökëgooterre bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.16",
            "verseOrgIds": [
              "PHP.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.16"
              },
              "items": [
                {
                  "text": "1 Ko 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.1"
              },
              "items": [
                {
                  "text": "11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, mögoote igituubhaniö keene möbhe ke uni, na muëge kurua köbhaara bhakögoota igituubhaniö këno tööbhahaayë. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.17",
            "verseOrgIds": [
              "PHP.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naisa köbhateebhia harë kaaru, na bhoono nkörëngëra ndë köbhateebhia kömaisori iga, abhantö abhaaru mbaana irimenya rëno rëkoorokia iga na abhabhisa bhö ömösarabha go Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.18",
            "verseOrgIds": [
              "PHP.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masërra gaabho niiga mbarasaribhöe; kërë ënda igituna nkiö ënooköë yaabho. Nkuiraha bharë kö gaara garëngë ichinsoni harë bho, amaitegeerro gaabho gonsui ni igörö yë ëkëbhara këno. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.19",
            "verseOrgIds": [
              "PHP.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhaitö weitö nkuriöbha igörö ërë; igörö hayö ho tököganyera Umutuuria weitö kurua, Ömönene weitö Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.20",
            "verseOrgIds": [
              "PHP.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno arëhönchöra ömöbhërë goitö göno görëngë ömörosu gutuubhane na ömöbhërë gooe gu ubhuhiku, guchinguru chaae chö ögötöra götööra ibhintö bhionsui hansë yö öbhögambi bhooe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.21",
            "verseOrgIds": [
              "PHP.3.21"
            ]
          }
        }
      ]
    }
  ],
