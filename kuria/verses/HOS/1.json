              "items": [
                {
                  "text": "Rum 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Abhaisiraeri mbaraabhe abhaaru kiö ömösense gui inyancha göno götakörengöa, gösë köbharoa; haara wanyoorrë Ënooköë aabhateebhia iga, “Bhainyu mötarë abhantö bhaane,” bhoono naarëbhateebhia iga, “Bhainyu na abhaana bhë Ënooköë ömöhoru.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Yuta na abhantö bha Isiraeri mbaragotane hamui, na koohoora ömötangati waabho umui; nabho mbaragooke gönsë yaabho. Röyö ndörëbha urusikö örönene ro Yesireeri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
