                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.37+ACT.15.38+ACT.15.39"
              },
              "items": [
                {
                  "text": "15:37-39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Arisitariko, öno törëngë nawe gökëbhohe, abhakeerri, hamui guiki na Mariko, mubhiara o Bharinabha. (Mosookiri kunyoora amaragirriö gukuirigania Mariko hano araahike harë bhainyu.) ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesö öno aköbhërëkëröa iga Yusito, nawe wonsui abhakeerri. Köbhaara bhagösaaröa (hayö niiga Abhayahuti), mbayö bheene, bharëngë abhakoramërëmo hamui na uni gikugira yö öbhögambi bhöë Ënooköë, nabho mbo bhaguntirimikia. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.7"
              },
              "items": [
                {
                  "text": "Kor 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Bhir 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ebhabhura umui wi irikomo reinyu na ömökoramërëmo wa Kirisitö Yesö, abhakeerri. Ruiso ronsui nköbhasabhëra arë bhökong'u, korri iga mötöre kuimëërra bhöröngë, mökong'e na mötërëmëke kimui kömang'ana gano gonsui Ënooköë agutuna. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni umuene nköherekia ndë iga ngökora arë ëmërëmo bhökong'u kugira yeinyu na gikugira ya abhantö bha Raotikia na Hierabhori. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.11"
              },
              "items": [
                {
                  "text": "2 Tim 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.24"
              },
              "items": [
                {
                  "text": "Bhir 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Tim 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.24"
              },
              "items": [
                {
                  "text": "Bhir 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ruka, öno arëngë ömöreri weitö ömöhanchöa, na Tema bhabhakeerri. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakeeriö gaitö köbhakumia bha Raotikia; mökeeri musubhaati ömoitö Nimubha hamui na ëkanisa ëno ikuirana nyuumba mooe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano mörasooki gösoma inyarubha ëno, mömaahe iga ësomëröë na ëkanisa ya Raotikia. Na bhainyu mökore ëseemi mösome inyarubha ëyö nabho bhaanyoorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
            "verseOrgIds": [
              "COL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.2"
              },
              "items": [
                {
                  "text": "Bhir 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Möteebhi Arikibho iga, “Ömaahe iga öhëkëëraini ömörëmo göno waahaayöë na Ömönene.” ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
            "verseOrgIds": [
              "COL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 4:18"
          },
