        {
          "text": "Abhanene, mökorre abhagöre bhainyu bhuuya na köbhöheene. Möhëëtöke iga na bhainyu bhonsui mmööna Ömönene weinyu kuriöbha.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        }
      ]
