              "type": "text"
            }
          ]
        },
        {
          "text": "Ërë yonsui mögökora, mögëkore kömooyo goinyu gonsui, ke hano mögaakorrë kugira yö Ömönene na tiiga ngikugira ya abhantö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
