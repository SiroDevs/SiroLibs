              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömanye iga mmurinyoora igituho kiö ömöndö kurua kö Ömönene. Kugira nö Ömönene Kirisitö mögökorra! ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
