          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.22"
              },
              "items": [
                {
                  "text": "Eb 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Bhe 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhakari mösööke bhasaacha bhainyu, kugira nigo këragërë mökore kö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Eb 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.7"
              },
              "items": [
                {
                  "text": "1 Bhe 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhasaacha, möhanche bhakainyu, monge köbha abharrrö harë bho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
            "verseOrgIds": [
              "COL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.1"
              },
              "items": [
                {
                  "text": "Eb 6:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaana, mösööke abhaibhuri bhainyu kömang'ana gonsui, kugira ëyö ngötegeria ërë Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.20",
            "verseOrgIds": [
              "COL.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.4"
              },
              "items": [
                {
                  "text": "Eb 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhainyu abhaibhuri monge kuiriiria abhaana bhainyu, ëtarë igo mbaraakue ënkoro. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.21",
            "verseOrgIds": [
              "COL.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 3:22"
          },
