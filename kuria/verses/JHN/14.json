          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imöka turue hano, nchö tëgende.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.31",
            "verseOrgIds": [
              "JHN.14.31"
            ]
          }
        }
