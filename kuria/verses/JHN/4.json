              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.46",
            "verseOrgIds": [
              "JHN.4.46"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.1+JHN.2.2+JHN.2.3+JHN.2.4+JHN.2.5+JHN.2.6+JHN.2.7+JHN.2.8+JHN.2.9+JHN.2.10+JHN.2.11"
              },
              "items": [
                {
                  "text": "Yoh 2:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö akaringa kuya Kana kumugi go Gariraya, harë wanyoorrë ahönchöra amanchë köbha itibhaai. Nkanyoora umuirigania öwöndë wö ömögambi aho, öno wanyoorrë ömoona waae aroorrë, kumugi go Kabherinaumu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.46",
            "verseOrgIds": [
              "JHN.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aiguurë iga Yesö aruurë Yutea achërë Gariraya, naagëëyë harë we, kömögeya iga ang'aaraare kuya Kabherenaumu kuhuenia ömoona waae, öno aarëngë ömörooyi umutiitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.47",
            "verseOrgIds": [
              "JHN.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö Akamöteebhia iga, “Hano mötarööchë ibhirögööro na ibhimanyiirriö tëmögakumia hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.48",
            "verseOrgIds": [
              "JHN.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöhobhisa ööra akamöteebhia iga, “Mönene tötaya hano ökaahancha ömoona waane atarakua.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.49",
            "verseOrgIds": [
              "JHN.4.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 4:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akamöteebhia iga, “Taya, ömoona waaö narahone!” Ömöntö ööra akaringa kuya ka, ana ubhukumia kömang'ana gaara Yesö aamöteebhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.50",
            "verseOrgIds": [
              "JHN.4.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 4:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëno aarë kuya ka, agaturuung'anöa na abhakoramërëmo bhakamöteebhia iga, “Ömoona waaö ahuenërë!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.51",
            "verseOrgIds": [
              "JHN.4.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 4:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabhabhuuria ënkaaga ëno aabhaayë bhuuya, nabho bhakamöteebhia iga, “Ni icho möbhasö, ichinkaaga muhungatë irikeng'enti reerë risirrë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.52",
            "verseOrgIds": [
              "JHN.4.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 4:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isawaabho akahëëtöka iga në ënkaaga ëëra bheene Yesö aamöteebhiri iga, “Ömoona waao narahone.” Kö hayö möntö öyö na waae bhagakumia bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
            "verseOrgIds": [
              "JHN.4.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 4:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këyö nkeerëngë ëkërögööro ge kabhërë këno Yesö aakorrë hano aruurë Yutea Gariraya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.54",
            "verseOrgIds": [
              "JHN.4.54"
            ]
          }
        }
      ]
    }
