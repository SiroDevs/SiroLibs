          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano umukubhiö gumui goosirrë nkanyoora abhëëga bhairaini hamui nyumba guiki, röyö nkanyoora Tomasi mo arë. Ibhisaku wanyoorrë mbisiikërë, sibhoono Yesö agaacha akaimëërra harë bho akagamba iga, “Ömörembe göbhe na bhainyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua agateebhia Tomasi iga, “Tööra ëkeera keeo hano, na ömaahe kubhisanyi bhiane, rambëka ököbhokö kooo ögoote göntahana yö öröbharu roone; Tiga isi yaao isire, takumia!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomasi akamuhunchukiria iga. “Mönene waane, Ënooköë waane!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö Akamöteebhia iga, “Ngukumia örë kugira öndööchë? Abhakehaiya mbaara bhagukumia bhataarööchë!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikibhune kë ëgëtabhö këno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
              "JHN.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö naakörre ibhimanyiirriö bhindë ibhiaru mbere ya abhëëga bhaae bhino bhitandëkëröë kögëtabhö këno. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono gano ngaandëkëröë korri iga mukumi iga Yesö nëwe Masihi, Ömoona wë Ënooköë, na kubhukumia bhoinyu muuche kunyoora öbhöhoru kuriina reee.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.31",
            "verseOrgIds": [
              "JHN.20.31"
            ]
          }
        }
