          ]
        },
        {
          "text": "Ësögökörö yë Ëbhasaka ya Abhayahuti nkanyoora ihikërë hang'i, abhantö abhaaru bhagatiira kuya Yerusaremu, guisaabhuura mbere yë ësögökörö ëyö yë Ëbhasaka ëtaraabha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.55",
            "verseOrgIds": [
              "JHN.11.55"
            ]
          }
        },
