            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.1",
            "verseOrgIds": [
              "JHN.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.38"
              },
              "items": [
                {
                  "text": "Ruk 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.39"
              },
              "items": [
                {
                  "text": "39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömöntö öwöndë iga Rasaro, öno wanyoorrë amenyërë Bhetania, akaroora. Bhetania nu umugi göno Mariamu na Marita musubhaati omoobho wanyoorrë bhaamenyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.1",
            "verseOrgIds": [
              "JHN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.3"
              },
              "items": [
                {
                  "text": "Yoh 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Mariamu nööra aahakërë Yesö amaguta gano gakurumbaasa kömagörö na akamueya na ituukia yaae, nëwe aarëngë musubhaati omoobho Rasaro öno aarëngë ömörooyi.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.2",
            "verseOrgIds": [
              "JHN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhasubhaati bha moobho bhayö bhakahërra Yesö umunyua iga, “Mönene, ömögonche waao nö ömörooyi.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.3",
            "verseOrgIds": [
              "JHN.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.3",
            "verseOrgIds": [
              "JHN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yesö aaiguurë igo, naagambërë iga, “Öbhörooyi bhöno tëbhooruku hai; gayö ngabhaayë göököha Ënooköë ubhuhiku, na köbhörooyi bhöno nho Ömoona wë Ënooköë araheeroe ubhuhiku.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.4",
            "verseOrgIds": [
              "JHN.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.4",
            "verseOrgIds": [
              "JHN.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö naahanchërë Marita na musubhaati omoobho hamui na Rasaro. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.5",
            "verseOrgIds": [
              "JHN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aanyoorrë umunyua iga Rasaro nö ömörooyi, naabhereeyë ho guchinsikö chindë ibhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.6",
            "verseOrgIds": [
              "JHN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua agateebhia abhëëga bhaae iga, “Turinge kuya Yutea.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.7",
            "verseOrgIds": [
              "JHN.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhëëga bhaae bhakamöteebhia iga, “Muigia, mböngö igo Abhayahuti bhaatuna kögötema na amagëna; guiki öraya ho?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.8",
            "verseOrgIds": [
              "JHN.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.8",
            "verseOrgIds": [
              "JHN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhahunchukiria iga, “Aai, urusikö ndötaana ichinkaaga ikumi na ibhërë, gösë kana hai? Hano ömöntö agötaara ömöbhasö tagaituuratuura hai, gikugira nyoora nkömaaha arë öbhörabhu bhuë ëkëbhara këno. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.9",
            "verseOrgIds": [
              "JHN.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano agötaara ubhutikö nguituuratuura arë, kugira nyoora taana bhörabhu hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.10",
            "verseOrgIds": [
              "JHN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aagambërë gayö agösookia akaroobhirria iga, “Ömösaani weitö Rasaro, araayë, sibhoono nëndaayi kumutura.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.11",
            "verseOrgIds": [
              "JHN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhëëga bhaae bhakahunchukia iga, “Ömönene, hano öranyoore naraayë naraabhë bhuuya.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.12",
            "verseOrgIds": [
              "JHN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Yesö niiga aagambërë iga Rasaro akuurë, nabho bhagakanya iga ni ichitëro aarë gusumaachëra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.13",
            "verseOrgIds": [
              "JHN.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yesö akabhakonorra iga, “Rasaro akuurë, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.14",
            "verseOrgIds": [
              "JHN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "sibhoono gikugira yeinyu, ngookërë iga tënaarë nawe hai, korri iga möbhe na ubhukumia. Tiga tuyi kömömaaha.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.15",
            "verseOrgIds": [
              "JHN.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomasi öno aakabhërëkëëyöë iga Irisarai agateebhia abhëëga bhandë iga, “Na bhaitö bhonsui tiga tögeenane na Muigia, korri tukue hamui nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.16",
            "verseOrgIds": [
              "JHN.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö nëwe ukuriöka na öbhöhoru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.16",
            "verseOrgIds": [
              "JHN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yesö aahikërë ho, naanyoorrë iga Rasaro aasookia ichinsikö inyai kundua. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.17",
            "verseOrgIds": [
              "JHN.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetania yaarëngë hang'i ichikiiromiita isatö gukurua Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.18",
            "verseOrgIds": [
              "JHN.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Abhayahuti abhaaru wanyoorrë bhaachërë waabho Marita na Mariamu, köbhahonia kugira yu uruku ro mura omoobho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.19",
            "verseOrgIds": [
              "JHN.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.19",
            "verseOrgIds": [
              "JHN.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Marita aaiguurë iga Yesö ngönchëra arë araacha, naagëëyë kumuturung'ana, sibhoono Mariamu wë naatamërë ka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.20",
            "verseOrgIds": [
              "JHN.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marita agateebhia Yesö iga, “Mönene, nkanyoorrë waarë hano, mura omoitö nyoora takuurë hai! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.21",
            "verseOrgIds": [
              "JHN.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ninyoora mboono nëmanyërë iga kërë gionsui örasabhe Ënooköë naraköhe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.22",
            "verseOrgIds": [
              "JHN.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akamöteebhia iga, “Mura omoinyu narariöke.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.23",
            "verseOrgIds": [
              "JHN.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Mak 7:22,23; 12:44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marita akamuhunchukiria iga, “Nëmanyërë iga naarriöka kurusikö rua amasërra.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.24",
            "verseOrgIds": [
              "JHN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akamuhunchukiria iga, “Uni nu uni ukuriöka köyö na guiki nu uni ënsëmöka yö obhöhoru. Örë wonsui araabhe na ubhukumia harë uni, ninyoora akue naraabhe ömöhoru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.25",
            "verseOrgIds": [
              "JHN.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na örë wonsui amöhoru si ana ubhukumia harë uni tarikua röndë hai. Bhoono örakumia gayö?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.26",
            "verseOrgIds": [
              "JHN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marita akamuhunchukiria iga, “Ee-ë, Mönene ngukumia ndë iga nuuwe Masihi, Ömoona wë Ënooköë, öno aguucha gökëbhara.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.27",
            "verseOrgIds": [
              "JHN.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö araharrukia amaisori",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.27",
            "verseOrgIds": [
              "JHN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Marita aagambërë gayö agösookia, naagëëyë köbhërëkëra Mariamu musubhaati omoobho bhakaya gusumaacha mbisi. Akamöteebhia iga, “Muigia ahikërë hano, nkugutuna arë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.28",
            "verseOrgIds": [
              "JHN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Mariamu aaiguurë igo, naaimökërë iga kubhu akaya kumuturuung'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.29",
            "verseOrgIds": [
              "JHN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Yesö tëwanyoorrë araahika köröbhëri röyö hai, sibhoono wanyoorrë haara bheene Marita amuturuung'anëëyë akërë.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.30",
            "verseOrgIds": [
              "JHN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti bhano wanyoorrë bhanyumba, bharahonia Mariamu, hano bhaarööchë aimökërë bhöngöbhöngö na kurichoka mbaamösoorainë. Mbaakanyërë iga nagëëyë gukuura kundua haara.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.31",
            "verseOrgIds": [
              "JHN.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.31",
            "verseOrgIds": [
              "JHN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Mariamu aahikërë haara Yesö aarëngë, akömömaaha, naagööyë kömagörö gaae, akagamba iga, “Mönene, nyoora waarë hano nyoora mura omoitö taakuurë hai!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.32",
            "verseOrgIds": [
              "JHN.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yesö aarööchë Mariamu hamui na Abhayahuti bhano wanyoorrë bhaachënainë bhonsui bharakuura; akagootoa na amaachiichi amanene bhökong'u, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.33",
            "verseOrgIds": [
              "JHN.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabhabhuuria iga, “Nëhai mömöbhëëkërë?” Bhakamöteebhia iga, “Mönene, taacha ömaahe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.34",
            "verseOrgIds": [
              "JHN.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akaharrukia amaisori. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.35",
            "verseOrgIds": [
              "JHN.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti bhakagamba iga, “Tamaaha bhörë wanyoora aamöhancha!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.36",
            "verseOrgIds": [
              "JHN.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhamui bhaaho bhakagamba iga, “Hano ndanyoore aahueniri umuhukuru akamaaha, natakaarëbhërrëëyë Rasaro ange gukua?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.37",
            "verseOrgIds": [
              "JHN.11.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö arariukia Rasaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.37",
            "verseOrgIds": [
              "JHN.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akagootoa na amaachiichi amanene guiki, agatanöra kuya kömbëëhëra haara, ëno yaarëngë irisana. Na irigëna wanyoorrë ndisiikëre gësaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.38",
            "verseOrgIds": [
              "JHN.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhateebhia iga, “Taruusia ho irigëna rëyö!” Marita, musubhaati omoobho umusiri öyö akagamba iga, “Mönene, ubhugundo mbutuita. Kugira asookiri ichinsikö inyai kömbëëhëra!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.39",
            "verseOrgIds": [
              "JHN.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.39",
            "verseOrgIds": [
              "JHN.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akamuhunchukiria iga, “Kana nëntaagöteebhiri iga hano öraabhe na ubhukumia nöramaahe ubhuhiku bhuë Ënooköë?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.40",
            "verseOrgIds": [
              "JHN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakaruusia ho irigëna. Yesö akagaramëra igörö akagamba iga, “Taata, ndakuringiria umukumo iga nkunyigua örë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.41",
            "verseOrgIds": [
              "JHN.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë iga ruiso ronsui nkunyigua örë, sibhoono nkögamba ndë gayö gikugira ya abhantö bhano, korri bhabhe na ubhukumia iga nuwe waantömërë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.42",
            "verseOrgIds": [
              "JHN.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aasookiri kögamba gayö, akabhërëkëra bhökong'u aragamba iga, “Rasaro, tarichoka!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.43",
            "verseOrgIds": [
              "JHN.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rasaro akarichoka, amabhoko na amagörö gaae wanyoorrë ngabhöheerreeyöë ichingëbho cha köbhöbheerra umukuurë, na ëgëtambara kigubhërë ubhusiö bhooe. Yesö akabhateebhia iga, “Tamötachöra, na mömöhaatëre agende.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.44",
            "verseOrgIds": [
              "JHN.11.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inikö ya guita Yesö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.44",
            "verseOrgIds": [
              "JHN.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti abhaaru bhano wanyoorrë bhaachërë köhonia Mariamu hano bhaarööchë gano Yesö aakorrë, mbaabhaayë na ubhukumia harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.45",
            "verseOrgIds": [
              "JHN.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhamui bhaaho bhakaringa kuya göteebhia Abhabharisayo gano Yesö aakorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.46",
            "verseOrgIds": [
              "JHN.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Abhabharisayo hamui na abhanchaama abhanene bhagaikara inchaama bhakagamba iga, “Niyekë kana törakore, kugira ömöntö öno ngökora arë ibhimanyiirriö ibhiaru? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.47",
            "verseOrgIds": [
              "JHN.11.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 11:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano töramutige ayi arakora igo, abhantö bhonsui mbaraabhe na ubhukumia harë we, na Abharumi mbaraache gösaria ahasë ahahoreeru haitö na ëhamatë yeitö!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.48",
            "verseOrgIds": [
              "JHN.11.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 11:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umui waabho öno aarë köbhërëkëröa iga Kayabha, umunchaama umuhikërë kömooka göyö, akabhateebhia iga, “Bhainyu tëmömanyërë gëntö hai! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.49",
            "verseOrgIds": [
              "JHN.11.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 11:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana tëmömanyërë iga nkihueneeyë iga ömöntö umui akue kuibhaga ria abhantö bhonsui gökëra hano ëhamatë yonsui ëraasike?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.50",
            "verseOrgIds": [
              "JHN.11.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 11:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayö tanamang'ana gaae umuene agambërë hai; gëtatiga hano aarë umunchaama umuhikërë ömooka göyö, naanyeereeyë Yesö ënaabhi, iga narakue gikugira yë ëhamatë ya Abhayahuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.51",
            "verseOrgIds": [
              "JHN.11.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 11:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "na tiiga iga nköhamatë ëyö bheene hai, gëtatiga niiga akome abhantö bhë Ënooköë bhano bhaanyeregana bhabhe ëgëntö kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.52",
            "verseOrgIds": [
              "JHN.11.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 11:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua röyö abhatangati bha Abhayahuti bhagakenga ikiina ke guita Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.11.53",
            "verseOrgIds": [
              "JHN.11.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 11:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Yesö naarë götaara araibhisabhisa Abhayahuti, hakurua, akaya ahasë hang'i na iriköngö, kumugi go Ebhuraimu, hayö nëho aaikaayë na abhëëga bhaae.",
          "type": "text",
