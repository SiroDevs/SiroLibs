    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhuramu aratuuria Rutu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö ömögambi Amurabheri wa Sinari, ömögambi Arioko wa Erasari, ömögambi Ketoriraomeri wa Eramu, na ömögambi Titari wa Goimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.1",
            "verseOrgIds": [
              "GEN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbaitaini iriihi guisiira Bhera ömögambi wa Sotoma, Bhirisa ömögambi wa Gomora, Sinabhu ömögambi wa Atima, Semebheri ömögambi wa Sebhoimu na guisiira ömögambi wa Bhera, nko kögamba iga, Soari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhagambi bhayö bhatano mbaagotaini hamui amacheesi gaabho, kuibhate rë Sitimu, nko kögamba iga, Kunyancha ya Kiönyö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.3",
            "verseOrgIds": [
              "GEN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbabhaayë hansë ya ömögambi Ketoriraomeri kömeeka ikumi na ëbhërë, sibhoono kömooka go ikumi na gatatö bhakamötëëyëra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.4",
            "verseOrgIds": [
              "GEN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komööka go ikumi na kanai ömögambi Ketoriraomeri na abhagambi bhaara bhaarëngë hamui nawe mbaachërë bhagaitania abhantö na köbhakëra guchintahana chino iga, Abharebhaimu göntahana ya Asetaroti-karinaimu, Abhasusi göntahana ya Hamu, Abhaemi göntahana ya Sawe-kiriataimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Abhahori kunguku yaabho ya Seiri, bhakabharugia kuhika Eribharani köbhaga yi iriköngö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua bhakaringa nyuma kuhika Eni-misibhati, nko kögamba iga, Katesi, bhagaitania ënsë yonsui ya Abhaamareki, na gökëra Abhaamori bhano bhaamenyërë Hasasoni-tamari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ömögambi wa Sotoma, ömögambi wa Gomora, ömögambi wa Atima, ömögambi wa Sebhoimu, na ömögambi wa Bhera, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.8",
            "verseOrgIds": [
              "GEN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nko kögamba iga, Soari, bhaatöörrë hamui amacheesi gaabho, bhagasoha kuiihi kuibhatë rë Sitimu, guitana na Ketoriraomeri ömögambi wa Eramu, Titari ömögambi wa Göimu, Amurabheri ömögambi wa Sinari, na Arioko ömögambi wa Erasari; abhagambi bhanai guisiira abhagambi bhatano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iribhatë re Sitimu wanyoorrë amaina gë ërami, bhoono, nkaaga abhagambi bha Sotoma na Gomora bhaarë köng'osa iriihi, bhakagöa kömarööma möyö, sibhoono abhandë bhakang'osera guchinguku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, abhagambi bhanai bhaara bhaakërrë, bhagasënsa ibhintö bhia Sotoma na Gomora na ibhiakörea bhiabho bhionsui, na kuya bhoobho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakagoota ninyoora Rutu ömoona o mura omoobho Abhuramu, öno wanyoorrë amënyërë Sotoma, bhakaya nawe hamui na ibhintö bhia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömöntö umui öno aatërrökërë, naagëëyë agateebhia Abhuramu Ömöebhurania ööra wanyoorrë amënyërë hang'i na imiaroni ge Mamure. Mamure naarëngë bhamura omoobho iga Esikori na Aneri bhonsui wanyoorrë bhaarëa imuuma na Abhuramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhuramu aiguurë amang'ana iga ömoona o mura omoobho ahirröë köbhögöre, naarichokërë na abhantö bhaae abhakarë amagana atatö na ikumi na bhanaanai (318) bhano bhaibhööyöë gööka yaae, akarondia abhabhisa bhayö kuhika Tani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhuramu agatuena iricheesi reee kömakomo. Ubhutikö, agaitania abhabhisa bhaae, akabhakëra na kubharugia kuhika Hobha, mööchë ya Tamasika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, akaringia ibhintö bhionsui bhia Rutu bhino wanyoorrë bhihirröë na abhabhisa, akabhohoria Rutu ömoona o mura omoobho hamui na abhagaikörö bhaae na abhantö bhandë.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Merikiseteki araitabhiria Abhuramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhuramu akaringa kurua kuiihi hano aasookiri gökëra ömögambi Ketoriraomeri na bharikia bhaae, ömögambi wa Sotoma akarichoka kuya kumuturung'ana kuibhatë re Sawe, nko kögamba iga, Ibhatë re Mögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.1+HEB.7.2+HEB.7.3+HEB.7.4+HEB.7.5+HEB.7.6+HEB.7.7+HEB.7.8+HEB.7.9+HEB.7.10"
              },
              "items": [
                {
                  "text": "Ibr 7:1-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Merikiseteki ömögambi wa Saremu, öno aarëngë umunchaama wë Ënooköë Umukumahe, akarentera Abhuramu ömögaate ni itibhaai, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaitabhiria Abhuramu, akagamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhuramu nawe akaha Merikiseteki iring'ënga re ikumi ri ibhintö bhionsui bhino aarëngë nabhio.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi wa Sotoma agateebhia Abhuramu iga, “Tang'a abhantö bhayö, sibhoono uhire bhionsui.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Abhuramu agateebhia ömögambi wa Sotoma iga, “Ndaituenerria kö ÖMÖNENE, Ënooköë Umukumahe, öno aateemërë kuriöbha na hansë, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
              "GEN.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "iga tënkaimukia ninyoora nu uruche gösë ëkëgachiriö gë ëkëraatö, gösë kërë gionsui këno kërëngë ëkeeo, ötagaacha kuiheema iga, wanyamihia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.23",
            "verseOrgIds": [
              "GEN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Tëndaimuki kërë gionsui gëtatiga bhiira bheene abhahentani bhaane bhaarëëyë na iring'enga re bhaara bharëngë hamui nani, Aneri, Esikori na Mamure bhano bharanyoore ësöro yaabho.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.24",
            "verseOrgIds": [
              "GEN.14.24"
            ]
          }
        }
      ]
    }
  ],
