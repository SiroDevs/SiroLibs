    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukuibhöroa ko Isaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akahëëtöka Sara, akamökorra keehaara wanyoorrë aaragana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.11"
              },
              "items": [
                {
                  "text": "Ibr 11:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, Sara akaimukia ënda na akaibhörra Ibhurahimu ömoona köbhöntö bhökörö bhooe gönkaaga ëëra bheene Ënooköë aamöteebhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhurahimu akaröka iriina ömoona ööra wanyoorrë aibhööyöë iga, Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.12"
              },
              "items": [
                {
                  "text": "Ögt 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.8"
              },
              "items": [
                {
                  "text": "Ama 7:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano Isaka aahikiri ichinsikö inyaanyai, Ibhurahimu akamösaara, keehaara Ënooköë aamöteebhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhurahimu wanyoorrë aahikia ëmeeka irigana rimui (100), nkaaga ömoona waae Isaka aibhööyöë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Sara aagambërë iga, “Ënooköë aang'ayë ögöseka; örë wonsui araigue amang'ana gano naraaseke hamui nani.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Sara akagenderria kögamba iga, “Ning'ui agaateebhiri Ibhurahimu iga uni Sara nkagonkia abhaana? Guiki muibhorëëyë ömoona wë ëgësaacha köbhöntö bhökörö bhooe!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isaka akagenderria gukiina, na röno aatusibhui, Ibhurahimu agakora inyangi ënene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hagari na Isimairi bhararugibhua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röndë Sara akamaaha Isimaeri ömoona o Ibhurahimu öno aibhööyë harë Hagari Umumisiri, arahooya hamui na ömoona waae, Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.29"
              },
              "items": [
                {
                  "text": "Gar 4:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, Sara agateebhia Ibhurahimu iga, “Tarugia ömögaikörö ömögöre öno agende hamui nö ömoona waae. Kugira ömoona wö ömögaikörö ömögöre takaarëa ömöndö nö ömoona waane Isaka hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ëyö ëkariirria Ibhurahimu bhökong'u, kugira Isimairi nawe wonsui nö ömoona waae aarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.7"
              },
              "items": [
                {
                  "text": "Rum 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.18"
              },
              "items": [
                {
                  "text": "Ibr 11:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhono Ënooköë agateebhia Ibhurahimu iga, “Wange körëërra gikugira yö ömoona öyö, wö ömögörë waao öyö wë ëgëkari. Takora kërë gionsui Sara akögöteebhia, maaheene uruibhöro rooo harë Isaka röraarue.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na igörö yö ömoona wö ömögöre wë ëgëkari nëndamökore abhe ëhamatë ënene, kugira nawe wonsui nö ömoona waao.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Ibhurahimu akabhööka inkio chuni, akaimukia ibhiakörea na ikiguchi kia amanchë, akaha Hagari, akamöbherekia ömoona, akamurugia hamui na ömoona waae. Hagari agatanöra, akaya kögendagenda guiköngö re Bheeri-sebha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano amanchë gaasirrë gukiguchi keera, Hagari agatööra ömoona waae hansë yö ömötë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaya mbarëka örögendo rui ichimiita igana rimui (100), agaikara hansë akagamba kömooyo gooe iga, “Mbuuya nange kömaaha ömoona waane arakua.” Nkaaga wanyoorrë aikaayë ho, ömoona ööra agakuura bhökong'u.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ënooköë akaigua ömoona ööra arakuura; ömömaraika wë Ënooköë akabhërëkëra Hagari kurua igörö kuriöbha akamubhuuria iga, “Ni nyaanyi kë önayo Hagari? Wange koobhoha kugira Ënooköë aiguurë irikuura riö ömoona haara arëngë.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Taimöka wimuki ömoona na ömötahate bhuuya kömabhoko gaao, kugira nëndamökore abhe ëhamatë ënene bhökong'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Ënooköë akahönyöra amaiso ga Hagari akamaaha igisima kia amanchë, akaya agaichuria ikiguchi amanchë, akaha ömoona waae akanyua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë akabha hamui na ömoona ööra, nawe akagenderria gukiina. Akamenya guiköngö na akabha ömörasi wö öbhöta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.20",
            "verseOrgIds": [
              "GEN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimairi akamenya guiköngö re Bharani, na nyaköwaabho akamötetia ömökari kurua gönsë ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaiguërrano ga Ibhurahimu na Abhimereki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
