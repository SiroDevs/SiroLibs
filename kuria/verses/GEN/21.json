        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhurahimu akamuhunchukiria iga, “Ichichöörö muhungatë chino ngököha ndë uni umuene, korri chibhe ëherekio yaane iga, nu uni naatukërë igisima këno.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, igisima këyö gëkabhërëkëröa iga, Bheeri-sebha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:31",
              "type": "text"
            },
            {
              "text": "Bheeri-sebha:",
              "type": "text"
            },
            {
              "text": "Igisima kio umuhangate gösë kie imuuma.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kugira nëho bhonsui bhabhërë bhaitueneerreeyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        }
      ]
    },
