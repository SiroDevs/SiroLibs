              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Naahori aahikiri ëmeeka mërongo ëbhërë na kenda naibhööyë Tera. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.24",
            "verseOrgIds": [
              "GEN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aasookiri kuibhöra Tera, Nahori naamenyërë ëmeeka gëndë irigana rimui na ikumi na kenda (119), akaibhöra abhaana bhandë bhë ëgësaacha na ëgëkari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
            "verseOrgIds": [
              "GEN.11.25"
            ]
          }
        }
      ]
    },
