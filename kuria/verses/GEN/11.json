              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Tera aahikiri ëmeeka mërongo muhungatë akaibhöra, Abhuramu, Nahori na Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
