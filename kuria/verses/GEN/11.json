          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sera akamenya ëmeeka gëndë amagana anai na ëtatö, akaibhöra abhaana bhandë bhë ëgësaacha na ëgëkari.",
          "type": "text",
          "attrs": {
