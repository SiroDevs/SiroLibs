      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruibhöro ro Tera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
