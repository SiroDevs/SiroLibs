          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera akaimukia ömoona waae, Abhuramu na ömöchökörö waae iga Rutu öno aarëngë ömoona o Harani na Sarai, möka Abhuramu, bhakang'aanya bhonsui kurua kumugi go Uru Bhökaritayo kuya gönsë ya Kanaani. Sibhoono hano bhaahikërë Harani bhakamenya ho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera naakuërëëyë Harani haara ana ëmeeka amagana abhërë na ëtaano (205).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
