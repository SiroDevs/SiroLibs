              "type": "text"
            },
            {
              "text": "Hawa:",
              "type": "text"
            },
            {
              "text": "Iriina rëno iga Hawa Köbhaibhurania nkuitabha rërë në ëng'ana ëno bhitubhaine në ëng'ana iga ökömenya igo ësësöro yaario hano niiga abhantö.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nëwe abhaayë nyaköwabho abhantö bhonsui bhano bha ho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
