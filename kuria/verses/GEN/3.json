            {
              "text": "Atamu:",
              "type": "text"
            },
            {
              "text": "Iriina rëno Atamu ësësöro yaario niiga abhantö bhonsui",
              "type": "text"
            }
          ]
        },
        {
          "text": " akaröka mökaae iriina iga, Hawa,",
          "type": "text",
