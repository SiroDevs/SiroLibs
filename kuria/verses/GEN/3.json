          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö ööra akamuhunchukiria iga, “Niguure imititi geeo guisamba noobhohërë na kuibhisa, kugira nkëng'aabhi naarë.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        }
      ]
