          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE Ënooköë agakorra Atamu na mökaae ibhitati bhi irisaakoa, akabhabhisia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
