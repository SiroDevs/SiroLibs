          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE Ënooköë akamubhuuria iga, “Ning'ui agöteebhiri iga nkëng'aabhi örë? Gösë nöörëëyë irikö riö ömötë gööra naagökaaniri iga ötagaacha körëa?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        }
      ]
    },
