                  "text": "Ama 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na gököhetera kuruibhöro rooo, ichihamatë chonsui chë ëkëbhara nchiraitabhiribhoe, gikugira ösöökërë ëngamba yaane.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Ibhurahimu akaringa kuya köbhakoramërëmo bhaae bhaara, nabho bhakaringa bhonsui hamui kuya Bheeri-sebha; na Ibhurahimu akamenya ho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruibhöro ro Nahori",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano amang'ana gayö gaahetërë, Ibhurahimu agateebhibhua iga, “Mirika nawe wonsui aibhörra mura omoinyu Nahori abhaana bhananai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho mbano iga: Usi ömötangi, na Bhusi mura omoobho, Kemueri isawaabho Aramu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keseti, Haso, Bhiritasi, Yitirabhu na Bhetueri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetueri nëwe isawaabho Rebheka. Abhaana bhananai bhano, mbo Mirika aibhörëëyë Nahori mura omoobho Ibhurahimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua guiki Reuma umuikarani o Nahori namuibhörëëyë abhaana bhano iga: Tebha, Gahamu, Tabhasi na Maaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.24",
            "verseOrgIds": [
              "GEN.22.24"
            ]
          }
        }
      ]
    }
