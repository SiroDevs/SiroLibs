              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutu naahikërë kumugi go Soari nkaaga wanyoorrë iriöbha rërasërë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
