          },
          "items": [
            {
              "text": "Öbh 10:7",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.32"
              },
              "items": [
                {
                  "text": "Ruk 17:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono möka Rutu, öno aarëngë nyuma yaae, akamagia nyuma, akabha umutimö gö ömönyö.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        }
