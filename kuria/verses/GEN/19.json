          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tangöha! Öng'sere ho, nani tëndakore ëng'ana ërë yonsui, kuhika uhike ho.” Köhayö umugi gööra gökabhërëkëröa iga, Soari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
