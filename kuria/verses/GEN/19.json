                  "text": "Yuta 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ho hayö igo ÖMÖNENE akarenta ömörro guikibhiriti kurua kuriöbha igörö ya Sotoma na Gomora, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "agasikia imigi gëyö, iribhatë rionsui, hamui na abhamenyi bhario bhonsui na bhionsui bhino wanyoorrë bhiamera gönsë ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
