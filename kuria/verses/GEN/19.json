              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika ööra akamuhunchukiria iga, “Mbuuya, niitabhiriiyi irisabhi reeo. Tëndasiki umugi göyö ötarrë hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
