              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhurahimu naarëngë na ëmeeka mërongo kenda na kenda nkaaga aasaarröe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
