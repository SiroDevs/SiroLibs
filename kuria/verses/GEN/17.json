          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Isimairi, ömoona waae naarëngë ëmeeka ikumi na ëtatö nkaaga aasaarröe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
