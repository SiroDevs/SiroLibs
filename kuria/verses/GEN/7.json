            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.6"
              },
              "items": [
                {
                  "text": "2 Bhe 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aahikiri ëmeeka amagana asansabha (600), kurusikö ro ikumi na muhungatë ru umueri go kabhërë, urusikö röyö ichinsëröka chonsui chi ibhindumanchë bhë ëkëbhara, mbiatitiiyi amanchë, na ichindöhö cha kuriöbha chikaiigöka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbura ëgatöa gökëbhara guchinsikö mërongo ënai, ubhutikö na ömöbhasö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö röyö bheene hano imbura yaatangërë götöa, Nuhu, mökaae na abhaana bhaae, Semu, Hamu na Yabheti, hamui na bhakaabho, bhagasoha kömeeri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagasoha bho abhiene hamui na ichituubho chonsui chi ichitiinyi cha ibhara, ichitugo, ichitiinyi chino chikuing'uura na ibhinyunyi bhia këra tuubho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhigasoha kömeeri hamui na Nuhu bhibhërë bhia këra tuubho ya ibhiteemoa ibhihoru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra tuubho yaabhio mbiasohërë ëgësaacha na ëgëkari, keehaara Ënooköë aateebhiri Nuhu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëhöörö yaabhaayë gökëbhara guchinsikö mërongo ënai. Amanchë gakaiyengeria na guchungia ëmeeri, nayo ëkörööra këgörö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.17",
            "verseOrgIds": [
              "GEN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanchë gakagenderria kuiyengeria bhökong'u gökëbhara, na ëmeeri ëkörööra këgörö yaago. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.18",
            "verseOrgIds": [
              "GEN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanchë gayö gakabha amaaru bhökong'u hansë ya kuriöbha, gagatubhiria ichinguku chonsui ichintambë gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.19",
            "verseOrgIds": [
              "GEN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanchë gakaiyengeria na gutubhiria ichinguku ëkërengere gi ichimiita muhungatë na iritënë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.20",
            "verseOrgIds": [
              "GEN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiteemoa ibhihoru bhionsui bhino bhiarëngë gökëbhara bhigakua: Ibhinyunyi, ichitugo, ichitiinyi cha ibhara, amakomo gi ibhiteemoa na abhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.21",
            "verseOrgIds": [
              "GEN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee-e këra gëteemoa ëkëhoru ngeekuurë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.22",
            "verseOrgIds": [
              "GEN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë agasikia këra gëteemoa këno kërëngë ëkëhoru gökëbhara: Abhantö, ichitiinyi, ibhiteemoa bhino bhikuing'uura na ibhinyunyi bhia igörö. Nuhu bheene nëwe aahönërë hamui na bhaara aarëngë nabho kömeeri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.23",
            "verseOrgIds": [
              "GEN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanchë gayö ngaabhaayë gökëbhara guchinsikö irigana rimui na mërongo ëtaano (150).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.24",
            "verseOrgIds": [
              "GEN.7.24"
            ]
          }
        }
      ]
    }
  ],
