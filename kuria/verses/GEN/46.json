            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano Yakobho aagëëyë nabho gönsë ya Misiri, gökanga köbhara abhakamoona bhaae, mbaarëngë mërongo ësansabha na bhasansabha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.26",
            "verseOrgIds": [
              "GEN.46.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "Ama 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaana bha Yusubhu bhano bhaibhörëëywë Misiri, mbaarëngë bhabhërë; köhayö, Abhantö bhë ëka ya Yakobho bhano bhaagëëyë Misiri mbaarëngë mërongo muhungatë.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobho na umugi gooe bharëngë Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobho agatöma Yuta iga atangate kuya harë Yusubhu kömöteebhia iga bhasikanëre Goseni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu akariina irigaari reee ri ichibharaasi, akaya guturung'ana Isiraeri isawaabho Goseni haara. Na hano aahikërë harë isawaabho namuibhaarrë na gukuura gönkaaga ëntambë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeri agateebhia Yusubhu iga, “bhoono nëngakua tëng'ana hai kugira nkörööchë iga nëho örë!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 46:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu agateebhia bhamura bha moobho na abhantö bha isawaabho bhonsui iga, “Uni ndaya harë Bharao kömöteebhia iga, ‘Bhamura bha moobho na abhantö bhaitö, bhano bhaarëngë gönsë ya Kanaani bhaachërë harë uni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndamöteebhi iga bhainyu na abhaniibhi bhi ichitugo mörëngë, na iga muuchërë na ichimburi, amang'ondi, iching'ombe na bhintö bhienyu bhionsui.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 46:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, hano Bharao arabhabhërëkërë na abhabhuuri iga, ‘Mërëmo kë mögökora?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 46:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömöteebhi iga, ‘Mönene bhaitö abhakoramërëmo bhaao nabhaniibhi bhi ichitugo törë gukurua tööbhaana, kuhika reero, kugira bhaguuka bhaitö bhonsui ëmërëmo ngëyö bhaagakorrë,’ mögambe igo korri muitabhirribhöë kömenya kömöndaara go Goseni.” Yusubhu agambërë igo, gikugira abhaniibhi bhonsui bha amang'ondi ni ikiriirriö kö Abhamisiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.34",
            "verseOrgIds": [
              "GEN.46.34"
            ]
          }
        }
      ]
