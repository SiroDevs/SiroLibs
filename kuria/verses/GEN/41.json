    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusubhu arasësörra Bharao ibhirooto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ëmeeka ëbhërë imigima geehetërë, Bharao akaroota iga, nkanyoora aimërëëyë mbarëka yö Ömoro go Nairi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.1",
            "verseOrgIds": [
              "GEN.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamaaha iching'ombe muhungatë ichinchiya, ichinuru chirarua kömoro gööra na kuriisia amanyanki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.2",
            "verseOrgIds": [
              "GEN.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua iching'ombe chindë muhungatë ichinsiniinuuna chino chabhoncha chikarichoka kurua kömooro go Nairi chigaacha na kuimëërra hang'i na ichinchiiya na chiira chimërëëyë kunguguni yö ömooro go Yorotani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.3",
            "verseOrgIds": [
              "GEN.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iching'ombe muhungatë chiira wanyoorrë chaabhoncha bhökong'u, chikarëa ichindë muhungatë chiira chaarëngë ichinchiiya na ichinuru. Ho hayö igo Bharao akamisukia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.4",
            "verseOrgIds": [
              "GEN.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aagooteroe ni ichitëro guiki akaroota ëkërooto këndë. Akamaaha ibhigara muhungatë ibhinene na ibhiiya bhino bhichööyë ichiheke bhirëngë guitina rimui. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.5",
            "verseOrgIds": [
              "GEN.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua bhikarichokera ibhigara bhindë muhungatë ibhinyerre bhino bhianiaribhua na ömökama go rögörö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.6",
            "verseOrgIds": [
              "GEN.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhigara ibhinyerre muhungatë bhiira bhikamera ibhigara muhungatë ibhinuru bhiira bhichööyë ichiheke. Hano Bharao aamisukiri nöngööyë iga në ëkërooto ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.7",
            "verseOrgIds": [
              "GEN.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.2"
              },
              "items": [
                {
                  "text": "Tan 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano bhookëëyë, Bharao nairiirrë bhökong'u, akabhërëkëra abhakoni na abhang'aini bhonsui bha Misiri. Akabhateebhia ibhirooto bhiae, sibhoono tëmöntö aatökërë öno aamösësörëëyë ibhirooto bhiyö hai.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho umuimiriirri ömönene wi itibhaai ööra agateebhia Bharao iga, “Reero nhëtökërë amasaria gaane! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.9",
            "verseOrgIds": [
              "GEN.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëëra watörërrëëyë bhaitö abhakoramërëmo bhaao, uni na ömösambi wë ëmëgaate ömönene ögatötööra gökëbhohe hansë yö ömökabhuruti wa abhasirikare abhariihi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.10",
            "verseOrgIds": [
              "GEN.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubhutikö ubhumui ntorootërë këra umui ëkërooto keee ëkëhagarë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.11",
            "verseOrgIds": [
              "GEN.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ömöhentani umui Umuebhurania ömökaramërëmo wö ömökabhuruti; hano toomöteebhiri, naatösësörëëyë ibhirooto bheitö këra umui gököreng'aana në ëkërooto keee. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.12",
            "verseOrgIds": [
              "GEN.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhööra aatösësörëëyë nkeebho bheene keebhaayë. Uni nkaringibhöa kömërëmo geene, na ömösambi wë ëmëgaate ömönene ööra agasungua kömötë.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Bharao agatömana iga Yusubhu abhërëkëroe, nawe akaruusibhua cheera bhöngöbhöngö. Hano aasookiri kugingiröa na köhönchöra ichingëbho, Yusubhu akaya harë Bharao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.14",
            "verseOrgIds": [
              "GEN.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharao agateebhia Yusubhu iga, “Uni ndotërë ëkërooto, sibhoono tëmöntö aho öno akagënsësörra hai. Naigua ichinkuma chaao iga hano wateebhibhöa ëkërooto, nkögësësöra örë.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.15",
            "verseOrgIds": [
              "GEN.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu akahunchukiria Bharao iga, “Tënëëna ögötöra köyö hai, sibhoono Ënooköë naraaköhe irihunchukiö rëno risërë.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.16",
            "verseOrgIds": [
              "GEN.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Bharao agateebhia Yusubhu iga, “Naarëndötërë iga, nimërëëyë mbarëka yö ömooro go Nairi ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.17",
            "verseOrgIds": [
              "GEN.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkamaaha iching'ombe muhungatë ichinchiya, ichinuru chirarua kömooro, na kuriisia amanyanki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.18",
            "verseOrgIds": [
              "GEN.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua iching'ombe chindë muhungatë ichinsiniinu, ichimbonchu chigachirua nyuma. Uni tënaakarööchë iching'ombe changa chiira gönsë yonsui ya Misiri hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.19",
            "verseOrgIds": [
              "GEN.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Iching'ombe ichinsiniinu, ichimbonchu chiira chikarea iching'ombe muhungatë ichinuru chiira cha mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.20",
            "verseOrgIds": [
              "GEN.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhono ninyoora chaarëëyë ichinuru chiira tëmöntö aakamanyërë iga chichirëëyë hai, kugira ni ichimbochu chaarëngë gië ëkëmbere. Ho hayö igo, nkamisukia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.21",
            "verseOrgIds": [
              "GEN.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkaroota ëkërooto këndë: Nkamaaha ibhigara muhungatë ibhinene na ibhiiya bhino bhichööyë ichiheke bhirëngë guitina rimui. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.22",
            "verseOrgIds": [
              "GEN.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ibhigara bhindë muhungatë ibhinyerre bhino bhianiaribhua nö ömökama go rögörö bhikarichokera. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.23",
            "verseOrgIds": [
              "GEN.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhigara ibhinyerre bhiira bhiikamera ibhigara ibhiiya bhiira. Bhoono, nteebhiri abhakoni ëbhirooto bhiyö, sibhoono möntö abhörrë öno agönsësörra.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu agateebhia Bharao iga, “Ibhirooto bhiao bhibhërë ësësöro yaabhio ni imui. Ënooköë aköhönyörëëyë gano akuya gökora guchinsikö chino chiguucha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.25",
            "verseOrgIds": [
              "GEN.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iching'ombe muhungatë ichinchiiya chiira në ëmeeka muhungatë, na ibhigara muhungatë ibhiiya bhiira, në ëmeeka muhungatë; ibhirooto bhiyö ësësöro yaabhio ni imui. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.26",
            "verseOrgIds": [
              "GEN.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iching'ombe muhungatë ichimbonchu bhökong'u chino chaaruurë nyuma ichinuru chiira, na ibhigara bhiira ibhichua muhungatë bhiira bhiniaribhui nö ömökama go rögörö, ësësöro yaabhio në ëmeeka muhungatë gi inchara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.27",
            "verseOrgIds": [
              "GEN.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkeebhörë nyoorrë ngöteebhiri wei Bharao, iga Ënooköë aköhönyörëëyë amang'ana gano akuya gökora bhöngö igo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.28",
            "verseOrgIds": [
              "GEN.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaha, ëmeeka muhungatë giu umuigötö gönsë yonsui ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.29",
            "verseOrgIds": [
              "GEN.41.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono guiki ëmeeka muhungatë gi inchara ngëraache na umuigötö göyö ngubhöe kimui. Inchara ëyö niirisikia ënsë ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.30",
            "verseOrgIds": [
              "GEN.41.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö yu umuigötö niriëbhöa kimui, kugira inchara ëyö nëërëbha ëndrrö bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.31",
            "verseOrgIds": [
              "GEN.41.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuirëngëra kui ibhirooto bhiyö kubhirengio bhino bhitubhaini, ësësöro yaabhio niiga, amang'ana gayö ngano gaseemibhöa në Ënooköë, nawe naragahëkëërani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö, Bharao nkëragërë iga wahöre ömöntö umunguri na ömöng'aini, ömöhe ögötöra go kömaahërra ënsë yonsui ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.33",
            "verseOrgIds": [
              "GEN.41.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki Bharao, wahöre abhaimiriirri gönsë yonsui bhano bharairi iring'enga rë gataano ri irigesa kurua köbhantö bhonsui bha Misiri, gönkaaga yë ëmeeka muhungatë giu umuigötö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.34",
            "verseOrgIds": [
              "GEN.41.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 41:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öteebhi abhaimiriirri bhayö bhatööre ëmongo yi ibhiakörea kömeeka muhungatë giu umuigötö geno giguucha. Na ibhiakörea bhiyö bhibhe hansë ya ögötöra koo, korri bhibhe ëmongo kumigi gionsui, nabho bhariihe ëmongo ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.35",
            "verseOrgIds": [
              "GEN.41.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiaköre bhiyö mbiraabhe ëmongo ya körëbhërra ënsë yonsui ya Misiri ëtagaacha gusikibhua na inchara yë ëmeeka muhungatë gëno giguucha.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusubhu arabha ömögabhana Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 41:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöragirria bho Yusubhu mbomaahëkaini köbha ubhuuya harë Bharao na abhahobhisa bhaae bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.37",
            "verseOrgIds": [
              "GEN.41.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 41:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Bharao akabhuuria abhakoramërëmo bhaae iga, “Ömöntö öno naana ënkoro yë Ënooköë! Gösë tökaanyoora wöndë ke öno?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.38",
            "verseOrgIds": [
              "GEN.41.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 41:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua agateebhia Yusubhu iga, “Gikugira Ënooköë akoorokiri amang'ana gano gonsui, tëmöntö wöndë aho umunguri na ömöng'aini ke uwe hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.39",
            "verseOrgIds": [
              "GEN.41.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 41:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.10"
              },
              "items": [
                {
                  "text": "Ama 7:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nu uwe öraimërëërre ënsë yaane, na abhantö bhaane bhonsui mbaraabhe hansë yö ögötöra kooo. Nuni bheene ndaabhe ömönene kögökëra, kugira niikarëëyë igitumbë kiö öbhögambi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 41:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharao agateebhia Yusubhu iga, “Bhoono, nkohööyë köbha umuimiriirri wë ënsë yonsui ya Misiri!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.41",
            "verseOrgIds": [
              "GEN.41.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 41:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.29"
              },
              "items": [
                {
                  "text": "Tan 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nëho Bharao aaruusiri ëbhete ëno ëna umuhuri gooe kurua gökeera keee, agasohiria Yusubhu, akamusuaria ëhanga inyëke hamui na urubhisia röë ësahaabhu kuigoti. Bharao akaruusia ekeröngë kiö öbhögambi kurua gökeera keee këno keerëngë ni iriina reee, agasohiria Yusubhu gökeera keee. Hakurua akamusuaria ichingëbho chi iriguri irinene, akamötöörra ömösanga göë ësahaabhu kuigoti reee. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.42",
            "verseOrgIds": [
              "GEN.41.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 41:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamuriinia kuigaari reee re kabhërë riö öbhögambi rëno reere kurutua ni ichibharaasi, abhasirikare bhagatangata bharachëërra bharagamba iga, “Mötatema ibhiru!” Mböyö Bharao aahaayë Yusubhu ögötöra ökönene gönsë yonsui ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.43",
            "verseOrgIds": [
              "GEN.41.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 41:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igiro ya gayo, Bharao agateebhia Yusubhu iga, “Uni nu uni Bharao! Na ndagamba iga: Möntö örë wonsui atagaacha gökora ëng'ana ërë yonsui gönsë ingima ya Misiri ötamuitabhirriiyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.44",
            "verseOrgIds": [
              "GEN.41.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharao akaröka Yusubhu iriina ri Ikimisiri iga Sabhenati-bhanea. Akamötetia Asaenati muisëkë o Bhotibhera, umunchaama wu umugi go Oni. Igo, Yusubhu agataanga götaarra ënsë yonsui ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 41:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu naarëngë na ëmeeka mërongo ëtatö, nkaaga aatangërë gökorra Bharao ëmërëmo, ömögambi wa Misiri. Akarichoka kurua kumugi go Bharao, agataarra ënsë yonsui ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.46",
            "verseOrgIds": [
              "GEN.41.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 41:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonkaaga ëëra yë ëmeeka muhungatë giu umuigötö, irirobha rë ënsë ya Misiri rëgakora ibhiakörea ibhiaru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.47",
            "verseOrgIds": [
              "GEN.41.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 41:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu akairia ibhiakörea bhionsui kömeeka muhungatë gëyö giu umuigötö, akabhibhëëka ëmongo kömatara imigi ge Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.48",
            "verseOrgIds": [
              "GEN.41.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu gi akairia ëmongo ya ibhiakörea ibhiaru bhökong'u bhikabha kiö ömösense gui inyancha, ëkërengere këno gëtagaatimöa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 41:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere ëmeeka gi inchara gëtaratanga, nkanyoora Yusubhu naana abhaana bhabhërë harë Asenati muisëkë o Bhotibhera, umunchaama wu umugi go Oni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.50",
            "verseOrgIds": [
              "GEN.41.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 41:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusubhu akabherëkëra ömoona waae ömötangi iga Manase, aragamba iga, “Ënooköë ankorrë niëbhërë inyaanyi yaane yonsui na ëka ya taata yonsui.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.51",
            "verseOrgIds": [
              "GEN.41.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaröka ömoona waae wa kabhërë iga Ebhuraimu, akagamba iga “Ënooköë kang'aayë abhaana gönsë ya imiiriiro geene.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 41:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëmeeka muhungatë gëëra giu umuigötö gönsë ya Misiri gëkaheta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 41:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.11"
              },
              "items": [
                {
                  "text": "Ama 7:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ëmeeka gi inchara muhungatë gëgatanga, keehaara Yusubhu wanyoorrë agambërë. Inchara ëgasëkërra ichinsë chindë choonsui, sibhoono ënsë yonsui ya Misiri yaarë na ibhiakörea. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
