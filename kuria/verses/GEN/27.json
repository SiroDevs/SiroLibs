                "loc": "HEB.11.20"
              },
              "items": [
                {
                  "text": "Ibr 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, Yakobho akahika hang'i isawaabho akamönamuuna, na hano isawaabho aiguurë ikirumba gi ichingëbho chaae, akamuitabhiria aragamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esau arageya isawaabho amöhe amaitabhiriö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
