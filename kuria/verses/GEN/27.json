          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau kamuhunchukiria iga, “Uni nu uni Esau, ömoona waao ömötangi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
