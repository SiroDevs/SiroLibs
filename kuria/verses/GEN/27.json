          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho Isaka agankaini bhökong'u akagamba iga, “Kana ööra andeteeyë inyama yi iriguëma ndëëyë nani muitabhiiyi ötaraacha, ning'ui aarë? Nani niisërë kumuitabhiria! Ee-e aisërë guitabhiribhöa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        }
      ]
    },
