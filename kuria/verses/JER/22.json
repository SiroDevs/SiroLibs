            "number": "5",
            "style": "v",
            "sid": "JER 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aragamba iga, igörö yi nyumba nköraano yö ömögambi o Yuta:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua abhantö abhaaru bhi ichihamatë mbarahete hang'i na umugi göno, na këra umui waabho narabhuuria öwöndë iga, ‘Igankë ÖMÖNENE akorrë igo umugi ömönene göno?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.8",
            "verseOrgIds": [
              "JER.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamui bhaabho mbarabhahunchukiri iga, ‘Ngikugira mbaatigërë imuuma yö ÖMÖNENE, Ënooköë waabho, bhagasengera ichinooköë chindë na guchikorra ëmërëmo.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
          }
        }
      ]
    },
    {
