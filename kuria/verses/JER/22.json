    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëhöbhë ëno ërasianye Yerusaremu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökenga ikiina kuë Ënooköë igörö ya Konia",
          "type": "text"
        }
      ]
    },
    {
