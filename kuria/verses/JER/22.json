                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Ich 36:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira ÖMÖNENE aragamba iga igörö ya Sarumu ömoona o Yosia ömögambi o Yuta, öno aabhaahërë kuibhaga rë Yosia isawaabho, na öno aatanööyë kurua ahasë hano: “Sarumu tariringa guiki ahasë hano, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga narikuëra hayö bheene bhaamuimukiri öbhögöre. Na tërööho guiki röno arëmaaha ënsë ëno.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
