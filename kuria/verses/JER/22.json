              "items": [
                {
                  "text": "2 Ich 36:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Köhayö, uni ÖMÖNENE ndagamba iga igörö ya Yehoyakimu ömoona o Yosia ömögambi o Yuta:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
