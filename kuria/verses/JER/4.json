        },
        {
          "text": "ÖMÖNENE arateebhia abhantö bha Yuta na abhamenyi bha Yerusaremu iga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
            "verseOrgIds": [
              "JER.4.3"
            ]
          }
        }
