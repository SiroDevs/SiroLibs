            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.14+JER.33.15+JER.33.16"
              },
              "items": [
                {
                  "text": "Yer 33:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tamaaha, ichinsikö chiraacha chino ndisibhukiria Tauti örösagia öröheene. Öyö narëbhaaha kiö ömögambi, na naarëkora köbhöng'aini, köbhöröngë na köbhöheene gönsë ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.5",
            "verseOrgIds": [
              "JER.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guchinsikö chö öbhöbhaahi bhooe, Yuta narituuribhua na Isiraeri narëmenya kögaareeya. Nawe narëbhërëkëröa iga, ‘ÖMÖNENE nö öbhöheene bhoitö.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö ichinsikö chiraacha, ndagamba uni ÖMÖNENE, chino abhantö bhatarituenerria guiki bharagamba iga, ‘Keebhörë ÖMÖNENE amenyërë öno aaruusiri abhantö bha Isiraeri gönsë ya Misiri,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.7",
            "verseOrgIds": [
              "JER.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga mbarituenerria bharagamba iga, ‘Keebhörë ÖMÖNENE amenyërë öno aaruusiri na götangata Abhaisiraeri kurua gönsë ya mööchë na gukurua guchinsë chonsui chino aabhanyeregainia.’ Hakurua mbarëmenya gönsë yaabho abhiene.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhanaabhi abharongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.15",
            "verseOrgIds": [
              "JER.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE wa amacheesi aragamba iga, “Monge kuiguëra abhanaabhi bhano bhaköbhanyeera ënaabhi; bharabhaha amaiteng'ero gö öbhörongo. Gano bhaköbhateebhia na amamaaho gaabho abhiene, na tëgaruurë harë uni ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.16",
            "verseOrgIds": [
              "JER.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bho tëbhaasinyërë göteebhia bhaara bhagösera ëng'ana yaane uni ÖMÖNENE iga, ‘Amang'ana ngarabhagëëre bhuuya.’ Na göteebhia këra möntö öno agösoorana amaitegeerro gaae köbhögachagachia iga, ‘Tiibhëëbhë rërë rionsui rëgakunyoora hai!’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.17",
            "verseOrgIds": [
              "JER.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.22",
            "verseOrgIds": [
              "JER.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni në Ënooköë öno arëngë hang'i, të Ënooköë önö arëngë harai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.23",
            "verseOrgIds": [
              "JER.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Öbh 1:7; Sir 16:17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë ömönto agaatöra kuibhisa ahasë hi ikibhisërë nange kömömaaha? Tëmömanyërë iga uni ÖMÖNENE nëndëngë këra hasë, kuriöbha na gökëbhara? Uni ÖMÖNENE ngambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.24",
            "verseOrgIds": [
              "JER.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni naigua amang'ana gano bhaagamba abhanaabhi bhayö bhaakörëa ënaabhi yö öbhörongo kuriina reene, bharagamba iga, ‘Ndootërë ëkërooto, ndootërë ëkërooto!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.25",
            "verseOrgIds": [
              "JER.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkëraabhe igo kuhika rööhai? Abhanaabhi bhayö mbaragenderri köhotoka ömooyo kuhika rööhai; körëa ënaabhi yö öbhörongo na öbhöng'ainirria bhui imioyo geebho abhiene? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.26",
            "verseOrgIds": [
              "JER.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubhirooto bhiabho bhiyö, ngöseemia bharë gökora abhantö bhaane bhanyëbhe uni kehaara bha isawaabho bhaanyëbhërë, bhakagëëra Bhaari! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.27",
            "verseOrgIds": [
              "JER.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönaabhi öno aroota ëkërooto, tiga arundiiyi ëkërooto keee, sibhoono öno ana ëng'ana yaane agirundi köbhöheene. Uni ÖMÖNENE ndagamba, umuirrro tëgönga ëngano hai! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.28",
            "verseOrgIds": [
              "JER.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yaane yanga ömörro; yanga ëkërësa këno këgootia ichintare amang'ëngang'enga ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.29",
            "verseOrgIds": [
              "JER.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, uni ÖMÖNENE nëndaitani abhanaabhi bhano bhakuibhana amang'ana gaane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.30",
            "verseOrgIds": [
              "JER.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene uni ÖMÖNENE ndagamba iga, nëndaitani abhanaabhi bhano bhakörakania amang'ana gaabho abhiene bharagamba iga, ‘ÖMÖNENE aragamba.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.31",
            "verseOrgIds": [
              "JER.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö mbe, uni ÖMÖNENE ndagamba iga, nëndaitani abhanaabhi bhano bhaakörëa ënaabhi yi ibhirooto bhiabho bhiö öbhörongo köbhantö bhaane, na köbhahotora köbhörongo bhoobho na ökörakania koobho. Uni tënaabhatömërë gösë köbhagambëra bhagende; köhayö tëbharaisane köbhantö bhayö hai. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.32",
            "verseOrgIds": [
              "JER.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëng'ana yö ÖMÖNENE nö ömösairë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.32",
            "verseOrgIds": [
              "JER.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aganteebhia iga, “Hano ömöntö örë wonsui, abhe ömönaabhi gösë umunchaama, arakubhuuria iga, ‘Nëhai görë ömösairë göno ÖMONENE agututuëka?’ Uwe nörabhateebhi iga,‘Bhainyu mbainyu ömösairë harë Ënooköë, nawe narabhatabhute harai,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.33",
            "verseOrgIds": [
              "JER.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, ömönaabhi, gösë umunchaama, gösë ömöntö örë wonsui öno aragambe iga ‘Ömösairë gö ÖMÖNENE,’ Nëndamöbhörööte hamui na ëka yaae yonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.34",
            "verseOrgIds": [
              "JER.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëgëntö këno këragërë iga mubhuurani bhainyu abhiene kubhiene niiga, ‘Nkë ÖMÖNENE ahunchukiri?’ Gösë, nkë ÖMÖNENE agambërë? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.35",
            "verseOrgIds": [
              "JER.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ëng'ana iga ‘Ömösairë gö ÖMÖNENE,’ mötakagëtara guiki. Kërë ömoona wö ömöntö akögamba nö mösairë harë we umuene. Abhantö nköhotora bharë amang'ana gë Ënooköë ömöhoru, ÖMÖNENE wa amacheesi, Ënooköë waabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.36",
            "verseOrgIds": [
              "JER.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mmörabhuuri ömönaabhi iga, ‘Nkë ÖMÖNENE akuhunchukiiyi?’ Gösë ‘Nkë ÖMÖNENE agambërë?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.37",
            "verseOrgIds": [
              "JER.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bho hano bharasari ëngamba yaane na kögamba iga,‘Ömösairë gö ÖMÖNENE,’ Na hano uni nnaabhakaaniri iga bhange kögamba iga, ‘Ömösairë gö ÖMÖNENE,’ bhoono tabhateebhia iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.38",
            "verseOrgIds": [
              "JER.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "uni nëndabhaimukiirri na köbhatabhuta kuya harai, bho abhiene hamui na umugi göno naabhahaayë bho na bhaguuka bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.39",
            "verseOrgIds": [
              "JER.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
