            {
              "text": "Bhar 2:23",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.23"
              },
              "items": [
                {
                  "text": "Öbhö 18:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ënsë nëërëbha iriköngö na gatai yi migi ge Yuta na ichimberi cha Yerusaremu nindirimia ichingamba chonsui cha amaseko na ëmëgooko, ichingamba chö möteti na ömörekari, gikugira ënsë nëërëbha irihooru.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
            "verseOrgIds": [
              "JER.7.34"
            ]
          }
        }
