    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichindagano chë Ënooköë köbhantö bhonsui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ëno yaachëëyë Yeremia kurua kö ÖMÖNENE iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni ÖMÖNENE, Ënooköë wa Isiraeri ndagamba iga, Taandëka kögëtabhö amang'ana gonsui gano naagöteebhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ichinsikö chiraacha chino ndiringiria abhantö bhaane Isiraeri na Yuta iriyeega reebho na köbharingia gönsë ëno naahaayë bhaguuka bhaabho, nabho mbarëgëmeria. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amang'ana gano ÖMÖNENE agambërë igörö ya abhantö bha Isiraeri na Yuta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano urusikö röyö rurihika, ndagamba uni ÖMÖNENE wa amacheesi, nindibhuna ichoogi yaabho na köbhötöra ibhirang'ani bhiabho, na bhange köbha abhakoramërëmo bha abhaitongo kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho tëbharëbha guiki abhagöre bha bhageni, gëtatiga mbarënkorra ëmërëmo uni ÖMÖNENE, Ënooköë waabho, hamui na ömögambi wë ëka ya Tauti öno ndëbhaahörra.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    }
  ],
