            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20+1KI.7.21+1KI.7.22+1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26+1KI.7.27+1KI.7.28+1KI.7.29+1KI.7.30+1KI.7.31+1KI.7.32+1KI.7.33+1KI.7.34+1KI.7.35+1KI.7.36+1KI.7.37+1KI.7.38+1KI.7.39+1KI.7.40+1KI.7.41+1KI.7.42+1KI.7.43+1KI.7.44+1KI.7.45+1KI.7.46+1KI.7.47"
              },
              "items": [
                {
                  "text": "1 Gam 7:15-47",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhagaritayo mbaabhöröngööyëbhöröngööyë imitimö gi iriche gënö gerëngë kunyumba yö ÖMÖNENE hamui na ibhiikarriö na ibhiriga ënene yi iriche ëno yaarëngë kunyumba yö ÖMÖNENE, bhakaimukia iriiköë rionsui kuhika Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene, bhakaimukia ichinyöngö, amachiiko, amagasi, ichikaraya, ichisahaani na ichibhakuri chi iriche bhino bhiarëngë ibhiëmërëmo gë ëhekaru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ömökabhuteeni wa abhariihi bhö ömögambi akaimukia ibhibhakuri, amarembeni, ichikaraaya, ichinyöngö, ibhitagacha bhi ibhimörë, ichisahaani chö öbhöbhaani na ibhibhakuri bhië ësataaka yi ibhinyuëbhöa. Ibhintö bhiyö bhibhe bhia sahaabhu gösë bhia matiini ga mbiria, ömötangati wa abhariihi naabhimukiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igörö yi ibhintö bhino ömögambi Solomoni aakorrë: Mbiaarë Imitimö ëbhërë, ugutubha gumui ögönene na ibhihooru bhi ichigaini ikumi na ibhërë chi iriche chino charëngë hansë yi iribhiriga irinene rëyö hamui na ibhiikarriö, iriche ri ibhintö bhiyö bhionsui nderëngë na ubhurito öbhooru bhökong'u ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra gumui kumitimö ëbhërë gëyö ngorëngë na öbhötambë bhui ichimiita inyaanyai (8), umuinaaro göyö ichimiita isaano na ichinuguta ibhërë isaano (5.25), na öbhörömba ichimirimiita mërongo muhungatë na isaano (75), gionsui ngerëngë bhömaaho mönsë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igörö ya këra mutimö haarëngë na ömötöe gui iriche; öbhötambë bho këra mötöe mborëngë ichimiita ibhërë na ichisentimita mërongo ëbhërë. Këra umutimö ngoinaariibhui ibhimigo bhiu uruero ibhië ëmëkomamanga, gionsui gi iriche. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeerë ho ëmëkomamanga mërongo kenda na ësansabha (96) guchimbaru chi imitimö gëyö; ëmëkomamanga gionsui ngeerëngë irigana rimui (100) na ibhimigo mbarëka yaagio.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhantö bha Yuta bharahirua Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Nebhusaratani ömokabhuteeni wa abhariihi bhö ömögambi, akamuimukia ubhunyambu Seraya umunchaama ömönene, na Sebhania umunchaama wa kabhërë, na abhariihi bha amahita bhatatö; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gukurua kumugi naamuimukiri ömöhobhisa umui öno aarëngë götangata abhasirikare kuiihi, hamui na abhantö muhungatë abharagiirria bhö ömögambi bhano aanyoorrë kumugi. Bhöyö bheene akamuimukia ömöng'orong'omi wö ömökönaare ömönene wi iricheesi öno arë köbhëëka ëhëëtöko yi iricheesi hamui na abhantö abharito mërongo ësansabha bhano aanyoorrë kumugi go Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebhusaratani ömökabhuteni wa abhariihi bhö ömögambi, naaimukiri abhantö bhayö akabhahira kömögambi o Bhabheri Ribhura hayö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Nebhugatinesa wa Bhabheri naatemërë na guita abhantö bhayö Ribhura hayö gönsë ya Hamati.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mböyö abhantö bha Yuta bhagëëyë köng'aanyi këbhara yënsë yaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këno nkio ëkërengere kia abhantö bhano Nebhugatinesa aimukiri kuya köng'aanyi kömooka go muhungatë gö öbhötangati bhooe: Naimukiri Abhayahuti ibhiköë bhitatö na mërongo ëbhërë na bhatatö (3,023); ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go ikumi na kanaanai gö öbhötangati bhooe, naimukiri kurua Yerusaremu abhanyambu amagana anaanei na mërongo ëtatö na bhabhërë (832); ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mërongo ëbhërë na ëtatö gö öbhötangati bho Nebhugatinesa, Nebhusaratani ömökabhuteni wa abhariihi bhö ömögambi, naimukiri abhanyambu Abhayahuti amagana muhungatë na mërongo ënanai na bhataano (745). Abhaanyambu bhonsui hamui igo mbarëngë abhantö ibhiköë bhinai na amagana ësansabha (4,600).",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mërongo ëtatö na muhungatë gukurua Yehoyakini ömögambi o Yuta aahiirruë köng'aanyi, urusikö ro mërongo ëbhërë na ëtaano ru umueri go ikumi na kabhërë, Ebhiri-merotaki ömögambi o Bhabheri, ömooka gööra bheene aatöörröë köbha ömögambi o Yuta, naabhëëyë Yehoyakini ömögambi o Yuta, akamurichokia kurua gökëbhohe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasumaachërë nawe bhuuya akamöha iribhaga riubhusuuki gökëra abhagambi bhandë bhano bhaarëngë hamui nawe köng'aanyi Bhabheri haara. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Yehoyakini akahönchöra amatati gaae agë ëkëbhohe, akaya araraagëra ibhiakörëa bhiae nsikö chonsui kömeesa yö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsikö chonsui akahaabhöa ëhakano na ömögambi o Bhabheri köreng'aana na amatuno ga nsikö chonsui kuhika hano aakuurë.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
