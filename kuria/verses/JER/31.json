            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.37",
            "verseOrgIds": [
              "JER.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aragamba iga, “Ichinsikö chiraacha chino umugi göno go Yerusaremu görëhagaachöa bhöhëa gikugira yö ÖMÖNENE, gukurua kömönaara go Hananeri kuhika Ihita re Mbarëka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.38",
            "verseOrgIds": [
              "JER.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na urusiri ro götëëmëra ndöraramböröe bhöröngë rurungihibhui kuhika kunguku ya Garebhu, hakurua ruinaaribhue kuhika Goa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.39",
            "verseOrgIds": [
              "JER.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iribhatë rionsui rëno abhaku bhaatökëëyöë na körekerröa iriibhu, ëmëgöndö gionsui, kuhika kögëtabhöka kë Gituroni kuhika kumuinogo go Ihita re Bharaasi kögëëra rögörö, ndërehöröa rëbhe irihoreeru kö ÖMÖNENE. Tëgëntö kërësaribhua mo gösë götëmöröa guiki kuya ëyö.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.40",
            "verseOrgIds": [
              "JER.31.40"
            ]
          }
        }
      ]
    }
