          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amang'ana ga Yeremia ömoona wa Herekia, umui wa abhanchaama bhu umugi go Anatoti gönsë ya Bhenchamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Gam 22:3—23:27; 2 Ich 34:8—35:19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëgaachëra Yeremia kömooka go ikumi na gatatö köbhöbhaahi bho Yosia ömoona o Amooni ömögambi o Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Gam 23:36—24:7",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7+2CH.36.8"
              },
              "items": [
                {
                  "text": "2 Ich 36:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Gam 24:18—25:21",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13+2CH.36.14+2CH.36.15+2CH.36.16+2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Ich 36:11-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yaamööchëëyë guiki gönkaaga ëno Yehoyakimu ömoona o Yosia aarëngë ömögambi o Yuta. Yeremia naagenderreeyi kunyoora ëng'ana yö ÖMÖNENE kuhika masërra gö ömooka go ikumi na kamui gö öbhöbhaahi bho Setekia ömoona o Yosia, ömögambi o Yuta. Kumueri go gataano kömooka göyö, abhantö bha Yerusaremu mbaahirruë köng'aanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ököbhërëkëröa ko Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono ëng'ana yö ÖMÖNENE ëkaanyëchëra ëragamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE akarambëka ököbhoko kooe, aganturubhania umunyua goone agantebhia iga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amamaaho abhërë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE yaanyëchëëyë iga, “Yeremia, nkë ökömaaha?” Nani nkagamba iga, “Nkömaaha ndë örösagia rö ömörosi röno rögösëbhöka.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aganteebhia iga, “Mbuuya, örööchë, kugira mmaiso ndë köhëkëërania ëng'ana yaane.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëkaanyëchëra ëre kabhërë iga, “Nke ökömaaha?” Nani nkagamba iga, “Ni ikinyöngö nkömaaha këratogota kiherrekëre gucha harë uni kurua Mööchë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aganteebhia iga, “Ugusikia nköraruëre Mööchë na gusiaanya abhamenyi bhonsui bhë ënsë ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira nëndabhërëkëre amagambi ga Mööchë na ichihamatë chonsui. Abhagambi bhaacho bhonsui mbaraache na këra umui waabho naratööre igitumbë keee kiu ubhuhika mbere ya amahita ga Yerusaremu na mbarëka yi ichingito chago chonsui, na kuinaara imigi gionsui ge Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani nëndëkengera Abhaisiraeri ikiina kugira ya ubhunyanku bhoobho bhonsui öbhoguntiga uni, bhakahöötëra ichinooköë ichingeni öbhöbhaani na gösengera ibhihooru bhino bhaakorrë abhiene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono mbe Yeremia uwe taiseemia. Igo! Taya öbhateebhi amang'ana gonsui gano nkögökörömërra. Ötakabhoobhoha, ntagaacha kögökora wobhohe mbere yaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.17",
            "verseOrgIds": [
              "JER.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reero ëno ndagökora wëëme kiu umugi göno gugitërë bhökong'u, kiö ömönaara gui ikiöma na kiu urugito rui iriche, guisiira ënsë yonsui, guisiira abhagambi bha Yuta, abhanene bhaayo, abhanchaama bhaayo na abhantö bhaayo bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.18",
            "verseOrgIds": [
              "JER.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaraguitani, sibhoono tëbharakërë hai kugira uni nhamui ndë na uwe kugutuuria. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.19",
            "verseOrgIds": [
              "JER.1.19"
            ]
          }
        }
      ]
    }
  ],
