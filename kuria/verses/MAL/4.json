        },
        {
          "text": "“Maaha, nkaaga urusikö örönene rööra ro koobhohia rötarahika, nëndëtöma ömönaabhi Eriya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönaabhi Eriya naarakore öbhögootaini kö abhaibhuri na abhaana bhaabho; gëtarë igo, nëndaache na gusikia ënsë yeinyu kumihiimo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
          }
