                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Öbhö 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö, amanchë gö öbhöhoru ngarëtitiria kurua kumugi gö Yerusaremu, na iring'ënga ria amanchë gayö ngarëgera kuya kunyancha ya rögörö, na iring'ënga rëndë kunyancha yë ëntahaana ya nyancha. Amanchë gayö ngarëgendeerria kunyöörröa ënkaaga yë ëmaaö gë ënkaaga ya kimuamu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö ÖMÖNENE nëwe arëbha ömögambi umuene wë ëkëbhara ikigima; nawe nëwe arëbha ÖMÖNENE umunyene, umui igo, na iriina reee ndio rërëbha iriina iriene.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënsë yonsui, götangëra Gebha kuhika Rimoni, sööchë ya Yerusaremu, nërëhonchöröa köbha irisisi iritendeeru kimui. Sibhoono umugi go Yeresaremu ngörëtama ahasë haago gukiinöngo kurua kuiihita re Bhenchamini kuhika kuiihita re karai, köhëkëra irihita re Konani, götangëra ömoonara go Hanareri kuhika kubhimëtëro bhi ichisabhibhu bhiö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.3"
              },
              "items": [
                {
                  "text": "Öbhö 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na abhantö mbarëmenya mo, timuihiimo görëbha ho guiki hai; sibhoono Yerusaremu ngörëbha na ömörembe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono igörö ya abhantö bhaara bhaachërë guitana na Yerusaremu, ëno niyo ëhöbhë ëno ÖMÖNENE arëbharentera: Ëmëbhërë geebho ngëragunde bhaabhahoru; amaiso gaabho ngaragunde garëngë kubhitökööma bhiago na ichindëmë chaabho nchiragunde chirëngë kuminyua geebho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö, irihiku kurua kö ÖMÖNENE ndërëgoota abhantö, na këra möntö nariitania öwöndë. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Yuta mbariitana guikëngëërra umugi go Yerusaremu; öbhoomë bhui ichihamatë chonsui chino chinaarrë ënsë ya Yuta mbörëkömöa: Mbarëköma ësahaabhu, amatiini gi ichimbiria na ichingëbho köbhooru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichibharaasi, ichitëkërë-bharaasi, ichingamëëra, ichitëkërë, na ichitinyi chonsui chino ndinyoora chirëngë kömasanchö gayö ga abhabhisa nchirinyoora ëtabharibharia yi intira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
    {
