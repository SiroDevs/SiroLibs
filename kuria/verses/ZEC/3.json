                "loc": "EZR.5.2"
              },
              "items": [
                {
                  "text": "Esr 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Öbhö 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömamaaho gandë, ÖMÖNENE naanyorokiri Yosua umunchaama umuhikërë aimërëëyë mbere yö ömömaraika ÖMÖNENE, na ëntahana yaae ya bhörëo Irisambö rimërëëyë iga rëmösemere. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Yuta 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömömaraika wö ÖMÖNENE agateebhia Irisambö rëyö iga, “ÖMÖNENE akuihiime, uwe rërë Isambö! Mböyö, ÖMÖNENE öno aahöra umugi go Yeruseremu akuihiime! Ömöntö öyö anga ëkëgenga këno keebhakëröë kurua kömörro!”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosua umunchaama umuhikërë wanyoorrë naimërëëyë mbere yö ömömaraika, asuarre ichingëbho ichingundo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika agateebhia abhakoramërëmo bhaae, “Taruusia Yosua umunchaama umuhikërë ichingëbho chaae ichingundo chiyö.” Sooki agateebhia Yosua umunchaama umuhikërë iga, “Maaha, nkuruusiyi iriraga reeo, nani nëndaköhe ichingëbho chë ëgooreti.” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki akabhateebhia bhamöbhohere iyaati inchiiya kömötöe. Bhöyö mbe, bhakamöbhohera iyaati inchiiya ni ichingëbho; ömömaraika wö ÖMÖNENE nawe wanyoorrë nëho aimërëëyë.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika wö ÖMÖNENE agaköga Yosua umunchaama umuhikërë, aragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ÖMÖNENE wa amacheesi aragamba iga, ‘Hano öraitabhiirri amaragirrio gaane na kögoota gaara ngöteebhiri, nöraimërëërre Inyumba yaane na ibhisumua bhiayo. Nani nëndaköhe umueya gösoha köbhökora mërëmo bhoone ke bhano bharëngë hamui na uni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.5"
              },
              "items": [
                {
                  "text": "Yer 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.15"
              },
              "items": [
                {
                  "text": "33:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.12"
              },
              "items": [
                {
                  "text": "Sek 6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhoono ntegeerra wigue, uwe Yosua, umunchaama umuhikërë; möntegeerre na bhainyu bharë bhanchaama bhano mörëngë hamui nawe, bhainyu bhano mörëngë ëkëmanyiirrio gë ënkaaga inchiiya ëno iguucha: Nëndarente ömökoramërëmo waane öno aköbhërëkëröa iga Örösagia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möhëëtöke iga ntöörrë mbere ya Yosua irigëna rimui rëno rëëna amasio muhungatë. Na uni nëndandëke igörö yaario Amandëko, na kurusikö rumui bheene, nëndaruusi ho iriraga rë ëkëbhara këno. Mböyö, uni ÖMÖNENE wa amacheesi ngambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.4"
              },
              "items": [
                {
                  "text": "Mik 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Urusikö röyö, ndagamba iga ÖMÖNENE wa amacheesi, këra umui weinyu narërarëka öwönde kuigookera ömörembe na ëgaareeya kömögöndö gooe göë ëmësabhibhu na ëmëkö.’”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        }
      ]
    }
  ],
