            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
