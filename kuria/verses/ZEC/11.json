          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ëhöbhë kumuriisia ömöbhëëbhë,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
