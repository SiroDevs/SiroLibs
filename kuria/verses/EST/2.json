              "type": "text"
            }
          ]
        },
        {
          "text": "Motekai akamanya inikö ëyö, agateebhia Esita ömökari wö ömögambi, Esita nawe agateebhia ömögambi amang'ana gayö. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
