        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ömögambi na Hamani bhakaya köndaagëra na Esita ömökari wö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.1",
            "verseOrgIds": [
              "EST.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro kabhërë, hano bhaarë kunyua itibhaai, ömögambi akabhuuria guiki Esita iga, “Bhoono, Esita ömökari wö ömögambi, nkë ugutuna? Tanteebhia, na uwe nörakinyoore. Irituno reeo nkë? Ninyoora ni iring'ënga riö öbhögambi bhoone, nörahaabhöe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.2",
            "verseOrgIds": [
              "EST.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita ömökari wö ömögambi akamuhunchukiria iga, “Hano ndanyoore nyoorrë öbhöhanchirri harë uwe, uwe ömögambi, na hano örahaanche köhëkërania irituno reene, irituno reene uni niiga nmenye na abhantö bhaane nabho bhamenye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.3",
            "verseOrgIds": [
              "EST.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira, uni na abhantö bhaane toguribhua iga tuitue, gusikibhua na gösereekibhua. Hano tökaguriibhui köbha abhagöre abhasaacha na abhagaikörö nëngaikaayë nkiri na tëngakuiriirri hai. Ninyoora ntörasereekibhöe kimui taaho mubhisa öno agaatöra köhakana ëhaasara ëno kömögambi.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.4",
            "verseOrgIds": [
              "EST.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.4",
            "verseOrgIds": [
              "EST.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö Ömögambi Ahasuero akabhuuria Esita ömökari wö ömögambi iga, “Ning'ui öyö agösaacha gökora ëng'ana ke ëyö? Nëhai arë möntö öyö?” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.5",
            "verseOrgIds": [
              "EST.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita akamuhunchukiria iga, “Umubhisa weitö ömönene na umuitania weitö nu umunyanku öno Hamani!” Hayö Hamani akagootöa na irihiku mbere yö ömökari wö ömögambi na ömögambi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi akaimöka köbhörrö, akarichoka kurua möno bhaarë kunyeera itibhaai akaya këbhara gukibhumburio ki inyumba nköraano. Hano Hamani aarööchë iga ömögambi namasërë iga amöbhörööte, naatamërë nyuma arageya Esita ahoni amabhaho gaae. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.7",
            "verseOrgIds": [
              "EST.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi naaringërë kurua gukibhumburio, na hano aasohërë kugisuumua mööra bhaarë kunyeera itibhaai naanyoorrë Hamani airambaarrë hang'i na iritumbë rëno Esita wanyoorrë aikaayë. Hano aarööchë igo ömögambi agakuura ikuuratë aragamba iga, “Gösë ömöntö öno ngutuna arë agake ömökari wö ömögambi mbere yaane na kunyumba nköraano?” Hayö igo ömögambi atarasookia kögamba, ichinture bhakagubha Hamani ubhusiö. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haribhona, öno aarë umui wa ichinture bhaara bhaarë kuirigania ömögambi akagamba iga, “Hamani nasaachërë gökora ömötë go guitëra Motekai öno aatuurri amabhaho gaao uwe ömögambi. Ömötë göyö, göno gööna öbhötambë bhui ichimiita mërongo ëbhërë na ibhërë, ninyoora mboono igo nka waae haara görëngë.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö ömögambi akaruusia ëngamba iga, “Muitëre Hamani ko bheene.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani agaitëröa kömötë gö guitëra göno wanyoorrë aseemiiyi Motekai. Köhayö, öbhörrö bhö ömögambi bhögatënda.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
              "EST.7.10"
            ]
          }
        }
      ]
    }
