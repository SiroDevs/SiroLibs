{
  "id": "EZK.4",
  "number": "4",
  "bookId": "EZK",
  "reference": "Esekieri 4",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
