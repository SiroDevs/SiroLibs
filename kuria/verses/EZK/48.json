        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubhutuenani bhui irirëma kubhiaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amariina gi ibhiaro na amarëma gaabho: Kögötangëra köbhaga ya sööchë kuirongatë re Hetironi köhetera Hamati kuhika kumugi go Hasari-enoni (göno görëngë köbhaga ya Tamasiko na Hamati ëntahana ya mööchë, na kurua rögörö kögëëra Nyancha ya Metiterania), ömögöndö göyö ngörëbha ugui ikiaro ge Tani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno ituurraini na Tani kurua rögörö kuhika nyancha nërëbha iya Aseri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiaro ge Nabhutari, nkirinyoora ëntahana ëno ituurraini na iya Aseri, kurua rögörö kuhika nyancha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua göntahana yi ikiaro ke Nabhutari, ahasë hi ikiaro ke Manase, harëgëroobhera kurua rögörö kuhika nyancha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno bhituurraini na iya Manase, kurua rögörö kuhika nyancha nërëbha iyi ikiaro ke Ebhuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno bhituurraini na Ebhuraimu, kurua rögörö kuhika nyancha nëërëbha iyi ikiaro ke Rubheni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno bhituurraini na iya Rubheni kurua rögörö kuhika nyancha nërëbha iyi ikiaro ke Yuta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubhutuenani bhui irirëma gatai yi ibhiaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kögösookirria göntahana yi ikiaro ke Yuta, nöraahöre ahasë hö öbhötambë bhui ichikiromiita ikumi na ibhërë na ahasë ke hayö bheene, kurua mööchë kuhika sööchë, na öbhötambë ke bhöyö kurua rögörö kuhika nyancha, hareng'aane na ibhiaro bhionsui. Gataigatai ya ahasë hayö nëho harëbha ahasë ahahoreeru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano öreehöra gikugira yö ÖMÖNENE harëbha ichikiiromiita ikumi na ibhërë na iritënë harë ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhanchaama mbaarëbha na iring'ënga reebho köhasë hayö. Ahasë hayö harëbha ichikiromiita ikumi na ibhërë na iritënë kurua rögörö kuhika nyancha, na kurua mööchë kuhika sööchë. Ahasë ahahoreeru hö ÖMÖNENE harëbha gataigatai ya ahasë hayö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hayö harëbha aha abhanchaama bhu uruibhöro ro Satoki, bhano bhaankoreyë köbhöheene bhakanga götëëya nkaaga Abhaisiraeri bhaatëëyërë keebhörë Abharawi bhaakorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö harëbha ahaabho ahanuhe kurua köhasë ahahoreeru hë ënsë, ahasë ahahoreeru bhökong'u, hano harituura göntahana ya Abharawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abharawi nabho, ahasë haabho harëbha sööchë göntahana ya abhanchaama. Iring'ënga rëyö ndërëbha öbhötambë bhui ichikiromiita ikumi na ibhërë na iritënë kurua rögörö kuhika nyancha, na öbhögarë bhui ichikiromiita isaano kurua mööchë kuhika sööchë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëntahana ërë yonsui ya ahasë hayö iriguribhua gösë köhaanöa kömontö örë wonsui, kugira ahasë hayö na ahahoreeru kö ÖMÖNENE; naho na ahaiya gökëra ënsë yonsui.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iring'ënga irinuhe rëno rërëtama, ndërëbha na öbhötambë bhui ichikiromiita ikumi na ibhërë na iritënë na öbhögarë bhui ichikiromiita ibhërë na iritënë, ndërëbha ëre gökorra ëmërëmo giu umugi: Ahasë ha kömenya na ahë ëmëgöndö. Gataigatai yaho nho umugi görëbha, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nago öbhötambë na öbhögarë mbirëreng'aana, këra ntahana ichimiita ibhiköë bhibhërë na amagana abhërë na mërongo ëtaano (2,250) kuinaara umugi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hataana gëntö hano hainaarrë umugi gonsui nharëbha ichimiita irigana rimui na mërongo ëbhërë na isaano (125). ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë ahahoreeru hano harëtama ëhekaru ësookiri köhagaachöa, sööchë yu umugi, ichikiiromiita isaano harë ibhërë na iritënë, ëntahana ya rögörö, ichikiromiita isaano harë ibhërë na iritënë ënthana ya nyancha, harëbha aha körëma köbhamenyi bhu umugi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano bhaagökora ëmërëmo kumugi, gukurua ibhiaro bhionsui bhia Isiraeri, mbakaarëma köhasë hayö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ahasë honsui hano öreehöra, nkö ökögamba iga, ahasë ahahoreeru hamui na ahasë hu umugi, haraabhe na öbhötambë na öbhögarë bhino bhireng'aaini, ichikiiromiita ikumi na ibhërë na iritënë këra ntahana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hagötama guchintahana chonsui icha ahahoreeru na ahasë hu umugi, nkö ökögamba iga, ahasë haara hareng'aini ichikiromiita ikumi na ibhërë na iritënë kurua këra ntahana, gukurua rögörö kögëëra Nyancha ya Metiterania, hano hataachërraini na amang'ënga gi ibhiaro, nho harëbha ahö ömögambi. Ahasë ahahoreeru na ëhekaru hano harëngë gataigatai yaago, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ahasë ha Abharawi hamui na ahu umugi, harëbha gataigatai ya ahasë hö ömögambi. Ahasë hö ömögambi harëbha köbhaga yi ikiaro ke Yuta na ikiaro ke Bhenchamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irirobha ri ichihamatë chindë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiaro bhino bhitamërë mbirituenanibhua ahasë haabho iga, ikiaro ke Bhenchamini nkërëhaabhöa ahasë gukurua rögörö kögëëra Nyancha ya Metiterania. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hatuurraini na haara ha Bhenchamini kurua ëntahana ya rögörö kögëëra ëntahana ya nyancha harëbha ahë ikiaro ge Simioni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hatuurraini na ëntahana ya Simioni kurua ëntahana ya rögörö kögëëra ëntahana ya nyancha nharëbha ahi ikiaro ge Isakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hatuurraini na ikiaro ge Isakari kurua ëntahana ya rögörö kögëëra ëntahana ya nyancha, nharëbha ahi ikiaro ge Sabhuroni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hatuurraini na ikiaro ge Sabhuroni kurua ëntahana ya rögörö kögëëra ëntahana ya nyancha, nharëbha ahi ikiaro ke Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë hano hatuurraini na ikiaro ke Gati kögëëra sööchë, ëbhaga niriruua ku umugi go Tamari kuhika kubhichabhichabhi bhia Meribha gatesi na köhetera ëntahana ya rögörö ya Misiri kuhika Nyancha ya Metiterania. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rëyö ndio irirobha ri ibhiaro bhia Isiraeri. Hayö nho bharëhaabhöa amang'ënga gaabho, këra ikiaro ahasë hakio. ÖMÖNENE Ënooköë agambërë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
      ]
