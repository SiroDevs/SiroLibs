                }
              ]
            }
          ]
        },
        {
          "text": "Nëndëmenya harë bho; nëndëbha Ënooköë waabho nabho mbarëbha abhantö bhaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
