          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe ömoona wö ömöntö! Tarëa ënaabhi ögambe iga uni ÖMÖNENE Ënooköë ndagamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
