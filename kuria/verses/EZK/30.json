          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abhantö bhano bhagösanga na Misiri, nko kögamba iga, abhantö bha Kusi, Bhuti, Ruti, Arabhia yonsui na Ribhia mbarisikibhua gunchonge hamui nabho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
