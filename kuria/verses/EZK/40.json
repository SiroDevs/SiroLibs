        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.12",
            "verseOrgIds": [
              "EZK.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönto öra agatiima öbhöharai kurua kundigi ya nyuma yi igisuumua kimui keebhio kuhika kundigi ya nyuma yi igisuumua ëntahana ya kabhërë yi irihita akanyoora ichimiita ikumi na ibhërë na iritënë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.13",
            "verseOrgIds": [
              "EZK.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igisuumua ke gösookirria nkëno keebhatërë kuihita ri irigori. Agatiima igisuumua këyö nakio nkeerëngë öbhögarë bhui ichimiita ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.14",
            "verseOrgIds": [
              "EZK.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua mbere yö öbhösohero bhui irihita kuhika kömörengo mönsë yi irihita ncharëngë ichimiita mërongo ëbhërë na isaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.15",
            "verseOrgIds": [
              "EZK.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irihita ndeerë na ichindöhö nkenke guchingito cha isikö chi ibhisuumua bhionsui hamui na ichindigi chino chaahökaini ibhisuumua. Amachaaria gë ëmëtende ngaarë kömëhörö ge mönsë gëno geebhatërë kömörengo go köhetera.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urugito ro Isikö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömöntö öra akaahira kuhika köröbhago ro isikö yë ëhekaru. Hayö mbiarë ho ibhisuumua mërongo ëtatö bhino bhieinaarrë indigi ya isikö na mbere ibhisuumua bhiyö hansë waanyoorrë haarrë amagëna. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.17",
            "verseOrgIds": [
              "EZK.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hansë hayö haariibhui hakainaara amahita gököreng'aana na öbhötambë bhoogo; hayö nhaarëngë ahasë hansë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.18",
            "verseOrgIds": [
              "EZK.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki, ömöntö öra agatiima öbhöharai bhuë ënchëra ëno yaarë kurua bhoori bhuë ëntahana ya nsë kögëëra isikö yö öbhoori bhöyö, akanyoora ichimiita mërongo ëtaano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irihita re mööchë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, ömönto öra agatiima öbhötambë na öbhögarë bhui irihita rë ëntahana ya mööchë yö öröbhago ro isikö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.20",
            "verseOrgIds": [
              "EZK.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhisuumua bhitatö bhia abhariihi bhino bhiaarë këra ntahana yi irihita, ibhitiimo bhië ëmëhörö na öbhösohero bhobhio mbiareng'aini na bhiira bhi irihita re mbere. Öbhötambe bhuë ënchëra ëëra yonsui mboorë harë rimui ichimiita mërongo ëbhërë na isaano na öbhögarë bhöyö mboorë ichimiita ikumi na ibhërë na iritënë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.21",
            "verseOrgIds": [
              "EZK.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igisuumua ke gösohera na amatirisa gakio, hamui na ëmëtende gëëra waanyoorrë gechaaribhua kurugito, bhionsui mbiatuubhaini na bhiira bhi irihita re rögörö. Hayö ho bhiarëngë ibhikanëro muhungatë bhia körëënëra kuihita, na öbhösohero bhorio mboorë mbere yaario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.22",
            "verseOrgIds": [
              "EZK.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua gönchëra ëyö ya gösohera ya mööchë na götamböka öröbhago röyö kimui yaarëngë ho ënchëra yëndë ya gösohera ëno yaarë kögëëra bhoori, ke ëëra yaarëngë ëntahana ya rögörö. Ömöntö öra agatiima öbhötambë bho kurua gönchëra imui kuhika kuyëndë, akanyoora ichimiita mërongo ëtaano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.23",
            "verseOrgIds": [
              "EZK.40.23"
            ]
          }
        }
      ]
