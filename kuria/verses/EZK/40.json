              "EZK.40.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 40:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öra agatiima urugito ro mönsë röno wanyoorrë röreng'aini ichintahana chonsui na öbhögarë bhoochio mboorë ichimiita mërongo ëtaano. Irikëngë ndeerë mbere yë ëhekaru yö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.47",
            "verseOrgIds": [
              "EZK.40.47"
            ]
          }
        }
      ]
