                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Ëbh 28:16-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Urusikö ro ikumi na kanai ru umueri go mbere mmöraayi mörakora ësögökörö yë ëbhasaka, guchinsikö muhungatë, mmöraayi mörarëa ëmëgaate gëno gëtatöörröë iriogo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö ömögambi naraayi aramuensa ëgaini imui gikugira yi ikimuenso ki iriraga reee umuene na Abhaisiraeri bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruiso ronsui guchinsikö muhungatë chiyö, naraayi araruusiria ÖMÖNENE ikimuenso ke gösambërëërröa ichigaini muhungatë na ichiguruki muhungatë chino chitaana ikoori ku guchisambërëërra ichingima. Kuhika akore ikimuenso ki iriraga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua aaseemi ësataaka yi ibhiakörëa ichikiro ikumi harë këra ëgaini na ichikiro ikumi harë këra guruki, sooki amaguta ichiriita isatö harë këra ichikiiro ikumi chö öbhöse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        }
      ]
