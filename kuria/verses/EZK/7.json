    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iribhörööta re Isiraeri kugira ya amaraga",
          "type": "text"
        }
      ]
    }
