          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe ömoona wö ömöntö, teebhia abhamenyi bhë ënsë ya Isiraeri iga ÖMÖNENE Ënooköë aragamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        }
