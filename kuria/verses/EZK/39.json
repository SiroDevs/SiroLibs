              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayo uni ÖMÖNENE Ënooköë ndagamba iga, Bhoono nëndaabhëre Abhaisiraeri uruibhöro ro Yakobho, na köbharingiria ëmësaraaro geebho. Ngutuna ndë iga iriina reene irihoreeru rësöököe kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.25",
            "verseOrgIds": [
              "EZK.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndinyoora bhamenyërë kögaareeya gönsë yaabho, bhatakoobhohirribhua, mbariëbha ichinsoni chaabho na öbhöteeyu bhöno bhaankoreeyë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
            "verseOrgIds": [
              "EZK.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö, nindinyoora naabharingia kurua guchihamatë na köbhaköma kurua guchinsë cha abhabhisa bhaabho na köherekia ubhuhika bhoone mbere yi ichihamatë ichincharu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua mbarëmanya iga nu uni ÖMÖNENE, Ënooköë waabho, kugira uni nnaabhahirrë köng'aanyi guchihamatë na köbharingia guiki gönsë yaabho. Tinditiga ninyoora nu umui waabho atigare guchihamatë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndëhömëërra Abhaisiraeri ënkoro yaane, tindihönchöra guiki iga bhange köömaaha. Uni ÖMÖNENE Ënooköë ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.29",
            "verseOrgIds": [
              "EZK.39.29"
            ]
          }
        }
      ]
