              "EZK.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.17"
              },
              "items": [
                {
                  "text": "Öbhö 19:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Bhoono, uwe ömoona wö ömöntö, uni ÖMÖNENE Ënooköë ndagamba iga, Bhërëkëra ibhinyunyi bhionsui na ichitiinyi chonsui cha masisi bhikömane kurua guchintahana chonsui bhiiche körëa ësögökörö yi ikimuenso këno nköbhaseemiria, ëno ërëbha ënene bhökong'u guchinguku cha Isiraeri, harë bhirërëa ichinyama na kunyua amanyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbirërëa ichinyama cha abhakarë, mbirinyua amanyinga ga abhanene bhë ëkëbhara bhano bharëgoogoa kia amaguruki gösë ibhichöörö, gösë ichimburi, gösë ichigaini ichiinuru cha Bhasani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösögökörö ëyö nkubhiseemiria mbirërëa amaguta bhiigöte. Mbirinyua amanyinga bhireehöe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua kömeesa yaane mbiriigutibhua na ichibharaasi, abhagendia bhi ichibharaasi, abhakarë hamui na abhaitani bhi iriihi bhonsui. Uni ÖMÖNENE Ënooköë ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeri ërakoröa bhuuya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aganteebhia iga, “Nëndëkora ichihamatë chonsui chimaahe ubhuhika bhoone, na guchiorokia keebhörë ngötömëra ichinguru chaane kögökenga ibhiina bhiane bhiö öbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbarëmanya iga nu uni ÖMÖNENE, Ënooköë waabho, kurua röyö na kuya mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
            "verseOrgIds": [
              "EZK.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichihamatë nchirëmanya iga Abhaisiraeri mbaagëëyë köng'aanyi gikugira ya amasaria gano bhansariiyi abhiene. Mbaanteyeeyë, nani nkaihönchöra bhakanga kömmaaha, nkabhatööra kömabhoko ga abhabhisa bhaabho bhagaitua gunchonge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.23",
            "verseOrgIds": [
              "EZK.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naihönchööyë bhakanga köömaaha, nkabhakorra gano gareng'aini na ubhunyanku na amasaria gaabho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
