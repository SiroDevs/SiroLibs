                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kurusikö ro ikumi na kabhërë, kumueri go ikumi, kömooka go ikumi gukurua toong'aanyibhui, ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe ömoona wö ömöntö! Magakiria Bharao ömögambi o Misiri, umunyeere ënaabhi na ënsë yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möteebhia iga: Uni ÖMÖNENE Ënooköë ndagamba iga:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.12",
            "verseOrgIds": [
              "EZK.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sibhoono uni ÖMÖNENE Ënooköë ndagamba iga, Hano ëmeeka mërongo ënai girisira nindiiria Abhamisiri kurua guchihamatë chino ndinyoora bhaanyereganibhua kuya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindiringia Abhamisiri mbakore bhuuya. Nëndëbharingia gönsë ya Bhatirosi, ënsë yaabho yënsëmöka. Hayö mbaarëbha na öbhögambi bhöno bhötaana nguru, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "öbhögambi öbhörosu gökëra amagambi gonsui; na tëbhariiyimukirria guchihamatë chindë hai. Nëndëkora Abhamisiri bhabhe abhantö abharosu bhano bhatagaatöra köbhaaha ichihamatë chindë guiki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri tëërëbha na nguru cha guiteng'eröa na abhantö bha Isiraeri hai. Abhaisiraeri mbarëhëëtöka möna bhaasarri kuguiteng'era ënsë ya Misiri. Abhaisiraeri mbaarëmanya iga uni nö ÖMÖNENE Ënooköë ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömögambi Nebhugatinesa narëkëra Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro mbere ru umueri go mbere, kömooka go mërongo ëbhërë na muhungatë gukurua toong'aanyibhui, ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe ömoona wö ömöntö! Nebhugatinesa, ömögambi o Bhabheri aaha iricheesi reee ëmërëmo ëmëkong'u ge gösoherra Tiro. Ëmëtöe gionsui gia abhaanacheesi bhaae ngeetëkërë ichibhööya na amarëko gonsui ngaamiökërë. Sibhoono we, gösë iricheesi reee tëbhaanyoorrë bhuëra hano bhaasoherreeyë Tiro hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, uni ÖMÖNENE Ënooköë ndagamba iga, Nëndëha Nebhugatinesa ömögambi o Bhabheri, ënsë ya Misiri. Narëroona ibhintö bhiayo bhionsui na gökora öbhoomë bhooyo köbha ëhakano yi iricheesi reee. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamöha ënsë ya Misiri ëbhe ëhakano yi ibhigeri bhiae gikugira amacheesi gaae ngaankoreeyë ëmërëmo. Uni ÖMÖNENE Ënooköë ngambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö nëndëkora Abhaisiraeri bhabhe na ichinguru na bhakuigue uwe Esekieri hano waasumaacha nabho. Nabho mbarëmanya iga uni nö ÖMÖNENE ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        }
      ]
    }
  ],
