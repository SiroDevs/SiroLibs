            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuirëma ri ikiaro ke Isakari, mbaahaayöë Kisioni hamui na amasisi gaago gu ubhuriisiriö, Taberati hamui na amasisi gaago gu ubhuriisiriö. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
        {
          "name": "verse",
