          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesiboni hamui na amasisi gaago gu ubhuriisiriö na Yeseeri hamui na amasisi gaago gubhuriisiriö. Gionsui ngeerë imigi ënai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
