          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigi gionsui gëno uruibhöro ro Mërari, nko ökögaamba iga, ichika cha Abharawi chino chaatigaayë nchaarë ikumi na ibhërë.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
