          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhi ikiaro kia Abharawi abhe ëka ya Gerisoni, mbaahaayöë imigi ëbhërë kuirëma ri iritënë ri ikiaro ke Manase: Gorani go Bhasani, umugi gö öbhöng'osero hamui na amasisi gaago gubhuriisiriö, Bhesi-tera hamui na amasisi gaago gu ubhuriisiriö. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
