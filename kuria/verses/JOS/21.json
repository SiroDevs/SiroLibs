          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarimuti hamui ni irisisi reegoo riu ubhuriisiriö, na Eni-ganiimu hamui na amasisi gaago gubhuriisiriö. Imigi gëno bhaahaayöë ngeerë ënai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        },
        {
          "name": "verse",
