          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köröng'ngo rui ikiaro ke Gati mbaahaayöë Ramoti ya Gireati, umugi gö öbhöng'osero, hamui na amasisi gaago gu ubhuriisiriö Mahanaimu hamui na amasisi gaago gu ubhuriisiriö ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
