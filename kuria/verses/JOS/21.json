          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketemoti hamui na amasisi gaagio gi ibhiriisiriö, Mebhati hamui na amasisi gaago gubhuriisiriö. Gionsui imigi ënai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
