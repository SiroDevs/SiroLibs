          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, imigi gëno ëka ya Kohati bhano bhaatigaayë ngeerë ikumi hamui na amasisi gaagio gibhiriisiriö.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
