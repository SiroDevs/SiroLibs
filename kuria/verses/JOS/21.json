          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köröng'ngo rui ikiaro ke Rubheni mbaahaayöë Bheseri hamui na amasisi gaago gu ubhuriisiriö Yahasi hamui na amasisi gaago gubhuriisiriö ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
