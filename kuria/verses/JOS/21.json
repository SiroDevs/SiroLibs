          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuirëma ri ikiaro ke Aseri mbaahaayöë Misari hamui na amasisi gaago gubhuriisiriö, Abhutoni hamui na amasisi gaago gubhuriisiriö, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herikati hamui na amasisi gaago gu ubhuriisiriö na Rehobhu hamui na amasisi gaago gubhuriisiriö. Imigi gionsui gëno bhaahaayöë ngeerë ënai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.31",
            "verseOrgIds": [
              "JOS.21.31"
            ]
          }
