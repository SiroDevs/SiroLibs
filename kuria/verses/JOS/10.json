            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Egironi Yosua na Abhaisiraeri bhonsui bhakaya bhakahika Hebhuroni, bhakagösoherra ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kögömeria. Bhagaita gunchonge abhamenyi bhaamo bhonsui hamui na ömögambi waago; bhagatëmöra kimuikimui imigi gëndë gëno geguinaarrë, bhagasikia kimui abhamenyi bhaamo bhonsui keebhööra bhaakorrë Egironi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
