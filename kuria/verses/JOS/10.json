          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Yosua akameria ënsë yonsui; agakëra abhagambi bhë ëntahana yi ichinguku, ëntahana ya Negebhu, ëntahana yi iritendeera na yi ibhing'aaraario. Taatigire kërë gionsui keerë këhoru hai, gëtatiga naasikiri kimui këra gëntö keebhörë ÖMÖNENE Ënooköë wa Isiraeri aasimisiiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosua naakërrë abhantö bhonsui gukurua Gatesi-bharinea kuhika Gasa, na gukurua Goseni kuhika Gibheoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosua naagotërë abhagambi bhano bhonsui na kuigaria ichinsë chaabho chonsui harë rimui igo, kugira ÖMÖNENE Ënooköë wa Isiraeri naitanëëyë Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Yosua hamui na Abhaisiraeri bhonsui bhakaringa kuya Girigari guisanchö reebho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
