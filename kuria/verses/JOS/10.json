          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Ribhuna Yosua na Abhaisiraeri bhonsui bhakaya Rakisi, bhakagönaaria na kögösoherra. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ÖMÖNENE akahebherria umugi goyo kö Abhaisiraeri bhakagömeria kurusikö ro kabhërë. Bhagaita gunchonge abhamenyi bhonsui bhu umugi göyö kehaara bhakorrë Ribhuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        }
      ]
