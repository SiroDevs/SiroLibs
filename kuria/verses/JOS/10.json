          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Maketa, Yosua hamui na Abhaisiraeri bhonsui bhakaya Ribhuna na kuguitania. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akahebherria umugi göyö hamui na ömögambi waago kö Abhaisiraeri, bhagaita gunchonge abhamenyi bhaago na konga gutigia ninyoora nu umui. Mbaakoreeyë ömögambi wa Ribhuna kehaara bhaakoreeyë ömögambi wa Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
