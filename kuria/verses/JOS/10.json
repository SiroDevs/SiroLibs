          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö ho ömögambi Horamu wa Gerasi aakengërë ikiina guucha gutuurria abhantö bha Rakisi. Sibhoono Yosua akamuita hamui na abhantö bhaae bhonsui, taatigiri ninyoora ni ntiruuki hai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
