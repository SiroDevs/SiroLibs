          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yosua na Abhaisiraeri bhakaringa Tebhiri, bhakagösoherra. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakagoota umugi göyö na ömögambi waago hamui ni imigi gëndë gionsui gëno geguinaarrë na gusikia kimui gunchonge bhano bhonsui bhaarëngë mo na tëbhaatigiri ninyoora ni intirruki hai. Bhagakorra umugi göyö kehaara bhaakoreeyë umugi go Hebhuroni na umugi go Rebhuna na abhagambi bhaagiö.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
