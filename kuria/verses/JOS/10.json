              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Rakisi, Yosua na Abhaisiraeri bhonsui bhakaya na kuhika Egironi, bhakagönaaria na kögösoherra. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
