                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.25"
              },
              "items": [
                {
                  "text": "Yak 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yosua, ömoona o Nuni, agatöma ërooti ya abhantö bhabhërë gukibhisërë kurua Sitimu kuya köhenyahenya ënsë ya Kanaani, si bhahënge Yeriko. Bhakaya bhakahika kunyumba yö ömöraaya wöndë iga Rahabhu bhakaraara mo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi wa Yeriko agateebhibhöa iga, “Tamaaha, abhasaacha bhabhërë Abhaisiraeri bhutikö bho reero mbasohërë kumugi göno korri bhahenyehenye ënsë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi wa Yeriko agatöma abhantö harë Rahabhu aragamba iga, “Richokia abhantö bhano bhasohërë kunyumba yaao, kugira mbaachërë, köhenyahenya ënsë yonsui.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömögaikörö ööra nkanyoora abhisirë ërooti ëëra. Köhayö agateebhia abhantö bhaara bhatömëröë iga, “Mmaheene abhantö bhayö mbaachërë moone, sibhoono tëmanyërë harë bharuurë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ënkaaga ya gusiika irihita ihikërë, na igisuntë köbha, abhantö bhayö mbarichokërë, na harë bhagëëyë tëmanyërë hai; hano mökanguhirria köbharondia mökabhagoota.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si nkanyoora abhabhisirë irongo na köbhakundikiria ëmëtaani gëno wanyoorrë aaria irongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niigo abhantö bhaara wanyoorrë bhaatömëröë nö ömögambi bhaarichokërë igo, irihita rëgasiiköa. Bhakarondia ërooti ëyö köhetera gönchëra yi ibhitabhöka bhia Yorotani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rahabhu akagëëra ërooti ëëra irongo ëtaraihiribhöa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akagëteebhia iga, “Uni nëmanyërë iga ÖMÖNENE abhaha ënsë ëno; toogootoa nö öbhoobha gikugira yeinyu, na abhamenyi bhonsui bhë ënsë ëno bhaahaha gikugira yeinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.21"
              },
              "items": [
                {
                  "text": "Ëgt 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Ëbh 21:21-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira toigua keebhörë ÖMÖNENE aakamukiri amanchë ga Nyancha Mberretu mbere yeinyu nkaaga moorë kurua Misiri, na keebhörë mookorrë abhagambi bhabhërë bha Abhaamori bhano wanyoorrë bhamenyërë ihumbu ya Yorotani, nabho Sihoni na Ogu, bhano moosikiri kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano toiguurë igo ntoosërëëyöë ichinguru, na tëbhökarë bhootamërë kömösaacha örë wonsui gikugira ya bainyu. Kugira ÖMÖNENE, Ënooköë weinyu nëwe Ënooköë wa igörö kuriöbha na hansë gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö bhoono, tuenerria kuriina riö ÖMÖNENE iga gukugira nëmbakoreeyë amaiya na bhainyu mökorre umugi go taata amaiya, na mööng'e ëkëmanyiirriö kiö öbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndagana iga mörahoni taata na bhaabha, bhamura bha möitö na bhasubhaati bha mueitö, na ichika chaabho chonsui; möratöbhohori kurua kuruku.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhaara bhakamuhunchukiria iga, “Öbhöhoru bhoinyu no öbhöhoru bhoitö! Hano ndanyoore ötaatöbhöre amang'ana gaitö, ntörabhakorre amaiya hano ÖMÖNENE aratöhe ënsë ëno.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Rahabhu agasikiria abhantö bhaara kurusiri köhetera guitirisa kugira inyumba yaae wanyoorrë nëhagaachëröë mbarëka yu urugito ru umugi, korri amenye kuigori. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
            "verseOrgIds": [
              "JOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabhateebhia iga, “Taya muigunye kubhikerege, gëtarë igo mörasikane na bhaara bhaköbharöndia. Muigunye guchinsikö isatö kuhika bharinge, hakurua bhoono mögendi bhoinyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhaara bhakamöteebhia iga, “Bhaitö ntöragökorrë ëng'ana ëno igirrë tuitueneerreeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.17",
            "verseOrgIds": [
              "JOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano turiicha kumugi göë ënsë ëno, uuche köbhoha urusiri öröbherretu röno guitirisa rëno utusikiriiyi; hakurua uuche gököma kunyumba yaao möno isaweinyu, nyaköweinyu na bhamura bha mueinyu na ëka yonsui ya isaweinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.18",
            "verseOrgIds": [
              "JOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömöntö örë wonsui aririchoka kurua nyumba na guitöa amaanyinga gaae tëgarëbha igörö yeitö hai. Si hano ömöntö örë wonsui öno arëngë nyumba ariitöa amaanyinga gaae ngarëbha igörö yaitö. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.19",
            "verseOrgIds": [
              "JOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ögatöbhöra öbhöhenyihenyi bhoitö bhoono, hayö tëtökaabha na isaria kugutueneerria köno ugirrë tuitueneerreeyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akagamba iga, “Tiga këbhe keebhöyö mögambere.” Hakurua akabharichokia bhakaya. Nawe akabhoha urusiri öröbherretu rööra guitirisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ërooti ëëra ëkaya ëkagunya kubhikerege guchinsikö isatö kuhika hano bhaara bhaarë köbharondia bhaaringërë na gösoha kumugi go Yeriko kugira bhabharigiri bhangërë köbhanyoora. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.22",
            "verseOrgIds": [
              "JOS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho ërooti ëëra yaasëkëëyë kurua kubhikerege na köröbhöka na kuhika harë Yosua ömoona o Nuni; bhakamöteebhia gonsui gano gaabhanyoorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.23",
            "verseOrgIds": [
              "JOS.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakamöteebhia iga, “Mmaheene ÖMÖNENE ahebherreeyi ënsë harë bhaitö. Na gukuengeria ëyö, abhamenyi bhonsui bhë ënsë bhahahërë gikugira yeitö.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.24",
            "verseOrgIds": [
              "JOS.2.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
