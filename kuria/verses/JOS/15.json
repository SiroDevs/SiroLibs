          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarimuti, Aturamu, Soko, Aseka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.35",
            "verseOrgIds": [
              "JOS.15.35"
            ]
          }
        },
        {
          "name": "verse",
