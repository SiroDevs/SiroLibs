            "number": "36",
            "style": "v",
            "sid": "JOS 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saraimu, Atitaimu, Getera na Geterotaimu. Imigi gionsui gëno bhaahaayöë ngeerë ikumi na ënai hamui na ichimberi chaagio.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.36",
            "verseOrgIds": [
