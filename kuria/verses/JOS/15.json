          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigi gëno geerë ëntahana yi inguku ngëno: Samiri, Yatiri, Soko, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tana, Kiriati-sana nko kögamba iga (Tebhiri), ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.49",
            "verseOrgIds": [
              "JOS.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anabhu, Esitemoa, Animu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.50",
            "verseOrgIds": [
              "JOS.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goseni, Horoni na Giro. Imigi gëno bhaahaayöë ngeerë ikumi na gumui hamui ni ichimberi chaagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JOS 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaahaayöë imigi ge Arabhu, Tuma, Esani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.52",
            "verseOrgIds": [
              "JOS.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JOS 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanimu, Bheti-tabhua, Abheka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.53",
            "verseOrgIds": [
              "JOS.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JOS 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humuta, Kiriati-aribha nko kögamba iga (Hebhuroni) na Siori. Imigi gionsui gëno bhaahaayöë ngeerë kenda hamui na ichimberi chaagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.54",
            "verseOrgIds": [
              "JOS.15.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JOS 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaahaayöë imigi ge Maoni, Karimeri, Sibhu, Yuta, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.55",
            "verseOrgIds": [
              "JOS.15.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JOS 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesireri, Yokiteamu, Sanoa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.56",
            "verseOrgIds": [
              "JOS.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JOS 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaini, Gibhea na Timuna. Imigi gionsui gëno bhaahaayöë ngëëre ikumi hamui na ichimberi chaagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.57",
            "verseOrgIds": [
              "JOS.15.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JOS 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na guiki imigi ge Harihuri, Bheti-suri, Getori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.58",
            "verseOrgIds": [
              "JOS.15.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JOS 15:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarati, Bheti-anooti na Eritekoni. Imigi gionsui gëno bhaahaayöë ngeerë ësansabha hamui na ichimberi chaagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.59",
            "verseOrgIds": [
              "JOS.15.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaahaayöë Kiriati-bhari, göno guiki gököbhërëkëröa iga Kiriati-yearimu, na Rabha. Imigi gëno bhaahaayöë në ëbhërë hamui na ichimberi chaagio.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
              "JOS.15.60"
            ]
          }
        }
      ]
    },
