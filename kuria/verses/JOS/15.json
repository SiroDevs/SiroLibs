          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikiragi, Matimana, Sansana, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.31",
            "verseOrgIds": [
              "JOS.15.31"
            ]
          }
        },
