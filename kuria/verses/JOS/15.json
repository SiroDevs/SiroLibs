            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eritorati, Kesiri, Horima, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.30",
            "verseOrgIds": [
              "JOS.15.30"
