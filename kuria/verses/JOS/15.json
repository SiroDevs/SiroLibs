          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigi gëno geerë guitendeera ngëno iga, Esitaori, Sora, Asina, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        },
