          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigi gëno geerë guiköngö ngëno iga, Bheti-arabha, Mitini, Sekaka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JOS 15:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibhusani, Umugi Gui ikiönyö na Engeeti. Imigi geno bhaahaayöë ngeerë ësaansabha hamui na ichimberi chaagio.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.62",
