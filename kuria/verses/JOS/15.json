          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaahaayöë imigi ge Senani, Hatasa, Migitari-gati, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.37",
            "verseOrgIds": [
              "JOS.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tireani, Misibha, Yokiteeri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.38",
            "verseOrgIds": [
              "JOS.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakisi, Bhosikati, Egironi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.39",
            "verseOrgIds": [
              "JOS.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabhoni, Rahimamu, Kitirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.40",
            "verseOrgIds": [
              "JOS.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geteroti, Bheti-tagoni, Naama na Maketa. Imigi gionsui gëno bhaahaayöë ni ikumi në esansabha hamui na ichimberi chaagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.41",
            "verseOrgIds": [
              "JOS.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaahaaöë imigi ge Ribhuna, Eteri, Asani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.42",
            "verseOrgIds": [
              "JOS.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yibhuta, Asina, Nesibhu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.43",
            "verseOrgIds": [
              "JOS.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keira, Akisibhu na Maresa. Imigi gionsui gëno bhaahaayöë ngeerë kenda hamui na ichimberi chaagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.44",
            "verseOrgIds": [
              "JOS.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaahaayöë Ekuroni hamui na imigi geego ëmëke hamui na ichimberi chaagio, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
              "JOS.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "imigi gionsui na ichimberi chino chaarëngë hang'i na Asitoti gatai ya Ekuroni na Nyancha ya Metiterania, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asitoti na Gasa hamui na imigi na ichimberi chaagio, kuhika kögëtabhöka ke Misiri na kuhika mbarëka yi Nyancha ya Metiterania.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
            "verseOrgIds": [
              "JOS.15.47"
            ]
          }
        }
      ]
