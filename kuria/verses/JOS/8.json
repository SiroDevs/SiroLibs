                {
                  "text": "Ëhë 27:2-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yosua akahagaachëra ÖMÖNENE, Ënooköë wa Isiraeri irikëngë re kumuensera kunguku ya Ebhari, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.25"
              },
              "items": [
                {
                  "text": "Ëgt 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "keebhööra Mösa ömökoramërëmo wö ÖMÖNENE wanyoorrë aasimisiria Abhaisiraeri, na keebhörë ëgëtabhö ki imigiro ke Mösa kendëkërë iga, “Irikëngë re kumuensera rëhagaachöe na amagëna gano gatabhaachërë gösë gökenga na kiöma.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "text": " Köyö nko bhaaruusiiyi ibhimuenso bhia gösambërëërröa na ikimuenso kiö ömörembe kö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hayö mbere yu umuiraniö go Abhaisiraeri, nëho Yosua aandëkërë ëkobhi yi imigiro ge Mösa kömagëna. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
