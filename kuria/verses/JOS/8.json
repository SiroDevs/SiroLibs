              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Ëhë 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.11+DEU.27.12+DEU.27.13+DEU.27.14"
              },
              "items": [
                {
                  "text": "27:11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhonsui hamui na abhatangati bhaabho, abhagaaka na Abhahökania, na abhaitongo bhonsui bhano bhaarë gatai yaabö, bhakaimëërra këra ntahana bhatachërëëyë Irisandëko ri Imuuma mbere ya abhanchaama Abharawi bhano wanyoorrë bhaaimukiri Irisandëko ri Imuuma yö ÖMÖNENE, iritënë ri irikomo ria abhantö rëkaimëërra mbere yi inguku ya Gerisimu na iritënë rëndë rëkaimëërra mbere yi inguku ya Ebhari, keebhööra Mösa, ömökoramërëmo wö ÖMÖNENE wanyoorrë aasimisiria ëkembere hayö iga kuhika bhaitabhiri Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, Yosua agasoma amang'ana ga amarago gonsui, amaitabhiriö na imiihiimo këbhörë gendëkëröë kögëtabhö ki imigiro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teng'ana ëho ëno Mösa aasimisiiyi ëno Yosua ataasomërë mbere yu umuiraniö gua Abhaisiraeri, abhagaikörö, abhaana na abhaitongo bhano bhaamenyërë nabho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
