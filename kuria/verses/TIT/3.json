                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hanö ndatöme Aritema gösë Tukiko, wangöhe uche Nikobhori tömaahane ho, gikugira nkengërë ikiina iga nëho ndaabhe gönkaaga ya mabheho. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
