              },
              "items": [
                {
                  "text": "1 Ko 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ökore bhöngö utuurri Sena ömökengibhiina na Abhoro korri iga bhatange örögendo roobho, na ömaahe iga gëntö kërë gionsui gëtakabhabhöra. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhika abhantö bhaitö bhiëge kuiruusia gökora amakora amaiya, korri iga bhanyoore ibhintö bhino bhirabhatuurri, na bhange guikara bhuchua. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano bhahamui na uni bhabhakeerri. Ökeeri bhaara bhatöhanchërë kubhukumia. Ësaramita yë Ënooköë ëbhe na bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
