          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge köbha na siire kömöntö örë wonsui – isiire bheene ëno möraabhe nayo nököhanchana abhiene kubhiene. Kugira örë wonsui ahanchërë öwöndë öyö nköhëkëërania imigiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.8",
            "verseOrgIds": [
              "ROM.13.8"
