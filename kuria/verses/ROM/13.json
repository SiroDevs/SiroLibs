              },
              "items": [
                {
                  "text": "Abhar 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amarago gaara iga, “Wange gökora öbhöraaya; wange guita; wange kuibha; wange kuigomba gëntö ke möntö” na agandë gonsui nkuiribhöa garë köng'ana imui ëno, “Öhanche umunyaröbhëri waao keebhörë wihanchërë uwe umuene.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöhanchi tëbhögökorra munyaröbhëri ëng'ana mbëëbhë hai. Köhayö öbhöhanchi mbo öbhöhëkëëranu bhui imigiro.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
