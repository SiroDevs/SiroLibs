          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhika ökore gayö, gikugira mömanyërë iga ënkaaga yaahikërë yaköbhööka kurua guchitëro. Kugira ubhuituuria hang'i bhörë gökëra haara tötangërë gukumia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhutikö bhusirrë na öbhökëëyë bhuhikërë hang'i. Tatiga tutige gökora amang'ana gi igisuntë, gëtatiga tuimuki ibhiögë bhia guitanëra bhiö ömörabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga töbhe na amakora amaiya kia abhantö bhano bhamenyërë köbhörabhu – tonge köbha na ëtantago ëno ëtarë, öbhöreebhi, gösë ubhunyanku, gösë öbhöraaya, gösë iribhëëha, gösë irihari. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gëtatiga muibhohe ibhiögë bhiö Ömönene Yesö Kirisitö na muriihe kuiguëra ëmëbhërë geinyu gi iriraga gukugiigutia ichigoorio chagio.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
