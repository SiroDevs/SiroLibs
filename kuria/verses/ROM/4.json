              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.29"
              },
              "items": [
                {
                  "text": "Gar 3:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëndagano ëno Ibhurahimu aragainöë iga narahaabhoe ëkëbhara köbha ömöndö, tiyaamöchëëyë we gösë uruibhöro rooe gönchëra yi imigiro hai, Sibhoono ngikugira yö öbhöröngë bhöno bhuguucha gönchëra yu ubhukumia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gar 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira hano nkanyoorrë bhano bhaakorea ömöndö mbaara bheene bhakuiguëra imigiro, ubhukumia tëbhökabhaayë na bhuëra hai, na ëndagano tëkaabhaayë gëntö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigiro nkörenta gërë ubhusinanku bhöë Ënooköë; si hano imigiro gëtarë, tisaria rëëho hai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
