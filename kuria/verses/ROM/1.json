              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ninyoora bhaamanyërë Ënooköë, si tëbhaamöhaayë ësööko kebhörë këragërë hai, gösë kömöha umukumo hai. Kuibhaga rëyö, amaitegeerro gaabho gaabha amakangi kimui na imioyo geebho guichuribhöa na igisuntë. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharagamba iga mbo abhang'aini, sibhoono mbo ichitöhö; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
