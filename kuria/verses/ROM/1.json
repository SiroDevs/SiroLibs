              "items": [
                {
                  "text": "Mk 8:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tënkömaahera nsoni igichiiratë hai, kugira ni ichinguru chië Ënooköë chu ubhuituuria köbhonsui bhano bhagukumia, Abhayahuti mbere na sooki Amahamatë. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Hak 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira igichiiratë nköhönyöra kërë kebhörë Ënooköë agötööra abhantö köbhöröngë bhooe; iga ngököhetera kubhukumia, gukurua ögötanga kuhika ögösookerria. Kebhörë ërendeko rëkögamba iga, “Ömöntö öno araatööröe köbhöröngë në Ënooköë gököhetera kubhukumia naraamenye.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisoro ria abhantö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhusinanku bhöë Ënooköë bhoohönyöröa kurua kuriöbha igörö yi iriraga na ubhunyanku bhonsui bhöa abhantö bhano kubhunyanku bhoobho bhaakörëbhërra öbhöheene iga bhonge kömanyëkana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë nköbhabhööröta arë, gikugira kërë gëkamanyëkana igörö yë Ënooköë mbörabhu kërë harë bho, kugira në Ënooköë umuene aagëtööra bhörabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Öbh 13:1-9; Sir 17:8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Ënooköë aateemërë ëkëbhara, ëteemo yaae ëno ëtakömaahoa, ichinguru chaae cha kuya ëyö na ëteemo yö öbhönooköë bhooe, nkömaahëkana bhirë bhörabhu; nkömaahoa bhirë gököhetera kubhintö bhino Ënooköë aakoorrë. Köhayö tëbhaana nchëra ërë yonsui ya guitaamiriirria hai! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.17"
