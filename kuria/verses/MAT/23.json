              "MAT.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ëhöbhë yeinyu, bharë bhaigia bhi Imigiro na Abhabharisayo, bharë bhaiteerri, bharë mökoogia ëgëkombe na esahani këbhara, sibhoono mönsë nyoora mbiichööyë ibhintö bhino moonyoora köbhösakuri na köndambë. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharë Bhabharisaayo bhahukuru! Toogia tanga ëgëkombe mönsë, na këbhara naho nkëraabhe ëkërabhu!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
      ]
    },
