          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wei, Yerusaremu, Yerusaremu! Nguita örë abhanaabhi na götema na amagëna abhahira mang'ana bhano nkunyoora Ënooköë agötömëëyë! Harë karënga naatuna gököma abhantö bhaao bhonsui keehaara ëngoko ëgököma ibhichuuchu bhiayo kömabhabha gaayo, sibhoono uwe wanga! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.5"
              },
              "items": [
                {
                  "text": "Yer 22:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö, inyumba yaao nëratame inchua. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Sab 118:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gukurua bhoono, ndabhateebhia, töörëmaaha guiki hai kuhika röno örëgamba iga, ‘Ënooköë aitabhiri öno aguucha kuriina riö Ömönene.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
