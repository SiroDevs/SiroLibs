                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.45"
              },
              "items": [
                {
                  "text": "Yoh 1:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akamenya kumugi go Nasareti. Nke hayö amang'ana gano wanyoorrë ömönaabhi aagamba gaahëkëëraini iga: “Narabhërëkëröe iga Ömönasare.”",
          "type": "text",
