              "items": [
                {
                  "text": "Ruk 9:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ëngamba kurua kuriöbha ëkagamba iga, “Onö nëwe ömoona waane ömöhanchöa, öno ngötegeribhua nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
