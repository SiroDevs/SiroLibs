          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.8"
              },
              "items": [
                {
                  "text": "2 Gam 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana naagasuarrë ichingëbho chino chaarökëröë na ubhuchooki bhuë ëngamëëra; na kuibhoha kumukurukuru umuchibhi gui iriihö. Ibhiakörëa bhiae mbiarëngë ichingigë na öbhöökë bho masisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, abhantö kurua Yerusaremu, ichintahana cha Yutea na ichintahana chonsui chö ömöndaara gö ömooro go Yorotani, mbaamögërëëyë, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhagatöbhöra amaraga gaabho, nawe akabhabhatiisa kömooro go Yorotani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
