              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guchinsikö chiyö Yohana Möbhatiisi naamaahëkaini ararundia guiköngö re Yutea iga, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
