                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Yoh 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Taikaayë Nasarëti haara hai, naagëëyë kömenya Kabherinaumu, umugi göno gorëngë mbarëka yi inyancha ya Gariraya, gukiaro ge Sabhuroni na Nabhutari. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayö ngaakorroë korri iga gaara ömönaabhi Isaya aagambërë gahëkëërane iga:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
