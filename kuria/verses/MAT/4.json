              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akarihunchukiria iga, “Si yandëkërë iga, ‘Wanga gösaacha Ömönene, Ënooköë waao.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
