            }
          ]
        },
        {
          "text": "Hano Yesö aaiguurë iga Yohana atöörröë cheera, akaringa kuya Gariraya, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
