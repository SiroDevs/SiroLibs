            }
          ]
        },
        {
          "text": "Gukurua ënkaaga ëyö Yesö naatangërë kurundia aragamba iga, “Mötaihönchöra; kugira öbhögambi bho kuriöbha nhang'i bhörë.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
