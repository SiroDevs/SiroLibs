            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe hano wanyoorrë aragenda mbarëka yi inyancha ya Gariraya, akamaaha abhamura bhanda imui bhabhërë, Simoni öno aköbhërëkëröa iga Bhetero, na Anderea mura omoobho, bhararekera uruero kunyancha; kugira mbaarëngë abhahömaani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabhateebhia iga, “Mötansoorana, nani nëndabhakore abhahömaani bha abhantö.” ",
          "type": "text",
