              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho hayö igo bhagatiga öbhooto na isawaabho, bhakamösoorana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
