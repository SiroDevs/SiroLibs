                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono, Abhabharisayo bhakagamba iga, “Nkurugia arë ibhihui guchinguru cha ömönene wa ibhihui.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        }
      ]
