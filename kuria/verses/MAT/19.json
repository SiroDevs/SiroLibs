              "items": [
                {
                  "text": "Mat 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.30"
              },
              "items": [
                {
                  "text": "Ruk 22:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesö akabhahunchukiria iga, “Ndabhateebhia öbhöheene, röno Ömoona wö Ömöntö arikarra igitumbë keee kiu ubhuhiku na ikio öbhögambi gökëbhara Ëkëhëa, nëho na bhainyu bhano monsoorana mörëngë ikumi na bhabhërë, murikarra ibhitumbë bhiö öbhögambi ikumi na bhibhërë, na gökengera ikiina ibhiaro ikumi na bhibhërë bhia Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na örë wonsui aatigërë waae gösë bhamura bha moobho, gösë bhasubhaati bha moobho, gösë isawaabho, gösë nyaköwaabho, gösë abhaana bhaae, gösë ëmëgöndö geee gikugira yaane, narinyoora harë igana, na körëa ömöndö gö öbhöhoru bho kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
