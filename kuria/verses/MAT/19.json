              "items": [
                {
                  "text": "Ëhë 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe akabhuuria Yesö iga, “Marago kë?” Yesö akamuhunchukiria iga, “Wanga guita, wanga gökora öbhöhoyiri, wanga kuibha, wanga kuruusiria ömöntö örë wonsui ëherekiö yö öbhörongo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
