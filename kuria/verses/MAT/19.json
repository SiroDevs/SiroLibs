                  "text": "Ruk 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono abhaaru bhano bhaatangatërë mbarëbha abhanyuma, na bhano bharëngë abhanyuma mbarëbha abhambere.”",
          "type": "text",
          "attrs": {
