        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö mbaabhaayë na uguitëng'ëra, bhagatanga gökanya iga nkanyoora Yohana akaabha Masiihi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Yohana akabhateebhia bhonsui iga, “Nköbhabhaatiisa ndë kömanchë; sibhoono, öno ankërrë ngucha arë. Kura tinisaini götachöra ninyoora ni ichinkini chi ibhiraatö bhiaae hai. Nawe narabhabhaatiise gönkoro Nhoreeru na kömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "We naana ihuuri ya köhöörra gököbhoko, korri ahööre ibhiakörëa bhiae; aköme ëngano agëtööre guitara, na gösamba amatete kömörro göno götakurima.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
