                "loc": "MAT.2.23"
              },
              "items": [
                {
                  "text": "Mat 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Yusubhu na Mariamu bhaasookiri gökora gonsui gököreng'aana na imigiro giö Ömönene, mbaaringërë kuya waabho kumugi go Nasareti, kömöndaara go Gariraya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömoona ööra agakiina akabha na ichinguru, öbhöng'aini, na ësaramita yë Ënooköë yaarë hamui nawe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömoona Yesö arëngë köhekaru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
