              },
              "items": [
                {
                  "text": "Mari 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira Yohana öyö nëwe Amandëko gagusumaachëra iga:",
          "type": "text",
