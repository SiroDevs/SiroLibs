          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taa aawadeed, walaalahayow, ku dadaala inaad wax sii sheegtaan, hana diidina in afaf lagu hadlo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
