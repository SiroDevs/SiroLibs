              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceesheq oo ahaa walaalkiis wiilashiisiina waa kuwan, Uulaam oo curadkiisii ahaa, iyo Yecuush oo ahaa kii labaad, iyo Eliifeled oo ahaa kii saddexaad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
