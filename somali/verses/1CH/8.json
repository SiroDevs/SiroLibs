              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaseelna wuxuu lahaa lix wiil, oo magacyadoodiina waa kuwan: Casriiqaam, iyo Bokeruu, iyo Ismaaciil, iyo Shecaryaah, iyo Cobadyaah, iyo Xaanaan. Oo kulli intaas oo dhammu waxay ahaayeen wiilashii Aaseel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
