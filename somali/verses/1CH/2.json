    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wiilashii Israa'iil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanu waa Israa'iil wiilashiisii, oo waxay ahaayeen Ruubeen, iyo Simecoon, iyo Laawi, iyo Yahuudah, iyo Isaakaar, iyo Sebulun, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.1",
            "verseOrgIds": [
              "1CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Daan, iyo Yuusuf, iyo Benyaamiin, iyo Naftaali, iyo Gaad, iyo Aasheer.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yahuudahna waxay ahaayeen Ceer, iyo Oonaan, iyo Sheelaah, oo saddexdaas waxaa isaga u dhashay Batshuuca oo reer Kancaan ahayd. Oo Ceer oo ahaa curadkii Yahuudah wuxuu ahaa mid Rabbiga hortiisa shar ku ah, oo isna Rabbigu wuu dilay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.3",
            "verseOrgIds": [
              "1CH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Taamaar oo uu soddog u ahaa ayaa isaga u dhashay Feres iyo Serax. Wiilashii Yahuudah oo dhammuna waxay ahaayeen shan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Feresna waxay ahaayeen Xesroon, iyo Xaamuul. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.5",
            "verseOrgIds": [
              "1CH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Seraxna waxay ahaayeen Simrii, iyo Eetaan, iyo Heemaan, iyo Kalkol, iyo Daarac, oo dhammaantoodna waxay ahaayeen shan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.6",
            "verseOrgIds": [
              "1CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina Karmiina wuxuu ahaa Caakaar oo ahaa kii reer binu Israa'iil dhibay, oo ku xadgudbay alaabtii la xaaraameeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.7",
            "verseOrgIds": [
              "1CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina Eetaanna wuxuu ahaa Casaryaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba Xesroon wiilashiisii u dhashay waxay ahaayeen Yeraxme'eel, iyo Raam, iyo Keluubay.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Raam wuxuu dhalay Cammiinaadaab, Cammiinaadaabna wuxuu dhalay Naxshoon, oo reer Yahuudah amiir u ahaan jiray. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.10",
            "verseOrgIds": [
              "1CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Naxshoon wuxuu dhalay Salmaa, Salmaana wuxuu dhalay Bocas, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.11",
            "verseOrgIds": [
              "1CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bocasna wuxuu dhalay Coobeed, Coobeedna wuxuu dhalay Yesay, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesayna wuxuu dhalay curadkiisii oo ahaa Elii'aab, iyo Abiinaadaab oo ahaa wiilkiisii labaad, iyo Shimcaa oo ahaa wiilkiisii saddexaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.13",
            "verseOrgIds": [
              "1CH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Netaneel oo ahaa kii afraad, iyo Radday oo ahaa kii shanaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.14",
            "verseOrgIds": [
              "1CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Osem oo ahaa kii lixaad, iyo Daa'uud oo ahaa kii toddobaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.15",
            "verseOrgIds": [
              "1CH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo walaalahoodii gabdhaha ahaana waxay ahaayeen Seruuyaah iyo Abiigayil, oo Seruuyaah wiilasheediina waxay ahaayeen Abishay, iyo Yoo'aab, iyo Casaaheel, oo waxay ahaayeen saddex. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiigayilna waxay dhashay Camaasaa, oo Camaasaa aabbihiisna wuxuu ahaa Yeter oo reer Ismaaciil ahaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaleeb ina Xesroonna wuxuu carruur ka dhalay naagtiisii Casuubaah, iyo Yeriicood, oo kuwanuna waxay ahaayeen wiilasheedii, waana Yeesher, iyo Shoobaab, iyo Ardoon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.18",
            "verseOrgIds": [
              "1CH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Casuubaahna way dhimatay, oo Kaaleeb wuxuu guursaday Efraad, oo iyana isagay u dhashay Xuur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.19",
            "verseOrgIds": [
              "1CH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xuurna wuxuu dhalay Uurii, Uuriina wuxuu dhalay Besaleel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taas dabadeedna Xesroon wuxuu u tegey ina Maakiir oo ahaa Gilecaad aabbihiis, oo taas wuxuu guursaday isagoo lixdan sannadood jira, oo waxayna isaga u dhashay Seguub. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.21",
            "verseOrgIds": [
              "1CH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seguubna wuxuu dhalay Yaa'iir, oo dalka reer Gilecaad ku lahaa saddex iyo labaatan magaalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.22",
            "verseOrgIds": [
              "1CH.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Geshuur iyo Araam ayaa waxay qaateen magaalooyinkii reer Yaa'iir, iyo Qenaad, iyo tuulooyinkeedii, waxayna wada ahaayeen lixdan magaalo. Oo kulli intaasu waxay wada ahaayeen wiilashii Maakiir oo ahaa Gilecaad aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.23",
            "verseOrgIds": [
              "1CH.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Xesroon markuu Kaaleeb Efraataah ku dhintay dabadeed ayaa Abiiyaah oo ahayd Xesroon naagtiisii waxay isagii u dhashay Ashxuur oo ahaa Teqooca aabbihiis.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yeraxme'eel oo ahaa curadkii Xesroon wiilashiisiina waxay ahaayeen Raam oo curadkiisii ahaa, iyo Buunaah, iyo Oren, iyo Osem, iyo Axiiyaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.25",
            "verseOrgIds": [
              "1CH.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yeraxme'eelna wuxuu qabay naag kale, oo magaceeda la odhan jiray Cataaraah, oo iyana waxay ahayd Oonaam hooyadiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.26",
            "verseOrgIds": [
              "1CH.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Raam oo ahaa curadkii Yeraxme'eel wiilashiisii waxay ahaayeen Macas, iyo Yaamiin, iyo Ceeqer. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.27",
            "verseOrgIds": [
              "1CH.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Oonaamna waxay ahaayeen Shammay, iyo Yaadaac, wiilashii Shammayna waxay ahaayeen Naadaab iyo Abiishuur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.28",
            "verseOrgIds": [
              "1CH.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo naagtii Abiishuur magaceedana waxaa la odhan jiray Abiixayil, iyana waxay isagii u dhashay Axbaan iyo Mooliid. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.29",
            "verseOrgIds": [
              "1CH.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Naadaabna waxay ahaayeen Seled, iyo Afayim, laakiinse Seled wiilalla'aan buu ku dhintay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.30",
            "verseOrgIds": [
              "1CH.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina Afayimna wuxuu ahaa Yishcii. Ina Yishciina wuxuu ahaa Sheeshaan. Ina Sheeshaanna wuxuu ahaa Axlay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.31",
            "verseOrgIds": [
              "1CH.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shammay walaalkiisii oo Yaadaac ahaa wiilashiisiina waxay ahaayeen Yeter, iyo Yoonaataan, Yeterna wiilalla'aan buu ku dhintay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.32",
            "verseOrgIds": [
              "1CH.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yoonaataanna waxay ahaayeen Feled, iyo Saasaa. Kuwaasu waxay wada ahaayeen wiilashii Yeraxme'eel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.33",
            "verseOrgIds": [
              "1CH.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Sheeshaan wiilal ma lahayn, gabdho mooyaane. Oo Sheeshaan wuxuu lahaa addoon Masri ah, oo magiciisana waxaa la odhan jiray Yarxaac. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.34",
            "verseOrgIds": [
              "1CH.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Sheeshaan gabadhiisii u guuriyey addoonkiisii Yarxaac la odhan jiray, oo iyana waxay isagii u dhashay Catay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.35",
            "verseOrgIds": [
              "1CH.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Catayna wuxuu dhalay Naataan, Naataanna wuxuu dhalay Saabaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.36",
            "verseOrgIds": [
              "1CH.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saabaadna wuxuu dhalay Eflaal, Eflaalna wuxuu dhalay Coobeed, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.37",
            "verseOrgIds": [
              "1CH.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Coobeedna wuxuu dhalay Yeehuu, Yeehuuna wuxuu dhalay Casaryaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.38",
            "verseOrgIds": [
              "1CH.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Casaryaahna wuxuu dhalay Xeles, Xelesna wuxuu dhalay Elecaasaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.39",
            "verseOrgIds": [
              "1CH.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elecaasaahna wuxuu dhalay Sismay, Sismayna wuxuu dhalay Shalluum, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.40",
            "verseOrgIds": [
              "1CH.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalluumna wuxuu dhalay Yeqamyaah, Yeqamyaahna wuxuu dhalay Eliishaamaac.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeraxme'eel walaalkiis Kaaleeb wiilashiisiina waxay ahaayeen curadkiisii Meeshaac, oo Siif aabbihiis ahaa, iyo wiilashii Maareeshaah oo ahaa Xebroon aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.42",
            "verseOrgIds": [
              "1CH.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Xebroonna waxay ahaayeen Qorax, iyo Tafuu'ax, iyo Reqem, iyo Shemac. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.43",
            "verseOrgIds": [
              "1CH.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemacna wuxuu dhalay Raxam, oo ahaa Yorqecaam aabbihiis, Reqemna wuxuu dhalay Shammay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.44",
            "verseOrgIds": [
              "1CH.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shammay wiilkiisiina wuxuu ahaa Maacoon, Maacoonna wuxuu ahaa Beytsuur aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.45",
            "verseOrgIds": [
              "1CH.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceefah oo ahayd Kaaleeb naagtiisii addoonta ahaydna waxay dhashay Xaaraan, iyo Moosaa, iyo Gaasees, oo Xaaraanna wuxuu dhalay Gaasees. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yaahdayna waxay ahaayeen Regem, iyo Yootam, iyo Geeshaan, iyo Feled, iyo Ceefah, iyo Shacaf. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macakaah oo ahayd Kaaleeb naagtiisii addoonta ahaydna waxay dhashay Sheber iyo Tirxanaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.48",
            "verseOrgIds": [
              "1CH.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay kaloo dhashay Shacaf oo ahaa Madmannaah aabbihiis, iyo Shewaa oo ahaa Makbeenaa aabbihiis, iyo Gibecaa aabbihiis, oo Kaaleeb gabadhiisana waxaa la odhan jiray Caksaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanu waxay wada ahaayeen ilmaha Kaaleeb, kaasoo ahaa ina Xuur, oo ahaa curadkii Efraataah, iyo Shoobaal oo ahaa Qiryad Yecaariim aabbihiis, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Salmaa oo ahaa Beytlaxam aabbihiis, iyo Xaareef oo ahaa Beytgaadeer aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.51",
            "verseOrgIds": [
              "1CH.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoobaal oo ahaa Qiryad Yecaariim aabbihiisna wuxuu lahaa wiilal, Haaro'eh iyo reer Menuxood badhkiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.52",
            "verseOrgIds": [
              "1CH.2.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 2:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Qiryad Yecaariim qolooyinkoodiina waxay ahaayeen reer Yeter, iyo reer Fuutii, iyo reer Shumaatii, iyo reer Mishraacii, oo kuwaas waxaa ka soo farcamay reer Sorcaah, iyo reer Eshtaa'ool. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.53",
            "verseOrgIds": [
              "1CH.2.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Salmaana waxay ahaayeen Beytlaxam, iyo reer Netofaah, iyo Cataarood Beytyoo'aab, iyo reer Maanahad badhkiis, iyo reer Sorcii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.54",
            "verseOrgIds": [
              "1CH.2.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CH 2:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo karraaniyadii Yacbees degganaa qolooyinkoodiina waxay ahaayeen reer Tircaatii, iyo reer Shimcaatiim, iyo reer Suukaatiim. Intaasu waa reer Qeynkii ka soo farcamay Xammad oo ahaa reer Reekaab aabbahood.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.55",
            "verseOrgIds": [
              "1CH.2.55"
            ]
          }
        }
      ]
    }
