    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daa'uud Oo Ay Raaceen Dagaalyahanno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba intanu waa kuwii Daa'uud ugu yimid Siiqlag, intuu weli ka dhumanayay Saa'uul ina Qiish, oo iyagu waxay ku jireen ragga xoogga badan oo la dagaal galay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyagu qaansooyin bay siteen, oo gacanta midigta iyo tan bidixdaba dhagaxyo way ku wadhfin kareen, fallaadhona qaansooyin way kaga gani kareen, oo iyagu waxay ahaayeen reer Benyaamiin oo Saa'uul walaalihiis ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa madax ahaa Axiiceser, dabadeedna Yoo'aash, oo ahaa ina Shemaacaah oo ahaa reer Gibecaad, iyo Yesii'eel iyo Feled oo ahaa wiilashii Casmaawed, iyo Beraakaah, iyo Yeehuu oo ahaa reer Canaatood, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Yishmacyaah oo ahaa reer Gibecoon oo ahaa nin xoog badan oo soddonka ka mid ahaa, oo weliba soddonka ka wada sarreeyey, iyo Yeremyaah, iyo Yaxasii'eel, iyo Yooxaanaan, iyo Yoosaabaad oo ahaa reer Gedeeraad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Elcuusay, iyo Yeriimood, iyo Becalyaah, iyo Shemaryaah, iyo Shefatyaah oo ahaa reer Xaruuf, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Elqaanaah, iyo Yishiyaah, iyo Casareel, iyo Yooceser, iyo Yaashaabcaam oo ahaa reer Qorax, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Yooceelaah iyo Sebadyaah oo ahaa wiilashii Yeroxaam oo ahaa reer Gedoor. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa reer Gaad Daa'uud isaga soocay oo ugu tegey dhufayskii cidlada ku yiil rag xoog badan oo ah rag dagaal loo tababbaray, oo gaashaan iyo waran qaadan karay, oo wejigooduna wuxuu ahaa sida weji libaax oo kale, oo waxay u dheereeyeen sida cawsha buuraha joogta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyaga waxaa madax ahaa Ceser, Cobadyaahna wuxuu ahaa kii labaad, Elii'aabna kii saddexaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishmannaahna kii afraad, Yeremyaahna kii shanaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Catayna kii lixaad, Elii'eelna kii toddobaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooxaanaanna kii siddeedaad, Elsaabaadna kii sagaalaad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremyaahna kii tobnaad, Makbannayna kii kow iyo tobnaad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwaas oo ahaa reer Gaad waxay ahaayeen saraakiishii ciidanka, oo kii iyaga ugu yaraa wuxuu u dhigmaa boqol nin, kii ugu weynaana kun nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwaasu waxay ahaayeen kuwii bishii kowaad ka gudbay Webi Urdun oo buuxdhaafay oo qararka oo dhan ka daatay, oo iyagu waxay kala eryeen dadkii dooxooyinka degganaa oo dhan, xagga bari, iyo xagga galbeedba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa dhufayska Daa'uud ugu yimid reer Benyaamiin iyo reer Yahuudah qaarkooda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daa'uud u baxay inuu iyaga ka hor tago, oo intuu jawaabay ayuu ku yidhi, Haddaad nabdoon iigu timaadeen inaad i caawisaan qalbigaygu wuu idinla jiri doonaa, laakiinse haddaad iigu timaadeen inaad cadaawayaashayda ii gacangelisaan, Ilaahii awowayaasheen taas ha fiiriyo oo ha canaanto, maxaa yeelay, gacmahayga wax xumaan ahu kuma jiraan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa ruuxii ku soo degay Camaasay oo soddonkii nin madax u ahaa, oo wuxuu yidhi, Daa'uudow, ina Yesayow, annagu waxaannu nahay kuwaagii, waannuna ku garab taagan nahay. Nabad. Nabad ha kula jirto, oo kaalmeeyayaashaadana nabad ha la jirto, waayo, waxaa ku caawiya Ilaahaaga. Markaasaa Daa'uud iyagii soo dhoweeyey oo wuxuu ka dhigay saraakiishii guutada. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba reer Manasehna qaar baa Daa'uud geestiisa soo maray markuu raacay reer Falastiin oo Saa'uul dagaal ugu yimid, laakiinse iyagii ma ay caawiyin, waayo, saraakiishii reer Falastiin talay isagii ku eryeen, oo waxay isyidhaahdeen, Isagu intuu madaxyadeenna khatar geliyo ayuu sayidkiisii Saa'uul garab geli doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markuu Siiqlag tegey waxaa geestiisa reer Manaseh ka soo maray Cadnaah, iyo Yoosaabaad, iyo Yediica'eel, iyo Miikaa'eel, iyo Yoosaabaad, iyo Eliihuu, iyo Silletay, oo dhammaantood ahaa saraakiil u taliya kun kun reer Manaseh ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay Daa'uud ka caawiyeen guutadii wax dhacaysay, waayo, waxay ahaayeen rag xoog badan oo ahaa saraakiishii ciidanka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, maalin ka maalin waxaa Daa'uud u iman jiray kuwo isaga caawiya, ilamaa ay noqdeen ciidan weyn, oo ah sidii ciidanka Ilaah.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daa'uud Oo Kuwa Kale Ka Raaceen Xebroon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tanuna waa tiradii kuwii madaxda u ahaa kuwii dagaalka hubka u lahaa, oo Daa'uud ugu yimid Xebroon inay boqortooyada Saa'uul isaga u rogaan sidii uu eraygii Rabbigu ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwii reer Yahuudah ee gaashaan iyo waran qaadayay waxay ahaayeen lix kun iyo siddeed boqol oo nin, oo dagaal hub u leh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwii reer Simecoon ee xoogga badnaa, dagaalkana u darbanaa waxay ahaayeen toddoba kun iyo boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reer Laawina waxaa ka joogay afar kun iyo lix boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yehooyaadaacna wuxuu ahaa madaxdii reer Haaruun, oo isagana waxaa la socday saddex kun iyo toddoba boqol oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saadooqna wuxuu ahaa nin dhallinyar oo xoog badan, oo waxaa la jiray laba iyo labaatan sirkaal oo reerkiisii wada ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Benyaamiin oo ahaa Saa'uul walaalihiisna waxaa ka joogay saddex kun oo nin, waayo, ilaa waagaas iyaga intoodii badnayd waxay daacad u sii ahaayeen reerkii Saa'uul. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Efrayimna waxaa ka joogay labaatan kun iyo siddeed boqol oo nin, oo ah rag xoog badan oo dhammaantood reerahooda caan ku ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Manaseh badhkiisiina waxaa ka joogay siddeed iyo toban kun oo nin, oo loo magacaabay inay yimaadaan oo ay Daa'uud boqraan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Isaakaarna waxaa ka joogay rag garasho u leh wakhtiyada iyo waxa reer binu Israa'iil waajibka ku ah inay sameeyaan, oo iyaga madaxdoodu waxay ahaayeen laba boqol oo nin oo walaalahood oo dhanna iyagaa xukumay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Sebulunna waxaa ka joogay kuwo ciidanka geli kara oo dagaalka isu safi kara, iyagoo wata cayn kasta oo ah alaabta dagaalka, oo isdiyaarin kara, oo aan labaqalbiilayaal ahayn, oo tiradooduna waxay ahayd konton kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Naftaalina waxaa ka joogay kun sirkaal oo ay la socdaan toddoba iyo soddon kun oo nin oo waran iyo gaashaan wada sita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Daanna waxaa ka joogay siddeed iyo labaatan kun iyo lix boqol oo nin oo dagaalka isu safi kara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Aasheerna waxaa ka joogay afartan kun oo nin oo ciidanka geli kara oo dagaalka isu safi kara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Webi Urdun dhankiisa kalena waxaa ka yimid boqol iyo labaatan kun oo nin oo wata cayn kasta oo ah alaabta dagaalka, oo waxayna ahaayeen reer Ruubeen, iyo reer Gaad, iyo reer Manaseh badhkiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intaas oo dhan oo wada ahaa rag dagaalyahan ah oo dagaalka isu safi kara waxay Xebroon ula yimaadeen qalbi qumman inay Daa'uud reer binu Israa'iil oo dhan u boqraan, oo reer binu Israa'iil intooda hadhay oo dhammuna isku qalbi bay ku ahaayeen inay Daa'uud boqraan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyana halkaasay Daa'uud la joogeen intii saddex maalmood ah, iyagoo wax cunaya oo wax cabbaya, waayo, walaalahood baa sooryo u diyaariyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba dadkii iyaga u dhowaa ee ahaa ilaa reer Isaakaar iyo reer Sebulun iyo reer Naftaali waxay cunto ku soo rareen dameerro, iyo awr, iyo baqlo, iyo dibi, oo waxay keeneen bur, iyo fudad berde ah, iyo rucubo sabiib ah, iyo khamri, iyo saliid, iyo dibi, iyo ido, dhammaanna aad iyo aad bay u badnaayeen, maxaa yeelay, reer binu Israa'iil dhexdooda farxad baa jirtay.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    }
