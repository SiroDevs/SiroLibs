    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sanduuqii Axdiga Oo La Keenay Yeruusaalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daa'uud wuxuu magaaladii Daa'uud ka dhistay guryo, oo sanduuqii Ilaahna meel buu u hagaajiyey, teendhona buu u dhisay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daa'uud yidhi, Waa inaan ninna qaadin sanduuqa Ilaah reer Laawi mooyaane, waayo, Rabbigu iyaguu u doortay inay qaadaan sanduuqa Ilaah, iyo inay isaga u adeegaan weligood. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Daa'uud reer binu Israa'iil oo dhan wuxuu ku soo wada ururiyey Yeruusaalem in sanduuqii Rabbiga la keeno meeshiisii uu u hagaajiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana Daa'uud wuxuu soo wada ururiyey reer Haaruun iyo reer Laawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.4",
            "verseOrgIds": [
              "1CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwii reer Qohaad waxay ahaayeen Uurii'eel oo madax ahaa, iyo walaalihiis oo ahaa boqol iyo labaatan nin, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwii reer Meraariina, Casaayaah oo madax ahaa, iyo laba boqol iyo labaatan nin oo walaalihiis ahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwii reer Gershoomna, Yoo'eel oo madax ahaa, iyo boqol iyo soddon nin oo walaalihiis ahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwii reer Eliisaafaanna, Shemacyaah oo madax ahaa, iyo laba boqol oo nin oo walaalihiis ahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwii reer Xebroonna, Elii'eel oo madax ahaa, iyo siddeetan nin oo walaalihiis ahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwii reer Cusii'eelna, Cammiinaadaab oo madax ahaa, iyo boqol iyo laba iyo toban nin oo walaalihiis ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daa'uud u yeedhay Saadooq iyo Aabyaataar oo wadaaddada ahaa, iyo kuwii reer Laawi oo ahaa Uurii'eel, iyo Casaayaah, iyo Yoo'eel, iyo Shemacyaah, iyo Elii'eel, iyo Cammiinaadaab, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu ku yidhi, Idinku waxaad tihiin madaxdii qolooyinka reer Laawi, haddaba idinka iyo walaalihiinba isdaahiriya si aad sanduuqii Rabbiga ah Ilaaha reer binu Israa'iil ugu soo qaaddaan meeshii aan u hagaajiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maxaa yeelay, indinku markii hore ma aydnaan qaadin, oo sidaas daraaddeed ayaa Rabbiga Ilaaheenna ahu degdeg inoogu qabtay, waayo, sidii qaynuunku ahaa wax kuma aynan weyddiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba sidaas daraaddeed ayaa wadaaddadii iyo kuwii reer Laawi isdaahiriyeen inay soo qaadaan sanduuqii Rabbiga ah Ilaaha reer binu Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
              "1CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa reer Laawi garbaha ku qaadeen sanduuqii Ilaah iyagoo ulihiisii ku sida, sidii Muuse amray oo uu eraygii Rabbigu ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daa'uud madaxdii reer Laawi ku yidhi, Walaalihiin rag ka dhex doorta inay ahaadaan niman gabayaa ah oo sita alaabtii muusikada, oo ah shareerado, iyo kataarado, iyo suxuun laysku garaaco, oo aad ha uga dhawaajiyeen oo farxad aawadeed codka kor ha u qaadeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed reer Laawi waxay doorteen Heemaan oo ahaa ina Yoo'eel iyo walaalihiis oo ahaa Aasaaf ina Berekyaah, oo walaalahood reer Meraariina waxay ka doorteen Eetaan ina Quushaayaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo iyaga waxaa la jiray walaalahood oo ahaa darajadii labaad, waxayna ahaayeen Sekaryaah, iyo Been, iyo Yacasii'eel, iyo Shemiiraamood, iyo Yexii'eel, iyo Cunnii, iyo Elii'aab, iyo Benaayaah, iyo Macaseeyaah, iyo Matityaah, iyo Eliifeleehuu, iyo Miqneeyaah, iyo Cobeed Edoom, iyo Yecii'eel oo dhammaantood wada ahaa iridjoogayaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed kuwii gabayaagii ahaa oo ahaa Heemaan, iyo Aasaaf, iyo Eetaan waxay siteen suxuun naxaas ah oo laysku garaaco si ay aad ugaga dhawaajiyaan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo Sekaryaah, iyo Casii'eel, iyo Shemiiraamood iyo Yexii'eel, iyo Cunnii, iyo Elii'aab, iyo Macaseeyaah, iyo Benaayaahna waxay siteen shareerado si ay ugu dhuftaan wax Calaamood lagu luuqeeyo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo Matityaah, iyo Eliifeleehuu, iyo Miqneeyaah, iyo Cobeed Edoom, iyo Yecii'eel, iyo Casasyaahna waxay siteen kataarado ay ku hoggaamiyaan wax Shemiiniid lagu luuqeeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Kenanyaah oo madax u ahaa reer Laawina wuxuu u sarreeyey gabaygii, oo isagu wuxuu dadkii wax ka baray gabaygii, maxaa yeelay, aad buu u yiqiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Berekyaah iyo Elqaanaahna waxay iridjoogayaal u ahaayeen sanduuqii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wadaaddadii ahaa Shebanyaah, iyo Yehooshaafaad, iyo Netaneel, iyo Camaasay, iyo Sekaryaah, iyo Benaayaah, iyo Eliiceserna turumbooyin ayay ku hor afuufayeen sanduuqii Ilaah, oo Cobeed Edoom iyo Yexiyaahna iridjoogayaal ayay sanduuqii u ahaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed Daa'uud iyo odayaashii reer binu Israa'iil iyo kuwii kun kun u taliyeyba waxay u tageen inay sanduuqii axdiga Rabbiga ka soo qaadaan gurigii Cobeed Edoom iyagoo faraxsan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markii Ilaah caawiyey kuwii reer Laawi oo qaaday sanduuqii axdiga Rabbiga ayay toddoba dibi iyo toddoba wan ku allabaryeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Daa'uudna wuxuu xidhnaa dhar aad u wanaagsan, isaga iyo kuwii reer Laawi oo sanduuqa qaaday oo dhan, iyo nimankii gabayaaga ahaa, iyo Kenanyaah oo ahaa madaxdii gabayga oo la jiray nimankii gabayaaga ahaa, oo Daa'uudna wuxuu qabay eefod maro wanaagsan ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba reer binu Israa'iil oo dhammu saasay u soo qaadeen sanduuqii axdiga Rabbiga iyagoo dhawaaqaya, oo afuufaya buun iyo turumbooyin, oo ka dhawaajinaya suxuun laysku garaaco, iyo shareerado iyo kataarado. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markii sanduuqii axdiga Rabbigu uu magaaladii Daa'uud imanayay ayay Miikaal oo ahayd ina Saa'uul daaqadda ka eegtay, oo kolkay aragtay Boqor Daa'uud oo cayaaraya ayay qalbiga ka quudhsatay.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
    }
  ],
