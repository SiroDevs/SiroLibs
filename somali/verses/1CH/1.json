      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.28",
            "verseOrgIds": [
              "1CH.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intanu waa qarniyadoodii, Ismaaciil curadkiisii wuxuu ahaa, Nebayod, dabadeedna wuxuu dhalay Qedaar, iyo Adbe'el, iyo Mibsam, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.29",
            "verseOrgIds": [
              "1CH.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Mishmaac, iyo Duumah, iyo Masa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.30",
            "verseOrgIds": [
              "1CH.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Hadad, iyo Teemaa, iyo Yetuur, iyo Naafiish, iyo Qedemah. Kuwanu waa wiilashii Ismaaciil.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.31",
            "verseOrgIds": [
              "1CH.1.31"
            ]
          }
        }
      ]
    },
    {
