          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibraahimna wuxuu dhalay Isxaaq. Wiilashii Isxaaqna waxay ahaayeen Ceesaw iyo Israa'iil.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.34",
