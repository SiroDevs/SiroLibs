          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Ceesawna waxay ahaayeen Eliifas, iyo Recuu'eel, iyo Yecuush, iyo Yaclaam, iyo Qorax.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.35",
