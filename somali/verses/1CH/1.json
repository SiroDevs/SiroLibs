          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Eliifasna waxay ahaayeen Teemaan, iyo Oomaar, iyo Sefii, iyo Gactaam, iyo Qenas, iyo Timnac, iyo Camaaleq. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.36",
            "verseOrgIds": [
              "1CH.1.36"
            ]
          }
        },
