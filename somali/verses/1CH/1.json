          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Seciirna waxay ahaayeen Lootaan, iyo Shoobaal, iyo Sibecoon, iyo Canah, iyo Dishon, iyo Eeser, iyo Diishaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
            "verseOrgIds": [
              "1CH.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Lootaanna waxay ahaayeen Xori iyo Hoomaam, oo Timnacna waxay ahayd Lootaan walaashiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Shoobaalna waxay ahaayeen Calyaan, iyo Maanahad, iyo Ceebaal, iyo Shefii, iyo Oonaam. Wiilashii Sibecoonna waxay ahaayeen Ayah, iyo Canah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
              "1CH.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Canahna waxay ahaayeen Dishon. Wiilashii Dishonna waxay ahaayeen Xamraan, iyo Eshbaan, iyo Yitraan, iyo Keraan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
            "verseOrgIds": [
              "1CH.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Eeserna waxay ahaayeen Bilhaan, iyo Sacwaan, iyo Yacaqaan. Wiilashii Diishaanna waxay ahaayeen Cuus iyo Araan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        }
