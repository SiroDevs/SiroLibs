          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Recuu'eelna waxay ahaayeen Nahad, iyo Serax, iyo Shammah, iyo Misaah.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.37",
