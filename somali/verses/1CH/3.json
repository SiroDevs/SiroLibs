      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba kuwanu waxay ahaayeen wiilashii Daa'uud, oo isaga ugu dhashay Xebroon, oo curadkiisu wuxuu ahaa Amnoon, oo ay dhashay Axiinocam tii reer Yesreceel, oo kii labaadna wuxuu ahaa Daanyeel, oo ay dhashay Abiigayil tii reer Karmel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo kii saddexaadna wuxuu ahaa Absaaloom oo ay dhashay Macakaah oo ahayd boqorkii Geshuur oo Talmay ahaa gabadhiisii, oo kii afraadna wuxuu ahaa Adoniiyaah oo ay Haggiid dhashay, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kii shanaadna wuxuu ahaa Shefatyaah oo ay Abiital dhashay, kii lixaadna, wuxuu ahaa Yitrecaam oo uu ka dhalay naagtiisii Ceglaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lix waxay ugu dhasheen Xebroon, oo Xebroon wuxuu boqor ka ahaa toddoba sannadood iyo lix bilood, oo Yeruusaalemna wuxuu boqor ku ahaa saddex iyo soddon sannadood. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanuna waxay isaga ugu dhasheen Yeruusaalem: Shimcaa, iyo Shoobaab, iyo Naataan, iyo Sulaymaan, afartaas oo ay dhashay Batshuuca oo ahayd ina Cammii'eel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Yibxaar, iyo Eliishaamaac, iyo Eliifeled, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Nogah, iyo Nefeg, iyo Yaafiica, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.7",
            "verseOrgIds": [
              "1CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Eliishaamaac, iyo Elyaadaac, iyo Eliifeled, oo iyana waxay ahaayeen sagaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwaas oo dhammu waxay ahaayeen ilmaha Daa'uud, oo wiilashiisii uu addoommaha ka dhalayna kuma ay jirin, oo Taamaarna waxay ahayd walaashood.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
