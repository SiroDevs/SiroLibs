            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miqloodna wuxuu dhalay Shime'aam. Iyana walaalahood ayay la degganaayeen Yeruusaalem meel walaalahood ka soo hor jeedda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
