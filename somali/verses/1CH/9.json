            "number": "39",
            "style": "v",
            "sid": "1CH 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neerna wuxuu dhalay Qiish, Qiishna wuxuu dhalay Saa'uul, Saa'uulna wuxuu dhalay Yoonaataan, iyo Malkiishuuca, iyo Abiinaadaab, iyo Eshbacal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.39",
            "verseOrgIds": [
              "1CH.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilkii Yoonaataanna wuxuu ahaa Meriibacal, Meriibacalna wuxuu dhalay Miikaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Miikaahna waxay ahaayeen Fiitoon, iyo Meleg, iyo Taxreeca iyo Aaxaas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaxaasna wuxuu dhalay Yacraah, Yacraahna wuxuu dhalay Calemed, iyo Casmaawed, iyo Simrii, Simriina wuxuu dhalay Moosaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.42",
            "verseOrgIds": [
              "1CH.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moosaana wuxuu dhalay Bincaa, oo wiilkiisiina wuxuu ahaa Refaayaah, oo dhalay Elecaasaah, oo isna dhalay Aaseel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaseelna wuxuu lahaa lix wiil, oo magacyadoodiina waa kuwan: Casriiqaam, iyo Bokeruu, iyo Ismaaciil, iyo Shecaryaah, iyo Cobadyaah, iyo Xaanaan. Intaasu waxay ahaayeen wiilashii Aaseel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
