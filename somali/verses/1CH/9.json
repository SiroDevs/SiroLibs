          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo walaalahood qaarkood oo reer Qohaad ahaana waxay u talin jireen kibistii tusniinta, si ay sabti kasta u diyaariyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanuna waa nimankii gabayaaga ahaa oo ahaa madaxdii qolooyinka reer Laawi, oo waxay joogi jireen qolalka oo hawl kalena ma ay hayn, waayo, iyagu habeen iyo maalinba waxay qabanayeen shuqulkoodii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwaasu waxay ahaayeen madaxdii qolooyinka reer Laawi, oo qarniyadoodii oo dhan waxay ahaayeen rag madax ah, oo waxay degganaan jireen Yeruusaalem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
    },
