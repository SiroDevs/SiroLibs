          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo curadkiisii Cabdoon ahaa, iyo Suur, iyo Qiish, iyo Bacal, iyo Neer, iyo Naadaab, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
        {
