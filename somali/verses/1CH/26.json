    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iridjoogayaashii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kooxihii iridjoogayaashiina waa kuwan: reer Qorax waxaa laga doortay Meshelemyaah ina Qore oo ahaa reer Aasaaf. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Meshelemyaahna wuxuu lahaa wiilal, oo curadkiisii wuxuu ahaa Sekaryaah, kii labaadna Yediica'eel, kii saddexaadna Sebadyaah, kii afraadna Yatnii'eel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kii shanaadna Ceelaam, kii lixaadna Yehooxaanaan, kii toddobaadna Eliihooceenay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Cobeed Edoomna wuxuu lahaa wiilal, oo curadkiisii wuxuu ahaa Shemacyaah, kii labaadna Yehoosaabaad, kii saddexaadna Yoo'aax, kii afraadna Saakaar, kii shanaadna Netaneel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kii lixaadna Ammii'eel, kii toddobaadna Isaakaar, kii siddeedaadna Fecultay, waayo, Ilaah baa isaga barakeeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba wiilkiisii Shemacyaahna wiilal baa u dhashay, oo iyagaa u talin jiray reerkii aabbahood, waayo, waxay ahaayeen rag xoog badan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6",
            "verseOrgIds": [
              "1CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Shemacyaahna waxay ahaayeen Cotnii, iyo Refa'eel, iyo Coobeed, iyo Elsaabaad, walaalahoodna oo ah Eliihuu iyo Semakiyaah waxay ahaayeen rag xoog badan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kulli intaasoo dhammu waxay ahaayeen reer Cobeed Edoom, oo iyaga iyo wiilashoodii iyo walaalahoodba waxay ahaayeen rag xoog iyo karti adeegidda u leh, waxayna ahaayeen laba iyo lixdan nin oo reer Cobeed Edoom wada ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.8",
            "verseOrgIds": [
              "1CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Meshelemyaahna wuxuu lahaa siddeed iyo toban nin oo ahaa rag xoog badan, waxayna wada ahaayeen wiilashiisii iyo walaalihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.9",
            "verseOrgIds": [
              "1CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba Xosaah oo ahaa reer Meraariina wuxuu lahaa wiilal, waxaana ugu weynaa Shimrii (waayo, in kastoo uusan curadkii ahayn haddana aabbihiis ayaa madax ka dhigay), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kii labaadna wuxuu ahaa Xilqiyaah, kii saddexaadna Tebalyaah, kii afraadna Sekaryaah. Oo Xosaah wiilashiisii iyo walaalihiis oo dhammu waxay ahaayeen saddex iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iridjoogayaasha kooxahooduna intaasay ka koobnaayeen, waxayna ahaayeen rag madax ah, oo sida walaalahood hawl madax ka ah inay guriga Rabbiga ka dhex adeegaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.12",
            "verseOrgIds": [
              "1CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyana midkooda ugu yar iyo midka ugu weynba, sidii ay qolooyinkoodu kala ahaayeen ayay irid kasta saami ugu riteen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.13",
            "verseOrgIds": [
              "1CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saamigii dhanka bari wuxuu u soo baxay Shelemyaah. Oo haddana waxay saami u rideen wiilkiisii Sekaryaah, oo ahaa lataliye xigmad badan, oo saamigiisiina wuxuu ku helay dhankii woqooyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cobeed Edoomna waxaa u soo baxay dhankii koonfureed, oo wiilashiisiina waxaa u soo baxay guryihii wax lagu kaydin jiray. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.15",
            "verseOrgIds": [
              "1CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shufiim iyo Xosaahna waxaa u soo baxay dhankii galbeed oo u dhowaa iriddii Shalleked la odhan jiray, oo ku ag tiil jidka kor u baxa, oo waardiyeba waardiyaha kaluu ka soo hor jeeday. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanka bari waxaa joogi jiray lix reer Laawi ah, dhanka woqooyina maalintiiba waxaa dhawri jiray afar nin, dhanka koonfureedna maalintiiba waxaa dhawri jiray afar nin, oo guryaha wax lagu kaydiyana waxaa dhawri jiray laba laba nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Farbaar dhankeedii galbeed, oo u dhow jidkiina waxaa dhawri jiray afar, oo Farbaarna waxaa dhawri jiray laba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intaasu waxay ahaayeen kooxihii iridjoogayaasha, oo waxayna ahaayeen reer Qorax iyo reer Meraarii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Khasnajiyada Iyo Madax Kale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo mid ka mid ahaa reer Laawi oo Axiiyaah ahaana wuxuu u talin jiray khasnadihii guriga Ilaah, iyo khasnadihii ay alaabta quduuska ahu tiil. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.20",
            "verseOrgIds": [
              "1CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwii reer Lacdaan ee reer Gershoon oo uu lahaa Lacdaan, oo ahaa madaxdii reerahooda oo uu lahaa Lacdaan oo ahaa reer Gershoon, waxay ahaayeen Yexii'eelii, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo wiilashii Yexii'eelii oo ahaa Seetaam, iyo Yoo'eel oo walaalkiis ahaa, waxayna u talin jireen khasnadihii guriga Rabbiga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaana jiray reer Camraam, iyo reer Isehaar, iyo reer Xebroon, iyo reer Cusii'eel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Shebuu'eel oo ahaa ina Gershoom, oo ahaa reer Muusena wuxuu ahaa taliye xukuma khasnadihii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaana la jiray walaalihiis ahaa reer Eliiceser, kuwaasoo ahaa wiilkiisii Rexabyaah, iyo isagii wiilkiisii Yeshacyaah, iyo isagii wiilkiisii Yooraam, iyo isagii wiilkiisii Sikrii, iyo isagii wiilkiisii Shelomood. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwan oo ah Shelomood iyo walaalihiis waxay u talin jireen khasnadihii alaabta quduuska ah, kuwaasoo ay quduus ka dhigeen Boqor Daa'uud, iyo madaxdii qolooyinka, iyo kuwii kun kun u taliyey iyo kuwii boqol boqol u taliyey, iyo saraakiishii ciidanku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maalkii boolida ahaa oo dagaalka lagu soo dhacay waxay quduus uga dhigeen si loogu cusboonaysiiyo gurigii Rabbiga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kulli waxyaalihii ay quduus ka dhigeen Samuu'eel oo wax arke ahaa, iyo Saa'uul ina Qiish, iyo Abneer ina Neer, iyo Yoo'aab oo ay Seruuyaah dhashay, iyo wax alla wixii quduus laga dhigay oo dhammu waxay ku jireen gacantii Shelomood iyo tii walaalihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Kenanyaah iyo wiilashiisii oo ahaa reer Isehaarna waxay saraakiil iyo xaakinno u ahaayeen hawlaha dibadda oo reer binu Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Xashabyaah iyo walaalihiis oo ahaa reer Xebroon, oo weliba ahaa rag xoog badan, oo tiradoodu ahayd kun iyo toddoba boqol oo nin, waxay u talin jireen reer binu Israa'iilkii dhanka galbeed oo Webi Urdun ka shisheeyey, iyo shuqulkii Rabbiga oo dhan, iyo adeegiddii boqorkaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
