          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Beser, iyo Xood, iyo Shammaa, iyo Shilshaah, iyo Yitraan, iyo Be'eeraa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
