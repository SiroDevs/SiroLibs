          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yafleedna waxay ahaayeen Faasag, iyo Bimhaal, iyo Cashwaad. Intaasu waa ilma Yafleed. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
