          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo walaalkiisii Xeelem wiilashiisiina waxay ahaayeen Soofax, iyo Yimnaac, iyo Sheelesh iyo Caamaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
