          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Xeber wuxuu dhalay Yafleed, iyo Shomeer, iyo Xootaam, iyo walaashood Shuucaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
              "1CH.7.32"
            ]
          }
        },
        {
          "name": "verse",
