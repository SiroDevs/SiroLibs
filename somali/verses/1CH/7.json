              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Cullaana waxay ahaayeen Aarax, iyo Xannii'eel, iyo Risyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
