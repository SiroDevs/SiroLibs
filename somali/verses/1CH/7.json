          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma Aasheerna waxay ahaayeen Yimnaah, iyo Yishwaah, iyo Yishwii, iyo Beriicaah, iyo Serax oo ahayd walaashood. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
