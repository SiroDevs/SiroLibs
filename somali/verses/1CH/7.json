              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yeterna waxay ahaayeen Yefunneh, iyo Fisfaah, iyo Araa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
