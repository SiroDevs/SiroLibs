          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Soofaxna waxay ahaayeen Suu'ax, iyo Xarnefer, iyo Shuucaal, iyo Beerii, iyo Yimraah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
