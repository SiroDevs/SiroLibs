    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Farcankii Isaakaar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Isaakaarna waxay ahaayeen Toolac, iyo Fuwaah, iyo Yaashuub, iyo Shimroon, afar bay ahaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Toolacna waxay ahaayeen Cusii, iyo Refaayaah, iyo Yerii'eel, iyo Yahmay, iyo Yibsaam, iyo Shemuu'eel, oo waxay ahaayeen madaxdii reerahoodii oo ahaa reer Toolac, oo qarnigoodiina rag xoog badan bay ku ahaayeen. Wakhtigii Daa'uud joogayna tiradoodu waxay ahayd laba iyo labaatan kun iyo lix boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farcankii Cusiina waxay ahaayeen Yisraxyaah, iyo wiilashii Yisraxyaah oo ahaa Miikaa'eel, iyo Cobadyaah, iyo Yoo'eel, iyo Yishiyaah, oo waxay isku ahaayeen shan, dhammaantoodna waxay ahaayeen rag madax ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyaga waxaa la jiray guutooyin ah ciidankii dagaalka sidii ay u kala dhasheen iyo sidii reerahoodu ahaayeen, waxayna ahaayeen lix iyo soddon kun oo nin, waayo, waxay lahaayeen naago iyo wiilal badan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo walaalahoodii qolooyinka reer Isaakaar ku dhex jiray oo dhammu waxay ahaayeen rag xoog badan, oo kulligoodna abtiriskooda la tiriyey, oo waxayna ahaayeen toddoba iyo siddeetan kun oo qof.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.5",
            "verseOrgIds": [
              "1CH.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Farcankii Benyaamiin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.5",
            "verseOrgIds": [
              "1CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Benyaamiinna waxay ahaayeen Belac, iyo Beker, iyo Yediica'eel, oo ahaa saddex. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Belacna waxay ahaayeen Esboon, iyo Cusii, iyo Cusii'eel, iyo Yeriimood, iyo Ciirii, oo ahaa shan, oo reerahoodana madax bay u ahaayeen, rag xoog badan bayna ahaayeen, oo abtiriskoodana waa la tiriyey, oo waxay ahaayeen laba iyo labaatan kun iyo afar iyo soddon nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Bekerna waxay ahaayeen Semiiraah, iyo Yoo'aash, iyo Eliiceser, iyo Eliyooceenay, iyo Comrii, iyo Yereemood, iyo Abiiyaah, iyo Canaatood, iyo Calemed. Oo intaas oo dhammu waxay wada ahaayeen wiilashii Beker. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyaga sidii abtiriskoodii ahaa waa loo tiriyey iyo sidii ay u kala dhasheen, oo waxay ahaayeen madaxdii reerahooda oo ah rag xoog badan, tiradooduna waxay ahayd labaatan kun iyo laba boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farcankii Yediica'eelna waxay ahaayeen Bilhaan, iyo wiilashii Bilhaan oo ahaa Yecuush iyo Benyaamiin, iyo Eehuud, iyo Kenacanaah, iyo Seetaan, iyo Tarshiish, iyo Axiishaxar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intaas oo dhammu waxay ahaayeen farcankii Yediica'eel sidii ay ahaayeen madaxdii reerahoodu, rag xoog badan bayna ahaayeen, oo intoodii dagaal aawadiis ciidanka u geli kartay waxay ahaayeen toddoba iyo toban kun iyo laba boqol, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo weliba Shufiim iyo Xufiim oo ahaa wiilashii Ciir, iyo Xushiim oo ahaa ina Axeer.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Farcankii Naftaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Naftaalina waxay ahaayeen Yaxsii'eel, iyo Guunii, iyo Yeser, iyo Shalluum, oo intaasu waxay ahaayeen wiilashii Bilhah.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Farcankii Manaseh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Manasehna waxay ahaayeen Casrii'eel, oo ay naagtiisii dhashay: (oo naagtiisii addoonta ahaydna waxay u dhashay Maakiir oo ahaa Gilecaad aabbihiis, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maakiirna wuxuu guursaday walaashii Xufiim iyo Shufiim, oo magaceedana waxaa la odhan jiray Macakaah,) oo wiilkii labaad magiciisana waxaa la odhan jiray Selaafexaad, oo Selaafexaadna wuxuu lahaa gabdho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Macakaah oo ahayd Maakiir naagtiisiina waxay dhashay wiil, oo magiciisiina waxay u bixisay Feresh, oo walaalkiis magiciisana waxaa la odhan jiray Shereesh, wiilashiisiina waxay ahaayeen Uulaam iyo Raaqem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina Uulaamna wuxuu ahaa Bedaan. Kuwaasu waxay ahaayeen wiilashii Gilecaad oo ahaa ina Maakiir, oo ka sii ahaa ina Manaseh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo walaashiis Hammolekedna waxay dhashay Iishood, iyo Abiiceser, iyo Maxlaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Shemiidaacna waxay ahaayeen Axyaan, iyo Shekem, iyo Liqxii, iyo Aniicaam.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Farcankii Efrayim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farcankii Efrayimna waxay ahaayeen Shuutelax oo dhalay Bered, oo isna dhalay Taxad, oo isna dhalay Elcaadaah, oo isna dhalay Taxad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo isna dhalay Saabaad, oo isna dhalay Shuutelax, iyo weliba Ceser, iyo Elcaad oo ay dileen dadkii reer Gad oo dalka ku dhashay, maxaa yeelay, iyagu waxay u soo degeen inay xoolahooda dhacaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo aabbahood Efrayimna maalmo badan ayuu aawadood u barooranayay, laakiinse waxaa isaga u yimid walaalihiis inay tacsiyeeyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isna markaasuu naagtiisii u tegey, kolkaasay uuraysatay oo waxay dhashay wiil. Markaasuu magiciisii u bixiyey Beriicaah, maxaa yeelay, belaayaa reerkiisii ku dhacday. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo gabadhiisana waxaa la odhan jiray She'eraah, oo iyadu waxay dhistay Beytxooroon tan hoose iyo tan sareba, iyo weliba Useen She'eraah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu dhalay Refax, oo isna dhalay Reshef, iyo wiilkiisii Telax, oo isna dhalay Tahan, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo isna dhalay Lacdaan, oo isna dhalay Cammiihuud, oo isna dhalay Eliishaamaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
