          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Shemerna waxay ahaayeen Axii, iyo Raahgaah, iyo Yehubbaah, iyo Araam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
