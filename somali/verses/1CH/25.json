          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii kow iyo tobnaadna wuxuu u soo baxay Casareel, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
            "verseOrgIds": [
              "1CH.25.18"
            ]
