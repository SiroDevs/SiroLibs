      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba Daa'uud iyo saraakiishii ciidanku waxay adeegiddii u sooceen kuwa ah reer Aasaaf, iyo reer Heemaan, iyo reer Yeduutuun, kuwaasoo wax ku sii sheega kataarado iyo shareerado iyo suxuun laysku garaaco, oo kuwa shuqulka qabta sidii adeegiddoodu kala ahayd tiradoodii waxay ahayd: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Aasaaf oo ahaa Sakuur, iyo Yuusuf, iyo Netanyaah, iyo Asareelaah, intaasu waxay ahaayeen reer Aasaaf oo ka hooseeya Aasaaf kaasoo markii boqorku amro wax sii sheegi jiray, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo reer Yeduutuun, oo wiilashii Yeduutuunna waxay ahaayeen lix, oo ahaa Gedalyaah, iyo Serii, iyo Yeshacyaah, iyo Xashabyaah, iyo Matityaah, oo waxay ka wada hooseeyeen aabbahood Yeduutuun oo kataaradda lahaa oo wax sii sheegi jiray markuu Rabbiga u mahad naqayo oo ammaanayo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo reer Heemaan: oo wiilashii Heemaanna waxay ahaayeen Buqiyaah, iyo Matanyaah, iyo Cusii'eel, iyo Shebuu'eel, iyo Yeriimood, iyo Xananyaah, iyo Xanaanii, iyo Elii'aataah, iyo Giddaltii, iyo Romamtii Ceser, iyo Yaashbeqaashaah, iyo Mallootii, iyo Hootiir, iyo Maxasii'ood. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwaas oo dhammuna waxay ahaayeen wiilashii Heemaan kaasoo ahaa waxarkihii boqorka u sheegi jiray erayadii Ilaah, oo geeska kor u qaadi jiray. Oo Ilaahna wuxuu Heemaan siiyey afar iyo toban wiil iyo saddex gabdhood. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intaas oo dhammu waxay ka hooseeyeen aabbahood inay gurigii Rabbiga ku dhex gabyaan iyagoo haysta suxuun laysku garaaco, iyo shareerado, iyo kataarado, inay ka adeegaan guriga Ilaah, oo boqorku wuxuu saas ku amray Aasaaf iyo Yeduutuun iyo Heemaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyagii iyo walaalahood la jiray ee la baray inay Rabbiga u gabyaan kuwaasoo dhammaan farsamada yiqiin tiradoodu waxay ahayd laba boqol iyo siddeed iyo siddeetan nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyana hawshoodii waxay u riteen saami iswada le'eg, oo way isle'ekaysteen, kan ugu yar iyo kan ugu weyn, iyo xataa macallin iyo ardayba, waxba isma dheeraysan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba saamigii kowaad wuxuu u soo baxay reer Aasaaf oo waxaa helay Yuusuf. Kii labaadna wuxuu u soo baxay Gedalyaah, oo isaga iyo walaalihiis iyo wiilashiisiiba waxay isku ahaayeen laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii saddexaadna wuxuu u soo baxay Sakuur, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.10",
            "verseOrgIds": [
              "1CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii afraadna wuxuu u soo baxay Yisrii, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii shanaadna wuxuu u soo baxay Netanyaah, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.12",
            "verseOrgIds": [
              "1CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii lixaadna wuxuu u soo baxay Buqiyaah, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii toddobaadna wuxuu u soo baxay Yeshareelaah, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.14",
            "verseOrgIds": [
              "1CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii siddeedaadna wuxuu u soo baxay Yeshacyaah, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
            "verseOrgIds": [
              "1CH.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
