          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii tobnaadna wuxuu u soo baxay Shimcii, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.17",
            "verseOrgIds": [
              "1CH.25.17"
            ]
