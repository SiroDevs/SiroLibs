          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii laba iyo tobnaadna wuxuu u soo baxay Xashabyaah, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
