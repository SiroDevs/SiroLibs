          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii sagaalaadna wuxuu u soo baxay Matanyaah, iyo wiilashiisii iyo walaalihiisba oo ahaa laba iyo toban. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
            "verseOrgIds": [
              "1CH.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
