    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guulihii Daa'uud",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taas dabadeed ayaa Daa'uud reer Falastiin laayay oo jebiyey, oo Gad iyo magaalooyinkeediiba gacantii reer Falastiin wuu ka qaaday. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu kaloo laayay reer Moo'aab, oo reer Moo'aabna addoommay Daa'uud u noqdeen, oo baad bay u keeneen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ilaa Xamaad Daa'uud wuxuu dilayay boqorkii Soobaah oo ahaa Hadarceser, intuu ku socday inuu dowladnimadiisa ku ag dhiso Webi Yufraad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Daa'uud wuxuu isagii ka qabsaday kun gaadhifaras, iyo toddoba kun oo fardooley ah, iyo labaatan kun oo nin oo lug ah, oo Daa'uudna wuxuu boqno jaray fardihii gaadhiyada waday oo dhan, laakiinse boqol gaadhifaras buu uga reebay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Suuriyihii Dimishaqna markay u yimaadeen inay u hiiliyaan boqorkii Soobaah oo ahaa Hadarceser, Daa'uud wuxuu iyagii ka laayay laba iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daa'uudna wuxuu reer Dimishaq oo Suuriya jooga dhex dhigay rugo askareed, oo reer Suuriyana Daa'uud bay addoommo u noqdeen oo baad u keeneen. Oo Rabbiguna Daa'uud buu siiyey meel kastoo uu tegeyba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daa'uud soo qaaday gaashaammadii dahabka ahaa oo ay wateen addoommadii Hadarceser, wuxuuna keenay Yeruusaalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalooyinkii Hadarceser oo ahaa Tibxad iyo Kuun Daa'uud wuxuu ka soo qaaday naxaas aad u badan, taasoo uu Sulaymaan ka sameeyey berkeddii naxaasta ahayd iyo tiirarkii iyo weelashii naxaasta ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Tocuu oo ahaa boqorkii Xamaad markuu maqlay in Daa'uud laayay Hadarceser oo ahaa boqorkii Soobaah ciidankiisii oo dhan ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayuu Daa'uud wiilkiisii Hadooraam u soo diray inuu soo salaamo oo uu u soo duceeyo, maxaa yeelay, wuxuu la diriray oo dilay Hadarceser, waayo, Hadarceser wuxuu la diriri jiray Tocuu, oo wuxuu keenay weelal cayn kasta ah oo ah dahab iyo lacag iyo naxaasba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwaasna Boqor Daa'uud wuxuu quduus uga dhigay Rabbiga, oo wuxuu ku daray lacagtii iyo dahabkii uu ka soo dhacay quruumihii oo dhan, kuwaasoo ahaa reer Edom, iyo reer Moo'aab, iyo reer Cammoon, iyo reer Falastiin, iyo reer Camaaleq. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba Abiishay oo ay Seruuyaah dhashayna wuxuu reer Edom Dooxadii Cusbada kaga laayay siddeed iyo toban kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isna wuxuu Edom dhex dhigay rugo askareed, oo reer Edom oo dhammuna Daa'uud bay addoommo u noqdeen. Oo Rabbiguna Daa'uud guul buu siiyey meel kastoo uu tegeyba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Madaxdii Daa'uud",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Daa'uudna reer binu Israa'iil oo dhan buu u taliyey, oo wuxuu dadkiisa oo dhan ugu gar qaybshay xukun iyo caddaalad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa ciidanka u sarrayn jiray Yoo'aab oo ay Seruuyaah dhashay, oo taariikhdana waxaa qori jiray Yehooshaafaad ina Axiiluud, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wadaaddona waxaa ahaa Saadooq ina Axiituub, iyo Abiimeleg ina Aabyaataar, Shawshaana wuxuu ahaa karraani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Benaayaah ina Yehooyaadaacna wuxuu u taliyey reer Kereetiim iyo reer Feleetii, oo Daa'uud wiilashiisuna waxay ahaayeen madaxda boqorka u dhow.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    }
