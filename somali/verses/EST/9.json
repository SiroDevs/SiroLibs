          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuhuudduu waxay amreen oo dul saareen iyaga iyo farcankooda, iyo in alla intii iyaga ku darmatay, inaanay ka baaqan, inay labadaas maalmood u dhawraan sannad kasta sida waafaqsan waxa laga qoray, iyo goor waafaqsan xilligii la yidhi; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
