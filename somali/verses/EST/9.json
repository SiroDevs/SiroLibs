      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse Yuhuuddii Shuushan joogtay way isa soo wada urursadeen bishaas, maalinteedii saddex iyo tobnaad, iyo maalinteedii afar iyo tobnaad, oo isla bishaas, maalinteedii shan iyo tobnaadna way nasteen, oo waxay ka dhigeen maalin iid ah oo farxad badan. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Yuhuuddii tuulooyinka joogtay oo degganayd magaalooyinka aan derbiga lahayn, bisha Adaar, maalinteeda afar iyo tobnaad, waxay ka dhigaan maalin farxadeed oo iid ah, oo maalin wanaagsan ah, iyo maalin waxyaalo wanaagsan mid ba midka kale u diro.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Mordekay waxyaalahaas oo dhan qoray, oo wuxuu warqado u diray kulli Yuhuuddii joogtay Boqor Ahashwerus gobolladiisa oo dhan, kuwii dhowaa iyo kuwii fogaaba, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu ku amray iyagii inay sannad walba bisha Adaar, afar iyo tobankeeda iyo shan iyo tobankeeda, dhawraan, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo ay ka dhigaan maalmihii Yuhuuddii ay cadaawayaashoodii ka raysteen iyo bishii xaggooda ay murugtii farxad u beddelantay, baroortiina maalin wanaagsan; inay ka dhigaan maalmo iid ah oo farxad badan, oo mid ba midka kale waxyaalo wanwanaagsan u diro, oo masaakiintana hadiyado la siiyo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
      ]
    },
    {
