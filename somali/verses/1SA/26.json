{
  "id": "1SA.26",
  "number": "26",
  "bookId": "1SA",
  "reference": "Samuu'Eel Kowaad 26",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
