        "style": "s1"
      },
      "items": [
        {
          "text": "Feqax, Boqorkii Israa'iil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Casaryaah oo ahaa boqorkii dalka Yahuudah sannaddiisii laba iyo kontonaad ayaa Feqax ina Remalyaah dalka Israa'iil Samaariya boqor ugu noqday, oo wuxuu boqor ahaa labaatan sannadood. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isaguna wuxuu sameeyey wax Rabbiga hortiisa shar ku ah, kamana uu tegin dembiyadii uu Yaaraabcaam ina Nebaad dadka Israa'iil dembaajiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wakhtigii Feqax boqorka ka ahaa dalka Israa'iil waxaa yimid Tiglad Fileser oo ahaa boqorka Ashuur, oo wuxuu qabsaday Ciyoon, iyo Aabeel Beytmacakaah, iyo Yaanoo'ax, iyo Qedesh, iyo Xaasoor, iyo Gilecaad, iyo Galili, iyo dalkii reer Naftaali oo dhan, oo dadkiina maxaabiis ahaan ayuu Ashuur ugu kaxaystay. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoosheeca ina Eelaah ayaa Feqax ina Remalyaah sirqoolay, oo intuu wax ku dhuftay ayuu dilay, oo meeshiisiina boqor buu ka noqday sannaddii labaatanaad oo Yootam ina Cusiyaah. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Feqax falimihiisii kale iyo wixii uu sameeyey oo dhammuba waxay ku wada qoran yihiin kitaabkii taariikhda boqorradii dalka Israa'iil.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yootam, Boqorkii Yahuudah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Feqax ina Remalyaah oo ahaa boqorkii dalka Israa'iil sannaddiisii labaad ayaa Yootam ina Cusiyaah dalka Yahuudah boqor ka noqday. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markuu boqor noqday wuxuu jiray shan iyo labaatan sannadood, oo Yeruusaalem ayuu boqor ku ahaa lix iyo toban sannadood, oo hooyadiis magaceedana waxaa la odhan jiray Yeruushaah ina Saadooq. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isna wuxuu sameeyey wax Rabbiga hortiisa ku qumman, oo wuxuu wada yeelay sidii aabbihiis Cusiyaah yeelay oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habase yeeshee meelihii sarsare lama baabbi'in, oo dadkuna weli way ku allabaryi jireen, fooxna bay ku shidi jireen meelihii sarsare. Oo isagu wuxuu dhisay iriddii sare oo gurigii Rabbiga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Yootam falimihiisii kale iyo wixii uu sameeyey oo dhammuba sow kuma qorna kitaabkii taariikhda boqorradii dalka Yahuudah? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waagaas Rabbigu wuxuu bilaabay inuu dalka Yahuudah ku soo diro Resiin oo ahaa boqorkii Suuriya iyo Feqax ina Remalyaah. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yootam dhintay oo la seexday awowayaashiis, oo waxaa awowayaashiis lagula aasay magaaladii awowgiis Daa'uud, oo meeshiisiina waxaa boqor ka noqday wiilkiisii Aaxaas.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
      ]
    }
