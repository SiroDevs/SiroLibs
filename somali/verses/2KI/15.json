          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Casaryaah oo ahaa boqorkii dalka Yahuudah sannaddiisii kontonaad ayaa Fiqaxyaah ina Menaxeem dalka Israa'iil Samaariya boqor ugu noqday, oo wuxuu boqor ahaa laba sannadood. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
