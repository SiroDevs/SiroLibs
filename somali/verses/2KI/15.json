        },
        {
          "text": "Haddaba Fiqaxyaah falimihiisii kale iyo wixii uu sameeyey oo dhammuba waxay ku wada qoran yihiin kitaabkii taariikhda boqorradii dalka Israa'iil.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
