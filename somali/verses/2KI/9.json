              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Axasyaah wuxuu dalka Yahuudah boqor ka noqday sannaddii kow iyo tobnaad oo Yooraam ina Axaab.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
