{
  "id": "2KI.4",
  "number": "4",
  "bookId": "2KI",
  "reference": "Boqorradii Labaad 4",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
