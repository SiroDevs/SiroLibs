          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkaaru ha ku dhacdo kii qalloociya garta qariibka iyo agoonta iyo carmalka. Oo dadka oo dhammuna ha yidhaahdeen, Aamiin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
