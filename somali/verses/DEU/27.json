              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkaaru ha ku dhacdo kii soohdinta deriskiisa durkiya. Oo dadka oo dhammuna ha yidhaahdeen, Aamiin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
