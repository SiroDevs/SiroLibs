          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkaaru ha ku dhacdo kii neef u galmooda, cayn kasta ha ahaadee. Oo dadka oo dhammuna ha yidhaahdeen, Aamiin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
