          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkaaru ha ku dhacdo kii aabbihiis ama hooyadiis fududaysta. Oo dadka oo dhammuna ha yidhaahdeen, Aamiin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
