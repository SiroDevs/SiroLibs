          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkaaru ha ku dhacdo kii qof indha la' jidka ka habaabiya. Oo dadka oo dhammuna ha yidhaahdeen, Aamiin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
