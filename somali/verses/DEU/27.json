    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meeshii Allabariga Ee Buur Ceebaal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse iyo odayaashii reer binu Israa'iil waxay dadkii ku amreen oo ku yidhaahdeen, Amarka aan maanta idinku amrayo oo dhan wada xajiya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.1",
            "verseOrgIds": [
              "DEU.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo maalintii aad Webi Urdun uga gudubtaan dalkii Rabbiga Ilaahiinna ahu uu idin siinayo waa inaad dhagaxyo waaweyn qotomisaan oo aad nuurad ku malaastaan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.2",
            "verseOrgIds": [
              "DEU.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaad ku qortaan erayada sharcigan oo dhan markaad gudubtaan inaad gashaan dalkii Rabbiga Ilaahiinna ahu idin siinayo oo ah dal caano iyo malab la barwaaqaysan, sidii Rabbiga ah Ilaahii awowayaashiin uu idiin ballanqaaday. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.3",
            "verseOrgIds": [
              "DEU.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaad Webi Urdun ka gudubtaan, waa inaad Buur Ceebaal ku qotomisaan dhagaxyada aan maanta idinkaga amrayo, oo iyaga waa inaad nuurad ku malaastaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.4",
            "verseOrgIds": [
              "DEU.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo halkaas waa inaad Rabbiga Ilaahiinna ah meel allabari uga dhistaan, ha ahaato meel allabari oo dhagax ah, oo dhagaxyadeeda waa inaydaan alaab bir ah u qaadan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.5",
            "verseOrgIds": [
              "DEU.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbiga Ilaahiinna ah meeshiisa allabariga waa inaad ku dhistaan dhagaxyo aan la qorin, oo meeshaas dusheeda waxaad Rabbiga Ilaahiinna ah ugu bixisaan qurbaanno la gubo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.6",
            "verseOrgIds": [
              "DEU.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad qurbaanno nabaadiino sadqaysaan, oo aad halkaas ku cuntaan, oo aad Rabbiga Ilaahiinna ah hortiisa ku faraxdaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad dhagaxyada si bayaan ah ugu qortaan sharcigan erayadiisa oo dhan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inkaarihii Buur Ceebaal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
