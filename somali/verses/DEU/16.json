          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dalka Rabbiga Ilaahiinna ahu uu idin siinayo irdihiinna oo dhan siday qabiilooyinkiinnu yihiin u samee xaakinno iyo saraakiil, oo iyana dadka ha ugu garsooreen garsoor xaq ah. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaydaan garta qalloocin, oo dadkana waa inaydaan u kala eexan, oo laaluushna waa inaydaan qaadan, waayo, laaluushku wuu indhatiraa kuwa xigmadda leh, oo erayada kuwa xaqa ahna wuu qalloociyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wixii dhammaan xaq ah waa inaad raacdaan, inaad noolaataan, oo aad dhaxashaan dalka Rabbiga Ilaahiinna ahu uu idin siinayo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        }
      ]
    },
    {
