              "DEU.28.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "DEU 28:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu wuxuu idinku kala dhex firdhin doonaa dadyowga oo dhan, iyo tan iyo dunida geesteed iyo ilaa geesteeda kale, oo halkaas waxaad ugu adeegi doontaan ilaahyo kale oo qoryo iyo dhagax ah oo aydaan aqoon idinka iyo awowayaashiin toona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.64",
            "verseOrgIds": [
              "DEU.28.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "DEU 28:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo quruumahaas dhexdooda istareex kama heli doontaan, oo cagtiinnuna ma nasan doonto, laakiinse Rabbigu wuxuu halkaas idinku siin doonaa qalbigariir, iyo indhabbeel, iyo naf dulloobid. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.65",
            "verseOrgIds": [
              "DEU.28.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "DEU 28:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo naftiinnana waad u shakiyi doontaan, oo habeen iyo maalinba waad cabsan doontaan, oo noloshiinnana ma aad hubi doontaan innaba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.66",
            "verseOrgIds": [
              "DEU.28.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "DEU 28:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waaberigii waxaad odhan doontaan, Bal may fiid noqoto! Sababtuna waa cabsida aad qalbiga ka cabsan doontaan iyo xumaanta aad indhaha ku arki doontaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.67",
            "verseOrgIds": [
              "DEU.28.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "DEU 28:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu mar dambe wuxuu Masar idinku celin doonaa idinkoo doonniyo ku jira, oo waxaad mari doontaan jidkii aan idinku idhi, Mar dambe ma aad arki doontaan, oo halkaasaad cadaawayaashiinna isugu iibin doontaan, inaad rag iyo dumarba addoommo u ahaataan, oo weliba ninna idinma iibsan doono.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.68",
            "verseOrgIds": [
              "DEU.28.68"
            ]
          }
        }
