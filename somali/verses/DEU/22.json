          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii nin magaalada dhexdeeda ka helo gabadh bikrad ah oo nin kale u doonan, oo uu iyada la jiifsado, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "markaas labadoodaba waa inaad soo bixisaan oo keentaan magaaladaas iriddeeda, oo waa inaad dhagxisaan si ay u dhintaan, maxaa yeelay, gabadhu magaaladay joogtay, mana ay qaylin, ninkuna ceeb buu ku hoosaysiiyey tii deriskiisa u doonanayd, oo sidaas waa inaad sharka dhexdiinna uga saartaan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
