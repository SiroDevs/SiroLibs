              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddii nin helo gabadh bikrad ah oo aan ninna u doonanayn, oo intuu qabsado uu iyada la jiifsado, oo markaas iyaga la helo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
