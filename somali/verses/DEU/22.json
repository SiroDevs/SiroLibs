          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "markaas ninkii gabadha la jiifsaday waa inuu gabadha aabbaheed siiyaa konton sheqel oo lacag ah. Iyana naagtiisa ha ahaato, maxaa yeelay, isagu ceeb buu ku hoosaysiiyey, oo isna waa inuusan furin cimrigiisa oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
