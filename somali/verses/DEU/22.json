          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninna waa inuusan qaadan naagtii aabbihiis, oo waa inuusan aabbihiis marada ka bannayn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.30",
