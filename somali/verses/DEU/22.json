        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii la helo nin la jiifa naag nin kale qabo, markaas labadooduba waa inay dhintaan, ninkii naagta la jiifsaday iyo naagtaba, oo sidaas waa inaad sharka reer binu Israa'iil dhexdooda uga saartaan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
