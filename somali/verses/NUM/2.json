          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ciidankiisii kuwii laga tiriyey waxay ahaayeen afartan kun iyo shan boqol. ",
          "type": "text",
          "attrs": {
