              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xagga koonfureedna waa inuu ahaadaa calanka xerada reer Ruubeen, siday ciidammadoodu yihiin, oo amiirka reer Ruubeenna waa inuu ahaadaa Eliisuur ina Shedeeyuur. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
