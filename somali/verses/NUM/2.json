          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilkii reer Benyaamiinna, oo amiirka reer Benyaamiinna waa inuu ahaadaa Abiidaan ina Gidconii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
