          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qabiilka reer Manaseh waa inuu ku xigaa; oo amiirka reer Manasehna waa inuu ahaadaa Gamalii'eel ina Fedaahsuur. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
