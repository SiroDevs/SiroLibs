          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ciidankiisii kuwii laga tiriyey waxay ahaayeen laba iyo soddon kun iyo laba boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
