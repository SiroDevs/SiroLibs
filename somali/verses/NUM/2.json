          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ciidankiisii kuwii laga tiriyey waxay ahaayeen lix iyo afartan kun iyo shan boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwa ku xigaana waa inay ahaadaan qabiilka reer Simecoon. Oo amiirka reer Simecoonna waa inuu ahaadaa Shelumii'eel ina Suuriishadday. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ciidankiisii kuwii laga tiriyey waxay ahaayeen sagaal iyo konton kun iyo saddex boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Gaadna, oo amiirka reer Gaadna waa inuu ahaadaa Eliyaasaaf ina Recuu'eel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
              "NUM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ciidankiisii kuwii laga tiriyey waxay ahaayeen shan iyo afartan kun iyo lix boqol iyo konton. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kulli intii xeradii reer Ruubeen laga tiriyey waxay ahaayeen boqol iyo kow iyo konton kun iyo afar boqol iyo konton, siday ciidammadoodu ahaayeen. Oo iyana waa inay marka labaad baxaan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.16",
            "verseOrgIds": [
              "NUM.2.16"
