          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxay Muuse ku yidhaahdeen, Annagoo addoommadaada ah waan soo tirinnay ragga dagaalyahannada ah oo aannu u talinno, oo nin qudhuhu nagama dhinna. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
