          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Haddaba shirka badhkiisii wuxuu ahaa saddex boqol iyo toddoba iyo soddon kun iyo shan boqol oo ido ah, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
