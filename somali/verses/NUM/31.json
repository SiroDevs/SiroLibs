          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaas waxaa Muuse u yimid saraakiishii ahayd kun-u-taliyayaashii iyo boqol-u-taliyayaashii oo u sarreeyey kumanyaalkii ciidanka ahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
