          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbiga canshuurtiisii idaha ka go'day waxay ahayd lix boqol iyo shan iyo toddobaatan neef. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
