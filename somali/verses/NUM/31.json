          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dahabkii qurbaanka sare loo qaado oo dhan oo ay kun-u-taliyayaasha iyo boqol-u-taliyayaashu Rabbiga u bixiyeen wuxuu ahaa lix iyo toban kun iyo toddoba boqol iyo konton sheqel. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
