          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer binu Israa'iil badhkoodii wuxuu Muuse gooni uga dhigay qaybtii raggii dagaallamay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
