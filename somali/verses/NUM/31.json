          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo lo'duna waxay ahayd lix iyo soddon kun, oo Rabbiga canshuurtiisii ka go'dayna waxay ahayd laba iyo toddobaatan neef. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
