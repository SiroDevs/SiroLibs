          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Waayo, raggii dagaalyahannada ahaa nin waluba wuxuu qaatay wixii uu soo dhacay.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
