              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo dadkuna kulligiis wuxuu ahaa laba iyo soddon kun oo ah dumarkii aan rag la seexan. ",
          "type": "text",
          "attrs": {
