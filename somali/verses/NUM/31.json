          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dadkuna wuxuu ahaa lix iyo toban kun, oo Rabbiga canshuurtiisii ka go'dayna waxay ahayd laba iyo soddon qof. ",
          "type": "text",
          "attrs": {
