          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo annagu waannu keennay qurbaankii Rabbiga, kaas oo ah wixii dahab ah oo nin waluba helay, kuwaasoo ah silsilado, iyo dugaagado, iyo kaatunno, iyo hilqado, iyo murriyado, inaannu naftayada Rabbiga hortiisa u kafaaro gudno. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
