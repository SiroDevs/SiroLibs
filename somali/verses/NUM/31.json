          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dameerraduna waxay ahaayeen soddon kun iyo shan boqol, oo Rabbiga canshuurtiisii ka go'dayna waxay ahayd kow iyo lixdan neef. ",
          "type": "text",
          "attrs": {
