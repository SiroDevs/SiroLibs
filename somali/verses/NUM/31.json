          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Muuse iyo wadaadkii Elecaasaar ahaa iyagay ka qaadeen dahabkii oo ahaa wax kasta oo laysku sharxo oo dahab laga sameeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
