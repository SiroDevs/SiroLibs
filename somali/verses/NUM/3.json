          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tiradooda dheeraadka ah lacagta lagu madax furtay waa inaad Haaruun iyo wiilashiisa siisaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
