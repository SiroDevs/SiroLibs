          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwoodii loo tiriyey siday ahayd tiradii kuwii labka ahaa oo dhan, intii bil jirtay ama ka sii weynayd, waxay ahaayeen lix kun iyo laba boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
