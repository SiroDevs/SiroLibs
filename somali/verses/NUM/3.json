          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Muuse lacagtii madaxfurashada ahayd wuxuu u dhiibay Haaruun iyo wiilashiisii, siduu ahaa eraygii Rabbigu Muuse ku amray.",
          "type": "text",
