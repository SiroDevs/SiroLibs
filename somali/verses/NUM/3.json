              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu wuxuu Muuse ku yidhi, Tiri curadyada labka ah oo reer binu Israa'iil oo dhan, intii bil jirta ama ka sii weyn, oo magacyadooda ku soo xisaab. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
