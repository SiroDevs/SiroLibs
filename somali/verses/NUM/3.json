          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad ii qaaddaa reer Laawi intii aad ii qaadi lahayd curadyada reer binu Israa'iil oo dhan, oo waa inaad xoolaha reer Laawina ii qaaddaa intii aad ii qaadi lahayd curadyada xoolaha reer binu Israa'iil oo dhan, waayo, aniga ayaa Rabbiga ah. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
