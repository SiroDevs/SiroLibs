          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse lacagtii ka qaaday kuwii ka sii badnaa kuwii lagu madax furtay reer Laawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
