          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Meraarii waxaa loo amray inay u taliyaan taambuugga looxyadiisa, iyo ulihiisa gudban, iyo tiirarkiisa, iyo saldhigyadiisa, iyo alaabtiisa oo dhan, iyo hawshiisa oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
