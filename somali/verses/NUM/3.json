          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyana waxay u talin doonaan sanduuqa, iyo miiska, iyo laambadda, iyo meelaha allabariga, iyo weelasha meesha quduuska ah oo ay ku adeegaan, iyo daaha, iyo hawsha oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
