              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo labada boqol iyo saddex iyo toddobaatanka curad oo reer binu Israa'iil oo ka sii badan reer Laawi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
