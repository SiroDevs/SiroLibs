          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qabiilka reer Meraarii amiirkoodii wuxuu ahaa Surii'eel ina Abiixayil, oo iyana waa inay taambuugga dhankiisa woqooyi teendhooyinkooda ka dhistaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
