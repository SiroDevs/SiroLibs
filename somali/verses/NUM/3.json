            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Meraariina waxaa ka soo farcamay reer Maxlii iyo reer Mushii, kuwaasu waa qolooyinkii reer Meraarii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
