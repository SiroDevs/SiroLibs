          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo curadyadii reer binu Israa'iil ayuu ka qaaday lacagtii, oo ahayd kun iyo saddex boqol iyo shan iyo lixdan sheqel oo le'eg sheqelka meesha quduuska ah. ",
          "type": "text",
          "attrs": {
