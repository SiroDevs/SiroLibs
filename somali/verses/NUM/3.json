          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse curadyadii reer binu Israa'iil oo dhan u tiriyey sidii Rabbigu ugu amray. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
