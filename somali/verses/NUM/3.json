          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo tiirarka barxadda ku wareegsanna, iyo saldhigyadooda, iyo musaamiirtooda iyo xadhkahooda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
