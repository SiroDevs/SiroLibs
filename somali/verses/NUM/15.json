            "sid": "NUM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intii reer binu Israa'iil cidladii joogeen, waxay heleen nin maalintii sabtida qoryo guranaya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.32",
            "verseOrgIds": [
              "NUM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwii helay isagoo qoryo guranaya waxay u keeneen Muuse iyo Haaruun iyo shirkii oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.33",
            "verseOrgIds": [
              "NUM.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaasay xidheen, maxaa yeelay, waxa isaga lagu samayn lahaa ayaan weli la caddayn. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.34",
            "verseOrgIds": [
              "NUM.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu Muuse ku yidhi, Ninka hubaal waa in la dilaa, oo shirka oo dhammu waa inay isaga xerada dibaddeeda ku dhagxiyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa shirkii oo dhammu waxay isagii keeneen xerada dibaddeedii, kolkaasay dhagxiyeen oo wuu dhintay, sidii Rabbigu Muuse ku amray.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        }
      ]
    },
