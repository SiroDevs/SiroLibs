{
  "id": "NUM.27",
  "number": "27",
  "bookId": "NUM",
  "reference": "Tirintii 27",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "NUM 27"
      },
      "items": [
        {
          "text": "27",
