            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dalka aad deggan tihiin waa inaydaan nijaasayn, waayo, dhiigu dalka waa nijaaseeyaa, oo dalka dhiiggii lagu dhex daadshay wax loogu kafaaro gudi karo lama arko, dhiigga kii daadshay mooyaane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
