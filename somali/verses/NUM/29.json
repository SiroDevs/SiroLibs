          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba orgi waa inaad u bixisaan qurbaan dembi, oo ayan qurbaanka la gubo oo joogtada ah iyo qurbaankiisa hadhuudhka ah, iyo qurbaankiisa cabniinka ahu ku jirin.",
          "type": "text",
