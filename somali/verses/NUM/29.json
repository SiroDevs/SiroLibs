          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse waa inaad Rabbiga qurbaan la gubo oo caraf udgoon ah ugu bixisaan dibi yar iyo wan weyn iyo toddoba wan oo yaryar oo wada gu jir ah, oo waa inay idiin ahaadaan kuwa aan iin lahayn, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
