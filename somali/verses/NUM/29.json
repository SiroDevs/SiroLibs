          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaad la bixisaan qurbaankooda hadhuudhka ah oo ah bur saliid lagu daray, oo burkii tobankii meelood saddex meelood saddex iyo tobanka dibi midkiiba la bixi, oo labada wan oo waaweynna midkiiba laba meelood la bixi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
