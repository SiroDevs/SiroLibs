          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo toddobada wan oo yaryarna wankiiba meel la bixi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
