            }
          ]
        },
        {
          "text": "Oo bisha toddobaad maalinteeda shan iyo tobnaad waa inaad yeelataan shir quduus ah, oo waa inaydaan innaba shuqul caadi ah samayn, oo waa inaad inta toddoba maalmood ah Rabbiga iid u samaysaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
