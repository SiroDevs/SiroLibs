          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo saddex iyo tobanka wan oo yaryarna mid kasta meel la bixi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
