              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaad la bixisaan qurbaankoodii hadhuudhka ah oo ah bur saliid lagu daray, oo burka tobankii meelood saddex meelood dibiga la bixi, wankana laba meelood, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
