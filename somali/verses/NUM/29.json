            }
          ]
        },
        {
          "text": "Oo bishaas toddobaad, maalinteeda tobnaad, waxaad yeeshaan shir quduus ah, oo waa inaad nafihiinna dhibtaan, oo waa inaydaan innaba shuqul samayn cayn kasta ha ahaadee, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
