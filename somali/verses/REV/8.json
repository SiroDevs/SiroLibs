          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddana waxaan arkay oon maqlay gorgor dhex duulaya samada isagoo cod weyn ku leh, Waxaa hoogay oo hoogay oo hoogay kuwa dhulka deggan, sababtuna waa buunanka dhawaaqooda hadhay oo saddexda malaa'igood ay dhowaan ka dhawaajin doonaan.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
