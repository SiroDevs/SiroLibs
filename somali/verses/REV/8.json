          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana waxaa ka dhawaajisay malaa'igtii afraad, markaasaa waxaa wax lagu dhuftay qorraxda saddex meelood oo meel, iyo dayaxa saddex meelood oo meel, iyo xiddigaha saddex meelood oo meel, in saddex meelood oo meeli ay gudcur noqoto, iyo in maalinta saddex meelood oo meeli aanay iftiimin, habeenkuna uu noqdo sidaas oo kale.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saddexda Hoog",
          "type": "text"
        }
      ]
    },
    {
