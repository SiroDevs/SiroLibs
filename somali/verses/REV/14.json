              "REV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana malaa'ig kale ayaa waxay ka baxday macbudka samada ku yaal, oo iyana waxay haysatay manjo af badan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana malaa'ig kale oo dabka xukunta ayaa waxay ka soo baxday meeshii allabariga; oo waxay cod weyn ugu dhawaaqday tii manjada afka badan haysatay iyadoo ku leh, Manjadaada afka badan soo dir, oo waxaad ururisaa canabka dhulka rucubyadiisa; maxaa yeelay, canabkii waa bislaaday. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.18",
            "verseOrgIds": [
              "REV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa malaa'igtii waxay manjadeedii ku soo tuurtay dhulka, oo waxay soo ururisay canabka dhulka, oo waxay ku tuurtay macsaraddii canabka oo weyn oo cadhada Ilaah. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.19",
            "verseOrgIds": [
              "REV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo canabkiina waxaa lagu tuntay magaalada dibaddeeda, oo waxaa macsaraddii ka soo baxay dhiig, wuxuuna gaadhay tan iyo fardaha xakamahooda, ilaa kun iyo lix boqol oo ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.20",
            "verseOrgIds": [
              "REV.14.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:20",
              "type": "text"
            },
            {
              "text": "Istaadiyon",
              "type": "text"
            },
            {
              "text": "Mayl toban meelood oo meel.",
              "type": "text"
            }
          ]
        },
        {
          "text": "istaadiyon.",
          "type": "text",
          "attrs": {
