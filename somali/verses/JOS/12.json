        {
          "text": "iyo boqorkii Tacanaag, iyo boqorkii Megiddoo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
