          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo boqorkii Debiir, iyo boqorkii Geder, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.13",
            "verseOrgIds": [
              "JOS.12.13"
            ]
          }
        },
