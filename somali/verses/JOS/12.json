          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo boqorkii Yarmuud, iyo boqorkii Laakiish, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.11",
            "verseOrgIds": [
              "JOS.12.11"
            ]
          }
        },
