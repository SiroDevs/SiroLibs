          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo boqorkii Cegloon, iyo boqorkii Geser, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.12",
            "verseOrgIds": [
              "JOS.12.12"
            ]
