          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo boqorkii Door oo ku tiil meesha ugu dheer Door, iyo boqorkii quruumaha degganaa Gilgaal, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
