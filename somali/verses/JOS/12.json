          "text": "iyo boqorkii Libnaah, iyo boqorkii Cadullaam, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.15",
            "verseOrgIds": [
              "JOS.12.15"
            ]
          }
        },
