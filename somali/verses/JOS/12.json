          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanu waa boqorradii Yashuuca iyo reer binu Israa'iil ka laayeen Webi Urdun shishadiisa xagga galbeed ka xigta, markii laga bilaaba Bacal Gaad oo ku tiil dooxadii Lubnaan iyo tan iyo Buur Xaalaaq oo kor u kacsan Seciir; oo Yashuuca wuxuu siiyey qabiilooyinkii reer binu Israa'iil, oo hanti ahaan buu ugu qaybiyey, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "xagga dalkii buuraha lahaa, iyo dalkii dooxooyinka ahaa, iyo bankii Caraabaah, iyo dhaadhacyadii, iyo cidladii, iyo xagga Koonfureed; iyo reer Xeed, iyo reer Amor, iyo reer Kancaan, iyo reer Feris, iyo reer Xiwi, iyo reer Yebuus. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa kuwan boqorradii, boqorkii Yerixoo, iyo boqorkii Aacii tii u dhowayd Beytel, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo boqorkii Yeruusaalem, iyo boqorkii Xebroon, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
              "JOS.12.10"
            ]
          }
        },
