        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
