        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaasuu Rabbigu reer binu Israa'iil u siiyey dhulkii u awowayaashood ugu dhaartay inuu siiyo oo dhan, oo iyana way hantiyeen, wayna iska degeen. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu wuxuu iyagii ka nasiyey dadkii ku wareegsanaa, siduu awowayaashood ugu dhaartay oo dhan: oo nin cadaawayaashoodii oo dhan ka mid ihi hortooda isma taagin, oo Rabbigu cadaawayaashoodii oo dhan gacantuu u soo geliyey. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxba kama baaqan innaba wixii wanaagsanaa oo Rabbigu u sheegay reer binu Israa'iil; laakiinse kulli way wada ahaadeen.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
