          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yashuuca wuxuu laayay iyagii ilaa Qaadeesh Barneeca iyo tan iyo Gaasa, iyo dalkii reer Goshen oo dhan, iyo xataa tan iyo Gibecoon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
