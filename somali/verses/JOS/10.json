            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yashuuca Rabbiga la hadlay maalintii Rabbigu reer Amor u dhiibay reer binu Israa'iil, oo wuxuu reer binu Israa'iil hortooda ka yidhi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yashuuca iyo reer binu Israa'iil oo dhammu waxay ku noqdeen xeradii ku tiil Gilgaal.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.15",
            "verseOrgIds": [
              "JOS.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shan Boqor Oo Reer Amor Ah Oo La Dilay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.15",
            "verseOrgIds": [
              "JOS.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasaa shantii boqor carartay, oo waxay ku dhuunteen godkii ku yiil Maqeedaah. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.16",
            "verseOrgIds": [
              "JOS.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaasaa Yashuuca loo sheegay, oo waxaa lagu yidhi, Shantii boqor waxaa la helay iyagoo ku qarsoon god ku yaal Maqeedaah. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.17",
            "verseOrgIds": [
              "JOS.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu Yashuuca yidhi, Dhagaxyo waaweyn ku giringiriya godka afiisa, oo rag dhawrana ag taaga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.18",
            "verseOrgIds": [
              "JOS.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse intiinna kale ha joogsanina; ee cadaawayaashiinna eryada, oo laaya intooda ugu dambaysa, oo ha u oggolaanina inay galaan magaalooyinkooda; waayo, Rabbiga Ilaahiinna ah ayaa iyaga gacanta idiin geliyey. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markii Yashuuca iyo reer binu Israa'iil ay dhammeeyeen layntii weynayd ee ay raggii laayeen, ilaa ay wada baabbi'iyeen oo firxadkii ka soo hadhayna ay galeen magaalooyinkii deyrarka lahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.20",
            "verseOrgIds": [
              "JOS.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayaa dadkii oo dhammu nabdoonaan ku soo noqdeen Yashuuca oo joogay xeradii ku tiil Maqeedaah, oo mid qudh ahu afka uma kala qaadin reer binu Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.21",
            "verseOrgIds": [
              "JOS.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaasuu Yashuuca yidhi, Godka afkiisa banneeya oo shantii boqor ka soo bixiya godkii oo ii keena. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.22",
            "verseOrgIds": [
              "JOS.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasay sidii yeeleen, oo waxay isagii u keeneen shantii boqor oo ay ka soo bixiyeen godkii, kuwaas oo ahaa boqorkii Yeruusaalem, iyo boqorkii Xebroon, iyo boqorkii Yarmuud, iyo boqorkii Laakiish, iyo boqorkii Cegloon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.23",
            "verseOrgIds": [
              "JOS.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markay boqorradii u keeneen Yashuuca ayuu u yeedhay raggii reer binu Israa'iil oo dhan, oo wuxuu raggii dagaalyahannada ahaa oo isaga raacay madaxdoodii ku yidhi, Soo dhowaada, oo boqorradan qoorta kaga joogsada. Oo kolkaasay soo dhowaadeen, oo boqorradii qoorta kaga joogsadeen. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.24",
            "verseOrgIds": [
              "JOS.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yashuuca wuxuu iyagii ku yidhi, Ha cabsanina, hana qalbi jabina; xoog yeesha oo aad u dhiirranaada; waayo, Rabbigu sidaasuu u geli doonaa cadaawayaashiinna aad la diriraysaan oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaas dabadeed ayuu Yashuuca wada laayay, oo uu shan geed ka soo deldelay, oo waxay geedihii ka soo laalaadeen ilaa fiidkii. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.26",
            "verseOrgIds": [
              "JOS.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kolkay qorraxdu dhacday ayaa Yashuuca amray in laga soo dejiyo geedihii, oo kolkaasay ku tuureen godkii ay markii hore ku dhuunteen, oo markaasay dhagaxyo waaweyn godkii afkiisii saareen, oo waa sidii ilaa maantadan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yashuuca maalintaasuu qabsaday Maqeedaah, oo wuxuu dadkeedii ku laayay seef, iyo xataa boqorkeedii; oo dadkii ku jiray oo dhan wuu wada baabbi'iyey, oo waxba kama uu reebin, oo boqorkii Maqeedaah wuxuu ku sameeyey sidii uu ku sameeyey boqorkii Yerixoo.",
          "type": "text",
