          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo boqorradaas iyo dalkoodii oo dhan Yashuuca isku mar buu wada qabsaday, maxaa yeelay, Rabbiga ah Ilaaha reer binu Israa'iil baa u diriray reer binu Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
