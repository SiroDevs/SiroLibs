              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa eraygii Rabbigu ku soo degay Yeremyaah, isagoo leh, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
