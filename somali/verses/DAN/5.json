              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boqorow, Ilaaha ugu Sarreeyaa wuxuu aabbahaa Nebukadnesar siiyey boqortooyada, iyo weynaan, iyo ammaan, iyo derejo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo weynaantii uu siiyey aawadeed ayay dadyowgii iyo quruumihii iyo kuwii kala afka ahaa oo dhammu la gariireen oo ka cabsadeen. Kuu doonayay wuu dilay, kuu doonayayna wuu reebay; oo kuu doonayay wuu sarraysiiyey, kuu doonayayna wuu hoosaysiiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse markuu dhulka kor isaga qaaday oo ruuxiisii kibir la qallafsanaaday ayaa carshigii boqornimadiisa laga dejiyey, ammaantiisiina waa laga qaaday. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa binu-aadmiga laga eryay, qalbigiisiina waxaa laga dhigay sida kan dugaagga, wuxuuna la joogay dameeraha duurka, oo wuxuu doogga u daaqay sida dibida, jidhkiisana waxaa qoyay dharab samada ka soo dhacay ilaa uu ka ogaaday in Ilaaha ugu Sarreeyaa u taliyo boqortooyada dadka, oo uu madax uga dhigo ku alla kii uu doonayo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
