          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Daanyeel jawaabay oo yidhi isagoo boqorkii hor taagan, Boqorow, hadiyadahaaga iska hayso, abaalgudyadaadana ku kale sii; habase yeeshee farta waan kuu akhriyi doonaa, fasirkana waan kuu caddayn doonaa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
