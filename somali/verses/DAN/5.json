          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa tan fartii la qoray, MENE, MENE, TEQEL, UUFARSIIN.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        }
