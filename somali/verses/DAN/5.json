          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beelshaasarow, adigoo wiilkiisii ah, ma aadan is-hoosaysiin in kastoo aad waxyaalahan oo dhan ogayd; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
