          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "dabadeed gacanta isaga xaggiisaa laga soo diray, oo waxay qortay fartan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
