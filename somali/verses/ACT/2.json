              "type": "text"
            }
          ]
        },
        {
          "text": "oo intay iibiyeen waxyaalahoodii iyo alaabtoodiiba ayay dhammaan u wada qaybiyeen sidii nin kasta baahidiisu ahayd. ",
          "type": "text",
          "attrs": {
