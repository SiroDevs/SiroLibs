          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwii rumaystay oo dhammu waa wada jireen, wax walubana waa ka wada dhexeeyeen; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
