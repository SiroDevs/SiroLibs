              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo naf kasta cabsi baa gashay; oo rasuulladii waxay sameeyeen yaabab iyo calaamooyin badan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
