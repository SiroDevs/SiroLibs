        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.48",
            "verseOrgIds": [
              "ACT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "ACT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereygii Rabbigana waxaa lagu faafiyey waddankii oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.49",
            "verseOrgIds": [
              "ACT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin Yuhuuddu waxay soo kiciyeen dumarkii cibaadada iyo sharafta lahaa iyo raggii madaxda magaalada ahaa, silec bayna Bawlos iyo Barnabas ku kiciyeen, oo soohdintoodii bay ka eryeen iyagii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.50",
            "verseOrgIds": [
              "ACT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin markay siigadii cagahooda ka dhabaandhabeen, dabadeed ayay waxay yimaadeen Ikoniyon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xertiina waxaa ka buuxsamay farxad iyo Ruuxa Quduuska ah.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.52",
            "verseOrgIds": [
              "ACT.13.52"
            ]
          }
        }
