          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hase ahaatee Kan ugu sarreeya ma dego guryo gacmo lagu sameeyo; sida nebigu leeyahay,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.48",
            "verseOrgIds": [
              "ACT.7.48"
            ]
          }
        }
