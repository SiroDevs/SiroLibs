          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.53",
            "verseOrgIds": [
              "ACT.7.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "ACT 7:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba markay waxyaalahaas maqleen way ka xanaaqeen oo u ilka jirriqsadeen isaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.54",
            "verseOrgIds": [
              "ACT.7.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "ACT 7:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin isagoo Ruuxa Quduuska ahu ka buuxo ayuu samada aad u fiiriyey, oo wuxuu arkay ammaanta Ilaah iyo Ciise oo midigta Ilaah taagan, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.55",
            "verseOrgIds": [
              "ACT.7.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "ACT 7:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu yidhi, Bal eega, waxaan arkayaa samooyinkii oo la furay iyo Wiilkii Aadanaha oo midigta Ilaah taagan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.56",
            "verseOrgIds": [
              "ACT.7.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "ACT 7:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin markaasay cod weyn ku qayliyeen oo dhegaha furaysteen, oo iyagoo isku wada qalbi ah ku yaaceen isagii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.57",
            "verseOrgIds": [
              "ACT.7.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "ACT 7:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay intay magaalada ka soo saareen dhagxiyeen; kuwii maragga ahaana dharkoodii waxay ag dhigteen nin dhallinyaro ah oo la odhan jiray Sawlos. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.58",
            "verseOrgIds": [
              "ACT.7.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "ACT 7:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay dhagxiyeen Istefanos oo Rabbiga baryaya oo ku leh, Rabbi Ciisow, ruuxayga qaado. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.59",
            "verseOrgIds": [
              "ACT.7.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "ACT 7:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu jilba joogsaday oo cod weyn ku qayliyey oo ku yidhi, Rabbiyow, dembigan dushooda ha ka dhigin. Oo markuu sidaas yidhi, ayuu dhintay.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.60",
            "verseOrgIds": [
              "ACT.7.60"
            ]
          }
        }
      ]
