          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.24",
            "verseOrgIds": [
              "ACT.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barnabas iyo Sawlos ayaa ka soo noqday Yeruusaalem markay shuqulkoodii soo dhammaysteen, oo waxay wateen Yooxanaa oo la odhan jiray Markos.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.25",
            "verseOrgIds": [
              "ACT.12.25"
            ]
          }
        }
      ]
    }
