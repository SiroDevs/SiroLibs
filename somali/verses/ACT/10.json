{
  "id": "ACT.10",
  "number": "10",
  "bookId": "ACT",
  "reference": "Falimaha Rasuullada 10",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
