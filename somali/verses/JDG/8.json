              "JDG.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaasaa reer Midyaan loo hoosaysiiyey reer binu Israa'iil hortooda, oo mar dambena madaxooda kor uma ay qaadin. Oo wakhtigii Gidcoon dalku wuxuu nastay afartan sannadood. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa wiilkii Yoo'aash, oo Yerubbacal ahaa intuu tegey ayuu iska degay gurigiisii. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.29",
            "verseOrgIds": [
              "JDG.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Gidcoon wuxuu lahaa toddobaatan wiil oo uu isagu dhalay, waayo, wuxuu qabay naago badan. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
              "JDG.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo naagtiisii addoonta ahayd oo degganayd Shekem, iyana wiil bay u dhashay, oo wuxuu magiciisii u bixiyey Abiimeleg. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
            "verseOrgIds": [
              "JDG.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Gidcoon ina Yoo'aash ayaa dhintay isagoo da' weyn, oo waxaa lagu aasay xabaashii aabbihiis Yoo'aash, oo ku tiil Coofraah tii reer Abiiceser.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
        }
      ]
    },
