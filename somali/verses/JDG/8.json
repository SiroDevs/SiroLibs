          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "raxmadna ma ay tusin reerkii Yerubbacal, kaasoo ahaa Gidcoon, siduu wanaagga oo dhan ugu sameeyey reer binu Israa'iil.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.35",
