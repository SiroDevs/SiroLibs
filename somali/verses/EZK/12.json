            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana Eraygii Rabbiga ayaa ii yimid isagoo leh, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilka Aadamow, waa maxay hadalkan aad dalka reer binu Israa'iil ku haysataan, kaasoo leh, Wakhtigii waa sii dheeraaday oo muujin kastaaba way beenowday? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.22",
            "verseOrgIds": [
              "EZK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddaba waxaad iyaga ku tidhaahdaa, Sayidka Rabbiga ahu wuxuu leeyahay, Anigu hadalkaas waan joojin doonaa, oo mar dambena dalka reer binu Israa'iil sidaas loogama dhex hadli doono, laakiinse waxaad iyaga ku tidhaahdaa, Wakhtigii waa soo dhow yahay, oo muujin kastaaba way rumoobi doontaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, innaba mar dambe reer binu Israa'iil lagama dhex heli doono muujin been ah iyo faal sasab ah. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maxaa yeelay, anaa Rabbiga ah. Anigu waan hadli doonaa, oo eraygii aan ku hadlaana wuu oofi doonaa. Mar dambena dib looma sii dhigi doono waayo, Sayidka Rabbiga ahu wuxuu leeyahay, Reerka caasiyoobayow, wakhtigiinna ayaan erayga odhan doonaa, oo weliba waan oofin doonaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        }
      ]
    },
