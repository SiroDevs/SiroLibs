              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana Eraygii Rabbiga ayaa ii yimid isagoo leh, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilka Aadamow, kibistaada naxdin ku cun, oo biyahaagana gariirid iyo welwel ku cab, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
              "EZK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo dadka dalka degganna waxaad ku tidhaahdaa, Sayidka Rabbiga ahu wuxuu dadka deggan Yeruusaalem iyo dalka reer binu Israa'iilba ka leeyahay, Iyagu kibistooda welwel bay ku cuni doonaan, oo biyahoodana yaab bay ku cabbi doonaan, si uu dalkoodu uga cidloobo waxa dhexdiisa jooga oo dhan, waana dulmiga kuwa dhexdiisa deggan oo dhammu ay sameeyaan aawadiis. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalooyinka la deggan yahay way baabbi'i doonaan, oo dalkuna wuu cidloobi doonaa, oo idinkuna waxaad ogaan doontaan inaan anigu Rabbiga ahay.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
