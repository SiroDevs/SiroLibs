      },
      "items": [
        {
          "text": "Cadhadii Rabbiga U Cadhooday Nineweh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
