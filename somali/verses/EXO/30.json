          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ku alla kii kaas oo kale sameeya, inuu ku udgoonsado, kaas dadkiisa waa laga gooyn doonaa.",
          "type": "text",
