          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddiise mag la saaro isaga, de markaas waa inuu bixiyaa wax alla wixii la kor saaray madaxfurashadiisa aawadeed. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
