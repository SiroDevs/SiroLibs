          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay kaloo sameeyeen taajkii quduuska ahaa ee ahaa wasladdii khafiifka oo dahabka saafiga ahayd, oo waxay dushiisii ku qoreen far u eg xaradhkii shaabadda oo leh, WAA U QUDUUS RABBIGA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay ku xidheen shalash buluug ah, in lagula dhejiyo duubka sare, sidii Rabbigu Muuse ku amray.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
