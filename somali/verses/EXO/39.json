            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxay Haaruun iyo wiilashiisii u sameeyeen jubbadihii marada wanaagsan ahaa oo si fiican loo sameeyey, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxay kaloo sameeyeen duubkii Haaruun oo marada wanaagsan ahaa, iyo wiilashiisii duubabkoodii wacanaa oo marada wanaagsan ahaa, iyo sirwaalladii marada wanaagsan ahaa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo dhex-xidhkii ahaa marada wanaagsan, iyo buluug, iyo guduud, iyo casaan, oo daabacnaa, sidii Rabbigu Muuse ku amray.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        }
      ]
