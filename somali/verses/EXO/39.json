        "style": "s1"
      },
      "items": [
        {
          "text": "Muuse Oo Kormeeray Taambuugga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
