          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Naadaab falimihiisii kale, iyo wixii uu sameeyey oo dhammuba sow kuma qorna kitaabka taariikhda boqorrada dalka Israa'iil? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimrigood oo dhan dagaal baa ka dhexeeyey Aasaa iyo Bacshaa oo boqor ka ahaa dalka Israa'iil.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
