    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulaymaan Oo Qasrigiisii Dhisay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Sulaymaan gurigiisana wuxuu dhisayay saddex iyo toban sannadood, oo gurigiisii oo dhanna wuu dhammeeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.1",
            "verseOrgIds": [
              "1KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, guriga wuxuu ka dhisay geedihii Lubnaan, oo dhererkiisu wuxuu ahaa boqol dhudhun, ballaadhkiisuna wuxuu ahaa konton dhudhun, sarajooggiisuna wuxuu ahaa soddon dhudhun, oo wuxuu ku dul taagnaa afar saf oo tiirar kedar ah, oo tiirarkana waxaa dul saarnaa alwaax waaweyn oo kedar ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa ku dednaa qoryo kedar ah oo ka sarreeya shan iyo afartanka loox oo tiirarka dul saarnaa, ee shan iyo tobanba saf ahaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.3",
            "verseOrgIds": [
              "1KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu lahaa saddex saf oo dariishado ah, oo saddexda saf iftiinkooduna midba mid buu ka soo hor jeeday. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.4",
            "verseOrgIds": [
              "1KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo albaabbada oo dhan iyo dariishadaha oo dhammu waxay wada ahaayeen afargees, oo saddexda saf iftiinkooduna midba mid buu ka soo hor jeeday. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.5",
            "verseOrgIds": [
              "1KI.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu sameeyey balbalo tiirar ah; oo dhererkeedu wuxuu ahaa konton dhudhun, ballaadhkeeduna wuxuu ahaa soddon dhudhun, oo balbalona waa ka horraysay, iyadoo leh tiirar iyo looxyo balballaadhan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu kaloo sameeyey balbaladii carshiga oo ahayd meeshii uu wax ku xukumi lahaa, oo taasu waxay ahayd balbaladii xukunka; oo dhulkeedana waxaa ku dednaa alwaax kedar ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.7",
            "verseOrgIds": [
              "1KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo gurigiisii uu degi lahaana wuxuu ku yiil balbalada barxaddeeda kale, oo isku si baana loo dhisay. Oo guri balbaladan u eg ayuu u dhisay gabadhii Fircoon (oo Sulaymaan guursaday). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.8",
            "verseOrgIds": [
              "1KI.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanu dhammaantood waxay ahaayeen dhagxan qaali ah oo qiyaas loo qoray, oo kor iyo hoosba miinshaaro lagu gooyay tan iyo salka iyo baarka, oo dibadduna saasay ahayd tan iyo barxadda weyn. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.9",
            "verseOrgIds": [
              "1KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo aasaaskuna wuxuu ahaa dhagxan qaali ah oo waaweyn, oo qaarna waxay ahaayeen toban dhudhun, qaarna waxay ahaayeen siddeed dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo korkana waxaa jiray dhagxan qaali ah oo qiyaas loo qoray, iyo alwaax kedar ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.11",
            "verseOrgIds": [
              "1KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo barxadda weyn ee ku wareegsanna waxay lahayd saddex saf oo dhagxan qoran ah, iyo saf ah looxyo waaweyn oo kedar ah, oo waxay la mid ahayd guriga Rabbiga barxaddiisa hoose iyo sida balbalada guriga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alaabtii Macbudka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Boqor Sulaymaanna Xiiraam cid buu u diray oo Turos ka soo kexeeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.13",
            "verseOrgIds": [
              "1KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Xiiraam waxaa dhashay naag carmal ah oo qabiilkeedu yahay reer Naftaali, aabbihiisna wuxuu ahaa nin reer Turos ah, oo naxaasta ka shaqayn jiray, Xiiraamna waxaa ka buuxay xigmad, iyo waxgarasho, iyo sanco uu ku sameeyo shuqul kasta oo naxaas laga qabto. Oo Boqor Sulaymaan buu u yimid oo shuqulkiisii oo dhan u sameeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.14",
            "verseOrgIds": [
              "1KI.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuxuu sameeyey labada tiir oo naxaasta ah, oo midkiiba sarajooggiisu yahay siddeed iyo toban dhudhun; meeriskiisuna yahay laba iyo toban dhudhun markii xadhig lagu qiyaaso. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuxuuna sameeyey laba taaj oo naxaas la shubay ah in la saaro tiirarkii dhaladooda. Oo taaj sarajooggiisu wuxuu ahaa shan dhudhun, oo taajka kale sarajooggiisuna wuxuu ahaa shan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taajajka tiirarka dhaladooda saarnaa waxay lahaayeen shabagyo isa sudhsudhan, iyo silsilado tidcan, oo taaj wuxuu lahaa toddoba, taajka kalena wuxuu lahaa toddoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.17",
            "verseOrgIds": [
              "1KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saasuu u sameeyey tiirarkii; oo shabaggiiba waxaa kor saarnaa laba saf oo ku wareegsan inay dedaan taajajka tiirarka kor saaran; oo taajkii kalena saasoo kaluu u galay. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.18",
            "verseOrgIds": [
              "1KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo balbalada tiirarkeedii taajajkoodii saarnaa waxay u ekaayeen ubax, afar dhudhun bayna ahaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taajajkii labadii tiir saarnaa dushooda oo shabagga u dhowaana waxay lahaayeen rummaanno. Oo rummaannadu waxay ahaayeen laba boqol oo taajkiiba safaf ugu wareegsan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.20",
            "verseOrgIds": [
              "1KI.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tiirarkiina wuxuu qotomiyey balbaladii macbudka; oo tiirkii midigta ahaa intuu qotomiyey ayuu magiciisii u bixiyey Yaakiin, tiirkii bidixda ahaana intuu qotomiyey ayuu u bixiyey Bocas. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tiirarka korkoodana waxaa saarnaa wax ubax u eg, oo tiirarka hawshoodiina saasay ku dhammaatay. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.22",
            "verseOrgIds": [
              "1KI.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu sameeyey berkedda naxaasta ah, oo labadeeda qar isu jiraan toban dhudhun, oo ku wada wareegsan, oo sarajooggeeduna wuxuu ahaa shan dhudhun, oo meeriskeeduna wuxuu ahaa soddon dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo berkedda qarkeedii wareegsanaa waxaa ku hoos yiil ubbooyin ku wareegsan berkedda, dhudhunba toban; oo ubbooyinku waxay ahaayeen laba saf, oo markii berkeddii la shubay ayaa iyana la shubay. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.24",
            "verseOrgIds": [
              "1KI.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo berkeddu waxay dul saarnayd laba iyo toban dibi, oo saddex waxay u jeedday xagga woqooyi, saddexna waxay u jeedday xagga galbeed, saddexna waxay u jeedday xagga koonfureed, saddexna waxay u jeedday xagga bari; berkeddiina way dul saarnayd, oo dibidii kulligoodna qarkooda dambe wuxuu ku jiray gudaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.25",
            "verseOrgIds": [
              "1KI.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo berkeddii dhumucdeedu waxay ahayd taako; qarkeedana waxaa loo sameeyey sidii koob qarkiis oo kale oo ubax u ekaa; oo waxay qaadday laba kun oo qiyaasood oo bad la yidhaahdo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu sameeyey toban saldhig oo naxaas ah, oo saldhig kasta dhererkiisu wuxuu ahaa afar dhudhun, ballaadhkiisuna wuxuu ahaa afar dhudhun, sarajooggiisuna wuxuu ahaa saddex dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saldhigyadana sidan baa loo sameeyey; darfaha dhexdooda waxay ku lahaayeen meelo dhexe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.28",
            "verseOrgIds": [
              "1KI.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo darfaha meelaha u dhexeeyeyna waxaa ku yiil libaaxyo, iyo dibiyo, iyo keruubiim, oo darfaha korkoodana waxaa ku yiil meel la saaro; oo libaaxyada iyo dibiyada hoostoodana waxaa ku yiil ubaxyo ka soo laalaada. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.29",
            "verseOrgIds": [
              "1KI.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saldhig kastaaba wuxuu lahaa afar giraangirood oo naxaas ah, iyo ulo naxaas ah oo giraangiraha wareejiya; oo afarta rukunna waxay ku lahaayeen meelo haya; oo berkeddii hoosteeda ayaa meelihii hayay oo shubanu ku yiilleen iyagoo dhinac kasta ku leh ubaxyo ka laalaada. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.30",
            "verseOrgIds": [
              "1KI.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo afkeeda oo qarka ku dhex jira wuxuu ahaa dhudhun; oo afkeeduna wuu wareegsanaa, oo wuxuu u ekaa sida meesha haysa, wuxuuna ahaa dhudhun iyo badh; oo weliba afkeedu waa xardhanaa oo darfahooduna afargees bay ahaayeen oo ma wareegsanayn. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo afarta giraangiroodna waxay ku yiilleen darfaha hoostooda, oo ulaha giraangiraha wareejiyaana waxay ku yiilleen salka hoose; oo giraangir kastana sarajooggeedu wuxuu ahaa dhudhun iyo badh. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.32",
            "verseOrgIds": [
              "1KI.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo giraangiruhuna waxay u ekaayeen sidii gaadhifaras giraangirihiis; oo ulahooda wareejiya, iyo qararkooda, iyo birahooda gudban, iyo dhexbadhtanadoodaba kulligood shub bay ahaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.33",
            "verseOrgIds": [
              "1KI.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo afarta geesna waxay ku lahaayeen afar meelood oo haya, oo afarta meelood oo hayaana waxay ka mid ahaayeen saldhigga qudhiisii. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.34",
            "verseOrgIds": [
              "1KI.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saldhigga dushiisana waxaa tiil meel wareegsan oo sarajooggeedu yahay dhudhun badhkiis; oo saldhigga korkiisa siddooyinkiisa iyo darfihiisuba isagay ku yiilleen. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.35",
            "verseOrgIds": [
              "1KI.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo siddooyinkiisa iyo darfihiisa dushooda wuxuu ku xardhay keruubiim, iyo libaaxyo, iyo geedo timireed sidii mid kasta meeshiisii bannaanayd ahayd, iyagoo mid kasta ubaxyo laalaada ku wareegsan yihiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.36",
            "verseOrgIds": [
              "1KI.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tobankii saldhigna saasuu u sameeyey; oo kulligoodna isku si baa loo shubay, oo isku qiyaas bay ahaayeen iyo isku qaab. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.37",
            "verseOrgIds": [
              "1KI.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu sameeyey toban berkedood oo naxaas ah; oo berkedba waxay qaadday afartan bad; oo berked kastaaba waxay ahayd afar dhudhun; oo tobankii saldhigna mid kasta berked baa saarnayd. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saldhigyadii shanna wuxuu dhigay guriga dhankiisa midig, shantii kalena wuxuu dhigay guriga dhankiisa bidix; oo berkeddii weynaydna wuxuu dhigay guriga dhankiisa midig ee xagga bari ee dhinaca koonfureed. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Xiiraam wuxuu wada sameeyey berkedihii, iyo majarafadihii, iyo maddiibadihii. Oo sidaasuu Xiiraam u dhammeeyey shuqulkii uu Boqor Sulaymaan ugu sameeyey guriga Rabbiga, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaasoo ahaa labadii tiir, iyo labadii fijaan oo taajajkii tiirarka kor saarnaa, iyo labadii shabag oo ku dednaa labada fijaan oo taajajkii tiirarka kor saarnaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo afartii boqol oo rummaan ee labadii shabag lahaayeen, oo shabag kastaa wuxuu lahaa laba saf oo rummaan ah si ay u dedaan labadii fijaan ee taajajkii tiirarka kor saarnaa; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.42",
            "verseOrgIds": [
              "1KI.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo tobankii saldhig, iyo tobankii berkedood ee saldhigyada dul saarnaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.43",
            "verseOrgIds": [
              "1KI.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo berkeddii weynayd, iyo laba iyo tobankii dibi ee berkedda weyn ka hooseeyey, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo dheryihii, iyo majarafadihii, iyo maddiibadihii; oo dhammaan weelashan gurigii Rabbiga yiil ee uu Xiiraam Boqor Sulaymaan u sameeyey waxay ahaayeen naxaas dhalaasha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo boqorku wuxuu alaabtaas ku shubay Bannaankii Webi Urdun oo dhoobada lahaa ee u dhexeeyey Sukod iyo Saaretaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
            "verseOrgIds": [
              "1KI.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Sulaymaanna weelashii oo dhan ma uu miisaamin, maxaa yeelay, aad iyo aad bay u badnaayeen; oo naxaasta miisaankeeda lama hubin. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
            "verseOrgIds": [
              "1KI.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Sulaymaan baa sameeyey alaabtii guriga Rabbiga tiil oo dhan, kuwaasoo ahaa girgirihii dahabka ahaa, iyo miiskii ay kibistii tusniinta saarnayd oo dahabka ahaa; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo laambadihii ahaa dahabka saafiga ah oo meesha ugu quduusan horteeda yiil, ee shanu midigta ka tiil, shanuna bidixda, iyo ubaxyadii iyo laambadihii, iyo birqaabyadii ee dahabka wada ahaa; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo koobabkii, iyo alaabta laambadihii lagu safeeya, iyo maddiibadihii, iyo malgacadihii, iyo idammadii ee dahabka saafiga ah wada ahaa, iyo birihii albaabbada guriga hoose ee ah meesha ugu wada quduusan iyo guriga macbudka ah albaabbadiisa oo dhan ee dahabka wada ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
            "verseOrgIds": [
              "1KI.7.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saasuu ku wada dhammaaday shuqulkii uu Boqor Sulaymaan ku sameeyey guriga Rabbiga. Oo Sulaymaanna wuxuu soo geliyey alaabtii aabbihiis Daa'uud quduuska ka dhigay ee ahayd lacagtii, iyo dahabkii, iyo weelashii, oo wuxuu ku riday khasnadihii guriga Rabbiga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.51",
            "verseOrgIds": [
              "1KI.7.51"
            ]
          }
        }
      ]
