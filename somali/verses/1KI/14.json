          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rexabcaam iyo Yaaraabcaamna dagaal baa ka dhexayn jiray had iyo goorba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
