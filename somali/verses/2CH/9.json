              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Sulaymaan afartan sannadood ayuu reer binu Israa'iil oo dhan Yeruusaalem boqor ugu ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
