{
  "id": "2CH.13",
  "number": "13",
  "bookId": "2CH",
  "reference": "Taariikhdii Labaad 13",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
