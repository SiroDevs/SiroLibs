{
  "id": "2CH.21",
  "number": "21",
  "bookId": "2CH",
  "reference": "Taariikhdii Labaad 21",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yehooshaafaadna wuu dhintay oo la seexday awowayaashiis, oo waxaa awowayaashiis lagula aasay magaaladii Daa'uud, oo meeshiisiina waxaa boqor ka noqday wiilkiisii Yehooraam. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isna wuxuu lahaa walaalo oo ahaa ilma Yehooshaafaad, waana Casaryaah, iyo Yexii'eel, iyo Sekaryaah, iyo Casaryaah, iyo Miikaa'eel, iyo Shefatyaah, oo intaas oo dhammu waxay ahaayeen ilma Yehooshaafaad kii ahaa boqorkii dalka Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.2",
            "verseOrgIds": [
              "2CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo aabbahoodna wuxuu iyagii siiyey hadiyado waaweyn oo ah lacag, iyo dahab, iyo waxyaalo qaali ah, oo weliba wuxuu ugu daray magaalooyin deyr leh oo dalka Yahuudah ku yaal, laakiinse boqortooyadii wuxuu siiyey Yehooraam, maxaa yeelay, wuxuu ahaa curadkiisii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooraam, Boqorkii Yahuudah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Yehooraam markuu boqortooyadii aabbihiis fuulay oo uu aad u xoogaystay ayuu walaalihiis oo dhan seef ku laayay, iyaga iyo kuwo kale oo ah amiirradii dadka Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yehooraam markuu boqor noqday wuxuu jiray laba iyo soddon sannadood, siddeed sannadoodna boqor buu ku ahaa Yeruusaalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu ku socday jidkii ay boqorradii dalka Israa'iil mareen, sidii reerkii Axaab yeelay oo kale, waayo, wuxuu qabay Axaab gabadhiisii, oo wuxuu sameeyey wax Rabbiga hortiisa shar ku ah. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habase yeeshee Rabbigu ma uu doonaynin inuu baabbi'iyo reerkii Daa'uud, maxaa yeelay, axdi wuu la dhigtay, oo wuxuu u ballanqaaday inuu isaga iyo carruurtiisa had iyo goorba laambad siiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wakhtigiisii ayaa reer Edom ka fallaagoobay dadka Yahuudah, oo iyana waxay yeesheen boqor u taliya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yehooraam soo gudbay isagoo wata saraakiishiisii iyo gaadhifardoodkiisii oo dhan, oo intuu habeennimo kacay ayuu laayay reer Edom oo hareereeyey isaga iyo saraakiishiisii gaadhifardoodka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reer Edomna way ka fallaagoobeen oo way ka hoos baxeen gacantii dadka Yahuudah ilaa maantadan la joogo. Oo haddana isla markaasba waxaa kaloo ka fallaagoobay oo gacantiisii ka hoos baxay reer Libnaah, maxaa yeelay, isagu wuxuu ka tegey Rabbigii ahaa Ilaaha awowayaashiis. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba wuxuu buuraha dalka Yahuudah ka sameeyey meelo sarsare, oo dadkii Yeruusaalem degganaana wuxuu ka dhigay inay sanamyo raacaan, oo dadkii Yahuudahna wuu habaabiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa isagii u timid qorniin laga keenay Nebi Eliiyaah, oo leh, Rabbiga aabbahaa Daa'uud Ilaahiisa ahu wuxuu leeyahay, Adigu kuma aadan socon jidadkii aabbahaa Yehooshaafaad maray iyo jidadkii Aasaa oo boqorka dalka Yahuudah ahaa uu maray toona, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse waxaad ku socotay jidkii boqorrada dalka Israa'iil, oo dadkii Yahuudah iyo dadkii Yeruusaalem degganaaba waxaad ka dhigtay inay sanamyo raacaan sidii reerkii Axaab yeelay oo kale, oo weliba waxaad laysay walaalahaa oo reerka aabbahaa ka mid ahaa oo kaa wanaagsanaa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "haddaba sidaas daraaddeed bal eeg, Rabbigu belaayo weyn ayuu ku dhufan doonaa dadkaaga, iyo carruurtaada, iyo naagahaaga, iyo xoolahaaga oo dhanba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo adigana waxaa kugu dhici doona cudur weyn oo xiidmahaaga ayaa bukan doona, ilaa xiidmahaagu ay kaa soo dhacaan maalin ka maalin cudurka aad qabto daraaddiis. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu wuxuu Yehooraam ku soo kiciyey reer Falastiin iyo reer Carabta oo ag joogay reer Itoobiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay ku soo kaceen dalka Yahuudah, oo way burburiyeen, waxayna wada qaateen maalkii guriga boqorka yiil oo dhan, iyo weliba wiilashiisii iyo naagihiisii, sidaas daraaddeed wiilna uma hadhin isagii kii wiilashiisa ugu yaraa oo Yehoo'aaxaas la odhan jiray mooyaane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaas oo dhan dabadood Rabbigu wuxuu isaga xiidmihiisii ku dhuftay cudur aan la bogsiin karin. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wakhtigii waa iska socday, oo laba sannadood dabadood waxay noqotay in xiidmihiisii la soo dhacay cudurkii uu qabay daraaddiis, oo wuxuu u dhintay cudurro xunxun. Oo dadkiisiina isaga dab uguma ay shidin siday awowayaashiis dab ugu sharfi jireen oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markuu boqor noqday wuxuu jiray laba iyo soddon sannadood, oo Yeruusaalemna boqor buu ku ahaa siddeed sannadood, oo wuxuu tegey oo dhintay isagoo aan la jeclayn, oo waxaa lagu aasay magaalada Daa'uud, laakiinse laguma aasin qabuurihii boqorrada.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
      ]
    }
  ],
