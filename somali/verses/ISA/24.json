{
  "id": "ISA.24",
  "number": "24",
  "bookId": "ISA",
  "reference": "Ishacyaah 24",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
