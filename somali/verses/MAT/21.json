          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadaaddadii sare iyo Farrisiintii goortay masaalladiisii maqleen waxay garteen inuu iyagu ka hadlay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goortay dooneen inay qabtaan ayay dadkii badnaa ka baqeen, waayo, waxay u haysteen nebi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
