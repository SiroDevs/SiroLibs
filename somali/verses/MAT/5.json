{
  "id": "MAT.5",
  "number": "5",
  "bookId": "MAT",
  "reference": "Matayos 5",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MAT 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wacdigii Ciise Dadka ku Wacdiyey Markuu Buurta Joogay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markuu dadkii badnaa arkay ayuu buur fuulay, markaasuu fadhiistay oo xertiisa ayaa u timid. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.1",
            "verseOrgIds": [
              "MAT.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasuu afkiisa kala qaaday oo wax baray, isagoo leh.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.2",
            "verseOrgIds": [
              "MAT.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwa Barakaysan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.2",
            "verseOrgIds": [
              "MAT.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa xagga ruuxa ka masaakiin ah, waayo, boqortooyada jannada iyagaa leh. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.3",
            "verseOrgIds": [
              "MAT.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa baroorta, waayo, waa la qalbiqabowjin doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.4",
            "verseOrgIds": [
              "MAT.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa camal qabow, waayo, dhulkay dhaxli doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.5",
            "verseOrgIds": [
              "MAT.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa xaqnimada u gaajaysan oo u harraadsan, waayo, way dhergi doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.6",
            "verseOrgIds": [
              "MAT.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa naxariista leh, waayo, waa loo naxariisan doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.7",
            "verseOrgIds": [
              "MAT.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa qalbiga ka daahirsan, waayo, Ilaah bay arki doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.8",
            "verseOrgIds": [
              "MAT.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa nabadda ka shaqeeyaa, waayo, waxaa loogu yeedhi doonaa wiilashii Ilaah. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan kuwa xaqnimada aawadeed loo silciyo, waayo, boqortooyada jannada iyagaa leh. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.10",
            "verseOrgIds": [
              "MAT.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waad barakaysan tihiin goortii laydin caayo, oo laydin silciyo, oo wax walba oo xun oo been ah laydinka sheego aawaday. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.11",
            "verseOrgIds": [
              "MAT.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farxa oo reyreeya, waayo, jannada abaalgudkiinnu waa ku weyn yahay, waayo, sidaasay u silcin jireen nebiyadii idinka horreeyey.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wixii Laga Bartay Cusbo iyo Laambad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idinku waxaad tihiin cusbadii dhulka, laakiin haddii cusbadu dhadhan beesho, maxaa lagu cusbaynayaa? Dabadeed waxba tari mayso in dibadda loo tuuro oo dadku ku tunto maahee. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.13",
            "verseOrgIds": [
              "MAT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idinku waxaad tihiin iftiinkii dunida. Magaalo buur ku taallu ma qarsoomi karto. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.14",
            "verseOrgIds": [
              "MAT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilays looma shido in la hoos geliyo weel, laakiin waxaa la saaraa meeshii ilayska, oo wuu u iftiimaa kuwa guriga ku jira oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.15",
            "verseOrgIds": [
              "MAT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas oo kale iftiinkiinnu dadka hortiisa ha iftiimo, si ay shuqulladiinna wanaagsan u arkaan, oo ay Aabbihiinna jannada ku jira u ammaanaan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sharcigii Hore iyo Sharciga Ciise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha u malaynina inaan u imid inaan sharciga ama qorniintii nebiyada baabbi'iyo; uma aan iman inaan baabbi'iyo, laakiin waxaan u imid inaan wada oofiyo ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.17",
            "verseOrgIds": [
              "MAT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runtii waxaan idinku leeyahay, Intaan cirka iyo dhulku idlaan, xaraf ama dhibic keliya ka idlaan mayso sharciga ilaa ay wada noqdaan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.18",
            "verseOrgIds": [
              "MAT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaa darteed kii jebiya qaynuunnadan kuwa ugu yar midkood, oo sidaas dadka u bara, waxaa loogu yeedhi doonaa kan uga yar boqortooyadii jannada, laakiin kii yeela oo bara, waxaa loogu yeedhi doonaa kan weyn boqortooyadii jannada. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.19",
            "verseOrgIds": [
              "MAT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, waxaan idinku leeyahay, Xaqnimadiinnu haddaanay ka badnaan tan culimada iyo Farrisiinta, geliba maysaan boqortooyadii jannada.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cadhada iyo Dhiigqabidda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waad maqasheen in kuwii hore lagu yidhi, Waa inaanad dhiig qabin; kii dhiig qabaa wuxuu galabsadaa xukunka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.21",
            "verseOrgIds": [
              "MAT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin waxaan idinku leeyahay, Mid walba oo walaalkiis u cadhoodaa wuxuu galabsadaa xukunka, oo kii walaalkiis ku yidhaahda, Nacas yahow, wuxuu galabsadaa in shirka la geeyo, oo kii yidhaahda, Doqon yahow, wuxuu galabsadaa jahannamada dabka ah. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.22",
            "verseOrgIds": [
              "MAT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba haddaad hadiyaddaada meesha allabariga keento, oo meeshaas aad ku xusuusatid in walaalkaa wax kuu haysto, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.23",
            "verseOrgIds": [
              "MAT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "hadiyaddaada ku dhaaf meeshii allabariga horteeda, tag, oo horta walaalkaa la soo heshii, dabadeed kaalay oo hadiyaddaada bixi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.24",
            "verseOrgIds": [
              "MAT.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaqso cadowgaaga ula heshii intaad jidka kula socoto, si aan cadowgu xaakinka kuugu dhiibin, xaakinkuna askariga kuugu dhiibin, oo xabsi lagugu tuurin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.25",
            "verseOrgIds": [
              "MAT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runtii waxaan kugu leeyahay, Halkaas ka soo bixi maysid ilaa aad siisid beesadda ugu dambaysa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daahirla'aanta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waad maqasheen in la yidhi, Waa inaanad sinaysan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin waxaan idinku leeyahay, Nin walba oo qof dumar ah damac u eegaa, durba qalbigiisuu kaga sinaystay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddii ishaada midig ku xumayso, iska bixi oo iska tuur, waayo, waxaa kuu wanaagsan in xubnahaaga mid kaa lunto intii jidhkaaga oo dhan jahannamada lagu tuuri lahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.29",
            "verseOrgIds": [
              "MAT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gacantaada midig hadday ku xumayso, iska jar oo iska tuur, waayo, waxaa kuu wanaagsan in xubnahaaga mid kaa lunto intii jidhkaaga oo dhan jahannamada geli lahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaana la yidhi, Ku alla kii naagtiisa furaa, warqaddii furniinka ha siiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.31",
            "verseOrgIds": [
              "MAT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin waxaan idinku leeyahay, Mid walba oo naagtiisa furaa sababta sinada aawadeed maahee, wuxuu ka dhigayaa inay sinaysato, oo kii guursadaa tii la furayna waa sinaystaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhaaraha iyo Runsheegidda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
