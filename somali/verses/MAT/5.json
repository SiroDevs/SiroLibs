          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waad maqasheen in la yidhi, Il il ha loo rido, iligna ilig ha loo rido. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.38",
            "verseOrgIds": [
              "MAT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin waxaan idinku leeyahay, Sharka ha hor istaagina, laakiin ku alla kii dhabanka midig kaa dharbaaxa, kan kalena u jeedi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.39",
            "verseOrgIds": [
              "MAT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo kii doonaya inuu ku ashtakeeyo oo khamiiskaaga kaa qaato, maradaadana u daa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.40",
            "verseOrgIds": [
              "MAT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo ku alla kii kugu qasba inaad mayl la socotid, laba la soco. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.41",
            "verseOrgIds": [
              "MAT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii wax kaa barya, sii, oo kii doonaya inuu wax kaa amaahdo ha ka sii jeesan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jacaylka iyo Dabeecadda Daahirka ah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
