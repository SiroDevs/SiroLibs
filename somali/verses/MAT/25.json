            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu kuwa bidixdiisa jooga ku odhan doonaa, Kuwa yahow inkaaranu, iga taga oo gala dabka weligiis ah kan Ibliiska iyo malaa'igihiisa loo diyaargareeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, waan gaajooday, cuntona ima aydnaan siin, waan harraadsanaa, imana aydnaan waraabin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qariib baan ahaa, imana aydnaan soo dhowayn, waan qaawanaa, dharna ima aydnaan huwin, waanan bukay oo xabsi ku jiray oo ima aydnaan soo booqan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyaguna markaasay u jawaabi doonaan oo ku odhan doonaan, Sayidow, goormaannu ku aragnay adigoo gaajaysan ama harraadsan ama qariib ah ama qaawan ama buka ama xabsi ku jira oo aannu ku kalmayn waynay? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu u jawaabi doonaa oo ku odhan doonaa, Runtii waxaan idinku leeyahay, In alla intaad u samayn weydeen mid ka mid ah kuwan u yaryar, anigana waad ii samayn weydeen. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanuna waxay geli doonaan taqsiirta weligeed ah, kuwa xaqa ahuse waxay geli doonaan nolosha weligeed ah.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
