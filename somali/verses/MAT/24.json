            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soo Jeedid Baa Loo Baahan Yahay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddeer geedka berdaha ah masaal ka garta. Intii laantiisu curdan tahay oo caleemo bixinayso, waxaad garanaysaan inuu roobku dhow yahay. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.32",
            "verseOrgIds": [
              "MAT.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idinkuna sidaas oo kale goortaad waxan oo dhan aragtaan, garta inuu dhow yahay oo albaabbada ag joogo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.33",
            "verseOrgIds": [
              "MAT.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runtii waxaan idinku leeyahay, Qarniganu ma idlaan doono intaanay waxan oo dhammi dhicin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.34",
            "verseOrgIds": [
              "MAT.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cirka iyo dhulku waa idlaan doonaan, laakiinse ereyadaydu ma idlaan doonaan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin maalintaas iyo saacaddaas ninna waxba kama oga, malaa'igaha jannada iyo Wiilka toona, midna ma oga, Aabbahay keliya maahee. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.36",
            "verseOrgIds": [
              "MAT.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sida wakhtigii Nuux ahaa, sidaas oo kale ayaa imaatinka Wiilka Aadanahu ahaan doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.37",
            "verseOrgIds": [
              "MAT.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, siday wax u cunayeen oo wax u cabbayeen, oo u guursanayeen oo loogu guurinayay maalmihii daadka hortiisa ilaa maalintii Nuux doonnida galay, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.38",
            "verseOrgIds": [
              "MAT.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayna garan waayeen ilaa daadkii yimid oo kulligood wada qaaday, sidaas oo kale ayaa imaatinka Wiilka Aadanahu ahaan doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.39",
            "verseOrgIds": [
              "MAT.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaas laba nin ayaa beerta ku jiri doona, mid waa la qaadi doonaa, midna waa laga tegi doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.40",
            "verseOrgIds": [
              "MAT.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba naagood ayaa dhagax wax ku shiidi doona, mid waa la qaadi doonaa, midna waa laga tegi doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba soo jeeda, waayo, ma aad ogidin maalinta Rabbigiinnu imanayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.42",
            "verseOrgIds": [
              "MAT.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin tan ogaada, odayga reerku hadduu ogaan lahaa wakhtiga tuuggu imanayo, wuu soo jeedi lahaa, oo ma uu daayeen in gurigiisa la jebiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.43",
            "verseOrgIds": [
              "MAT.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaa darteed idinkuna diyaar ahaada, waayo, saacad aydnaan u malaynaynin ayaa Wiilka Aadanahu imanayaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masaalka Ku Saabsan Addoommadii Aaminka Ahaa iyo Kuwii Aan Aaminka Ahayn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba yuu yahay addoonka aaminka ah oo caqliga leh, kan sayidkiisu dadka gurigiisa u sarreeysiiyey inuu cuntada siiyo wakhtigeeda? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.45",
            "verseOrgIds": [
              "MAT.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa barakaysan addoonkaas kan sayidkiisu goortuu yimaado uu helayo isagoo sidaas samaynaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.46",
            "verseOrgIds": [
              "MAT.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runtii waxaan idinku leeyahay, Wuxuu leeyahay oo dhan ayuu ka sarreeysiin doonaa isaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.47",
            "verseOrgIds": [
              "MAT.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin haddii addoonkaas sharka leh qalbigiisa ka yidhaahdo, Sayidkaygu waa raagay, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.48",
            "verseOrgIds": [
              "MAT.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo uu bilaabo inuu garaaco kuwii la shaqayn jiray, oo uu wax la cuno oo wax la cabbo kuwa sakhraanka ah, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.49",
            "verseOrgIds": [
              "MAT.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "addoonkaas sayidkiisu wuxuu iman doonaa maalin aanu filayn iyo saacad aanu ogayn, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.50",
            "verseOrgIds": [
              "MAT.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waa kala jeexi doonaa oo wuxuu ka dhigi doonaa mid qayb la hela labawejiilayaasha. Halkaa waxaa jiri doonta baroor iyo ilko jirriqsi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.51",
            "verseOrgIds": [
              "MAT.24.51"
            ]
          }
        }
      ]
    }
