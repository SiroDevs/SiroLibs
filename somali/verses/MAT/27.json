          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba amar in xabaashii aad loo dhawro ilaa maalinta saddexaad inaan xertiisu iman oo xadin oo aanay dadka ku odhan, Kuwii dhintay wuu ka soo sara kacay, oo aanay khiyaanada dambe ka sii xumaan tii hore. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.64",
            "verseOrgIds": [
              "MAT.27.64"
            ]
          }
        },
        {
          "name": "verse",
