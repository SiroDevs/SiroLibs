              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxay ku yidhaahdeen, Sayidow, waxaannu xusuusan nahay in khaa'inkaasu yidhi, intuu weli noolaa, Saddex maalmood dabadeed waan soo sara kacayaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.63",
            "verseOrgIds": [
              "MAT.27.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
