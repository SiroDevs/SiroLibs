          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay tageen, iyaga iyo waardiyayaashii, oo xabaashay soo adkeeyeen, dhagixiina way shaabadeeyeen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.66",
