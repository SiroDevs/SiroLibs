          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilaatos wuxuu ku yidhi, Waardiyayaal baad leedihiin. Taga oo adkeeya in alla intaad adkayn taqaaniin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.65",
            "verseOrgIds": [
              "MAT.27.65"
            ]
          }
        },
        {
