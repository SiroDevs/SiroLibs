              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ii kaalaya kulligiin kuwiinna hawshaysan oo culaabaysanow, oo anigu waan idin nasin doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
