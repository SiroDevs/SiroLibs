  "bookId": "GEN",
  "reference": "Bilowgii 21",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "GEN 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhalashadii Isxaaq",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu Saarah wuu soo booqday siduu yidhi, oo Rabbigu wuxuu Saarah u yeelay siduu kula hadlay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Saarah way uuraysatay, oo Ibraahim wiil bay u dhashay isagoo da' weyn, waxayna ahayd wakhtigii Ilaah kala hadlay isaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Ibraahim wuxuu wiilkiisii u dhashay, oo Saarah u dhashay isaga, u bixiyey Isxaaq. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Ibraahim baa guday wiilkiisii Isxaaq markuu siddeed maalmood jiray, sidii Ilaah ku amray isaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Ibraahimna wuxuu jiray boqol sannadood, markii wiilkiisii Isxaaq u dhashay isaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saarahna waxay tidhi, Ilaah waa iga qosliyey, qof kasta oo maqlaana waa ila qosli doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay tidhi, Yaa Ibraahim ku odhan lahaa, Saarah carruur bay nuujin doontaa? Waayo, wiil baan u dhalay isaga oo da' weyn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haagaar Iyo Ismaaciil Oo La Eriyey",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilkiina wuu koray, naaskiina waa laga gudhiyey. Ibraahimna diyaafad weyn buu sameeyey maalintii Isxaaq naaska laga gudhiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saarahna waxay aragtay wiilkii ay Haagaar tii Masriyadda ahayd Ibraahim u dhashay oo ku cayaaraya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed waxay Ibraahim ku tidhi, Eri addoontan iyo wiilkeedaba: maxaa yeelay, wiilka addoontanu wax la dhaxli maayo wiilkayga Isxaaq ah. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaasuna Ibraahim aad buu ula xumaa xagga wiilkiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaahna wuxuu Ibraahim ku yidhi, Yaanay kula xumaan wiilka dartiis, iyo naagta addoonta ah toona. Wax alla wixii Saarah kugu tidhaahdo, hadalkeeda maqal; waayo, farcankaaga Isxaaq baa loogu yeedhi doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilka addoontana waxaan ka dhigi doonaa quruun, waayo, isna waa farcankaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibraahimna aroortii horuu kacay, wuxuuna qaaday cunto iyo sibraar biyo ah, oo Haagaar buu siiyey intuu garbaha u saaray, wiilkiina wuu siiyey, markaasuu eryay: wayna iska tagtay, oo ku wareegtay cidladii Bi'ir Shebac. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyihii sibraarka ku jirayna way dhammaadeen, kolkaasay ilmihii ku xoortay geedihii midkood hoostiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayna tagtay oo waxay fadhiisatay meel ku soo jeedda oo ka fog, oo qiyaastii ah intii fallaadh la ganay gaadho, waxayna tidhi, Yaanan eegin dhimashada wiilka. Iyadoo fadhida meel ku soo jeedda ayay codkeedii kor u qaadday oo ooyday. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaah baana maqlay codkii wiilka; malaa'igtii Ilaahna Haagaar bay samada uga yeedhay, oo waxay ku tidhi, Haagaaray, maxaa ku helay? Ha baqin; waayo, Ilaah waa maqlay codkii wiilka, meeshuu joogo isagu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kac oo wiilka toosi, oo gacantaada ku hay; maxaa yeelay, quruun weyn baan ka dhigi doonaa isaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Ilaah indhaheedii furay, oo waxay aragtay ceel biyo ah; kolkaasay tagtay, oo sibraarkii biyo ka soo buuxisay, oo wiilkii waraabisay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaahna wiilkii buu la jiray; wuuna koray; oo cidladuu degay, wuxuuna noqday qaansoole. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.20",
            "verseOrgIds": [
              "GEN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuxuuna degay cidladii Faaraan: hooyadiis baana dhulka Masar naag uga qaadday.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Axdigii Bi'ir Shebac",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxayna noqotay wakhtigaas in Abimeleg iyo Fiikol oo ahaa madaxda ciidankiisa ay la hadleen Ibraahim iyagoo leh, Ilaah waa kugula jiraa waxa aad samayso oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba halkan Ilaah iigu dhaaro inaadan i khiyaanaynin aniga ama wiilkayga, ama wiilkayga wiilkiisa, laakiinse sidii aan wanaagga kuugu sameeyey, inaad adna iigu samaynaysid, aniga iyo dhulka aad qariib ahaanta u degganaydba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibraahimna wuxuu yidhi, Waan kuu dhaaran doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibraahimse wuxuu Abimeleg u canaantay ceelkii ay addoommada Abimeleg ka xoogeen aawadiis. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimelegna wuxuu yidhi, Anigu garan maayo ka waxaas sameeyey; adna iima aad sheegin, welina ma aan maqlin, maanta mooyaane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.26",
            "verseOrgIds": [
              "GEN.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Ibraahim ido iyo dibiyo kaxeeyey, oo wuxuu siiyey Abimeleg; labadoodiina axdi bay dhigteen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.27",
            "verseOrgIds": [
              "GEN.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasaa Ibraahim idihii gooni ahaan uga bixiyey toddoba sabeenood. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.28",
            "verseOrgIds": [
              "GEN.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimelegna wuxuu Ibraahim ku yidhi, Micnehoodu waa maxay toddobadan sabeenood oo aad gooni ahaantooda u bixisay? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu yidhi, Toddobadan sabeenood waa inaad iga guddoontid inay markhaati ii noqoto inaan anigu ceelkan qoday. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed meeshaas wuxuu u bixiyey Bi'ir Shebac; maxaa yeelay, labadooduba meeshaas bay ku dhaarteen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed axdi bay ku dhigteen Bi'ir Shebac; markaasaa Abimeleg kacay, isaga iyo Fiikol oo ahaa madaxda ciidankiisa, oo waxay ku noqdeen dhulkii reer Falastiin. ",
