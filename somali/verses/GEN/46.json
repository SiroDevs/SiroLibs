              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markii Fircoon idiin yeedho, oo idinku yidhaahdo, Shuqulkiinnu waa maxay? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
