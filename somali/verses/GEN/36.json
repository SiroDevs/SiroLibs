          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanuna waa magacyadii ugaasyadii Ceesaw dhalay, siday ahaayeen qabiilooyinkoodii iyo magacyadii meelahoodii ay degganaan jireen, waana ugaas Timnac, iyo ugaas Calwah, iyo ugaas Yeteed, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
