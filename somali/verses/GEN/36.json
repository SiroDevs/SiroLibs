              "type": "text"
            }
          ]
        },
        {
          "text": "iyo ugaas Qenas, iyo ugaas Teemaan, iyo ugaas Mibsaar; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
