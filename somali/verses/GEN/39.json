{
  "id": "GEN.39",
  "number": "39",
  "bookId": "GEN",
  "reference": "Bilowgii 39",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
