              "ZEP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba reer Itoobiyow, idinkana waxaa laydinku layn doonaa seeftayda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.12",
            "verseOrgIds": [
              "ZEP.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Digniin Ka Gees Ah Ashuur",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.12",
            "verseOrgIds": [
              "ZEP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isagu gacantiisuu u fidin doonaa xagga woqooyi, oo dalka Ashuur wuu wada baabbi'in doonaa, oo Ninewehna cidla buu ka dhigi doonaa iyo lamadegaan engegan. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.13",
            "verseOrgIds": [
              "ZEP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa dhexdeeda jiifsan doona xoolo iyo xayawaanka quruumaha oo dhan, oo cantalyaaga iyo caanaqubtuba waxay ku dhex hoyan doonaan tiirarkeeda. Cod baa ka gabyi doona daaqadaheeda, oo waxaa marinnada joogi doona abaar, waayo, isagu wuu soo ban dhigay shuqulkii qoriga kedarka ah laga qabtay. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanu waa magaaladii faraxa badnayd oo feyigla'aanta ku degganayd, oo qalbiga iska tidhi, Anigaa ah, oo aniga mooyaane mid kale ma jirto. Waxay noqotay cidla iyo meel dugaag ku hoydo! Mid kasta oo agteeda soo maraaba wuu ku foodhyi doonaa oo gacanta quudhsasho la ruxi doonaa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.15",
            "verseOrgIds": [
              "ZEP.2.15"
            ]
          }
        }
      ]
    }
