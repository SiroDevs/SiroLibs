            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isa soo urursada, quruuntan aan xishoodka lahaynay, isa soo urursada, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "intaan amarku soo bixin, oo aan maalintu u dhaafin sida xaab oo kale, intaan Rabbiga xanaaqiisa kululu idinku soo degin, intaan maalinta cadhada Rabbigu idinku soo degin. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbiga doondoona, dhammaantiin kuwiinna camalka qabow ee dhulkow, oo xukunkiisa yeelayow, xaqnimo doondoona, oo qabownaan doondoona. Waxaa laga yaabaa inaad maalinta cadhada Rabbiga qarsoonaan doontaan.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Digniin Ka Gees Ah Reer Falastiin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
