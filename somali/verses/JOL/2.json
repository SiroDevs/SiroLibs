          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaan samooyinka iyo dhulkaba ka muujin doonaa yaabab, kuwaasoo ah dhiig, iyo dab, iyo tiirar qiiq ah. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.30",
            "verseOrgIds": [
              "JOL.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
