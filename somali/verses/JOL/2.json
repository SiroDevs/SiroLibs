          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo weliba maalmahaas addoommada rag iyo dumarba ruuxaygaan ku shubi doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.29",
            "verseOrgIds": [
              "JOL.2.29"
            ]
          }
        },
        {
          "name": "verse",
