        "style": "s1"
      },
      "items": [
        {
          "text": "Haaruun Iyo Wiilashiisii Oo La Caleemasaaray",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu Muuse la hadlay oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaad keentaa Haaruun iyo wiilashiisa oo isaga la jira, iyo dharka, iyo saliidda lagu subkado, iyo dibiga ah qurbaanka dembiga, iyo labada wan, iyo dambiisha ay kibista aan khamiirka lahaynu ku jirto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ururka oo dhanna waxaad ku soo shirisaa iridda teendhada shirka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Muusena waa yeelay wixii Rabbigu isaga ku amray, oo ururkiina waa lagu soo shiriyey iridda teendhadii shirka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasaa Muuse ururkii oo dhan ku yidhi, Waxanu waa waxa Rabbigu amray in la sameeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse wuxuu soo kexeeyey Haaruun iyo wiilashiisii, oo biyuu iyagii ku maydhay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu isagii u geliyey jubbaddii, oo dhexdana wuxuu ugu xidhay dhex-xidhka, oo wuxuu u geliyey khamiiskii, eefodkiina wuu u geliyey, oo dhexdana wuxuu ugu xidhay dhex-xidhkii eefodka oo daabaca lahaa, oo kaasuu isagii ku xidhay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu isagii saaray laabgashigii, oo laabgashigiina wuxuu geliyey Uuriimkii iyo Tummiimkii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo madaxana wuxuu u saaray duub, oo duubka dhankiisa horena wuxuu ku dhejiyey waslad khafiif ah oo dahab ah oo ah taajka quduuska ah sidii Rabbigu Muuse ku amray. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse soo qaaday saliidda lagu subkado, oo wuxuu ku subkay taambuuggii iyo waxyaalihii gudihiisa ku jiray oo dhan, oo dhammaantoodna quduus buu ka dhigay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qaarkeedna wuxuu toddoba jeer ku saydhsaydhay meeshii allabariga, oo wuxuu subkay meeshii allabariga iyo weelasheedii oo dhan iyo berkeddii weysada iyo salkeedii, si uu dhammaantood quduus uga dhigo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saliidda lagu subkado qaarkeedna wuxuu ku shubay Haaruun madaxiisa, oo isagii wuu subkay si uu quduus uga dhigo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana Muuse wuxuu soo kexeeyey wiilashii Haaruun, oo wuxuu iyagii u geliyey jubbado, wuxuuna ugu xidhay dhex-xidho, duubabna wuu u duubay sidii Rabbigu Muuse ku amray. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu keenay dibigii ahaa qurbaanka dembiga, oo Haaruun iyo wiilashiisiina gacmahooday madaxa ka saareen dibigii qurbaankii dembiga ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu dibigii gowracay, oo Muuse wuxuu soo qaaday dhiiggii, oo farta ku mariyey geesihii meesha allabariga, oo meesha allabarigana sidaasuu ku daahiriyey, kolkaasuu dhiigga ku ag shubay salkii meesha allabariga, quduus buuna ka dhigay, si uu kafaaraggud ugu sameeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu qaaday kulli xaydhii uurka ku jirtay oo dhan, iyo xuubkii beerka ku dul yiil, iyo labada kelyood iyo xaydhooda, oo Muuse intaasuu ku dul gubay meesha allabariga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse dibigii iyo haraggiisii, iyo hilibkiisii, iyo uuskiisiiba wuxuu ku gubay meel xerada dibaddeeda ah sidii Rabbigu Muuse ku amray. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu keenay wankii ahaa qurbaanka la gubo, oo Haaruun iyo wiilashiisiina gacmahooday madaxa ka saareen wankii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isna wankii wuu gowracay, markaasaa Muuse dhiiggii ku dul rusheeyey hareeraha meesha allabariga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wankii xubin xubin buu u kala googooyay, markaasaa Muuse wuxuu gubay madaxii iyo xubnihii iyo xaydhii, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo isna uurkujirtii iyo addimmadii ayuu biyo ku maydhay, markaasaa Muuse wankii oo dhan ku dul gubay meesha allabariga, waayo, kaasu wuxuu ahaa qurbaan la gubo oo caraf udgoon loo bixiyo, wuxuuna ahaa qurbaan Rabbiga dab loogu sameeyo, sidii Rabbigu Muuse ku amray. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu keenay wankii kale, kaasoo ahaa wankii quduuskadhigidda, oo Haaruun iyo wiilashiisiina gacmahooday madaxa ka saareen wankii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu wankii gowracay, oo Muuse wuxuu soo qaaday dhiiggii oo wuxuu mariyey Haaruun caaradda dhegtiisa midig, iyo suulka gacantiisa midig, iyo suulka cagtiisa midig. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu keenay Haaruun wiilashiisii, kolkaasaa Muuse dhiiggii mariyey caaradda dhegahooda midig, iyo suulka gacantooda midig, iyo suulka cagtooda midig, oo Muusena wuxuu dhiiggii ku dul rusheeyey hareeraha meesha allabariga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu soo qaaday baruurtii, iyo badhidii, iyo xaydhii uurka ku jirtay oo dhan, iyo xuubkii beerka ku yiil, iyo labadii kelyood, iyo xaydhoodii, iyo bowdadii midig. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dambiishii ay kibista aan khamiirka lahaynu ku jirtay oo Rabbiga hortiisa tiilna wuxuu ka soo bixiyey xabbad ah kibis aan khamiir lahayn, iyo xabbad ah moofo saliid leh, iyo xabbad canjeero ah, oo wuxuu saaray baruurtii iyo bowdadii midig, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo intaas oo dhan ayuu saaray Haaruun gacantiisii, iyo gacantii wiilashiisa, oo sida qurbaanka la ruxruxo ayaa Rabbiga hortiisa lagu ruxruxay. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasaa Muuse gacmahoodii ka qaaday oo wuxuu qurbaankii la gubayay kula dul gubay meesha allabariga, oo waxay ahaayeen quduuskadhigidda oo caraf udgoon loo bixiyo. Taasu waxay ahayd qurbaan Rabbiga dab loogu sameeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasaa Muuse qaaday sakaarkii, oo Rabbiga hortiisa ayuu ugu ruxruxay qurbaan la ruxruxo aawadiis, oo kaasu wuxuu ahaa qaybtii Muuse ku lahaa wankii quduuskadhigidda sidii Rabbigu Muuse ku amray. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse qaaday saliiddii lagu subkado qaarkeed iyo dhiiggii meesha allabariga ku kor yiil, oo wuxuu ku kor saydhsaydhay Haaruun, iyo dharkiisii, iyo wiilashiisii, iyo dharkii wiilashiisa, oo wuxuu quduus ka dhigay Haaruun iyo dharkiisii iyo wiilashiisii iyo dharkii wiilashiisaba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse Haaruun iyo wiilashiisii ku yidhi, Hilibka waxaad ku ag karisaan iridda teendhada shirka, oo halkaas ku cuna hilibka iyo kibista dambiisha quduuskadhigidda ku jirta, sidaan u amray, oo aan u idhi, Haaruun iyo wiilashiisu waa inay cunaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo hilibka iyo kibista wixii ka hadhana waa inaad dab ku gubtaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
