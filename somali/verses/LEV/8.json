          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu wuxuu amray in la yeelo sida maantadan la yeelay, in kafaaraggud laydiin sameeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
