          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa weligiinba qaynuun idiin ahaan doona inaad bisha toddobaad maalinteeda tobnaad nafihiinna dhibtaan, oo waa inaydaan waxba shuqul qaban cayn kasta ha ahaadee, kiinna waddaniga ah iyo shisheeyaha dhexdiinna degganuba, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "waayo, maalintaas kafaaraggud baa laydiin samayn doonaa in laydin daahiriyo aawadeed, oo dembiyadiinna oo dhanna daahir baad kaga noqon doontaan Rabbiga hortiisa. ",
          "type": "text",
