      },
      "items": [
        {
          "text": "Cabbidda Dhiigga Oo La Mamnuucay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
