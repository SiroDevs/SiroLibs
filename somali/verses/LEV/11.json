              "LEV.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwaas idinku waad ku nijaasoobaysaan, oo ku alla kii baqtigooda taabtaa nijaas buu ahaanayaa tan iyo fiidkii, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24",
            "verseOrgIds": [
              "LEV.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo ku alla kii baqtigooda wax ka qaadaa waa inuu dharkiisa maydhaa, oo nijaas buu ahaanayaa tan iyo fiidkii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.25",
            "verseOrgIds": [
              "LEV.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xayawaan kasta oo raafkiisu kala jeexan yahay, oo aan qanjaafilo lahayn ama aan calyanaqsiga raamsan waa idinka nijaas, oo ku alla kii iyaga taabtaana wuu nijaasoobayaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.26",
            "verseOrgIds": [
              "LEV.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xayawaanka afarta addinba ku socda, wax alla wixii baabacooyinka ku socdaa waa idinka nijaas, oo ku alla kii baqtigooda taabtaa nijaas buu ahaanayaa tan iyo fiidkii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.27",
            "verseOrgIds": [
              "LEV.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kii baqtigooda qaadaana waa inuu dharkiisa maydhaa, oo tan iyo fiidkiina nijaas buu ahaanayaa, waayo, iyagu waa idinka nijaas.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        }
      ]
    },
