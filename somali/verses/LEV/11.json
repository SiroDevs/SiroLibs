          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxa dhulka ku gurguurta oo dhan kuwanu waa kuwa idinka nijaas ah, waana fadhanfadhka, iyo jiirka, iyo amuurka iyo caynkiisa oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
