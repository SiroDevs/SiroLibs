              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xayawaanka aad cuni kartaan midkood hadduu dhinto, kii baqtigiisa taabtaa nijaas buu ahaanayaa tan iyo fiidkii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
