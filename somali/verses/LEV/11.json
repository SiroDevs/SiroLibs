          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo ilweynta iyo maansalugaleyda, iyo qorratada, iyo mulaca, iyo jirjirroolaha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxa gurguurta oo dhan kuwaasu waa kuwa idinka nijaas ah, oo ku alla kii taabtaa markay dhintaan nijaas buu ahaan doonaa tan iyo fiidkii. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wax alla wixii ay ku dhacaan markay dhintaan, nijaas bay ahaan doonaan, hadday yihiin weel qori ah, ama dhar, ama harag, ama joonyad, weelkaasu wax kasta ha ahaadee haddii wax loogu isticmaalo waa in biyo la dhex geliyaa, oo tan iyo fiidkiina nijaas buu ahaanayaa, oo markaas dabadeedna daahir buu ahaanayaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weelkii dhoobo ah oo mid iyaga ka mid ahu gudihiisa ku dhaco, wax alla wixii weelkaas gudihiisa ku jiraaba way nijaasoobi doonaan, oo weelkiina waa inaad jebisaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxa la cuno oo ku jira oo biyo gaadhaanba way nijaasoobi doonaan, oo weelka caynkaas ah waxa la cabbo oo ku jira oo dhammuna way nijaasoobi doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wax alla wixii wax baqtigooda ahu ku dhacaanba way nijaasoobi doonaan, hadday yihiin foorno ama sholad, waa in la burburiyaa, waayo, iyagu waa nijaas, waana inay nijaas idinka ahaadaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habase yeeshee il amase god ay biyo badanu ku jiraan daahir bay ahaanayaan, laakiinse wixii baqtigooda taabtaa way nijaasoobayaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wax baqtigooda ahu hadday ku dhacaan abuur la abuurayo, kaasu waa daahir. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse abuurka haddii biyo lagu shubo oo wax baqtigooda ahu ay ku dhacaan markaas waa idinka nijaas.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
