          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wadaadku waa inuu dhiigga qaarkiis ku qaadaa fartiisa oo uu mariyaa geesaha meesha allabariga qurbaanka la gubo, oo dhiiggana waa inuu ku ag shubaa salka meesha allabariga qurbaanka la gubo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
