              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddaan la soo furan intii sannad dhan ah, markaas gurigii magaalada deyran ku yiil waa inuu weligii hanti u ahaadaa qofkii iibsaday, oo tan iyo ab ka ab isagaa iska leh, oo sannadda yubilii ahna gacantiisa ka bixi maayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse guryaha ku dhex yaal tuulooyinka aan lahayn deyr ku wareegsan ha lagu tiriyo beeraha duurka ku yaal, oo iyaga waa la soo furan karaa, oo sannadda yubilii ahna gacanta kii iibsaday way ka bixi doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habase yeeshee magaalooyinka reer Laawi saas ma aha, oo reer Laawi mar kasta way soo furan karaan guryaha ku dhex yaal magaalooyinka ay iyagu hantida u leeyihiin. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo mid reer Laawi ahu hadduu soo furto, markaas gurigii la iibiyey iyo magaaladii hantidiisa ahaydba waxay bixi doonaan wakhtiga yubilii ah, waayo, guryaha ku dhex yaal magaalooyinka reer Laawi waa hantidooda oo ku dhex jirta reer binu Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waa inaan la iibin beertii ku taal agagaarka magaalooyinkooda, waayo, taasu waa hantidooda weligeed ah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
