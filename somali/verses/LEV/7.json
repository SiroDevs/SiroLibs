          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii reer Haaruun ka mid ah oo bixiya dhiigga qurbaannada nabaadiinada iyo baruurta ayaa qayb ahaan u leh bowdada midig. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
