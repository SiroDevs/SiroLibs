          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo allabariga ah qurbaannadiinna nabaadiinada waxaad ka soo bixisaan bowdada midig oo waa inaad wadaadka siisaan, ha ahaatee qurbaan sare loo qaado. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
