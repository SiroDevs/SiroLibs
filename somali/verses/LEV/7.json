          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wadaadku waa inuu baruurta ku dul gubaa meesha allabariga, laakiinse sakaarka waxaa iska leh Haaruun iyo wiilashiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
