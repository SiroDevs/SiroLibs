            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbigu wuxuu Muuse uga yeedhay teendhadii shirka oo intuu la hadlay ayuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reer binu Israa'iil la hadal oo waxaad ku tidhaahdaa, Markii nin idinka mid ahu uu Rabbiga qurbaan u bixinayo, qurbaankiinna waxaad ka bixisaan xoolaha, kuwaasoo ah lo'da iyo idaha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii qurbaankiisu yahay qurbaan la gubo oo lo' ah, waa inuu bixiyaa neef lab oo aan iin lahayn, oo waa inuu ku bixiyaa teendhada shirka iriddeeda, si isaga Rabbiga hortiisa loogu aqbalo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inuu gacanta saaraa madaxa neefka qurbaanka la gubayo, oo waxaa loo aqbali doonaa inuu isaga u ahaado kafaaraggud. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dibiga waa inuu Rabbiga hortiisa ku gowraco, oo wiilasha Haaruun oo wadaaddada ahu waa inay dhiigga keenaan, oo ay dhiigga ku dul rusheeyaan hareeraha meesha allabariga ee teendhada shirka horteeda taal. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo neefka qurbaanka la gubayo waa inuu haragga ka bixiyaa, oo haddana waa inuu xubin xubin u googooyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wiilasha Haaruun oo wadaaddada ahu waa inay meesha allabariga dab ku shubaan oo haddana waa inay qoryo ku dul hagaajiyaan dabka, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo markaas wiilasha Haaruun oo wadaaddada ahu xubnaha iyo madaxa iyo baruurta ha ku dul hagaajiyeen qoryaha dabka meesha allabariga saaran, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse neefka uurkujirtiisa iyo addimmadiisa biyo ha ku maydho, oo wadaadku meesha allabariga dusheeda dhammaantiis ha ugu gubo qurbaan la gubo oo ah qurbaan dab lagu sameeyo oo Rabbiga caraf udgoon u ah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
