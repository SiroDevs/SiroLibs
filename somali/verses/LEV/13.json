          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii timihiisu ay foodda hore ka dhammaadaanna, isagu foodda horuu bidaar ku leeyahay, hase ahaatee waa daahir. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse madaxa bidaarta leh ama foodda bidaarta leh haddii lagu arko cudur guduudan oo caddaan ku jiro, markaas waa baras ka soo baxay madaxiisii bidaarta lahaa ama fooddiisii bidaarta lahayd. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
