          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "isagu waa nin baras qaba, oo waa nijaasaysan yahay, oo sida xaqiiqada ah wadaadku waa inuu yidhaahdaa, Ninkanu waa nijaasaysan yahay; oo cudur buu madaxa ka qabaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
