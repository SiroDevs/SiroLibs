          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii nin madaxiisa ay timahu ka dhammaadaan, isagu wuxuu leeyahay bidaar, hase ahaatee waa daahir. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
