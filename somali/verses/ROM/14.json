{
  "id": "ROM.14",
  "number": "14",
  "bookId": "ROM",
  "reference": "Rooma 14",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "ROM 14"
      },
      "items": [
        {
          "text": "14",
