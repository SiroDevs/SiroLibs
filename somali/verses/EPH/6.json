  "reference": "Efesos 6",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EPH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Carruurtay, waalidkiinna ku addeeca xagga Rabbiga, waayo, taasu waa qumman tahay. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaynuunkii kowaad oo ballan la jiraa waa kan, Aabbahaa iyo hooyadaa maamuus ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.2",
            "verseOrgIds": [
              "EPH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inaad nabdoonaatid oo cimrigaagu ku dheeraado dhulka. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabbayaashow, carruurtiinna ha ka cadhaysiinina, laakiinse waxaad ku korisaan edbinta iyo waanada Rabbiga.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addoommadow, kuwa xagga jidhka sayidyadiinna ah ku addeeca cabsi iyo gariir iyo qalbi daacad ah sidaad Masiixa uga cabsataan oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ahaanina kuwo markii loo jeedo oo keliya shaqeeya sida kuwa dadka ka farxiya, laakiinse ahaada sida addoommada Masiixa, idinkoo doonista Ilaah xagga qalbiga ka samaynaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyo wanaagsan ku adeega sida idinkoo Rabbiga u adeegaya oo aan dad u adeegin, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "idinkoo garanaya wax kasta oo wanaagsan oo mid kasta sameeyo inuu Rabbiga isla waxaas ka helayo hadduu yahay addoon iyo hadduu yahay xorba. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sayidyadow, idinkuna isla waxaas iyaga u sameeya, oo cabsiinta iska daaya, waayo, waad og tihiin inuu kan ah Sayidkooda iyo kiinnaba jannada ku jiro, oo uusan dadka u kala eexan.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hubka Masiixiyiinta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugu dambaysta waxaan idinku leeyahay, Ku xoogaysta Rabbiga iyo xoogga itaalkiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo hubka Ilaah oo dhan qaata, si aad u awooddaan inaad sirta Ibliiska hor istaagtaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.11",
            "verseOrgIds": [
              "EPH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, innagu lama legdanno bini-aadan, laakiinse waxaynu la legdannaa kuwa madaxda ah iyo kuwa amarka leh iyo taliyayaasha dunida gudcurka ah iyo ruuxyada sharka ah oo samooyinka ku jira. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.12",
            "verseOrgIds": [
              "EPH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba sidaas daraaddeed hubka Ilaah qaata si aad u awooddaan inaad maalinta sharka iyaga is-hor taagtaan, oo markaad saas oo dhan yeeshaan aad awooddaan inaad istaagtaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.13",
            "verseOrgIds": [
              "EPH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba istaaga idinkoo runta dhexda ku xidhan, oo laabtana laabdhawrka xaqnimada ku xidhan, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo cagahana gashan isu-diyaarinta injiilka nabadda, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.15",
            "verseOrgIds": [
              "EPH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo weliba waxaa kaloo aad qaadataan gaashaanka rumaysadka, kaas oo aad ku awoodaysaan inaad ku wada demisaan kan sharka leh fallaadhihiisa ololaya oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.16",
            "verseOrgIds": [
              "EPH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaad qaadataan koofiyada badbaadada iyo seefta Ruuxa oo ah erayga Ilaah. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.17",
            "verseOrgIds": [
              "EPH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mar kasta Ilaah wax kaga barya Ruuxa baryo iyo duco kastaba, oo taas ku dhawra adkaysasho oo dhan iyo u-ducaynta quduusiinta oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo anigana iigu soo duceeya in lay siiyo hadal aan afka ku furo inaan cabsila'aan u muujiyo qarsoodiga injiilka, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
              "EPH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaas oo aan u ahay mid ergo ah oo silsilad ku xidhan, inaan cabsila'aan ugu hadlo sida igu waajibka ah.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhammaadka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse inaad ogaataan axwaashayda iyo sidaan ahayba, waxaa idiin wada sheegi doona Tukhikos oo xagga Rabbiga ku ah walaalkay gacaliye iyo midiidin aamin ah. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.21",
            "verseOrgIds": [
              "EPH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaan isaga idiinku soo diray isla sababtan inaad xaaladdayada ogaataan iyo inuu qalbigiinna dhiirrigeliyo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walaalaha ha u ahaadeen nabad iyo jacayl rumaysad la jiro oo xagga Ilaaha Aabbaha ah iyo Rabbi Ciise Masiix ka yimid. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulligood kuwa Rabbigeenna Ciise Masiix jacaylka aan dhammaanayn ku jecel, nimco ha u ahaato.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.24",
            "verseOrgIds": [
              "EPH.6.24"
            ]
          }
        }
      ]
    }
  ],
