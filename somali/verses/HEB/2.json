          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "sidee baynu u baxsan doonnaa haddaynu dayacno badbaadintan weyn oo Rabbigu kolkii hore ku hadlay oo kuwii maqlayna inoo xaqiiqeeyeen? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
