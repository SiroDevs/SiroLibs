              "HEB.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derbiyadii Yerixoo rumaysad bay ku dumeen kolkii toddoba maalmood lagu warwareegay dabadeed. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.30",
            "verseOrgIds": [
              "HEB.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhilladii Raxab rumaysadkeedii aawadiis lama ay halligmin kuwii caasiyiinta ahaa, maxaa yeelay, basaasyadii bay nabad ku dhowaysay.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo maxaan kale oo idhaahdaa? Waayo, wakhtigu waa igu gaabnaan doonaa haddaan wax ka sheegi lahaa Gidcoon, iyo Baaraaq, iyo Samsoon, iyo Yeftaah, iyo Daa'uud, iyo Samuu'eel iyo nebiyadii. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumaysad bay kaga adkaadeen boqortooyooyin, oo xaqnimo ku sameeyeen, oo ballamo ku heleen, oo afafka libaaxyada ku xidheen, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.33",
            "verseOrgIds": [
              "HEB.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo xooggii dabka ku demiyeen, oo seefta afkeedii kaga baxsadeen, oo itaaldarradii kaga xoogaysteen, oo dagaal ku itaal weynaadeen, oo colalkii shisheeyaha ku eryeen. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.34",
            "verseOrgIds": [
              "HEB.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dumar baa waxay heleen kuwii ka dhintay iyagoo la sara kiciyey, qaar kalena waa la xanuujiyey ilaa ay ka dhinteen iyagoo aan aqbalin in la samatabbixiyo si ay ku gaadhaan sarakicid ka wanaagsan. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaar kalena waxay jirrabaad ahaan ula kulmeen majaajilo iyo karbaashid iyo weliba silsilado iyo xabbis. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.36",
            "verseOrgIds": [
              "HEB.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waana la dhagxiyey, miinshaarna waa lagu kala jeexay, waana la jirrabay, seefna waa lagu gowracay, wayna warwareegeen iyagoo qaba hargo idaad iyo hargo riyood, iyagoo caydh ah oo la dhibay oo la silciyey. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.37",
            "verseOrgIds": [
              "HEB.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunidu ma ay istaahilin iyagii. Waxayna warwareegi jireen lamadegaanka iyo buuraha iyo boholaha iyo godadka dhulka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwaas oo dhammu, iyagoo loo markhaati furay rumaysadkoodii daraaddiis, ayaanay helin wixii loo ballanqaaday; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
            "verseOrgIds": [
              "HEB.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "HEB 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "waayo, Ilaah wuxuu hore u arkay wax ka wanaagsan oo inagu saabsan, inaan la'aanteen iyaga kaamil laga dhigin.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
            "verseOrgIds": [
              "HEB.11.40"
            ]
          }
        }
