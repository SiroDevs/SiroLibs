          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimcada Rabbigeenna Ciise Masiix ha idinla jirto.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.28",
            "verseOrgIds": [
              "1TH.5.28"
            ]
