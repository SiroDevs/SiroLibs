          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walaalayaalow, noo soo duceeya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1TH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walaalaha oo dhanna dhunkasho quduus ah ku salaama. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.26",
            "verseOrgIds": [
              "1TH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1TH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbigaan idinku dhaarinayaaye, Warqaddan ha loo akhriyo walaalaha oo dhan.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.27",
            "verseOrgIds": [
              "1TH.5.27"
            ]
          }
        }
      ]
    },
