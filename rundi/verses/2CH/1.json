              "items": [
                {
                  "text": "1 Ngo 21:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo ajana n’ikoraniro ryose, baja mu gitabo co ku mpinga y’umusozi i Gibeyoni, kukw aho ari ho ihema ry’ibonaniro ry’Imana ryari riri, iryo Mose umusavyi w’Uhoraho yakoreye mu bugaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "1 Ngo 15:1, 25—16:1.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw isandugu y’Imana Dawidi yari yarayidūganye, ayikūra i Kiriyati‐yeyarimu ayijana aho yayitunganirije; kuko yari yayishingiye ihema i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
