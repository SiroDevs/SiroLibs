              "items": [
                {
                  "text": "1 Ngo 16:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw igicaniro c’umuringa, cākozwe na Besaleli mwene Uri umwuzukuru wa Huri, cari kikiri ngaho imbere y’ihema ry’Uhoraho; aho ni ho Salomo n’ikoraniro bākunda kuja gusiguriza Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.4"
              },
              "items": [
                {
                  "text": "1 Abam 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo aradūga aja kur’ ico gicaniro c’umuringa imbere y’Uhoraho, kiri kur’ iryo hema ry’ibonaniro, acoserezakw ibimazi igihumbi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
