              "items": [
                {
                  "text": "1 Ngo 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo acūrira amajambo Abisirayeli bose, abagabisha bagaba ibihumbi n’abagaba amajana, n’ abacamanza, n’abaganwa bose b’ Abisirayeli, n’abakuru b’amazu ya ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
