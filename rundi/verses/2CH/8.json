            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Salomo yagenda yosereza Uhoraho ibimazi ku gicaniro c’Uhoraho nyene, ico yari yarubatse imbere y’urubaraza, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
