        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo yimura umwamikazi wiwe, umukobga wa Farawo, mu gisagara ca Dawidi, amushira mu ngoro yamwubakiye; kuko yavuze, at’ Umwamikazi wanje ntiyoba mu ngoro ya Dawidi umwami w’Abisirayeli, kukw ah’ isandugu y’Imana yashitse hose ar’ ahantu hēra.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
