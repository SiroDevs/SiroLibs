                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Gus 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akāma atanga ivyashinzwe na Mose vyatangwa uko bukeye, bo n’ivyo ku masabato n’ivyo mu mboneko z’ukwezi, n’ivyo ku misi mikuru yashinzwe, nk’ukw ikurikirana gatatu‐gatatu mu mwaka, ari yo misi mikuru y’imitsima itambiwe, n’umusi mukuru ukurikira amasabato ndwi, n’imisi mikuru y’insago. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.2"
              },
              "items": [
                {
                  "text": "Guh 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.6"
              },
              "items": [
                {
                  "text": "1 Ngo 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atunganya imbu z’abaherezi uko zākurikirana zo gukora, nk’uko se Dawidi yasize ashinze, n’ivy’ ibikorwa vy’ Abalewi vyo guhimbaza no gufasha abaherezi, nk’ukw ibikorwa vyabo vy’imisi yose vyari biri, n’ ivy’ abashibamyi na bo, nk’ukw imbu zabo zakurikirana ku birimba vyose; kukw ari ko Dawidi, wa muntu w’Imana, yari yasize abishinze. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta bgirizwa na rimwe bāvako mu yo umwami yasize ageze ku vy’abaherezi n’ Abalewi, canke ku kintu ic’ ari co cose, canke ku vy’ububīko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Salomo yatunganije ibikorwa vyose, uhereye ku musi yashiriyeh’ itanguriro ry’ingoro y’Uhoraho gushitsa aho yayujurije. Nukw iyo ngoro y’Uhoraho iruzura.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
