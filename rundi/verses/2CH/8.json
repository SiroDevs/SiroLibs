            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo aja i Eziyoni‐geberi n’i Eloti, kw isēsero ry’ ikiyaga mu gihugu c’Abanyedomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramu amurungikira amāto, ayarungikanye abantu biwe, bo n’abazi gusōza bamenyereye ivy’ ikiyaga; baragenda bafatanya n’abantu ba Salomo, baja i Ofiru, bakūray’ amazahabu italanto amajana ane na mirongwitanu, bayazanira umwami Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
