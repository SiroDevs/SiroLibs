          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.3"
              },
              "items": [
                {
                  "text": "2 Ngo 35:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.25"
              },
              "items": [
                {
                  "text": "Ezr 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu mwaka ugira gatatu ari ku ngoma arungika abaganwa biwe Beni‐hayili na Obadiya na Zekariya na Netaneli na Mikaya kuja kwigisha mu bisagara vy’i Buyuda; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi hamwe na bo arungika n’Abalewi, Shemaya na Netaniya na Zebadiya, na Asaheli na Shemiramoti na Yehonatani, na Adoniya na Tobiya na Tobadoniya; kandi hamwe n’abo Balewi arungika n’abaherezi Elishama na Yehoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo baragenda bigisha i Buyuda, bafise igitabo c’ivyagezwe vy’Uhoraho; bagendagenda mu bisagara vyose vy’i Buyuda bigisha abantu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
