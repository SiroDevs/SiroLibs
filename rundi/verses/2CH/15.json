            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakagenda bavunagurana, ihanga ritera irindi hanga, igisagara gitera ikindi gisagara, kukw Imana yagenda ibavurungisha ivyago vy’uburyo bgose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
