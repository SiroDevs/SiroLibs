          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko barahira Uhoraho n’ijwi rirenga, bashira urwamo hejuru, bavuza inzumbete n’inzamba. ",
          "type": "text",
          "attrs": {
