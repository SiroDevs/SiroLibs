            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze basezerana isezerano ryo kuzokwama barondeza Uhoraho Imana ya ba sekuruza imitima yabo yose n’ubugingo bgabo bgose; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
