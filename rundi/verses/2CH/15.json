        },
        {
          "text": "Erega har’ igihe kirekire Abisirayeli bāmaze batagira Imana nyakuri, batagira abaherezi bo kubigisha, badafise n’ivyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
