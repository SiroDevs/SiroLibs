            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mur’ ico gihe nta mutēkāno wariho ng’ umuntu agire aho yocārūkira, kuko hāba imivurungano myinshi mu bantu bose bāba mur’ ivyo bihugu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
