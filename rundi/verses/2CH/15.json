                  "text": "Gus 4:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bashitsweko n’ ivyago, bahindukirira Uhoraho Imana y’Abisirayeli, baramurondera, baramubona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
