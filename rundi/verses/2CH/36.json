            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza atakw ajana n’ ibintu vyo mu ngoro y’Uhoraho i Babuloni, abishira mu rusengero rwiwe i Babuloni nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
