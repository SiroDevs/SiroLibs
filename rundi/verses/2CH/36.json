            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Yehoyakimu, n’ivy’ ibizira vy’ubuyobe yakoze, n’ibindi bibi vyose yagenda abonekako, vyanditswe mu gitabo c’abami b’Abisirayeli n’ab’ Abayuda. Maz’ umuhungu wiwe Yehoyakina asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
