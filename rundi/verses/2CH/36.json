              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Nebukadineza umwami w’i Babuloni araza aramutera, amuta mu minyororo, amujana i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
