                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku gacikamvura umwami Nebukadineza aratuma ngo bamuzane i Babuloni, bo n’ibintu vyiza‐vyiza vyo mu ngoro y’Uhoraho; yimika mukuru we Zedekiya ngw abe umwami w’i Buyuda n’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
