        },
        {
          "text": "Kandi Yehoyakimu yagiye ku ngoma amaze imyaka mirongwibiri n’itanu; ayimarakw imyaka cumi n’umwe ar’i Yerusalemu; akora ivyo Uhoraho Imana yiwe abona kw ari bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
