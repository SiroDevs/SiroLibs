              "items": [
                {
                  "text": "2 Abam 23:30-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu bo mur’ ico gihugu bahitana Yehowahazi umuhungu wa Yosiya, bamwimika mu gishingo ca se i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowahazi yagiye ku ngoma amaze imyaka mirongwibiri n’itatu; ayimarakw amezi atatu ar’ i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye umwami wa Egiputa amukūra ku ngoma i Yerusalemu; igihugu ciwe agicira iciru c’italanto ijana z’ifeza n’italanto imwe y’izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwami wa Egiputa yimika Eliyakimu mukuru we, amugira umwami w’i Buyuda n’i Yerusalemu, ahindura izina ryiwe, amwita Yehoyakimu. Neko araheza afata Yehowahazi, amujana muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
    {
