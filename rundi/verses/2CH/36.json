              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze baturira n’ ingoro y’Imana, basangangura n’ uruzitiro rw’amabuye rw’i Yerusalemu, baturira n’ingoro zaho zose, bīca n’ivyiza‐vyiza vyaho vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
