            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo atuma kuri Huramu umwami w’i Tiro, uti Nk’uko wagirira se Dawidi, ukamurungikira ibiti vy’amasederi vyo kwubaka ingoro yiwe, uti Na we abe ari k’umugirira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.3",
            "verseOrgIds": [
              "2CH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.7"
              },
              "items": [
                {
                  "text": "Kuv 30:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8"
              },
              "items": [
