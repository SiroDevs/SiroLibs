            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Gus 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Non’ agira ngo yubake ingoro y’izina ry’Uhoraho Imana yiwe, ut’ Az’ aheze ayimushikirize, uti Kugira ngo haboneke aho kumwosereza imibavu y’ibintu bimoga, n’aho gutereka imitsima y’ibiterekērwa, n’aho kwosereza ibimazi vyo mu gitondo no ku mugoroba, n’ivyo ku masabato, n’ivyo mu mboneko z’ukwezi n’ivyo ku misi mikuru yashinzwe y’Uhoraho Imana yabo; uti Kukw ivyo ar’ icagezwe c’intahava ku Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.4",
            "verseOrgIds": [
              "2CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
