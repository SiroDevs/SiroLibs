            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo agira imigabo yo kwubakira izina ry’Uhoraho ingoro, no kwiyubakira ingoro yiwe ubgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
