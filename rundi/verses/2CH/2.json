                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ashirah’ abantu ibihumbi mirongwirindwi ashinze ivyo kwikorera, n’abandi ibihumbi mirongumunani bāshinzwe kubāza amabuye ku misozi, n’abo kugaba abo bakozi ibihumbi bitatu n’amajana atandatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.2",
            "verseOrgIds": [
              "2CH.2.2"
            ]
          }
        },
        {
