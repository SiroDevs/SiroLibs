              "items": [
                {
                  "text": "135:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Kand’ iyo ngoro agomba kwubaka ni nini; uti Kukw Imana yabo ar’ agakomeye, isumba izindi mana zose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.5",
            "verseOrgIds": [
              "2CH.2.5"
            ]
          }
        },
        {
