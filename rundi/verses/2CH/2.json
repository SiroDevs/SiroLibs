                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.49"
              },
              "items": [
                {
                  "text": "Ivyak 7:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ut’ Ariko ni nde yoshobora kuyubakira ingoro, uti Kw ijuru, mbere n’ijuru risumba ayandi, itoshobora kurikwirwamwo? Uti None nka we, n’inda n’indēsho, yar’ iki vyotuma ayubakira ingoro, ut’ Atar’ ukurondera aho yoyosereza imibavu gusa? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.6",
            "verseOrgIds": [
              "2CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.15"
              },
              "items": [
                {
                  "text": "1 Ngo 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Nuko none umurungikire umuntu w’umuhinga azi gucura ivy’ amazahabu n’ivy’ amafeza n’ivy’ imiringa n’ivy’ ivyuma, azi no kujisha impuzu mu nyuzi z’amashigisha n’izisa n’agahama n’iz’ amasufe, azi no guca amagarwe, uti Kugira ngw az’ aze afatanye n’abantu biwe b’abahinga bar’ i Buyuda n’i Yerusalemu, ut’ Abo se Dawidi yasize atoye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.7",
            "verseOrgIds": [
              "2CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Kand’ uz’ umurungikire ibiti vy’ amasederi n’ivy’ akajwari, n’ivya alumugi, vy’i Lebanoni; uti Kukw azi kw abantu bawe ar’ abahinga bo guca ibiti i Lebanoni; uti Kand’ abantu biwe bazofatanya n’abawe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.8",
            "verseOrgIds": [
              "2CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Kugira ngo bamutunganirize ibiti vyinshi cane, uti Kukw iyo ngoro agomba kwubaka izoba nini y’igitangaza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.9",
            "verseOrgIds": [
              "2CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Kand’ abo bantu bawe b’ababāji baca ibiti, azobaha ingero zitwa koro ibihumbi mirongwibiri z’ingano zisekuye, uti N’ingero ibihumbi mirongwibiri za sayiri, uti N’imibindi ya vino ibihumbi mirongwibiri, uti N’imibindi y’ amavuta ya elayo ibihumbi mirongwibiri nyene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.10",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
