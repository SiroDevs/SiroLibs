              "type": "tag",
              "attrs": {
                "loc": "NUM.28.3+NUM.28.4+NUM.28.5+NUM.28.6+NUM.28.7+NUM.28.8+NUM.28.9+NUM.28.10+NUM.28.11"
              },
              "items": [
                {
                  "text": "Guh 28:3-11",
