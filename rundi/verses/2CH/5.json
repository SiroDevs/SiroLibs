            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abāvuza inzumbete n’ abaririmvyi bahūza amajwi, bakumvikanisha ijwi rihūye batāzīra Uhoraho bamukengurukira, bakavuza ijwi rirengēra izo nzumbete na matowazi n’ibintu bicurarangwa, bagatāzīra Uhoraho, bat’ Uhoraho ni mwiza, kukw imbabazi ziwe zamah’ ibihe bidashira; nukw ako kanya igicu c’ igipfungu gica cuzura mu ngoro y’Uhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
