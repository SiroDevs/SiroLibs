            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abaherezi barasohoka bava Ahēra, kukw abāri baje bose bo mu baherezi bāri biyejeje, ntibarinze kuzanwa n’ukuza mu mbu zabo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
