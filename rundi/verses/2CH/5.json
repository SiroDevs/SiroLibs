            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ Abalewi bose b’abaririmvyi, Asafu na Hemani na Yedutuni n’abigishwa babo na bagenzi babo, bāri bahagaze i ruhande y’igicaniro ahahera i burasirazuba, bambaye impuzu zera derere, bavuza ivyitwa matowazi n’amakembe n’inanga, bari kumwe n’abaherezi ijana na mirongwibiri bavuza inzumbete. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
