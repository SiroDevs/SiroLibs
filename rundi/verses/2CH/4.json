                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Salomo acurisha ibintu vyose vyo mu ngoro y’Imana, ni vyo ibi: igicaniro c’izahabu, n’ ameza y’imitsima y’ibiterekērwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
