              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.7"
              },
              "items": [
                {
                  "text": "2 Ngo 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibiterekwakw amatara vyacuzwe mw izahabu iramuye, bo n’ amatara yavyo, kugira ngw aze yame yākira hino y’Ahēra Cane, nk’uko vyashinzwe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibisa n’amashurwe, n’ayo matara nyene, n’imakasi zayo zo gutunganya urutambi, na vyo vyar’ ivy’ izahabu y’indobānurwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
            "verseOrgIds": [
              "2CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ imbugita, n’imibehe, n’udukombe, n’udusahani two gushirwak’ umunyota, na vyo nyene vyar’ ivy’ izahabu iramuye; n’amapata y’ inzugi zo haruguru zija Ahēra Cane, n’ay’ inzugi z’ingoro ubgayo, ari rwo rusengero, na yo yar’ ay’ izahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.22",
            "verseOrgIds": [
              "2CH.4.22"
            ]
          }
        }
