            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acura n’ibigarigari cumi vyo kurongamwo; bitanu abishira ku ruhande rw’i buryo, bindi bitanu i bumoso; bābirongamw’ inyama z’ibimazi vyo kwosa, ariko ca gikarabiro citwa ikiyaga car’ ic’ abaherezi co gukarabiramwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        }
