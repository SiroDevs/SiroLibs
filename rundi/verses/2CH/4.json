              "type": "text"
            }
          ]
        },
        {
          "text": "Acura n’ibiterekwakw amatara cumi mw izahabu, nk’ukw ibgirizwa ryavyo riri, abitereka mu rusengero, bitanu mu ruhande rw’i buryo, bindi bitanu mu ruhande rw’i bumoso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
