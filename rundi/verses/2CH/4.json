                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ imibindi n’ivyuma vyo kuyora umunyota n’imibehe Huramu arabikora na vyo. Uko ni ko yanonosoye igikorwa yakorera umwami Salomo c’ingoro y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo yakoze vyar’ ibi: za nkingi zompi, na ya myashi yompi yiburungushuye yari mu mitwe y’izo nkingi, n’ibimeze bga nsenga bibiri vyari kuri ya myashi yiburungushuye yari mu mitwe y’ izo nkingi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.20"
              },
              "items": [
                {
                  "text": "1 Abam 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na vya bishushanyo vy’amakomamanga amajana ane bitondeshejwe kur’ izo nsenga, imirongo ibiri‐ibiri ku nsenga zompi, uko zari kur’ iyo myashi yompi yiburungushuye yari mu mitwe y’izo nkingi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.38"
              },
              "items": [
                {
                  "text": "1 Abam 7:38",
                  "type": "text"
                }
              ]
            },
