            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko none, igikorwa yahawe kirusha icabo kuba ciza, nk’ukw ar’ umuhūza w’isezerano riruta iryabo, kuko ryashizweho n’ivyasezeranywe biruta ivy’ iryabo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
