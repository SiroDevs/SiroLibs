        {
          "text": "bituma Abayuda barundura ivy’ iyo misi yompi ko bazoyigira mikuru, uk’ umwaka utashe, mu gihe cayo gishinzwe nk’uko vyari vyanditswe, babicāna amahani ubgabo no ku ruvyaro rwabo, n’abifatanije na bo bose, ngo vyoye kuzoshingūka; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
