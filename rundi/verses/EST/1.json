              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo nama umwami n’abaganwa barayishima; umwami abigenza nk’ukw inama ya Memukani yar’ iri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
