                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami aca abaza abanyabgenge bazi uko vyahora bigenda mu bihe vyashize; (kuk’ ukw ari k’umwami yahora agenza ku bazi ivyagezwe n’imanza bose). ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.19"
              },
              "items": [
                {
                  "text": "2 Abam 25:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.14"
              },
              "items": [
                {
                  "text": "Ezr 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abār’ akadasohoka ku mwami bāri Karishena na Shetari na Adimata na Tarishishi na Meresi na Marisena na Memukani, abaganwa ndwi b’i Buperesi n’i Bumedi; bār’ abishikira b’umwami, bakaba n’aba mbere mu bgami bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza, at’ Umwamikazi Vashiti tumugire dute mu vy’ivyagezwe, kukw atemeye ijambo natumye inkone, jewe umwami Ahasuwerusi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Memukani arishura, avugira imbere y’umwami n’abo baganwa, at’ Umwamikazi Vashiti ntacumuye ku mwami wenyene, acumuye no ku baganwa bose, no ku mahanga yose ari mu bihugu vyose vy’umwami Ahasuwerusi; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ivyo umwamikazi yakoze ivyo bizokwamamara mu bagore bose, bibatere gukēngēra abagabo babo, ni vyavugwa yuk’ umwami Ahasuwerusi yageze k’umwamikazi Vashiti azanwa imbere yiwe, akanka. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mber’ uyu musi abagore bacu b’i Buperesi n’i Bumedi ni bumva ivyo umwamikazi yakoze, na bo bazoca bagira bartyo abaganwa bose b’umwami. Nuko rero hazobah’ agakēngērwe kenshi n’ishavu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
