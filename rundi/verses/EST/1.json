              "items": [
                {
                  "text": "7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ku musi ugira indwi umutima w’umwami umaze gukankamurwa na vino, abarira Mehumani na Bizita na Haribona na Bigita na Abaguta na Zetari na Karukasi, abo ukw ar’ indwi bār’ inkone zihēreza uwo mwami Ahasuwerusi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.17"
              },
              "items": [
                {
                  "text": "Est 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababgira kuzana umwamikazi Vashiti imbere yiwe yambaye igitsibo c’ubgami, kugira ngo yereke amahanga n’abaganwa ubgiza bgiwe, kuko yar’ umunyakaranga. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umwamikazi Vashiti yanka kuza ngo yemere ijambo ry’umwami ryatumwe izo nkone: bituma umwami ashangashirwa rwose, uburake bgiwe buraziriringa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
