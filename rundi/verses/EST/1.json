                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ngoma ya Ahasuwerusi, (Ahasuwerusi uyo, ni we yaganza ibihugu ijana na mirongwibiri n’indwi, uhereye i Buhindi ugashitsa Etiyopiya), ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.1"
              },
              "items": [
                {
                  "text": "Neh 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ico gihe umwami Ahasuwerusi yar’ ahangamye ku ngoma yiwe ku murwa i Shushani; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.40.20"
              },
              "items": [
                {
                  "text": "Ita 40:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.18"
              },
              "items": [
                {
                  "text": "Est 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.21"
              },
              "items": [
                {
                  "text": "Mrk 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu mwaka ugira gatatu ari ku ngoma atumirira amazimano abaganwa biwe bose n’abamenyekana biwe; abahambaye b’i Buperesi n’i Bumedi, na ba segaba n’abaganwa b’ibihugu bakoranira imbere yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amara imisi myinshi yerekana ubutunzi bg’ ubgami bgiwe bg’icubahiro, n’ igitinyiro c’ubugabe bgiwe bg’ agahebuza; ashitsa imisi ijana na mirongumunani.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iyo misi ishize, umwami atumira abantu bose bari ku murwa i Shushani, abahambaye n’ aboroshe; bamara imisi ndwi mu nyubakwa yo mu rugo rwo ku ngoro y’umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hāri hakinze impuzu zera n’izisa n’akatsi gatoto n’iz’ amasufe, zimanikishijwe imigozi y’ibitambara vyera vyiza n’iy’ inyambarabami, ifashwe n’impeta z’ifeza ku nkingi z’amabuye yitwa marimari; hāri n’imisegamuro yakozwe mw izahabu n’ifeza, iteretse ku musezero wa marimari nyene y’amabara y’ agahama n’ayera n’ay’ umuhondo n’ayirabura. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babahēra ivyo kunywa mu mabakure y’izahabu — kand’ ayo mabakure amwe yasa ukwayo ayandi ukwayo — babaha ku biturire vy’i bgami, nk’ukw ikiganza ciza c’umwami cari kiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mur’ ukwo kunywa vyashinzwe ngo ntihagire ūgōbērwa; kuk’ umwami yari yageze abasuku biwe ng’ umuntu wese agire ukw agomba. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’umwamikazi Vashiti atumirira abagore amazimano mu ngoro y’umwami Ahasuwerusi nyene.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
