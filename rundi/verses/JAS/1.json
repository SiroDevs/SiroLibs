                "loc": "1PE.1.24"
              },
              "items": [
                {
                  "text": "1 Pet 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "umutunzi na we, ni yirate kw acishijwe bugufi, kukw azoyoka nk’amashurwe y’ivyatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.10",
            "verseOrgIds": [
              "JAS.1.10"
            ]
          }
        },
