          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JAS 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kwirāba, akagenda, uwo mwanya agaca yiyibagira ukw asa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.24",
            "verseOrgIds": [
