          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uwumva iryo jambo ntarikore, ameze nk’umuntu yirābiye mu cirore mu maso hiwe yavukanye. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.23",
            "verseOrgIds": [
