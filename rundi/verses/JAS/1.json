                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw asangwa har’ uwo muri mwebge akennye ubgenge, n’abusabe Imana, igabira bose ata kinūbge, idaterana imirarwe, azobuhabga. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
