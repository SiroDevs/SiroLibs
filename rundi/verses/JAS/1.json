              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, mwene Data w’umufafara ni yirate kw ashizwe hejuru, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.9",
            "verseOrgIds": [
              "JAS.1.9"
            ]
          }
        },
