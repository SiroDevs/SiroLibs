              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiyumvire kw ar’ ivyo kunezererwa rwose, bene Data, ni mwagwa mu bibagerageza bitari bimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.2",
            "verseOrgIds": [
              "JAS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
