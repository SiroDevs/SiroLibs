            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw izuba rirasa, rizanye indugumba, rikūmisha ivyatsi, amashurwe yavyo agahunguruka, ubgiza bg’ishusho yayo bugashira. Uko ni k’umutunzi azoyonga mu ngendo ziwe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
