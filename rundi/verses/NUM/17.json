            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.11",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli babarira Mose, bat’ Ehe turashize, turapfuye, eka mbere turapfuye twese. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.12",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.1.53"
              },
              "items": [
                {
                  "text": "Guh 1:53",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.5"
              },
              "items": [
                {
                  "text": "18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūgize ngw arīgira hafi, ngo yēgēre ihema ry’Uhoraho, aca apfa: mbega twese tugiye gupfa, dushire?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.17.13",
            "verseOrgIds": [
              "NUM.17.13"
            ]
          }
        }
      ]
