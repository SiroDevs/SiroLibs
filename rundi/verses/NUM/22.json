                "loc": "NUM.33.48"
              },
              "items": [
                {
                  "text": "Guh 33:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli barahaguruka, basagaza mu kiyaya c’i Mowabu, hakuno ya Yorodani, aharābana n’i Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki mwene Sipori abona ivyo Abisirayeli bāgiriye Abamori vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.2",
            "verseOrgIds": [
              "NUM.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.15"
              },
              "items": [
                {
                  "text": "Kuv 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamowabu bacibga ivutu n’iryo hanga, kubg’ ubginshi bgabo; barandurwa imitima n’ Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.8"
              },
              "items": [
                {
                  "text": "Guh 31:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.21"
              },
              "items": [
                {
                  "text": "Yos 13:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamowabu babarira abakuru b’i Midiyani, bat’ Erega ririya sinzi ry’abantu rigiye gukombotoza ibiri hirya no hino yacu vyose, nk’ukw inka zikombotoza ubgatsi bgo ku musozi. Kand’ uyo Balaki mwene Sipori ni we yari ku ngoma i Mowabu mur’ ico gihe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuma intumwa kuri Balamu mwene Beyori, i Petori hafi y’uruzi Efurate, mu gihugu c’i wabo, ngo zimuhamagare, zimubgire, ziti Ngo Haje abantu bavuye muri Egiputa, bajimagije igihugu cose, ngo None bahanganye na we. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.5",
            "verseOrgIds": [
              "NUM.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ngw Arakwinginze, n’uze umuvumire abo bantu; ngo Kuko bahambaye, atobīhanga. Ngo Kumbure yobanesha, akabatsinda, akabirukana mu gihugu: ngo Kukw azi yuk’ uwo uhezagiye aba ahezagiwe, kand’ uwo uvumye aba avumwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        }
      ]
    },
