          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.38",
            "verseOrgIds": [
              "NUM.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Balamu ajana na Balaki, baja i Kiriyati‐husoti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.39",
            "verseOrgIds": [
              "NUM.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki atanga inka n’intama kw ibimazi, abicīrako Balamu na ba bamenyekana bari kumwe na we. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Balaki ajana Balamu, amudūgana i Bamoti‐Bayali, ah’ ashobora kubona uruhande rumwe rw’Abisirayeli",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:41",
              "type": "text"
            },
            {
              "text": "Abisirayeli",
              "type": "text"
            },
            {
              "text": ": mu Giheburayo handitswe ngw Abantu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aho bagarukira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
      ]
