            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bīfatanya na Bayali y’i Peyori, uburake bg’Uhoraho burabaziriringira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.17"
              },
              "items": [
                {
                  "text": "Gus 13:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ati Jana n’abakuru bose baganza abantu, umanike abakoze ivyo imbere yanje, ubānikire ku zuba, kugira ng’ uburake bganje bg’inkazi buve ku Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 25:5"
