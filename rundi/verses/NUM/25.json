          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akurikira wa mugabo w’Umwisirayeli haruguru mw ihema ryiwe, abatobekeranisha icumu bompi, wa mugabo w’Umwisirayeli na wa mugore, umugore rimutobekeranya mu nda. Uko ni kw ikīza cābogojwe mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
