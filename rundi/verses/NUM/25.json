                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bābatumira ngo baze gusangira na bo ibimazi vy’ibigirwamana vyabo: nukw abo bantu bakabiryako, bakūnamira ivyo bigirwamana vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
