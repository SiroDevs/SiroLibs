            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Finehasi mwene Eleyazari, Eleyazari wa Aroni umuherezi, abibonye, ava hasi hagati mw ishengero, ahitana icumu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
