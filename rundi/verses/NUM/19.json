            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ikintu cose ūhumanye azokorako na co kizoba gihumanye: ūzogikorako azoba ahumanye gushitsa ku mugoroba.",
          "type": "text",
