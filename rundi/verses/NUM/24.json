            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu yunamura amaso, abona Abisirayeli bashagaje nk’ukw imiryango yabo iri; Mpwemu w’ Imana amuzako. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
