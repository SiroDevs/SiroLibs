            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.37"
              },
              "items": [
                {
                  "text": "Kuv 25:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Aroni, uti Ni washira ya matara ku gitereko cayo, uz’ uyatereke kuri co ukw ari ndwi, uburyo butuma abonesha imbere yaco. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.25"
              },
              "items": [
                {
                  "text": "Kuv 40:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aroni abigenza artyo; ashira ayo matara ku gitereko, uburyo butuma abonesha imbere yaco, nk’uk’ Uhoraho yabariye Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "Kuv 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni kw ico gitereko cākozwe: cari gicuzwe mw izahabu; car’ igicurano uhereye ku ntebe yaco ugashitsa no ku bimeze nk’amashurwe biri kuri co; nk’ukw icitegererezo cari kiri, Uhoraho yeretse Mose, uko ni ko Mose yacurishije ico gitereko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
    },
