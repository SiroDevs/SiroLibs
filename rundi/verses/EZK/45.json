            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aze yābīre ku maraso y’ikimazi gitangirwa ivyaha, ayasīge ku bisapfu vy’ ingoro, no ku mfuruka zine z’ intera y’igicaniro, no ku bikingi vy’ikirimba c’inyubakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.19",
            "verseOrgIds": [
              "EZK.45.19"
            ]
          }
        },
