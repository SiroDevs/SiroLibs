                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.13"
              },
              "items": [
                {
                  "text": "47:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hazomubera ishamvu hagati mu Bisirayeli mur’ ico gihugu; kandi ba segaba banje ntibazokwongera guhahaza abantu banje; ariko bazogabanganiriza igihugu ab’ inzu ya Isirayeli, nk’ukw imiryango yabo iri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        }
      ]
    },
