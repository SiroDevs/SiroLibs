            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kwezi kwa mbere, ku musi wakwo w’icumi na kane, muze mugire Pasika, iz’ ibe imisi mikuru gushitsa indwi; baze barye imitsima itambiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
