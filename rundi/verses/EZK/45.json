              },
              "items": [
                {
                  "text": "Lew 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ az’ ashikane ishikanwa ry’amafu, ku masa yose hajekw ingero imwe yitwa efa, no ku mpfizi y’intama hajeko efa imwe nyene; no kuri efa yose y’ifu hajekw ingero yitwa hini y’ amavuta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
