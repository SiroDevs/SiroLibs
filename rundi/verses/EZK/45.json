                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo musi segaba az’ atange imasa kw ikimazi gitangirwa ivyaha, co kubgiwe no kubg’ igihugu cose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
