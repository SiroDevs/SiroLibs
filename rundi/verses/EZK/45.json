              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ni ryo shikanwa muzoshikana: mu ngano muze mutange kimwe ca gatandatu co muri efa, mukigabanije kuri homeru imwe; muri sayiri muze mutange kimwe ca gatandatu co muri efa nyene, mukigabanije kuri homeru; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "urugero rw’amavuta rushinzwe muzotanga rwo muri batu igera amavuta, ruze rube kimwe c’icumi co muri batu, mukigabanije kuri koru, ari yo ijamwo batu cumi, ar’ urugero rumwe na homeru: kuko homeru imwe ijamwo batu cumi nyene; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.1.4"
              },
              "items": [
                {
                  "text": "Lew 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutange n’umwagazi w’intama umwe‐umwe ukūwe mu mukuku w’amajana abiri‐abiri, mu mikuku y’imiryango y’Abisirayeli; ivyo vyose bize bibe ishikanwa ry’ amafu, n’ikimazi co kwoswa, n’ ibimazi vy’ishimwe, kugira ngo batangirwe impongano, ni k’ Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bo mu gihugu bazozanira segaba w’Abisirayeli iryo shikanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
