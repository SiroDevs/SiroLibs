                  "text": "Guh 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi mikuru ukw ar’ indwi az’ atange ibimazi vyo kwosereza Uhoraho, amamasa ndwi‐ndwi n’impfizi z’intama ndwi‐ndwi bitagira agasembga, ku musi wose ukw ar’ indwi; n’impfizi z’impene kw ikimazi gitangirwa ivyaha imwe‐imwe uko bukeye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
