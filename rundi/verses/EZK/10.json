              },
              "items": [
                {
                  "text": "Ezk 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ngize ntya mbona mw itāzānure ry’ijuru ryo hejuru y’imitwe ya ba bakerubi, haboneka igisa n’ibuye ryitwa safiro, kimeze nk’igisa n’intebe y’ubgami. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.2"
              },
              "items": [
                {
                  "text": "Ezk 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho abarira wa muntu yambaye impuzu zera, ati Genda uce hagati ya ya makurudumu yizinguriza, musi y’umukerubi, wuzuze amashi yawe yompi amakara yaka, uyakūye hagati y’abakerubi, uyakwiragize hejuru y’igisagara. Nukw ahaca mbona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.10"
              },
              "items": [
                {
                  "text": "1 Abam 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.16"
              },
              "items": [
                {
                  "text": "Ezk 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ba bakerubi bāri bahagaze i buryo bg’ ingoro igihe wa muntu yahaca; maz’ igipfungu cuzura mu nyubakwa y’imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2"
              },
              "items": [
                {
                  "text": "43:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ ubgiza bg’Uhoraho buradūga buva ku mukerubi, buhagarara imbere y’ irebe ry’ingoro; maz’ ingoro yuzura igipfungu, inyubakwa na yo yuzura ugukayangana kw’ubgiza bg’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.24"
              },
              "items": [
                {
                  "text": "Ezk 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uguhinda kw’amababa y’abakerubi kwarumvikana kugashika no mu ntangaro, kumeze nk’ijwi ry’ Īshobora vyose iy’ ivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw imaze kubarira wa muntu yambaye impuzu zera, it’ Abīra umuriro uwukūye hagati ya ya makurudumu yizinguriza, no hagati y’abakerubi, araheza arahaca, ahagarara i ruhande y’ikurudumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umukerubi umwe atuma ukuboko hagati ya ba bakerubi, ku muriro wari hagati yabo, awābīrako, awushira mu mashi y’uwo yambaye impuzu zera; arawābīra, aragenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.8"
              },
              "items": [
                {
                  "text": "Ezk 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi musi y’amababa ya ba bakerubi hāboneka ibisa n’amaboko y’umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
