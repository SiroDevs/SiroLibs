              "items": [
                {
                  "text": "Int 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amahanga yumva ivyayo, ikorokera mu cobo ayo mahanga yayimbiye: bayikwegesha ingōgo z’ivyuma, bayijana mu gihugu ca Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
