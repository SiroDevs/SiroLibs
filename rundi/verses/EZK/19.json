                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Ezk 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amahanga arayitera baturutse mu bihugu impande zose; bayita mu ruriba rwabo, ikorokera mu cobo bayimbiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
