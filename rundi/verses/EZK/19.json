              "items": [
                {
                  "text": "Hos 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noneho watewe mu bugaragwa, mu gihugu cumye kigataye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.13",
            "verseOrgIds": [
              "EZK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuriro wavuye muri rya shami, uturira ayandi mashami yawo, n’inzabibu zawo, bituma ata shami rinoze ryo kuvamw’ inkoni y’ubugabe yo kuganzisha iwusigarako. Ayo majambo n’ay’ agacurantimba, kand’ azohora acurishwa intimba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.14",
            "verseOrgIds": [
              "EZK.19.14"
            ]
          }
        }
      ]
