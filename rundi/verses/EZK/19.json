                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Ita 49:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Nyoko yar’ iki? Yar’ intambge y’ingore: yigaramangira mu zindi ntambge, ikonkereza ibibunda vyayo hagati mu migunza y’ intambge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        },
        {
          "name": "verse",
