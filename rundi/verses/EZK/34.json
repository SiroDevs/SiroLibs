            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.3"
              },
              "items": [
                {
                  "text": "Zek 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Umwami Uhoraho agize, ati Rāba abo bungere tuzohigūra twe na bo; kand’ intama zanje nzozibaronderako, ndababuze gusubira kuziragira; kand’ abo bungere ntibazoba baciragira ukundi; nzokiza intama zanje amenyo yabo, zoye kuba inyama zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.10",
            "verseOrgIds": [
              "EZK.34.10"
            ]
          }
        }
      ]
