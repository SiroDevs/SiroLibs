            "number": "8",
            "style": "v",
            "sid": "EZK 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.9"
              },
              "items": [
                {
                  "text": "Yes 56:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo Ndahiye ukubaho kwanje, ni k’Umwami Uhoraho agize, n’ ukuri intama zanje ko zahindutse inyagano, zikaba ivyo kurya vy’ ibikōko vyose vyo mw ishamba, kubgo kutagira umwungere, kand’ abungere banje ntibarondere intama zanje, ariko bakīragira ubgabo, ntibaragire intama zanje; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.8",
            "verseOrgIds": [
              "EZK.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero, ni mwumve ijambo ry’ Uhoraho, yemwe mwa bungere: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.9",
            "verseOrgIds": [
              "EZK.34.9"
            ]
          }
        },
