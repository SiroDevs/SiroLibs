              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.6"
              },
              "items": [
                {
                  "text": "Lew 26:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.10"
              },
              "items": [
                {
                  "text": "Yes 54:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.26"
              },
              "items": [
                {
                  "text": "Ezk 37:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.8"
              },
              "items": [
                {
                  "text": "38:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzosezerana na zo isezerano ry’amahoro, kandi nzoherengeteza ibikōko vy’inkazi mu gihugu: maze zizokwibera amahoro mu gahinga, zīryamire mu mashamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.4"
              },
              "items": [
                {
                  "text": "Lew 26:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.24"
              },
              "items": [
                {
                  "text": "Yes 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.13"
              },
              "items": [
                {
                  "text": "Zek 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoziha umugisha hamwe n’uturambi duherereye ku musozi wanje; kandi nzorekura imvura mu gihe cayo; hazogwa imvura ihesha umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.26",
            "verseOrgIds": [
              "EZK.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.85.12"
              },
              "items": [
                {
                  "text": "Zab 85:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.30.8"
              },
              "items": [
                {
                  "text": "Yer 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.30"
              },
              "items": [
                {
                  "text": "Ezk 36:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ igiti co mw ishamba kizokwama, isi yimbuke ivyimburo vyayo; na zo zizokwibera amahoro mu gihugu cazo; kandi zizomenya yuko jewe nd’Uhoraho, igihe nzoba mmaze kuvuna ibiti vy’ingōgo zambitswe, no kuzirokora mu maboko y’abāzihinduye abaja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.27",
            "verseOrgIds": [
              "EZK.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntizizokwongera kuba inyagano z’abanyamahanga ukundi, cank’ ibikōko vyo kw isi ngo bizirotse; ariko zizokwibera amahoro, ata kiziteye ubgoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
            "verseOrgIds": [
              "EZK.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzozimereza umuyigwe w’agahagarika, kandi ntizizosubira kumarwa n’inzara mu gihugu, canke gutēterezwa n’abanyamahanga ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.100.3"
              },
              "items": [
                {
                  "text": "Zab 100:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze zizomenya yuko jewe Uhoraho Imana yazo ndi kumwe na zo, kandi yukw ar’ abantu banje, ari bo ab’ inzu ya Isirayeli, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi namwe ntama zanje, mwa ntama z’icibare canje, mur’ abantu, nanje nd’ Imana yanyu, ni k’ Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
              "EZK.34.31"
            ]
          }
        }
