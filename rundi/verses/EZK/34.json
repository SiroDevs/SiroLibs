            "number": "20",
            "style": "v",
            "sid": "EZK 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Umwami Uhoraho azibariye, at’ Ehe jewe, jewe nyene, ngira nce urubanza hagati y’ibitungwa bivyibushe n’ ibindi binanutse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.20",
            "verseOrgIds": [
              "EZK.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko muzisitisha imbavu n’ibitugu, izirwaye zose mukazisunikisha amahembe yanyu, gushitsa muzisanzarije kure; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.21",
            "verseOrgIds": [
              "EZK.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni co gituma ngira nkize umukuku wanje ngo ntube ukiba inyagano ukundi; kandi nce urubanza hagati y’ibitungwa n’ibindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.22",
            "verseOrgIds": [
              "EZK.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 34:23"
          },
          "items": [
