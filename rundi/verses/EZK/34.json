                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.25"
              },
              "items": [
                {
                  "text": "Ezk 37:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje Uhoraho, nzoba Imana yazo, n’ umusavyi wanje Dawidi azoba segaba muri zo; ni jewe Uhoraho mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.24",
            "verseOrgIds": [
              "EZK.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 34:25"
          },
          "items": [
