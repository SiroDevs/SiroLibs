        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.19",
            "verseOrgIds": [
              "EZK.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
