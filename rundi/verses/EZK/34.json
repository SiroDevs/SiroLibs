          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.11.16"
              },
              "items": [
                {
                  "text": "Zek 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.12"
              },
              "items": [
                {
                  "text": "Mat 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.3"
              },
              "items": [
                {
                  "text": "1 Pet 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Īdakomeye ntimwayisindagije, n’īrwaye ntimwayivūye, n’īvunitse ntimwayunze, n’iyirukanywe ntimwayigarukanye, canke ngo murondere iyazimiye; ariko mwazitwaje igitugu n’amanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.4",
            "verseOrgIds": [
              "EZK.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
