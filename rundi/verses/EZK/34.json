              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, ni mwumve ijambo ry’Uhoraho, yemwe mwa bungere: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.7",
            "verseOrgIds": [
              "EZK.34.7"
            ]
          }
        },
        {
          "name": "verse",
