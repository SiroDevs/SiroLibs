                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.4"
              },
              "items": [
                {
                  "text": "Mik 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoziha umwungere umwe, na we azoziragira, ni we musavyi wanje Dawidi; azoziragira, abe umwungere wazo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.23",
            "verseOrgIds": [
              "EZK.34.23"
            ]
          }
        },
        {
