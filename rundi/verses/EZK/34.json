                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ut’ Ariko mweho muzirya ibinure, mukambara ubgoya bgazo, mukabāga izinuze; ariko ntimuragira intama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.3",
            "verseOrgIds": [
              "EZK.34.3"
            ]
          }
        },
        {
