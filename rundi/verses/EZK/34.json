        },
        {
          "text": "Nzorondera iyazimiye, ngarukane iyahuvye, nunge īvunitse, nsindagize īrwaye, izivyibushe n’izikomeye ndazibogeke; zose nzoziragira mu buryo buroranye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.16",
            "verseOrgIds": [
              "EZK.34.16"
            ]
          }
        }
      ]
    },
