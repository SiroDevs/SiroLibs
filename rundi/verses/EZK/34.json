              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari k’Umwami Uhoraho agize, ati Rāba jewe, jewe ubganje, ndīgīriye kurondera intama zanje, ndazibariritse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.11",
            "verseOrgIds": [
              "EZK.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
