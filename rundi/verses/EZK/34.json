                  "text": "Mat 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko zirasābagira kukw ata mwungere; zihinduka ivyo kurya vy’ibikōko vyose vyo mw ishamba, zirasābagira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.5",
            "verseOrgIds": [
              "EZK.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intama zanje zayerereye ku misozi yose, no ku gasozi kose karekare; mber’ intama zanje zāsābagiriye mw isi yose; kandi nta warushe azirondera canke ngw azibariritse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.6",
            "verseOrgIds": [
              "EZK.34.6"
            ]
          }
        }
      ]
    },
