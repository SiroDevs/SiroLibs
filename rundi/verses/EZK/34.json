          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.3"
              },
              "items": [
                {
                  "text": "Yer 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.17"
              },
              "items": [
                {
                  "text": "Ezk 11:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzozizana ndazikūye mu mahanga, ndazikoranirize hamwe ndazikūye mu bihugu, nzozizana ndazishikane mu gihugu cazo bgite; nzoziragira ku misozi y’i Bgisirayeli, i ruhande y’imigende y’amazi, n’ ahantu hose har’ abantu mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.13",
            "verseOrgIds": [
              "EZK.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 34:14"
          },
          "items": [
