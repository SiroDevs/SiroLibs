                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoziragira mu canya ciza, kandi mu mpinga z’imisozi miremire y’i Bgisirayeli ni ho zizogira umugutu; aho ni ho zizovyagira, ziri mu mugutu mwiza, zirishe mu canya c’ubgatsi buremvye ku misozi y’i Bgisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.14",
            "verseOrgIds": [
              "EZK.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe ubganje nzokwiragirira intama zanje, ndazivyagize, ni k’ Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.15",
            "verseOrgIds": [
              "EZK.34.15"
            ]
          }
        },
