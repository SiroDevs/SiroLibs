          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.3"
              },
              "items": [
                {
                  "text": "Ezk 30:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ uk’ umwungere abariritsa umukuku wiwe mu gihe ari mu ntama ziwe zāsābagiriye kure, ni ko nanje nzobariritsa intama zanje; nzozikiza ndazikūre ahantu hose zāsābagiriye ku musi wo gufurangana w’ubgirakabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.12",
            "verseOrgIds": [
              "EZK.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
