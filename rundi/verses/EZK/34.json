            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, būrira abungere baragira Abisirayeli, ubabūrire, ubgire abo bungere, ut’ Uku ni k’Umwami Uhoraho agize, ati Bazobona ibara, abungere b’Abisirayeli bīragira ubgabo! Mbeg’ abungere ntibāri bakwiye kuragira intama? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.2",
            "verseOrgIds": [
              "EZK.34.2"
            ]
          }
        },
        {
          "name": "verse",
