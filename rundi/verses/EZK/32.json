          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazohindikirana hagati y’abicishijwe inkota: Egiputa hāgaburiwe inkota: ni muhakwegane n’ishengero ryaho ryose. ",
          "type": "text",
          "attrs": {
