            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu mwaka w’icumi na kabiri, mu kwezi kw’ icumi na kabiri, ku musi wa mbere w’ukwo kwezi, ijambo ry’Uhoraho ryanjeko, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
