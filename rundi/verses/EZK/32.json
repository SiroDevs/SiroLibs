          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe nyene uzovunagurirwa hagati y’abatākebge, uryame hamwe n’abahindikiranijwe n’inkota.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
