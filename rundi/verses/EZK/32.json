                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.18"
              },
              "items": [
                {
                  "text": "34:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, cura intimba uririre Farawo umwami wa Egiputa, umubgire, uti War’ ūhwanye n’umugunza w’ intambge yo mu mahanga; yamar’ umeze nk’ingona iri mu kiyaga; widimbagura mu nzūzi zawe, amazi uyatobesha ibirenge, uca iyondoyondo inzūzi zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Ezk 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Umwami Uhoraho agize, ati Nzoguhwikiza urusenga rwanje, ndi kumwe n’igitero c’abanyamahanga benshi; kandi bazogukwegesha urusenga rwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.5"
              },
              "items": [
                {
                  "text": "Ezk 29:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzogusiga ngaho i musozi, ngushiburire mu gahinga ka sabaderi, kandi nzotuma ibiguruka vyose vyo mu kirēre biguhundarako, n’ ibikōko vyo kw isi yose nzobihāza inyama zawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.12"
              },
              "items": [
                {
                  "text": "Ezk 31:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere nzokwiragiza inyama zawe ku misozi, n’ imyonga ndayuzuze ubutumbazi bgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihugu ugenda wogamwo nzogitotesha amaraso yawe gushitsa no ku misozi miremire; n’ibihoro vy’imigezi bizokwuzura wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.10"
              },
              "items": [
                {
                  "text": "Yes 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.9"
              },
              "items": [
                {
                  "text": "Am 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mat 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.24"
              },
              "items": [
                {
                  "text": "Mrk 13:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe nzokudorongeza, nzotwikira ijuru, n’ inyenyeri ntume zicura umwiza; izuba nzoritwikiriza igicu, kand’ ukwezi ntikuzoba kucaka umuco wakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.30"
              },
              "items": [
                {
                  "text": "Yes 5:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imuri zose zaka kw ijuru nzotuma zicura umwiza hejuru yawe, igihugu cawe ncubikizek’ umwiza, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzotuma imitima y’amahanga menshi ihagarara igihe nzokwiza ivy’ ukugesera kwawe mu mahanga, gushitsa no mu bihugu utigeze kumenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.16"
              },
              "items": [
                {
                  "text": "Ezk 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.35"
              },
              "items": [
                {
                  "text": "27:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere nzotuma amoko menshi agutangarira, kand’ abami babo bazofatwa n’ubgoba bginshi kubgawe, igihe nzorabagiriza inkota yanje imbere yabo; bazohinda agashitsi urudaca, umuntu wese aririre amagara yiwe, ku musi wo kugesezwa kwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.26"
              },
              "items": [
                {
                  "text": "Yer 46:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari k’Umwami Uhoraho agize, at’ Inkota y’umwami w’i Babuloni izogushikako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.7"
              },
              "items": [
                {
                  "text": "Ezk 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.19"
              },
              "items": [
                {
                  "text": "29:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzotuma ishengero ryawe riririkwa n’inkota z’ abahizi; abo bose ni bo b’agaterabgoba bo mu mahanga. Ubgibone bga Egiputa bazobuhindura ubusa, n’ishengero ryaho ryose rizohona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.11"
              },
              "items": [
                {
                  "text": "Ezk 29:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzohonnya ibitungwa vyaho vyose bir’ i ruhande y’amazi menshi; kandi nta kirenge c’umuntu kizokwongera kuyatoba, n’inzāra z’ibitungwa ntizizoba zikiyatoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.2"
              },
              "items": [
                {
                  "text": "Ezk 32:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ho nzotuma amazi yaho atonganuka, ntume n’inzūzi zaho zitemba nk’ amavuta ya elayo, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.6"
              },
              "items": [
                {
                  "text": "Ezk 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe nzohindura igihugu ca Egiputa amatongo n’imisaka, igihugu kitakirimw’ ivyahora bicuzuye, nishe abākibamwo bose, ni ho bazomenya yuko nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ako ni ko gacurantimba bazocura; abakobga b’amahanga bazocura intimba bartyo: ni ko bazocurira intimba Egiputa n’ishengero ryaho ryose, ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
      ]
    },
