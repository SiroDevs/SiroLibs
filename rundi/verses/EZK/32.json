                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntibaryamye hamwe n’abahizi bāhindikiranye bo mu batākebge, bāmanukanye i kuzimu n’ibirwanishwa vyabo vy’intambara, bīseguye inkota zabo, ibigabitanyo vyabo biri ku magufa yabo; kuko bār’ agaterabgoba ku bahizi mw isi y’abariho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
