                  "text": "Yes 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imva zabo ziri mu bgigobeko bga rwa rwobo, kand’ ingabo ziwe zikikije imva yiwe: bose n’abishwe, bahindikiranijwe n’inkota, kand’ ari bo bār’ agaterabgoba mw isi y’ abariho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
