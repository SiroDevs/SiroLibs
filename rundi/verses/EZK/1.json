            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo bigiye, numva guhinda kw’amababa yavyo, ni nko guhinda kw’amazi menshi, nk’ ijwi ry’Īshobora vyose, nk’uguhinda kw’ingabo: iyo bihagaze vyabumba amababa yavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hirya y’itāzānure ry’ijuru ryo hejuru y’imitwe yavyo hār’ ijwi: nuko vyarahagarara bikabumba amababa yavyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
