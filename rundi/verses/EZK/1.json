            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi ugira gatanu w’ukwo kwezi, hāri mu mwaka ugira gatanu umwami Yehoyakina yambukanywe ar’ inyagano, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
