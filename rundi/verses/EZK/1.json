                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngize ntya, mbona umuyaga w’ikirura uje uturutse i burārūko, igicu kininiya kirabagizamw’ umuriro, gikikijwe n’ibibatsi bituruka hagati muri wo, biboneka nk’ umuringa w’umujumbu, bituruka hagati mur’ uwo muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
