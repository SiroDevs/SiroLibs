              "items": [
                {
                  "text": "Ezk 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijambo ry’ Uhoraho ryanjeko jewe umuherezi Ezekiyeli mwene Buzi, ndi mu gihugu c’Abakaludaya ku ruzi Kebari; kand’ aho hantu nyene ni ho ukuboko kw’Uhoraho kwaziye kuri jewe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
