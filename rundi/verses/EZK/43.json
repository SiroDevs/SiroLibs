            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwemu aranterura, anshikana mu nyubakwa; ngize ntya, mbona ubgiza bg’Uhoraho bguzuye ingoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
