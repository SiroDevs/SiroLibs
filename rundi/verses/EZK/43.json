            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi b’ Abalewi, bo mu ruvyaro rwa Sadoki, ari bo bampora hafi ngo bankorere, uz’ ubahe imasa y’umukangara, ibe ikimazi gitangirwa ivyaha, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
