              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.1"
              },
              "items": [
                {
                  "text": "Lew 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.40"
              },
              "items": [
                {
                  "text": "Ezk 20:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ni barangiza iyo misi, uhereye umusi ugira umunani, abaherezi baze bahereko babatangire ibimazi vyanyu ku gicaniro, ari vyo bimazi vyo kwoswa n’ibimazi vy’ishimwe; nanje nzobākīrira, ni k’Umwami Uhoraho agize.",
          "type": "text",
