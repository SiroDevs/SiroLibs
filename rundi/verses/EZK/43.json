            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambarira, ati Mwana w’umuntu, uku ni k’Umwami Uhoraho agize, at’ Aya ni yo mabgirizwa y’igicaniro bazoshitsa umusi bazocubaka, kugira ngo bacoserezekw ibimazi, bakimijekw amaraso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
