          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ubgiza bg’Uhoraho bginjira mu ngoro buciye mu kirimba gihera i burasirazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
