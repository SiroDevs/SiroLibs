          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko begereje irebe ryabo hambavu y’irebe ryanje, n’igisapfu cabo hambavu y’igisapfu canje, hagati yanje na bo hagaca urugo gusa; bakandurisha izina ryanje ryera ibizira vyabo bākora: ni co catumye mbayogeza mfise uburake. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noneho ni bankūre imbere ubgo bumaka bgabo, n’imivyimba y’abami babo, babinshire kure, mbone kuba hagati muri bo gushitsa ibihe bidashira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
