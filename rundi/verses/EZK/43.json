            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze numva ūmbarira ari mu ngoro; nuk’ umuntu aca ampagarara i ruhande. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
