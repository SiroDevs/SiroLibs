                  "text": "Ezk 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko, mu mwaka w’icenda, mu kwezi kw’icumi, ku musi ugira icumi w’ukwo kwezi, ijambo ry’Uhoraho ryongera kunzako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
