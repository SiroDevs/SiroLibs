            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe muzogira nk’ uko mmeze: ntimuzoruha mwipfuka ku munwa, canke ngo murye ibiryazagu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
