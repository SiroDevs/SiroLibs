              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu barambaza, bati Mbega ntiwotubarira ico ivyo bintu bidutaze, bitumye ukora urtyo? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
