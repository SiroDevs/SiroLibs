            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzobatungīra igitsure; bazova mu muriro basubire mu wundi ubatongore; kandi namwe muzomenya yuko jewe nd’ Uhoraho, abo ni nabatungīra igitsure. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
