            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibicumuro vyiwe vyose yacumuye nta na kimwe kizokwibukwa ngo gishirwe kuri we; azobeshwaho n’uko yakoze ivy’ ukugororoka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.22",
            "verseOrgIds": [
