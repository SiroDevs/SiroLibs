            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega mugira ngo mpimbarwa n’uk’ umunyavyaha apfa? ni k’ Umwami Uhoraho abaza; ikimpimbara s’uko yohindukira akava mu ngeso ziwe akabaho? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
