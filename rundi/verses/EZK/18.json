              "items": [
                {
                  "text": "Gus 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba atāgurāniye kuzohabga ay’ inyungu, canke ngo yake ibirenzeko na bikeya, arikw agatinyisha ukuboko kwiwe ivyaha, agaca ururoranye ku muntu na mugenzi we, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.11"
              },
              "items": [
                {
                  "text": "Ezk 20:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akagendera mu vyagezwe vyanje, akitondera amabgirizwa yanje ngw akore ivy’ ukuri; ben’ uyo aba ar’ umugororotsi, ntazobura kubaho, ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
