          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero n’uyo na we yovyara umwana, akitegereza ivyaha vyose vya se yakoze, agatinya, ntakore ibisa na vyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ akaba atārīriye mu bitabo ku misozi, ntiyunamurire amaso ibigirwamana vy’inzu ya Isirayeli, ntiyonone umugore wa mugenzi we, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntāgire uwo agunga, ntāgire uwo yaka ingwati, ntānyage ku gahahazo, arikw akaba yaragaburiye ūshonje, akambika impuzu uwambaye ubusa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "agatinyisha ukuboko kwiwe ngo ntigufyonderanye impahazwa, akaba atāgurāniye kuzohabga ay’ inyungu, ntiyake ibirenzeko, arikw agashitsa amabgirizwa yanje, akagendera mu vyagezwe vyanje: uyo ntazopfa azira ibigabitanyo vya se, mbere ntazobura kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.18"
              },
              "items": [
                {
                  "text": "Ezk 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko se wiwe, kuko yahahaza cane, akanyaga mugenzi we ku gahahazo, agakora ibitaroranye mu bgoko bgabo, uyo ni we azopfa azize ibigabitanyo vyiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        }
      ]
