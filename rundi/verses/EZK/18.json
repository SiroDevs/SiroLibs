              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.25"
              },
              "items": [
                {
                  "text": "33:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba atārīriye mu bitabo ku misozi, ntiyunamurire amaso ibigirwamana vy’inzu ya Isirayeli, kand’ akaba atononnye umugore wa mugenzi we, akaba atēgereye umugore mu gihe ari mu miziro; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        },
        {
