                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugororotsi ni yahindukira akava mu bugororotsi bgiwe, agakora ivy’ ukugabitanya, azopfa abizize; ibigabitanyo vyiwe yakoze ni vyo azopfa azize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.26",
            "verseOrgIds": [
              "EZK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 18:27"
          },
          "items": [
