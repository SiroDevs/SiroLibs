          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umunyavyaha ni yahindukira akava mu vyaha vyiwe vyose yakora, akitondera ivyagezwe vyanje vyose, agakora ibitunganye n’ibikwiye, n’ukuri azobaho, ntazopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.21",
            "verseOrgIds": [
              "EZK.18.21"
            ]
          }
        },
