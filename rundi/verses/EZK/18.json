                "loc": "LEV.18.19"
              },
              "items": [
                {
                  "text": "Lew 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.9+EZK.22.10+EZK.22.11"
              },
              "items": [
                {
                  "text": "Ezk 22:9-11",
