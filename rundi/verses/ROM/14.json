          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūrya inyama yoye gukēngēra ūtazirya; kand’ ūtazirya yoye guhinyura ūzirya, kukw Imana yamwemeye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.3",
            "verseOrgIds": [
              "ROM.14.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
