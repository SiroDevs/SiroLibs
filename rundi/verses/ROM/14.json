          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu umwe ashima umusi umwe kuwurutisha iyindi; uwundi agashima imisi yose. Umuntu wese n’ashirwe mu mutima wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.5",
            "verseOrgIds": [
              "ROM.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
