        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw icatumye Kristo apfa, akazuka, ar’ ukugira ngw abe Umwami w’abāpfuye kandi n’uw’ abariho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
