              },
              "items": [
                {
                  "text": "Kol 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.3",
            "verseOrgIds": [
              "ROM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe uri nde uhinyura umushumba w’abandi? Kukw imbere ya shebuja ari ho ahagarara cank’ agatemba; mber’ ushime azohagarara, kuk’ Umwami wacu ashobora kumuhagarika.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
