          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye none rero, twoye guhinyurana; yamara tugire iyi migabo: ngo hoye kugira ūshira igitsitaza cank’ ikigwisha imbere ya mwene Se. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.13",
            "verseOrgIds": [
              "ROM.14.13"
            ]
          }
        },
        {
