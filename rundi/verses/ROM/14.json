          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu umwe afise ukwizera kwo kumurisha vyose, arik’ ūdakomeye arya ibirimwa gusa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.2",
            "verseOrgIds": [
              "ROM.14.2"
