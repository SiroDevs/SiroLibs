          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mwene So ababajwe n’ivy’ urya, ntuba ukigendera mu rukundo. Uwo Kristo yapfiriye ntumuranduze ivyo kurya vyawe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.15",
            "verseOrgIds": [
              "ROM.14.15"
            ]
          }
        },
