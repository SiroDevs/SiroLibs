          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabizi, kandi nemejwe neza n’Umwami Yesu, yukw ata gihumanya ubgaco; shit’ uwiyumvira kw ikintu gihumanya, ni we cohumanya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.14",
            "verseOrgIds": [
              "ROM.14.14"
            ]
          }
        },
        {
