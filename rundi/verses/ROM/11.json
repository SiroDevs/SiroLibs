                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yō, uburebure bg’amajepfo bg’ubutunzi bg’ubgenge no kumenya vy’Imana! Imigabo yayo ntishoboka kubariritswa, n’inzira zayo ntizigira akehe! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
