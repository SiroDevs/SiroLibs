                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, singomba ko mutamenya iri banga, mwoye kwiyita abanyabgenge, n’iry’ uko habaye gukomantaza imitima y’Abisirayeli, ariko si bose, gushitsa ah’ igitigiri gikwiye c’abanyamahanga kizokwinjirira mw ishengero. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.25",
            "verseOrgIds": [
              "ROM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni vyaba birtyo, Abisirayeli bose bazokizwa, nk’uko handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
