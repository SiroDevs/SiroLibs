                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo kumbure ntere ishari ab’i wacu, nkize bamwe muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.14",
            "verseOrgIds": [
              "ROM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko gutabga kwabo kwazaniye abari mw isi kwuzura n’Imana, ukugarukanwa kwabo kuzoba gute? Mbega ntikuzoba ubugingo buzutse mu bapfuye? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.15",
            "verseOrgIds": [
              "ROM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.17+NUM.15.18+NUM.15.19+NUM.15.20+NUM.15.21"
              },
              "items": [
                {
                  "text": "Guh 15:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kw ifu y’umushuzo ar’ iyera, n’irobe ni ko rimeze; kandi kw igishitsi ar’ icera, n’amashami ni kw ameze.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.16",
            "verseOrgIds": [
              "ROM.11.16"
            ]
          }
        }
      ]
