              "items": [
                {
                  "text": "1 Kor 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yamenye umutima w’Uhoraho? Canke ni nde yabaye umujanama wiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke ni nde yabanje kumuha kand’ akazokwishurwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.35",
            "verseOrgIds": [
              "ROM.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko vyose biva muri we, kandi bizanwa na we, kandi vyamuremewe: icubahiro kibe iciwe ibihe bidashira. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
            "verseOrgIds": [
              "ROM.11.36"
            ]
