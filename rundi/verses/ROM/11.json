            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None vyabaye bite se? Ic’ Abisirayeli bārondeye, ntibākibonye; ariko, abātoranijwe bārakironse, abandi bakomantazwa imitima. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.7",
            "verseOrgIds": [
              "ROM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
