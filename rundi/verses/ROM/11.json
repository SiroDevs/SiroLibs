        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.10"
              },
              "items": [
                {
                  "text": "Yes 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.4"
              },
              "items": [
                {
                  "text": "Gus 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uko handitswe, ngw Imana yabahaye umutima wo guhunyiza, n’amaso atabona, n’amatwi atumva, gushitsa kur’ uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.8",
            "verseOrgIds": [
              "ROM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Dawidi yaravuze,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.9",
            "verseOrgIds": [
              "ROM.11.9"
            ]
          }
        }
