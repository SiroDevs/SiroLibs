              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndababarira mwebge, abanyamahanga. Ndashimisha igikorwa canje, kuko nd’ intumwa ku banyamahanga, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.13",
            "verseOrgIds": [
              "ROM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
