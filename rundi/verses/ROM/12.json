                {
                  "text": "Heb 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mugabanirize abera, uko bakennye; mushishikare gutanga indāro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        },
