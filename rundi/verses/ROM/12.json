            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bene Data, ndabahanūra kubg’ imbabazi z’Imana, ngo mutange imibiri yanyu ibe ibimazi bizima vyera, bihimbara Imana, ni kwo kuyikorera kwanyu kwogira ikimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
