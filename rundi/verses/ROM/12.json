              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urukundo rwanyu rwoye kuba uruheyiheyi. Mwanke ibibi, mumatane n’ivyiza; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.9",
            "verseOrgIds": [
              "ROM.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.1.7"
              },
              "items": [
                {
                  "text": "2 Pet 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.3"
              },
              "items": [
                {
                  "text": "Flp 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku vyo gukunda bene Data, mukundane rwose; ku vy’icubahiro, umuntu wese ashire imbere mugenzi we; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.15"
              },
              "items": [
                {
                  "text": "Ivyah 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.25"
              },
              "items": [
                {
                  "text": "Ivyak 18:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku vy’ ugushishikara, ntimugire urwangara; mukovye mu mitima gukorera Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.17"
              },
              "items": [
                {
                  "text": "1 Tes 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munezererwe kwizigira ibizoba; mwihanganire amagorwa; mushishikare gusenga; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
            "verseOrgIds": [
              "ROM.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
