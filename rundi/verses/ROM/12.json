            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.4"
              },
              "items": [
                {
                  "text": "Gal 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimushushanywe n’ivy’ iki gihe, yamara muhinduke rwose, mugize imitima misha, kugira ngo mumenye neza ivy’ Imana igomba, ni vyo vyiza bishimwa, bitunganye rwose.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
