            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw Abisirayeli bākurikiye ivy’ ivyagezwe vy’ukugororoka, ntibābishikako. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
