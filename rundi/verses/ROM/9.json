              "items": [
                {
                  "text": "Yer 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "cank’ umubumvyi ntagera ibumba, mu mugoma umwe kubumbamw’ urwavya rumwe rwo gukoresha ivy’ icubahiro, n’urundi rwo gukoresha ibiteye isoni? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
