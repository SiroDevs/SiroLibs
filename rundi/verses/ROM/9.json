            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo yerekanire ubutunzi bg’ubgiza bgayo ku nzavya z’ikigongwe, izo yiteguriye guha ubgiza kera, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
