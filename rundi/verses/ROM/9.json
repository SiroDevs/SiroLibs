              "attrs": {
                "loc": "ISA.45.9"
              },
              "items": [
                {
                  "text": "45:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ga wa muntu, uri nde, uhārīra n’Imana? Mbeg’ icābūmbge cobaza uwakibumvye, kiti N’iki catumye umbumba urtya? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
