          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ Uhoraho azoshitsa ijambo ryiwe mw isi, ariringanize kand’ arihimbure. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
