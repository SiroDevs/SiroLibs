              "items": [
                {
                  "text": "Yer 50:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega har’ ico biriko, nah’ Imana yagomvye kwerekana uburake bgayo, no kumenyesha ubushobozi bgayo, namba yihangananiye imbabazi nyinshi inzavya z’ukuraka, ziteguriwe guhona; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
