              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yesaya asemerera ivy’ Abisirayeli, at’ Igitigiri c’Abisirayeli n’iyo coba nk’umusenyi wo ku kiyaga, amasigarira ni yo azokira: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
