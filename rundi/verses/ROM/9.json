          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko wombaza, uti N’iki gituma ikigaya umuntu? Ni nde yankiye ivy’ igomba? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
            "verseOrgIds": [
              "ROM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
