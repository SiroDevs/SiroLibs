                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ imirima yeze, aca ayitemesha umuhoro, kukw igihe c’ishwābūra kigeze.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.29",
