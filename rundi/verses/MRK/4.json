          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ababgira ijambo ry’Imana mu migani myinshi imwe n’iyo, uko bashobora kwumva. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ atabaciriye umugani nta co yababgira, ariko yihereranye n’abiwe bigishwa akabibasobanurira vyose.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
