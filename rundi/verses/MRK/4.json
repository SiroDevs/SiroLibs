            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busa n’akabuto ka sinapi, iyo gatewe mw ivu, nah’ ari kanzinya hanyuma y’imbuto zose ziri mw isi; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
