          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
