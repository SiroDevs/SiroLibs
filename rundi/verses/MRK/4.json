                  "text": "Luk 8:4-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atangura ukundi gusha kwigishiriza ku nkombe y’ikiyaga. Ishengero ryinshi cane rikoranira kuri we, bimutera gutambukira mu bgato buri mu kiyaga, yicaramwo, ishengero ryose riguma ku nkombe y’ikiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigisha vyinshi mu migani, ababgira mur’ ukwo kwigisha kwiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Ni mwumve; umubivyi yasohoye imbuto. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.3",
            "verseOrgIds": [
              "MRK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akibiba, zimwe zigwa i ruhande y’inzira; inyoni ziraza, zirazinobagura. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.4",
            "verseOrgIds": [
              "MRK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindi zigwa ku rutare, hatar’ ivu ryinshi; zica zimera vuba, kukw ata vu ryinshi ririho: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.5",
            "verseOrgIds": [
              "MRK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "izuba rirashe, ziraraba, kukw ata mizi zifise, zirūma. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.6",
            "verseOrgIds": [
              "MRK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindi zigwa mu mahwa, amahwa arakura, arazinyoha, ntizama. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.7",
            "verseOrgIds": [
              "MRK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izindi zigwa mw ivu ryiza, ziramera, zirakura, zihunda impeke, zimwe mirongwitatu, izindi mirongwitandatu, izindi ijana, birtyo birtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.8",
            "verseOrgIds": [
              "MRK.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ at’ Ūri n’amatwi yumva, ni yumve.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bīherereye, abāri kumwe na we na bamwe cumi na babiri bamubaza iyo migani; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.10",
            "verseOrgIds": [
              "MRK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.12"
              },
              "items": [
                {
                  "text": "1 Kor 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arabishura, ati Mwebge mwahawe ibanga ry’ubgami bg’Imana, arikw abo hanze babarirwa vyose mu migani: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.9"
              },
              "items": [
                {
                  "text": "Yes 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.40"
              },
              "items": [
                {
                  "text": "Yoh 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.26"
              },
              "items": [
                {
                  "text": "Ivyak 28:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo kurāba barābe, yamara ntibavyitegereze; kwumva bavyumve, yamara ntibabitahure; ngo kumbure bohindukira bagaharirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.12",
            "verseOrgIds": [
              "MRK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ arababaza, ati Ntimuzi uwo mugani? Non’ imigani yose muzoyitahura mute? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umubivyi abiba ijambo ry’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.14",
            "verseOrgIds": [
              "MRK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i ruhande y’inzira, ah’ iryo jambo ribibga, iyo bahejeje kwumva, Satani aca aza uwo mwanya, akabakūramw’ iryo jambo ryabibge muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.15",
            "verseOrgIds": [
              "MRK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’aba n’uko, ni bo bābibge ku rutare; iyo bumvise iryo jambo, baca baryākīrana umunezero, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.16",
            "verseOrgIds": [
              "MRK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntibagire imizi muri bo, ariko bahagarara umwanya muto, maz’ iyo bādutsweko n’amarushwa bo n’akadenderezo bazira iryo jambo, bica bibagwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.17",
            "verseOrgIds": [
              "MRK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi ni bo bābibge mu mahwa, abo ni bo bumva iryo jambo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.18",
            "verseOrgIds": [
              "MRK.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.23"
              },
              "items": [
                {
                  "text": "Mrk 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ umwitwaririko w’ivy’ isi n’uruhendo rw’ubutunzi no kwifuza ibindi, iyo bibinjiyemwo, binyoha iryo jambo, rikaba ikirumbirane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abābibge mw ivu ryiza, abo ni bo bumva iryo jambo bakaryemera, bagahunda impeke, umwe mirongwitatu, uwundi mirongwitandatu, uwundi ijana, birtyo birtyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.20",
            "verseOrgIds": [
              "MRK.4.20"
            ]
          }
        }
      ]
    },
