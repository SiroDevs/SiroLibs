          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivu rimeza ryonyene, habanza kuba ibironge, hanyuma hakaba imiyange, hanyuma hakaba amahundo atēngēngeye impeke. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
