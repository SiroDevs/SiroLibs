                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bgije agasinzira, bugaca akavyuka, imbuto zikamera, zigakura, atazi ingene zakuze. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
