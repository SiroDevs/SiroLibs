                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ ūfise azohabga, arik’ ūdafise azokwakwa n’ico yar’ asanzwe afise.",
          "type": "text",
