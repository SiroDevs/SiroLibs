                "loc": "JOL.2.2"
              },
              "items": [
                {
                  "text": "Yow 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw iyo misi izoba iy’ amarushwa atigeze kubaho, kuva kw itanguriro ry’ibiremwa Imana yaremye ugashitsa n’ubu, kand’ atazokwongera kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.19",
            "verseOrgIds": [
              "MRK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyaba Umwami Imana itogeruye iyo misi, ntihorokotse umuntu n’umwe, ariko kubg’ abatoranijwe yatoranije, yarayigeruye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe ni hagira umuntu ababgira, at’ Ehe Kristo ari hano; cank’ at’ Ari hariya: ntimuze muvyemere. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
              "MRK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.1"
              },
              "items": [
                {
                  "text": "Gus 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hazokwaduka abīgira Kristo n’abīgira abavugishwa n’Imana, bagakora ibimenyetso n’ibitangaza, kugira ngo bazimize n’abatoranijwe, ni vyashoboka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
              "MRK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mweho mwiyubare: rāba ndabibabgiye vyose bitaraba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.23",
            "verseOrgIds": [
              "MRK.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
