            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mur’ iyo misi abazoba batwaye inda n’abonsa bazobona ibara: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muze musenge kugira ngo ntibize bibe mu rushana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
