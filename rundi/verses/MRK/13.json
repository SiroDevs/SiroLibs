            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, aho muzobonera ca kizira c’ubuyobe bg’ubugesera gihagaze aho kidakwiye, (ūsoma ni yiyubare), ico gihe abazoba bar’ i Yudaya baze bahungire ku misozi miremire, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ūzoba ari hejuru ku nzu ntaze yururutswe no kwinjira gusahura ikintu cose mu nzu yiwe: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ūzoba ari mu mirima ntaz’ asubizwe inyuma no gusahura umutamana wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        }
      ]
    },
    {
