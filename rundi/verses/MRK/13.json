                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwiyubare: kuko bazobashengerana mu manza, muzoshishagurirwa mu masinagogi, kandi muzohagarara imbere y’abaganza n’abami babampōra, mube ikimenyetso kibabere icabona. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.9",
            "verseOrgIds": [
              "MRK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.15"
              },
              "items": [
                {
                  "text": "Mrk 16:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubutumwa bgiza bukwiye kubanza kuvugwa mu mahanga yose. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.10",
            "verseOrgIds": [
              "MRK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni babajana babashengeranye, ntimuze muhagarikire imitima ico muzovuga; ico muzohabga cose mur’ ako kanya, muze mube ari co muvuga: kukw atazoba ari mwebge muvuga, azoba ari Mpwemu Yera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.11",
            "verseOrgIds": [
              "MRK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.6"
              },
              "items": [
                {
                  "text": "Mik 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu azoshengerana uwo bavukana ngo bamwice, na se w’umwana azomushengerana, n’abana bazogābagābira abavyeyi babicishe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.12",
            "verseOrgIds": [
              "MRK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.21"
              },
              "items": [
                {
                  "text": "Yoh 15:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzoba mwanswe na bose, babahōra izina ryanje: arik’ uwihangana, agashitsa iherezo, ni we azokira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.13",
            "verseOrgIds": [
              "MRK.13.13"
            ]
          }
        }
      ]
    },
