        {
          "text": "Bugorovye, kuko war’ umusi wo Kwitegura, ni wo musi utangurira isabato, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
