          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "haza Yosefu w’i Arimataya, umunyekombe w’icubahiro, kandi na we yar’ areretse ubgami bg’Imana, ararinduka aja kuri Pilato, asaba ikiziga ca Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
