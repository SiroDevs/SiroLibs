            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hāriho n’abagore bāri kure babirāba, muri bo hārimwo Mariya Magadalene, na Mariya nyina wa Yakobo mutoya na Yose, hārimwo na Salome. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bagore, aho yaba i Galilaya, bāramukurikira bakamukorera: kandi hāriho n’abandi bagore benshi bāri badūganye na we i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
