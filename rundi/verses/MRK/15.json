          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agura impuzu yera, arakibambūra akizingira mur’ ino mpuzu, agishira mu mva yimbge mu bitandara, atembagaza ikibuye acugaza umuryango w’imva. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
