            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutwenzi utambitse, uwo mwanya abaherezi bakuru n’abashingantahe n’abanyabgenge b’ivyanditswe n’abashingantahe b’amakombe bose baja inama, baboha Yesu, baramujana, bamushikiriza Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        },
