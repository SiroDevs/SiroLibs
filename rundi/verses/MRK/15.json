          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Pilato biramutangaza ko yoba amaze gupfa; ahamagaza wa mugabisha w’abasoda, amubaza yukw amaze umwanya apfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.44",
            "verseOrgIds": [
              "MRK.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
