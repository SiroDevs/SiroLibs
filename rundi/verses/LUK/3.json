              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abarira abantu ubutumwa bgiza, abahanūrisha ibindi vyinshi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
