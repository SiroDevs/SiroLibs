                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ ahishutse umwami Herode ku vya Herodiya muka mwene se, no ku vy’ ibindi bibi vyose Herode yakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kur’ ivyo vyose Herode agerekakw iki, yugaranira Yohana mw ibohero.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
