            }
          ]
        },
        {
          "text": "Nukw abantu bose babatijwe, na Yesu ahejeje kubatizwa, arikw arasenga, ijuru rirakinguruka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
