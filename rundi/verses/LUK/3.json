            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.19+JHN.1.20+JHN.1.21+JHN.1.22+JHN.1.23+JHN.1.24+JHN.1.25+JHN.1.26+JHN.1.27+JHN.1.28"
              },
              "items": [
                {
                  "text": "Yoh 1:19-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abantu bāri barorereye ibizoba, bose bakabūranisha imitima ngo kumbure Yohana yoba Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.25"
              },
              "items": [
                {
                  "text": "Ivyak 13:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana ababarira bose, ati N’ukuri jeho ndababatirisha amazi, ariko hazoza ūndusha ubushobozi, ntibimbereye no gupfundurura utugozi tw’inkweto ziwe: uyo azobabatiza muri Mpwemu Yera no mu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urutaro rwiwe ruri mu kuboko kwiwe, ngw akubure imbuga yiwe neza, yimburire ingano mu kigega ciwe, maz’ umuguruka awuturire mu muriro utazima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
