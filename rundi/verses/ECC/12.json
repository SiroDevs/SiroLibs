            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amajambo y’abanyabgenge ni nk’imihunda, kand’ amajambo atororokanijwe ni nk’imambo zishimangiwe, umwungere umwe ari we yayatanze. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
