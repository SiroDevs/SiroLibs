          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "izuba n’umuco n’ukwezi n’inyenyeri bitaracura umwiza, kand’ ibicu bitaragaruka imvura imaze guhita; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
