              "type": "text"
            }
          ]
        },
        {
          "text": "Vyongeye kandi, Umusiguzi kuko yar’ umunyabgenge yashishikaye kwigisha abantu ubgenge; mbere yakoze irya n’ino, araserangura, aroranya imigani myinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
