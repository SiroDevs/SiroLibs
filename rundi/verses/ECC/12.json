              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wame wibuka Umuremyi wawe mu misi y’ubusore bgawe, imisi mibi itaraza, igihe kitarashika, ah’ uzovuga, uti Nta kikinnezereza; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
