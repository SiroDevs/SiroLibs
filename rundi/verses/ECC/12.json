          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisigaye, mwana wanje, uhanurwe: kwandika ibitabo vyinshi ntikugira iherezo; kand’ ukwiga cane kuruhisha umubiri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
