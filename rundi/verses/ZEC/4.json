              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umumarayika twavugana aragaruka, arankangura, nk’ uk’ umuntu akangurwa ava mw itiro: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.1",
            "verseOrgIds": [
              "ZEC.4.1"
            ]
          }
        },
        {
          "name": "verse",
