            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nzobiba amahoro; umuzabibu uzokwama inzabibu zawo, isi yimbuke ivyimburo vyayo, ikirēre kizane ikime caco; ivyo vyose nzobiha amasigarira y’ubu bgoko k’umwandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
