            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uhoraho yarakiye cane ba sogokuruza banyu. ",
          "type": "text",
