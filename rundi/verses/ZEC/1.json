          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.10"
              },
              "items": [
                {
                  "text": "Yob 14:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
