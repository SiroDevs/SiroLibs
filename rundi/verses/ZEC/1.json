            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mureke kuba nka ba sogokuruza banyu, abo navugisha kera bābabarira basemerera, bat’ Uku ni k’Uhoraho Nyen’ ingabo agize, at’ Enda ni muhindukire muve mu ngeso zanyu mbi no mu bikorwa vyanyu bibi; maze ntibumva, nanje ntibanyumvira, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
