              "items": [
                {
                  "text": "Dan 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw amajambo yanje n’ivyagezwe vyanje nageze abasavyi banje navugisha, mbega ntivyashitse kuri ba sogokuruza? Maze bīsubiramwo, baravuga, bati Nk’uk’ Uhoraho Nyen’ ingabo yagabiye kw azotugirira, ngw atwishure ibihwanye n’ingeso zacu n’ivyo twakoze, ni ko yadukoreye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
