            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubg’ ivyo uz’ ubabgire, ut’ Uku ni k’Uhoraho Nyen’ ingabo agize, ati Ni mungarukeko, ni k’Uhoraho Nyen’ ingabo agize, nanje nzobagarukako, ni k’Uhoraho Nyen’ ingabo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
