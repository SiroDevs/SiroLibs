            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nunamuye amaso mbona amahembe ane. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.18",
            "verseOrgIds": [
              "ZEC.1.18"
