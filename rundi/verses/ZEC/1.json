              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nshavuriye cane amahanga yidibamiye, kuko Yerusalemu nari mpashavuriye buhoro, maze bo bakahasonga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
