            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma Uhoraho avuga, ati Ngarukiye Yerusalemu nzanye imbabazi; ingoro yanje izohubakwa, ni k’ Uhoraho Nyen’ ingabo agize: i Yerusalemu hazogereshwa umugozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "verse",
