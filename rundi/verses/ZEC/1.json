              "items": [
                {
                  "text": "Yoh 8:52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba sogokuruza banyu bari hehe? Cank’ abo navugishije mbega bokwamyeh’ ibihe vyose? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
