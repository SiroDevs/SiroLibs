                "loc": "LUK.2.51"
              },
              "items": [
                {
                  "text": "51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo majambo agarukiye aho. Ariko jewe Daniyeli ivyiyumviro vyanje bimpagarika umutima, mu maso hanje harahindurira; arikw ayo majambo ndayabīka mu mutima wanje.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
