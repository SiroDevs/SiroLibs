              "items": [
                {
                  "text": "Dan 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.19"
              },
              "items": [
                {
                  "text": "Luk 2:19",
