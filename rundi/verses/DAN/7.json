            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruzi rw’ umuriro rwiburuka ruva imbere yiwe; ibihumbi n’ibihumbi baramukorera, kand’ amasinzi n’amasinzi bari bahagaze imbere yiwe. Imanza zirashingwa, ibitabo birazingururwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.10",
            "verseOrgIds": [
              "DAN.7.10"
            ]
          }
        },
