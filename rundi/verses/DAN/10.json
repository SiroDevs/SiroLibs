          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.4"
              },
              "items": [
                {
                  "text": "Ivyak 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
              },
              "items": [
                {
                  "text": "Ivyah 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambgira, ati Nta co utinya, Daniyeli; kuk’ uhereye umusi washiriye umutima ku gutahura, no kwicisha bugufi imbere y’Imana yawe, amajambo yawe yarumviswe; kand’ ayo majambo yawe nyene ni yo anzanye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.12",
            "verseOrgIds": [
              "DAN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 10:13"
          },
          "items": [
