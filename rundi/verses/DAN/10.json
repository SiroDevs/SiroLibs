                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none nzanywe no kugutahuza ibizoba ku bgoko bganyu mu misi y’iherezo; kukw ivyo weretswe ar’ ibizoba hahise igihe kirekire. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.14",
            "verseOrgIds": [
              "DAN.10.14"
            ]
          }
        },
        {
