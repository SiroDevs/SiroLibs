          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko haza ukuboko kunkorako, bituma mpfukamika amavi n’ibiganza njugumira. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.10",
            "verseOrgIds": [
              "DAN.10.10"
            ]
