              "attrs": {
                "loc": "DAN.9.23"
              },
              "items": [
                {
                  "text": "Dan 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambgira, ati Daniyeli, muntu w’ umukundwa cane, utahure amajambo ngira nkubgire, va hasi uhagarare, kuk’ ubu ngutumweko. Amaze kumbgira iryo jambo, mpagarara mpinda agashitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.11",
            "verseOrgIds": [
              "DAN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
