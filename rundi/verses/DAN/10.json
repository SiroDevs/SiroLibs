              "items": [
                {
                  "text": "Ivyah 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunamuye amaso mbona umuntu yambaye impuzu zera, akenyeje izahabu nziza zavuye muri Ufazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.5",
            "verseOrgIds": [
              "DAN.10.5"
            ]
          }
        },
