              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umubiri wiwe wasa n’akabuyenge kitwa tarushishi, mu maso hiwe hasa n’umuravyo, amaso yiwe yasa n’imuri z’umuriro, amaboko yiwe n’ibirenge vyiwe vyasa n’umuringa w’umwakaka, kand’ ijwi ry’amajambo yiwe ryari rimeze nk’iry’ ishengero ry’abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.6",
            "verseOrgIds": [
              "DAN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.7"
              },
              "items": [
                {
                  "text": "Ivyak 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe Daniyeli gusa nabonye ivyo vyerekanywe, yamar’ abantu twari kumwe ntibabibonye, ariko bafatwa n’agatengo gakomeye, barahunga barihisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.7",
            "verseOrgIds": [
              "DAN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.28"
              },
              "items": [
                {
                  "text": "Dan 7:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko jeho nsigaraho nd’umwe, mbona ivyo vyerekanywe bihambaye, maze sinasigarana inkomezi na nkeya, mu maso hanje harahīndāna, ndadendebukirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.8",
            "verseOrgIds": [
              "DAN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.18"
              },
              "items": [
                {
                  "text": "Dan 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.17"
              },
              "items": [
                {
                  "text": "Ivyah 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara numva ijwi ry’amajambo yiwe; nkiryumva, nzimira ubgenge, ndubama, ncurika umutwe hasi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.9",
            "verseOrgIds": [
              "DAN.10.9"
            ]
          }
        }
      ]
    },
