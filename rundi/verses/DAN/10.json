          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambgiye ayo majambo, ncurika umutwe, mba ikiyingiyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.15",
            "verseOrgIds": [
              "DAN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 10:16"
