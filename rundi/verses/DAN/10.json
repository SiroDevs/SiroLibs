              "items": [
                {
                  "text": "Dan 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambgira, at’ Ewe muntu w’umukundwa cane, nta co utinya: mpore, mpore, gira amahoro! Akibimbgira, nca ndaremerana, ndavuga, nti Databuja n’uvuge, kuk’ unsubijemw’ intege. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.19",
            "verseOrgIds": [
              "DAN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
