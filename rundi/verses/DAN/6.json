                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami aca aranezerwa cane, avuga ko bakūra Daniyeli muri rwa rwobo. Nuko Daniyeli akūrwa mu rwobo, nta n’agakwabu kabonetse kuri we, kuko yari yizigiye Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        },
