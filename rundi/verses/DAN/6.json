              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yanje yarungitse umumarayika wayo, azibira iminwa y’intambge, nta co zankozeko; kuko nabonetse imbere yayo ntagira igicumuro, kandi nawe, mugenzi, nta kibi nakugiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
