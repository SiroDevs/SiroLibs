            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dariyo abona kw ari vyiza kugabanganya igihugu abaganwa ijana na mirongwibiri, ngo bakwire igihugu cose. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.1",
            "verseOrgIds": [
              "DAN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ashira hejuru yabo abakuru batatu bo kubaganza, umwe muri bo yari Daniyeli; kwar’ ukugira ngw abo baganwa babashikirize ivyo bātoje, ng’ umwami ntagire ico ahomba. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.2",
            "verseOrgIds": [
              "DAN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.40"
              },
              "items": [
                {
                  "text": "Ita 41:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.10.3"
              },
              "items": [
                {
                  "text": "Est 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.12"
              },
              "items": [
                {
                  "text": "Dan 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Daniyeli aba agakomeye kuruta abandi bakuru n’abaganwa, kuko yarimw’ ubgenge bg’agahebuza; mber’ umwami yiyumvira kumwegurira kuganza igihugu cose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.3",
            "verseOrgIds": [
              "DAN.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
