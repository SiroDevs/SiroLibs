              "items": [
                {
                  "text": "Flp 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba bakuru n’abaganwa baherako barondera urwitwazo rw’ ico borega Daniyeli ku vy’igihugu; ariko bamuburak’ urwitwazo na rumwe cank’ igitiriganye; kuko yar’ umwizigirwa, ntabonekekw amafuti cank’ igitiriganye na kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye abo bagabo baravugana, bati Nta rwitwazo tuzoronka kuri Daniyeli, shiti tururonse mu vy’ivyagezwe vy’Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bakuru n’ abaganwa bakondorera ku mwami Dariyo, baramubgira, bati Mwami nyaguhoraho; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.6",
            "verseOrgIds": [
              "DAN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakuru bose b’igihugu, n’ivyēgēra vyawe, n’ abaganwa n’abacamanza n’abagabisha, bagiye inama ngo hashingwe icagezwe cawe, no gushirah’ icihanikirizo gihambaye, ngo kumara imisi mirongwitatu umuntu wese azogira imana n’imwe asaba, cank’ umuntu n’umwe, atari wewe, mugenzi, az’ atererwe mu rwobo rw’intambge. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.7",
            "verseOrgIds": [
              "DAN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.19"
              },
              "items": [
                {
                  "text": "Est 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.8.8"
              },
              "items": [
                {
                  "text": "8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, mugenzi, shinga ico cihanikirizo, wisinye ku candiko caco, kugira ngo coye kuzohindurwa, nk’ukw ivyagezwe vy’Abamedi n’Abaperesi bidahinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami Dariyo asinya ku candiko c’ico cihanikirizo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.48"
              },
              "items": [
                {
                  "text": "1 Abam 8:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.28.2"
              },
              "items": [
                {
                  "text": "Zab 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.55.17"
              },
              "items": [
                {
                  "text": "55:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.138.2"
              },
              "items": [
                {
                  "text": "138:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Daniyeli amenye kw ico candiko casinyweko, aja i we; kand’ amadirisha y’inzu yiwe yerekeye i Yerusalemu yama yuguruye; akomeza gupfukama gatatu‐gatatu ku musi, asenga Imana yiwe ayikengurukira, nk’uko yar’ asanzwe abigenza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.10",
            "verseOrgIds": [
              "DAN.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye ba bagabo barakondora, basanga Daniyeli asenga Imana yiwe, ayinginga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.11",
            "verseOrgIds": [
              "DAN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraza bavugira imbere y’umwami ivya ca cihanikirizo ciwe, bati Mbega ntiwasinye ku cihanikirizo washinze, yuko kumara imisi mirongwitatu umuntu wese azogira imana n’imwe asaba cank’ umuntu n’umwe, atari wewe, mugenzi, azotererwa mu rwobo rw’intambge? Umwami arabishura, ati Narabishinze koko, nk’ukw ivyagezwe vy’Abamedi n’ Abaperesi bishingwa ntibihinduke. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baca bishura umwami, bat’ Ariko Daniyeli we wo mu banyagano b’Abayuda, ntaruha akubara, mugenzi, canke ca cihanikirizo wasinyeko, arikw asenga gatatu‐gatatu ku musi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.13",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.26"
              },
              "items": [
                {
                  "text": "Mrk 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami yumvise iryo jambo biramutuntuza, ashira umutima kuri Daniyeli kugira ngw amukize; yihambirira ku vyo kurokora Daniyeli gushitsa izuba rirenze. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.14",
            "verseOrgIds": [
              "DAN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bagabo bongera gukondorera ku mwami, baramubgira, bati Mugenzi, umenye kw ar’icagezwe c’ Abamedi n’Abaperesi ngo nta cagezwe cank’ ibgirizwa umwami yashinze vyohinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.23"
              },
              "items": [
                {
                  "text": "Ivyak 27:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.10"
              },
              "items": [
                {
                  "text": "2 Kor 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami apfa kubigera, bazana Daniyeli, bamuterera mu rwobo rw’intambge. Maz’ umwami abgira Daniyeli, at’ Imana yawe wama ukorera iragukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.12"
              },
              "items": [
                {
                  "text": "Est 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.3.53"
              },
              "items": [
                {
                  "text": "Int 3:53",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.66"
              },
              "items": [
                {
                  "text": "Mat 27:66",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.3"
              },
              "items": [
                {
                  "text": "Ivyah 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bazana ikibuye, bacubika ku munwa w’urwobo, bagihomakw ishashara, ayidomamw’ ikimenyetso ciwe bgite, n’ikimenyetso c’ abaganwa biwe, kugira ngo ntihagire igihindurwa mu vya Daniyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.6.1"
              },
              "items": [
                {
                  "text": "Est 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami asubira mu ngoro yiwe, akesha ijoro adafūnguye, ata n’ivyo kumunezereza bamuzanira; ntiyaruha agoheka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
              "DAN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoro rikeye mu mutwenzi umwami aravyukuruka, agenda yihuta aja kuri rwa rwobo rw’intambge. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
              "DAN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
