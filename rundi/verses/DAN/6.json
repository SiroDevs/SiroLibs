            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashitse hafi ya rwa rwobo Daniyeli yarimwo, ahamagara n’ijwi ry’umubabaro, abaza Daniyeli, ati Yewe Daniyeli musavyi w’Imana nzima, mbeg’ Imana yawe ukorera na ntaryo yashoboye kugukiza izo ntambge? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.20",
            "verseOrgIds": [
              "DAN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
