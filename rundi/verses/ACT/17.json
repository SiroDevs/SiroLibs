          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko muri yo ari ho tubeshejweho, tugenda, turi n’ubugingo; nk’uko na bamwe bo mu bigeneye indirimbo banyu bāvuze,",
          "type": "text",
          "attrs": {
