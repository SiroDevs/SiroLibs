              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana Rurema, yaremye isi n’ibirimwo vyose, iyo, kukw ari yo Mwami w’ijuru n’isi, ntiba mu nsengero zubatswe n’amaboko, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
