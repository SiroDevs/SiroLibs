              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ntikorerwa n’amaboko y’abantu, nk’ūri n’ic’ akennye: kukw ari yo yahaye bose ubugingo, no guhumeka, n’ibindi vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
