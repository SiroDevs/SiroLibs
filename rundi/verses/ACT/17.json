            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo barondere Imana, ngo namba kumbure bakabakavye boyibona, nah’ itari kure y’umuntu n’umwe muri twebge. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
