          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batemeranije ubgabo barataha, Paulo asubiye kuvuga ijambo rimwe, at’ Ivyo Mpwemu Yera yabaririye ba sogokuruza banyu mu kanwa k’uwavugishwa n’Imana Yesaya, yabivuze neza,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
