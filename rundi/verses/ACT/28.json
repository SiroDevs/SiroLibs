          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bamwe bemera ivyo avuze, abandi ntibāvyemera. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
