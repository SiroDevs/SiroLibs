                {
                  "text": "Ivyak 23:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Feliki, kuko yar’ azi neza ivy’ Iyo Nzira ivy’ ari vyo, arabibīka, ati Lusiya umukuru w’abagabisha b’abasoda ni yaza, nzoca urubanza rw’amajambo yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.22",
            "verseOrgIds": [
              "ACT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
