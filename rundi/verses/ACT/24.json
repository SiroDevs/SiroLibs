            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.3"
              },
              "items": [
                {
                  "text": "Ivyak 27:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarira umugabisha w’abasoda ijana kumurinda urw’ amaso, no kutabuza n’umwe mu bagenzi kumukorera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        }
