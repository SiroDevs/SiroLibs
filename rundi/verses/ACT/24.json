                {
                  "text": "Ivyak 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imyaka ibiri ishize, Porukiyo Fesito akūra Feliki. Maze Feliki agomvye kwikundisha Abayuda asiga Paulo akiboshwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.27",
