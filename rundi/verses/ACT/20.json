          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ntacishije i ruhande mbabgira ivy’ Imana yagabiye vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.27",
            "verseOrgIds": [
