                  "text": "Ivyak 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma mbashingira intahe uyu musi ncuna, yukw amaraso ya bose atazonkora, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.26",
            "verseOrgIds": [
              "ACT.20.26"
            ]
