              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi none rāba, ndazi yuko mutazosubira kubona mu maso hanje, abo naciyemwo mwese mbabgira ivy’ ubgami bg’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.25",
            "verseOrgIds": [
              "ACT.20.25"
            ]
          }
