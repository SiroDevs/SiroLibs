            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko simbabaye ubugingo bganje nk’ah’ ar’ubg’ igiciro, kugira ngo ndangize urugendo rwanje, n’igikorwa nahawe n’Umwami Yesu, co gushingira intahe ubutumwa bgiza bg’ubuntu bg’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        },
        {
