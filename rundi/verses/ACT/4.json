          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi wavugiye mu kanwa ka sogokuruza Dawidi, umusavyi wawe, ubivugisha Mpwemu Yera,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.25",
            "verseOrgIds": [
              "ACT.4.25"
