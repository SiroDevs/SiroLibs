            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosefu, uwo intumwa zise Barunaba, risobanurwa ng’Umwana wo guhanūra, Umulewi yavukiye i Kupuro, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
