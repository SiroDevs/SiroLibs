              "items": [
                {
                  "text": "Ivyak 2:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ intumwa zāshingira intahe ukuzuka kw’Umwami Yesu ziri n’ubushobozi bginshi, kand’ ubuntu bg’Imana bginshi buba kuri bo bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 4:34"
          },
          "items": [
