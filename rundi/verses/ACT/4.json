                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bavyumvise bavuga n’ijwi rirenga, babgira Imana n’umutima uhūye, bati Databuja, ni wewe waremye ijuru n’isi, n’ikiyaga n’ibirimwo vyose, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.24",
            "verseOrgIds": [
              "ACT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
