        },
        {
          "text": "Bakivugana n’abantu, abaherezi bazanana aho bari n’umukuru w’abashibamyi b’urusengero, n’Abasadukayo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.1",
