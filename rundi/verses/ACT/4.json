          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko barekuwe basubira muri bagenzi babo, babīgānira ivyo abaherezi bakuru n’abakuru bababgiye vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.23",
            "verseOrgIds": [
              "ACT.4.23"
            ]
