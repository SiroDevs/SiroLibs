              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashishikara cane mu vyo intumwa zigisha, no kugira ubumwe, no kumanyagura umutsima no gusenga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
