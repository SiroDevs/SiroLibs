              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.31"
              },
              "items": [
                {
                  "text": "Ivyak 4:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.44+ACT.10.45+ACT.10.46"
              },
              "items": [
                {
                  "text": "10:44-46",
                  "type": "text"
