                "loc": "ISA.52.13"
              },
              "items": [
                {
                  "text": "Yes 52:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.11"
