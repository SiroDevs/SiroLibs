                "loc": "LUK.24.27"
              },
              "items": [
                {
                  "text": "Luk 24:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo Imana yavugiye mu kanwa k’abāvugishwa na yo bose bitaribgabe, yuko Kristo wayo azobabazwa, ivyo yabishikije irtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.18",
            "verseOrgIds": [
              "ACT.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.38"
              },
              "items": [
                {
                  "text": "Ivyak 2:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwihane, muhindukire, ivyaha vyanyu bihanagurwe, ibihe vyo guhēmbūka bibone ingene biza, bivuye mu nyonga z’Umwami Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.19",
            "verseOrgIds": [
              "ACT.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo na yo iz’ itume Kristo yabatoranirijwe kera, ni we Yesu. ",
          "type": "text",
          "attrs": {
