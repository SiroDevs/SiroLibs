                "loc": "ACT.5.12"
              },
              "items": [
                {
                  "text": "Ivyak 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agifashe Petero na Yohana, abantu bose birukira kuri bo, bakoranira kw ibaraza ryitwa irya Salomo, batangaye cane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.11",
            "verseOrgIds": [
              "ACT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero abibonye, abaza abo bantu, ati Yemwe bagabo b’Abisirayeli, n’iki gitumye mutangazwa n’ibi, muduhangiye amaso iki, nk’ah’ ubushobozi bgacu cank’ ukwubaha Imana kwacu ari vyo vyaduhaye kumugendesha? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.12",
            "verseOrgIds": [
              "ACT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
