                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuntu wese atazokwumvira uno avugishwa n’Imana, azorandurwa mu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.23",
            "verseOrgIds": [
              "ACT.3.23"
            ]
          }
        },
