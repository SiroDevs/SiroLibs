            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.10"
              },
              "items": [
                {
                  "text": "Ivyak 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.31"
              },
              "items": [
                {
                  "text": "5:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.10"
              },
              "items": [
                {
                  "text": "Heb 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa Mukuru w’ubugingo muramwica; arikw Imana muzura mu bapfuye, natwe tur’ ivyabona vyo gushingira intahe ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.15",
            "verseOrgIds": [
              "ACT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uyu, uwo mubona kandi muzi, kuko yizeye izina ry’uwo, iryo zina ryamuhaye inkomezi: mber’ ukwizera ahawe na we ni kwo kumukirije rwose imbere yanyu mwese.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.16",
            "verseOrgIds": [
              "ACT.3.16"
            ]
          }
        }
      ]
    },
