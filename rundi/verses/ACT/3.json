                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose koko yaravuze, at’ Uhoraho Imana azobahagurukiriza ūvugishwa na we mu b’i wanyu ameze nkanje; uwo muze mumwumvire mu vy’ azobabarira vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.22",
            "verseOrgIds": [
              "ACT.3.22"
            ]
          }
        },
        {
          "name": "verse",
