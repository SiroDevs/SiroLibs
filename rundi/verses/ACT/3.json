                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.13"
              },
              "items": [
                {
                  "text": "1 Tim 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi none, bene Data, ndazi yuko mwabikoze mutabizi, n’ababaganza na bo n’uko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.17",
            "verseOrgIds": [
              "ACT.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
