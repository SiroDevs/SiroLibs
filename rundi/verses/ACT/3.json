              "type": "text"
            }
          ]
        },
        {
          "text": "Mber’ abāvugishwa n’Imana bose, uhereye kuri Samweli n’abāmukurikiye, abāvuze bose bāramenyekanishije ivy’ iyi misi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.24",
