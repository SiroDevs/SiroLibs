              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mweho mwihakana Uwera kand’ Umugororotsi, musaba ko babarekurira umwicanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.14",
            "verseOrgIds": [
              "ACT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
