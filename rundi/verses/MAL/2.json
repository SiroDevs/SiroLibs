          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.45"
              },
              "items": [
                {
                  "text": "Guh 3:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.12"
              },
              "items": [
