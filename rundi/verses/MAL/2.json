              "items": [
                {
                  "text": "1 Sam 2:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje ni co gitumye mbahindura inkēngērwa, nkabacisha bugufi imbere y’abantu bose, kuko mutakomeje inzira zanje, ariko mukarobanura abantu ku cubahiro mu vy’ivyagezwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.9",
            "verseOrgIds": [
              "MAL.2.9"
            ]
          }
        }
