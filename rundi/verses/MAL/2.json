                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ho muzomenyera kw ari jewe nabarungikiye iryo bgirizwa, kugira ngw isezerano nasezeranye na Lewi rimugumeko, ni k’Uhoraho Nyen’ ingabo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.4",
            "verseOrgIds": [
              "MAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.10"
              },
              "items": [
                {
                  "text": "Yes 54:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isezerano nasezeranye na we ryar’ iry’ ubugingo n’amahoro; nabimuhaye ngw anyubahe: maz’ aranyubaha, ahindishwa agashitsi n’izina ryanje. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.5",
            "verseOrgIds": [
              "MAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.3"
              },
              "items": [
                {
                  "text": "Dan 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.20"
              },
              "items": [
                {
                  "text": "Yak 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icagezwe c’ukuri caba mu kanwa kiwe, kandi mu minwa yiwe nta bigoramye vyahumvikana; yagendana nanje mu mahoro no mu bugororotsi, yahindura benshi bakareka ibigabitanyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.6",
            "verseOrgIds": [
              "MAL.2.6"
            ]
          }
        },
        {
