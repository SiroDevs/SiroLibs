            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwanka kwumva, mukanka kurishirak’ umutima, ntimuheshe izina ryanje icubahiro, ni k’Uhoraho Nyen’ ingabo agize, nzobavuma wa muvumo, n’imigisha yanyu nzoyivuma; mbere mmaze no kuyivuma, kuko mutarishizek’ umutima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.2",
            "verseOrgIds": [
              "MAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
