              "items": [
                {
                  "text": "Hag 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw akanwa k’umuherezi gakwiye kuzigama ubgenge, kandi mu kanwa kiwe ni ho bakwiye kubariza ivyagezwe: kukw ari we ntumwa y’ Uhoraho Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.7",
            "verseOrgIds": [
              "MAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.17"
              },
              "items": [
                {
                  "text": "1 Sam 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.26"
              },
              "items": [
                {
                  "text": "Ezk 22:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mweho mwarakebeje muta inzira; mutsitaje benshi mu vy’ivyagezwe; mwononye isezerano rya Lewi, ni k’Uhoraho Nyen’ ingabo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.8",
            "verseOrgIds": [
              "MAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 2:9"
          },
          "items": [
