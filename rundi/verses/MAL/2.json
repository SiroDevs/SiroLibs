            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba nzovuma imbuto zanyu, ari mwebge mubinteye, kandi nzobasīga mu maso amayezi y’ibimazi vyanyu; muzoyoranwa na yo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.3",
            "verseOrgIds": [
              "MAL.2.3"
            ]
          }
        },
        {
