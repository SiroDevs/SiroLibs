        },
        {
          "text": "Mbega twese ntidusangiye Data? Imana yaturemye s’imwe? None n’iki gituma turyarukana, umuntu wese aryaruka mwene wabo, tukica isezerano ryasezeraniwe ba sogokuruza? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.10",
            "verseOrgIds": [
              "MAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 2:11"
          },
          "items": [
