                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uhereye iy’ izuba rirasira ugashitsa iyo rirengera izina ryanje rirahambaye mu banyamahanga; kand’ ahantu hose barosereza izina ryanje imibavu, baranshikanira amashikanwa atunganye, kukw izina ryanje rihambaye mu banyamahanga, ni k’Uhoraho Nyen’ ingabo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mweho murarihumanya, kuko muvuga, mut’ Ameza y’Uhoraho aranduye, kandi n’ivyo aduhēra kuri yo vy’ivyo kurya n’ibikēngēretse. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
