                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icompa hakagira n’umwe muri mwebge yugara inzugi, ngo mureke gucanira ubusa ku gicaniro canje! Simbanezererwa na gatoya, ni k’Uhoraho Nyen’ ingabo agize, kandi sinzokwemera ishikanwa munshikaniye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 1:11"
          },
          "items": [
            {
