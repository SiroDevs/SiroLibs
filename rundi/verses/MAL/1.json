              "items": [
                {
                  "text": "Mal 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikindi muvuga, mut’ Ewe miruho turimwo! kandi muravyimyoza, ni k’Uhoraho Nyen’ ingabo agize; kandi muzana ico munyaze, n’igicumbagira n’ikirwaye: uko ni ko muzana amashikanwa. Mbega ben’ ayo mashikanwa noyemera? ni k’Uhoraho abaza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
