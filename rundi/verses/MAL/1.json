                {
                  "text": "Yer 49:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.35.3"
              },
              "items": [
                {
                  "text": "Ezk 35:3",
