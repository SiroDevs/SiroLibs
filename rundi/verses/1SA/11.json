                {
                  "text": "Luk 19:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu babarira Samweli, bati Mbega ni ba nde bavuze, ngw Aho Sauli ni we yotuganza? Ni muzane abo bantu, tubice. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.12",
            "verseOrgIds": [
              "1SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
