                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.22"
              },
              "items": [
                {
                  "text": "2 Sam 19:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Sauli aravuga, ati Nta muntu yokwicwa uyu musi, kuk’ uyu musi Uhoraho ahaye Abisirayeli intsinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.13",
            "verseOrgIds": [
              "1SA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.8"
              },
              "items": [
                {
                  "text": "1 Sam 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.4"
              },
              "items": [
                {
                  "text": "13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.33"
              },
              "items": [
                {
                  "text": "15:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samweli abarira abantu, ati Ni muze tuje i Gilugali, dusubire dukomeze ivy’ ubgami. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.14",
            "verseOrgIds": [
              "1SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bose baja i Gilugali, bimikira Sauli imbere y’Uhoraho aho nyene i Gilugali, bahatangira ibimazi vy’ishimwe imbere y’Uhoraho: nuko Sauli n’Abisirayeli bose bahagirira akanyamuneza kenshi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.15",
            "verseOrgIds": [
              "1SA.11.15"
            ]
          }
        }
      ]
    }
  ],
