              "items": [
                {
                  "text": "Zab 18:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli akirikw arosa ico kimazi, Abafilisitiya bēgereza Abisirayeli ngo bashireko, barwane. Arik’ Uhoraho kuri nya musi nyene aturikira hejuru y’ Abafilisitiya guturagara guhāmbāye, abaca umuhongo; Abisirayeli ni kwo kubanesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabo z’ Abisirayeli ziva i Misipa, bakinagiza Abafilisitiya babica ingenda kurinda bashika musi y’i Beti‐kari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
