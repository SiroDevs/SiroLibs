              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Samweli aravuga, at’ Abisirayeli bose ni mubakoranirize i Misipa, nanje nzobasengera k’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
