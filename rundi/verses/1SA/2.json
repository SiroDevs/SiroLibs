                "loc": "DEU.18.3"
              },
              "items": [
                {
                  "text": "Gus 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ivy’imituri abaherezi bāgenewe ku bimazi vy’abantu. Iy’ umuntu atanze ikimazi, inyama zigitētswe, umusuku w’ umuherezi yaraza, afise icuma mu ntoke cārura inyama c’ingobe zitatu; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akagita mw isafuriya, canke mw ibinika, canke mu nkono, canke mu kazīhebe; maz’ iz’ ico cuma cājabura zose, umuherezi yarazītwarira. Uko ni ko bāgirira Abisirayeli bose uko bagiye i Shilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
