            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo N’iki gituma mutimamukira ibimazi vyiwe n’amashikanwa yiwe, ivyo yashinze ko bamuzanira mu ngoro yiwe, ng’ Ukūbaha abahungu bawe kubamurutisha, mukīgaburira ibinoboye vyo mu bimazi vyose abantu biwe b’Abisirayeli bamushikanira, mukīvyibuhira? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
