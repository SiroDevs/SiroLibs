              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere batarosa ibinure, umusuku w’umuherezi yaraza, akabarira ūtanze ikimazi, ati N’umpe inyama zo gutarira umuherezi, kukw atagomba k’umuha izitētse, atar’ imbisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muntu yamwishura, ati Hinge babanze bose ibinure, uheze ubone gutwara iz’ ugomba; na we akamubarira, at’ Oya, urazimpa ubu nyene: utazimpaye ndazitwara wanse ukunze! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.8"
              },
              "items": [
                {
                  "text": "Mal 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw icaha c’abo basore cabaye igikomeye imbere y’Uhoraho, kuko bākēngēra ikimazi ciwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
