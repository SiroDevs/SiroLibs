        },
        {
          "text": "Kandi bene Eli bār’ abanyangeso mbi; bāpfa uko bagize ivy’ Uhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
