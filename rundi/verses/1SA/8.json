            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.19"
              },
              "items": [
                {
                  "text": "1 Sam 8:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.20"
              },
              "items": [
                {
                  "text": "20",
