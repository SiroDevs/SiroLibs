              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samweli ageze mu zabukuru, abahungu biwe abagira abacamanza b’Abisirayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.1",
            "verseOrgIds": [
              "1SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "imfura yiwe yitwa Yoweli, uw’ ubuheta yitwa Abiya. Baba abacamanza b’i Beri‐sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.2",
            "verseOrgIds": [
              "1SA.8.2"
            ]
          }
        },
        {
