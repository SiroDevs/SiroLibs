                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abaganwa b’Abafilisitiya bagenda bajanye ingabo zabo, hamwe ijana‐ijana, ahandi igihumbi‐igihumbi; kandi Dawidi n’ingabo ziwe bazanana na Akishi babakurikiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
