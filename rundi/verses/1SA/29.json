            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.7"
              },
              "items": [
                {
                  "text": "1 Sam 27:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abagabisha b’Abafilisitiya barabaza, bati Mbeg’ abo Baheburayo bakora iki hano? Akishi yishura abo bagabisha b’Abafilisitiya, at’ Uyu si Dawidi, yar’ umuntu wa Sauli umwami w’Abisirayeli, akaba yamaranye nanje imisi, na ko n’imyaka? Kand’ uhereye igihe yacīkiye, akaza i wanje, nta kibi namubonyeko gushitsa n’ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
