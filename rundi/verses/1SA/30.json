              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi n’ingabo ziwe bashika i Sikulagi ku musi ugira gatatu, basanga Abamaleki bateye igihugu c’i bumanuko n’i Sikulagi, basanga i Sikulagi bāhanesheje, bāhaturiye, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bānyaze abagore n’abāri mur’ ico gisagara bose, abato n’abakuru; ntibāri bagize uwo bica, atar’ ukubajana ar’ inyagano, bakīgīra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi n’abantu biwe bashitse kur’ ico gisagara, ni kwo gusanga bāgituriye, kand’ abagore n’abana babo b’abahungu n’abakobga bājanywe ar’ inyagano. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi n’abantu bari kumwe na we baraturikisha, bararira, gushitsa aho batakibasha kurira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.42"
              },
              "items": [
                {
                  "text": "1 Sam 25:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.43"
              },
              "items": [
                {
                  "text": "43",
