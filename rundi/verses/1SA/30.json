                "loc": "1SA.30.8"
              },
              "items": [
                {
                  "text": "1 Sam 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi yigarukanira ivyo Abamaleki bari banyaze vyose, arokora n’abagore biwe bompi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihāgira ico babura, ari gito ari kinini, ar’ abana b’abahungu cank’ ab’ abakobga, ar’ ico mu nyagano canke mu vyari vyasahuwe; Dawidi abigarukana vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi anyaga intama n’inka zose, bazishorera imbere y’izabo, baravuga, bat’ Uyu ni wo munyago wa Dawidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
