              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ab’i Aroweri, n’ab’i Sifumoti, n’ab’i Eshitemowa; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
