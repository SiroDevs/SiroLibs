                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi abarira Abiyatari umuherezi mwene Ahimeleki, ati N’unzanire efodi hano. Nuko Abiyatari azanira Dawidi efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.2"
              },
              "items": [
                {
                  "text": "1 Sam 23:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi araheza asiguza Uhoraho, ati Mbega ni nakurikira ico gitero nzogihamvya? Aramwishura, ati N’ubakurikire, kuk’ utazobura kubahamvya, ukabāka vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.13"
              },
              "items": [
                {
                  "text": "1 Sam 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi aragenda, bo na za ngabo zari kumwe na we ukw ar’ amajana atandatu; bashitse ku mugezi Besori, abāri basigaye inyuma bagumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Dawidi araramiriza, bo n’abantu amajana ane; abandi amajana abiri barasigara, kuko bari barushe, bananirwa kujabuka umugezi Besori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        }
      ]
    },
    {
