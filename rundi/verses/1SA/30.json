              "items": [
                {
                  "text": "Yoh 8:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi agira intuntu nyinshi, kukw abantu bāvuga nk’abagomba kumutera amabuye; bose bāri n’akabonge kubg’ abana babo b’abahungu n’abakobga; ariko Dawidi arīremēsha, yisunze Uhoraho Imana yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
