          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abirungikira ab’i Beteli, n’ab’i Ramoti h’i bumanuko, n’ab’i Yatira; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
