                "loc": "EXO.17.4"
              },
              "items": [
                {
                  "text": "Kuv 17:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.10"
              },
              "items": [
                {
                  "text": "Guh 14:10",
