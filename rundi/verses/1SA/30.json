              "items": [
                {
                  "text": "2 Sam 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abagore ba Dawidi bompi, Ahinowamu w’i Yezireli, na Abigayili yahora ari muka Nabali w’i Karumeli, na bo bāri bājanywe ar’ inyagano. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
