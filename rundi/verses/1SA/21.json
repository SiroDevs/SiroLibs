            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi nyene hār’ umuntu umwe wo mu basavyi ba Sauli yari yashībijwe ngw agume imbere y’Uhoraho, yitwa Dowegi w’Umunyedomu, yar’ umubgiriza w’abungere ba Sauli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        }
