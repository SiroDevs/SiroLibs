          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi abaza Ahimeleki, ati Mbega nta cumu wogira hano cank’ inkota? Nta nkota nazanye cank’ ikindi kirwanishwa, kuk’ urubanza rw’umwami rwar’ urwo kwihuta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
