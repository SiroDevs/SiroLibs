            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi Dawidi arahaguruka ahunga Sauli, aja kwa Akishi umwami w’i Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
