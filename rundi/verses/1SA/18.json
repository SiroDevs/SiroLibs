        },
        {
          "text": "Nuko Dawidi amaze kugānīra na Sauli, umutima wa Yonatani uca ufatana n’uwa Dawidi akaramata, Yonatani amukunda nk’uko yikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo musi Sauli aca agumya Dawidi, ntiyamukundira gusubira kwa se ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Yonatani asezerana isezerano na Dawidi, kuko yar’ amukunze nk’uko yikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani yikiza umutamana wiwe yari yambaye, awuha Dawidi, amuha n’ivyo yambara mu ntambara, mbere n’inkota yiwe n’ umuheto n’umukanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi yama agenda aho Sauli yamutuma hose, akabigiramw’ ikiganza ciza, bituma Sauli amuha kugaba ingabo ziwe; abantu bose barabishima, mbere n’abagendanyi ba Sauli na bo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        }
      ]
    },
