                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza ararirekura, ati Hinge ndarisākize Dawidi, rirume ku nzu. Ariko Dawidi amuzibukira kabiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
