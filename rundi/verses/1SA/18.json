          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.19.10"
              },
              "items": [
                {
                  "text": "1 Sam 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.20.33"
              },
              "items": [
                {
                  "text": "20:33",
