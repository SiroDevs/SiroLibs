              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sauli atinya Dawidi, kuk’ Uhoraho yari kumwe na we, ariko we akaba yamuvuyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.2"
              },
              "items": [
                {
                  "text": "2 Sam 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye amwigizayo, akamugira umugabisha w’ingabo igihumbi, akāma atabarana na zo amaja n’amaza. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Dawidi yagira ikiganza ciza mu vyo yakora vyose, kand’ Uhoraho yari kumwe na we. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sauli abonye ukuntu agira ikiganza ciza, aramutinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Abisirayeli n’Abayuda bose bākunda Dawidi, kuko yatabarana na bo amaja n’amaza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
