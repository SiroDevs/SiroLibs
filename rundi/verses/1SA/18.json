        },
        {
          "text": "Bukeye impwemu mbi irungitswe n’Imana iza kuri Sauli akābushūngwe, ashirakw ariyamiriza ari mu ngoro, Dawidi akavuza inanga nk’uko yar’ asanzwe akora imisi yose; kandi Sauli yar’ afise icumu mu ntoke. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
