              "attrs": {
                "loc": "1SA.1.19"
              },
              "items": [
                {
                  "text": "1 Sam 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi ni kwo guhunga agacika, akaja i Rama kwa Samweli, amwīgānira ivyo Sauli yamugiriye vyose. Hanyuma ahagurukana na Samweli, baja i Nayoti, bagumayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze babgira Sauli, bat’ Erega Dawidi ar’ i Nayoti i Rama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
