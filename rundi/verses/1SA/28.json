            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli yar’ amaze gupfa; Abisirayeli bose bari baramuririye, bamuhamba i Rama mu gisagara yabamwo. Kandi Sauli yari yarahoneje abahamagara imizimu n’ abamenyi mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abafilisitiya barakorakorana, baraza basagaza i Shunemu; Sauli na we akoranya Abisirayeli bose, basagaza i Gilibowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli abonye ingabo z’Abafilisitiya, aratinya, aranduka umutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
        },
