              "items": [
                {
                  "text": "2 Sam 12:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere mwe n’Abisirayeli Uhoraho azobagabura mu maboko y’Abafilisitiya; kand’ ejo mwe n’abahungu bawe muzoba mur’ aho ndi; Uhoraho agira agabure ingabo z’ Abisirayeli mu maboko y’Abafilisitiya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        }
      ]
