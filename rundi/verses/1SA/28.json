            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw asiguje Uhoraho, ntiyagira ico amwishura, ari mu nzozi, ari mu buryo bga Urimu, haba no mu bavugishwa na we. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
