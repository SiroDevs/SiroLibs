                "loc": "1CH.10.13"
              },
              "items": [
                {
                  "text": "1 Ngo 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sauli abarira abantu biwe, ati Ni mumbarize umupfumukazi azi guhamagara imizimu, nje kumubaza. Abantu biwe baramwishura, bati Harih’ umupfumukazi abizi i Endori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
