                {
                  "text": "28:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Samweli abaza Sauli, ati N’iki gitumye uza kunkoma, ukanzūra? Sauli aramwishura, ati N’uko ndi mu magorwa, kukw Abafilisitiya baje kuntera, kand’ Imana ikaba yarantaye, ata co ikinyishura, ari mu bo ivugisha canke mu nzozi. Ni co kinteye kuguhamagara, ng’ummenyeshe ico nkwiye gukora. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.10"
              },
              "items": [
                {
                  "text": "Yes 63:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli aramwishura, at’ Ubimbarije iki, k’ Uhoraho yakuretse, agahinduka umwansi wawe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.28"
              },
              "items": [
                {
                  "text": "1 Sam 15:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yakugiriye nk’uko yari yarabivugiye muri jewe. Akunyaze ingoma, ayiha mugenzawe Dawidi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ utumviye Uhoraho, ntushitse uburake bgiwe bukaze ku Bamaleki; ni co kimuteye kukugenza artyo uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
