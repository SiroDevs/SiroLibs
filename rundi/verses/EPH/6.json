                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe ba shebuja, mubagirire murtyo nyene, mwirinde kubakangisha, kuko muzi yuko Shobuja musangiye ari mw ijuru, kandi ntarobanura abantu ku butoni.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
