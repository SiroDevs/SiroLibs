            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambare ibirwanishwa vyose vy’Imana, kugira ngo mushobore guhagarara mudatsinzwe n’ubugunge bga wa Murwanizi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.11",
