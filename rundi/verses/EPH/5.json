                {
                  "text": "Kol 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "cank’ ibiteye isoni, cank’ amagambo y’ubupfu, cank’ ibitwenza bibi, kukw ivyo bitabereye; ikibereye n’ugushima Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.4",
            "verseOrgIds": [
              "EPH.5.4"
            ]
