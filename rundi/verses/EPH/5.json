                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumenye neza ibihimbara Umwami wacu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.10",
            "verseOrgIds": [
              "EPH.5.10"
            ]
