            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo banga rirahambaye, ariko mbivuze kuri Kristo n’ishengero. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
            "verseOrgIds": [
