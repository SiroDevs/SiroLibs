              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko kera mwar’ umwiza, none mukaba mur’ umuco mu Mwami wacu: mugende nk’abana b’umuco, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.8",
            "verseOrgIds": [
              "EPH.5.8"
            ]
          }
        },
