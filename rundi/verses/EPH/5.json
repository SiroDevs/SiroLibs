          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kw abagabo na bo bakwiye gukunda abagore babo nk’imibiri yabo bgite. Ūkunda umugore wiwe, aba yīkunda: ",
          "type": "text",
          "attrs": {
