              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihakagire umuntu abahendesha amagambo y’ubusa: kukw ivyo ari vyo bizanira uburake bg’Imana abantu b’intabarirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.6",
            "verseOrgIds": [
              "EPH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
