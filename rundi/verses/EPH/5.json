            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ntimugafatanye n’ibikorwa birumvye vy’umwiza, ariko cane‐cane mubiserure, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.11",
