          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ata muntu yigeze kwanka umubiri wiwe, arikw arawugaburira, akawubungabunga, nk’uko Kristo na we agirira ishengero: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
