        },
        {
          "text": "Arik’ ubushakanyi n’ibihumanya vyose cank’ ukwifuza ntimukabishire no mu kanwa, mube nk’uko bibereye abera: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.3",
