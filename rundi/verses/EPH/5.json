            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngw aryīshīre, ar’ ishengero rifise ubgiza, ridafise amarabaga cank’ injebejebe cank’ ikintu cose gisa girtyo, ariko ngo ribe iryera ridafise agasembga. ",
          "type": "text",
          "attrs": {
