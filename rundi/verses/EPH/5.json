          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntimugafatanye na bo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.7",
            "verseOrgIds": [
              "EPH.5.7"
            ]
          }
        },
