            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko vyose, iyo bishizwe ahabona, bigaragazwa n’umuco, kukw ikigaragazwa cose ar’ umuco. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.13",
            "verseOrgIds": [
