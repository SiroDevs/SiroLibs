          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw imbuto y’umuco iboneka mu ngeso nziza zose no mu kugororoka no mu kuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.9",
            "verseOrgIds": [
              "EPH.5.9"
            ]
