                  "text": "Rom 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ibikorwa na bo mu mpisho biteye isoni no kubivuga. ",
          "type": "text",
