                  "text": "Ita 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma umuntu azosiga se na nyina, akabana n’umugore wiwe akaramata, bompi bakaba umubiri umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
          }
