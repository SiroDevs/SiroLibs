                "loc": "JUD.1.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko cane‐cane abagenda bakurikira ivy’ akameremere kabo, bifuza ibihumanya bagakengera ababaganza.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
