                "loc": "ROM.16.18"
              },
              "items": [
                {
                  "text": "Rom 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.5"
              },
              "items": [
                {
                  "text": "2 Kor 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.5"
              },
              "items": [
                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ukwifuza inyungu kwabo kuzobatera kwunguka kuri mwebge, bababgiye amagambo y’amaremano: gucirwakw iteka kwabo uhereye kera ntiguteba, no guhona kwabo ntiguhunyiza.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        }
      ]
    },
