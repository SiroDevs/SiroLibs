            }
          ]
        },
        {
          "text": "Kuko, kw Imana itāgiriye ikigongwe abamarayika bākoze ivyaha, arikw ikabakororera i kuzimu, ikabashira mu vyobo vy’umwiza, ngo barindirwe kuzocirwakw iteka; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.4",
            "verseOrgIds": [
              "2PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.6"
              },
              "items": [
                {
                  "text": "2 Pet 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.18"
              },
              "items": [
                {
                  "text": "Ita 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi kw itāgiriye ikigongwe isi ya kera, arikw igakiza Nowa, umwigisha w’ivyo kugororoka, hamwe n’abandi ndwi, aho yazana umwuzure kw isi y’abatayubaha; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Ita 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.7"
              },
              "items": [
                {
                  "text": "Yud 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ibisagara vy’i Sodomu n’i Gomora, ko yabiciriyekw iteka ryo gukomvomvorwa ikabigira umunyota, ikabishiraho kuba akabarore k’abazogenda batubaha Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikarokora Loti, umugororotsi, yababazwa cane n’ingeso z’isoni nke z’abatirinda — ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7",
            "verseOrgIds": [
              "2PE.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezk 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ uyo mugororotsi, aho yaba muri bo, yagira akabonge uko bukeye mu mutima wiwe ugororoka kubg’ ibikorwa vyabo vy’ubugarariji yabona, akumva; — ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.8",
            "verseOrgIds": [
              "2PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.13"
              },
              "items": [
                {
                  "text": "1 Kor 10:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.10"
              },
              "items": [
                {
                  "text": "Ivyah 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.6"
              },
              "items": [
                {
                  "text": "Yud 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Imana arazi gukiza abamwubaha ibibagerageza, no kurinda abagabitanya bahanwa gushitsa ku musi w’amateka, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.7"
              },
              "items": [
                {
                  "text": "Yud 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
