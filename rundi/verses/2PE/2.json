                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hār’ abigira abavugishwa n’Imana kandi, mu bgoko bg’Abisirayeli, nk’uko no muri mwebge hazobah’ abigisha b’ibinyoma, bazozana inyigisho mu mpisho zirema ibice, zitera guhona: bazokwihakana na Shebuja yabaguze, bīhamagarire uguhona gutebutse. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.1",
            "verseOrgIds": [
              "2PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.5"
              },
              "items": [
                {
                  "text": "Yes 52:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ingeso zabo z’isoni nke benshi bazozikurikira; kubg’ ivyo inzira y’ukuri bazoyitukisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
