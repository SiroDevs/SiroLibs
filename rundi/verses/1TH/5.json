          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mububahe rwose mu rukundo kubg’ igikorwa cabo. Mubane amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
