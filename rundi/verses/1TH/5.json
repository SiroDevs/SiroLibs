                {
                  "text": "Rom 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.9"
              },
              "items": [
                {
                  "text": "Ef 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mwese mur’ abana b’umuco n’abana b’umurango. Ntitur’ ab’ ijoro cank’ ab’ umwiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ntidusinzire nka ba bandi, ariko twame tugavye, twirinde ibiboreza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abasinzira basinzira mw ijoro, n’ababorerwa baborerwa mw ijoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
