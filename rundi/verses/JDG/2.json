        },
        {
          "text": "Maz’ Abisirayeli bakora ivyo Uhoraho abona kw ari bibi, basaba za Bayali; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
