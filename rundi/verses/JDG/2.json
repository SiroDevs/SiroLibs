              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umumarayika w’Uhoraho amaze kubgira Abisirayeli bose ayo majambo, abantu baraturikisha bararira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu baca bahita i Bokimu;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:5",
              "type": "text"
            },
            {
              "text": "Bokimu risobanurwa ngw Abantu barira.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bahatangira ibimazi, babishikanira Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
