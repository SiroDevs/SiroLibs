                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti Namwe ntimuze musezerane na ben’ iki gihugu, ariko muze musangangure ibicaniro vyabo. Yamara ntimwanyumviye. N’iki catumye mukora murtyo? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
        {
