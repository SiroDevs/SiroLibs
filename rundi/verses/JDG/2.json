              "items": [
                {
                  "text": "Yos 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None nanje hinge ndababarire: Abo sinzobirukana ngo bababise, ariko bazobabera ibibahanda mu mbavu, n’imana zabo zizobabera umutego.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
