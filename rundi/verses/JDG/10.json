                "loc": "JER.2.13"
              },
              "items": [
                {
                  "text": "Yer 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara, ko mwamvuyeko, mukaja gusaba izindi mana, ni co gituma ntongera kubakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.37"
              },
              "items": [
                {
                  "text": "Gus 32:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.27"
              },
              "items": [
                {
                  "text": "1 Abam 18:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mugende mutakambire za mana mwitoranirije, abe ari zo zibakiza mu gihe c’amagorwa yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.14",
            "verseOrgIds": [
              "JDG.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bishura Uhoraho, bati Twaracumuye koko, none n’utugire uk’ ugomba: mugabo, wemere kudukiza iri rimwe gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.23"
              },
              "items": [
                {
                  "text": "Yos 24:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.18"
              },
              "items": [
                {
                  "text": "Abac 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.9"
              },
              "items": [
                {
                  "text": "Yes 63:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraheza bakūraho izo mana z’inyamahanga, basubira gusaba Uhoraho, na we aca agira ikigumbagumba mu mutima kubgo kubona imibabaro y’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        }
      ]
    },
    {
