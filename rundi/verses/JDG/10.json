                "loc": "JDG.3.9"
              },
              "items": [
                {
                  "text": "Abac 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abisirayeli batakambira Uhoraho, bati Twagucumuyeko, kuko twakuvuyeko ari wewe Imana yacu, tugasaba za Bayali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
