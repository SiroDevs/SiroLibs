                "loc": "EZK.17.2"
              },
              "items": [
                {
                  "text": "Ezk 17:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samusoni arababgira, ati Hinge mbasōkōze igisōkōranyo; ni mwashobora kugipfīndūra, mukakinsobanurira, iyi misi ndwi yo kuba mu nkinga itarashira, nzoheza mbahe imikenyero yera mirongwitatu n’ impuzu zo gukūranya mirongwitatu nyene; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ni cabananira, ni mwebge muzompa imikenyero yera mirongwitatu n’impuzu zo gukūranya mirongwitatu nyene. Baramwishura, bati Dusōkōze, twumve igisōkōranyo cawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        },
