              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Samusoni amanukana na se na nyina, baja i Timuna; ashitse mu mizabibu yaho, ahūra n’umugunza w’intambge, iramutontomera. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
