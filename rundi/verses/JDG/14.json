              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni aramanuka aja i Timuna; abonay’ umwigeme wo mu Bafilisitiyakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
