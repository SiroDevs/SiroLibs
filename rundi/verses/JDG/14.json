              "items": [
                {
                  "text": "15:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko se na nyina ntibāri bāzi ko bivuye k’Uhoraho; kuko yarondera inyanduruko ku Bafilisitiya. Kand’ ico gihe Abafilisitiya ni bo bāganza Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        }
