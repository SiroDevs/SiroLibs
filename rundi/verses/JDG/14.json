          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se amanutse i wabo w’uwo mwigeme, Samusoni arondeza amazimano y’ubukwe, kukw abasore ari wo war’ umugenzo wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.10",
            "verseOrgIds": [
              "JDG.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamubonye, bamuzanira abagenzi mirongwitatu ngo babe baragumanye na we. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.11",
            "verseOrgIds": [
              "JDG.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
