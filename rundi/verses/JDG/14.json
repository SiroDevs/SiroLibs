              },
              "items": [
                {
                  "text": "Ita 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ aradūga, abarira se na nyina, ati Nabonye umwigeme i Timuna w’Umufilisitiyakazi: none ni mumunsabire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        },
