              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo ahamagaza Mose na Aroni, ati Ni mugende, mushikanire Imana yanyu ibimazi ngaha mur’ iki gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
