                  "text": "Kuv 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo aramwishura, ati Ndabaretse mugende, kugira ngo mushikanire Uhoraho Imana yanyu ibimazi mu bugaragwa: mugabo ntimuje kure cane; kandi munsabire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.15"
              },
              "items": [
                {
                  "text": "Kuv 8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramwishura, at’ Ehe ndagiye; ndasaba Uhoraho, ejo az’ akūre ayo masinzi y’ibibugu kuri wewe, mwe n’abanyarugo bawe n’ abantu bawe. Ariko Nyaguhora ku ngoma, woye kwongera kuduhenda, ngo wanke kurekura abantu ngo bagende bashikanire Uhoraho ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
