              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babigira bartyo; Aroni amanika ukuboko kwiwe gufashe ya nkoni, akubita umukungugu wo hasi, imibu iba ku bantu no ku bitungwa; umukungugu wose wo mu gihugu cose ca Egiputa uhinduka imibu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.17",
            "verseOrgIds": [
              "EXO.8.17"
            ]
          }
        },
        {
