                  "text": "46:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramwishura, ati Ntibibereye ko twokora durtyo, kuko twoba dushikaniye Uhoraho Imana yacu ivyitwa umuziro ku Banyegiputa; mbeg’ ivyo Abanyegiputa bīta umuziro twobishikana babona, ntibotwicisha amabuye? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
