        },
        {
          "text": "Ngo Na ho ni wanka kubarekura, igihugu cawe arakigomorera ibikere iyo kiva kikagera: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.2",
            "verseOrgIds": [
              "EXO.8.2"
            ]
          }
        },
        {
