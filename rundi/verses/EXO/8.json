          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ngw azoshira itandukaniro hagati y’abantu biwe n’abawe: ejo ni h’ico kimenyetso kizobaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
