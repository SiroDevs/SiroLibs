              },
              "items": [
                {
                  "text": "Zab 78:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni aramvura ukuboko kwiwe hejuru y’amazi ya Egiputa; ibikere biradūga, bizimanganya igihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
