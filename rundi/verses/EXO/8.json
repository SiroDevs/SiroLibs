              "items": [
                {
                  "text": "Kuv 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ba banyamarēba babigira bartyo babikoresheje amarēba yabo, badūza ibikere, bija mu gihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        },
