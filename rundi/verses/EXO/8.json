            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Farawo abonye ko habaye impore, yikomantaza umutima, ntiyabumvira, nk’uk’ Uhoraho yari yaravuze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
