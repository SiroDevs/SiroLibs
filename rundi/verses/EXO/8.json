            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dukwiye kugenda urugendo rw’imisi itatu tuje mu bugaragwa, tubone gushikanira Uhoraho Imana yacu, nk’ ukw izotubarira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
