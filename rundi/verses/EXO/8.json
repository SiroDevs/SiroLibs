                  "text": "Zab 105:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uruzi ruruzura ibikere, bidūge bije mu nzu yawe no haruguru, no ku buriri bgawe, no mu nzu z’abanyarugo bawe no mu z’abantu bawe, no mu dutanure twawe two kwotsamw’ imitsima, no mu mato yawe yo gucumba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.3",
            "verseOrgIds": [
              "EXO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibikere bizodūga binyagare kuri wewe no ku bantu bawe no ku banyarugo bawe bose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
