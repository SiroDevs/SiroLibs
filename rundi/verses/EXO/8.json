            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamarēba bakoresha amarēba yabo ngo barekure imibu, ntibabishobora; nukw imibu iba ku bantu no ku bitungwa. ",
          "type": "text",
          "attrs": {
