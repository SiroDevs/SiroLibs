              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bararondoka, baravyara cane, baragwira, baba igisata; buzura ico gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
