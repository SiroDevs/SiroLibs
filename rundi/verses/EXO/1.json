        },
        {
          "text": "Hārih’ abākirizi bākīra Abaheburayokazi, umwe yitwa Shifura, uwundi yitwa Puwa: nuk’ umwami wa Egiputa arababarira, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.15",
            "verseOrgIds": [
              "EXO.1.15"
            ]
          }
        },
        {
