            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abarira abantu biwe, ati Rāba Abisirayeli bahindutse ihanga rituruta mu bginshi riturusha n’inkomezi. ",
          "type": "text",
          "attrs": {
