            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, uko barushiriza kubatwaza ituntu, na bo ni ko barushiriza kugwira no kugasāra; nukw Abanyegiputa karabarya mu nda kubg’ Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
              "EXO.1.12"
            ]
          }
        },
