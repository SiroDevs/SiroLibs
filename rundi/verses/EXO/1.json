            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacuranguza Abisirayeli barabacumukuza, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
