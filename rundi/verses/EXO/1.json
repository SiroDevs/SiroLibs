            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo mazina ya bene Isirayeli bagiye muri Egiputa, bajanye na Yakobo, umuntu wese ajana n’abo mu rugo rwiwe: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reyubeni, na Simeyoni, na Lewi, na Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
