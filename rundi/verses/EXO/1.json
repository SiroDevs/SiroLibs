                "loc": "ACT.7.15"
              },
              "items": [
                {
                  "text": "Ivyak 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosefu arapfa, n’abo bavukana bose barapfa, bo n’ urunganwe rwose rw’ico gihe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
            ]
