        },
        {
          "text": "Nuko babaha abo kubakebera ibikebere ngo babatwaze ituntu babīkoreze ibiremereye. Bubakira Farawo ibisagara vyitwa Pitomu na Ramusesi vy’ibigega. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
          }
        },
        {
          "name": "verse",
