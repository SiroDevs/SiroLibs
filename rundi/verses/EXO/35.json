              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ imyambaro ijishitse yo kwambara mu gukora Ahēra, ni yo myambaro yejejwe yo kwambara Aroni umuherezi, n’iy’ abana biwe, yo gukoramw’ igikorwa c’ubuherezi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
