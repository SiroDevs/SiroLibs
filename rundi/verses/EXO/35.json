          ]
        },
        {
          "text": "n’igitereko c’amatara yo kubonesha, n’ibintu vyaco, n’ amatara yaco, n’amavuta yo gutuma yaka; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
