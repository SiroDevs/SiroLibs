            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’impuzu zo kubamba ngo zibe urugo, n’ibirimbi vyo kuzimanikako, n’ibitereko vyavyo vyo kubinegamwo, n’impuzu yo gukinga mw irembo ry’urwo rugo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
