                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "iryo hema ry’ imbere, n’ihema ryo hejuru yaryo, n’ivyo kurenza hejuru y’iryo hema; n’uturinda twaryo, n’imbaho zaryo, n’ibiti vyaryo vy’intumba, n’inkingi zaryo, n’ibitereko vyo kurokezamw’ imbaho n’inkingi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        },
