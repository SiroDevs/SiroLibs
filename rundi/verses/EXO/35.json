              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abarira ikoraniro ryose ry’Abisirayeli, at’ Ibi ni vyo Uhoraho yageze, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
