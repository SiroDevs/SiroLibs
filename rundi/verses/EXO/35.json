                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ ameza n’iminiho yayo n’ibintu vyayo vyose, n’imitsima y’ibiterekerwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
