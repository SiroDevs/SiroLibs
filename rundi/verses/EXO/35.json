        },
        {
          "text": "na ya sandugu n’iminiho yayo, na wa mutemere wo guhongerako, n’igihuzu co gukīngīra Ahēra cane; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        },
