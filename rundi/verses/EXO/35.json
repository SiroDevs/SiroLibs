                  "text": "Kuv 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuntu wese w’umuhinga wo muri mwebge n’aze, akore ivyo Uhoraho yageze vyose, ni vyo ibi: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        },
