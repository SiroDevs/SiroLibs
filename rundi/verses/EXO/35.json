            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’imambo z’iryo hema, n’iz’ urugo, n’imigozi yazo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
            "verseOrgIds": [
              "EXO.35.18"
            ]
