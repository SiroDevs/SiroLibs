              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.23"
              },
              "items": [
                {
                  "text": "Kuv 23:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje ndarungika umumarayika abaje imbere, kandi nzocirukanamw’ Abanyakanani, n’ Abamori, n’Abaheti, n’Abaferizi, n’Abahiwi, n’Abayebusi: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.21"
              },
              "items": [
                {
                  "text": "Guh 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.45"
              },
              "items": [
                {
                  "text": "45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muje mur’ ico gihugu gitemba amata n’ ubūki. Ariko jeho sindūgana namwe, ngo ngendere hagati muri mwebge; kuko mur’ ihanga ritagonda izosi: nohava mbatikiriza mu nzira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        }
      ]
    },
    {
