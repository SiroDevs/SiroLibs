                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Kuv 19:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.6"
              },
              "items": [
                {
                  "text": "6",
