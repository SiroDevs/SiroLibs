            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose abgira Uhoraho, ati Rāba, wambariye ngo Dūgana abo bantu, ariko ntiwammenyesha uwo udutumanye. Yamara waravuze, uti Ndakuzi izina, kandi wagiriwe ubuntu imbere yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.26"
              },
              "items": [
                {
                  "text": "Gus 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.27.11"
              },
              "items": [
                {
                  "text": "Zab 27:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, ndakwinginze, asangwa nagiriwe ubuntu imbere yawe koko, n’unyereke imigendere yawe, kugira ngo nkumenye, mbone kurushiriza kugirirwa ubuntu imbere yawe: kandi wibuke yukw iryo hanga ar’ iryawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.34+EXO.40.35+EXO.40.36+EXO.40.37+EXO.40.38"
              },
              "items": [
                {
                  "text": "Kuv 40:34-38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.21.44"
              },
              "items": [
                {
                  "text": "Yos 21:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.9"
              },
              "items": [
                {
                  "text": "Yes 63:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwishura, at’ Ubganje nzokwijanira namwe, mbashikane amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramwishura, at’ Ubgawe n’utajana natwe, ntudukūre ino. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.15",
            "verseOrgIds": [
              "EXO.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
