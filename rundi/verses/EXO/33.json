                "loc": "NUM.14.14"
              },
              "items": [
                {
                  "text": "Guh 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.53"
              },
              "items": [
                {
                  "text": "1 Abam 8:53",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None n’iki comenyekanisha yuko nagiriwe ubuntu imbere yawe, twe n’iryo hanga? Mbega s’uko wojana natwe, bigatuma twe n’ihanga ryawe dutandukanywa n’amahanga yose ashagaje kw isi?",
          "type": "text",
          "attrs": {
