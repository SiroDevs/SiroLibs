              },
              "items": [
                {
                  "text": "Ita 35:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ati N’ugende, uve ino, mwe n’ abantu wakūye mu gihugu ca Egiputa, mudūge muje mu gihugu narahiye Aburahamu na Isaka na Yakobo ko nzogiha uruvyaro rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
