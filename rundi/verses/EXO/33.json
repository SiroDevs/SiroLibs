                "loc": "EXO.29.43"
              },
              "items": [
                {
                  "text": "43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yajana ihema, akarishinga hirya y’aho bashagaje, ahītāngūye, yaryita ihema ry’ibonaniro. Uwagomba gusigūza Uhoraho wese yava aho bashagaje, akaja kw ihema ry’ibonaniro hirya yaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uko Mose yava aho bashagaje, agiye kur’ iryo hema, abantu bose bāva hasi, umuntu wese agahagarara ku muryango w’ihema ryiwe, bakamukurikiza amaso, gushitsa aho yinjiriye mur’ iryo hema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.21"
              },
              "items": [
                {
                  "text": "Kuv 13:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.99.7"
              },
              "items": [
                {
                  "text": "Zab 99:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yamara kwinjira mw ihema, ya nkingi y’igicu ikamanuka, igahagarara ku muryango waryo: Uhoraho akagānīra na Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bakabona iyo nkingi y’igicu ihagaze ku muryango w’iryo hema, bakava hasi, umuntu wese agasenga ari ku muryango w’ihema ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.8"
              },
              "items": [
                {
                  "text": "Guh 12:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.10"
              },
              "items": [
                {
                  "text": "Gus 34:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho akīgānīrira na Mose imbonankubone, nk’uk’ umuntu agānīra na mugenzi we. Maze Mose agasubira aho bashagaje; arik’ umufasha wiwe, Yosuwa mwene Nuni, w’umusore, ntiyava kur’ iryo hema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
