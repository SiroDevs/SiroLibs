            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.1+LEV.24.2+LEV.24.3"
              },
              "items": [
                {
                  "text": "Lew 24:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ubarire Abisirayeli bakuzanire amavuta y’umwisengesure avuye muri elayo zisekuwe, ya ca giterekwakw amatara, kugira ngo haze hame har’ itara ryaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mw ihema ry’ibonaniro, hino ya ca gihuzu gikingiye vya Bishinga intahe, abe ari ho Aroni n’abana biwe bazokwama baritunganiriza, kugira ngo rize ryame ryaka imbere yanje, jewe Uhoraho, rihēre ku mugoroba rishitse mu gitondo. Iryo rize ribe ibgirizwa ry’intahava ryo kwitonderwa n’Abisirayeli ukw ibihe vy’urunganwe rwabo bizogenda bikurikirana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
