            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rer’ Uhoraho ni yamara kubashikana mu gihugu c’Abanyakanani n’Abaheti n’Abamori n’Abahiwi n’Abayebusi, ico yarahiye ba sogokuruza banyu kw azokibaha, igihugu gitemba amata n’ubūki, muze mwame mwitondera uyo muhango mur’ uku kwezi, iyo gutashe hose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
          },
          "items": [
