              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mumare imisi ndwi murya imitsima itambiwe, maz’ umusi ugira indwi uz’ ube umusi mukuru w’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imitsima itambiwe iz’ ibe ari yo iribga mur’ iyo misi ukw ar’ indwi. Ntihaze hagire imitsima yambiwe ibabonekamwo, cank’ umwambiro, mu gihugu canyu cose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.7",
            "verseOrgIds": [
              "EXO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 13:8"
          },
          "items": [
