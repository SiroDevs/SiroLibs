            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14"
              },
              "items": [
                {
                  "text": "Kuv 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.8"
              },
              "items": [
                {
                  "text": "Gus 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.18"
              },
              "items": [
                {
                  "text": "11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bize bibabere nk’ikimenyetso gishizwe ku maboko yanyu, n’icibutso gishizwe hagati y’amaso yanyu, kugira ngw ivyagezwe vy’Uhoraho vyame mu kanwa kanyu: kuk’ Uhoraho yabakūje muri Egiputa ubushobozi bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma mukwiye kwama mwitondera iryo bgirizwa mu gihe caryo, uk’ umwaka utashe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        }
      ]
