        },
        {
          "text": "Kand’ Uhoraho ni yamara kubashikana mu gihugu c’Abanyakanani, nk’uko yabarahiye mwe na ba sogokuruza kw azokibaha, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
