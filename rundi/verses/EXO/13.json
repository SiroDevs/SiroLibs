            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu musi muviriyeyo n’uwo mu kwezi kwa Abibu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
        },
