              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ati Hasigaye icago kimwe nzorekurira kuri Farawo no ku Banyegiputa: hanyuma azobarekura mugende. Kand’ igihe azobarekura, mber’ azonabirukana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
