        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.22"
              },
              "items": [
                {
                  "text": "Kuv 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.35"
              },
              "items": [
                {
                  "text": "12:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero barira abantu, umugabo wese asabe umubanyi wiwe, n’umugore wese asabe umubanyi wiwe, babasabe utugenegene tw’ ifeza n’utw’ izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.21"
              },
              "items": [
                {
                  "text": "Kuv 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.36"
              },
              "items": [
                {
                  "text": "12:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aha ubgo bgoko kurābga neza n’Abanyegiputa. Bitayeko uwo mugabo Mose na we yar’ umuntu ahambaye mu gihugu ca Egiputa, mu maso y’abanyarugo ba Farawo, no mu maso y’abandi bantu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
