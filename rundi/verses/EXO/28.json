                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.5.4"
              },
              "items": [
                {
                  "text": "Heb 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uze wīgize hafi yawe Aroni mukurwawe n’abana biwe, ubarobanure mu Bisirayeli, kugira ngo bankorere igikorwa c’ubuherezi: Aroni nyene, na Nadabu na Abihu, na Eleyazari na Itamari, abana biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ ujishishirize Aroni mukurwawe imyambaro, iz’ ibe iyejejwe, yo kumutera icubahiro no kumushariza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ubgire abahinga bose, abo nujuje impwemu y’ubgenge, ngo bajishe imyambaro ya Aroni yo kumurobanura, kugira ngw ankorere igikorwa c’ubuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi abe ari yo myambaro bazojisha: umupfuko wo kwambara mu gikiriza, n’umwambaro witwa efodi, n’umwinjiro, n’ikanzo y’insobane, n’igitambara co kuzingīra mu mutwe, n’umukanda: nuko baze bajishire Aroni mukurwawe n’abana biwe imyambaro iz’ ibe iyejejwe, kugira ngo bankorere igikorwa c’ubuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baze bakoreshe intahe z’izahabu, n’inyuzi z’amasufe n’iz’ amashigisha n’izisa n’agahama, n’izera derere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwambaro witwa efodi baze bawujishishe intahe z’izahabu, n’ inyuzi z’amasufe, n’iz’ amashigisha, n’izisa n’agahama, n’izera derere nziza zihinzwe neza, ujishwe n’ abahinga bavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ ugire ibizāna bibiri vyo ku bitugu, bifate ku nzāno zayo zompi, kugira ngo biwufatanirize hamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umusipi ujishwe n’abahinga, ujishiwe kuri wo, wo kuwukenyeza, uz’ ujishwe nka wo, ube kimwe na wo; baze bawujishe mu ntahe z’izahabu no mu nyuzi z’amasufe no mu z’amashigisha no mu zisa n’agahama no mu zera derere nziza zihinzwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uze wābīre utubuyenge tubiri twitwa shohamu, utwandikekw amazina y’abana ba Isirayeli mu buryo bgo guca amagarwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mazina yabo uze wandike atandatu ku kabuyenge kamwe, yandi atandatu uyandike ku kandi kabuyenge, nk’uko bakurikiranye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uk’ umuntu azi guca amagarwe ku kabuyenge ko kudoma ikimenyetso, abe ari ko nawe wandika amazina y’abana ba Isirayeli kur’ utwo tubuyenge twompi: uheze uturumike mu tugenegene tw’izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utēre utwo tubuyenge twompi ahahera ku bitugu ku bizāna vya efodi, tubere Abisirayeli utubuyenge two kwibukwako: Aroni aze yambare amazina y’abana ba Isirayeli ku bitugu vyiwe vyompi, ayazane imbere yanje, jewe Uhoraho, kuba icibutso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ucure utugenegene mw izahabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’imigufu ibiri y’izahabu iramuye, uyigire nk’ imigozi itsivye; ivyo bitsibo vy’ imigufu ubirumye kur’ utwo tugenegene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ujishishe umupfuko wo kwambara mu gikiriza wo kwahukanya imanza: abahinga bavyo abe ari bo bawujisha; uko efodi ijishwe abe ari k’uwujishisha: uwujishishe mu ntahe z’izahabu no mu nyuzi z’amasufe n’iz’ amashigisha n’izisa n’agahama n’izera derere nziza zihinzwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ ukorwe ukubiranijwe, uringanire impande zose: uburebure bgawo bube itambge rimwe ry’ intoke, n’ubgaguke bgawo bube itambge rimwe nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uheze uwudombagizek’ utubuyenge mu mirongo ine: mu murongo wa mbere haze habe utubuyenge twitwa odemu na pitida na bareketi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu wa kabiri habe utwitwa nofekina na safiro na yahalomu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu wa gatatu habe utwitwa leshemu na shevo na akilama; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu wa kane habe utwitwa tarushishi na shohamu na yasipi: tuze tugende turumikwa mu tugenegene tw’izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utwo tubuyenge tunganye igitigiri n’amazina y’ abana ba Isirayeli: tube icumi na tubiri nk’ukw amazina yabo ar’ icumi n’abiri: tumere nk’utubuyenge two kudoma ibimenyetso, tugende twandikwakw izina mu buryo bgo guca amagarwe, tube utw’ iyo miryango ukw ar’ icumi n’ibiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo mupfuko wo kwambara mu gikiriza uz’ uwushireko ya migufu icuzwe mw izahabu iramuye, ikozwe nk’imigozi itsivye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mupfuko uz’ uwucurire impeta zibiri z’izahabu, uzitēre ku mitwe yawo yompi yo haruguru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze urumye iyo migufu yompi y’izahabu itsivye kur’ izo mpeta zompi zo ku mitwe y’uwo mupfuko wo ku gikiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyindi mitwe yompi y’ivyo bitsibo vyompi vy’imigufu uyirumye kur’ utwo tugenegene twompi, uyitēre kuri vya bizāna vya efodi vyo ku bitugu, ku ruhande rw’imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ucure izindi mpeta zibiri mw izahabu, uzitēre ku mitwe yompi yo hepfo y’uwo mupfuko wo ku gikiriza, ku mubuga wawo, ku ruhande rw’ imbere ruhera kuri efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ucure izindi mpeta zibiri mw izahabu, uzitēre ahahera imbere aho vya bizāna bibiri vya efodi vyo ku bitugu bitērewe, haruguru ya wa musipi wajishwe n’abahinga, wo gukenyeza efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uwo mupfuko wo kwambara ku gikiriza baze bawufatanishe impeta zawo n’impeta zo kuri efodi akagozi ko mu nyuzi z’amasufe, kugira ng’ ugume kuri wa musipi wa efodi wajishwe n’ abahinga, uwo mupfuko woye gukūrwa kuri efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni, uko yinjiye Ahēra, aze yame yambara ku mutima amazina y’ abana ba Isirayeli ari kur’ uwo mupfuko wo ku gikiriza wo kwahukanya imanza, kugira ngw ayo mazina abe icibutso co gutuma bibukwa ubudasība imbere yanje, jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
