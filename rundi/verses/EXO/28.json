          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze ucure akabāte mw izahabu iramuye, ukandikeko mu buryo bgo guca amagarwe, nk’ uko baca amagarwe ku kabuyenge ko kudoma ikimenyetso, uti YEREJWE UHORAHO. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugapfundikishe akagozi ko mu nyuzi z’ amasufe, kuri ca gitambara kizingiriye mu mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
