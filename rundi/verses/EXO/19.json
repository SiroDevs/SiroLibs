            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi ry’ inzamba rirushirije kurengēra, Mose aravuga, Imana imwishura mw ijwi rirenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
