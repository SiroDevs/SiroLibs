        },
        {
          "text": "Uti None rero, ni mwamwumvira vy’ ukuri, mukitondera isezerano ryiwe, muzomubera inyegu yiharije, yitoranirije mu mahanga yose: uti Kukw isi yose ar’ iyiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.5",
            "verseOrgIds": [
              "EXO.19.5"
            ]
          }
        },
