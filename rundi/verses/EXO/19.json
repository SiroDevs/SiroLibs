                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abaherezi na bo, basanzwe bīgira hafi yanje, jewe Uhoraho, ni biyeze, kugira ngo simbatsindeho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
