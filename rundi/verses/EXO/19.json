            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muzomubera ubgami, ubgoko bg’abaherezi, ihanga ryera. Ayo majambo abe ari yo ubgira Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
