            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Mwarabonye ivyo yakoreye Abanyegiputa, n’ingene mweho yabateruye ku mababa nk’ay’ inkukuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.4",
            "verseOrgIds": [
              "EXO.19.4"
            ]
          }
        },
        {
