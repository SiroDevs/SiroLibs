            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:4",
              "type": "text"
            },
            {
              "text": "Inkukuma ni yo mpungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akabazana iy’ ari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.4",
