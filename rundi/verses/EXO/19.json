        {
          "text": "Nuko Mose araza, ahamagara abakuru bo mu bantu, abashikiriza ayo majambo yose Uhoraho yamutumye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
