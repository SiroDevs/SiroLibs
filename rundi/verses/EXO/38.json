              "text": "38:24",
              "type": "text"
            },
            {
              "text": "italanto",
              "type": "text"
            },
            {
              "text": "imwe irimwo shekeli 3.000: kandi rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.39"
              },
              "items": [
                {
                  "text": "Kuv 25:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mirongwibiri n’icenda na shekeli amajana ndwi na mirongwitatu, yagezwe kuri shekeli ir’ Ahēra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafeza yatanzwe n’ abaharūwe bo mw ikoraniro yanganya kuriba n’italanto ijana na shekeli igihumbi n’amajana ndwi na mirongwirindwi na zitanu, yagezwe kuri shekeli ir’ Ahēra; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
