                  "text": "Guh 1:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yatanzwe n’abantu ibihumbi amajana atandatu na bitatu n’ amajana atanu na mirongwitanu, umuntu wese yarēngāna agashirwa mu gitigiri c’abāharūwe, amaze imyaka mirongwibiri cank’ isāga, yatanga beka imwe, ari yo kigabane ca shekeli yagezwe kuri shekeli ir’ Ahēra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
