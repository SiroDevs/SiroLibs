          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imiringa y’amashikanwa yanganya kuriba n’italanto mirongwirindwi na shekeli ibihumbi bibiri n’amajana ane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
