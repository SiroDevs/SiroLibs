              "EXO.38.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.9+EXO.27.10+EXO.27.11+EXO.27.12+EXO.27.13+EXO.27.14+EXO.27.15+EXO.27.16+EXO.27.17+EXO.27.18+EXO.27.19"
              },
              "items": [
                {
                  "text": "Kuv 27:9-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ akora urugo; ku ruhande ruhera i bumanuko, impuzu zo kubamba ngo zibe urugo zari zijishwe mu nyuzi zera derere nziza zihinzwe neza, uburebure bgazo bg’amakika bgar’ amatambge ijana y’ukuboko uciriye mu nkokora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibirimbi vyo kuzimanikako vyari mirongwibiri, n’ ibitereko vyavyo vyo kubinegamwo vyari mirongwibiri nyene, bicuzwe mu miringa: imisumari yo kuri vyo yar’ icuzwe mw ifeza, bo n’ imitambikwa yo kuri vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ku ruhande ruhera i burārūko na rwo uburebure bg’amakika bg’izo mpuzu bgar’ amatambge ijana nyene, n’ibirimbi vyazo vyari mirongwibiri, n’ibitereko vyavyo vyari mirongwibiri nyene bicuzwe mu miringa; imisumari yo kuri vyo yar’ icuzwe mw ifeza, bo n’imitambikwa yo kuri vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rw’i burengerazuba, impuzu zo kubamba zar’ iz’ amatambge mirongwitanu; ibirimbi vyazo vyari cumi, n’ibitereko vyavyo vyari cumi nyene; imisumari yo kuri vyo yar’ icuzwe mw ifeza, bo n’ imitambikwa yo kuri vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ku ruhande rw’i burasirazuba, amatambge yazo yari mirongwitanu nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rumwe ruhera kw irembo impuzu zo kubamba zar’ iz’ amatambge cumi n’atanu; ibirimbi vyazo vyari bitatu, n’ibitereko vyavyo vyari bitatu nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ku rundi ruhande rwaryo vyari kuno; hepfo y’ irembo ry’urwo rugo no haruguru, impuzu zo kubamba zar’ iz’ amatambge cumi‐cumi n’atanu; ibirimbi vyazo vyari bitatu‐bitatu, n’ibitereko vyavyo vyari bitatu‐bitatu nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impuzu zose zo kubamba impande zose ngo zibe urugo, zari zijishwe mu nyuzi zera derere nziza zihinzwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibitereko vyo kunegamw’ ibirimbi vyari bicuzwe mu miringa; imisumari yo kur’ ivyo birimbi, bo n’imitambikwa yo kuri vyo, vyari bicuzwe mw ifeza; ku mitwe yavyo vyari vyometswekw ifeza; ibirimbi vyose vy’urwo rugo vyarikw imitambikwa icuzwe mw ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihuzu co gukinga mw irembo ry’urwo rugo cari kijererenzwekw amabara n’abahinga, cari kijishwe mu nyuzi z’amasufe no mu z’amashigisha no mu zisa n’agahama, no mu zera derere nziza zihinzwe neza; uburebure bgaco bg’amakika bgar’ amatambge mirongwibiri, uburebure bg’igihagararo bgar’ amatambge atanu: bgari cabugerwe n’ubg’ izindi mpuzu zo kubamba ngo zibe urugo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibirimbi vyaco vyari bine, n’ibitereko vyavyo vyari bine nyene, vyacuzwe mu miringa; imisumari yo kuri vyo yar’ icuzwe mw ifeza, kandi vyari vyometswekw ifeza ku mitwe yavyo, bifise n’imitambikwa yacuzwe mw ifeza nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imambo zose z’iryo hema, n’iz’ urugo rurikīkūje impande zose, zari zicuzwe mu miringa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        }
      ]
    },
