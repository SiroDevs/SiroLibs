            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co gitigiri c’ivyakoze iryo hema, ari ryo hema ry’Ibishinga intahe, nk’uko Mose yageze ko biharūrwa, Abalewi baba ari bo babiharūra, baharūzwa na Itamari, mwene Aroni umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
