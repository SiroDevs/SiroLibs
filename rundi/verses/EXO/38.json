                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ afatanije na Oholiyabu mwene Ahisamaki, wo mu muryango wa Dani, umuntu azi guca amagarwe ku tubuyenge, w’umukozi w’umuhanga, umuhinga wo kujererenga amabara y’inyuzi z’ amasufe n’iz’ amashigisha n’izisa n’agahama n’izera derere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        }
