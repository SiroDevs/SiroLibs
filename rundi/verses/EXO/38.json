              "type": "text"
            }
          ]
        },
        {
          "text": "Amazahabu yose yakoreshejwe mu gucura ivy’ iryo hema vyose, ari yo mazahabu y’amashikanwa, yanganya kuriba n’ italanto",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
