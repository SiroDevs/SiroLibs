            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Besaleli mwene Uri, Uri mwene Huri, wo mu muryango wa Yuda, ni we yakoze ivyo Uhoraho yabariye Mose vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
