              },
              "items": [
                {
                  "text": "1 Sam 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ acura ikigārigāri mu miringa, co gukaraba, acura n’ intebe yaco mu miringa nyene, abicuze mu vyīrore vy’imiringa vy’abagore bākoranira ku muryango w’ihema ry’ibonaniro gukora ibikorwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
