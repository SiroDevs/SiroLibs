              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawomi abonye yukw amaramaje kujana na we aca arahora.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
