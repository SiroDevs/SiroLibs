            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.15"
              },
              "items": [
                {
                  "text": "12:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbeg’ ivyo vyotuma mubarīndīra gushitsa aho bazokurira? Ivyo vyotuma mureka kurondera abagabo? Vyoye kuba birtyo, bakobga banje, kuko muntera akagongwe, kuk’ ukuboko kw’Uhoraho kwaramvuriye kundwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barongera baraturikīsha, bararira: Orupa agūmbīra inabukwe, ariko Rusi we amugumakw akaramata.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        }
      ]
