            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusi aramwishura, ati Reka kunyinginga kuguheba, no gusubira inyuma ngo noye kugukurikira; kukw ah’ uzoja ari ho nzoja, kand’ ah’ uzorāra ari ho nzorāra; ihanga ryanyu ni ryo rizoba ihanga ryacu, Imana yawe ni yo izoba Imana yanje; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        },
