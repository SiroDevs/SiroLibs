              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bompi barajana kurinda bashika i Betelehemu. Nuko rero bashitse i Betelehemu abo mu gisagara bose barashwabāduka, abagore barabazanya, bati Mbeg’ uyo yoba Nawomi? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        },
