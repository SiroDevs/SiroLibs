              "items": [
                {
                  "text": "Yob 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuye ino nninahaye, Uhoraho angarukanye i wacu nd’ imbokoboko: munyitira iki Nawomi, Uhoraho ko yantuntuje, kandi Rugira Vyose akaba yanteye ivyago? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
