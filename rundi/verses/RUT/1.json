                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Ntimube mukinyita Nawomi,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:20",
              "type": "text"
            },
            {
              "text": "Nawomi risobanurwa ng’ Uw’ igikundiro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ariko munyite Mara;",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:20",
              "type": "text"
            },
            {
              "text": "Mara risobanurwa ng’ Umururāzi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuko Rugira Vyose ivyo yangiriye vyambereye umururāzi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
