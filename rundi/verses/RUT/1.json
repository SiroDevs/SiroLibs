            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ah’ uzogwa ni ho nzogwa, bahampambe: Uhoraho arakabimpanira, kandi birushirije, ni nagira ikizontandukanya nawe, atar’ urupfu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
