            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ni yo idukomezanya namwe muri Kristo, kandi ni yo yaturobanuje amavuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
