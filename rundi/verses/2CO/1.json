                "loc": "2CO.2.17"
              },
              "items": [
                {
                  "text": "2 Kor 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.18"
              },
              "items": [
                {
                  "text": "Heb 13:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.17"
              },
              "items": [
                {
                  "text": "1 Kor 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukwirata kwacu ar’ uku, kand’ ijwi ryo mu mitima yacu rirabishingira intahe: ingeso twagirira mw isi, kandi cane‐cane muri mwebge, zar’ ukwera, n’imitima itagira ubugunge iva ku Mana, atari mu bgenge bg’abantu, ariko mu buntu bg’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ata bindi tubandikira, atar’ ivyo nyene musoma kandi mwemera, kandi nishimiye ko muzovyemera gushitsa kw iherezo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.12"
              },
              "items": [
                {
                  "text": "2 Kor 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.16"
              },
              "items": [
                {
                  "text": "Flp 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk’uko mwatwemeye agace, yuko tur’ ivyirato vyanyu, nk’uko namwe muzoba ivyacu ku musi w’Umwami wacu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nk’uko nizigiye ivyo, nagira ngo nzobanza kuza i wanyu, ngo muhabge ubuntu ubugira kabiri, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.5"
              },
              "items": [
                {
                  "text": "1 Kor 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kubacako nja i Makedoniya, nkagaruka i wanyu mvuye i Makedoniya, ngo mumperekeze, munsezere neza nja i Yudaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.16"
              },
              "items": [
                {
                  "text": "2 Kor 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw aho nagomba gukora ntyo, mbega narahindagurika? Cank’ ivyo ngabira, mbigabira mbgirijwe n’akameremere kanje, ngo nībūranye, nt’ Ego, ego, maze nt’ Oya, oya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        },
        {
