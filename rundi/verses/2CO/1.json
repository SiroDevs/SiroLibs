              "items": [
                {
                  "text": "1 Kor 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, intumwa ya Kristo Yesu, nk’ukw Imana yagomvye, na Timoteyo mwene Data, turabandikiye abo mw ishengero ry’Imana ry’i Korinto, n’abera bose bari muri Akaya hose: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.7"
              },
              "items": [
                {
                  "text": "Rom 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubuntu bube muri mwebge n’amahoro, biva ku Mana Data wa twese no ku Mwami Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
