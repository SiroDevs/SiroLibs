            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivy’ Imana yasezeranye uko bingana, muri we ni ho Ego me riri: ni co gituma ari we adutera kuvuga ngo Amen, ngw Imana ishimishwe natwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
