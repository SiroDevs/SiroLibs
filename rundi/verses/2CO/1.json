          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana w’Imana Yesu Kristo, umwe twabigisha ivyiwe, twe na Siluwano na Timoteyo, ntiyar’ Ego, kandi ngw abe Oya; ariko muri we harimw’ Ego me. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
