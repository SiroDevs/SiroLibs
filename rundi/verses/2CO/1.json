              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nk’ukw Imana ar’ iyo kwizerwa, ijambo tubabarira ntituvuga ngw Ego, maze ng’ Oya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
