              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa musukūzi mukuru abonye kw amusobanuriye ivyiza, abarira Yosefu, ati Nanje narose nikoreye intimbiri zitatu z’imitsima y’ifu igogōretse; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.16",
            "verseOrgIds": [
              "GEN.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ intimbiri yo hejuru y’izindi yarimw’ ivyo kurya bikaranze vy’uburyo bgose nshīra Farawo; maz’ ibisīga bibindīra ku mutwe, mur’ iyo ntimbiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.17",
            "verseOrgIds": [
              "GEN.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu aramwishura, at’ Uku ni ko zisobanurwa: izo ntimbiri zitatu n’imisi itatu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "imisi itatu itarashira, Farawo azokubohora akumanike, ibisīga bikugabangane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        }
      ]
    },
