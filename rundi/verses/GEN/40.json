              },
              "items": [
                {
                  "text": "Neh 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo, umukevyi ahēreza igiturire umwami wa Egiputa, n’umusukūzi wiwe bacumura kuri shebuja, umwami wa Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo arakira abo banyarugo biwe bompi, umukevyi mukuru n’umusukūzi mukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.2",
            "verseOrgIds": [
              "GEN.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.36"
              },
              "items": [
                {
                  "text": "Ita 37:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.20"
              },
              "items": [
                {
                  "text": "39:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashirisha mw ibohero ryari mu rugo rw’uwaganza abashibamyi, aho Yosefu yar’ arindiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.3",
            "verseOrgIds": [
              "GEN.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwaganza abashibamyi b’umwami abahēreza Yosefu, na we arabakorera. Bamaze igihe bari mw ibohero, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa mukevyi w’umwami wa Egiputa na wa musukūzi wiwe, barindiwe mur’ iryo bohero, bompi barotera ijoro rimwe, umwe iziwe uwundi iziwe, zigasobanurwa zimwe ukwazo izindi ukwazo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.5",
            "verseOrgIds": [
              "GEN.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu gitondo Yosefu yinjira aho bari; abarāvye, abona bajonjogoye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.6",
            "verseOrgIds": [
              "GEN.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaza abo banyarugo ba Farawo barindanywe mw ibohero ryo mu rugo rwa shebuja wiwe, ati Mbeg’ uyu musi ko mujonjogoye n’iki? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.7",
            "verseOrgIds": [
              "GEN.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.28"
              },
              "items": [
                {
                  "text": "Dan 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura, bati N’uko twarose inzozi, kand’ akaba ata wushobora kuzidusobanurira. Yosefu arabishura, ati Mbeg’ Imana si yo Nyene gusobanura? Enda ni muzindotorere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukevyi mukuru arotorera Yosefu inzozi ziwe, ati Narose mbona umuzabibu imbere yanje, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.9",
            "verseOrgIds": [
              "GEN.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ uwo muzabibu war’ ufise amashami atatu: mbona usa n’ūpfunditse, usambura amashurwe, amahando yawo arahishira; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.10",
            "verseOrgIds": [
              "GEN.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ igikombe ca Farawo nari ngifise mu minwe, nuko nābīra izo nzabibu, nzikānyira muri co, ndaheza ngihēreza Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.11",
            "verseOrgIds": [
              "GEN.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.26"
              },
              "items": [
                {
                  "text": "Ita 41:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.36"
              },
              "items": [
                {
                  "text": "Dan 2:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu aramubarira, at’ Uku ni ko zisobanurwa: ayo mashami atatu n’imisi itatu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.3.3"
              },
              "items": [
                {
                  "text": "Zab 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.31"
              },
              "items": [
                {
                  "text": "Yer 52:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "imisi itatu itarashira Farawo azokubohora, agusubize kw ibango ryawe: kand’ uzohēreza Farawo igikombe nk’uko wahora ukora ur’umukevyi wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uz’ unyibuke, ni wamara kumererwa neza, uz’ untabare, ndakwinginze, umvugire kuri Farawo, unkūze mur’ iyi nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.28"
              },
              "items": [
                {
                  "text": "Ita 37:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.39.20"
              },
              "items": [
                {
                  "text": "39:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nasahuwe, nkūwe mu gihugu c’Abaheburayo: n’ino na ho nta caha nakoze cotumye banshira mur’ iri bohero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        }
      ]
    },
    {
