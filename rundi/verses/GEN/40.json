                "loc": "GEN.40.19"
              },
              "items": [
                {
                  "text": "Ita 40:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ amanika wa musukūzi mukuru, nk’uko Yosefu yabasobanuriye inzozi zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.22",
            "verseOrgIds": [
              "GEN.40.22"
            ]
          }
        },
