                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.21"
              },
              "items": [
                {
                  "text": "Mrk 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira gatatu, ari wo musi wo kwibuka ukuvuka kwa Farawo, atumirira amazimano abamenyekana biwe bose; araheza abohora wa mukevyi mukuru na wa musukūzi mukuru hagati y’abo bamenyekana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.20",
            "verseOrgIds": [
              "GEN.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 40:21"
          },
          "items": [
            {
