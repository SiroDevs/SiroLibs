            },
            {
              "text": "Yosefu risobanurwa ngo Guheterwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " at’ Uhoraho ampetere uwundi muhungu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
