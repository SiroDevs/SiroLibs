              "GEN.30.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.24"
              },
              "items": [
                {
                  "text": "Ita 29:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya abonye aretse kuvyara, yābīra Zilupa incoreke yiwe, amuha Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.9",
            "verseOrgIds": [
              "GEN.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilupa incoreke ya Leya avyarana na Yakobo umuhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.10",
            "verseOrgIds": [
              "GEN.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya aravuga, ati Ngize imana! Amwita Gadi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.11",
            "verseOrgIds": [
              "GEN.30.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30:11",
              "type": "text"
            },
            {
              "text": "Gadi risobanurwa ngo Kugira imana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.11",
            "verseOrgIds": [
              "GEN.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Zilupa incoreke ya Leya avyarana na Yakobo umuhungu wa kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.12",
            "verseOrgIds": [
              "GEN.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya aravuga, ati Ndahiriwe! Kukw abandi bagore bazonyita umuhirwa: amwita Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30:13",
              "type": "text"
            },
            {
              "text": "Asheri risobanurwa ngo Kwita uwundi umuhirwa.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
