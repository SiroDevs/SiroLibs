              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asama inda, avyara umuhungu, at’ Imana irantēturuye: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
