              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Imana yibuka Rakeli, iramwumvira, izibūra inda yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.22",
            "verseOrgIds": [
