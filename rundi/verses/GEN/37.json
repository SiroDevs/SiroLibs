            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubira kuri barumuna be, at’ Umwana ntakiriyo; none jeho ndakwirwa hehe? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
