              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda abarira abo bavukana, ati Vyotumarira iki kwica mwene data, no kumuzimanganya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
