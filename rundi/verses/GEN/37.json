                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawumenya, aravuga, ati N’umwambaro w’umwana wanje! Igikōko c’inkazi caramuriye! Yosefu yaratabaguwe, nta kindi! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        },
