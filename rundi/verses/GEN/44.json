            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
              "GEN.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.18",
            "verseOrgIds": [
              "GEN.44.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.40"
              },
              "items": [
                {
                  "text": "Ita 41:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yuda aramwegera, aramubarira, ati Mugenzi, zirikana, ndagusabe ijambo mvuga, ntumpambarire, jewe umusavyi wawe: kuk’ umeze nka Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.18",
            "verseOrgIds": [
              "GEN.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erega mugenzi, ni wewe watubajije, uti Muracafise so, canke har’ uwundi muvukana? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.19",
            "verseOrgIds": [
              "GEN.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natwe turakwishura, mugenzi, tuti Dufise data w’umutāma, hariho n’ uwundi muhungu yavyaye ashaje; na we mukuru we yarapfuye, none ni we asigaye ar’ikinege mu nda ya nyina, kandi se amukunda cane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.20",
            "verseOrgIds": [
              "GEN.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.15"
              },
              "items": [
                {
                  "text": "Ita 42:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe uratubarira abasavyi bawe, uti Muramunzanira ndamurābe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.21",
            "verseOrgIds": [
              "GEN.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natwe turakubarira, mugenzi, tut’ Uwo muhungu ntivyoshoboka kw atandukana na se, kuko botandukana se yopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.22",
            "verseOrgIds": [
              "GEN.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 44:23"
          },
          "items": [
