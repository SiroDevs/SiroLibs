                "loc": "GEN.42.25"
              },
              "items": [
                {
                  "text": "Ita 42:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosefu abarira umubgiriza wiwe, ati Ni mwuzuze amagunira y’abo bantu impeke, nk’izo bashobora gutwara, kand’ ushire n’amahera y’umuntu wese mu munwa w’igunira ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.1",
            "verseOrgIds": [
              "GEN.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushire n’igikombe canje c’ifeza mu munwa w’igunira ry’umuhererezi wabo, hamwe n’amahera yazanye gusumisha. Abikora nk’uko Yosefu yamubariye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.2",
            "verseOrgIds": [
              "GEN.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye mu gasisira barungika abo bantu, hamwe n’indogoba zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.3",
            "verseOrgIds": [
              "GEN.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuye mu gisagara, batarashika kure, Yosefu abarira umubgiriza wiwe, ati Va hasi, ukurikire ba bagabo, maze ni wabashikīra, ubabaze, uti N’iki catumye mugirira nabi uwabagiriye neza? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.4",
            "verseOrgIds": [
              "GEN.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ico mwivye s’ico databuja anywesha, kand’ akakiragurisha? Uti Ko mwakoze murtyo, mwakoze icaha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.5",
            "verseOrgIds": [
              "GEN.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.5",
            "verseOrgIds": [
              "GEN.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabashikīra, ababarira ayo majambo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.6",
            "verseOrgIds": [
              "GEN.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura, bati Mugenzi, utewe n’iki kutubarira ben’ ivyo? Biragahera abasavyi bawe ko twokora nk’ivyo! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.7",
            "verseOrgIds": [
              "GEN.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.21"
              },
              "items": [
                {
                  "text": "Ita 43:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ amahera twasanze mu minwa y’ amagunira yacu twarayakugarukaniye tuyakūye mu gihugu c’i Kanani: none twoshobora dute kwiba ifeza cank’ izahabu vyo mu nzu ya shobuja? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.8",
            "verseOrgIds": [
              "GEN.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.32"
              },
              "items": [
                {
                  "text": "Ita 31:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo wokibonana wese muri twebge abasavyi bawe, akwiye gupfa, natwe duhinduke abaja ba shobuja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.9",
            "verseOrgIds": [
              "GEN.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Nuko rero, birakora bibe nk’uko mubivuze. Uwo kija kubonekako ni we azohinduka umuja wanje, namwe abandi muzoba mweze. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.10",
            "verseOrgIds": [
              "GEN.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baca bakūra amagunira yabo ku ndogoba n’ ingoga, bayashira hasi, umuntu wese atekurura iryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.11",
            "verseOrgIds": [
              "GEN.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arasaka, ahera k’uw’imfura ashitsa ku muhererezi: ca gikombe kiboneka mw igunira rya Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.12",
            "verseOrgIds": [
              "GEN.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.29"
              },
              "items": [
                {
                  "text": "Ita 37:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baca bitantamurirakw impuzu zabo, umuntu wese asubiza ibintu vyiwe ku ndogoba, basubira mu gisagara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.13",
            "verseOrgIds": [
              "GEN.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
