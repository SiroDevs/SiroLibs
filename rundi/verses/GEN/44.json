              "GEN.44.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.6"
              },
              "items": [
                {
                  "text": "Ita 42:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yuda na bagenzi be bashika kwa Yosefu, basanga ari ho akiri: baca bamwitembagaza imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.14",
            "verseOrgIds": [
              "GEN.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu arababaza, at’ Ico mwakoze ico n’igiki? Ntimuzi yuk’ umuntu ameze nkanje ashobora kuragura koko? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.15",
            "verseOrgIds": [
              "GEN.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.18"
              },
              "items": [
                {
                  "text": "Ita 37:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.9"
              },
              "items": [
                {
                  "text": "44:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.23"
              },
              "items": [
                {
                  "text": "Guh 32:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda aramwishura, ati None twovuga iki ga mugenzi? canke twokwishura iki, canke twokwiregura dute? Imana yamenye ibigabitanyo vy’ abasavyi bawe: ehe tubaye abaja bawe, databuja, twe n’uwo igikombe kibonetseko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.16",
            "verseOrgIds": [
              "GEN.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwishura, ati Biragahera ko nokora ntyo! Uwo igikombe kibonetseko ni we azoba umuja wanje; ariko mweho ni mwīgīre, mudūge kwa so amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
              "GEN.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
