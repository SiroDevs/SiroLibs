              },
              "items": [
                {
                  "text": "Ita 42:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bacuranuye ibiri mu magunira yabo, basanga itu ry’amahera ry’umuntu wese riri mw igunira ryiwe: abo bose bo na se babonye ayo matu yabo y’ amahera, baratinya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        }
