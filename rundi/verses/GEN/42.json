                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reyubeni abarira se, ati Ni ntamukugarukanira, uze wice abahungu banje bompi; n’ umumpe, nzomukugarukanira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
