                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.36.8"
              },
              "items": [
                {
                  "text": "Yob 36:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.36.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze baravugana, bati Turikw inkurikizi ya murumuna wacu, s’ikindi, kuko twabonye intuntu yar’ afise mu mutima, hamwe yatwinginga, tukanka kumwumviriza; ni vyo bituzaniye ibi vyago. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
