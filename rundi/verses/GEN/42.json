        },
        {
          "text": "Maze Reyubeni arababgira, ati Sinababariye, nti Ntimugire ico mugira uwo mwana, mukanka kunyumvira? ni co gitumye amaraso yiwe aturondererwako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.22",
            "verseOrgIds": [
              "GEN.42.22"
            ]
          }
        },
        {
          "name": "verse",
