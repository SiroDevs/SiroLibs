              "items": [
                {
                  "text": "Ita 34:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Muheze munzanire umuhererezi wanyu; ati Ni ho nzomenya ko mutar’ abatasi, ariko ko mur’ abanyakuri; mpeze mbasubize mugenzi wanyu, mubone kugenda uburarame mur’ iki gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
