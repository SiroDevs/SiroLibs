              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se Yakobo arababarira, ati Muntōtōyekw abana: ehe Yosefu ntakiriho, na Simeyoni ntakiriho, none mugomba kunyaka na Benyamini: ivyo vyose ni jewe vyeguriweko! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        },
        {
          "name": "verse",
