            "number": "23",
            "style": "v",
            "sid": "GEN 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntibamenya ko Yosefu abumva, kuko yasobanurirwa n’uwundi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.23",
            "verseOrgIds": [
              "GEN.42.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arora irya, ararira; araheza agaruka kuri bo, arabasigurira, abakūramwo Simeyoni, amubohera mu maso yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.24",
            "verseOrgIds": [
              "GEN.42.24"
            ]
          }
        },
        {
