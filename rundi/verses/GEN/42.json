                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bat’ Umugabo aganza ico gihugu yatubariye adutera imirarwe, atugirira nk’aho tur’ abatasi batata igihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.30",
            "verseOrgIds": [
              "GEN.42.30"
            ]
          }
