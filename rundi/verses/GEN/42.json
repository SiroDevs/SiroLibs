                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yakobo yumva ko muri Egiputa har’ amasumo; abaza abana biwe, ati N’iki gituma murābana? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.8"
              },
              "items": [
                {
                  "text": "Ita 43:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.18"
              },
              "items": [
                {
                  "text": "Zab 33:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ati Numvise yuko muri Egiputa har’ amasumo: enda ni mumanuke mujeyo, mudusumire, kugira ngo tubeho, twoye gupfa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene se ba Yosefu ukw ari cumi baramanuka, baja gusuma imihure y’impeke muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.3",
            "verseOrgIds": [
              "GEN.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.18"
              },
              "items": [
                {
                  "text": "Ita 35:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.38"
              },
              "items": [
                {
                  "text": "42:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Benyamini, mwene nyina wa Yosefu, Yakobo ntiyamutumana na bakuru be, kuko yiyumvira, ati Kumbure yogira ic’ aba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bene Isirayeli bajana n’ abandi gusuma, kuko kigoyi cāteye mu gihugu c’i Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
