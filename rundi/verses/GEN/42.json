              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse i muhira kwa se Yakobo, mu gihugu c’i Kanani, bamudōndera ivyababayeko vyose, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.29",
