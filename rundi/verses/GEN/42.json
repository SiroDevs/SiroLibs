                  "text": "Neh 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira gatatu, Yosefu arababarira, at’ Enda genza murtya, mwoye gupfa, kuko ntinya Imana: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
              "GEN.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "namba mur’ abanyakuri, umwe muri mwebge asigare hano mw ibohero; abandi mugende, mujane imihure y’impeke yo kubamara inzara mu ngo zanyu: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.19",
            "verseOrgIds": [
              "GEN.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "muheze munzanire umuhererezi wanyu; ni ho amagambo yanyu azomenyekana kw ar’ay’ ukuri, bikabakiza ntimupfe. Baca bagenza bartyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
