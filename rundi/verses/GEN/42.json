            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugabo aganza ico gihugu, aratubarira, at’ Iki ni co kizommenyesha ko mur’ abanyakuri: ati Ni munsigarane umwe mu bo muvukana, mujane ivyo kubamara inzara mu ngo zanyu, mugende. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
