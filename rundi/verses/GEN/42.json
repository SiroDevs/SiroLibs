            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosefu agera ko babuzuriza impeke amagunira yabo, kandi ngo basubize amahera y’umuntu wese mw igunira ryiwe, kandi ngo babahe n’impamba: babagirira bartyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        }
