                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.7"
              },
              "items": [
                {
                  "text": "1 Kor 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu abarira Loti, ati Ndakwinginze, hoye kuba intonganya hagati yanje nawe, no hagati y’abungere banje n’abawe, kuko tuvukana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
