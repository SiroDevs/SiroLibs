              "items": [
                {
                  "text": "47:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ igihugu cose kir’ imbere yawe! Ndakwinginze ngo duhāne inta: ni wahitamwo kuja i bumoso nanje ndaja i buryo; ni waja i buryo ndaja i bumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        },
        {
