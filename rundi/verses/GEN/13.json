              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.15"
              },
              "items": [
                {
                  "text": "Ita 20:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.34.10"
              },
              "items": [
                {
                  "text": "34:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
