            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza umwe wo muri ba bamarayika ndwi bari bafise za nzavya ndwi, avugana nanje, arambgira, ati Ngwino nkwereke iteka rizocirwa maraya w’agahebuza, yicaye kw iteraniro ry’amazi menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
