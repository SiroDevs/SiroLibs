                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.3"
              },
              "items": [
                {
                  "text": "18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo abami bo kw isi bāsambana na we, ababa kw isi bakaborerwa vino, ni zo busambanyi bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Ivyah 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anjana mu bugaragwa ndi muri Mpwemu. Mbona umugore yicaye ku gikōko gisa n’agahama, cuzuye amazina y’amarogotano, gifise imitwe ndwi n’amahembe cumi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.13"
              },
              "items": [
                {
                  "text": "Ezk 28:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugore yambaye impuzu y’inyambarabami",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:4",
              "type": "text"
            },
            {
              "text": "inyambarabami",
              "type": "text"
            },
            {
              "text": ": rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.16.19"
              },
              "items": [
                {
                  "text": "Luk 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n’iy’ agahama, yari yisakaye izahabu n’utubuyenge tw’igiciro kinini n’imaragarita,",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:4",
              "type": "text"
            },
            {
              "text": "imaragarita",
              "type": "text"
            },
            {
              "text": ": rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.6"
              },
              "items": [
                {
                  "text": "Mat 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " afise igikombe c’izahabu mu minwe cuzuye ibihumanya n’imyanda y’ubusambanyi bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
