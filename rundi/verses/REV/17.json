          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Yes 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.8"
              },
              "items": [
                {
                  "text": "Ivyah 14:8",
