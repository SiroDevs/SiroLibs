              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ko nawe, ufise abakomeza inyigisho z’Abanikolayiti nk’uko nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
