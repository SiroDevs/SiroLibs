          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi namuhaye uburyo bgo kwihana, ntiyakunda kwihana ngw areke ubushakanyi bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
