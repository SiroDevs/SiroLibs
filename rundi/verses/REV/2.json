          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe ndamutsinda ku buriri, ndarungikira abasambana na we amarushwa menshi, ni batihana ibikorwa vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
