              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika wa gatanu aravuza. Mbona inyenyeri itibukiye mw isi ivuye kw ijuru; ihabga urupfunguzo rw’urusumanyenzi rw’i kuzimu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
