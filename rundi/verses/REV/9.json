            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yugurura urusumanyenzi rw’i kuzimu, rupfundukamw’ umwotsi nk’uw’ itanure rinini, izuba n’ikirēre bicurishwa umwiza n’umwotsi wo mur’ urwo rusumanyenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.12"
              },
              "items": [
                {
                  "text": "Kuv 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwotsi havamw’ inzige zija mw isi, zihabga ububasha bgo gukora ivyo sikorupiyo",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:3",
              "type": "text"
            },
            {
              "text": "sikorupiyo",
              "type": "text"
            },
            {
              "text": "ni co kimwe n’akamina: n’agakōko k’ubumara gakomoresha umurizo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " zo kw isi zibasha gukora. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
