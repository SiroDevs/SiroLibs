                "loc": "GEN.19.28"
              },
              "items": [
                {
                  "text": "Ita 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.18"
