                "loc": "DEU.32.40"
              },
              "items": [
                {
                  "text": "Gus 32:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika nabonye ahagaze ku kiyaga n’i musozi, amanika ukuboko kw’i buryo, agutunga mw ijuru, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
