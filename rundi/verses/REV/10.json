                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imituragaro ndwi imaze kuvuga nariko ngira nandike. Numva ijwi rivuye mw ijuru rimbarira, riti Matanisha ishashara udomemw’ ikimenyetso ivyo imituragaro ndwi ivuze, ntuvyandike. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.4",
            "verseOrgIds": [
              "REV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
