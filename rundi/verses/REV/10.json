              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rya jwi numvise rivuye mw ijuru nongera kuryumva rimbarira, riti Genda wābīre igitabo kizinguruye kiri mu kuboko kw’ umumarayika, ahagaze ku kiyaga n’i musozi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
