                "loc": "EZK.2.8"
              },
              "items": [
                {
                  "text": "Ezk 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.1+EZK.3.2+EZK.3.3"
              },
              "items": [
