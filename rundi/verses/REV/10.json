                  "text": "3:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nja ah’ uwo mumarayika ari, ndamubgira kumpa ako gatabo. Arambarira, at’ Enda ugatsontsomere, karakururira mu nda, ariko mu kanwa karagusosera nk’ubūki. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nābīra ako gatabo, ngakūra mu kuboko kw’umumarayika, ndagatsontsomera; mu kanwa kansosera nk’ubūki; mmaze kukarya mu nda hacika umururazi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
