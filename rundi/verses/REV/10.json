            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barambarira, bat’ Ukwiye kuzosubira kuvugishwa ivy’ amoko menshi n’amahanga menshi n’indimi nyinshi n’abami benshi.",
          "type": "text",
