              "items": [
                {
                  "text": "Am 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asemerera n’ijwi rirenga, nk’ukw intambge yivuga: asemereye, imituragaro ndwi ituragara amajwi yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
              "REV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
