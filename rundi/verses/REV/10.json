            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko mu misi y’ijwi ry’umumarayika w’indwi, ah’ azoba agira avuze inzamba, ni ho ibanga ry’Imana rizoba riheraherejwe, nk’uko yabariye abasavyi bayo ubutumwa bgiza, ni bo bavugishwa na yo.",
          "type": "text",
          "attrs": {
