              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wandikire umumarayika w’ishengero ry’i Sarudi, ut’ Ūfise Impwemu ndwi z’Imana n’inyenyeri ndwi, aravuga ibi, ngo Ndazi ibikorwa vyawe, k’uvugwa k’uri muzima, arik’ ur’ uwapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
