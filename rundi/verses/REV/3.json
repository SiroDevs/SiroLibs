                "loc": "EZK.34.4"
              },
              "items": [
                {
                  "text": "Ezk 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gira ube maso, ukomeze ibisigaye bigira bipfe: kukw ata bikorwa vyawe nabonye bisozerewe imbere y’Imana yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.2",
            "verseOrgIds": [
              "REV.3.2"
            ]
          }
        },
        {
