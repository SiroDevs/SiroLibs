            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgo bgato buganishirizwamw’ ibirenge inyuma ya ca gisagara, amaraso ava mu bgato, ashitsa stadiyo",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.20",
