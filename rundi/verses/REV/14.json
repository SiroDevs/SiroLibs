                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika wundi ava mu rusengero, asemerera n’ijwi rirenga, abgira ūvyagiye kur’ ico gicu, ati N’urungike umuhoro wawe, wimbure, kukw iyimbura rishitse, kand’ ivyimburwa vyo mw isi vyumye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
