          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūvyagiye ku gicu arekurira umuhoro wiwe mw isi, isi irimburwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
