            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika wundi ava ku gicaniro, ni we aganza umuriro, asemerera n’ijwi rirenga, abarira ūfise umuhoro ukarishe, ati Rungika umuhoro wawe ukarishe, uce inzabibu zo ku muzabibu w’isi, kukw inzabibu zawo zirungurije. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.18",
            "verseOrgIds": [
              "REV.14.18"
            ]
          }
        },
