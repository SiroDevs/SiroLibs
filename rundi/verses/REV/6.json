        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amennye ica kabiri kimatanije ca gitabo, numva ikigira kabiri mu binyabugingo, kiti Ngwino. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza iyindi farasi y’akagajo, ūyicayeko ahabga gukūra amahoro mw isi, ngo bicane: kand’ ahabga inkota ndende.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
