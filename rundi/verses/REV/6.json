              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona Umwagazi w’Intama amena kamwe muri twa dushashara ndwi tumatanije ca gitabo: numva kimwe muri vya binyabugingo bine kivuga nk’ijwi ry’inkuba, kiti Ngwino. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.8"
              },
              "items": [
                {
                  "text": "Zek 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.1+ZEC.6.2+ZEC.6.3"
              },
              "items": [
                {
                  "text": "6:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona ifarasi y’igitare, kand’ ūyicayeko yar’ afise umuheto, ahabga igitsibo, agenda anesha, kandi ngo yame anesha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
