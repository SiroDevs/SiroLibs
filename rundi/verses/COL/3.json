        },
        {
          "text": "Nuko mwice ingingo zanyu ziri mw isi, ubushakanyi, ibihumanya, ukwifuza kw’umubiri, ukwifuza kubi kwose, no kwifuza ivy’ abandi, ni kwo gusenga ibigirwamana; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
