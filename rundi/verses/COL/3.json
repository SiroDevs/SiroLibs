            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amahoro ya Kristo aganze mu mitima yanyu, ayo mwahamagariwe ngo mube umubiri umwe: kandi mube abama bakenguruka. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
            "verseOrgIds": [
              "COL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 3:16"
          },
          "items": [
