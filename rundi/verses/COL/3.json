                {
                  "text": "Gal 3:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho ntihaba Umugiriki cank’ Umuyuda, uwakebge cank’ ūtākebge, ūdebagura cank’ Umusikiti, umugurano cank’ uwidegemvya; ariko Kristo ni vyose, kand’ ari muri bose.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
