                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwihanganirana, muharirana, iy’ umuntu agize ico apfa n’uwundi. Nk’uk’ Umwami wacu yabahariye, namwe abe ari ko muharirana. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        },
