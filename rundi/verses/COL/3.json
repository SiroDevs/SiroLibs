                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo muzokora vyose, mu majambo no mu bikorwa, muhore mubikora vyose mw izina ry’Umwami Yesu, mushima Imana Data wa twese kubg’ uwo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.17",
            "verseOrgIds": [
              "COL.3.17"
            ]
          }
        }
