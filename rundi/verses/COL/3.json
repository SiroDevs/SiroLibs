              },
              "items": [
                {
                  "text": "Ef 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo rya Kristo ribe muri mwebge rigwiriye, ririmw’ ubgenge bgose: mwigishanye, muhanūrane, muririmba zaburi n’indirimbo n’amatazirano y’ivya Mpwemu, muririmbire Imana mu mitima yanyu mubiheshwa n’ubuntu bgayo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
