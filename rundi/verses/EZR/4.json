                "loc": "2KI.17.24"
              },
              "items": [
                {
                  "text": "2 Abam 17:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.6"
              },
              "items": [
                {
                  "text": "Ezr 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
