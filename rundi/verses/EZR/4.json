        },
        {
          "text": "Kandi ngo Hābamw’ abami bakomeye cane bāganza i Yerusalemu n’ igihugu cose co hakurya y’uruzi, ngo bagatorezwa ikori n’ikibuguro n’ingorore. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ni mushinge icagezwe bareke kwubaka, ico gisagara coye kwubakwa, gushitsa aho jewe nyene nzoryīkūrira mu kanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mwame mugavye ntimureburure mur’ ivyo, kugira ngw ikibi ntikigwire, abami bagakehanirwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
