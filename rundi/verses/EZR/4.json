          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya majambo n’amwe n’ayo mur’ ico cete bāmwandikiye, ngo Ku mwami Aritazeruzi, twebge abasavyi bawe bo hakuno y’uruzi turagize bgakeye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.3"
              },
              "items": [
                {
                  "text": "Ezr 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urazirikanye, Abayuda bāvuye iyo, bakaza bakadusanga i Yerusalemu, ubu bariko barasubira kwubaka ico gisagara kibi c’ikigarariji; bariko baruzuza uruzitiro, basana n’ amatanguriro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
