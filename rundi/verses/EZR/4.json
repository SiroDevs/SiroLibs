                {
                  "text": "6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbere Rehumu uwo mujanama na Shimushayi umukarani bafatanya kucandika na bagenzi babo bandi b’Abadinayi n’Abafarisatiki n’Abataripeli n’ Abafarisiti n’Abarikevi, n’Abanyababuloni n’Abashushanki n’ Abadehayi n’Abelamiti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ ayandi mahanga yose Osinapari umunyacubahiro ahambaye yajabukanye hakuno akabagerēra mu gisagara c’i Samariya, no mu kindi gihugu co hakuno y’ uruzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        }
      ]
