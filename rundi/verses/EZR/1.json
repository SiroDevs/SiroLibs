              "items": [
                {
                  "text": "6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’umwami Kuro asohora ibintu vy’imbombovu vyakoreshwa mu ngoro y’Uhoraho, ivyo Nebukadineza yari yaranyaze i Yerusalemu, akabishira mu kinyabugoro c’imana ziwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.14"
              },
              "items": [
                {
                  "text": "Ezr 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "izo mbombovu Kuro umwami w’i Buperesi mu kuzisohora atuma Mitiredati umuzezwabintu wiwe, na we aziharūrira imbere ya Sheshibazari umuganwa wo mu Bayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igitigiri cavyo ngiki: amasahani y’izahabu mirongwitatu, n’ay’ ifeza igihumbi, n’ imbugita mirongwibiri n’icenda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’amabakure y’izahabu mirongwitatu, n’amabakure y’ifeza y’uburyo bga kabiri amajana ane n’icumi, n’ibikoreshwa bindi igihumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibintu vy’imbombovu vy’izahabu n’ivy’ ifeza, vyose na vyose vyar’ ibihumbi bitanu n’ amajana ane. Ivyo vyose Sheshibazari yabijanye igihe abantu b’inyagano bāva i Babuloni bagasubira i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
