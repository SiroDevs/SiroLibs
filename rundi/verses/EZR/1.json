              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababanyi babo bose babaha intererano z’ibintu vy’amafeza n’amazahabu n’ibindi, bo n’ibitungano n’ibintu vy’igiciro kinini, ukūyemw’ ivyo bashikanye vyose bivuye ku mitima ikunze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
