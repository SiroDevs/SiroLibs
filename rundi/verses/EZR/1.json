                "loc": "EXO.12.35"
              },
              "items": [
                {
                  "text": "Kuv 12:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
