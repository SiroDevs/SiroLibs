          ]
        },
        {
          "text": "ni co gituma ayo mahera ukwiye kugira umwete cane wo kuzoyagura amamasa n’ amapfizi y’intama bo n’imyagazi, hamwe n’amashikanwa y’amafu n’ay’ ibiturire agendana na vyo, ukazobitangira ku gicaniro c’ingoro y’Imana yanyu i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
