            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana ya ba sogokuruza aragahezagirwa, yashize mu mutima w’umwami imigabo imeze irtyo, yo gushariza ingoro y’Uhoraho ir’ i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
