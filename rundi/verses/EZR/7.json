              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo, ku ngoma ya Aritazeruzi umwami w’i Buperesi, haza Ezira mwene Seraya, Seraya wa Azariya, Azariya wa Hilukiya, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilukiya wa Shalumu, Shalumu wa Sadoki, Sadoki wa Ahitubu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitubu wa Amariya, Amariya wa Azariya, Azariya wa Merayoti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merayoti wa Zerahiya, Zerahiya wa Uzi, Uzi wa Buki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buki wa Abishuwa, Abishuwa wa Finehasi, Finehasi wa Eleyazari, Eleyazari wa Aroni umuherezi mukuru; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
