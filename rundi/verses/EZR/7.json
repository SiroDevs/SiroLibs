                "loc": "DAN.2.37"
              },
              "items": [
                {
                  "text": "Dan 2:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo Jewe Aritazeruzi umwami aganza abami, ndakwandikiye Ezira umuherezi, umunyabgenge azi ivyagezwe vy’Imana Nyen’ ijuru: n’amahoro neza? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "None nshinze ibgirizwa ryo kurekura abo mu bantu b’ Abisirayeli bose baba mu bihugu vyanje bīgombera ubgabo kujana nawe i Yerusalemu, bo n’abaherezi babo n’Abalewi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.14"
              },
              "items": [
                {
                  "text": "Est 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jewe umwami n’abajanama banje ukw ar’ indwi, tugutumye ng’ uje kubaza ivy’ i Buyuda n’i Yerusalemu, nk’ukw ivyagezwe vy’Imana yawe bimeze, ivy’ ufise mu maboko yawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
