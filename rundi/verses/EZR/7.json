            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi turabamenyesha ivy’ abaherezi n’Abalewi, n’abaririmvyi n’abashibamyi, n’abahawe ibango ry’ibikorwa vy’urusengero, n’abakozi bo mur’ iyo ngoro y’ Imana bose uko bangana, ko bitemewe ko bākwa ikori cank’ ikibuguro cank’ ingorore. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        },
