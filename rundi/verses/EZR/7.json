              "items": [
                {
                  "text": "2 Ngo 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.8.25"
              },
              "items": [
                {
                  "text": "Ezr 8:25",
                  "type": "text"
                }
