              },
              "items": [
                {
                  "text": "Ezr 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni we yerekanye imbabazi ziwe kuri jewe imbere y’ umwami n’abajanama biwe, n’ imbere y’abaganwa biwe bose bahambaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
