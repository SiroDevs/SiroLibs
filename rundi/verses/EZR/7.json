            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bo n’amafeza yose n’amazahabu uzosanga mu gihugu c’i Babuloni cose, hamwe n’amashikanwa y’abantu n’ay’ abaherezi, ayo bāshikaniye ingoro y’Imana yabo ir’ i Yerusalemu bivuye ku mitima; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
