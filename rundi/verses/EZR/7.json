          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya majambo n’amwe n’ayo mu cete umwami Aritazeruzi yahaye Ezira umuherezi ari we mwanditsi, mbere yar’ umwanditsi azi amajambo y’ivyagezwe vy’ Uhoraho n’ivyo yashingiye Abisirayeli: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
