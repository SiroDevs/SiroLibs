            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko Ezira yari yarīnāmūye mu mutima kwitwaririka ivyagezwe vy’Uhoraho ngw abishitse, kandi ngo yigishe mu Bisirayeli amabgirizwa n’amatēka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
