                "loc": "PSA.135.21"
              },
              "items": [
                {
                  "text": "Zab 135:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ng’ ugende ujanye amafeza n’amazahabu, ayo jewe umwami n’abajanama banje twashikaniye Imana y’Abisirayeli iba i Yerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
