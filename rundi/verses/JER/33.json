              "items": [
                {
                  "text": "Yer 24:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzotuma Abayuda n’Abisirayeli bahindukira bave mu kinyago, nzosubira mbubake nk’uko vyari bir’ ubga mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
