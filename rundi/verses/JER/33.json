                {
                  "text": "Yer 30:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti Rāba nzohazanira gukira no kuvūrwa, kandi nzobavūra; nzobahishurira amahoro bo n’ukuri vy’isinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
