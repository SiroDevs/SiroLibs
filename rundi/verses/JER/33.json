                  "text": "Ita 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ukw ingabo zose z’inyenyeri zo kw ijuru zitoharūrika, n’umusenyi wo ku kiyaga utogereka, ni ko nzogwiza uruvyaro rwa Dawidi umusavyi wanje, n’urw’ Abalewi bankorera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’Uhoraho riza kuri Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mbega ntiwiyumviriye ivyo aba bantu bavuga, ngw Imiryango yompi Uhoraho yatoranije yayicīye? Uko ni ko bakēngēra abantu banje, kuko bagira ngo ntibakir’ ihanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko mvuze, jewe Uhoraho, nti Namb’ isezerano ryanje ryāshinze umurango n’ijoro ritāhamye, namba ntāshinze ivyagezwe vy’ijuru n’isi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero nzoca n’uruvyaro rwa Yakobo, n’urwa Dawidi umusavyi wanje, ngo noye gutora mu ruvyaro rwiwe abo kuganza uruvyaro rwa Aburahamu na Isaka na Yakobo; kuko nzotuma bahindukira bakava mu kinyago, kandi nzobagirira imbabazi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
