              "items": [
                {
                  "text": "Kuv 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uhoraho abikora, Uhoraho abirema akabikomeza, Uhoraho ni ryo zina ryiwe, uku ni kw agize, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
