              "items": [
                {
                  "text": "Yer 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Mpamagara, nanje ndakwitaba, nkwereke ibihambaye n’ivyikinze, ivy’ utaribgamenye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
