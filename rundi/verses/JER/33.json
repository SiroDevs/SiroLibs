          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi Abayuda bazokira, i Yerusalemu hazoba amahoro: kand’ iri ni ryo zina hazokwitwa, ng’ Uhoraho ni we kugororoka kwacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
