            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari ko mvuze, jewe Uhoraho, nti Dawidi ntazokwigera abura uwo kuzokwama ku ngoma yiwe, aganza ab’ inzu ya Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
