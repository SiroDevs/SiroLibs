              "items": [
                {
                  "text": "Yer 32:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari ko mvuze, jewe Uhoraho, Imana y’Abisirayeli, ku vy’amazu yo mur’ iki gisagara, no ku vy’ingoro z’umwami w’i Buyuda, vyasambuwe ngo bavyubakishe aho kwikingiriza ngo barwanye abitwaje inkota būrira ku birundo kubatera, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
