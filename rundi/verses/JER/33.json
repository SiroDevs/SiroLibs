              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobōza ibigabitanyo vyabo vyose, ivyo bangabitanijeko; nzobaharira ibigabitanyo vyabo vyose bangabitanijeko n’ivyo bancumuyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.8",
            "verseOrgIds": [
              "JER.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
