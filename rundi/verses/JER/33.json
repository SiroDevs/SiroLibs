            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’Uhoraho ryongera kuza kuri Yeremiya ubugira kabiri, acugaraniwe mu rugo rw’ibohero, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
