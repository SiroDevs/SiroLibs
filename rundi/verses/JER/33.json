              "items": [
                {
                  "text": "Yoh 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imikuku izosubira gutaha itonze imirongo mu bisagara vyo mu mugamba waho, no mu bisagara vyo mu bihugu biciye bugufi, no mu bisagara vy’i bumanuko, no mu gihugu ca Benyamini n’ahantu hahereranye n’i Yerusalemu, no mu bisagara vy’i Buyuda, bayiharūre, ni jewe Uhoraho mbivuze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
