                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’Uhoraho agize, ati Namba mwoshobora guhindura isezerano ryanje ryashinze umurango k’ubaho, n’isezerano ryanje ryashinze ijoro ko ribaho, ng’ umurango n’ijoro ntibikūranwe mu bihe vyavyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
