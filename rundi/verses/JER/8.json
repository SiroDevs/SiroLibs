                {
                  "text": "Rom 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ubabgire, ut’ Uku ni k’Uhoraho abaza, ati Mbeg’ abantu iyo batemvye ntibasubira kuvyuka? Cank’ umuntu iy’ ahuvye inzira ntasubira kugaruka? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.24"
              },
              "items": [
                {
                  "text": "Yer 7:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.6"
              },
              "items": [
                {
                  "text": "9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero n’iki cashubije inyuma aba bantu b’i Yerusalemu, bagasubira inyuma akagīrīre? Bakobereza ubugunge, bakanka kugaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.39.19+JOB.39.20+JOB.39.21+JOB.39.22+JOB.39.23+JOB.39.24+JOB.39.25"
              },
              "items": [
                {
                  "text": "Yob 39:19-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.9"
              },
              "items": [
                {
                  "text": "2 Pet 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narateze ugutwi ndumviriza, ariko nta ho bavuga ukuri: nta muntu yihannye ibibi vyiwe, ngo yibaze, ati Mbeg’ ico nakoze n’igiki? Umuntu wese apfa guhuruduka, akajana inzira yiwe, ameze nk’ifarasi igenda akabushungwe yirukira mu ntambara. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
