                {
                  "text": "Yes 39:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umve, ijwi ry’ugutakamba kw’umukobga, ari we bgoko bgacu, rituruka hirya no hino mu gihugu, riti Mbeg’ Uhoraho ntakiba i Siyoni? Mbeg’ Umwami waho si ho akiri? Mbega na bo n’iki catumye bandakisha ibishushanyo vyabo bibājwe, n’ ivy’ imburakimazi vy’ivyaduka? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.19",
            "verseOrgIds": [
              "JER.8.19"
            ]
          }
        },
