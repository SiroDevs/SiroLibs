              "items": [
                {
                  "text": "Mat 21:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6"
              },
              "items": [
                {
                  "text": "Luk 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobanzura rwose, ni jewe Uhoraho mbivuze: nta nzabibu zizoba zikiba ku muzabibu, cank’ insukoni ku musukoni, n’ibibabi bizokabirana; kand’ ibintu nabahaye bizobavako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.13",
            "verseOrgIds": [
              "JER.8.13"
            ]
          }
        }
      ]
    },
