              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bat’ Igihe c’iyimbura kirashize, ici rirahise, natwe ntituragakira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.20",
            "verseOrgIds": [
