              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mber’ igisīga sarumfune co mu kirēre kizi ibihe vyaco cāgerewe, kand’ intunguru n’intamba n’inyanāna bimenya ibihe vyavyo vyo kuziramwo; arikw abantu banje bo ntibazi ibgirizwa ryanje, jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.17"
              },
              "items": [
                {
                  "text": "Rom 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvugira iki, muti Tur’ abanyabgenge, kandi mut’ Ivyagezwe vy’Uhoraho bibana natwe? Ereg’ abanditsi banyu bandikishije ikaramu y’ibinyoma, banditse ibitar’ ivy’ ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.19"
              },
              "items": [
                {
                  "text": "1 Kor 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyabgenge baratēterewe, barajorewe, bafashwe mpiri: erega n’uko bāgaye ijambo ryanje Uhoraho; mbeg’ ubgenge buri muri bo n’ubuki? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.12+JER.6.13+JER.6.14+JER.6.15"
              },
              "items": [
                {
                  "text": "Yer 6:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.11"
              },
              "items": [
                {
                  "text": "Yes 56:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gitumye abagore babo nzobaha abandi, n’amatongo yabo nkazoyaha abandi bakayegukira: kuk’ umuntu wese, uhereye kuri nyarucari muri bo ugashitsa no k’ūhambaye wo muri bo, yifuza inyungu mbi: kand’ uhereye kuri ba kamenyi ugashitsa no ku baherezi, umuntu wese aragunga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bāvūye imirenzako igikomere ca wa mukobga ari bo bantu banje, bavuga, bati N’amahoro, n’amahoro; kand’ ata mahoro ariho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.3"
              },
              "items": [
                {
                  "text": "Yer 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.5"
              },
              "items": [
                {
                  "text": "Hos 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega har’ isoni bāgize, bamaze gukora ibizira? Eka nta dusoni na mba, nta n’ukumāramāra. Ni co gituma bazotembana n’abari ku mutembo; igihe nzobazira bazogwaho, ni jewe Uhoraho mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.12",
            "verseOrgIds": [
              "JER.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
