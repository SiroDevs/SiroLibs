              "items": [
                {
                  "text": "Lew 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.53"
              },
              "items": [
                {
                  "text": "Gus 28:53",
