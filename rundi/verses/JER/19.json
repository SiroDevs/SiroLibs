              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.11"
              },
              "items": [
                {
                  "text": "1 Sam 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.20"
              },
              "items": [
                {
                  "text": "Yer 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Ni mwumve ijambo ry’Uhoraho, mwebge bami b’i Buyuda, namwe ababa i Yerusalemu; uku ni k’ Uhoraho Nyen’ ingabo agize, ni we Mana y’Abisirayeli, at’ Ehe nzozana ivyago aha hantu, kand’ ūzovyumva wese iminzerere izomuvuga mu matwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.16"
              },
              "items": [
                {
                  "text": "Yer 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.34"
              },
              "items": [
                {
                  "text": "2:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.16"
              },
              "items": [
                {
                  "text": "2 Abam 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bāntaye, bagahumanya aha hantu, bakahoserereza imibavu izindi mana batigeze kumenya, bo na ba sekuruza n’abami b’i Buyuda; bakuzuza aha hantu ibitenga vy’ amaraso y’abatācumuye; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
