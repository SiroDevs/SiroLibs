        },
        {
          "text": "Uku ni k’Uhoraho yagize, ati Genda ugure ikarabo ku mubumvyi, uheze ujane abashingantahe bo mur’ ubu bgoko, n’ abakuru b’abaherezi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ugende ushike mu mwonga wa mwene Hinomu, aherekeye mw ishikiro ry’irembo ry’ababumvyi, uhavugire amajambo nkubarira: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
