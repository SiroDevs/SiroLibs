                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Lew 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.35"
              },
              "items": [
                {
                  "text": "Yer 32:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31+JER.7.32+JER.7.33"
              },
              "items": [
