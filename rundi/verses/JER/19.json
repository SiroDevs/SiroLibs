              },
              "items": [
                {
                  "text": "2 Abam 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko nzogirira aha hantu, bo n’abahaba, ni jewe Uhoraho mbivuze, mpindure iki gisagara kibe nk’i Tofeti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
