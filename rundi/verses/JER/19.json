                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagataba ibitabo vya Bayali, ngo bahosereze abahungu babo mu muriro, babe ibimazi vyosherejwe Bayali; ar’ ikintu ntābageze, ntāvuze, kitigeze no kuza mu mutima wanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, umve, imisi igira ize, ni jewe Uhoraho mbivuze, aha hantu ntihazoba hacitwa Tofeti, canke ngo hitwe Umwonga wa mwene Hinomu; ariko hazokwitwa Umwonga w’Imihindigiti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.17"
              },
              "items": [
                {
                  "text": "Lew 26:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.3"
              },
              "items": [
                {
                  "text": "Yes 19:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzohindurira ubusa aha hantu inama z’i Buyuda n’iz’ i Yerusalemu; nzobahindikiranya n’inkota imbere y’abansi babo, bicwe n’amaboko y’ababahīga: kand’ imivyimba yabo nzoyigabura ibe inyama z’ibisīga vyo mu kirēre, n’iz’ ibikōko vyo kw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.16"
              },
              "items": [
                {
                  "text": "Yer 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzohindura iki gisagara akajoreza, n’ico kuvuzwakw agahwa; umuntu wese azohaca azojorerwa, avuze agahwa kubg’ ivyago vyaho vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
