                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.10"
              },
              "items": [
                {
                  "text": "Ezk 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzotuma barya abahungu babo n’abakobga babo, umuntu wese aryekw inyama mugenzi we, kubgo kwugarizwa no gusugerezwa, basugerejwe n’abansi babo n’ababahīga ngo babice.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
