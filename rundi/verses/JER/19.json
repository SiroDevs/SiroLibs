                {
                  "text": "Int 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubabgire, ut’ Uku ni k’Uhoraho Nyen’ ingabo agize, at’ Uko ni ko nzosāvya ubu bgoko n’iki gisagara, nk’uk’ umuntu asāvya ikibumbano, kidashobora kwungwa ukundi: uti Maze bazohamba i Tofeti gushitsa aho batazoba bagishigaje n’akanya k’aho bahamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
