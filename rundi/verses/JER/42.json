          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababarira, at’ Uku ni k’Uhoraho agize, ni we Mana y’Abisirayeli, uwo mwantumyeko kumushikiriza ivyo mwasavye: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        },
        {
