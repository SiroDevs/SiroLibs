                "loc": "EZR.8.21"
              },
              "items": [
                {
                  "text": "Ezr 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ng’ Uhoraho Imana yawe atwereke uko dukwiye kugenza n’ico dukwiye gukora. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
              "JER.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.18"
              },
              "items": [
                {
                  "text": "1 Sam 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwavugishwa n’Imana Yeremiya arabishura, at’ Ego ndumvise; ngiye kubasengera k’Uhoraho Imana yanyu nk’uko muvuze: maz’ ico Uhoraho azonyishura cose nzokibabarira; sinzogira ico mbahisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
