                  "text": "Neh 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngw Azobaha kumutera akagongwe, kugira ngw abagirire imbabazi, abasubize mu gihugu canyu bgite. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
