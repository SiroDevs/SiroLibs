          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagara Yohanani mwene Kareya, n’abagabisha b’ingabo bose bāri kumwe na we, n’abantu bose uhereye ku boroshe ugashitsa ku bahambaye, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
