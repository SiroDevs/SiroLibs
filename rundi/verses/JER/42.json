            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukavuga, mut’ Oya, ariko tugomba kuja mu gihugu ca Egiputa, aho tutazobona intambara, canke ngo twumve ijwi ry’inzamba, canke ngo tubure indya; abe ari ho tuba: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
        {
