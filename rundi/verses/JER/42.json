                  "text": "24:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Ni mwakomeza kuguma mur’ iki gihugu, azobubaka, ntazobasambura; azobatēragira, ntazobarandura: ngo Kuko yigaruye mu vyago yabateje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.10",
            "verseOrgIds": [
              "JER.42.10"
            ]
          }
        },
        {
