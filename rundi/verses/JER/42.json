            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "none rero gira mwumve ijambo ry’Uhoraho, mwebge amasigarira y’i Buyuda: uku ni k’Uhoraho Nyen’ ingabo agize, ni we Mana y’Abisirayeli, ati Ni mwerekeza amaso rwose muri Egiputa, ngw abe ari yo muja kuba; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.15",
            "verseOrgIds": [
              "JER.42.15"
            ]
          }
        },
