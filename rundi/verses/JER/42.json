            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw imisi cumi ihise, ijambo ry’Uhoraho riza kuri Yeremiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
