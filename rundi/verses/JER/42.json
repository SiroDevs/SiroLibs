            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngw Ariko ni mwavuga, muti Ntitukigomba kuba mur’ iki gihugu; bigatuma mutamwumvira, ari we Uhoraho Imana yanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
