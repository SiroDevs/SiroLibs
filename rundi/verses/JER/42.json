                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo Reka gutinya umwami w’i Babuloni, uwo mutinya uwo; ntimumutinye, ni k’Uhoraho agize; ngo Kukw ari kumwe namwe ngw abakize, abarokore abakūre mu kuboko kwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
          }
        },
        {
