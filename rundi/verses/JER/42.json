                "loc": "JER.7.23"
              },
              "items": [
                {
                  "text": "Yer 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ar’ ivyiza ar’ ibibi, ntituzobura kwumvira Uhoraho Imana yacu, uwo tugutumyeko; kugira ngo tuze tubone kuroranirwa ni twumvira Uhoraho Imana yacu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        }
