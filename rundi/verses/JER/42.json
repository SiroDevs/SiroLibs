                {
                  "text": "Yer 40:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bēgēra uwavugishwa n’Imana Yeremiya, bati Turakwinginze, emera ico tugusaba, udusengere k’Uhoraho Imana yawe, twebge aya masigarira twese; kuko dusigaye turi bake twahora turi benshi, nk’uko nawe utwibonera: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.2",
            "verseOrgIds": [
              "JER.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 42:3"
          },
          "items": [
            {
