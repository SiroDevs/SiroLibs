              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ni mumenye mudakekeranya yuko muzokwicirwa n’inkota n’ inzara n’ikīza, aho hantu aho mwifuza kuja kuba.",
          "type": "text",
          "attrs": {
