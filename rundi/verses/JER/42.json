              "items": [
                {
                  "text": "3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishura Yeremiya, bat’ Uhoraho n’atubere icabona c’ ukuri c’ukwizigirwa, ni tutākora nk’ukw ijambo ryose rimeze, iryo Uhoraho Imana yawe azokudutumako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
