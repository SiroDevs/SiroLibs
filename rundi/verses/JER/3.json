          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uhereye no mu buto bgacu, ivy’ akamāramāza ni vyo vyāmaze ivyāvuye mu butame bga ba sogokuruza; vyāmaze imikuku yabo n’amasho yabo, n’abahungu babo n’abakobga babo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
