                  "text": "Yer 30:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuka, mwa bantu basubiye inyuma, nzoharira ugusubira inyuma kwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
