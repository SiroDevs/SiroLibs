            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbahe abungere bameze nk’uk’ umutima wanje ugomba, bazobaragirana ubgenge no gutahura. ",
          "type": "text",
          "attrs": {
