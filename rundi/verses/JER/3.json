                  "text": "Yer 31:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi rirumvikanira ku mpinga mu ruharabuga, ry’ukurira no kwinginga kw’Abisirayeli, kuko bāgoretse inzira yabo, bakanyibagira jewe Uhoraho Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        },
        {
          "name": "verse",
