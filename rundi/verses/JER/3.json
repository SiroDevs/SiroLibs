            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuka, mwa bantu basubiye inyuma, ni jewe Uhoraho mbivuze, kuko jewe nd’ umugabo wanyu; kandi nzobagarukana i Siyoni, umwe ndamukūye mu gisagara kimwe, babiri mu muryango umwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
