                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko narībajije, nti Nogushira nte mu bana banje, nkaguha igihugu c’igikundiro, nkaguha umwandu mwiza uruta iy’ ayandi mahanga yose? Nari naravuze, nti Muzonyita umuvyeyi wanyu, kandi ntimuzokebanuka ngo mumve inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        },
