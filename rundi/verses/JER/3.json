                "loc": "DEU.24.1+DEU.24.2+DEU.24.3+DEU.24.4"
              },
              "items": [
                {
                  "text": "Gus 24:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baravuga, bat’ Umuntu ni yirukana umugore wiwe bakavana, akābīrwa n’uwundi mugabo, mbeg’ uwo mugabo wiwe yosubira kumugarukana ukundi? Mbega n’igihugu nyene nticoba cononekaye? Nawe wīgize maraya ku būzure batari bake; non’ ugira ngo wongarukako? ni jewe Uhoraho mbibajije. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.25"
              },
              "items": [
                {
                  "text": "Ezk 16:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unamurira amaso ku mpinga mu ruharabuga, witegereze: mbeg’ aho batāryamanye nawe ni hehe? Wabategeye ku mayira, nk’uk’ Umwarabo ategera mu bugaragwa; wononesheje igihugu ubusambanyi bgawe n’ivyaha vyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.24"
              },
              "items": [
                {
                  "text": "Gus 28:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.15"
              },
              "items": [
                {
                  "text": "Yer 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.12"
              },
              "items": [
                {
                  "text": "8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gitumye imvura ibuzwa, ntigwe no mu gihe cobaye urushana; yamara na ho nyene wāraritse uruhanga nka maraya, ntiwaruha ugira n’udusoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbe ntiwoca uhēra ubu ukantakambira, uti Muvyeyi wanje, ni wewe wandōngōra mu buto bganje? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.9"
              },
              "items": [
                {
                  "text": "Zab 103:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Mbeg’ uzohorana uburake imisi yose? Uzobgamana gushitsa kw iherezo? Mbega si wewe wavuze ibintu bibi, ugatak’ ukabikora, ukīgira uk’ ugomba?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
