                "loc": "JER.2.20"
              },
              "items": [
                {
                  "text": "Yer 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku ngoma y’umwami Yosiya, Uhoraho arambarira, ati Mbega wabonye ico Isirayeli Inamusubiranyuma yakoze? Yadūze umusozi wose muremure, akaja no musi y’igiti cose gitōtahaye, akīhindurirayo maraya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.16.46"
              },
              "items": [
                {
                  "text": "Ezk 16:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.4"
              },
              "items": [
                {
                  "text": "23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze gukora ivyo vyose, naravuze, nt’ Azongarukako; maze ntiyagaruka; kandi mwene nyina Yuda Inamuryarukanyi arabibona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.19"
              },
              "items": [
                {
                  "text": "2 Abam 17:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.1.6"
              },
              "items": [
                {
                  "text": "Hos 1:6",
