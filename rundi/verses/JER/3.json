              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nk’uk’ umugore aryāruka umugabo wiwe akamuta, uko ni ko namwe mwandyārutse, mwebge ab’ inzu ya Isirayeli, ni jewe Uhoraho mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        },
        {
