              "items": [
                {
                  "text": "Yer 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arik’ uzokwipfira bupfe; nk’ uko boshereje imibavu ba sogokuruza, abami bākwitangiye imbere, ni ko bazoyikwosereza nawe; bazokuborogera, bati Yewe mwami wacu! uti Kukw ari we avuze iryo jambo, uti Ni kw agize.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        }
