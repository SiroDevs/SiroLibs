                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ryaje kuri Yeremiya rivuye k’Uhoraho, igihe Nebukadineza umwami w’i Babuloni n’ingabo ziwe zose n’abami bo mw isi yose yaganzwa na we, n’ amahanga yose, bāriko bararwana n’i Yerusalemu n’ibisagara vyaho vyose, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.2"
              },
              "items": [
                {
                  "text": "2 Abam 25:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.10"
              },
              "items": [
                {
                  "text": "Yer 21:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’Uhoraho agize, ni we Mana y’Abisirayeli, ati Genda ubarire Zedekiya umwami w’i Buyuda, umubgire, ut’ Uku ni k’Uhoraho agize, ngw Eh’ azotanga iki gisagara mu kuboko kw’ umwami w’i Babuloni, na we azogitongoza umuriro: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe ubgawe ntuzomukira, ntuzobura gufatwa ng’ utangwe mu kuboko kwiwe; uzomwibonera imbonankubone, na we muzokwivuganira; kand’ uzoja i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.17"
              },
              "items": [
                {
                  "text": "Yer 38:17",
                  "type": "text"
                }
