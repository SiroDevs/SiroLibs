                  "text": "Lew 25:39-46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.8"
              },
              "items": [
                {
                  "text": "Neh 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ng’ umuntu wese arekure umuja wiwe, ar’ uwitwa umuhungu, cank’ umukobga, ar’ Umuheburayo cank’ Umuheburayokazi abe uwidegemvya; kugira ngo hoye kuba ūbagaba, ar’ Umuyuda ngw agabe mugenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abaganwa bose n’ abantu bose baramwumvira, abāri basezeranye iryo sezerano ry’uk’ umuntu wese akwiye kurekura umuja wiwe, ar’ uwitwa umuhungu cank’ umukobga, abe uwidegemvya, ngo hoye kuba ūkibagaba; baramwumvira, barabarekura; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko hanyuma barihindukiza, bagarukana abo baja b’abahungu n’abakobga, abo bāri barekuye ngo babe abidegemvya, babasubiza mu buja ukw ar’ abahungu n’abakobga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico ni co catumye ijambo ry’Uhoraho riza kuri Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’ Uhoraho agize, ni we Mana y’ Abisirayeli, ati Nasezeranye isezerano na ba sogokuruza, umusi nabakūra mu gihugu ca Egiputa, no mu nzu y’ubuja, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.12"
              },
              "items": [
                {
                  "text": "Gus 15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nt’ Ukw imyaka ndwi igiye gushira, umuntu wese az’ arekure mugenzi we w’Umuheburayo, uwo yaguze akamukorera imyaka ndwi, amurekure amuveko, abe uwidegemvya: yamara ba sogokuruza ntibānyumvira, canke ngo bantege ugutwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.14",
            "verseOrgIds": [
              "JER.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.3"
              },
              "items": [
                {
                  "text": "2 Abam 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mweho mwari mwigaruye, mukora igitunganye mu nyonga zanje, mutanga umwidegemvyo, umuntu wese arekura mugenzi we; kandi mwari musezeraniye isezerano imbere yanje mu ngoro yitirirwa izina ryanje; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.15",
            "verseOrgIds": [
              "JER.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Lew 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze murihindukiza, mutukisha izina ryanje, umuntu wese agarukana umuja wiwe ar’ umuhungu cank’ umukobga, abo mwari mwarekuye ngo babe abidegemvya uko bagomba; mubasubiza mu buja ukw ar’ abahungu n’abakobga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.16",
            "verseOrgIds": [
              "JER.34.16"
            ]
          }
        },
        {
