            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ryaje kuri Yeremiya rivuye k’Uhoraho, igihe umwami Zedekiya yar’ amaze gusezerana isezerano n’abantu bose b’i Yerusalemu, ryo gutanga umwidegemvyo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
