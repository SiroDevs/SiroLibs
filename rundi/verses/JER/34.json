                  "text": "Yak 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni ko mvuze, jewe Uhoraho, nti Ntimwanyumviye, ngo mutange umwidegemvyo, ng’ umuntu wese arekure mwene wabo, umuntu wese arekure mugenzi we: nuko rero nanje ntanze umwidegemvyo kuri mwebge, ni jewe Uhoraho mbivuze, w’inkota n’ikīza n’inzara; kandi nzotuma mutererekanywa irya n’ino mu bihugu vy’ abami bose bo mw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.17",
            "verseOrgIds": [
              "JER.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
