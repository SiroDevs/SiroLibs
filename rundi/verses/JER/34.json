            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Yamara ni wumve ijambo ryiwe Uhoraho, ewe Zedekiya mwami w’i Buyuda: ut’ Uku ni kw avuze ku vyawe, ati Ntuzokwicwa n’inkota, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
