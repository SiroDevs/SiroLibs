              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ ūvugishwa n’Imana Yeremiya abarira Zedekiya umwami w’i Buyuda ayo majambo yose ar’ i Yerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe ingabo z’umwami w’i Babuloni zāriko zirarwana n’i Yerusalemu n’ibisagara vyose vy’i Buyuda vyari bigisigaye, n’i Lakishi n’i Azeka; kukw ivyo ari vyo vyari bigisigaye mu bisagara vy’i Buyuda bikizitiriwe inzitiro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        }
      ]
