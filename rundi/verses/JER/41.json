              "JER.41.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.25"
              },
              "items": [
                {
                  "text": "2 Abam 25:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.41.9"
              },
              "items": [
                {
                  "text": "Zab 41:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu kwezi kw’indwi, Ishimayeli mwene Netaniya, Netaniya wa Elishama, wo mu nda y’ingoma, ari we umwe mu babgiriza bakuru b’umwami, azanana n’abantu cumi, aja kuri Gedaliya mwene Ahikamu i Mizipa; nuko basangirira na we aho nyene i Mizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.28"
              },
              "items": [
                {
                  "text": "2 Sam 13:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ishimayeli mwene Netaniya avana hasi n’abo bagabo cumi bāri kumwe na we, bacumita inkota Gedaliya mwene Ahikamu, Ahikamu wa Shafani, baramwica, kand’ ari we umwami w’i Babuloni yashizeho kuganza igihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimayeli yica kandi n’ Abayuda bāri kumwe na Gedaliya i Mizipa, bo n’abasoda b’Abakaludaya bāri basanzweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye ku musi ugira kabiri amaze kwica Gedaliya, kand’ ata wurabimenya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.1"
              },
              "items": [
                {
                  "text": "Gus 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.24"
              },
              "items": [
                {
                  "text": "1 Abam 16:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Yes 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "haza bamwe bavuye i Shekemu n’i Shilo n’i Samariya, abagabo mirongumunani, bāri bimosheje ubganwa bgabo inkomvorera, bitantamuriyekw impuzu zabo, bikebaguye ku mibiri, bazanye amashikanwa n’imibavu mu minwe, ngo babizane mu ngoro y’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ishimayeli mwene Netaniya ava i Mizipa ngw aje kubasanganira, agenda arira ingenda: abasanganiye, arababarira, ati Ni muze kuri Gedaliya mwene Ahikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bamaze gushika hagati mu gisagara, Ishimayeli mwene Netaniya arabica, afatanije n’abagabo bāri kumwe na we, abashiburira mu cobo co kubīka amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.11"
              },
              "items": [
                {
                  "text": "Abac 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko haboneka abagabo cumi muri bo bīsaba Ishimayeli, bati Ntutwice, kuko dufise ivyo twaziganije, twānyegeje mu misozi, ingano na sayiri n’amavuta ya elayo n’ubūki. Nukw arigarura, ntiyabicana na bagenzi babo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.22"
              },
              "items": [
                {
                  "text": "1 Abam 15:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ico cobo Ishimayeli yashiburiyemw’ imivyimba yose y’abo yishe, ikahasanga uwa Gedaliya, ni co cari cimbishije umwami Asa kubgo gutinya Bayasha umwami w’Abisirayeli. Ishimayeli mwene Netaniya acuzuza abishwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.23"
              },
              "items": [
                {
                  "text": "Yer 38:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.14"
              },
              "items": [
                {
                  "text": "40:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ishimayeli ajana kw inyagano amasigarira yose y’abantu bār’ i Mizipa, ni bo bakobga b’umwami n’abantu bose bāri bagisigaye i Mizipa, abo Nebuzaradani umukuru w’abashibamyi yari yaragije Gedaliya mwene Ahikamu. Nuko Ishimayeli mwene Netaniya abajana kw inyagano, avayo ngw aje mu Bamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yohanani mwene Kareya, n’abagabisha bose b’ingabo bāri kumwe na we, bumvise ivyo bibi vyose Ishimayeli mwene Netaniya yakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.13"
              },
              "items": [
                {
                  "text": "2 Sam 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bajana n’ ingabo zose, baja kurwanya Ishimayeli mwene Netaniya, bamusanga hafi y’ikidengeri kinini c’i Gibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bose bāri kumwe na Ishimayeli babonye Yohanani mwene Kareya n’abagabisha b’ingabo bose bāri kumwe na we, baranezerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bose Ishimayeli yarajanye kw inyagano abakūye i Mizipa, barahindukira, baherēra kuri Yohanani mwene Kareya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Ishimayeli mwene Netaniya, bo n’abagabo munani, bacikana Yohanani, baja mu Bamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yohanani mwene Kareya, n’abagabisha b’ingabo bose bāri kumwe na we, ajana amasigarira y’abantu yari yatse Ishimayeli mwene Netaniya, yarakūye i Mizipa amaze kwica Gedaliya mwene Ahikamu, abagabo n’abagore n’abana n’ inkone, abagarukaniye i Gibeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.37"
              },
              "items": [
                {
                  "text": "2 Sam 19:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baragenda baba barifashije i Geruti‐Cimuhamu hahereranye n’i Betelehemu, ngo baje muri Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubg’ Abakaludaya: kuko bābatinya, kuko Ishimayeli mwene Netaniya yari yishe Gedaliya mwene Ahikamu, uwo umwami w’i Babuloni yari yarashizeho kuganza igihugu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
