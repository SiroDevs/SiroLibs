                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo bizokubako, ni wo mugabane nkugereye, ni jewe Uhoraho mbivuze, kuko wanyibagiye ukizigira ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        },
        {
