          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero nanje nzogukūrakw impuzu, mfate ku musozo ndenze ku mutwe wawe, ubgambure bgawe buboneke. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.26",
