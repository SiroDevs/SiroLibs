              },
              "items": [
                {
                  "text": "Mat 19:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ Umunyetiyopiya yoshobora guhindura urukoba rw’umubiri wiwe, cank’ ingwe yokwihindura amabara yayo? Ivyo bishobotse, namwe mwoshobora gukora ivyiza, mwebge abāmogoreye gukora ibibi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
