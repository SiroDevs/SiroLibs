                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo wironkeyekw abagenzi ni yabashira hejuru yawe ngo bakuganze, uzovuga iki, kand’ ari wewe wabiyigishirije? Mbeg’ umubabaro ntuzogufata nk’uw’ umugore ari ku nda? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        },
