                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni wibaza mu mutima, uti N’iki gitumye mbonye aya? Umurengera w’ibigabitanyo vyawe ni wo watumye impuzu zawe zigukūrwako, ibitsintsiri vyawe bigasigara ar’ inkobe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        },
        {
