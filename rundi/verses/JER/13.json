              "items": [
                {
                  "text": "Yoh 11:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muheshe Uhoraho Imana yanyu icubahiro, atarazana umwiza, ibirenge vyanyu bitaratsitarira ku misozi icuze umwiza; namwe muciteze umuco akawuhindura igitūtu c’urupfu, akawugira umwiza w’umuzitanya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        },
        {
