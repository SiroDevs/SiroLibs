              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwumve, mutege amatwi: nta co mugira ubgibone; kuk’ Uhoraho ari we avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        },
