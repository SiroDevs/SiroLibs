                  "text": "Zab 83:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero nzobashwiragiza, nk’ibishingwe bitwawe n’umuyaga wo mu bugaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.24",
            "verseOrgIds": [
              "JER.13.24"
            ]
          }
        },
