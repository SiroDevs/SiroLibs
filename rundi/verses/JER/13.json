            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’Uhoraho rinzako, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.19"
              },
              "items": [
                {
                  "text": "Lew 26:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’Uhoraho agize, at’ Uko ni ko nzokwonona amanyama y’ Ubuyuda n’amanyama akomeye y’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.17"
              },
              "items": [
                {
                  "text": "Yer 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bantu b’abanyakibi, uko bākanse kwumva amajambo yanje, bakagendera mu budadarare bg’imitima yabo, bagakurikira izindi mana ngw abe ari zo basaba, bazisenge, bazomera nk’uyu mukanda utakigira ico umaze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Kuv 19:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.9"
              },
              "items": [
                {
                  "text": "Yer 33:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.20"
              },
              "items": [
                {
                  "text": "Zef 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uk’ umukanda uramata ubura bg’ umuntu, uko ni ko nari naratumye inzu yose ya Isirayeli indamatako, bo n’inzu yose ya Yuda, ni jewe Uhoraho mbivuze; kugira ngo bambere ubgoko niharije, bampeshe izina ry’iritazirano, n’icubahiro n’ubgiza: ariko banka kwumva.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
