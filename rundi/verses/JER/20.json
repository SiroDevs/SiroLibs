              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.11.20"
              },
              "items": [
                {
                  "text": "Yer 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko wewe, Uhoraho Nyen’ ingabo, wewe ugerageza abagororotsi, ukitegereza imishaha n’imitima, umpe kwibonera ingen’ ubīhōra, kukw ari wewe nitwayeko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        },
