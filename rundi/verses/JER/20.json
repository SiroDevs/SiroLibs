              "items": [
                {
                  "text": "Yer 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko numvise benshi bandementaniriza, ubgoba bukantera irya n’ino. Abakunzi banje pfampfe bose, ni bo barereka ko notsitara, bavuga, bati Mumurege, natwe tumurege, kumbure yogwa mu mutego, natwe tukamunesha, tukamwīhōra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        },
