                {
                  "text": "23:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneh’ Uhoraho ari kumwe nanje nk’umunyenkomezi n’uw’ igitinyiro; ni co kizotuma abampama batsitara, ntibaneshe: bazorimarima rwose kuko batākoze ivy’ ubgenge, bagire ibitētērwa bitazobavako, bitazoruha vyibagirana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 20:12"
          },
          "items": [
            {
