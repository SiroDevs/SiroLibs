            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Uhoraho, waranyoheje ndoha, wandushije inkomezi, uranjaniranya: mpindutse agatwengo kurenza umusi, umuntu wese arancokora. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.79.4"
              },
              "items": [
                {
                  "text": "Zab 79:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.7"
              },
              "items": [
                {
                  "text": "Yer 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw iyo mvuze, mvugira hejuru; mvugira hejuru, nti Har’ umuryano n’ubunyazi! Mber’ ijambo ry’Uhoraho ryampinduye agatukisha n’agatwengo kurenza umusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
