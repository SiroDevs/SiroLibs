                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mvuze, nti Sinzosubira kumuvuga, canke ngo ngire ico mvuga mw izina ryiwe, haca haba nk’umuriro uyingana mu mutima wanje, uhīshije uburimbi amagufa yanje, bikangora kwiyumanganya, nkaba ntobishobora. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        },
        {
          "name": "verse",
