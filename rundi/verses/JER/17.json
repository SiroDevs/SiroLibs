              "items": [
                {
                  "text": "Luk 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ukw inkware ibundikira amagi itātaye, umuntu yironkera itunga mu buryo bubi ni kw amera: agicagatije imisi yo kubaho kwiwe rizomuvako, kw iherezo ryiwe azoboneka kw ar’ igipfu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
