        },
        {
          "text": "None rero mweho ni mwanyumvirana umwete, ni jewe Uhoraho mbivuze, mukareka gucisha icikorerwa na kimwe mu birimba vy’iki gisagara ku musi w’isabato, ariko mukaziririza umusi w’isabato, ntimugire igikorwa na kimwe muwukorako; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
