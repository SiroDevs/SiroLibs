            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.5"
              },
              "items": [
                {
                  "text": "71:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arahiriwe umuntu yizigira Uhoraho, Uhoraho akaba ivyizigiro vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
