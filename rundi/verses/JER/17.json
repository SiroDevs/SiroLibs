              "items": [
                {
                  "text": "48:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoba nk’agasaka k’inkōkōre mu bugaragwa, kandi ntazobona ivyiza bimujeko; arikw azoba ahagadutse ahantu h’ ubgeranyange, igihugu c’umunyu kitabamw’ abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.12"
              },
              "items": [
                {
                  "text": "Zab 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.8"
              },
              "items": [
                {
                  "text": "34:8",
                  "type": "text"
