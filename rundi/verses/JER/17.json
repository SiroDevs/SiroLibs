                {
                  "text": "Rom 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe Uhoraho nsesa umutima, nkagerageza umushaha, kugira ngo ngerere umuntu wese ibikwiranye n’ingeso ziwe, n’ibikwiranye n’ivy’ ibikorwa vyiwe vyeze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.10",
            "verseOrgIds": [
              "JER.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 17:11"
          },
          "items": [
