              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, at’ Aravumwe umuntu yishimira abantu, akizigira inkomezi z’abari n’umubiri, umutima wiwe ukava k’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        },
        {
