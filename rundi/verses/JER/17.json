            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.21"
              },
              "items": [
                {
                  "text": "Gus 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.20"
              },
              "items": [
                {
                  "text": "Yer 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "abana babo bibuka ibicaniro vyabo, n’ibigirwamana vyabo vya Ashera vyashinzwe i ruhande y’ibiti bitotahaye ku misozi miremire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.3"
              },
              "items": [
                {
                  "text": "Yes 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.13"
              },
              "items": [
                {
                  "text": "Yer 15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe musozi wanje wibonekeza mu gihugu, ibintu vyawe n’itunga ryawe ryose nzobigomorera binyagwe, bo n’ibitabo vyawe vyatabge ku mpinga z’imisozi, kubg’ ivyaha, bihereye ku mbibe zawe zose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.22"
              },
              "items": [
                {
                  "text": "Gus 32:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.14"
              },
              "items": [
                {
                  "text": "Yer 15:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nawe uzohomba ishamvu yawe naguhaye, ari wewe uvyihamagariye; nzotuma ukorera abansi bawe uri mu gihugu utazi, kuko mwadometse umuriro w’uburake bganje uzokwaka gushitsa ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
