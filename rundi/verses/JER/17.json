        },
        {
          "text": "Icaha ca Yuda candikishijwe ikaramu y’icuma, n’ akabuye gasongoye kitwa alimasi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:1",
              "type": "text"
            },
            {
              "text": "alimasi mu Gifaransa ni diamant.",
              "type": "text"
            }
          ]
        },
        {
          "text": " canditswe ku bisate, ari vyo mitima yabo, canditswe no ku mahembe y’ibicaniro vyabo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 17:2"
          },
          "items": [
