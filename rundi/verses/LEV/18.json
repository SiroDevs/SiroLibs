          },
          "items": [
            {
              "text": "18:21",
              "type": "text"
            },
            {
              "text": "Moleki car’ ikigirwamana c’Abanyakanani, bāgishikanira umwana, bakamwosa mu muriro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kw ikimazi, ngw atukishe izina ryanje, Imana yiwe: nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
