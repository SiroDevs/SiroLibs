            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Abisirayeli, uti Ni we Uhoraho, Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
              "LEV.18.2"
            ]
          }
        },
        {
