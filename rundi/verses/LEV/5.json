              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umuntu ni yaramuka atsinzwe na kimwe mur’ ivyo bidōnzwe, aze yature icaha yakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "anzanire ikimazi ciwe c’impongano y’icaha yakoze, c’inyana y’intama canke y’impene, ayikūye mu mukuku, ngw ibe ikimazi gitangirwa ivyaha; umuherezi azoba amuhongeye ku caha ciwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
