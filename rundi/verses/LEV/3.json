          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ayikūrekw ishikanwa ryiwe anshikanira ryo gutōngōrwa n’umuriro, ribe urubambanda rwōrōshe amara, n’ibinure vyose bihometse ku mara, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
