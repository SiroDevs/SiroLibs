        },
        {
          "text": "Kandi ni yatanga impene kw ishikanwa ryiwe, az’ ayizane imbere yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
