        },
        {
          "text": "Mu gihugu c’i Uzi hār’ umuntu yitwa Yobu; kand’ uwo muntu yar’ umuntu atunganye w’umugororotsi, yubaha Imana, akitandukanya n’ikibi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.1",
            "verseOrgIds": [
              "JOB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.13"
              },
              "items": [
                {
                  "text": "Yob 42:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ afise abahungu ndwi n’abakobga batatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
              "JOB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.3"
              },
              "items": [
                {
                  "text": "Abac 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itunga ryiwe ryar’ intama ibihumbi ndwi, n’ingamiya ibihumbi bitatu, n’inka igihumbi zirima, n’indogoba zivyara amajana atanu, n’abahinda mu rugo benshi cane; nuk’ uwo muntu yar’ ūhambaye gusumba abantu bose b’i burasirazuba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        }
      ]
    },
    {
