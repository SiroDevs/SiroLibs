                "loc": "MAT.9.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana w’umuntu yaje, arya, anywa, baravuga bati Nguyu umukunzi w’inda n’umunoho wa vino, incuti y’abatozakori n’abanyavyaha. Kand’ ubgenge burangwa ko bugororotse n’ibikorwa vyabgo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.19",
            "verseOrgIds": [
              "MAT.11.19"
            ]
          }
        }
      ]
    },
