          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndababgire: muri Tiro n’i Sidoni hazogira agahengekezo ku musi w’amateka kurusha mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
