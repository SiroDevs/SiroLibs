          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ab’uru runganwe ndabagereranye n’iki? Basa n’abana bicaye mu tuguriro, bahamagara bagenzi babo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.16",
            "verseOrgIds": [
              "MAT.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.9"
              },
              "items": [
                {
                  "text": "Imig 29:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati Twavugije imyironge ntimwahamiriza; twakomye induru, ntimwaboroga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.17",
            "verseOrgIds": [
              "MAT.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
