          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.4"
              },
              "items": [
                {
                  "text": "Mat 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Yohana yaje, atarya, atanywa, bavuga bat’ Ahagazweko na dayimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
