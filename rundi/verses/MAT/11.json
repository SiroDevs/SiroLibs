              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yohana ari mu nzu y’imbohe, yumva ivyo Kristo akora, atuma abigishwa biwe kumubaza,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
