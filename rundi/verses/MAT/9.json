              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agendagenda mu bisagara vyose no mu mihana yose, yigisha mu masinagogi yabo, avuga ubutumwa bgiza bg’ubgami, akiza indwara zose n’ubumuga bgose. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
