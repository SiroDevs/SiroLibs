          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ni mwinginge Nyen’ ivyimburwa arungike abimbuzi mu vyimburwa vyiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
            "verseOrgIds": [
