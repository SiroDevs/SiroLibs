              "items": [
                {
                  "text": "Mat 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aja mu bgato, arajabuka, ashika mu gisagara c’i wabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.1",
            "verseOrgIds": [
              "MAT.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.1+MRK.2.2+MRK.2.3+MRK.2.4+MRK.2.5+MRK.2.6+MRK.2.7+MRK.2.8+MRK.2.9+MRK.2.10+MRK.2.11+MRK.2.12"
              },
              "items": [
                {
                  "text": "Mrk 2:1-12",
