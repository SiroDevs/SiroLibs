                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuva mu gihe co kwambukanwa i Babuloni Yekoniya yavyaye Shalutiyeli, Shalutiyeli yavyaye Zerubabeli, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zerubabeli yavyaye Abihudi, Abihudi yavyaye Eliyakimu, Eliyakimu yavyaye Azori, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azori yavyaye Sadoki, Sadoki yavyaye Akimu, Akimu yavyaye Elihudi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihudi yavyaye Eleyazari, Eleyazari yavyaye Matani, Matani yavyaye Yakobo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
