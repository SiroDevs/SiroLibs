            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ramu yavyaye Aminadabu, Aminadabu yavyaye Nahasoni, Nahasoni yavyaye Salumoni, ",
          "type": "text",
          "attrs": {
