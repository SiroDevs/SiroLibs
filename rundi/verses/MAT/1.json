        },
        {
          "text": "Yuda yavyaye Peresi na Zera kuri Tamari, Peresi yavyaye Hesironi, Hesironi yavyaye Ramu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
