            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azovyara umwana w’umuhungu, nawe uz’ umwite YESU, kukw ari we azokiza abantu biwe ivyaha vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
