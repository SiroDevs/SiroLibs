            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yavyaye Yosefu, umugabo wa Mariya nyina wa Yesu yitwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
