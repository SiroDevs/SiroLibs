            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya yavyaye Yekoniya n’abandi bavukana, mu gihe co kwambukanwa i Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
