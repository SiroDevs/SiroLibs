              "items": [
                {
                  "text": "Rus 4:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salumoni yavyaye Bowazi kuri Rahabu, Bowazi yavyaye Obedi kuri Rusi, Obedi yavyaye Isayi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
