            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubgami bgawe buze, ivyo ugomba bibe mw isi nk’uko biba mw ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.10",
            "verseOrgIds": [
              "MAT.6.10"
            ]
          }
        },
        {
