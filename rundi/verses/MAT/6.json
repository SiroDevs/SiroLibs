          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde muri mwebge yoshobozwa n’amaganya kwisumvya uko yareha nk’ukuboko kumwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.27",
            "verseOrgIds": [
              "MAT.6.27"
            ]
          }
        },
