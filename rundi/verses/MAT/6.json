                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo mwisonzesha, ntimwijirwe nk’uko za ndyarya zigira. Kuko bīyoberanya mu maso ngo babonwe n’abantu ko bisonzesheje. Ndababgire ukuri: Baramaze guhabga impēra zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko weho, ni wisonzesha, wīsīge amavuta mu mutwe, wiyuhagire mu maso, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo ntubonwe n’abantu ko wisonzesheje, arik’ ubonwe na So aba mu mpisho, kandi So, abona ivyo mu mpisho, azoguhēra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
