            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ndababgira yuko na Salomo mu bgiza bgiwe bgose atar’ ashajije nka rimwe mur’ ayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
