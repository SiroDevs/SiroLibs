              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ntutujane mu bitwosha nabi, arik’ udukize wa Mubi. [Kuk’ ubgami n’ubushobozi n’icubahiro ar’ ivyawe ibihe bidashira. Amen.] ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
