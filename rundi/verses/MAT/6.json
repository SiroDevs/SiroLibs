          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uduhe ivyo kurya dukwiranye uyu musi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.11",
            "verseOrgIds": [
              "MAT.6.11"
            ]
          }
        },
