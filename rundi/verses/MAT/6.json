                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uduhebere imyenda yacu, nk’uko natwe twahebeye abari mu myenda yacu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.12",
            "verseOrgIds": [
              "MAT.6.12"
            ]
          }
        },
        {
