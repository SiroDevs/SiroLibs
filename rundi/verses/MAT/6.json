          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibaganyisha impuzu n’iki? Ni murābe amashurwe yo ku misozi ingen’ akura, ntiyirirwa aratama, ntajisha impuzu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
