            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntutwikire igicumuro cabo, ntusibanganye icaha cabo ngo kive imbere yawe, kukw ijambo ryabo ar’ akavunamutima ku bubatsi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
