        },
        {
          "text": "Nuko dushimikira kwubaka uruzitiro, rwose turaruhwanya, gushitsa rutimbanye; kukw abantu bari bashize umutima kur’ ico gikorwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
