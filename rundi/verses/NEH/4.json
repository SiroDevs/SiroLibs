            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.12"
              },
              "items": [
                {
                  "text": "Yob 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abansi bacu bumva ko vyamenyekanye muri twebge; Imana ihindura ubusa imigabo yabo, natwe twese dusubira ku ruzitiro, umuntu wese ku gikorwa ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye ico gihe mu bantu banje, igihimba cakoze ico gikorwa, ikindi gihimba bahagarara bitwaje amacumu n’inkinzo n’ imiheto, bambaye n’amakoti y’ ivyuma; kand’ abaganza bāri bahagaze inyuma y’Abayuda bose. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.16",
            "verseOrgIds": [
              "NEH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abubaka uruzitiro n’abikorezi n’ababakorera, umuntu wese yakoresha ukuboko kumwe, ukundi gufashe ikirwanishwa ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.17",
            "verseOrgIds": [
              "NEH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
