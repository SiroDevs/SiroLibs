        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.38"
              },
              "items": [
                {
                  "text": "Mrk 14:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko twebge dusenga Imana yacu, dushiraho n’abarinzi bo kuharinda ku murango no mw ijoro, ngo tubabuze gutera.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        }
