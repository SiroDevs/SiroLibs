              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.10.12"
              },
              "items": [
                {
                  "text": "2 Sam 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbitegereje, mva hasi mbarira abakuru n’abaganza n’abandi bose, nti Ntimubatinye. Mwibuke Umwami Imana, ahambaye ateye ubgoba, murwanire bene wanyu, n’abahungu banyu n’abakobga banyu n’abagore banyu n’ingo zanyu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        }
      ]
    },
