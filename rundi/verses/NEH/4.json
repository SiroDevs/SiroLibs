            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Sanibalati na Tobiya n’Abarabo n’Abamoni n’Abanyashidodi bumvise yukw igikorwa co gusana uruzitiro rw’i Yerusalemu kija imbere, kandi yukw ibihengeri bitanguye kuzibirwa, bararaka cane, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.3+PSA.83.4+PSA.83.5"
              },
              "items": [
                {
                  "text": "Zab 83:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bahiga imihigo bose yuko bazoja gutera i Yerusalemu no kutuburabuza. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
              "NEH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
