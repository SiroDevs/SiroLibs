              },
              "items": [
                {
                  "text": "Neh 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurikirwa na Hananiya mwene Shelemiya, na Hanuni umuhungu agira gatandatu wo muri bene Salafu, basana ikindi gihimba; hakurikira Meshulamu mwene Berekiya, asana ahahereranye n’icumba ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurikira Malikiya, umwe wo mu bacuzi b’izahabu, arasana ashitsa ku nzu y’abahawe ibango ry’ibikorwa vy’urusengero, no ku nzu y’abadandaza, aharābana n’ irembo ryitwa Hamifukadi, kugeza ahadūga haja ku mfuruka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
