                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bo n’abahawe ibango ry’ibikorwa vy’urusengero bāba muri Ofeli; basana ahahereranye n’irembo ry’amazi ryerekeye i burasirazuba, bo n’ umunara wometseko. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
