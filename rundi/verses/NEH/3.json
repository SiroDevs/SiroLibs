                "loc": "NEH.3.4"
              },
              "items": [
                {
                  "text": "Neh 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurikirwa na Meremoti mwene Uriya, Uriya wa Hakosi, asana ikindi gihimba, ahereye ku muryango w’iyo nzu ya Eliyashibu akageza ah’ iyo nzu nyene igarukira. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurikirwa n’abaherezi bo mur’ iyo ntāra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bakurikirwa na Benyamini na Hashubu, basana aharābana n’ inzu yabo; bakurikirwa na Azariya mwene Mayaseya, Mayaseya wa Ananiya, asana ahabangikanye n’inzu yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurikirwa na Binuwi mwene Henadadi, asana ikindi gihimba ahereye kur’ iyo nzu ya Azariya ashitsa ah’ uruzitiro rwiheteye, ku mfuruka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
