            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakurikirwa n’ab’i Tekowa, arikw abapfasoni bo muri bo ntibarushe bemera gukora igikorwa ca Segaba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:5",
              "type": "text"
            },
            {
              "text": "Mu Giheburayo handitswe ngo Ntibarushe batega izosi ingogo ya Segaba.",
              "type": "text"
            }
          ]
        }
      ]
