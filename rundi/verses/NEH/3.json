                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akurikirwa na Palali mwene Uzayi, asana aharābana n’ahihese, ahahera ku munara wometswe ku ngoro y’umwami yo haruguru, ahahereranye n’urugo rw’abateramyi. Na we akurikirwa na Pedaya mwene Paroshi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
