              "items": [
                {
                  "text": "Neh 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hagati y’ahadūga haja ku mfuruka n’irembo ry’intama hasanwa n’abacuzi b’izahabu hamwe n’abadandaza.",
          "type": "text",
          "attrs": {
