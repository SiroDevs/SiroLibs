              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irembo ryitwa iry’ Amafi ryubakwa na bene Hasenaya, barishiramw’ imitambikwa yaryo, baterako n’inzugi zaryo n’ivyuma vyo kuzigumya n’ibihindizo vyazo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
