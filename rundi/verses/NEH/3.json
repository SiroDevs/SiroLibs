        },
        {
          "text": "Bukeye Eliyashibu, umuherezi mukuru, hamwe na bagenzi biwe b’abaherezi, bashirako bubaka irembo ry’intama; bararihezagira, bashiraho n’inzugi zaryo; bakomeza kwubaka barinda bashitsa ku munara wa Hameya, na wo barawuhezagira; bavudukaho bashitsa no ku munara wa Hananeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ab’ i Yeriko bahēra aho Eliyashibu yagarukiye, barubaka; bakurikirwa na Zakuri mwene Imuri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
