              "text": "Ico",
              "type": "text"
            },
            {
              "text": "kidengeri Shela",
              "type": "text"
            },
            {
              "text": "ni co Silowamu: rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.7"
              },
              "items": [
                {
                  "text": "Yoh 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " co ku ndimiro y’umwami, kurinda ashitsa ahagenda hadondagirwa hamanuka hava ku gisagara ca Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
