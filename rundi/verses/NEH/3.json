              "type": "text"
            }
          ]
        },
        {
          "text": "Haruguru y’irembo ry’amafarasi hasanwa n’abaherezi, umuherezi wese asana ahahereranye n’inzu yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
