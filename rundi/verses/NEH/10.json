          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Pashuri na Amariya na Malakiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.3",
            "verseOrgIds": [
              "NEH.10.3"
