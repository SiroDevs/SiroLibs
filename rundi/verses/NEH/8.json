                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ko bazotāngāza ayo majambo mu bisagara vyose no muri Yerusalemu, ngo Ni mugende ku misozi muce amashami y’ibiti vya elayo n’ay’ ibijābija vya elayo nyene, n’ay’ imihadasi n’ay’ ibigazi, n’ay’ ibindi biti vyose bizitanye, kugira ngo muce insāgo nk’uko vyanditswe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
