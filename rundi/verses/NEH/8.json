        },
        {
          "text": "Baraheza basanga ko mur’ ivyo vyagezwe Uhoraho yahaye Mose handitswe ko mu kwezi kw’indwi Abisirayeli bazokwama bagira imisi mikuru yo kurāra mu nsāgo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
