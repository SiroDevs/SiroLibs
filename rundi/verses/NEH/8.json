                "loc": "EST.9.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Nehemiya arababgira, ati Ni mutahe muje kurya inyama zinuze, munywe n’ibisosa, n’abatagira ico bafise mubarungikire, kuk’ uyu musi werejwe Uhoraho; ntimubabare, kuk’ umunezero w’Uhoraho ari zo nkomezi zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalewi na bo bahoza abantu bose, bati Ni mwihorere, kuk’ uyu musi ar’ uwera, ntimubabare. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bose baraheza baja kurya no kunywa no kugemuranira no kunezeranwa akanyamuneza kenshi, kuko bari batahuye amajambo basobanuriwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
