        },
        {
          "text": "Nehemiya icēgēra c’umwami, na Ezira umuherezi, umunyabgenge w’ivyanditswe, n’Abalewi ari bo bigisha abantu, baraheza bababgira bose, bat’ Uyu musi n’ uwo Uhoraho Imana yanyu yejeje, nta co mubabara kandi reka kurira; kukw abantu bose bariko bararira, aho bumviye amajambo y’ ivyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.9.19"
              },
              "items": [
                {
                  "text": "Est 9:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
