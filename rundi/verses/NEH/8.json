        },
        {
          "text": "Maz’ abantu bose iyo bava bakagera bakoranira icarimwe ku kibuga kir’ imbere y’irembo ry’ amazi, basaba Ezira, umunyabgenge w’ivyanditswe, ngw azane igitabo c’ivyagezwe vya Mose, bimwe Uhoraho yaha Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
