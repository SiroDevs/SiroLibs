            }
          ]
        },
        {
          "text": "Ibisigaye bene Data, ivy’ ukuri vyose, ivyo kwubahwa vyose, ibigororotse vyose, ibitānduye vyose, ivy’ igikundiro vyose, ibishimwa vyose, ni haba harih’ ingeso nziza, ni haba hariho gushimwa, abe ari vyo mwiyumvira. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.8",
            "verseOrgIds": [
              "PHP.4.8"
            ]
          }
        },
        {
