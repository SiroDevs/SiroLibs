          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Imana yanje izobamara ubukene bganyu bgose, nk’ukw itunga ry’ubgiza ryayo riri ryo muri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.19",
            "verseOrgIds": [
              "PHP.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw icubahiro kibe ic’ Imana yacu, ni yo Data wa twese, ibihe bitazoshira. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.20",
            "verseOrgIds": [
              "PHP.4.20"
            ]
          }
        }
