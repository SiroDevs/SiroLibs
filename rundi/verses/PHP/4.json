              "items": [
                {
                  "text": "1 Kor 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "S’uko ndondera ingabire, ariko ndondera imbuto zigwiririkanya amaronko yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.17",
            "verseOrgIds": [
              "PHP.4.17"
            ]
          }
        },
        {
