              "type": "text"
            }
          ]
        },
        {
          "text": "Mwame munezererwa mu Mwami wacu imisi yose; ndabivuze ubugira kabiri: ni munezerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
