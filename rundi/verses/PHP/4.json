        },
        {
          "text": "Ariko ndanezererewe cane mu Mwami wacu kuk’ ubu mwahavuye mukongera kubabara ivyanje: kandi mwaranabibabara, ariko mukabura uburyo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.10",
            "verseOrgIds": [
              "PHP.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
