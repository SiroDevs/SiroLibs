            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo mwize, ivyo mwākiriye, ivyo mwumvise, ivyo mwambonanye, abe ari vyo mukora: ni ho Imana Nyen’ amahoro izobana namwe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
