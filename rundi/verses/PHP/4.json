                  "text": "Kol 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amahoro y’Imana aruta uko yomenywa n’umuntu wese, azoshibamira imitima yanyu n’ivyiyumviro vyanyu muri Kristo Yesu",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
