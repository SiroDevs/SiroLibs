              "PHP.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndahanūra Ewodiya, ndahanūra na Sintike, ngo bahūrize imitima mu Mwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.2",
            "verseOrgIds": [
              "PHP.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Zab 69:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.20"
              },
              "items": [
                {
                  "text": "Luk 10:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nawe, ndakwinginga, uwo dufatanije igikorwa vy’ukuri, wame ufasha abo bagore, kuko bārwananye nanje mu kurwanira ubutumwa bgiza, bo na Kilementi n’abandi bāfatanya nanje, amazina yabo yanditswe mu gitabo c’ubugingo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        }
      ]
    },
