              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwagize neza, kuko mwafatanije nanje amarushwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.14",
            "verseOrgIds": [
              "PHP.4.14"
            ]
