            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.10"
              },
              "items": [
                {
                  "text": "2 Kor 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzi gucishwa bugufi, nzi no kugira umurengera; muri cose no muri vyose nātiwe ibanga ryo mu vyo guhāga no mu vyo gusonza, ryo mu vyo kugira umurengera no mu vyo gukena. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.12",
            "verseOrgIds": [
              "PHP.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
