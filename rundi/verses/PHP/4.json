            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimugire ico mwiganyira, ariko muri vyose ivyo mugomba bimenyeshwe Imana, mu gusenga no mu kwinginga bifatanije no gukenguruka. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
