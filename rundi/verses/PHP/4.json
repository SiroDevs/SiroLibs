                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbivuze kubg’ ubukene, kuko nize kubumbga n’ivyo mfise uko ndi kose. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
            "verseOrgIds": [
              "PHP.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
