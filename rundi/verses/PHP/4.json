              "items": [
                {
                  "text": "Flp 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mfise ibinkwiye vyose, mfise umurengera: ndahāze, kuko mpāwe na Epafurodito ivyo mwarungitse, ar’ umubabge umota neza, ikimazi cemewe gihimbara Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.18",
            "verseOrgIds": [
              "PHP.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
