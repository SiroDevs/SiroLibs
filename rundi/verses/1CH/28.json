              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "amuha n’ icitegererezo c’ibintu vyo kwōkōza inyama, n’imibehe n’ibikombe, uko bizocurwa mw izahabu iramuye, amugereraniriza n’urugero rw’ amazahabu yo kuzocurishamw’ inzavya zose, n’urw’ amafeza yo kuzocurishamw’ inzavya z’amafeza nyene; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
